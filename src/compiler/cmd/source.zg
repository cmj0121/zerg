# Reading a source, and resolving what it imports: the loader every walk goes through, the
# three rules an import is held to, and the resolver that turns one import path into files.
#
# `build`, `test`, `lint` and `lsp` all need it — the first three to load a program, the
# last to load the program an unsaved buffer belongs to — so it belongs to none of them.
# Resolution in particular is the part that decides WHAT A PROGRAM IS, and a second copy of
# it kept in step by hand is the one thing this module exists to prevent.

import (
	"ascii"
	"io"

	"./zerg"
)

# --- import cycles ---------------------------------------------------------------------
#
# "Import cycles between modules are rejected" (docs/runtime/package.md), and nothing
# detected one, at either layer: `ca` importing `cb` importing `ca` compiled and ran.
#
# A cycle that BUILDS is worse than a cycle that is refused, which is why this is enforced
# rather than documented away. Two mutually importing modules each have to be initialized
# before the other — their `init()` blocks and their module constants both — and there is no
# order that satisfies both, so whatever the build settles on is an order no chapter defines
# and nothing can be written against.
#
# THE QUESTION IS ASKED OF THE PATH DOWN, not of what has been loaded. A module that two
# others import is the ordinary case — a diamond — and `seen` is what answers that one, by
# loading it once. What has no order is a module that comes up again while it is still ON the
# way down, and only a stack can tell the two apart. The self-import is the one-node case of
# exactly the same test, which is why it needs no branch of its own.
#
# The chain is reported from the first appearance, so what the reader is shown is the LOOP
# and not the walk that reached it.
fn chk_import_cycle(stack: list[str], im: str) {
	mut at := -1
	mut i := 0
	for i < stack.len() {
		if at < 0 and stack[i] == im {
			at = i
		}
		i = i + 1
	}
	return if at < 0

	mut chain := ""
	mut j := at
	for j < stack.len() {
		chain = chain + path_tail(stack[j]) + " -> "
		j = j + 1
	}
	raise zerg.rule_msg(zerg.Rule.ImportCycle, f"import cycle: {chain}{path_tail(im)} — modules form a DAG (docs/runtime/package.md), and a cycle has no order for its `init()` blocks and module constants to be readied in. Mutually recursive declarations belong in ONE module, which costs nothing: a module is a directory whose files share a namespace and import each other not at all")
}

# chk_unbuilt_module turns away an import of a module that SHIPS AND CANNOT BE COMPILED, at
# the line that asked for it.
#
# `atomic` is the whole list, and it earns the entry the hard way: the module is written, it
# is formatted and checked with the rest of the stdlib, and it declares `Atomic[T]`, a generic
# struct — a form this compiler refuses. So `import "atomic"` used to fail with `E9004
# NotImplemented: a generic struct` pointing INTO `src/stdlib/atomic.zg`, a file the reader
# did not write and cannot fix. That is the same shape as a cc error against generated C, and
# it is the shape this repo's gates exist to turn away.
#
# THE MODULE STAYS SHIPPED rather than being taken out of the stdlib directory. Unshipping it
# means moving the source out of `src/stdlib/`, because this compiler resolves the stdlib by
# LISTING that directory — and the moment it leaves, `zerg fmt --check` and the rest of
# SELF_SRCS stop reading it, so a hundred lines of Zerg rot quietly until generics land. What
# is left behind would be `E5002 cannot resolve import`, which is a sentence about a module
# that is right there. Between a listing that needs a marker and a diagnostic that is false,
# the marker is the honest one, and docs/runtime/stdlib.md carries it.
#
# This function deletes itself the day a generic struct is built.
# chk_test_import turns away an import that NAMES a test file. `import "lib/lib_test"` reaches
# module_at's single-file arm, which the directory arm's filter does not cover, and dropping it
# there instead would resolve the import to an empty module and move the complaint to whatever
# name the program went on to write.
#
# A test file is not importable from anywhere, including a sibling test file: the convention
# says which builds compile one, and `zerg test` is what will compile them together.
fn chk_test_import(im: zerg.ImportDecl) {
	return if not zerg.is_test_file(path_tail(im.path) + ".zg")

	place := zerg.place_line(im.at, im.line, im.col)
	raise zerg.rule_msg(zerg.Rule.TestFileImported, f"`{im.path}` names a test file, and a normal build compiles none — a `*_test.zg` is included only in a test build (docs/runtime/package.md), so nothing it declares is on any module's surface\n{place}")
}

fn chk_unbuilt_module(im: zerg.ImportDecl) {
	return if path_tail(im.path) != "atomic"

	place := zerg.place_line(im.at, im.line, im.col)
	raise zerg.rule_msg(zerg.Rule.NotYetAtomicImport, f"the module `atomic` ships and cannot be imported — it declares `Atomic[T]`, and a generic struct is a form this compiler has not built (docs/runtime/stdlib.md). Share state across coroutines with a channel until it has\n{place}")
}

# --- a program's sources, entry first ------------------------------------------------------

# load_sources loads every named entry with its imports, keeping one copy of a module
# that several entries share.
fn load_sources(files: list[str]) -> list[str] {
	mut paths: list[str] = []
	mut mods: list[str] = []
	return load_sources_at(files, paths, mods)
}

# load_sources_at is load_sources with the PATH of each source collected beside it, in the
# same order. A diagnostic names the file it is about, and by the time anything is emitted
# the whole program is one merged tree — so the path has to travel with the source from
# here, or nothing downstream can say where a statement came from.
fn load_sources_at(files: list[str], mut &paths: list[str], mut &mods: list[str]) -> list[str] {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	for f in files {
		load_into(f, dir_of(f), seen, srcs, paths, mods)
	}
	return srcs
}

# --- module resolution ------------------------------------------------------------------

# resolve_module is the SEARCH by itself: one module path tried under each source root, and
# the answer is whatever files it finds — possibly none. `module_files` is this search plus
# a refusal, and the two are separate because `zerg doc` runs the same search by name and
# wants the empty answer back (`module_sources`, below). One resolver either way, for the
# reason the file header gives.
#
# The module is searched BESIDE THE IMPORTER first — the directory of the file that wrote
# the import — then in the entry program's own directory, then the standard library. A
# module is either a single `<path>.zg` file or a DIRECTORY of them — the compiler's own
# `zerg` module is the second kind, and its files are read in the sorted order the runtime
# guarantees so the emitted C never depends on the filesystem.
# --- what an import path names -------------------------------------------------------------
#
# An import path is a PREFIX and a PACKAGE PATH. The package path is a directory path made of
# package NAMES; the prefix decides which ROOT it is under, and NOTHING ON DISK CHANGES WHICH
# ROOT. That is the property this whole section exists to have: reading an import tells you
# which of the three it is, and adding, removing or renaming a file can change only whether it
# RESOLVES — never what kind of thing it names.
#
#     import "io"               ->  <stdlib>/io.zg        or  <stdlib>/io/
#     import "net/http"         ->  <stdlib>/net/http.zg  or  <stdlib>/net/http/
#     import "./http"           ->  <entry>/http.zg       or  <entry>/http/
#     import "github.com/a/b"   ->  a remote repository — the shape is reserved and refused
#
# The three roots expand a package path by EXACTLY THE SAME RULE, which is what makes this
# readable: there is one layout rule, not three.
#
# THE CLASSIFIER IS A CONSEQUENCE OF THE NAME GRAMMAR rather than a rule standing beside it. A
# package name is `[a-z][a-z0-9_]*`, so it cannot hold a dot; so a first segment that holds one
# cannot be a package name and can only be a HOST. Three branches, each a question about the
# string and none of them a question about the filesystem:
#
#     starts with "./"           ->  this project
#     first segment holds a '.'  ->  remote
#     otherwise                  ->  the standard library
#
# Two things fall out for free. `"./Log"` is ILL FORMED rather than a filesystem question, so
# the difference between a case-insensitive macOS and a case-sensitive Linux can no longer
# reach an import path. And a dotted first segment can never be anything else, so reserving the
# remote shape today costs nothing and stops it being used for something it is not.
fn imp_is_local(path: str) -> bool {
	return has_prefix(path, "./")
}

# imp_body is the package path with the local prefix taken off — the part that is expanded
# under whichever root the classifier picked, and the one string the two roots share.
fn imp_body(path: str) -> str {
	return cut_prefix(path, "./") if imp_is_local(path)

	return path
}

fn imp_is_remote(path: str) -> bool {
	return false if imp_is_local(path)

	return seg_has_dot(imp_segs(path)[0]) if imp_segs(path).len() > 0

	return false
}

# imp_segs splits a package path on `/`. It keeps empty segments rather than dropping them,
# because an empty one is exactly what `//`, a leading `/` and a trailing `/` produce and each
# is a second spelling of some other path — which imp_ill_formed turns away.
fn imp_segs(body: str) -> list[str] {
	mut out: list[str] = []
	mut cur: list[byte] = []
	for b in bytearray(body) {
		if b == b'/' {
			out.append(str(cur))
			cur = []
		} else {
			cur.append(b)
		}
	}
	out.append(str(cur))
	return out
}

fn seg_has_dot(seg: str) -> bool {
	for b in bytearray(seg) {
		return true if b == b'.'
	}
	return false
}

# imp_name_ok is the package-name grammar, `[a-z] [a-z0-9_]*`, and it is deliberately NARROWER
# than the identifier a namespace is bound as. Upper case is refused so that the one difference
# between the two filesystems this compiler runs on — macOS folds case, Linux does not — cannot
# decide whether a program builds.
fn imp_name_ok(seg: str) -> bool {
	b := bytearray(seg)

	return false if b.len() == 0
	return false if not ascii.is_lower(b[0])

	mut i := 1
	for i < b.len() {
		return false if not ascii.is_lower(b[i]) and not ascii.is_digit(b[i]) and b[i] != b'_'

		i = i + 1
	}
	return true
}

# imp_ill_formed answers WHY a string is not an import path, or "" when it is one. Every shape
# it turns away fails the same test — a segment that is not a package name — so this is one
# rule wearing several sentences rather than six rules, which is what E5012 is.
#
# NOTHING IS NORMALISED. `./log/`, `.//log` and `./a/../b` are refused rather than cleaned up,
# because cleaning them makes two spellings into one module and puts module identity back to
# being computed from a string somebody happened to type.
fn imp_ill_formed(path: str) -> str {
	return "an import path may not be empty" if path == ""
	return "an import path may not begin with `/`: a module is named under a root, not at one — a module of this project is `./<name>`" if has_prefix(path, "/")

	body := imp_body(path)

	return "`./` names no module on its own — a module of this project is `./<name>`" if body == ""
	return "an import names a MODULE and not a file — write `" + drop_suffix(path, ".zg") + "`" if has_suffix(path, ".zg")

	segs := imp_segs(body)

	# THE DOT SEGMENTS COME FIRST, before anything classifies. `..` holds two dots, so a path
	# beginning with one has a first segment that is not a package name — which is the test for
	# a HOST, and `../shared` was answering _a remote package `../shared` names a host_. The
	# escape is checked over every segment before the host rule is allowed an opinion.
	mut d := 0
	for d < segs.len() {
		return "`..` is not part of an import path: an import may not reach outside the project, and a module reached from above belongs beside the entry file as `./<name>`" if segs[d] == ".." or segs[d] == "."

		d = d + 1
	}

	remote := imp_is_remote(path)
	mut i := 0
	for i < segs.len() {
		seg := segs[i]

		# the host of a remote path is not a package name and is not held to that grammar; the
		# segments after it are
		if remote and i == 0 {
			i = i + 1
			continue
		}

		return f"an import path is written one way: `{path}` has an empty segment" if seg == ""
		return f"`{seg}` is not a package name — a package name is a lower-case letter followed by lower-case letters, digits and `_`" if not imp_name_ok(seg)

		i = i + 1
	}

	last := segs[segs.len() - 1]
	return f"`{last}` is a reserved word, and a module's name is bound as an identifier" if zerg.reserved_word(last)

	return ""
}

# imp_root is the directory a well-formed, non-remote path is expanded under. The whole of the
# difference between the two roots is this one answer; everything after it is shared.
fn imp_root(path: str, entry_dir: str) -> str {
	return entry_dir if imp_is_local(path)

	return stdlib_dir()
}

# resolve_module is the files one import path names, or an empty list when nothing is there.
#
# ONE ROOT, NOT A SEARCH. It used to try the importing file'"'"'s directory, then the entry
# directory, then the standard library, first match winning — so `import "io"` meant the
# standard library or a neighbour'"'"'s file depending on what was on disk, adding a file changed
# what every sibling'"'"'s imports resolved to, and a file in a module directory was silently
# promoted to a module of its own (#13). The prefix decides the root now, and a search with one
# place to look is not a search.
fn resolve_module(path: str, entry_dir: str) -> list[str] {
	return module_at(imp_root(path, entry_dir), imp_body(path))
}

# module_files resolves one import to the source files that make up the module it names.
#
# AN IMPORT THAT RESOLVES TO NOTHING IS REFUSED HERE, and it used to yield an empty list that
# both loaders skipped: each read the files the import resolved to, found none, and moved on.
# `import "nope"` compiled and ran, and the first USE of the module reported "the method
# `thing` on a ?", naming neither the module nor the import. A dependency that is not there is
# the one thing a loader cannot work around, and the seed has said so since 1g; the two
# compilers now agree, in the same words.
#
# The refusal is `module_files`' rather than each caller's, because both callers want the same
# answer and a third would have to remember to ask for it. There is a third asker now, and it
# wants the OTHER answer — which is why the search underneath is a function of its own, and why
# `module_sources` calls that one instead.
#
# IT TAKES THE DECLARATION AND NOT THE PATH, so the refusal can say WHERE. E5002 was the last
# import rule with no place: the two beside it (E9104, E5011) are handed the `ImportDecl` and
# spell `place_line` from it, and this one was handed the path alone — a string that knows
# what was written and not which line wrote it. A reader told an import resolves nowhere and
# not which import is left grepping their own program for the quoted path.
fn module_files(im: zerg.ImportDecl, from_dir: str) -> list[str] {
	place := zerg.place_line(im.at, im.line, im.col)

	# THE STRING FIRST, and the disk only after it. A path that is not an import path is
	# refused for what it says rather than for what it failed to find, which is the difference
	# between `\`..\` is not part of an import path` and `cannot resolve import "../x"`.
	why := imp_ill_formed(im.path)

	raise zerg.rule_msg(zerg.Rule.ImportPathIllFormed, f"`{im.path}` is not an import path: {why}\n{place}") if why != ""

	raise zerg.rule_msg(zerg.Rule.NotYetRemoteImport, f"NotImplemented: a remote package — `{im.path}` names a host, and resolving one needs a package layer this compiler has not built. It resolves the standard library (`import \"io\"`) and this project (`import \"./io\"`)\n{place}") if imp_is_remote(im.path)

	raise zerg.rule_msg(zerg.Rule.ImportLayoutAmbiguous, f"`{im.path}` is both a file and a directory — a module is one shape or the other, and this compiler will not choose for you\n{place}") if module_ambiguous(imp_root(im.path, from_dir), imp_body(im.path))

	found := resolve_module(im.path, from_dir)

	return found if found.len() > 0

	# The sentence names the ROOT that was looked in, because that is the half the reader
	# cannot see — and when the other root holds it, saying so IS the fix.
	raise zerg.rule_msg(zerg.Rule.ImportUnresolved, f"cannot resolve import `{im.path}`: {imp_missing_says(im.path, from_dir)}\n{place}")
}

# imp_missing_says is the second half of an unresolved import: where it was looked for, and —
# when the OTHER root holds a module of that name — the one line that fixes it. A reader who
# wrote `import "log"` beside their own `log/` is one character away and has no way to know it.
fn imp_missing_says(path: str, from_dir: str) -> str {
	body := imp_body(path)
	return f"no module at `{path}` (looked in {join_path(from_dir, body)})" if imp_is_local(path)
	other := module_at(from_dir, body)
	return f"there is no standard-library module `{path}`, and `{body}` is beside your entry file — did you mean `./{body}`?" if other.len() > 0

	return f"there is no standard-library module `{path}` (looked in {stdlib_dir()})"
}

# module_sources is the same resolution asked BY NAME rather than by import: the files that
# make up module `name`, or an empty list when nothing resolves. It exists for `zerg doc`,
# which wants to answer "no such module, and here is what I can see" — a sentence, not the
# E5002 an import earns — and which holds no `ImportDecl` to be refused at anyway: nobody
# wrote an import, so there is no line for a place to name.
#
# There is no importer either, which is why `from_dir` stands as both roots: the directory
# the reader asked from plays the part the importing file's directory plays in a build.
#
# READING A MODULE IS NOT IMPORTING IT, and two of the three checks an import is held to go
# unasked here because of it. `chk_unbuilt_module` turns away `import "atomic"` because this
# compiler cannot BUILD a generic struct — but nothing is being built, the module's
# documentation is exactly as readable as the rest of the stdlib, and a doc tool that refused
# it would hide the one module whose documentation is all a user can get. `chk_import_cycle`
# asks about the PATH DOWN through a program being loaded, and no program is being loaded: one
# name resolves to one module's files and the walk that could come back around never starts.
#
# THE THIRD IS KEPT — `chk_test_import`'s rule, as a filter rather than a refusal. A
# `*_test.zg` is on no module's surface (docs/runtime/package.md), so a document of what one
# declares would describe declarations no program can reach; and `stdlib_modules` already
# leaves those names out, so resolving one here would have this file answer the same file two
# ways. It is an empty list rather than a raise because there is no place to raise at and the
# caller's sentence is already written: no such module, and here is what I can see.
#
# A MODULE NAME IS AN IDENTIFIER, and a last segment that is not one names no module.
# `module_at`'s directory arm asks whether `<root>/<name>` exists, and the filesystem answers
# yes to more names than the language does: the empty one is the root, `.` is the root again,
# and `..` is whatever stands above it. So `module_sources("", …)` used to answer with the
# whole standard library as one module — and `zerg doc .`, which a reader types meaning
# "document what is here", answered with the same two thousand lines through the same door,
# while `zerg doc ..` read the parent directory. Refusing the empty segment alone closed one
# spelling of one bug and left its family standing.
#
# `module_files` cannot reach any of them, a parser guaranteeing an import path is non-empty
# and quoted; asking BY NAME is what opens it, and `zerg doc strings/` is the empty spelling
# arriving through the last-segment alias.
pub fn module_sources(name: str, from_dir: str) -> list[str] {
	mut none: list[str] = []
	seg := path_tail(name)

	return none if not is_module_name(seg)
	return none if zerg.is_test_file(seg + ".zg")

	return none if imp_ill_formed(name) != ""
	return none if imp_is_remote(name)

	found := resolve_module(name, from_dir)
	return found if found.len() > 0

	# AND THE READER'S OWN DIRECTORY, for a bare name — which is the one place this differs
	# from an import, and it differs for the reason the paragraph above gives: reading a module
	# is not importing one. An import is held to `bare means the standard library` because a
	# name that could mean two things is a program that means two things; a person typing
	# `zerg doc attach` is pointing at the module they can see, and there is no program for the
	# ambiguity to reach. `zerg doc ./attach` says the same thing and is what a build would
	# require.
	return none if imp_is_local(name)

	return module_at(from_dir, name)
}

# is_module_name reports whether one segment is a name the language would let a module have.
# A module's name is the namespace an import binds, and a namespace is spelled `identifier`
# (GRAMMAR#import-spec, whose `as` clause renames it with one) — a letter or `_` followed by
# letters, digits and `_` (GRAMMAR#identifier). It is asked of the LAST segment because that is
# the segment that is the name: the one the namespace is bound from, and the one the alias
# above retries a whole path at.
fn is_module_name(seg: str) -> bool {
	b := bytearray(seg)

	return false if b.len() == 0
	return false if not ascii.is_alpha(b[0]) and b[0] != b'_'

	mut i := 1
	for i < b.len() {
		return false if not ascii.is_alnum(b[i]) and b[i] != b'_'

		i = i + 1
	}
	return true
}

# stdlib_modules is every module name the standard library holds, in the sorted order the
# runtime lists a directory in. It answers for ONE of the roots `module_sources` searches, and
# `local_modules` below answers for the other: a name that resolves to nothing is unknown only
# if BOTH listings leave it out, and the stdlib half alone would tell a reader standing in
# `src/compiler` that the modules there are the fifteen in the standard library.
#
# What is filtered out is what is not a Zerg module. The stdlib directory also carries
# `embed.go`, `go.mod` and `LICENSE`, which the `.zg` suffix turns away, and its own test
# files, which `zerg.is_test_file` does — the SAME rule `module_at` drops them by, because
# a naming convention answered in two places is one that drifts. `atomic` IS in the answer:
# unimportable is not unreadable (see module_sources).
pub fn stdlib_modules() -> list[str] {
	mut out: list[str] = []
	for name in __zrt_listdir(stdlib_dir()) {
		if has_suffix(name, ".zg") and not zerg.is_test_file(name) {
			out.append(drop_suffix(name, ".zg"))
		}
	}
	return out
}

# local_modules is every module name visible BESIDE one directory — the half of what
# `module_sources` can resolve that the standard library does not hold, `from_dir` standing as
# both of the other two roots there.
#
# IT ASKS `module_at`, once per entry, rather than deciding for itself what a module is. That a
# module is a `<name>.zg` file OR a directory of them is written once, below; a listing that
# re-derived it would be exactly the second copy this file exists to prevent, and it would
# drift the day a third shape is allowed. So each entry is reduced to the module name it could
# be — the `.zg` dropped from a file, a directory taken as it stands — and `module_at` says
# whether that is one. `embed.go` and `LICENSE` fall out with no filter of their own.
#
# A test file is left out for the reason `module_sources` refuses one, and by the same rule:
# `module_at`'s single-file arm keeps it only so `chk_test_import` has something to refuse.
#
# `foo.zg` beside `foo/` is ONE module — `module_at` reads the file and never the directory —
# so it is one line of the listing, which is what the `known` scan is for.
pub fn local_modules(from_dir: str) -> list[str] {
	mut out: list[str] = []
	return out if not __zrt_exists(from_dir)

	for name in __zrt_listdir(from_dir) {
		mut cand := name
		if has_suffix(name, ".zg") {
			cand = drop_suffix(name, ".zg")
		}
		continue if zerg.is_test_file(cand + ".zg")

		mut known := false
		for m in out {
			if m == cand {
				known = true
			}
		}
		continue if known

		if module_at(from_dir, cand).len() > 0 {
			out.append(cand)
		}
	}
	return out
}

# WHICH SOURCES ARE TEST FILES is `zerg.is_test_file`. The convention used to be written in
# the driver, and moved into the module when the linter grew a rule about it (L601): two tools
# ask the question now, and a naming convention answered in two places is one that drifts.

# module_at resolves one import path under one root: a single `<path>.zg` file, or a
# DIRECTORY of them read in sorted order so the emitted C never depends on the filesystem.
#
# A `*_test.zg` IS NOT IN EITHER ANSWER. A normal build compiled them like every other file,
# so a test's declarations reached the shipped artifact and its `pub` ones joined the module's
# surface — `lib.only_in_test()` resolved and ran from a program that never asked for a test.
# The directory case drops them; the single-file case refuses, because `import "lib/lib_test"`
# names one deliberately and dropping it would leave the module empty and the complaint about
# some name much later.
fn module_at(root: str, path: str) -> list[str] {
	parent := imp_under(root, imp_parent(path))
	base := path_tail(path)

	# BOTH SHAPES ARE ASKED, and both being there is NO module rather than a ranked pair. Any
	# silent precedence is a question a reader eventually has to ask — `zerg` used to read the
	# file and never the directory, the seed reads the directory and never the file — and the
	# import site turns the pair away by name (E5013) rather than choosing for them.
	file := dir_has(parent, base + ".zg")
	dir := dir_has(parent, base)

	mut none: list[str] = []

	return none if file and dir
	return module_one(join_path(parent, base + ".zg")) if file
	return module_many(join_path(parent, base)) if dir

	return none
}

# module_ambiguous is the pair module_at answers nothing for, asked on its own so the import
# site can say which of the two nothings it found.
fn module_ambiguous(root: str, path: str) -> bool {
	parent := imp_under(root, imp_parent(path))
	base := path_tail(path)
	return dir_has(parent, base + ".zg") and dir_has(parent, base)
}

# dir_has asks the LISTING rather than the path, and that is the whole point of it: macOS folds
# case and Linux does not, so `__zrt_exists("<root>/log")` answers yes to a `Log/` on one of the
# two platforms this compiler ships for. A name is present when the directory says that exact
# name is present.
fn dir_has(dir: str, name: str) -> bool {
	# AN EMPTY ROOT IS THE CURRENT DIRECTORY. `dir_of` answers "" for an entry named with no
	# directory at all — `zerg build main.zg` — and `__zrt_exists("")` is false, so every
	# import of such a build resolved to nothing. The old shape reached the filesystem through
	# `join_path(root, path)`, which produced a usable relative path from the same "".
	# a plain `if`, not a trailing one: this file is compiled BY THE SEED, which does not read an
	# if-expression in a binding
	mut at := dir
	if at == "" {
		at = "."
	}

	return false if not __zrt_exists(at)

	for e in __zrt_listdir(at) {
		return true if e == name
	}
	return false
}

fn module_one(file: str) -> list[str] {
	mut one: list[str] = []
	one.append(file)
	return one
}

# A `*_test.zg` IS NOT IN EITHER ANSWER. A normal build compiled them like every other file, so
# a test's declarations reached the shipped artifact and its `pub` ones joined the module's
# surface — `lib.only_in_test()` resolved and ran from a program that never asked for a test.
fn module_many(dir: str) -> list[str] {
	mut many: list[str] = []
	for name in __zrt_listdir(dir) {
		if has_suffix(name, ".zg") and not zerg.is_test_file(name) {
			many.append(join_path(dir, name))
		}
	}
	return many
}

# imp_under joins a root and a package path's parent, and it exists for the empty parent a
# single-segment path has: `join_path` would answer `<root>/`, and the next join makes that
# `<root>//<name>` — which works on every filesystem and appears in every diagnostic that
# names the file.
fn imp_under(root: str, parent: str) -> str {
	return root if parent == ""

	return join_path(root, parent)
}

# imp_parent is a package path without its last segment — "" for a single-segment path, which
# join_path leaves as the root itself.
fn imp_parent(path: str) -> str {
	segs := imp_segs(path)
	mut out := ""
	mut i := 0
	for i < segs.len() - 1 {
		if out != "" {
			out = out + "/"
		}
		out = out + segs[i]
		i = i + 1
	}
	return out
}

# path_tail is the last '/'-separated segment of an import path, which is the module's
# name.
fn path_tail(path: str) -> str {
	b := bytearray(path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# --- reading a source ---------------------------------------------------------------------

fn load_into(file: str, from_dir: str, mut &seen: list[str], mut &srcs: list[str], mut &paths: list[str], mut &mods: list[str]) {
	mut root: list[str] = []
	load_with(file, file, from_dir, seen, root, srcs, paths, mods, Buffer("", ""))
}

# Buffer is the one source the loader must NOT read from disk: the file a language server
# holds unsaved. An empty path means there is none, which is every build.
struct Buffer {
	pub path: str
	pub text: str
}

# load_with is load_into with that substitution, and it is the same function because the
# alternative is a second copy of the resolution rules — the part that actually decides what
# a program is — kept in step by hand.
#
# The buffer also decides whether a LEXICAL error is fatal. On a command line it is: nothing
# downstream can say anything true about text that does not tokenize, so `lex_check` reports
# and exits. In a server there is no exiting — the session is the process — so the unreadable
# source is skipped and `lex_diags` reports it to the editor instead.
# `stack` is the chain of MODULES on the way down to this file, and the cycle rule is asked of
# it for the reason `load_unit`'s is (unit.zg): this loader recurses per FILE and dedupes per file, so a
# module reached a second time is skipped and the loop never runs — which terminates the walk
# without noticing what it walked. The two loaders ask ONE function, so the rule and its
# sentence are in one place and cannot drift apart the way the walks themselves have to.
fn load_with(file: str, mod: str, from_dir: str, mut &seen: list[str], stack: list[str], mut &srcs: list[str], mut &paths: list[str], mut &mods: list[str], buf: Buffer) {
	for s in seen {
		return if s == file
	}
	seen.append(file)
	src := buffer_src(file, buf)
	if buf.path == "" {
		lex_check(src, file)
	} else if zerg.lex_diags(src, file).len() > 0 {
		return
	}

	# the pathed scan, so a refusal this parse raises names `file` rather than a line of
	# no file — the loader is the first parse a source meets
	for imd in zerg.import_decls_at(src, file) {
		im := imd.path
		chk_test_import(imd)
		chk_unbuilt_module(imd)
		chk_import_cycle(stack, im)
		mut here := stack
		here.append(im)
		for dep in module_files(imd, from_dir) {
			load_with(dep, im, from_dir, seen, here, srcs, paths, mods, buf)
		}
	}
	srcs.append(src)

	# appended HERE, not beside `seen`: a module's imports are loaded first, so `seen` is
	# in discovery order and `srcs` in dependency order, and only the second is the one a
	# path has to line up with
	paths.append(file)

	# and the MODULE it belongs to, in the same row. It is what the import RESOLVED to —
	# the written path for a dependency, the entry file itself for the program's own — and it
	# is the only place that fact is still known: by the time the trees are merged there is
	# nothing left to ask. `zerg/check.zg`'s `c_mod_of` is the reader.
	mods.append(mod)
}

# --- the program an open buffer belongs to -------------------------------------------------

# load_buffer loads the whole program an unsaved buffer belongs to. It is what `zerg lsp`
# hands the server, and the question it answers is NOT the one a command line asks.
#
# `zerg build f.zg` is told what the program is: `f.zg` is the entry, its directory is the
# second source root, and everything else follows. An editor says only WHICH FILE IS OPEN,
# and that file is usually not an entry at all — it is one member of a directory module,
# and its siblings are where its types come from. Reading it as an entry is what made the
# server underline correct code: the field `Parser.toks` reported E4056 no type named `Token`
# because `token.zg` sits beside `parser.zg` and no walk from `parser.zg` reaches it, and
# `import "zerg"` from `cmd/build.zg` reported E5002 cannot resolve because the `zerg/`
# directory is beside `cmd/` rather than inside it. Neither file is wrong; the walk started
# in the wrong place.
#
# SO IT LOOKS FOR THE ENTRY, rather than deciding for itself what module the buffer is in.
# That is the whole design decision, and the alternative — "load the buffer's directory as
# a module" — is wrong for THIS tree, twice over. `src/stdlib/` is a directory of .zg files
# that is not a module: each file in it is a module of its own, and merging them would put
# `os`, `time` and `strings` in one namespace. `examples/` is a directory of twenty
# PROGRAMS, each with its own `fn main`. Nothing local to a directory tells those apart
# from `src/compiler/cmd/`, because nothing local can: a directory is a module when
# something imports it, and only a walk from an entry knows that.
#
# The search is UPWARD and near-first: the .zg files directly in the parent of the buffer's
# directory, then its parent, and so on. The buffer's OWN directory is not searched, and
# that is not an oversight — a program whose entry sits beside the buffer reaches it by
# `import`, which makes the buffer a single-file module that already resolves everything it
# needs from where it stands. What needs the search is the other shape: a member of a
# directory module, whose entry is always outside that directory.
#
# THE CLIMB STOPS AT THE FIRST LEVEL THAT HOLDS ANY SOURCE, which is the policy for "several
# entries reach it" and for "none does" at once. The first directory above a module that
# holds .zg files at all is the program those modules belong to; if nothing there reaches
# the buffer, what is further up is another tree, and loading it would be a guess that costs
# a walk per file. Without the stop this runs to the filesystem root, and one directory
# somebody keeps scratch files in turns every keystroke into two hundred program loads.
#
# The FIRST candidate that reaches the buffer wins — sorted order within a level, nearest
# level first — so the answer never depends on the filesystem, and a program that reaches
# the buffer through only part of the tree is still enough: what the buffer needs is its own
# module and what that module imports, and anything reaching it carries both.
#
# WHAT COUNTS AS REACHING IT IS `load_with` ITSELF — the same walk, the same `module_files`,
# the same `module_at`. This function never asks whether a directory is a module; it asks
# whether a candidate entry's program contains this path, and the loader answers. That is
# the point: the server gets no second opinion about what a module is, so it cannot drift
# from the one `zerg build` holds.
#
# When nothing reaches the buffer it IS its own entry, which is what every stdlib module,
# every example and every test file is. That case is the old behaviour exactly, and it is
# deliberately the one path here that is NOT guarded: a buffer that does not parse must
# raise, because `ls_check` turns that raise into the diagnostic that says so, and a
# swallowed one is a server showing a clean file the compiler will not build.
fn load_buffer(path: str, text: str, mut &srcs: list[str], mut &paths: list[str], mut &mods: list[str]) {
	buf := Buffer(path, text)
	mut dir := dir_of(dir_of(path))
	for dir != "" and dir != "." {
		here := entry_files(dir)
		for entry in here {
			mut s: list[str] = []
			mut p: list[str] = []
			mut m: list[str] = []
			if entry_reaches(entry, path, buf, s, p, m) {
				srcs = s
				paths = p
				mods = m
				return
			}
		}
		break if here.len() > 0

		dir = dir_of(dir)
	}

	mut seen: list[str] = []
	mut stack: list[str] = []
	load_with(path, path, dir_of(path), seen, stack, srcs, paths, mods, buf)
}

# entry_files is the candidate entries directly in one directory: its `.zg` files, in the
# sorted order the runtime lists a directory in, so which program is chosen never depends on
# the filesystem.
#
# A `*_test.zg` is not a candidate. It is not an entry any normal build has — that is what
# `module_at` drops it for — and letting one be the program a module member is checked
# against would check that member against a build `zerg build` never performs.
fn entry_files(dir: str) -> list[str] {
	mut out: list[str] = []
	return out if not __zrt_exists(dir)

	for name in __zrt_listdir(dir) {
		if has_suffix(name, ".zg") and not zerg.is_test_file(name) {
			out.append(join_path(dir, name))
		}
	}
	return out
}

# entry_reaches loads the program `entry` names and answers whether `path` is one of its
# sources, leaving that program in `srcs` and `paths` when it is.
#
# GUARDED, and the failure is silence rather than a report. A candidate is a guess — it is
# whatever .zg file happened to be sitting in an ancestor directory — and a guess that
# refuses says nothing about the buffer: the file may be an unrelated program with a broken
# import of its own. So a candidate that raises is simply not the answer, and the search
# moves on to the next one and finally to the buffer alone, where a real refusal about the
# real file raises where the server can see it.
fn entry_reaches(entry: str, path: str, buf: Buffer, mut &srcs: list[str], mut &paths: list[str], mut &mods: list[str]) -> bool {
	mut seen: list[str] = []
	mut stack: list[str] = []
	mut ok := false
	guard {
		load_with(entry, entry, dir_of(entry), seen, stack, srcs, paths, mods, buf)
		ok = true
	}
	return false if not ok

	for p in paths {
		return true if p == path
	}
	return false
}

# read_source is the ONE place a file on disk becomes source text, and it exists because
# that step could KILL the compiler. `str(bytes)` checks the str invariant and aborts on a
# violation — `EncodingError: bytes are not valid UTF-8 for a str`, from the runtime, with no
# code, no place and no file named — so a single stray byte in any file the toolchain was
# pointed at ended the process before the lexer had read a character. `zerg build`, `zerg
# fmt`, `zerg desugar` and the language server all went the same way.
#
# GRAMMAR#letter says the source is UTF-8, so a file that is not is not a Zerg source file, and
# saying which file is the whole of the answer. That is why this carries no `-->` trailer:
# there is no line to name yet, the thing that would read one being what refused.
#
# THE READ IS OUTSIDE THE GUARD ON PURPOSE. A file that cannot be opened is a DIFFERENT
# failure and raises its own `IOError`, and a `guard` around both would report it as an
# encoding complaint about a file nobody could read — which `load_unit`, in `unit.zg`, has a
# paragraph about. The guard covers the conversion alone, which is the only thing in here
# that can abort. (That `IOError` says `cannot open file` and does not yet name the path it
# failed on, which is a gap in `io` rather than one here.)
fn read_source(path: str) -> str {
	b := io.read_file(path)

	mut src := ""
	mut ok := false
	guard {
		src = str(b)
		ok = true
	}
	raise zerg.rule_msg(zerg.Rule.SourceNotUtf8, f"`{path}` is not UTF-8 text, and a Zerg source file is UTF-8 text") if not ok

	return src
}

# buffer_src is the text of `file`: what the server is holding for it, or what the disk has.
fn buffer_src(file: str, buf: Buffer) -> str {
	return buf.text if file == buf.path
	return read_source(file)
}
