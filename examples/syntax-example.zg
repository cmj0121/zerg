# syntax-example.zg — a highlighting check for editors/nvim/syntax/zerg.vim.
# Open it in nvim (after `make install`) and confirm each token category lights up:
# comments, statement/declaration keywords, keyword-operators, built-in types,
# booleans, and the nil constant.

import io
pub import util/text        # re-export a module onto this package's public surface

init() {                    # lazy, exactly-once module setup (group 10)
    nop
}

# a strong-typedef over a built-in type
type UserId = int

# a product type; `#[derive(...)]` asks the compiler to generate the impls
#[derive(Encode, Decode)]
struct User {
    id:    UserId
    name:  str
    admin: bool = false        # field defaults feed the constructor
    email: str? = nil
}

# a sum type and a behavioral spec
enum Shape {
    Circle(float)
    Rect(float, float)
}

spec Summable {
    fn zero() -> This
    fn add(other: This) -> This        # `this` is implicit — not a parameter
}

# generics and impl (group 7)
enum Option[T] {
    Some(T)
    None
}
impl Summable for int {
    fn zero() -> This { return 0 }
    fn add(other: This) -> This { return this + other }   # this used, not declared
}

# a mutating method: `mut fn` marks that it changes the receiver in place
struct Counter { n: int }

spec Bumpable { mut fn bump() }

impl Bumpable for Counter {
    mut fn bump() { this.n = this.n + 1 }   # needs a `mut` binding at the call site
}

# the empty-statement placeholder
fn noop() { nop }

# defaults, named arguments, and a closure (group 5)
fn greet(name: str, greeting: str = "Hello", loud: bool = false) -> str {
    return f"{greeting}, {name}"
}

fn demo() {
    # TODO: cover the error operators once that group lands
    print greet("Sam", loud: true)      # named argument skips `greeting`
    double := fn(x: int) -> int { return x *% 2 }
    print f"{double(21)}"
    (q, r) := divmod(21, 4)             # tuple-destructuring bind
    print f"{q} rem {r}"

    pi := 3.14159
    print f"pi={pi:.2f} hex={q:#04x} {r=} debug={q!r}"   # Python-style format holes
}

# literals of every kind (group 3)
fn literals() {
    count := 1_000_000         # int, with digit grouping
    mask  := 0xDE_AD_BE_EF     # hex int
    perms := 0o755             # octal int
    flags := 0b1010            # binary int
    ratio := 6.022e23          # float
    tab   := '\t'              # rune
    ch    := b'a'              # byte
    hi    := "line\n"          # str with an escape
    path  := r"C:\tmp\new"     # raw str — backslashes are literal

    hash  := mask *% 31 +% count       # wrapping arithmetic
    bits  := flags << 2 | 0b1          # bitwise
    ok    := ratio >= 6.0 and count != 0
    nop
}

# composite construction (group 4/7): constructors, tuple, list, map, set
fn composites() -> User {
    u    := User(id: 1, name: "Sam", admin: true)   # struct constructor, named args
    root := User(id: 2, name: "Root")               # admin/email take their defaults

    (q, r) := divmod(21, 4)            # tuple destructure...
    pair   := (q, r)                   # ...and tuple construction

    nums  := [1, 2, 3]                 # list literal
    ages  := {"sam": 30, "ada": 28}    # map literal
    blank := {:}                       # empty map
    uniq  := set([1, 1, 2, 3])         # set through its constructor
    none  := set()                     # empty set

    print f"{pair} {nums} {ages} {uniq} {root.name}"
    return u
}

# a generic function: the `T: Summable` bound lets the body call Summable's methods on T
fn sum_all[T: Summable](xs: list[T]) -> T {
    mut acc := T.zero()
    for x in xs {
        acc = acc.add(x)
    }
    return acc
}

pub fn describe(u: User) -> str {
    mut loud  := false
    mut label := u.name

    if u.admin or loud {
        label = f"admin:{label}"
    } else {
        nop
    }

    print f"describe -> {label}"       # print + f-string interpolation
    return label
}

fn total(shapes: list[Shape]) -> float {
    mut acc := 0.0
    for s in shapes {
        continue if s is Circle
        acc = acc + area(s)
    }
    return acc
}

# bare block scopes a value; `with` binds a scoped resource, torn down on exit
fn process(path: str) {
    {
        tmp := 1_000           # scoped to this block, freed at its `}`
        print f"{tmp}"
    }
    with open(path) as f {     # f's Scoped teardown runs on every exit
        for line in f.read() { print line }
    }
}

# concurrency, pattern matching, and error handling
# coroutines & channels (group 9)
fn fanin(work: <-chan[int]) {
    ch := chan[int](64)                 # buffered channel, capacity 64
    spawn produce(ch.send)              # fire-and-forget producer
    ch <- 42                            # send a value
    first := <-ch!                      # receive, then force-unwrap
    for {
        select {
            v := <-work -> use(v)       # receive arm binds a value
            ch <- 0     -> nop          # send arm
            done        -> break        # every watched receive channel closed
            _           -> nop          # nothing ready now — non-blocking
        }
    }
}

# resource cleanup (group 11)
fn drain(ch: chan[int]) {
    defer report("drained")    # runs at block exit, on every path (incl. abort)
    for v in ch { use(v) }
    del ch                     # drop our hold now — closes if we were the last sender
}

# null-safety & errors (group 8)
fn load(path: str) -> Result[Config] {
    txt  := read_file(path)?                   # propagate: a Right early-returns
    port := lookup("PORT") ?? 8080             # default when absent
    host := cfg?.server?.host ?? "localhost"   # optional chain, then default
    n    := guard { parse_int(txt) } ?? 0      # demote abort -> value, then default
    key  := lookup("HOME") ?? raise MissingKey # diverge: raise instead of a value
    user := lookup("USER")!                    # force-unwrap or raise UnwrapError
    if n < 0 {
        raise RangeError from BadInput         # value -> abort, recording a cause
    }
    return parse(txt)
}

fn serve(inbox: <-chan[Shape]) {          # receive-only channel (a receiver)
    defer io.stdout.write_str("done")

    for {
        cmd := <-inbox ?? break
        result := guard { render(cmd) }

        match result {
            Left(ok) -> spawn publish(ok)
            Right(e) -> raise e
            _        -> nil
        }
    }
}

# program entry point (group 10) — main is an ordinary function, not reserved
fn main(args: list[str]) -> Result[nil] {
    print f"args: {args}"
    return nil
}
