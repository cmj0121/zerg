# 08 — Loops.
#
#   for cond { ... }   repeat while `cond` (a bool) holds  (a "while")
#   for { ... }        loop forever; leave it with `break`
# `continue` skips to the next iteration.
fn main() {
    # count up while a condition holds
    mut i := 0
    for i < 5 {
        print i              # 0 1 2 3 4
        i = i + 1
    }

    # count down with an infinite loop and `break`
    mut c := 3
    for {
        if c == 0 {
            break
        }
        print c              # 3 2 1
        c = c - 1
    }
}
