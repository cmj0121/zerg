# The `json` suite — every `pub` function, and the two properties this module is used FOR.
#
# WHITE-BOX, for the reason src/stdlib/strings_test.zg sets out: this file is a file of the
# `json` module, so the private writer and reader (`jw_str`, `jp_uescape`, `jp_num`) are in
# scope. Most of what is below still goes through `encode` and `decode`, because that is the
# path a caller takes and a property asserted at the surface is a property the module HAS —
# but the escaper's own table is asked directly, where the surface can only show it a
# character at a time.
#
# THE MODULE HAD NO SUITE FOR ITS WHOLE LIFE. It was `src/compiler/lsp/json.zg`, and what
# held it was `make lsp` — 15 protocol cases going through a server, which exercises the
# escaper on whatever a fixture happened to contain and asserts nothing about it directly.
# That is the position a module leaves when it becomes a `pub` surface: the claims have to
# be asked one at a time, especially the ones the LSP never happened to send.
#
# TWO PROPERTIES ARE WHAT THIS IS FOR, and they are why the module was promoted:
#
#   THE ESCAPER. `encode` is the only escaping implementation in the tree — the language
#   server and the logger share it precisely so a second one cannot drift. Every byte JSON
#   names is asked here, individually, plus the ones it does NOT name, because escaping too
#   much is as wrong as escaping too little and no gate would notice.
#
#   THE ROUND TRIP. `decode(encode(v))` has to give the value back, and the places it does
#   NOT are stated rather than discovered: a fraction is dropped, and an escape decodes to
#   the character it stands for.
import (
	"strings"
	"testing"
)

# --- encode: the escaper --------------------------------------------------------------

# THE TWO CHARACTERS JSON RESERVES. A quote closes the string and a backslash begins an
# escape, so an unescaped one of either produces a document that does not parse — the one
# failure mode that turns a log line into a syntax error in somebody's pipeline.
#[test]
fn test_encode_escapes_quote_and_backslash() {
	assert encode(of_str("say \"hi\"")) == "\"say \\\"hi\\\"\""
	assert encode(of_str("C:\\tmp")) == "\"C:\\\\tmp\""
	assert encode(of_str("\\\"")) == "\"\\\\\\\"\""
}

# THE FIVE SHORT ESCAPES, each on its own so a failure names the byte. `\b` and `\f` are the
# two nobody writes and the two a hand-rolled escaper forgets; they are bytes 8 and 12, and
# a byte below 0x20 with no short form has to come out as `\u00XX` instead.
#[test]
fn test_encode_short_escapes(ctx: testing.Context) {
	ctx.log("newline, return, tab — the three a source file and a diagnostic carry routinely")
	assert encode(of_str("\n")) == "\"\\n\""
	assert encode(of_str("\r")) == "\"\\r\""
	assert encode(of_str("\t")) == "\"\\t\""

	ctx.log("backspace (8) and form feed (12) — the two with short forms nobody writes")
	assert encode(of_str(str([byte(8)]))) == "\"\\b\""
	assert encode(of_str(str([byte(12)]))) == "\"\\f\""
}

# A CONTROL BYTE WITH NO SHORT FORM goes out as `\u00XX`, lower-case hex, four digits. The
# boundary is what this is really asking: 0x1F must be escaped and 0x20 (a space) must not.
#[test]
fn test_encode_control_bytes_as_u00xx() {
	assert encode(of_str(str([byte(1)]))) == "\"\\u0001\""
	assert encode(of_str(str([byte(15)]))) == "\"\\u000f\""
	assert encode(of_str(str([byte(26)]))) == "\"\\u001a\""
	assert encode(of_str(str([byte(31)]))) == "\"\\u001f\""

	# 0x20 is a space and is ordinary text. One byte higher and the rule changes.
	assert encode(of_str(str([byte(32)]))) == "\" \""
}

# ESCAPING TOO MUCH IS ALSO WRONG, and it is the half a test suite usually leaves out. JSON
# does not require `/` to be escaped and does not require a code point above ASCII to be —
# a UTF-8 string is already legal JSON text. An escaper that "played safe" here would double
# the size of every diagnostic this project prints and would still be correct-looking.
#[test]
fn test_encode_leaves_alone_what_json_does_not_reserve(ctx: testing.Context) {
	ctx.log("a solidus is ordinary; escaping it is legal JSON and is not what this does")
	assert encode(of_str("a/b")) == "\"a/b\""

	ctx.log("UTF-8 passes through as its own bytes — this is what carries a diagnostic's em-dash")
	assert encode(of_str("日本語")) == "\"日本語\""
	assert encode(of_str("café — 😀")) == "\"café — 😀\""
}

# --- encode: the shapes ------------------------------------------------------------------

#[test]
fn test_encode_scalars() {
	assert encode(null()) == "null"
	assert encode(of_str("")) == "\"\""
	assert encode(decode("true")) == "true"
	assert encode(decode("false")) == "false"
	assert encode(decode("0")) == "0"
	assert encode(decode("-9007199254740993")) == "-9007199254740993"
}

#[test]
fn test_encode_list() {
	mut xs: list[Val] = []
	assert encode(of_list(xs)) == "[]"

	xs.append(of_str("a"))
	xs.append(null())
	assert encode(of_list(xs)) == "[\"a\",null]"

	# Nesting, because an array of arrays is where a comma-placement bug shows up.
	mut outer: list[Val] = []
	outer.append(of_list(xs))
	outer.append(of_list(xs))
	assert encode(of_list(outer)) == "[[\"a\",null],[\"a\",null]]"
}

# THE FIELD ORDER IS THE ORDER THEY WERE PUT, and that is the module's stated reason for a
# list of fields rather than a map: the bytes are a function of the value alone, so a
# transcript or a log line can be diffed. A hash would make this test flaky and the property
# untrue.
#[test]
fn test_encode_object_keeps_field_order() {
	mut fs: list[Field] = []
	assert encode(of_obj(fs)) == "{}"

	put_str(fs, "b", "1")
	put_int(fs, "a", 2)
	put_bool(fs, "c", true)
	assert encode(of_obj(fs)) == "{\"b\":\"1\",\"a\":2,\"c\":true}"

	# Reversed input, reversed output — which is the claim. Same three keys.
	mut rev: list[Field] = []
	put_bool(rev, "c", true)
	put_int(rev, "a", 2)
	put_str(rev, "b", "1")
	assert encode(of_obj(rev)) == "{\"c\":true,\"a\":2,\"b\":\"1\"}"
}

# A KEY IS ESCAPED LIKE A VALUE. It is the same writer, and it is worth one test because a
# key is the string an implementation is most tempted to write out raw.
#[test]
fn test_encode_escapes_keys_too() {
	mut fs: list[Field] = []
	put_int(fs, "a\"b\n", 1)
	assert encode(of_obj(fs)) == "{\"a\\\"b\\n\":1}"
}

#[test]
fn test_put_builds_a_nested_value() {
	mut inner: list[Field] = []
	put_str(inner, "k", "v")

	mut fs: list[Field] = []
	put(fs, "o", of_obj(inner))
	assert encode(of_obj(fs)) == "{\"o\":{\"k\":\"v\"}}"
}

# --- decode -------------------------------------------------------------------------------

#[test]
fn test_decode_scalars() {
	assert is_null(decode("null"))
	assert as_int(decode("42")) == 42
	assert as_int(decode("-42")) == -42
	assert as_int(decode("0")) == 0
	assert as_str(decode("\"hi\"")) == "hi"
	assert as_str(decode("\"\"")) == ""
}

# WHITESPACE IS SKIPPED EVERYWHERE a value can begin or end — around the whole document,
# around a colon, around a comma. A reader that handles only the outer case works on every
# machine-written document and fails on the first hand-written one.
#[test]
fn test_decode_skips_whitespace_everywhere() {
	v := decode(" \t\r\n { \"a\" : [ 1 , 2 ] , \"b\" : { \"c\" : 3 } } \n ")
	assert as_list(get(v, "a")).len() == 2
	assert as_int(walk(v, "b", "c")) == 3
}

#[test]
fn test_decode_empty_object_and_array() {
	assert encode(decode("{}")) == "{}"
	assert encode(decode("[]")) == "[]"
	assert encode(decode("[ ]")) == "[]"
	assert as_list(decode("[]")).len() == 0
}

# THE ESCAPES COME BACK AS THE CHARACTERS THEY STAND FOR, which is what makes the round trip
# below not byte-identical — and is right: `\u0041` and `A` are the same string.
#
# EVERY ESCAPE THE WRITER PRODUCES IS ASKED BACK, one per line, which is what makes this the
# other half of the escaper tests rather than a sample of them: a decoder missing one of the
# six turns exactly one byte into something else, everywhere, forever. (`\r` was missing from
# this list when it was written, and a mutation that deleted the decoder's `\r` case left the
# whole suite green — which is the reason each is now its own line.)
#[test]
fn test_decode_string_escapes() {
	assert as_str(decode("\"a\\nb\"")) == "a\nb"
	assert as_str(decode("\"a\\rb\"")) == "a\rb"
	assert as_str(decode("\"a\\tb\"")) == "a\tb"
	assert as_str(decode("\"a\\bb\"")) == f"a{str([byte(8)])}b"
	assert as_str(decode("\"a\\fb\"")) == f"a{str([byte(12)])}b"
	assert as_str(decode("\"a\\\"b\"")) == "a\"b"
	assert as_str(decode("\"a\\\\b\"")) == "a\\b"
	assert as_str(decode("\"a\\/b\"")) == "a/b"
	assert as_str(decode("\"\\u0041\"")) == "A"

	# The writer's output is the reader's input: every short escape survives a round trip.
	assert encode(decode("\"\\r\\n\\t\\b\\f\"")) == "\"\\r\\n\\t\\b\\f\""
}

# A SURROGATE PAIR IS ONE CODE POINT. A client sending an emoji sends `\ud83d\ude00`, and a
# reader that decoded each half on its own would produce two invalid sequences — text that
# is no longer UTF-8 at all. This is the case a compiler's diagnostics never produce and a
# person's source file does.
#[test]
fn test_decode_surrogate_pair(ctx: testing.Context) {
	ctx.log("U+1F600, written as the two halves JSON requires")
	assert as_str(decode("\"\\ud83d\\ude00\"")) == "😀"

	ctx.log("and the three shorter UTF-8 widths, so every branch of the encoder is asked")
	assert as_str(decode("\"\\u0041\"")) == "A"
	assert as_str(decode("\"\\u00e9\"")) == "é"
	assert as_str(decode("\"\\u65e5\"")) == "日"
}

# A NUMBER IS AN INTEGER AND THE FRACTION IS DROPPED. This is the module's one silent
# behaviour and the reason it is stated in the header, at `decode` and in the docs: a caller
# who reads `1.9` as `1` and is not told will find out from a wrong answer. Asserting it
# here is what makes it a documented decision rather than an accident nobody measured.
#[test]
fn test_decode_number_is_an_integer(ctx: testing.Context) {
	ctx.log("a fraction is consumed and dropped, NOT rounded and NOT refused")
	assert as_int(decode("1.9")) == 1
	assert as_int(decode("-1.9")) == -1
	assert as_int(decode("0.5")) == 0

	ctx.log("an exponent goes the same way — `1e3` is one, not a thousand")
	assert as_int(decode("1e3")) == 1
	assert as_int(decode("2E+8")) == 2

	ctx.log("and the tail is CONSUMED, so what follows it still parses")
	assert as_list(decode("[1.5, 2]")).len() == 2
	assert as_int(walk(decode("{\"a\":{\"b\":1.25}}"), "a", "b")) == 1
}

# --- decode: what it refuses ---------------------------------------------------------------
#
# It RAISES rather than answering a partial value, which is the whole reason a caller can
# trust what comes back. Each of these is a different place in the reader.

#[test]
fn test_decode_refuses_malformed_input(ctx: testing.Context) {
	ctx.log("nothing at all, and nothing but space")
	testing.assert_raises(guard { decode("") })
	testing.assert_raises(guard { decode("   ") })

	ctx.log("a byte that begins no value")
	testing.assert_raises(guard { decode("oops") })
	testing.assert_raises(guard { decode("]") })

	ctx.log("an unfinished container")
	testing.assert_raises(guard { decode("{") })
	testing.assert_raises(guard { decode("[1,") })
	testing.assert_raises(guard { decode("{\"a\":1") })

	ctx.log("an object whose key is not a string, and one with no colon")
	testing.assert_raises(guard { decode("{a:1}") })
	testing.assert_raises(guard { decode("{\"a\" 1}") })

	ctx.log("a string that never closes, and one ending inside an escape")
	testing.assert_raises(guard { decode("\"abc") })
	testing.assert_raises(guard { decode("\"abc\\") })

	ctx.log("a sign with no digit, and a literal that is only a prefix")
	testing.assert_raises(guard { decode("-") })
	testing.assert_raises(guard { decode("tru") })
}

# --- the accessors are TOTAL ----------------------------------------------------------------
#
# The module's stated contract: asking a value of the wrong shape gives a default, never an
# abort, because the input comes from another program. Every accessor is asked with a value
# of a kind it is not for.

#[test]
fn test_accessors_are_total() {
	n := decode("42")
	assert as_str(n) == ""
	assert as_list(n).len() == 0
	assert is_null(get(n, "anything"))

	s := decode("\"text\"")
	assert as_int(s) == 0
	assert as_list(s).len() == 0

	empty := decode("{}")
	assert as_int(empty) == 0
	assert as_str(empty) == ""
	assert is_null(get(empty, "missing"))
	assert not has(empty, "missing")
}

#[test]
fn test_get_and_has() {
	v := decode("{\"a\": 1, \"b\": null, \"c\": \"\"}")
	assert as_int(get(v, "a")) == 1
	assert has(v, "a")

	# A KEY PRESENT WITH A `null` READS AS ABSENT, because `get` is total and `has` is
	# written on top of it. That is a real limit of a total accessor and it is asserted here
	# rather than left for a caller to trip over.
	assert is_null(get(v, "b"))
	assert not has(v, "b")

	# An empty string, by contrast, is present — absence is `null`, not falseness.
	assert has(v, "c")
	assert as_str(get(v, "c")) == ""

	# The FIRST field of a repeated key wins, which is what a linear scan gives.
	assert as_int(get(decode("{\"k\":1,\"k\":2}"), "k")) == 1
}

#[test]
fn test_walk_and_walk3() {
	v := decode("{\"a\": {\"b\": {\"c\": \"z\"}}}")
	assert as_str(walk3(v, "a", "b", "c")) == "z"
	assert as_str(get(walk(v, "a", "b"), "c")) == "z"

	# A path that leaves the object part way through answers `null` rather than aborting —
	# the totality of `get`, one level up.
	assert is_null(walk(v, "a", "nope"))
	assert is_null(walk3(v, "nope", "b", "c"))
	assert is_null(walk3(v, "a", "b", "nope"))
}

#[test]
fn test_as_list_elements() {
	xs := as_list(decode("[1, \"two\", null, [3]]"))
	assert xs.len() == 4
	assert as_int(xs[0]) == 1
	assert as_str(xs[1]) == "two"
	assert is_null(xs[2])
	assert as_list(xs[3]).len() == 1
}

# --- the round trip -------------------------------------------------------------------------

# `decode(encode(v))` gives the value back. It is asserted as `encode(decode(encode(v)))`,
# comparing TEXT, because two `json.Val`s cannot be compared — the enum has no `Eq` — and
# the text is the thing callers actually depend on anyway.
#[test]
fn test_round_trip_is_stable() {
	mut fs: list[Field] = []
	put_str(fs, "msg", "a \"quoted\" line\nwith\ttabs")
	put_int(fs, "n", -12)
	put_bool(fs, "ok", false)
	put(fs, "xs", of_list([of_str("日本語"), null()]))

	once := encode(of_obj(fs))
	assert encode(decode(once)) == once

	# And the text is what a reader would write by hand.
	assert strings.contains(once, "\"msg\":\"a \\\"quoted\\\" line\\nwith\\ttabs\"")
	assert strings.contains(once, "\"n\":-12")
	assert strings.contains(once, "\"xs\":[\"日本語\",null]")
}

# THE TWO PLACES THE ROUND TRIP IS NOT BYTE-IDENTICAL, stated rather than discovered. Both
# are the decoder normalising, and both are correct — but a caller diffing a transcript
# needs to know which direction is stable.
#[test]
fn test_round_trip_normalises_escapes_and_drops_fractions(ctx: testing.Context) {
	ctx.log("an escape decodes to its character and re-encodes as UTF-8")
	assert encode(decode("\"\\u00e9\"")) == "\"é\""
	assert encode(decode("\"\\u0041\"")) == "\"A\""

	ctx.log("a fraction is gone for good — text to value is lossy, value to text is not")
	assert encode(decode("1.5")) == "1"
}
