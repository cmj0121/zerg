# ignore — what a walk is told not to enter, and the first pattern matcher this toolchain has.
#
# A walk that reads a whole tree needs to be told what is not source. Two files can say so, and
# ONE OF THEM IS READ, never both:
#
#   `.zergignore` at the walk root  ->  it, and `.gitignore` is not consulted
#   no `.zergignore`                ->  `.gitignore`
#
# REPLACE, NOT LAYER, because two files that both apply need an order between them, and an
# order is the half of `.gitignore` that makes an ignore file unreadable. One source of truth
# at a time costs a repository that adds a `.zergignore` the patterns its `.gitignore` was
# excluding — which is a sentence in the documentation, not a surprise, and here it costs
# nothing at all: `/bin/`, `/.zerg-cache/` and `/dist/` hold no `.zg`.
#
# THE FILE IS READ AT THE WALK ROOT ONLY. `.gitignore` allows one per directory, and per-
# directory files bring `!` negation and layer-by-layer override with them. That is a matcher
# with a history, not a lookup.
#
# THE SYNTAX IS A DEFINED SUBSET AND THE REST IS REFUSED BY NAME. Reading half of
# `.gitignore`'s language and treating the other half as literal text is the failure this
# repository has a name for: a rule that silently means something other than what it says. A
# walk whose scope nobody can predict is a gate whose scope nobody can predict.
#
#   name       matches that name at any depth
#   name/      matches a directory only
#   /name      anchored at the walk root, and may hold `/`
#   *          any run of characters WITHIN one path segment
#   # …        a comment, and a blank line is nothing
#
#   !name      REFUSED — last-match-wins ordering is what makes an ignore file unreadable
#   **         REFUSED — until a case needs it, and then it is a decision rather than a default
#
# The refusals carry no CODE, and that is deliberate: a code is asserted by `refuse-check` or
# `reject-check`, both of which hold PROGRAMS, and an ignore file is not one. They carry what
# the contract actually asks for — a NAME for what went wrong, the file it is in, and the line
# — in the shape `zerg test` and `zerg fmt` already answer a path with.

import (
	"io"
	"strconv"
)

# Ignore is a parsed ignore file. An empty one matches nothing, which is what a walk with no
# ignore file has — so the walk asks the same question either way and has no second path.
struct Ignore {
	pub pats: list[Pat]
}

# Pat is one line of it, already taken apart. Keeping the three questions as fields rather than
# re-reading the text at each entry is what keeps the walk's inner loop about the walk.
struct Pat {
	pub text: str
	pub anchored: bool
	pub dir_only: bool
}

# ignore_none is the empty answer — no file, nothing excluded.
fn ignore_none() -> Ignore {
	mut pats: list[Pat] = []
	return Ignore(pats)
}

# ignore_at loads the ignore file that governs a walk rooted at `dir`.
fn ignore_at(dir: str) -> Ignore {
	zg := join_path(dir, ".zergignore")
	return ignore_read(zg) if exists(zg)

	git := join_path(dir, ".gitignore")
	return ignore_read(git) if exists(git)

	return ignore_none()
}

fn ignore_read(path: str) -> Ignore {
	mut pats: list[Pat] = []
	mut n := 0
	for raw in lines_of(str(io.read_file(path))) {
		n = n + 1
		line := trim_ws(raw)
		continue if line == "" or has_prefix(line, "#")

		ignore_refuse(path, n, line)

		anchored := has_prefix(line, "/")
		dir_only := has_suffix(line, "/")

		mut lo := 0
		mut hi := byte_len(line)
		if anchored {
			lo = 1
		}
		if dir_only {
			hi = hi - 1
		}
		body := slice_str(line, lo, hi)

		continue if body == ""

		pats.append(Pat(body, anchored, dir_only))
	}
	return Ignore(pats)
}

# ignore_refuse turns away the two forms this reads and will not pretend to understand. The
# message names the file, the line and the pattern, because a reader whose walk skipped the
# wrong thing has no other way to find which line did it.
fn ignore_refuse(path: str, n: int, line: str) {
	raise f"{path}:{strconv.to_string(n, 10)}: `{line}` — a `!` pattern is not read by this toolchain. It re-includes what an earlier line excluded, and the last-match-wins ordering that needs is what makes an ignore file unreadable; write the narrower pattern instead" if has_prefix(line, "!")

	raise f"{path}:{strconv.to_string(n, 10)}: `{line}` — `**` is not read by this toolchain. A bare name already matches at any depth, and an anchored one names the place it means" if has_double_star(line)
}

# ignore_hit reports whether an entry is excluded. `rel` is the entry's path relative to the
# walk root — `deep/b.zg` — and `is_dir_entry` is what a trailing `/` asks about.
fn ignore_hit(ig: Ignore, rel: str, is_dir_entry: bool) -> bool {
	for p in ig.pats {
		continue if p.dir_only and not is_dir_entry

		if p.anchored {
			return true if glob_match(p.text, rel)
			continue
		}

		# A BARE NAME MATCHES AT ANY DEPTH, so it is asked of the last segment. The whole
		# relative path is not the question: `build` means every `build`, wherever it sits,
		# and a reader who meant one of them writes `/a/build`.
		return true if glob_match(p.text, path_tail(rel))
	}
	return false
}

# `lines_of` is cmd/test.zg's, and it is USED rather than copied — one module, one namespace,
# so a second one would be the collision below in miniature.
#
# THE HELPERS BELOW ARE LOCAL COPIES, and that is the tree's existing answer rather than
# a shortcut: `parser.zg` carries `strings_has_prefix` and `layout.zg` carries `has_suffix` for
# the same reason. Importing `strings` here is refused by the compiler — E9081, two modules both
# defining `has_suffix` — because every module flattens into one namespace, so an import written
# in ONE file of `cmd` collides for all of them. That is the deviation #57 closes; until it does,
# a module that wants three functions writes three functions.
fn byte_len(s: str) -> int {
	b := bytearray(s)
	return b.len()
}

fn slice_str(s: str, lo: int, hi: int) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	mut i := lo
	for i < hi {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn trim_ws(s: str) -> str {
	b := bytearray(s)
	mut lo := 0
	for lo < b.len() and (b[lo] == b' ' or b[lo] == byte(9) or b[lo] == byte(13)) {
		lo = lo + 1
	}
	mut hi := b.len()
	for hi > lo and (b[hi - 1] == b' ' or b[hi - 1] == byte(9) or b[hi - 1] == byte(13)) {
		hi = hi - 1
	}
	return slice_str(s, lo, hi)
}

fn has_double_star(s: str) -> bool {
	b := bytearray(s)
	mut i := 1
	for i < b.len() {
		return true if b[i] == b'*' and b[i - 1] == b'*'
		i = i + 1
	}
	return false
}

# glob_match is `*` within one segment, and nothing else. It is the iterative wildcard match:
# a `*` records where it was and how much it had eaten, and a later mismatch feeds it one more
# character rather than searching again from the start.
#
# `*` DOES NOT CROSS A `/` in a pattern that has one, because a segment is the unit a path is
# made of — which is also why `**` is refused rather than approximated here.
fn glob_match(pat: str, s: str) -> bool {
	p := bytearray(pat)
	t := bytearray(s)

	mut pi := 0
	mut ti := 0
	mut star := 0 - 1
	mut eaten := 0

	for ti < t.len() {
		if pi < p.len() and p[pi] == b'*' {
			star = pi
			eaten = ti
			pi = pi + 1
		} else if pi < p.len() and p[pi] == t[ti] {
			pi = pi + 1
			ti = ti + 1
		} else if star >= 0 and t[ti] != b'/' {
			pi = star + 1
			eaten = eaten + 1
			ti = eaten
		} else {
			return false
		}
	}

	for pi < p.len() and p[pi] == b'*' {
		pi = pi + 1
	}
	return pi == p.len()
}
