# 23 — The three collections this compiler builds: `list`, `map`, and `[T; N]`.
#
# A `list` grows (`append`) only when the binding is `mut`. A `map` is keyed by
# `int` or `str` in this phase. An array's length is part of its type, so it
# neither grows nor shrinks. `set` is refused by name (E9064) and is not here.
fn main() {
	mut xs := [1, 2]
	xs.append(3)
	print xs.len()
	print xs[1]

	m := {"a": 10, "b": 20}
	print m["a"]
	print m.has("z")
	print m.len()

	a: [int; 3] = [7, 8, 9]
	print a[2]
	print a.len()
}
