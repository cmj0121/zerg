# cli — command-line parsing, and the help text that comes with it.
#
# A tool's argument handling is the first thing its users meet and the last thing anyone
# wants to write twice, so this is a module rather than a habit each program repeats. It
# parses what a POSIX-ish tool accepts — `-o value`, `--output value`, `--output=value`,
# bundled short flags, a `--` that ends option parsing — and renders `--help` from the
# same option list it parsed with, so the help can never drift from the behaviour.
#
# It stays inside the language's own subset: no closures, no maps, no optionals. Results
# come back in parallel lists, read through `get`/`has`/`value_or`, which is why the API
# is a handful of small functions rather than a builder.

# Opt is one option's declaration: its long name (without `--`), its short letter (without
# `-`, "" when it has none), whether it takes a value, and the one-line help.
pub struct Opt {
	long: str
	short: str
	takes_value: bool
	help: str
}

# opt declares a value-taking option; flag declares a boolean one.
pub fn opt(long: str, short: str, help: str) -> Opt {
	return Opt(long, short, true, help)
}

pub fn flag(long: str, short: str, help: str) -> Opt {
	return Opt(long, short, false, help)
}

# Parsed is the result: the options seen (names parallel to values, "" for a boolean), the
# positional arguments in order, and the first usage error. A caller checks `err` before
# anything else — a half-understood command line is worth refusing, not guessing at.
pub struct Parsed {
	names: list[str]
	values: list[str]
	args: list[str]
	err: str
}

# parse_argv reads argv (WITHOUT the program name — that is what `fn main(args)`
# receives) against a list of declared options.
#
# The name is `parse_argv`, not `parse`: every module in a program shares one flat scope,
# so a stdlib function called `parse` would collide with any program that has its own —
# and the compiler's own front end does. Names in a shared module have to be specific.
pub fn parse_argv(argv: list[str], opts: list[Opt]) -> Parsed {
	mut p := Parsed([], [], [], "")
	mut only_args := false
	mut i := 0
	for i < argv.len() {
		a := argv[i]
		if only_args {
			p.args.append(a)
		} else if a == "--" {
			only_args = true
		} else if is_long(a) {
			i = parse_long(a, argv, i, opts, p)
		} else if is_short(a) {
			i = parse_short(a, argv, i, opts, p)
		} else {
			p.args.append(a)
		}
		if p.err != "" {
			return p
		}
		i = i + 1
	}
	return p
}

# parse_long handles `--name` and `--name=value`, returning the index it consumed to.
fn parse_long(a: str, argv: list[str], i: int, opts: list[Opt], mut &p: Parsed) -> int {
	body := drop_prefix(a, 2)
	name := before_eq(body)
	o := find_long(opts, name)
	if o.long == "" {
		p.err = "unknown option --" + name
		return i
	}
	if not o.takes_value {
		if has_eq(body) {
			p.err = "option --" + name + " takes no value"
			return i
		}
		record(p, o.long, "")
		return i
	}
	if has_eq(body) {
		record(p, o.long, after_eq(body))
		return i
	}
	if i + 1 >= argv.len() {
		p.err = "option --" + name + " needs a value"
		return i
	}
	record(p, o.long, argv[i + 1])
	return i + 1
}

# parse_short handles `-o value` and bundled boolean flags like `-abc`. A value-taking
# option ends the bundle, so `-o out` works and `-ao out` does too.
fn parse_short(a: str, argv: list[str], i: int, opts: list[Opt], mut &p: Parsed) -> int {
	letters := list[byte](drop_prefix(a, 1))
	mut j := 0
	mut at := i
	for j < letters.len() {
		mut one: list[byte] = []
		one.append(letters[j])
		s := str(one)
		o := find_short(opts, s)
		if o.long == "" {
			p.err = "unknown option -" + s
			return at
		}
		if not o.takes_value {
			record(p, o.long, "")
			j = j + 1
		} else if j + 1 < letters.len() {
			# the rest of the bundle is the value: `-oout`
			mut rest: list[byte] = []
			mut k := j + 1
			for k < letters.len() {
				rest.append(letters[k])
				k = k + 1
			}
			record(p, o.long, str(rest))
			return at
		} else if at + 1 < argv.len() {
			record(p, o.long, argv[at + 1])
			return at + 1
		} else {
			p.err = "option -" + s + " needs a value"
			return at
		}
	}
	return at
}

fn record(mut &p: Parsed, long: str, value: str) {
	p.names.append(long)
	p.values.append(value)
}

# --- reading the result ------------------------------------------------------------------

# has reports whether an option was given at all.
pub fn has(p: Parsed, long: str) -> bool {
	for n in p.names {
		if n == long {
			return true
		}
	}
	return false
}

# get returns an option's value, or "" when it was not given. A repeated option keeps the
# LAST value, which is what a user expects from `zerg build --emit c --emit bin`.
pub fn get(p: Parsed, long: str) -> str {
	mut out := ""
	mut i := 0
	for i < p.names.len() {
		if p.names[i] == long {
			out = p.values[i]
		}
		i = i + 1
	}
	return out
}

# value_or returns an option's value, or fallback when it was not given.
pub fn value_or(p: Parsed, long: str, fallback: str) -> str {
	if has(p, long) {
		return get(p, long)
	}
	return fallback
}

# --- help ---------------------------------------------------------------------------------

# usage renders the help text from the same options the parser was given, so the two
# cannot disagree. `head` is the summary line, `body` any extra sections the caller wants
# printed after the options (commands, environment variables); either may be "".
pub fn usage(head: str, opts: list[Opt], body: str) -> str {
	mut out := head
	if opts.len() > 0 {
		out = out + "\nOptions:\n"
		for o in opts {
			out = out + "  " + opt_label(o) + pad(opt_label(o), 22) + o.help + "\n"
		}
	}
	if body != "" {
		out = out + body
	}
	return out
}

# opt_label renders an option's invocation: `-o, --output VALUE`.
fn opt_label(o: Opt) -> str {
	mut s := ""
	if o.short != "" {
		s = "-" + o.short + ", "
	} else {
		s = "    "
	}
	s = s + "--" + o.long
	if o.takes_value {
		s = s + " VALUE"
	}
	return s
}

# pad returns the spaces that bring s up to width, or one space when it is already past.
fn pad(s: str, width: int) -> str {
	# bound first: the self-hosted emitter cannot take the length of a conversion in place
	b := list[byte](s)
	n := width - b.len()
	if n < 1 {
		return " "
	}
	mut out: list[byte] = []
	mut i := 0
	for i < n {
		out.append(b' ')
		i = i + 1
	}
	return str(out)
}

# --- lookup and small string helpers --------------------------------------------------------

fn find_long(opts: list[Opt], name: str) -> Opt {
	for o in opts {
		if o.long == name {
			return o
		}
	}
	return Opt("", "", false, "")
}

fn find_short(opts: list[Opt], letter: str) -> Opt {
	for o in opts {
		if o.short != "" and o.short == letter {
			return o
		}
	}
	return Opt("", "", false, "")
}

# is_long reports `--name`; is_short reports `-x` but not a bare `-`.
fn is_long(a: str) -> bool {
	b := list[byte](a)
	return b.len() > 2 and b[0] == b'-' and b[1] == b'-'
}

fn is_short(a: str) -> bool {
	b := list[byte](a)
	return b.len() > 1 and b[0] == b'-' and b[1] != b'-'
}

fn drop_prefix(s: str, n: int) -> str {
	b := list[byte](s)
	mut out: list[byte] = []
	mut i := n
	for i < b.len() {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn has_eq(s: str) -> bool {
	for c in list[byte](s) {
		if c == b'=' {
			return true
		}
	}
	return false
}

fn before_eq(s: str) -> str {
	b := list[byte](s)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() {
		if b[i] == b'=' {
			return str(out)
		}
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn after_eq(s: str) -> str {
	b := list[byte](s)
	mut out: list[byte] = []
	mut seen := false
	mut i := 0
	for i < b.len() {
		if seen {
			out.append(b[i])
		}
		if b[i] == b'=' {
			seen = true
		}
		i = i + 1
	}
	return str(out)
}
