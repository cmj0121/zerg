# token — the lexical vocabulary of the self-hosting Zerg compiler.
#
# A port of the Go bootstrap's internal/token: the Kind enum names every lexical
# category, Token pairs a kind with its source lexeme / decoded value and a start
# position, and the helpers (kind_name, lookup_keyword, ends_item) drive the lexer
# and the `--emit tokens` rendering. This file is part of the `zerg` module — its
# enum variants are shared across the sibling lexer / parser / emit files, but never
# constructed from outside the module (a bootstrap limitation on cross-module enum
# variants), so the driver only calls the module's pub functions.

# Kind enumerates the lexical categories a token can belong to. The set mirrors
# GRAMMAR group 2 so the vocabulary is forward-compatible even where the current
# lexer does not yet emit every kind (f-strings, decorators).
#[derive(Eq)]
enum Kind {
	Eof
	Illegal
	Semi

	# literals and names
	Ident
	Int
	Float
	Str
	RawStr
	Rune
	Byte
	Cmd

	# FStr is a WHOLE f-string, lexeme and all — `f"a{x}b"` is one token, and splitting it
	# into text and holes is the parser's job. The seed lexes the structured stream below
	# instead; this compiler does not, because the formatter shares this lexer and the
	# printer treats every `{` as a block opener, so a hole's braces would have `zerg fmt`
	# tear the literal across four indented lines.
	FStr

	# structured f-string / f-cmd tokens (not yet emitted by the subset lexer)
	FStrBegin
	FStrText
	FStrEnd
	FCmdBegin
	FCmdText
	FCmdEnd
	Conv
	FmtSpec
	Hash

	# keywords
	Fn
	Return
	If
	Else
	For
	In
	Break
	Continue
	Nop
	Mut
	Const
	True
	False
	Nil
	Print
	And
	Or
	Not
	Is
	KwThis
	As
	Pub
	Import
	From
	Match
	Spawn
	Select
	Struct
	Enum
	Spec
	Chan
	Type
	Impl
	Package
	Init
	Defer
	Del
	Close
	Raise
	Guard
	With
	Unsafe
	Ptr
	Asm

	# operators and punctuation
	Plus
	Minus
	Star
	Slash
	SlashDiv
	Percent
	PlusMod
	MinusMod
	StarMod
	Amp
	Pipe
	Caret
	Tilde
	Shl
	Shr
	EqEq
	Ne
	Lt
	Gt
	Le
	Ge
	Assign
	Walrus
	Colon
	Arrow
	FatArrow
	LArrow
	Coalesce
	Question
	Bang
	OptDot
	Dot
	DotDot
	DotDotEq
	Comma
	LParen
	RParen
	LBrack
	RBrack
	LBrace
	RBrace

	# Trivia. Only the formatter asks for it: the compiler's own tokenize drops comments,
	# so no Kind below this line is ever seen by the parser.
	Comment
}

# Token is a single lexical unit: its kind, the exact source lexeme, the decoded
# value for string-like literals, and the 1-based line/column where it starts.
struct Token {
	kind: Kind
	lexeme: str
	value: str
	line: int
	col: int
}

# kind_name renders a kind exactly as the bootstrap's token.Kind.String, so the
# `--emit tokens` output matches byte-for-byte.
fn kind_name(k: Kind) -> str {
	return match k {
		Kind.Eof => "EOF"
		Kind.Illegal => "ILLEGAL"
		Kind.Semi => ";"
		Kind.Ident => "IDENT"
		Kind.Int => "INT"
		Kind.Float => "FLOAT"
		Kind.Str => "STR"
		Kind.RawStr => "RAWSTR"
		Kind.Rune => "RUNE"
		Kind.Byte => "BYTE"
		Kind.Cmd => "CMD"
		Kind.FStr => "FSTR"
		Kind.FStrBegin => "FSTR_BEGIN"
		Kind.FStrText => "FSTR_TEXT"
		Kind.FStrEnd => "FSTR_END"
		Kind.FCmdBegin => "FCMD_BEGIN"
		Kind.FCmdText => "FCMD_TEXT"
		Kind.FCmdEnd => "FCMD_END"
		Kind.Conv => "CONV"
		Kind.FmtSpec => "FMTSPEC"
		Kind.Hash => "#["
		Kind.Fn => "fn"
		Kind.Return => "return"
		Kind.If => "if"
		Kind.Else => "else"
		Kind.For => "for"
		Kind.In => "in"
		Kind.Break => "break"
		Kind.Continue => "continue"
		Kind.Nop => "nop"
		Kind.Mut => "mut"
		Kind.Const => "const"
		Kind.True => "true"
		Kind.False => "false"
		Kind.Nil => "nil"
		Kind.Print => "print"
		Kind.And => "and"
		Kind.Or => "or"
		Kind.Not => "not"
		Kind.Is => "is"
		Kind.KwThis => "this"
		Kind.As => "as"
		Kind.Pub => "pub"
		Kind.Import => "import"
		Kind.From => "from"
		Kind.Match => "match"
		Kind.Spawn => "spawn"
		Kind.Select => "select"
		Kind.Struct => "struct"
		Kind.Enum => "enum"
		Kind.Spec => "spec"
		Kind.Chan => "chan"
		Kind.Type => "type"
		Kind.Impl => "impl"
		Kind.Package => "package"
		Kind.Init => "init"
		Kind.Defer => "defer"
		Kind.Del => "del"
		Kind.Close => "close"
		Kind.Raise => "raise"
		Kind.Guard => "guard"
		Kind.With => "with"
		Kind.Unsafe => "unsafe"
		Kind.Ptr => "ptr"
		Kind.Asm => "asm"
		Kind.Plus => "+"
		Kind.Minus => "-"
		Kind.Star => "*"
		Kind.Slash => "/"
		Kind.SlashDiv => "//"
		Kind.Percent => "%"
		Kind.PlusMod => "+%"
		Kind.MinusMod => "-%"
		Kind.StarMod => "*%"
		Kind.Amp => "&"
		Kind.Pipe => "|"
		Kind.Caret => "^"
		Kind.Tilde => "~"
		Kind.Shl => "<<"
		Kind.Shr => ">>"
		Kind.EqEq => "=="
		Kind.Ne => "!="
		Kind.Lt => "<"
		Kind.Gt => ">"
		Kind.Le => "<="
		Kind.Ge => ">="
		Kind.Assign => "="
		Kind.Walrus => ":="
		Kind.Colon => ":"
		Kind.Arrow => "->"
		Kind.FatArrow => "=>"
		Kind.LArrow => "<-"
		Kind.Coalesce => "??"
		Kind.Question => "?"
		Kind.Bang => "!"
		Kind.OptDot => "?."
		Kind.Dot => "."
		Kind.DotDot => ".."
		Kind.DotDotEq => "..="
		Kind.Comma => ","
		Kind.LParen => "("
		Kind.RParen => ")"
		Kind.LBrack => "["
		Kind.RBrack => "]"
		Kind.LBrace => "{"
		Kind.Comment => "COMMENT"
		_ => "}"
	}
}

# lookup_keyword maps an identifier spelling to its reserved kind, or Ident when the
# word is not a keyword.
fn lookup_keyword(w: str) -> Kind {
	if w == "fn" {
		return Kind.Fn
	} else if w == "return" {
		return Kind.Return
	} else if w == "if" {
		return Kind.If
	} else if w == "else" {
		return Kind.Else
	} else if w == "for" {
		return Kind.For
	} else if w == "in" {
		return Kind.In
	} else if w == "break" {
		return Kind.Break
	} else if w == "continue" {
		return Kind.Continue
	} else if w == "nop" {
		return Kind.Nop
	} else if w == "mut" {
		return Kind.Mut
	} else if w == "const" {
		return Kind.Const
	} else if w == "true" {
		return Kind.True
	} else if w == "false" {
		return Kind.False
	} else if w == "nil" {
		return Kind.Nil
	} else if w == "print" {
		return Kind.Print
	} else if w == "and" {
		return Kind.And
	} else if w == "or" {
		return Kind.Or
	} else if w == "not" {
		return Kind.Not
	} else if w == "is" {
		return Kind.Is
	} else if w == "this" {
		return Kind.KwThis
	} else if w == "as" {
		return Kind.As
	} else if w == "pub" {
		return Kind.Pub
	} else if w == "import" {
		return Kind.Import
	} else if w == "from" {
		return Kind.From
	} else if w == "match" {
		return Kind.Match
	} else if w == "spawn" {
		return Kind.Spawn
	} else if w == "select" {
		return Kind.Select
	} else if w == "struct" {
		return Kind.Struct
	} else if w == "enum" {
		return Kind.Enum
	} else if w == "spec" {
		return Kind.Spec
	} else if w == "chan" {
		return Kind.Chan
	} else if w == "type" {
		return Kind.Type
	} else if w == "impl" {
		return Kind.Impl
	} else if w == "package" {
		return Kind.Package
	} else if w == "init" {
		return Kind.Init
	} else if w == "defer" {
		return Kind.Defer
	} else if w == "del" {
		return Kind.Del
	} else if w == "close" {
		return Kind.Close
	} else if w == "raise" {
		return Kind.Raise
	} else if w == "guard" {
		return Kind.Guard
	} else if w == "with" {
		return Kind.With
	} else if w == "unsafe" {
		return Kind.Unsafe
	} else if w == "ptr" {
		return Kind.Ptr
	} else if w == "asm" {
		return Kind.Asm
	}
	return Kind.Ident
}

# no_bound_follows reports that a kind cannot begin a range's upper bound, which is what tells
# the OPEN-ENDED range `500..` from one whose bound simply follows. GRAMMAR makes that bound
# optional after `..`, and nothing in the token itself says whether one is coming.
#
# It is a NEGATIVE list on purpose. Naming what can begin a bound means naming every literal,
# prefix and opener, and missing one of those turns a legal bound into a parse error; missing
# one HERE only leaves today's behaviour — a bound is read where none was written. The `if` in
# it is the case that made the rule: an if-expression is a legal bound expression, so the guard
# of `500.. if c =>` was read as the bound, and the arm silently tested `n < (c ? … : …)`.
#
# The formatter asks the same question for the same reason: printed tight, `20.. =>` becomes
# `20..=>`, which lexes as `20`, `..=`, `>`.
pub fn no_bound_follows(k: Kind) -> bool {
	return match k {
		Kind.FatArrow => true
		Kind.If       => true
		Kind.LBrace   => true
		Kind.RBrace   => true
		Kind.Semi     => true
		Kind.Comment  => true
		Kind.Eof      => true

		# a closer: `xs[1..]` and `f(a..)` end the range where the bracket does. It used to
		# be absent because the fallback in parse_primary answered nil for the `]` it then
		# read as the bound — the open-ended slice arrived shaped correctly by accident, and
		# stopped doing so the moment that fallback became a diagnostic.
		Kind.RBrack => true
		Kind.RParen => true
		_           => false
	}
}

# ends_item reports whether a token of this kind can end a grammatical item, which
# is what lets the lexer insert a ';' at a following line break (GRAMMAR group 2,
# ASI).
fn ends_item(k: Kind) -> bool {
	return match k {
		Kind.Ident    => true
		Kind.Int      => true
		Kind.Float    => true
		Kind.Str      => true
		Kind.RawStr   => true
		Kind.Rune     => true
		Kind.Byte     => true
		Kind.Cmd      => true
		Kind.FStr     => true
		Kind.FStrEnd  => true
		Kind.FCmdEnd  => true
		Kind.RParen   => true
		Kind.RBrack   => true
		Kind.RBrace   => true
		Kind.Question => true
		Kind.Bang     => true

		# `chan[T]<-` — the send-only direction marker is the one `<-` that ENDS something
		# rather than pointing at what follows it, and a struct field or a `type` alias
		# written with one is a whole item at the end of its line. Without this the line
		# break after it was insignificant and the NEXT line was read as a continuation of
		# the field: the formatter re-indented it under the field it had swallowed, which is
		# a layout the compiler still reads back, so nothing failed and the source was
		# quietly wrong.
		#
		# The cost is that a SEND may no longer be split after its arrow — `ch <-` then the
		# value on the next line is now two statements. Nothing in this tree writes that, and
		# the formatter never produces it, so the marker wins the token.
		Kind.LArrow   => true
		Kind.True     => true
		Kind.False    => true
		Kind.Nil      => true
		Kind.KwThis   => true
		Kind.Return   => true
		Kind.Break    => true
		Kind.Continue => true
		Kind.Nop      => true
		_             => false
	}
}
