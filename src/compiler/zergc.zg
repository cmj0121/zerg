# zerg — the self-hosting Zerg compiler.
#
# Three commands — build, fmt, lint — and the flags every tool owes its user: --help,
# --version, and --emit to stop after a stage. There are three because there are three
# JOBS: compiling is one of them however far along the pipeline you stop it, so the token
# stream, the tree, and the C are `--emit` values rather than commands of their own.
#
# The command line is DECLARED with the stdlib `cli` module — each command with its own
# arguments and the function it runs — so the help text is generated from the same
# declarations the parser used and cannot drift from them.
# `build` is self-sufficient — it emits C beside the output, then invokes cc through the
# runtime's process-spawn leaf — and the compiler resolves `import` itself, so it works
# from any directory.
import (
	"cli"
	"io"
	"strconv"

	"zerg"
)

# banner is the one line `--version` prints. It cannot be called `version`: a program and
# the modules it imports flatten into one scope, and `cli.version` is a name in it.
fn banner() -> str {
	return "zerg 0.1.0 (self-hosted)"
}

fn main(args: list[str]) {
	__zrt_exit(root().exec(args))
}

# root declares the whole command line once. Every sub-command names the function it runs,
# so dispatch is the declaration rather than a chain of string comparisons beside it.
fn root() -> cli.Command {
	# a multi-line chain is wrapped in parentheses: a line break after ')' would otherwise
	# end the statement
	return (
		cli.command("zerg", "the self-hosting Zerg compiler")
		.version(banner())
		.epilog(env_help())
		.sub(build_cmd())
		.sub(fmt_cmd())
		.sub(lint_cmd())
	)
}

# build is the only command that compiles; how FAR it goes is `--emit`, not a command of
# its own. The token stream, the tree, and the C are stages of one pipeline, so naming
# them as sub-commands said twice what `--emit` already says — and left a reader to
# discover that `zerg c f.zg` and `zerg build --emit c f.zg` were the same thing.
fn build_cmd() -> cli.Command {
	return (
		cli.command("build", "compile a program (see --emit)")
		.opt("e", "emit", "stop after a stage: tokens, ast, c, lib, bin", "lib")
		.opt("o", "output", "where to write the result (default: the source name)")
		.opt("j", "jobs", "how many units to compile at once", "4")
		.add(cli.positional("file.zg", "the source to compile").required().repeated())
		.run(do_build)
	)
}

fn fmt_cmd() -> cli.Command {
	return (
		cli.command("fmt", "rewrite sources in the canonical style")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. F401; repeatable").repeated())
		.add(cli.positional("file.zg", "the sources to rewrite").required().repeated())
		.run(do_fmt)
	)
}

fn lint_cmd() -> cli.Command {
	return (
		cli.command("lint", "report unused imports and dead private code")
		.add(cli.positional("file.zg", "the sources to check").required().repeated())
		.run(do_lint)
	)
}

# env_help is the part of the help no declaration can produce: where the compiler looks
# for the things it is not carrying.
fn env_help() -> str {
	return "Stages (--emit):\n" +
		"  tokens             the token stream, on stdout\n" +
		"  ast                the parsed tree, on stdout\n" +
		"  c                  the emitted C, on stdout\n" +
		"  lib                compile the C to an object file (default)\n" +
		"  bin                link an executable\n" +
		"\nEnvironment:\n" +
		"  ZERG_ROOT          installation root (default: the current directory)\n" +
		"  ZERG_RUNTIME       runtime C sources (default: $ZERG_ROOT/src/runtime/csrc)\n" +
		"  ZERG_STDLIB        standard library sources (default: $ZERG_ROOT/src/stdlib)\n"
}

# --- what each sub-command does -------------------------------------------------------------
#
# Each is handed the parsed command line and returns the process's exit status. There is no
# argument checking here: a missing file or an unreadable flag was refused before the
# function was ever called, which is the point of declaring the command line rather than
# unpicking it.

fn do_build(c: cli.Ctx) -> int {
	build_stage(c.args(), c.get("emit"), c.get("output"), job_count(c.get("jobs")))
	return 0
}

fn do_fmt(c: cli.Ctx) -> int {
	run_fmt(c.args(), c.all("off"))
	return 0
}

fn do_lint(c: cli.Ctx) -> int {
	return run_lint(c.args())
}

# job_count reads -j, falling back to one job rather than none when it is not a number —
# a bad value should slow the build down, not stop it.
fn job_count(v: str) -> int {
	mut n := 0
	guard {
		n = strconv.parse_int(v, 10)
	}
	return 1 if n < 1
	return n
}

# build_stage runs the pipeline as far as `emit` asks and no further. The early stages
# print to stdout because they are something a person is reading; the two that produce a
# FILE take an output path, defaulting to the entry file's name.
#
# `lib` is the default deliberately: a source is a module until something asks it to be a
# program. Compiling to an object leaves it composable — several modules can be built
# separately and linked once — and `--emit bin` is the step that says "this one is the
# program".
fn build_stage(files: list[str], emit: str, out: str, jobs: int) {
	if emit == "tokens" {
		guard {
			io.write(zerg.dump_tokens(str(io.read_file(files[0]))))
		}
		return
	}
	if emit == "ast" {
		guard {
			io.write(zerg.dump_ast(zerg.merge_files(load_sources(files))))
		}
		return
	}
	mut output := out
	if output == "" {
		output = drop_ext(files[0])
	}
	if emit == "lib" {
		# separate compilation: the unit DECLARES the whole program but DEFINES only this
		# module, so its object can be linked beside the objects of the modules it imports.
		units := load_units(files[0])
		mut trees: list[zerg.File] = []
		for u in units {
			trees.append(zerg.merge_files(u.srcs))
		}
		compile_to(zerg.emit_unit(zerg.merge_asts(trees), trees[trees.len() - 1]), output + ".o", true)
		return
	}
	srcs := load_sources(files)
	code := zerg.emit_files(srcs)
	if emit == "c" {
		guard {
			io.write(code)
		}
		return
	}
	if emit == "bin" {
		link_program(files[0], output, jobs)
		return
	}
	io.ewrite(f"zerg: unknown stage {emit} (want tokens, ast, c, lib, or bin)\n")
	__zrt_exit(2)
}

# link_program builds a program the way a project is built: every unit compiled to its
# own object, then one link. A unit whose object is already in the cache is not compiled
# again — which is the whole point of splitting the build up, since most rebuilds change
# one module and leave the rest exactly as they were.
fn link_program(entry: str, output: str, jobs: int) {
	units := load_units(entry)

	# Parse each unit ONCE, then build the whole-program view from those trees: emitting N
	# units used to re-parse the whole program N times, which cost more than the C
	# compiler did.
	mut trees: list[zerg.File] = []
	for u in units {
		trees.append(zerg.merge_files(u.srcs))
	}

	prog := zerg.merge_asts(trees)
	mut objs: list[str] = []
	mut todo_c: list[str] = []
	mut todo_o: list[str] = []
	mut ui := 0
	for ui < units.len() {
		code := zerg.emit_unit(prog, trees[ui])
		obj := cache_path(unit_key(code))
		objs.append(obj)
		if not __zrt_exists(obj) {
			cpath := obj + ".c"
			guard {
				io.write_file(cpath, list[byte](code))
			}
			todo_c.append(cpath)
			todo_o.append(obj)
		}
		ui = ui + 1
	}

	# The runtime is compiled the same way, and cached the same way. It changes far less
	# often than the program does, so recompiling its ten translation units on every link
	# was the largest thing a rebuild was paying for.
	for rc in rt_sources() {
		obj := cache_path(file_key(rc))
		objs.append(obj)
		if not __zrt_exists(obj) {
			todo_c.append(rc)
			todo_o.append(obj)
		}
	}
	compile_batch(todo_c, todo_o, jobs)
	if __zrt_exec(link_objs_argv(objs, output)) != 0 {
		io.ewrite("zerg: link failed\n")
		__zrt_exit(1)
	}
}

# rt_sources are the runtime translation units, as paths.
fn rt_sources() -> list[str] {
	rt := rt_dir()
	mut out: list[str] = []
	for u in rt_units() {
		out.append(f"{rt}/{u}")
	}
	return out
}

# file_key hashes a file the cache is keyed on. The runtime header goes into the key
# beside the source, because every runtime unit includes it and a change there changes
# what the object means.
fn file_key(path: str) -> str {
	mut body := ""
	guard {
		body = str(io.read_file(path)) + str(io.read_file(rt_dir() + "/zergrt.h"))
	}
	return unit_key(body)
}

# link_objs_argv links objects only — everything was compiled beforehand.
fn link_objs_argv(objs: list[str], output: str) -> list[str] {
	mut argv: list[str] = []
	argv.append("cc")
	argv.append("-std=c11")
	argv.append("-o")
	argv.append(output)
	for o in objs {
		argv.append(o)
	}
	return argv
}

# compile_batch runs the cc invocations, `jobs` of them at a time. Each unit is
# independent — separate compilation is what made that true — so the only ordering that
# matters is that they all finish before the link.
#
# It fills a batch, waits for the batch, then starts the next. A sliding window would keep
# every core busy at the edges; batching keeps the bookkeeping to two lists, and with a
# handful of units per build the difference is not what anyone is waiting on.
fn compile_batch(cpaths: list[str], opaths: list[str], jobs: int) {
	mut running: list[int] = []
	mut i := 0
	for i < cpaths.len() {
		pid := __zrt_proc_spawn(cc_object_argv(cpaths[i], opaths[i]))
		if pid < 0 {
			io.ewrite("zerg: cannot start cc\n")
			__zrt_exit(1)
		}
		running.append(pid)
		i = i + 1
		if running.len() >= jobs {
			reap(running)
			running = []
		}
	}
	reap(running)
}

# reap waits for every child in the batch and fails the build if any cc did.
fn reap(pids: list[int]) {
	mut bad := false
	for p in pids {
		if __zrt_proc_wait(p) != 0 {
			bad = true
		}
	}
	if bad {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# --- the build cache -----------------------------------------------------------------------
#
# The cache is keyed on CONTENT, not on timestamps: the same emitted C always compiles to
# the same object, which is a property the self-host fixpoint already proves. So a unit's
# key is a hash of the C it emitted — which folds in its own source, everything it can see,
# and the compiler that produced it, since a change to any of those changes the C.

# cache_dir is $ZERG_CACHE, else <root>/.zerg-cache, created on demand. A cache that
# cannot be created is not fatal: the build carries on without one.
fn cache_dir() -> str {
	dir := env_or("ZERG_CACHE", join_path(zerg_root(), ".zerg-cache"))
	__zrt_mkdir(dir)
	return dir
}

fn cache_path(key: str) -> str {
	return join_path(cache_dir(), key + ".o")
}

# unit_key hashes a unit's emitted C with FNV-1a (32-bit — the 64-bit basis does not fit
# an integer literal yet), and puts the LENGTH in the name beside it. The length is there
# because a hash this size is a cheap guard rather than a proof: two different units
# colliding would link the wrong object, and requiring the byte counts to match as well
# makes that far less likely. A cryptographic digest is the upgrade to make when the
# standard library has one.
fn unit_key(code: str) -> str {
	b := list[byte](code)
	mut h := 2166136261
	mut i := 0
	for i < b.len() {
		h = h ^ int(b[i])
		h = (h * 16777619) % 4294967296
		i = i + 1
	}
	return f"{strconv.to_string(h, 16)}-{strconv.to_string(b.len(), 16)}"
}

# compile_to writes the emitted C beside its product and hands it to cc — compiled only
# (`-c`, an object) or compiled and linked against the runtime (an executable).
fn compile_to(code: str, output: str, object_only: bool) {
	cpath := output + ".c"
	guard {
		io.write_file(cpath, list[byte](code))
	}
	mut argv: list[str] = []
	if object_only {
		argv = cc_object_argv(cpath, output)
	} else {
		argv = cc_argv(cpath, output)
	}
	if __zrt_exec(argv) != 0 {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# drop_ext removes a trailing ".zg" so `zerg build hello.zg` writes `hello`.
fn drop_ext(path: str) -> str {
	return path if not has_suffix(path, ".zg")

	b := list[byte](path)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() - 3 {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# --- compilation units --------------------------------------------------------------------
#
# A UNIT is what gets compiled to one object: a module. A file module is one unit of one
# file; a directory module is one unit of several, because its files share a scope and
# cannot be split. Separate compilation is unit-by-unit, which is what makes a build
# cacheable (a unit's object survives a change elsewhere) and parallelizable (units with
# no dependency between them can compile at once).

# Unit is one module: the name it is known by (its import path, or the entry file's path)
# and the sources that make it up.
struct Unit {
	name: str
	srcs: list[str]
}

# load_units returns every unit of the program, dependencies before dependents, the entry
# last. A unit is loaded once however many modules import it.
fn load_units(entry: str) -> list[Unit] {
	mut seen: list[str] = []
	mut units: list[Unit] = []
	mut one: list[str] = []
	one.append(entry)
	load_unit(one, entry, dir_of(entry), seen, units)
	return units
}

fn load_unit(files: list[str], name: str, from_dir: str, mut &seen: list[str], mut &units: list[Unit]) {
	for s in seen {
		return if s == name
	}
	seen.append(name)
	mut srcs: list[str] = []
	for f in files {
		guard {
			srcs.append(str(io.read_file(f)))
		}
	}
	for src in srcs {
		for im in zerg.imports_of(src) {
			deps := module_files(im, from_dir)
			if deps.len() > 0 {
				load_unit(deps, im, from_dir, seen, units)
			}
		}
	}
	units.append(Unit(name, srcs))
}

# load_sources loads every named entry with its imports, keeping one copy of a module
# that several entries share.
fn load_sources(files: list[str]) -> list[str] {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	for f in files {
		load_into(f, dir_of(f), seen, srcs)
	}
	return srcs
}

# --- installation layout -------------------------------------------------------------
#
# The compiler has to work from any directory, so nothing below is a relative path the
# process happens to be standing next to. Each location is answered by an environment
# variable first, then by a root that is itself answered the same way, and the in-repo
# layout is only the last resort — which is what makes a checkout work with no setup.

# env_or reads an environment variable, or gives fallback when it is unset.
fn env_or(key: str, fallback: str) -> str {
	return __zrt_getenv(key) if __zrt_has_env(key)
	return fallback
}

# zerg_root is the installation root: $ZERG_ROOT, else the current directory (the repo
# checkout, where src/runtime and src/stdlib sit).
fn zerg_root() -> str {
	return env_or("ZERG_ROOT", ".")
}

# rt_dir returns the runtime source tree — $ZERG_RUNTIME, else <root>/src/runtime/csrc.
# It is probed rather than assumed, so a wrong root fails as a missing-runtime message
# instead of a wall of cc errors about a header that was never there.
fn rt_dir() -> str {
	return __zrt_getenv("ZERG_RUNTIME") if __zrt_has_env("ZERG_RUNTIME")
	return join_path(zerg_root(), "src/runtime/csrc")
}

# stdlib_dir returns the standard library sources — $ZERG_STDLIB, else <root>/src/stdlib.
fn stdlib_dir() -> str {
	return __zrt_getenv("ZERG_STDLIB") if __zrt_has_env("ZERG_STDLIB")
	return join_path(zerg_root(), "src/stdlib")
}

# --- paths -----------------------------------------------------------------------------

# join_path joins a directory and a name, treating "" and "." as "here".
fn join_path(dir: str, name: str) -> str {
	return name if dir == "" or dir == "."
	return f"{dir}/{name}"
}

# dir_of returns the directory part of a path, or "." when it names a bare file.
fn dir_of(path: str) -> str {
	b := list[byte](path)
	mut cut := 0
	mut seen := false
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i
			seen = true
		}
		i = i + 1
	}
	return "." if not seen
	mut out: list[byte] = []
	mut j := 0
	for j < cut {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# has_suffix reports whether s ends with suffix.
fn has_suffix(s: str, suffix: str) -> bool {
	b := list[byte](s)
	x := list[byte](suffix)
	return false if x.len() > b.len()
	mut i := 0
	for i < x.len() {
		return false if b[b.len() - x.len() + i] != x[i]
		i = i + 1
	}
	return true
}

# --- module resolution ------------------------------------------------------------------

# module_files resolves one import path to the source files that make up that module,
# searched in the entry program's own directory first (a user module beside the program),
# then the standard library. A module is either a single `<path>.zg` file or a DIRECTORY
# of them — the compiler's own `zerg` module is the second kind, and its files are read in
# the sorted order the runtime guarantees so the emitted C never depends on the
# filesystem. An unresolvable import yields an empty list; the caller reports it.
fn module_files(path: str, from_dir: str) -> list[str] {
	mut roots: list[str] = []
	roots.append(from_dir)
	roots.append(stdlib_dir())
	for root in roots {
		found := module_at(root, path)
		return found if found.len() > 0
	}

	# The LAST-SEGMENT alias. A module is named by the last segment of its path — `import
	# "std/time"` and `import "time"` are the same module (docs/tooling/fmt.md) — and the
	# stdlib is one flat directory, so a path that resolves nowhere is retried at its last
	# segment. The seed has done this since 1g; without it here the two compilers disagree
	# about what a program imports, and the disagreement is SILENT until use: the namespace
	# is bound from the path either way, so `import "std/time"` loaded no files at all and
	# `time.now()` read as a method on nothing.
	seg := path_tail(path)
	if seg != path {
		for root in roots {
			found := module_at(root, seg)
			return found if found.len() > 0
		}
	}
	mut none: list[str] = []
	return none
}

# module_at resolves one import path under one root: a single `<path>.zg` file, or a
# DIRECTORY of them read in sorted order so the emitted C never depends on the filesystem.
fn module_at(root: str, path: str) -> list[str] {
	file := join_path(root, path + ".zg")
	if __zrt_exists(file) {
		mut one: list[str] = []
		one.append(file)
		return one
	}
	dir := join_path(root, path)
	if __zrt_exists(dir) {
		mut many: list[str] = []
		for name in __zrt_listdir(dir) {
			if has_suffix(name, ".zg") {
				many.append(join_path(dir, name))
			}
		}
		return many
	}
	mut none: list[str] = []
	return none
}

# path_tail is the last '/'-separated segment of an import path, which is the module's
# name.
fn path_tail(path: str) -> str {
	b := list[byte](path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

fn load_into(file: str, from_dir: str, mut &seen: list[str], mut &srcs: list[str]) {
	for s in seen {
		return if s == file
	}
	seen.append(file)
	src := str(io.read_file(file))
	for im in zerg.imports_of(src) {
		for dep in module_files(im, from_dir) {
			load_into(dep, from_dir, seen, srcs)
		}
	}
	srcs.append(src)
}

# cc_argv builds the cc command line: compile cpath into output over the always-linked,
# non-concurrent runtime units, found under rt_dir().
# rt_units are the runtime translation units every linked program needs.
fn rt_units() -> list[str] {
	mut units: list[str] = []
	units.append("alloc.c")
	units.append("conv.c")
	units.append("entry.c")
	units.append("fmt.c")
	units.append("list.c")
	units.append("map.c")
	units.append("ref.c")
	units.append("str.c")
	units.append("sys.c")
	units.append("unwind.c")

	# The concurrency floor. It is linked unconditionally rather than by inspecting the
	# program because the driver decides the link line before it knows whether emit
	# reached a channel — and an unused unit costs a few KB, while a missing one is a
	# link error a user cannot act on. The context switch and the thread backend are
	# chosen by target, exactly as the runtime's own selection does.
	units.append("sched.c")
	units.append("chan.c")
	units.append(ctx_unit())
	units.append(thread_unit())
	return units
}

# ctx_unit is the context switch for this target: a hand-written one where there is
# one, else the portable ucontext floor.
fn ctx_unit() -> str {
	a: str = __zrt_arch()

	return "ctx_arm64.S" if a == "arm64"
	return "ctx_x86_64.S" if a == "x86_64"

	return "ctx_ucontext.c"
}

# thread_unit is the zrt_thread backend. A platform this does not know gets the
# no-thread floor, which runs every coroutine on one thread — correct, just not
# parallel.
fn thread_unit() -> str {
	p: str = __zrt_platform()

	return "thread_win32.c" if p == "windows"
	return "thread_pthread.c" if p == "linux" or p == "darwin" or p == "freebsd" or p == "openbsd" or p == "netbsd"

	return "thread_none.c"
}

# cc_object_argv compiles the emitted C to an object without linking: a module is not a
# program, so it has no entry to link against and no runtime to pull in yet.
fn cc_object_argv(cpath: str, output: str) -> list[str] {
	mut argv: list[str] = []
	argv.append("cc")
	argv.append("-std=c11")
	argv.append("-I")
	argv.append(rt_dir())
	argv.append("-c")
	argv.append("-o")
	argv.append(output)
	argv.append(cpath)
	return argv
}

fn cc_argv(cpath: str, output: str) -> list[str] {
	rt := rt_dir()
	mut argv: list[str] = []
	argv.append("cc")
	argv.append("-std=c11")
	argv.append("-I")
	argv.append(rt)
	argv.append("-o")
	argv.append(output)
	argv.append(cpath)
	for u in rt_units() {
		argv.append(f"{rt}/{u}")
	}
	return argv
}

# --- fmt / lint ------------------------------------------------------------------------

# run_fmt rewrites each named file in place. Reading and writing the same path means a
# formatted file is byte-identical to what it was, so running fmt twice is a no-op.
fn run_fmt(files: list[str], off: list[str]) {
	for f in files {
		src := str(io.read_file(f))

		# fmt works on the TOKEN STREAM, not the tree, so it will reformat anything that
		# lexes — including a file with a syntax error, silently, exit 0. `fn main( {` came
		# back as `fn main({` and `print("hi")` as `print ("hi")`: the tokens survive, but
		# the spacing rules are applied to a shape they cannot mean anything about, so the
		# user's broken file comes back broken AND misformatted, with nothing said.
		#
		# The gate is NOT `parse`. A formatter has to work on source the compiler cannot
		# COMPILE — that is exactly when a person reaches for one — and this parser refuses
		# 26 forms the language has and this compiler has not built, `src/stdlib/testing.zg`
		# among them. Balance is what fmt's own rules actually depend on; see fmt_balanced.
		raise f"`{f}` has unbalanced brackets, so it cannot be formatted — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.fmt_src_off(src, off)
		if out != src {
			guard {
				io.write_file(f, list[byte](out))
			}
			io.write(f + "\n")
		}
	}
}

# run_lint reports every finding in the loaded program and RETURNS a nonzero status when
# there is one, so `zerg lint` can gate a build rather than merely inform. It returns the
# status rather than exiting on it because a sub-command's function is what decides the
# process's exit, and it is the only thing that knows what the finding meant.
fn run_lint(files: list[str]) -> int {
	findings := zerg.lint_files(load_sources(files))
	for f in findings {
		io.write(f + "\n")
	}
	return 1 if findings.len() > 0
	return 0
}
