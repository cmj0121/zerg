# io — minimal standard-stream output (Phase 1f, bundle MVP).
#
# Bundled into a program that writes `import "io"`; its members are reached
# through the namespace, as `io.println(...)`. Each writer returns `Result[nil]`
# per docs/runtime/io.md — a write failure is a value, not an abort — though this minimal
# surface writes best-effort over the runtime's `zrt_write` and never yields an
# Err yet (structured write failures land with the full Writer spec later).
#
# Zerg is zero-external-dependency like Go: the stdlib reaches the OS through the
# self runtime's own primitives, never an FFI binding onto a third-party library.
# So all I/O *logic* lives here in pure Zerg — the decimal conversion in `write_int`,
# the read loop in `read_file` — and only the irreducible syscall leaves stay in the
# runtime, reached through the thin compiler primitives `__zrt_write` (write a str to
# an fd) and the whole-file read floor `__zrt_open` / `__zrt_read` / `__zrt_close`.

# write writes s to standard output (fd 1) with no trailing newline. (`print` is a
# reserved keyword — the ambient no-import shortcut — so the module's newline-free
# writer is named `write`, matching the `write`/`write_str` verbs in docs/runtime/io.md.)
pub fn write(s: str) -> Result[nil] {
	__zrt_write(1, s)
	return nil
}

# println writes s to standard output (fd 1) followed by a newline.
pub fn println(s: str) -> Result[nil] {
	__zrt_write(1, s)
	__zrt_write(1, "\n")
	return nil
}

# ewrite writes s to standard error (fd 2), no trailing newline — the error-stream
# counterpart of write, so diagnostics stay off stdout.
pub fn ewrite(s: str) -> Result[nil] {
	__zrt_write(2, s)
	return nil
}

# eprintln writes s to standard error (fd 2) followed by a newline — the error-stream
# counterpart of println, the line a tool uses for a warning or error message.
pub fn eprintln(s: str) -> Result[nil] {
	__zrt_write(2, s)
	__zrt_write(2, "\n")
	return nil
}

# write_int writes the decimal text of n to standard output (fd 1). The conversion is
# pure Zerg: digits are peeled off with `% 10` / `/ 10` — the single digit is negated,
# never the whole value, so INT_MIN never overflows — collected least-significant-first,
# then reversed into a str and written through the `write` leaf.
pub fn write_int(n: int) -> Result[nil] {
	mut digits: list[byte] = []
	mut v := n
	neg := v < 0
	for {
		# `/` and `%` are EUCLIDEAN (docs/core/types.md): the remainder is never negative
		# and the quotient floors, so for a negative `v` neither is the digit-and-rest this
		# conversion wants. `-42 % 10` is 8, not 2, and `-42 / 10` is -5, not -4 — and
		# `-1 / 10` is -1, so a loop written against truncation never reaches zero.
		#
		# The two differ only when `v` is negative and the remainder is non-zero, and then
		# by exactly one step: the digit is `10 - r` and the rest is `q + 1`. Deriving it
		# this way is what lets INT_MIN convert — negating `v` to work in positives is the
		# one operation that has no answer at the bottom of the range.
		r := v % 10
		mut q := v / 10
		mut digit := r
		if neg and r != 0 {
			digit = 10 - r
			q = q + 1
		}
		digits.append(byte(48 + digit)) # 48 == '0'
		v = q
		break if v == 0
	}
	if neg {
		digits.append(byte(45))
	} # 45 == '-'
	mut out: list[byte] = []
	mut i := digits.len() - 1
	for {
		out.append(digits[i])
		break if i == 0
		i = i - 1
	}
	return write(str(out))
}

# read_file reads the whole file at path into a list[byte] — pure-Zerg orchestration
# over the runtime's open/read/close floor. It opens the file (a missing or unreadable
# file raises IOError in the floor, which `guard { io.read_file(p) }` demotes to a
# Result), loops the read leaf appending each chunk until end of input, then closes the
# fd. Decode the bytes with `str(...)` when the contents are text.
pub fn read_file(path: str) -> list[byte] {
	fd := __zrt_open(path)
	mut out: list[byte] = []
	for {
		chunk := __zrt_read(fd)
		break if chunk.len() == 0
		for b in chunk {
			out.append(b)
		}
	}
	__zrt_close(fd)
	return out
}

# read_stdin reads all of standard input (fd 0) to end of input into a list[byte] — the
# same read loop as read_file, but over the already-open stdin fd, so there is no open or
# close. It blocks until the stream reaches EOF, so it is the whole-input read a filter
# uses; decode the bytes with `str(...)` for text. Returns an empty list on empty input.
pub fn read_stdin() -> list[byte] {
	mut out: list[byte] = []
	for {
		chunk := __zrt_read(0)
		break if chunk.len() == 0
		for b in chunk {
			out.append(b)
		}
	}
	return out
}

# write_file writes data to the file at path, creating it or truncating an existing one —
# pure-Zerg orchestration over the runtime's open-write/write/close floor, symmetric with
# read_file. A failure to open or write raises IOError, which `guard { io.write_file(p, d) }`
# demotes to a Result. Encode text with `bytearray(s)` first.
pub fn write_file(path: str, data: list[byte]) {
	fd := __zrt_open_write(path)
	__zrt_write_bytes(fd, data)
	__zrt_close(fd)
}

# --- streams: Reader & Writer (docs/runtime/io.md) ---------------------------------------
#
# Each spec has ONE REQUIRED METHOD and the rest are provided defaults, so a new stream
# supplies the primitive and inherits the conveniences. That is the shape the chapter
# specifies, and it is what a spec's provided member is for.
#
# WHAT IS NOT HERE IS THE ITERATOR HALF. The chapter's `read() -> Iterator[str]`, `bytes()`
# and `chunks(n)` are defaults over a protocol `for … in` does not walk yet, so they are not
# written: a default that cannot be called is a promise, and the ones below are methods.

# Reader is a source of bytes: one required leaf, and the whole-input reads over it.
pub spec Reader {
	fn read_bytes(n: uint) -> Result[list[byte]]

	# read_all drains the stream to end of input. It is the whole-input read, over the
	# required leaf, which is exactly what a provided default is for.
	fn read_all() -> Result[list[byte]] {
		mut out: list[byte] = []
		for {
			chunk := this.read_bytes(uint(4096))?
			break if chunk.len() == 0

			for b in chunk {
				out.append(b)
			}
		}
		return out
	}

	# read_text is read_all decoded, for a stream a reader knows is text. A stream that is
	# not valid UTF-8 raises where the decode happens, which `guard` demotes.
	fn read_text() -> Result[str] {
		return str(this.read_all()?)
	}
}

# Writer is a destination for bytes: one required leaf, and the str convenience over it.
pub spec Writer {
	fn write(bytes: list[byte]) -> Result[uint]

	fn write_str(s: str) -> Result[uint] {
		return this.write(bytearray(s))
	}
}

# Fd is a raw file descriptor as a stream. It is the one concrete Reader and Writer this
# phase has, and it is what a child process's three ends are.
#
# IT DOES NOT CLOSE ITSELF. The chapter's `File` is a `Ref[handle]` closed exactly once at
# the last holder's scope exit, and that is the foreign-handle pattern this type is not: an
# `Fd` is owned by whoever opened it — for a child's streams, the `Proc` that holds them.
pub struct Fd {
	pub fd: int
}

impl Reader for Fd {
	fn read_bytes(n: uint) -> Result[list[byte]] {
		return __zrt_read(this.fd)
	}
}

impl Writer for Fd {
	fn write(bytes: list[byte]) -> Result[uint] {
		__zrt_write_bytes(this.fd, bytes)
		return uint(bytes.len())
	}
}

# release gives the descriptor back. It is a method on `Fd` and not on either spec, because
# closing is not something every stream answers — a `Reader` may be a buffer — and it is not
# spelled `close`, which is a reserved word (a channel's own closing).
impl Fd {
	# release gives the descriptor back to the OS. Whoever opened it owns it.
	pub fn release() {
		__zrt_close(this.fd)
	}
}
