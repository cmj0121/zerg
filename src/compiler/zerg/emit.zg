# emit — AST to C for the self-hosting Zerg compiler (M3).
#
# Lowers a parsed File to C over the same shape the Go bootstrap emits: an include
# header, forward declarations, the function definitions with `zg_`-mangled names, and
# an `int main` wrapper that calls `zg_main`. The bar is functional equivalence, not
# byte-identical C — the emitted C must compile and behave identically to the bootstrap
# build.
#
# Expressions are built as strings (each match arm yields C text), so no void-valued
# match is needed. A small type inference — over the function signature table and the
# per-function variable environment held in Emitter — picks the printf format for `print`
# and resolves numeric promotion. All helpers are `c_`-prefixed to stay clear of the
# lexer / parser names in this one flattened module.
import (
	"ascii"
	"strconv"
)

# Emitter carries the per-function variable environment (name -> type) and the
# whole-file function signature table (name -> return type).
struct Emitter {
	env_names: list[str]
	env_tys: list[Ty]

	# env_cnames is each binding's C NAME. A Zerg binding may shadow one already in scope
	# — `mut n := n` rebinding a parameter is the ordinary way to get a mutable copy — but
	# C has no shadowing inside a function, so the second one has to be spelled
	# differently or the C compiler rejects the redefinition.
	env_cnames: list[str]

	# env_dead is each binding's liveness after a `del`, in the same order: 0 live, 1
	# revoked on every path reaching here, 2 revoked on some paths and not others. It is
	# what makes `del` mean anything — without it `del v` followed by a use of `v` compiled
	# happily for every type, and the statement was a comment with a keyword in front.
	env_dead: list[int]

	# env_mut is whether each binding may be WRITTEN, in the same order. The parser has
	# always read `mut`, and until now nothing carried it past the AST: `x := 1` followed
	# by `x = 2` compiled, and so did a write to a parameter, to a field of an immutable
	# binding, and to a module `const`. That is not a missing diagnostic but a missing
	# GUARANTEE — the memory model's "no shared mutable Zerg state" rests on a binding
	# being unwritable unless it says otherwise, and nothing was holding the other end.
	env_mut: list[bool]

	# env_scope is the id of the BLOCK each binding was made in, in the same order. A
	# binding is not popped when its block ends — the C names already handed out have to
	# stay reserved — so "already declared here" cannot be read off the list's shape, and
	# depth alone would make two SIBLING blocks look like one scope. A fresh id per block
	# entry is what tells `x := 1; x := 2` (an error) from the same two lines in different
	# `if` arms (fine) and from shadowing an outer binding or a parameter (fine, and
	# `mut n := n` is the ordinary way to get a writable copy of one).
	env_scope: list[int]

	# rel_cnames / rel_fns are the PENDING RELEASES: every binding in scope that owns what
	# it holds, in declaration order, paired with the runtime function that gives it back.
	# Today only channel bindings are on it — a channel binding owns a holder count, and a
	# send count too when it is send-capable, and giving those back is what makes the spec's
	# "close early by narrowing the scope" idiom work without any statement at all — but the
	# list is deliberately type-agnostic: a `str`, `list` or `map` binding joins it by
	# registering a name and a release function, and every exit path already handles it.
	#
	# The list is consumed at the THREE places control leaves a block, and all three go
	# through c_release_from: falling off its end (c_block), `return` (c_return), and
	# `break`/`continue` (c_jump). A fourth exit gets one place to call, which is the whole
	# reason the pair is not shaped like the thing it releases.
	rel_cnames: list[str]
	rel_fns: list[str]
	sig_names: list[str]

	# sig_nparams / sig_nreq are how many arguments a call to each signature MAY give and
	# must give — the parameter count, and the count before the first defaulted one. They
	# are recorded here rather than counted on demand because the question is asked once
	# per CALL SITE, and counting means walking the whole program's parameter table: two
	# scans of ~1.7k rows at every call in the program, for two integers that are fixed
	# the moment the signature is read.
	sig_nparams: list[int]
	sig_nreq: list[int]
	sig_rets: list[Ty]
	sig_hasret: list[bool]
	struct_names: list[str]
	fld_struct: list[str]
	fld_name: list[str]
	fld_ty: list[Ty]
	enum_names: list[str]

	# spec_names is every `spec` the program declares, so a name that fails to resolve as a
	# TYPE can say which of the two it is: a spec used where a type goes, or a typo.
	spec_names: list[str]
	var_name: list[str]
	var_enum: list[str]
	var_tag: list[int]
	vf_variant: list[str]
	vf_index: list[int]
	vf_boxed: list[bool]
	vf_ty: list[Ty]
	used_rt: bool
	used_str: bool

	# used_fnptr records that some function was held as a VALUE, so the generic function
	# pointer the header typedefs is only there for a program that has one.
	used_fnptr: bool
	ref_names: list[str]
	pr_fn: list[str]
	pr_idx: list[int]
	pr_ref: list[bool]

	# pr_ty is each parameter's TYPE, parallel to pr_fn / pr_idx. It is what lets a bare
	# function name be given a type when it is used as a value: `fn(P...) -> R` needs the
	# P's, and the return table alone has only the R.
	pr_ty: list[Ty]

	# pr_hasdef / pr_def carry each parameter's DEFAULT, so a call that omits a trailing
	# argument can be given it. The default belongs to the callee's declaration, and a call
	# site is nowhere near it, which is the whole reason it has to be in a table.
	pr_hasdef: list[bool]
	pr_def: list[Expr]

	# k_names / k_tys are the module CONSTANTS. They are C globals, so they are in scope
	# in every function — c_reset_env seeds the per-function env from them rather than
	# starting empty, which is what lets a body name one.
	k_names: list[str]
	k_tys: list[Ty]

	# tup_names / tup_decls are the tuple CARRIERS. A tuple is a plain C struct, one per
	# distinct shape, generated on demand and emitted with the other typedefs.
	tup_names: list[str]
	tup_decls: list[str]

	# mvt_names / mvt_decls are the map VTABLES — one static per distinct key/value shape,
	# holding the hash and equality for the key type.
	mvt_names: list[str]
	mvt_decls: list[str]

	# dfn_decls are the generated defer thunks and their env structs, one per site.
	# fn_mark is the cleanup-stack mark a `return` unwinds to, and loop_mark the one a
	# `break` or `continue` unwinds to — empty when there is no defer to run.
	dfn_decls: list[str]
	dfn_n: int

	# lam_defs are the lambdas lifted out of expression position, each a whole C function,
	# and lam_n numbers them.
	lam_defs: list[str]
	lam_n: int

	# rcv_names / rcv_decls are the per-element-type receive helpers, and used_conc
	# records that this program touched a channel or a spawn — which is what decides
	# whether main runs under the scheduler and whether the concurrency units link.
	rcv_names: list[str]
	rcv_decls: list[str]
	used_conc: bool
	fn_mark: str
	loop_mark: str

	# loop_rel is the pending-release depth at the innermost enclosing loop BODY's entry —
	# what a `break` or a `continue` has to release on its way out. c_loop_block saves and
	# restores it, so a nested loop cannot leave its own depth visible to the outer one.
	loop_rel: int

	# res_names / res_decls are the `Result[T]` CARRIERS — one C struct per distinct
	# payload shape, plus the `zg_force_*` helper that reads it back. They are registered
	# exactly the way tup_names / tup_decls are, and for the same reason: the name is a
	# pure function of the shape, so two modules of one program spell it alike.
	res_names: list[str]
	res_decls: list[str]

	# fn_ret is the return type of the function currently being emitted, TVoid when it
	# declares none. A `return` is a place a value fills a DECLARED slot, so it is one of
	# the sites where a channel direction has to be checked — and the declared type is
	# nowhere near the statement, so it rides here. c_fn saves and restores it, which is
	# what keeps a lambda's own return type from leaking into the function it sits inside.
	#
	# There is no `has_ret` beside it: a function that declares no return type has TVoid
	# here, and every reader is asking whether this is a CHANNEL, which TVoid is not.
	fn_ret: Ty

	# op_n numbers the temporaries the Result operators need. It is DELIBERATELY not
	# dfn_n: that counter names the defer thunks, the spawn envs and the block marks, and
	# a new operator drawing from it would renumber every one of them downstream — a
	# whole-file diff for a change that touched one expression, and the first thing a
	# fixpoint failure would show.
	op_n: int

	# scope_n hands out block ids and scope_cur is the block being emitted. They are
	# separate from every other counter here because they must not renumber anything: a
	# scope id never reaches the emitted C, so drawing these from dfn_n or op_n would move
	# temp names for a change that emits nothing.
	# at_line / at_col are where the statement being emitted STARTS, updated by the SAt
	# marker the parser puts before each one. Every diagnostic reads them, which is what
	# turns a message into a message with a place.
	at_path: str
	at_line: int
	at_col: int

	# diags is every ILL-FORMED-PROGRAM finding this emission has made, rendered, in the
	# order they were found. They are COLLECTED rather than raised because an error was a
	# process death: a file with three mistakes in it reported one, and the programmer
	# learned about the second only after fixing the first.
	#
	# A checking rule can carry on where an emitting one cannot, which is why only the
	# check.zg rules are on this list. Emit's own `NotImplemented` refusals still raise:
	# they mean this compiler cannot lower the form at all, so there is nothing to carry
	# on with. The C built after a finding is discarded, never handed to cc.
	diags: list[Diag]

	scope_n: int
	scope_cur: int

	# open_scopes is the ids of the blocks currently being emitted, outermost first. A
	# binding is NOT popped when its block ends, so without this a name resolves to the
	# innermost binding that ever existed rather than the innermost one still in scope:
	# `x := 1` then `if … { x := 2 }` then a read of `x` resolved to the inner binding's
	# C name, which C has already closed the brace on.
	open_scopes: list[int]

	# mod_names is the NAMESPACE of every module this program imports — the last segment of
	# each import path. Without it a qualified name could not be told from a typo: `foo.n`
	# with no `foo` anywhere got the advice written for `lib.LIMIT`, because the guard was
	# "nothing else answers to this name" and a misspelling answers to nothing either.
	mod_names: list[str]

	# lv_write is set while the ASSIGNMENT TARGET of a statement is being lowered, and it
	# is what tells `xs[0] = 9` from `x := xs[0]`. A list's buffer is copy-on-write, so a
	# read takes the slot as it is and a write must first make the buffer this list's
	# alone; the two are the same expression on the page and differ only in which side of
	# an `=` they sit on, which no expression node records.
	#
	# It travels DOWN a target — through a field and through an index — because every list
	# on the path is written into: `xs[0].ys[1] = 9` stores into the struct that lives in
	# `xs`'s buffer, so unsharing `ys` alone would edit a header other holders can see.
	lv_write: bool

	# tmp_n numbers the temporaries a call has to hold on to because the CALLER owns them
	# (c_call_releasing). Its own counter, for the reason op_n has one: a name that reaches
	# the emitted C must not renumber because something unrelated grew a thunk, or every
	# fixpoint failure starts with a whole-file diff to read past.
	tmp_n: int
}

# Subst is an active set of identifier substitutions: an EIdent whose name appears in
# `names` emits the parallel `repls` entry instead of a mangled name. It splices a match
# arm's bound names — a scrutinee alias, or an enum payload field access — into the arm's
# guard and body.
struct Subst {
	names: list[str]
	repls: list[str]
}

fn c_nosub() -> Subst {
	return Subst([], [])
}

fn c_extend(sb: Subst, name: str, repl: str) -> Subst {
	mut nn := sb.names
	mut rr := sb.repls
	nn.append(name)
	rr.append(repl)
	return Subst(nn, rr)
}

# --- type helpers --------------------------------------------------------------

# c_type maps a value type to its C spelling.
fn c_type(t: Ty) -> str {
	return match t {
		TInt          => "int64_t"
		TFloat        => "double"
		TStr          => "const char*"
		TBool         => "bool"
		TVoid         => "void"
		TByte         => "uint8_t"
		TNamed(nm)    => "zg_" + nm
		TList(_)      => "zrt_list"
		TFn(_, _)     => "zg_fnptr"
		TTuple(ts)    => c_tuple_cname(ts)
		TMap(_, _)    => "zrt_map"
		TChan(_, _)   => "zrt_chan*"
		TEither(l, r) => c_carrier_cname(l, r)
		TOpt(el)      => c_opt_cname(el)
		TErr          => "zrt_err"
		_             => "int64_t"
	}
}

# --- the Result carrier -----------------------------------------------------------
#
# `Result[T]` is a plain C struct: a tag, the value, and the Err saying why there is not
# one. That encoding is shared with the Go seed and with the runtime's own zrt_result_nil,
# on purpose — the same program built by either toolchain has to behave the same way. The
# fields themselves are spelled in one place, beside the typedef further down.
#
# c_carrier_cname is the name, and it is a PURE function of the payload shape for two
# reasons, both of them hard. c_type has to be able to spell it and has no Emitter to
# ask, which is the constraint c_tuple_cname already lives under. And a build emits ONE
# TRANSLATION UNIT PER MODULE, each with an Emitter of its own, so any serial number
# would give the same shape two different names in two units and the prototypes would
# stop matching. A shape key cannot drift, because it depends on nothing.
#
# Two payloads whose C type coincides — `Result[list[int]]` and `Result[list[str]]` are
# both `zrt_list` — share one carrier. That is harmless: the C is identical, and the
# tuple carriers have behaved this way since they existed.
fn c_carrier_cname(left: Ty, right: Ty) -> str {
	return "zg_res_" + c_ident_safe(c_type(left)) if c_is_err_ty(right)
	return f"zg_eit_{c_ident_safe(c_type(left))}_{c_ident_safe(c_type(right))}"
}

# c_opt_cname is the C name of `T?`'s carrier. It is DISTINCT from the Result's even
# though the layout is the same: the two differ in what an absent value means and in what
# forcing one does, and giving them one name would make `Result[int]` and `int?` the same
# type to every check that compares C names.
fn c_opt_cname(elem: Ty) -> str {
	return "zg_opt_" + c_ident_safe(c_type(elem))
}

# c_opt_name registers the carrier for `T?` and answers its C name — the optional's half of
# what c_carrier_name does for an Either.
fn c_opt_name(mut &em: Emitter, elem: Ty) -> str {
	c_carrier_register(em, TOpt(elem))
	return c_opt_cname(elem)
}

# c_opt_wrap builds a `T?` from something that is not one yet: `nil` is the ABSENT value
# and anything else is present. It is what makes a declared optional mean what it says —
# `x: int? = nil` used to lower to `int64_t zgt_x = 0`, so absent and the number zero were
# the same value and no diagnostic stood between them.
fn c_opt_wrap(mut &em: Emitter, elem: Ty, e: Expr, sb: Subst) -> str {
	cn := c_opt_name(em, elem)
	return "(" + cn + "){ .tag = 1 }" if c_is_nil_lit(e)
	return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, elem, e, sb) + " }"
}

fn c_is_nil_lit(e: Expr) -> bool {
	return match e {
		ENil => true
		_    => false
	}
}

# c_carrier_fit renders `e` where a CARRIER is wanted — a `T?`, a `Result[T]`, an
# `Either[X, Y]`. One of the same shape passes through; anything else is injected into it.
# Every place a declared carrier meets a value goes through here, which is what makes a
# declaration mean what it says: `-> Result[nil] { return nil }` returns a Left, not a bare
# nil that the caller then reads a tag out of.
fn c_carrier_fit(mut &em: Emitter, want: Ty, e: Expr, sb: Subst) -> str {
	et := c_infer(em, e)

	return c_expr(em, e, sb) if c_is_carrier(et) and c_carrier_ty_cname(et) == c_carrier_ty_cname(want)
	return c_opt_wrap(em, c_opt_elem(want), e, sb) if c_is_opt(want)

	return c_either_wrap(em, want, e, sb)
}

# c_fit_copied is what every site where a DECLARED type meets a value calls: a carrier is
# filled, anything else is copied. Filling has to be part of the copy rather than beside it,
# because a carrier's payload may itself be one — `Result[int?]` used to take the bare int
# into a field whose type is the optional's carrier, so the tag it was read back through was
# whatever the value's first bytes happened to be.
fn c_fit_copied(mut &em: Emitter, want: Ty, e: Expr, sb: Subst) -> str {
	return c_carrier_fit(em, want, e, sb) if c_is_carrier(want)

	# a bare `[]` carries NO element type of its own, so it takes the destination's. Without
	# that it lowered to `(zrt_list){0}` — a list of zero-byte elements — and every later
	# push memcpy'd nothing: `take([])` then two appends read back 0. The rule lived on the
	# struct-field path alone, so a field got it and an argument did not.
	if c_is_list(want) and c_is_empty_listlit(e) {
		em.used_rt = true
		return f"zg_empty_list(sizeof({c_type(c_list_elem(want))}), &{c_elem_vt(em, c_list_elem(want))})"
	}
	return c_copied(em, want, e, sb)
}

# c_either_wrap injects a value into an Either. `Left(v)` and `Right(e)` say which side
# explicitly — they are CONTEXT-TYPED, having no type of their own to be — and a bare value
# picks the side its type matches. The sides of an Either differ (parse_type refuses
# `Either[T, T]`), which is what makes that unambiguous.
fn c_either_wrap(mut &em: Emitter, want: Ty, e: Expr, sb: Subst) -> str {
	lt := c_either_left(want)
	rt := c_either_right(want)
	cn := c_carrier_name(em, lt, rt)

	# a `Left`/`Right` with the wrong arity is that form used wrongly, not a value whose type
	# happens to be unknown — saying so beats "this is Left", which is what the bare-value
	# path below reports for it
	c_check_ctor_arity(e)

	side := c_ctor_side(e)
	if side >= 0 {
		inner := c_call_args_of(e)[0]
		return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, lt, inner, sb) + " }" if side == 0
		return "(" + cn + "){ .tag = 1, .err = " + c_fit_copied(em, rt, inner, sb) + " }"
	}

	et := c_infer(em, e)

	return "(" + cn + "){ .tag = 1, .err = " + c_fit_copied(em, rt, e, sb) + " }" if ty_name(et) == ty_name(rt)
	raise f"a {ty_name(want)} takes a {ty_name(lt)} or a {ty_name(rt)}, and this is {ty_name(et)} — say the side with `Left(…)` or `Right(…)`" if ty_name(et) != ty_name(lt) and not c_is_unknown(et)

	return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, lt, e, sb) + " }"
}

# c_ctor_side is which side of an Either a `Left(v)` / `Right(e)` call names — 0, 1, or -1
# for anything that is not one. They are the only calls whose meaning depends on where they
# are written, which is why they are read here rather than in c_call.
fn c_ctor_side(e: Expr) -> int {
	return match e {
		ECall(nm, args) => c_ctor_side_of(nm, args.len())
		_ => 0 - 1
	}
}

# c_check_ctor_arity refuses `Left()` / `Right(a, b)`: each side of an Either holds exactly
# one value.
fn c_check_ctor_arity(e: Expr) {
	match e {
		ECall(nm, args) => c_check_ctor_arity_of(nm, args.len())
		_ => c_skip()
	}
}

fn c_check_ctor_arity_of(nm: str, n: int) {
	raise f"`{nm}(…)` names one side of an `Either`, which holds exactly one value — this has {strconv.to_string(n, 10)}" if (nm == "Left" or nm == "Right") and n != 1
}

fn c_ctor_side_of(nm: str, n: int) -> int {
	return 0 if nm == "Left" and n == 1
	return 1 if nm == "Right" and n == 1

	return 0 - 1
}

# c_optchain lowers `a?.b` (GRAMMAR group 8): read `.b` when `a` is present, else nil IN
# PLACE. The result is itself an optional, which is what lets a chain keep going — every
# link answers the same shape, so only the end of it needs a `??` or a `!`.
#
# The operand is bound to a temp because it is read twice, the tag and then the payload,
# exactly as `??` does; and the branch is a statement rather than a ternary because the two
# sides fill different fields of the answer.
fn c_optchain(mut &em: Emitter, target: Expr, fld: str, sb: Subst) -> str {
	t := c_infer(em, target)
	raise f"`?.` reads through an optional, and {ty_name(t)} is not one — use `.` for a value that is always there" if not c_is_opt(t)
	inner := c_opt_elem(t)
	ft := c_field_ty(em, c_named_of(inner), fld)
	raise f"no field `{fld}` on {ty_name(inner)} (optional chain `?.{fld}`)" if c_is_unknown(ft)

	# a field that is ALREADY optional flattens: `T??` is not a type — GRAMMAR's
	# `type ::= base-type '?'?` allows exactly one marker — and "nil in place" means the
	# chain answers the same shape whether the absence came from the operand or the field.
	mut oft := ft
	if c_is_opt(ft) {
		oft = c_opt_elem(ft)
	}

	src := c_opt_name(em, inner)
	dst := c_opt_name(em, oft)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	tv := "zgt_oc" + tag
	rv := "zgt_ocr" + tag
	mut out := f"({{ {src} {tv} = {c_expr(em, target, sb)}; {dst} {rv};"
	acc := f"{c_res_ok(tv)}.zg_{fld}"
	mut take := f"{c_res_mark_left(rv)} {c_res_ok(rv)} = {acc};"
	if c_is_opt(ft) {
		# the field carries its own tag, so the answer IS the field
		take = f"{rv} = {acc};"
	}
	out = out + " if (" + c_res_is_left(tv) + ") { " + take + " }"
	return out + " else { " + c_res_mark_right(rv) + " } " + rv + "; })"
}

# c_try lowers `x?` (GRAMMAR group 8): the payload, or an early return of the absent side
# from the ENCLOSING function. It is a control transfer written as an expression, so what
# it needs is not a lowering trick but a RESULT TYPE that can carry the thing it returns —
# which is why the function's own signature decides whether it can be written at all.
#
# Scoped to the optional. A `Result[T]` operand needs `Result[T]` to survive in a signature,
# and this compiler still erases it there, so that half is refused by name rather than
# early-returning a carrier the caller was never given.
#
# The early return runs the same cleanup an ordinary `return` does — the defers, then every
# binding's release — because it IS an ordinary return, just written inside an expression.
fn c_try(mut &em: Emitter, x: Expr, sb: Subst) -> str {
	t := c_infer(em, x)

	raise f"NotImplemented: `?` on a {ty_name(t)} — it unwraps the Left of a carrier, and that is a `T?`, a `Result[T]` or an `Either[X, Y]`" if not c_is_carrier(t)
	raise f"`?` early-returns the RIGHT of {ty_name(t)}, so the enclosing function must answer a carrier with the same right — this one answers {ty_name(em.fn_ret)}" if not c_is_carrier(em.fn_ret)

	# the two rights must MATCH: `?` hands the operand's right side straight out of the
	# function, so a `Result[T]` cannot propagate out of one answering `int?` — there would
	# be no Err to put in the absent side, and no absence to make of an Err.
	raise f"`?` propagates the right of {ty_name(t)} out of a function answering {ty_name(em.fn_ret)}, and the two rights differ — convert first (`opt.ok_or(err)`, `res.ok()`)" if not c_right_matches(t, em.fn_ret)

	src := c_carrier_of(em, t)
	rcn := c_carrier_of(em, em.fn_ret)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tv := "zgt_tr" + tag
	mut out := f"({{ {src} {tv} = {c_expr(em, x, sb)};"
	out = out + " if (" + c_res_is_right(tv) + ") {"
	if em.fn_mark != "" {
		out = out + " zrt_unwind_to(" + em.fn_mark + ");"
	}
	out = out + " " + c_release_from(em, 0, "")

	# the right side travels UNCHANGED — an optional's carries nothing, and an Either's
	# carries the value that is the whole reason the early return happened
	mut right := f"({rcn}){{ .tag = 1 }}"
	if not c_is_opt(em.fn_ret) {
		right = f"({rcn}){{ .tag = 1, .err = {c_res_err(tv)} }}"
	}
	return out + " return " + right + "; } " + c_res_ok(tv) + "; })"
}

# c_right_matches reports whether two carriers propagate the same thing: an optional's
# right is `nil` and carries nothing, and an Either's is its declared right type.
fn c_right_matches(a: Ty, b: Ty) -> bool {
	return c_is_opt(b) if c_is_opt(a)
	return false if c_is_opt(b)

	return ty_name(c_either_right(a)) == ty_name(c_either_right(b))
}

fn c_optchain_ty(mut &em: Emitter, target: Expr, fld: str) -> Ty {
	t := c_infer(em, target)
	return TUnknown if not c_is_opt(t)
	ft := c_field_ty(em, c_named_of(c_opt_elem(t)), fld)

	return TUnknown if c_is_unknown(ft)
	return ft if c_is_opt(ft)

	return TOpt(ft)
}

fn c_is_opt(t: Ty) -> bool {
	return match t {
		TOpt(_) => true
		_       => false
	}
}

fn c_opt_elem(t: Ty) -> Ty {
	return match t {
		TOpt(e) => e
		_       => TUnknown
	}
}

# c_is_carrier / c_carrier_elem are what the OPERATORS ask, rather than asking for a
# Result: `??`, `!` and `if v := …` read a tag and a value, and both carriers have those.
# The two only part company where the absent side is built or explained.
fn c_is_carrier(t: Ty) -> bool {
	return c_is_either(t) or c_is_opt(t)
}

fn c_carrier_elem(t: Ty) -> Ty {
	return c_opt_elem(t) if c_is_opt(t)
	return c_result_elem(t)
}

# c_carrier_of registers whichever carrier a type is and answers its C name.
fn c_carrier_of(mut &em: Emitter, t: Ty) -> str {
	return c_opt_name(em, c_opt_elem(t)) if c_is_opt(t)
	return c_carrier_name(em, c_either_left(t), c_either_right(t))
}

# c_is_result is the Either whose Right is `Err` — the shape `guard` and a receive answer
# with, and the one `?` propagates out of a function. c_is_either is any of them.
fn c_is_result(t: Ty) -> bool {
	return c_is_either(t) and c_is_err_ty(c_either_right(t))
}

fn c_is_either(t: Ty) -> bool {
	return match t {
		TEither(_, _) => true
		_             => false
	}
}

fn c_result_elem(t: Ty) -> Ty {
	return c_either_left(t)
}

fn c_either_left(t: Ty) -> Ty {
	return match t {
		TEither(l, _) => l
		_             => TUnknown
	}
}

fn c_either_right(t: Ty) -> Ty {
	return match t {
		TEither(_, r) => r
		_             => TUnknown
	}
}

fn c_is_err_ty(t: Ty) -> bool {
	return match t {
		TErr => true
		_    => false
	}
}

# --- the carrier's field layout, written down once ---------------------------------
#
# THE LAYOUT LIVES HERE AND NOWHERE ELSE. The typedef below declares it and the accessors
# beside it are how every operator reads and writes one, so `??`, `!`, `guard`, `match`,
# `if let`, `select` and the receive helper name no field of their own. That is not tidiness:
# the layout has to stay byte-compatible with the Go seed's emit_result.go, because the same
# program built by either toolchain has to behave the same way — and the fixpoint gate cannot
# see it drift, since the self-hosted compiler is only ever compared with itself. One place
# to change is the whole of the protection.
#
# `tag == 0` is Left(v) and reads `.ok`; `tag == 1` is Right(err) and reads `.err`.

fn c_res_tag(r: str) -> str {
	return r + ".tag"
}

fn c_res_ok(r: str) -> str {
	return r + ".ok"
}

# c_res_taken is a carrier's payload TAKEN OUT as a value of its own. A carrier is a value
# holding a value, so the thing extracted from one is a copy of it — `mut c := a ?? []` on
# a `list[int]?` handed back the carrier's own header, uncounted, and a write through `c`
# was read back through `a`. The temp the payload comes out of is about to die, so the copy
# is what gives the result a reference of its own.
fn c_res_taken(mut &em: Emitter, r: str, elem: Ty) -> str {
	return c_res_ok(r) if not c_needs_copy(em, elem)
	return c_copy_of(em, elem, c_res_ok(r))
}

fn c_res_err(r: str) -> str {
	return r + ".err"
}

fn c_res_is_left(r: str) -> str {
	return c_res_tag(r) + " == 0"
}

fn c_res_is_right(r: str) -> str {
	return c_res_tag(r) + " != 0"
}

# c_res_mark_left / c_res_mark_right are the discriminant WRITES — a whole C statement,
# because that is how a carrier is filled in the statement contexts (`guard`, `select`)
# where a compound literal cannot go.
fn c_res_mark_left(r: str) -> str {
	return c_res_tag(r) + " = 0;"
}

fn c_res_mark_right(r: str) -> str {
	return c_res_tag(r) + " = 1;"
}

# c_carrier_name registers the carrier for `Either[L, R]` and answers its C name. Every
# operator that reads one back goes through the accessors above rather than writing `.ok` /
# `.err` itself, which is what lets an optional and an either share the whole set.
fn c_carrier_name(mut &em: Emitter, left: Ty, right: Ty) -> str {
	c_carrier_register(em, TEither(left, right))
	return c_carrier_cname(left, right)
}

# c_carrier_register registers a carrier TYPE once per shape and appends its declaration
# where the ordinary on-demand path wants it. c_carrier_decl is the declaration itself,
# split out because the pre-pass below needs the same text placed somewhere else — in
# declaration order, ahead of the struct typedefs that name it.
fn c_carrier_register(mut &em: Emitter, c: Ty) {
	name := c_carrier_ty_cname(c)
	return if c_name_in(em.res_names, name)

	em.used_rt = true
	em.res_names.append(name)
	em.res_decls.append(c_carrier_decl(em, c))
}

# c_carrier_decl writes ONE carrier: a tag, the Left, and — unless it is an optional, whose
# absent side carries nothing — the Right. The field names are the same for all three, so
# every accessor and every operator works on any of them without asking which it is.
#
# The layout has to stay byte-compatible with the Go seed's emit_result.go, because the same
# program built by either toolchain has to behave the same way.
fn c_carrier_decl(mut &em: Emitter, c: Ty) -> str {
	name := c_carrier_ty_cname(c)
	left := c_carrier_left(c)
	ct := c_type(left)

	mut d := f"typedef struct {{ int32_t tag; {ct} ok; }} {name};\n"
	if not c_is_opt(c) {
		d = f"typedef struct {{ int32_t tag; {ct} ok; {c_type(c_either_right(c))} err; }} {name};\n"
	}
	d = d + "static " + ct + " zg_force_" + name + "(" + name + " r) {\n"

	# forcing a Right RE-RAISES it when it is an Err — the reason it is there is in it. An
	# optional's absent side and a general Either's Right carry no abort, so forcing one
	# raises a message of its own.
	mut fail := "zrt_raise_err(zrt_err_new(\"force-unwrap of a Right\"));"
	if c_is_opt(c) {
		fail = "zrt_raise_err(zrt_err_new(\"force-unwrap of nil\"));"
	} else if c_is_err_ty(c_either_right(c)) {
		fail = "zg_force_fail(" + c_res_err("r") + ");"
	}
	d = d + "    if (" + c_res_is_right("r") + ") { " + fail + " }\n"

	# the payload is TAKEN OUT, so it comes out as a value of its own — `r` is a by-value
	# parameter about to die, and returning its header uncounted made `a!` a second name
	# for the carrier's buffer
	return d + "    return " + c_res_taken(em, "r", left) + ";\n}\n"
}

# c_carrier_ty_cname / c_carrier_left read a carrier TYPE — an optional or an either —
# without the caller having to know which of the two it holds.
fn c_carrier_ty_cname(c: Ty) -> str {
	return c_opt_cname(c_opt_elem(c)) if c_is_opt(c)
	return c_carrier_cname(c_either_left(c), c_either_right(c))
}

fn c_carrier_left(c: Ty) -> Ty {
	return c_opt_elem(c) if c_is_opt(c)
	return c_either_left(c)
}

# c_carrier_prelude is what every force helper lands on: an Err that was never meant to
# be forced, re-raised as the abort it is.
#
# The Err goes up WHOLE — message, cause and kind — with only the kind's NAME prefixed
# onto the message, which is the same `Kind: message` shape a runtime abort already
# reports. That prefix is the whole reason this is not a one-liner: a clean close carries
# the message "channel closed" under the kind StopIteration, and an abort that said only
# "channel closed" would leave the reader to guess which of the two endings they had.
# A generic Err (kind NONE, what a bare `raise "…"` builds) has no name to add, so a
# crash reason arrives verbatim — which is what makes a forced crash readable at all.
fn c_carrier_prelude() -> str {
	mut out := "static const char *zg_err_kindname(int k) {\n"
	for nm in c_err_kinds() {
		out = out + "    if (k == " + strconv.to_string(c_err_kind(nm), 10) + ") { return \"" + nm + "\"; }\n"
	}
	out = out + "    return NULL;\n}\n"
	out = out + "static void zg_force_fail(zrt_err e) {\n"
	out = out + "    const char *k = zg_err_kindname(e.kind);\n"
	out = out + "    if (k != NULL) { e.msg = zrt_str_concat(k, zrt_str_concat(\": \", e.msg)); }\n"
	out = out + "    zrt_raise_err(e);\n}\n"
	return out
}

# A held function is stored as ONE C type, `zg_fnptr` — a generic function pointer — and
# cast back to its real signature at the call. C guarantees exactly this round trip
# between function pointer types and no more, which is why the storage type is a function
# pointer rather than `void*`: converting a function pointer to an object pointer is not
# something the standard promises.
#
# A single storage type is also what keeps the declarator problem away. A C function
# pointer spells its name INSIDE the type — `int64_t (*f)(const char*)` — and every type
# in this emitter is a string that gets a name appended to it. A typedef sidesteps that
# for every function type at once, with no table of them to build and keep.
fn c_fnptr_typedef() -> str {
	return "typedef void (*zg_fnptr)(void);\n"
}

# c_fnptr_cast is the cast back to a real signature, `(R (*)(P, ...))`.
fn c_fnptr_cast(t: Ty) -> str {
	return match t {
		TFn(ps, r) => f"({c_type(r)} (*)({c_ptypes(ps)}))"
		_          => ""
	}
}

fn c_ptypes(ps: list[Ty]) -> str {
	return "void" if ps.len() == 0
	mut out := ""
	mut i := 0
	for i < ps.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + c_type(ps[i])
		i = i + 1
	}
	return out
}

fn c_is_fn(t: Ty) -> bool {
	return match t {
		TFn(_, _) => true
		_         => false
	}
}

fn c_fn_ret(t: Ty) -> Ty {
	return match t {
		TFn(_, r) => r
		_         => TUnknown
	}
}

fn c_is_unknown(t: Ty) -> bool {
	return match t {
		TUnknown => true
		_        => false
	}
}

fn c_is_byte(t: Ty) -> bool {
	return match t {
		TByte => true
		_     => false
	}
}

fn c_is_str(t: Ty) -> bool {
	return match t {
		TStr => true
		_    => false
	}
}

# c_list_elem returns the element type of a list type, or TUnknown otherwise.
fn c_list_elem(t: Ty) -> Ty {
	return match t {
		TList(e) => e
		_        => TUnknown
	}
}

fn c_is_list(t: Ty) -> bool {
	return match t {
		TList(_) => true
		_        => false
	}
}

fn c_is_float(t: Ty) -> bool {
	return match t {
		TFloat => true
		_      => false
	}
}

fn c_is_int(t: Ty) -> bool {
	return match t {
		TInt => true
		_    => false
	}
}

# c_is_bool_op reports whether a binary operator yields a bool (comparisons and the
# logical connectives).
fn c_is_bool_op(oper: str) -> bool {
	return true if oper == "==" or oper == "!=" or oper == "<" or oper == ">" or oper == "<=" or oper == ">="
	return oper == "and" or oper == "or"
}

# --- environment + signatures --------------------------------------------------

fn c_reset_env(mut &em: Emitter) {
	em.env_names = []
	em.env_tys = []
	em.env_cnames = []
	em.env_dead = []
	em.env_mut = []
	em.env_scope = []

	# scope 0 is the module: the constants below live there and it is open in every
	# function. c_fn opens one more for the parameters, and the body block one after that.
	em.scope_cur = 0
	em.open_scopes = [0]
	em.rel_cnames = []
	em.rel_fns = []
	em.loop_rel = 0
	em.ref_names = []

	# a module constant is a global: in scope everywhere, so every function body starts
	# with them already bound
	mut i := 0
	for i < em.k_names.len() {
		em.env_names.append(em.k_names[i])
		em.env_tys.append(em.k_tys[i])
		em.env_cnames.append("zg_" + em.k_names[i])
		em.env_dead.append(0)

		# a `const` is the one binding the language never lets anyone write, so this is
		# the only entry here whose answer is fixed rather than read off a declaration
		em.env_mut.append(false)

		# scope 0 is the module: a constant is in scope in every function, and a local
		# that shadows one is in a block of its own and so is not a redeclaration
		em.env_scope.append(0)
		i = i + 1
	}
}

# c_add_var binds a name. `is_mut` is whether it may be written afterwards, and every
# caller answers it from the form it is emitting rather than from a default: a `mut`
# binding and a `mut &` parameter say yes; a plain binding, a by-value parameter, a loop
# variable and a pattern binding all say no.
fn c_add_var(mut &em: Emitter, name: str, t: Ty, is_mut: bool) {
	cname := c_fresh_cname(em, name)
	em.env_names.append(name)
	em.env_tys.append(t)
	em.env_cnames.append(cname)
	em.env_dead.append(0)
	em.env_mut.append(is_mut)
	em.env_scope.append(em.scope_cur)
}

# c_fresh_cname is the C name a new binding takes: `zg_<name>`, or `zg_<name>__<n>` when
# that is already taken by a binding still in scope.
fn c_fresh_cname(mut &em: Emitter, name: str) -> str {
	base := "zg_" + name
	mut cand := base
	mut n := 0
	for c_cname_taken(em, cand) {
		n = n + 1
		cand = f"{base}__{n}"
	}
	return cand
}

# c_in_scope is whether a binding's block is still open. A closed block's bindings stay in
# the environment — their C names must not be handed out twice — but nothing may NAME them.
fn c_in_scope(mut &em: Emitter, idx: int) -> bool {
	for id in em.open_scopes {
		return true if em.env_scope[idx] == id
	}
	return false
}

fn c_cname_taken(mut &em: Emitter, cand: str) -> bool {
	for c in em.env_cnames {
		return true if c == cand
	}
	return false
}

# c_var_cname resolves a source name to the C name its binding took — the innermost one
# STILL IN SCOPE, so a shadowing binding wins from its declaration until its block ends.
#
# It and c_lookup_var both defer to c_live_idx rather than repeating its walk. They used to
# be three copies of one loop, which meant the scoping rule had three homes: adding
# `c_in_scope` to it was one edit made three times, and the next rule would be too.
fn c_var_cname(mut &em: Emitter, name: str) -> str {
	idx := c_live_idx(em, name)
	return em.env_cnames[idx] if idx >= 0
	return "zg_" + name
}

fn c_lookup_var(mut &em: Emitter, name: str) -> Ty {
	idx := c_live_idx(em, name)
	return em.env_tys[idx] if idx >= 0
	return TUnknown
}

# --- `del` liveness ----------------------------------------------------------------
#
# `del name` revokes a name's access (GRAMMAR group 11, docs/core/memory.md). The
# revocation is the entire statement — it emits no C — so it is worth only as much as the
# check that a revoked name is never read again, and the check has to be FLOW-SENSITIVE or
# it says the wrong thing about an `if` that revokes on one branch.
#
# The model is the seed's (src/bootstrap/internal/sema/sema.go, the `liveness` type and
# mergeDead), carried on the flat env stack this emitter already keeps: a name dead on
# every path reaching a use is a hard use-after-del, dead on some paths but not others is
# its own case, and the two get different words because they are different mistakes.
#
# It rides the emission walk rather than a pass of its own, which is why the merge points
# are written out at each control-flow form: the emitter already visits a body exactly
# once, in source order.

# c_live_idx is the index of the innermost binding of a name, or -1 when nothing binds it.
fn c_live_idx(mut &em: Emitter, name: str) -> int {
	mut i := em.env_names.len() - 1
	for i >= 0 {
		return i if em.env_names[i] == name and c_in_scope(em, i)
		i = i - 1
	}
	return -1
}

# c_live_del marks a name revoked on this path. Revoking is idempotent, so a symmetric
# `del` on both branches of an `if` merges cleanly back to revoked.
fn c_live_del(mut &em: Emitter, name: str) {
	idx := c_live_idx(em, name)
	return if idx < 0
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i == idx {
			out.append(1)
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_use refuses a read of a revoked name. This is the whole payoff: what used to be a
# use-after-free waiting to happen is a diagnostic at the line that wrote it.
fn c_live_use(mut &em: Emitter, name: str) {
	idx := c_live_idx(em, name)

	return if idx < 0
	raise f"`{name}` is used after del" if em.env_dead[idx] == 1
	raise f"`{name}` is used after del on some paths" if em.env_dead[idx] == 2
}

# c_live_save copies the current liveness, so a branch can be analysed from the shared
# entry state and its end merged rather than leaking into its sibling.
fn c_live_save(mut &em: Emitter) -> list[int] {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		out.append(em.env_dead[i])
		i = i + 1
	}
	return out
}

# c_live_restore puts a saved entry state back, so the next branch starts where the first
# one did. A binding the branch declared is past the end of the saved list and stays as it
# is — it is out of scope by the time this matters.
fn c_live_restore(mut &em: Emitter, saved: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i < saved.len() {
			out.append(saved[i])
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_merge joins one path's end state into the current one, entry by entry.
fn c_live_merge(mut &em: Emitter, other: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i < other.len() {
			out.append(c_live_join(em.env_dead[i], other[i]))
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_join is the two-path join: revoked on both stays revoked, live on both stays live,
# and one of each is the inconsistent case a later use is refused for.
fn c_live_join(a: int, b: int) -> int {
	return 0 if a == 0 and b == 0
	return 1 if a == 1 and b == 1

	return 2
}

# c_sig_key is how a function is looked up in the signature and parameter tables. A free
# function is keyed by its bare name; a method by `Type#name`. The '#' cannot occur in an
# identifier, so a method can never be mistaken for the free function of the same name —
# which is the whole point, since `App.parse` and the compiler's own `parse` must coexist.
fn c_sig_key(recv: str, name: str) -> str {
	return name if recv == ""
	return f"{recv}#{name}"
}

# c_fn_cname is the C symbol a function is emitted as. Free functions share one flat
# `zg_<name>` space with every module of the program; a method is `zg_<Type>_<name>`, off
# that space and unable to collide with it, since a type name is PascalCase and so cannot
# be confused with the snake_case free functions it sits beside.
fn c_fn_cname(recv: str, name: str) -> str {
	return "zg_" + name if recv == ""
	return f"zg_{recv}_{name}"
}

# c_sig_seen is `c_name_in(em.sig_names, key)` without the copy. `c_name_in` takes its list
# BY VALUE, and this question is asked once per function — 788 of them in a self-build — so
# the copy alone was ~310k element copies per unit for a scan that needs none.
fn c_sig_seen(mut &em: Emitter, key: str) -> bool {
	mut i := 0
	for i < em.sig_names.len() {
		return true if em.sig_names[i] == key
		i = i + 1
	}
	return false
}

fn c_build_sigs(mut &em: Emitter, f: File) {
	mut i := 0
	for i < f.fns.len() {
		fn_i := f.fns[i]
		key := c_sig_key(fn_i.recv, fn_i.name)

		# A NAME DECLARED TWICE, and the two halves of that are different rules.
		#
		# On a TYPE it is the language's: "Every method and associated fn on a type shares
		# one namespace, spec or inherent alike; a duplicate is an error" (GRAMMAR:498) —
		# which is also how a second `impl Spec for T` arrives, since a type has one
		# canonical implementation of a spec (docs/core/specs.md). It used to be reported as
		# two modules colliding, about one module and one type.
		#
		# For a FREE function it is this compiler's: every module flattens into one scope
		# here, so two modules declaring one name mangle to the same C symbol. That used to
		# be reported by the LINKER — `duplicate symbol '_zg_name'`, no file, no line — one
		# reporter further away than cc.
		if c_sig_seen(em, key) {
			raise f"`{fn_i.recv}` declares `{fn_i.name}` twice — every method on a type shares one namespace, spec or inherent alike, and a type has one canonical implementation of a spec" if fn_i.recv != ""

			raise f"NotImplemented: two modules both define `{fn_i.name}` — this compiler flattens every module into one namespace, so the two cannot be told apart"
		}
		em.sig_names.append(key)
		em.sig_rets.append(fn_i.ret)
		em.sig_hasret.append(fn_i.has_ret)
		em.sig_nparams.append(fn_i.params.len())
		em.sig_nreq.append(c_required_params(fn_i))
		mut j := 0
		for j < fn_i.params.len() {
			em.pr_fn.append(key)
			em.pr_idx.append(j)
			em.pr_ref.append(fn_i.params[j].is_ref)
			em.pr_ty.append(fn_i.params[j].ty)
			em.pr_hasdef.append(fn_i.params[j].has_def)
			em.pr_def.append(fn_i.params[j].def)
			j = j + 1
		}
		i = i + 1
	}
}

# c_param_row finds a parameter's row in the tables c_build_sigs filled, or -1 when the
# function has no such parameter. Everything asked ABOUT a parameter — is it a reference,
# what is its type, does it have a default, what is that default — reads its row, so the
# search happens once per question rather than once per field, and the answers cannot
# drift apart.
#
# c_build_sigs appends a function's parameters CONTIGUOUSLY in index order, so the row a
# function's parameter 0 sits at fixes every other one; the scan below stops as soon as it
# is past that block, which is what keeps a fully-applied call — nearly every call — from
# walking the whole program's parameters to learn it has no default to backfill.
# c_required_params is how many arguments a call to this function must give: every
# parameter up to the first one with a default, since a default may only follow defaults.
fn c_required_params(fn_d: FnDecl) -> int {
	mut n := 0
	for pm in fn_d.params {
		return n if pm.has_def
		n = n + 1
	}
	return n
}

# c_sig_row is a signature's index in the sig_* columns, or -1 when nothing registered it.
fn c_sig_row(mut &em: Emitter, key: str) -> int {
	mut i := 0
	for i < em.sig_names.len() {
		return i if em.sig_names[i] == key
		i = i + 1
	}
	return -1
}

fn c_param_row(mut &em: Emitter, fname: str, idx: int) -> int {
	mut i := 0
	mut seen := false
	for i < em.pr_fn.len() {
		if em.pr_fn[i] == fname {
			return i if em.pr_idx[i] == idx
			seen = true
		} else if seen {
			# past the function's own block: it has no parameter idx
			return -1
		}
		i = i + 1
	}
	return -1
}

fn c_is_ref_name(mut &em: Emitter, name: str) -> bool {
	mut i := 0
	for i < em.ref_names.len() {
		return true if em.ref_names[i] == name
		i = i + 1
	}
	return false
}

fn c_lookup_sig_ret(mut &em: Emitter, name: str) -> Ty {
	mut i := 0
	for i < em.sig_names.len() {
		if em.sig_names[i] == name {
			return em.sig_rets[i] if em.sig_hasret[i]
			return TVoid
		}
		i = i + 1
	}
	return TUnknown
}

# c_has_method reports whether type `recv` declares a method `meth`, and c_is_free_fn
# whether a bare name is a free function — a method is excluded from the second, since it
# is keyed by its type and has no bare name to be reached by.
#
# Both ask about EXISTENCE, which the signature table answers with TUnknown: a declared
# function that returns nothing is TVoid, and no declared return type is ever TUnknown, so
# the two cannot be confused. Deriving them from the one lookup rather than scanning the
# table again is what keeps them from drifting away from it.
fn c_has_method(mut &em: Emitter, recv: str, meth: str) -> bool {
	return false if recv == ""
	return not c_is_unknown(c_lookup_sig_ret(em, c_sig_key(recv, meth)))
}

fn c_is_free_fn(mut &em: Emitter, n: str) -> bool {
	return not c_is_unknown(c_lookup_sig_ret(em, n))
}

# c_builtin_check raises for a documented built-in this compiler has not built, and returns
# for every other name so the caller reports whatever it was going to.
#
# The built-in set is CLOSED (docs/runtime/builtins.md) — a user cannot add to it — so a
# program naming one of these has not made a typo, and answering "undefined name `sizeof`"
# tells a reader the language does not have it when the documentation says it does. Every
# one of them is built by the SEED, which is what makes the wording matter: the form exists,
# this compiler is the one that is behind.
#
# The three report sites funnel through here, so the answer does not depend on whether the
# name was reached as a call, as a constructor or as a bare value.
#
# This is one THIRD of that closed set. The conversions and the str/list bridges are decided
# by `is_conv`/`conv_ty` in parser.zg, and the error constructors by `c_err_kinds` here — so
# nothing can yet assert that every row of builtins.md is either built or named. Whoever
# unifies the three should start from those two names.
fn c_builtin_check(n: str) {
	raise "NotImplemented: a refcounted box `Ref(x)` / `deref(r)` — this compiler has no `Ref[T]` type" if n == "Ref" or n == "deref"
	raise f"NotImplemented: the raw-pointer built-in `{n}` — bare-metal memory access, which is `unsafe`-only and not built here" if n == "addr" or n == "ptr"
	raise f"NotImplemented: the compile-time built-in `{n}[T]` — this compiler does not compute a type's layout" if n == "sizeof" or n == "alignof"
}

# c_is_ctor reports whether a name denotes a type constructor rather than a function
# call — Zerg types are PascalCase and functions snake_case, so an uppercase first
# letter is the tell.
fn c_is_ctor(name: str) -> bool {
	b := list[byte](name)
	return false if b.len() == 0
	return ascii.is_upper(b[0])
}

# c_type_decls writes every type declaration a unit needs, IN DEPENDENCY ORDER: the enums,
# the structs, and the carriers over them. C needs the complete type of everything a
# declaration holds BY VALUE ahead of it, and all three kinds hold each other — a struct
# field may be an enum, an enum's payload may be a struct, and a carrier holds whichever it
# wraps. Three fixed passes could only ever be right by luck, and were not: enums went first
# on the assumption that "a struct is never held by an enum", which `enum E { Wrap(Later) }`
# is not. Each sweep here emits whatever has all of its dependencies already out.
#
# A group that can never be emitted is a CYCLE — `struct A { b: B }` with `struct B { a: A }`
# — a type of infinite size rather than an ordering problem, and it is named as such.
fn c_type_decls(mut &em: Emitter, f: File, carriers: list[Ty], tuples: list[Ty]) -> str {
	mut out := ""

	# EVERY name this pass will emit, collected ONCE. It is what "does this dependency have
	# to wait?" is asked against, and the answer cannot change while the sweep runs — so
	# deriving it per dependency was waste, and expensive waste: the lists it came from were
	# reached through a by-value `File`, which is the whole program's AST. That copy, taken
	# twice per dependency per sweep, was a fifth of every compile.
	mut all: list[str] = []
	for ed in f.enums {
		all.append(ed.name)
	}
	for sd in f.structs {
		all.append(sd.name)
	}
	for c in carriers {
		all.append(c_carrier_ty_cname(c))
	}
	for t in tuples {
		all.append(c_tuple_cname(ty_tuple_elems(t)))
	}

	mut done: list[str] = []
	mut es := f.enums
	mut ss := f.structs
	mut cs := carriers
	mut ts := tuples

	for es.len() > 0 or ss.len() > 0 or cs.len() > 0 or ts.len() > 0 {
		# `done` is the only thing a sweep moves, so its length before and after IS whether
		# progress was made — and a sweep that emits nothing never will
		n0 := done.len()

		mut es2: list[EnumDecl] = []
		for ed in es {
			if c_deps_done(c_enum_deps(ed), ed.name, done, all) {
				out = out + c_enum_typedef(ed)
				done.append(ed.name)
			} else {
				es2.append(ed)
			}
		}
		es = es2

		mut ss2: list[StructDecl] = []
		for sd in ss {
			if c_deps_done(c_struct_deps(sd), sd.name, done, all) {
				out = out + c_struct_typedef(sd)
				done.append(sd.name)
			} else {
				ss2.append(sd)
			}
		}
		ss = ss2

		mut cs2: list[Ty] = []
		for c in cs {
			cn := c_carrier_ty_cname(c)
			if c_deps_done(c_carrier_deps(c), cn, done, all) {
				out = out + c_carrier_decl(em, c)
				em.res_names.append(cn)
				em.used_rt = true
				done.append(cn)
			} else {
				cs2.append(c)
			}
		}
		cs = cs2

		# the same arm again for TUPLES. A tuple is a typedef like a carrier is, it names
		# the declared types its elements hold, and a struct field of tuple type depends on
		# it — so it belongs in the sweep rather than in a block emitted before or after it,
		# which is where it was and why `pair: (Q, int)` had to be turned away.
		mut ts2: list[Ty] = []
		for t in ts {
			elems := ty_tuple_elems(t)
			tn := c_tuple_cname(elems)
			if c_deps_done(c_ty_list_deps(elems), tn, done, all) {
				out = out + c_tuple_decl(em, elems)
				done.append(tn)
			} else {
				ts2.append(t)
			}
		}
		ts = ts2

		raise f"`{c_stuck_name(es, ss, cs)}` is part of a cycle of by-value declarations — a type holding itself, however indirectly, has no size; hold it behind a `list`, or box it as a self-recursive enum payload" if done.len() == n0
	}
	return out
}

# c_deps_done reports whether every DECLARED type a declaration names by value is already
# out. A name this program does not declare — a scalar, a runtime container — needs nothing
# ahead of it, and a SELF reference is boxed rather than held.
fn c_deps_done(deps: list[str], own: str, mut &done: list[str], mut &all: list[str]) -> bool {
	for dep in deps {
		if dep != own and c_name_in(all, dep) {
			return false if not c_name_in(done, dep)
		}
	}
	return true
}

fn c_struct_deps(sd: StructDecl) -> list[str] {
	mut deps: list[str] = []
	for fd in sd.fields {
		c_ty_struct_deps(fd.ty, deps)
	}
	return deps
}

fn c_enum_deps(ed: EnumDecl) -> list[str] {
	mut deps: list[str] = []
	for v in ed.variants {
		for t in v.fields {
			c_ty_struct_deps(t, deps)
		}
	}
	return deps
}

fn c_carrier_deps(c: Ty) -> list[str] {
	mut deps: list[str] = []
	if c_is_opt(c) {
		c_ty_struct_deps(c_opt_elem(c), deps)
	} else {
		c_ty_struct_deps(c_either_left(c), deps)
		c_ty_struct_deps(c_either_right(c), deps)
	}
	return deps
}

# c_ty_struct_deps collects the declared type names a type needs COMPLETE where it is used
# by value. A carrier holds its payload by value, so `Y?` and `Result[Y]` need Y as surely
# as a bare `Y` does — which is why the ordering could not be read off a field's own name.
# A `list[Y]` needs nothing: the runtime container holds its elements behind a pointer.
fn c_ty_struct_deps(t: Ty, mut &out: list[str]) {
	match t {
		TNamed(nm)    => out.append(nm)
		TOpt(el)      => out.append(c_carrier_ty_cname(TOpt(el)))
		TEither(l, r) => out.append(c_carrier_ty_cname(TEither(l, r)))
		TTuple(ts)    => out.append(c_tuple_cname(ts))
		_             => c_skip()
	}
}

# c_ty_list_deps is the declared types a list of types names, which is what a tuple's
# elements are.
fn c_ty_list_deps(ts: list[Ty]) -> list[str] {
	mut out: list[str] = []
	c_ty_struct_deps_list(ts, out)
	return out
}

fn c_ty_struct_deps_list(ts: list[Ty], mut &out: list[str]) {
	for t in ts {
		c_ty_struct_deps(t, out)
	}
}

# c_stuck_name names one member of the group that could not be emitted, for the diagnostic.
fn c_stuck_name(es: list[EnumDecl], ss: list[StructDecl], cs: list[Ty]) -> str {
	for ed in es {
		return ed.name
	}
	for sd in ss {
		return sd.name
	}
	for c in cs {
		return c_carrier_ty_cname(c)
	}
	return "?"
}

# c_carrier_decl_types collects every CARRIER a declaration spells — a struct field, a
# parameter, a result. Those carriers have to exist before the struct typedefs that name
# them, and one registered while a body is emitted lands after them: a struct holding a
# `Q?` reached cc as `unknown type name 'zg_opt_zg_Q'`.
#
# It gathers optionals AND eithers, which is what a `-> Result[nil]` in the stdlib needs:
# the type is spelled in one module's prototype and the carrier registered in another, so a
# caller compiled on its own had the name and not the typedef.
fn c_tuple_decl_types(mut &em: Emitter, f: File) -> list[Ty] {
	mut out: list[Ty] = []
	for st in f.structs {
		for fd in st.fields {
			c_tuple_collect(fd.ty, out)
		}
	}
	for fn_i in f.fns {
		c_tuple_collect(fn_i.ret, out)
		for pm in fn_i.params {
			c_tuple_collect(pm.ty, out)
		}
	}
	return out
}

# c_tuple_collect walks a type to the tuples inside it, innermost first, so a tuple holding
# a tuple is registered after the one it holds. A container is transparent, exactly as it is
# for a carrier.
fn c_tuple_collect(t: Ty, mut &out: list[Ty]) {
	match t {
		TTuple(ts)    => c_tuple_collect_tuple(ts, out)
		TList(el)     => c_tuple_collect(el, out)
		TOpt(el)      => c_tuple_collect(el, out)
		TChan(el, _)  => c_tuple_collect(el, out)
		TMap(k, v)    => c_tuple_collect_two(k, v, out)
		TEither(l, r) => c_tuple_collect_two(l, r, out)
		_             => c_skip()
	}
}

fn c_tuple_collect_two(a: Ty, b: Ty, mut &out: list[Ty]) {
	c_tuple_collect(a, out)
	c_tuple_collect(b, out)
}

fn c_tuple_collect_tuple(ts: list[Ty], mut &out: list[Ty]) {
	for t in ts {
		c_tuple_collect(t, out)
	}
	name := c_tuple_cname(ts)
	for t in out {
		return if c_tuple_cname(ty_tuple_elems(t)) == name
	}
	out.append(TTuple(ts))
}

fn c_carrier_decl_types(mut &em: Emitter, f: File) -> list[Ty] {
	mut out: list[Ty] = []
	for st in f.structs {
		for fd in st.fields {
			c_carrier_collect(fd.ty, out)
		}
	}
	for fn_i in f.fns {
		c_carrier_collect(fn_i.ret, out)
		for pm in fn_i.params {
			c_carrier_collect(pm.ty, out)
		}
	}
	return out
}

# c_carrier_collect walks a type to the carriers inside it. A container is transparent:
# `list[T?]` needs the same carrier a bare `T?` does.
fn c_carrier_collect(t: Ty, mut &out: list[Ty]) {
	match t {
		TOpt(el)      => c_carrier_seen(TOpt(el), out)
		TEither(l, r) => c_carrier_seen(TEither(l, r), out)
		TList(el)     => c_carrier_collect(el, out)
		TChan(el, _)  => c_carrier_collect(el, out)
		TMap(k, v)    => c_carrier_collect_two(k, v, out)
		_             => c_skip()
	}
}

fn c_carrier_collect_two(a: Ty, b: Ty, mut &out: list[Ty]) {
	c_carrier_collect(a, out)
	c_carrier_collect(b, out)
}

# c_carrier_seen adds a carrier once per SHAPE, then descends into its payloads — a
# `Result[T?]` needs the optional's carrier written before its own.
fn c_carrier_seen(c: Ty, mut &out: list[Ty]) {
	nm := c_carrier_ty_cname(c)
	mut i := 0
	for i < out.len() {
		return if c_carrier_ty_cname(out[i]) == nm
		i = i + 1
	}
	if c_is_opt(c) {
		c_carrier_collect(c_opt_elem(c), out)
	} else {
		c_carrier_collect_two(c_either_left(c), c_either_right(c), out)
	}
	out.append(c)
}

# c_check_named_types refuses a DECLARATION that names a type nothing declares. Every
# other named type resolves to a C typedef this unit writes; one that resolves to nothing
# was still spelled `zg_<Name>` and handed to cc, which rejected it against a line of
# generated C under .zerg-cache — the same "loudly, but a long way from the source" the
# error-constructor case above already names. `Ref[T]` is the one that matters today: the
# self-hosted compiler has no Ref, so `std/atomic` reached cc as `zg_Ref` rather than being
# turned away here.
#
# It runs over DECLARATIONS only — struct fields, parameters, results — because those are
# written out before any body is, so this is the earliest point where the whole program's
# type names are known and nothing has been emitted yet.
fn c_check_named_types(mut &em: Emitter, f: File) {
	for s in f.structs {
		for fd in s.fields {
			c_check_named_ty(em, fd.ty, f"field `{s.name}.{fd.name}`")
		}
	}

	# A VARIANT'S PAYLOAD is a type position like any other, and it was the one this pass
	# did not walk — so `Leaf(int, 1)` declared a payload of type `1`, and the emitter wrote
	# `zg_1` into a union member for cc to complain about. Found by the mutation fuzzer,
	# which is the first thing that ever put a wrong type there.
	for e in f.enums {
		for v in e.variants {
			mut i := 0
			for i < v.fields.len() {
				c_check_named_ty(em, v.fields[i], f"payload {strconv.to_string(i, 10)} of `{e.name}.{v.name}`")
				i = i + 1
			}
		}
	}
	for fn_i in f.fns {
		# the declaration's own place: this pass runs before any statement is emitted, so
		# the SAt markers have said nothing and `em.at_*` still holds the last unit's
		em.at_path = fn_i.path
		em.at_line = fn_i.line
		em.at_col = fn_i.col

		# an `impl` on a PRIMITIVE arrives as a synthesized `this` of that type, and that is
		# knowable here and nowhere below: `c_check_type_name` sees a name and a site string,
		# so it had to claim "an `impl` on the built-in type" for any site and then print the
		# site it was given — `… `int` (parameter `this` of `tag`)`.
		raise f"NotImplemented: an `impl` on the built-in type `{fn_i.recv}` — this compiler gives a method a declared struct or enum receiver" if fn_i.recv != "" and is_conv(fn_i.recv)

		c_check_named_ty(em, fn_i.ret, f"the result of `{fn_i.name}`")
		for pm in fn_i.params {
			c_check_named_ty(em, pm.ty, f"parameter `{pm.name}` of `{fn_i.name}`")
		}
	}
}

# c_check_named_ty walks a type to its named leaves. A container is transparent here: the
# name that fails to resolve is just as unspellable inside a `list[…]` or a `chan[…]`.
fn c_check_named_ty(mut &em: Emitter, t: Ty, site: str) {
	match t {
		TNamed(nm)    => c_check_type_name(em, nm, site)
		TList(el)     => c_check_named_ty(em, el, site)
		TChan(el, _)  => c_check_named_ty(em, el, site)
		TMap(k, v)    => c_check_named_ty_two(em, k, v, site)
		TEither(l, r) => c_check_named_ty_two(em, l, r, site)
		TOpt(el)      => c_check_named_ty(em, el, site)
		TTuple(ts)    => c_check_named_ty_list(em, ts, site)
		TFn(ps, r)    => c_check_named_fn(em, ps, r, site)
		_             => c_skip()
	}
}

fn c_check_named_ty_two(mut &em: Emitter, a: Ty, b: Ty, site: str) {
	c_check_named_ty(em, a, site)
	c_check_named_ty(em, b, site)
}

fn c_check_named_ty_list(mut &em: Emitter, ts: list[Ty], site: str) {
	for t in ts {
		c_check_named_ty(em, t, site)
	}
}

fn c_check_named_fn(mut &em: Emitter, ps: list[Ty], r: Ty, site: str) {
	c_check_named_ty_list(em, ps, site)
	c_check_named_ty(em, r, site)
}

fn c_check_type_name(mut &em: Emitter, nm: str, site: str) {
	return if c_is_struct_name(em, nm)
	return if c_is_enum_ty(em, TNamed(nm))

	# `This` is the SELF TYPE (GRAMMAR:333), so it names something only where there is a
	# self — inside an `impl`, where c_impl_ty has already substituted it. Reaching here
	# means there was none, and saying "no type named `This`" invites the reader to go and
	# declare one. Checked rather than refused, for the reason c_ident gives.
	if nm == "This" {
		chk_at(em, f"`This` is the self type, and {site} is outside an `impl` — there is no type for it to name")
		return
	}

	# A `spec` IS a type in the language — the third of the three roles docs/core/specs.md
	# gives it, beside the bound and the interface — and this compiler has not built that
	# one. Saying "no type named `Tag`" about a spec the reader declared three lines above
	# invites them to go and declare it again.
	raise f"NotImplemented: the `spec` `{nm}` used as a TYPE ({site}) — a spec is a bound and an interface here, not yet a value's type; take the concrete type, or a generic parameter bounded by it" if c_name_in(em.spec_names, nm)

	raise f"no type named `{nm}` ({site})"
}

fn c_is_struct_name(mut &em: Emitter, nm: str) -> bool {
	mut i := 0
	for i < em.struct_names.len() {
		return true if em.struct_names[i] == nm
		i = i + 1
	}
	return false
}

# c_scan_fnptr decides up front whether the program spells a function type anywhere in a
# DECLARATION — a struct field, a parameter, a result. It has to run before anything is
# emitted, because those declarations are written out before any body is: a struct typedef
# naming `zg_fnptr` would otherwise reach the C compiler ahead of the typedef that defines
# it. (A body that merely holds a function in a local sets the flag as it goes; by then the
# header has not been assembled yet.)
fn c_scan_fnptr(mut &em: Emitter, f: File) {
	for s in f.structs {
		for fd in s.fields {
			if c_is_fn(fd.ty) {
				em.used_fnptr = true
			}
		}
	}
	for fn_i in f.fns {
		if c_is_fn(fn_i.ret) {
			em.used_fnptr = true
		}
		for pm in fn_i.params {
			if c_is_fn(pm.ty) {
				em.used_fnptr = true
			}
		}
	}
}

# c_build_type_names refuses a NAME DECLARED TWICE at the type level.
#
# A `struct`, an `enum` and a `spec` share one namespace — every module of a program
# flattens into one scope here, which is the same argument that already refuses a duplicate
# function and a duplicate module constant. Nothing checked it, and the four shapes failed
# four different ways:
#
#   struct A {v} + struct A {w}   MERGED into one struct of two fields; `A(7)` then wanted
#                                 two arguments, a wrong answer with no diagnostic
#   struct A {v} + struct A {v}   cc: "typedef redefinition", against .zerg-cache
#   enum E + enum E               the same cc error
#   spec T + spec T               silently ignored; the second's members required nothing
#
# It runs before the tables are built, so a later pass never sees the second declaration
# and cannot be confused by it.
fn c_build_type_names(mut &em: Emitter, f: File) {
	mut seen: list[str] = []
	mut kind: list[str] = []
	for sd in f.structs {
		c_check_type_dup(em, seen, kind, sd.name, "a struct", "", 0, 0)
	}
	for ed in f.enums {
		c_check_type_dup(em, seen, kind, ed.name, "an enum", "", 0, 0)
	}
	for sp in f.specs {
		# a SpecDecl knows WHERE it was written, and a rule that has a place uses it: it says
		# where, and it accumulates rather than ending the run at the first finding. A
		# struct, an enum, a field and a variant carry no place, so those still raise —
		# `reject-check.sh` marks each of those cases `no-place`, which is the debt declared.
		c_check_type_dup(em, seen, kind, sp.name, "a spec", sp.path, sp.line, sp.col)

		# the spec table, filled by the walk that is already here rather than by a second
		# pass over the same list
		em.spec_names.append(sp.name)
	}

	# and one level down, where the same question has the same answer and three more ways
	# of going wrong: a repeated FIELD and a repeated PARAMETER both reached cc as a C
	# redefinition against .zerg-cache, and a repeated VARIANT was accepted — the second
	# took the next discriminant, so it was unreachable, and a `match` naming the first was
	# "exhaustive" over an enum that had two.
	for sd in f.structs {
		mut fnames: list[str] = []
		for fd in sd.fields {
			fnames.append(fd.name)
		}
		c_check_names_distinct(fnames, "a field", sd.name)
	}
	for ed in f.enums {
		mut vnames: list[str] = []
		for v in ed.variants {
			vnames.append(v.name)
		}
		c_check_names_distinct(vnames, "a variant", ed.name)
	}
	for fn_i in f.fns {
		# a FnDecl knows where it was written too
		mut pseen: list[str] = []
		for pm in fn_i.params {
			if c_name_in(pseen, pm.name) {
				chk_at_place(em, fn_i.path, fn_i.line, fn_i.col, f"`{fn_i.name}` declares a parameter named `{pm.name}` twice")
			}
			pseen.append(pm.name)
		}
	}
}

fn c_check_names_distinct(names: list[str], what: str, whose: str) {
	mut seen: list[str] = []
	for n in names {
		raise f"`{whose}` declares {what} named `{n}` twice" if c_name_in(seen, n)

		seen.append(n)
	}
}

fn c_check_type_dup(mut &em: Emitter, mut &seen: list[str], mut &kind: list[str], name: str, what: str, path: str, line: int, col: int) {
	mut i := 0
	for i < seen.len() {
		if seen[i] == name {
			msg := c_dup_msg(name, kind[i], what)
			if path != "" {
				chk_at_place(em, path, line, col, msg)
				return
			}
			raise msg
		}
		i = i + 1
	}
	seen.append(name)
	kind.append(what)
}

# c_dup_msg is the one sentence, so a declaration that knows its place and one that does not
# say the same thing about the same rule.
fn c_dup_msg(name: str, prev: str, what: str) -> str {
	return f"`{name}` is declared twice — once as {prev}, once as {what}" if prev != what

	return f"`{name}` is declared twice — a type name is one name, and every module of a program flattens into one namespace here"
}

fn c_build_structs(mut &em: Emitter, f: File) {
	mut i := 0
	for i < f.structs.len() {
		sd := f.structs[i]
		em.struct_names.append(sd.name)
		mut j := 0
		for j < sd.fields.len() {
			fd := sd.fields[j]
			em.fld_struct.append(sd.name)
			em.fld_name.append(fd.name)
			em.fld_ty.append(fd.ty)
			j = j + 1
		}
		i = i + 1
	}
}

fn c_field_ty(mut &em: Emitter, sname: str, fname: str) -> Ty {
	mut i := 0
	for i < em.fld_struct.len() {
		return em.fld_ty[i] if em.fld_struct[i] == sname and em.fld_name[i] == fname
		i = i + 1
	}
	return TUnknown
}

# c_struct_field_ty_at returns the type of a struct's idx-th field (declaration order).
fn c_struct_field_ty_at(mut &em: Emitter, sname: str, idx: int) -> Ty {
	mut n := 0
	mut i := 0
	for i < em.fld_struct.len() {
		if em.fld_struct[i] == sname {
			return em.fld_ty[i] if n == idx
			n = n + 1
		}
		i = i + 1
	}
	return TUnknown
}

# c_field_init emits a constructor argument, initialising an EMPTY list `[]` to a properly
# sized runtime list from the destination field's element type (a bare `[]` carries no
# element type of its own, and would otherwise emit a malformed zero list).
#
# The emptiness test is the whole point of it, and it used to be missing: any list literal
# took this branch, so `Bag([1, 2, 3])` built a struct whose field was an EMPTY list and
# said nothing. That is the same defect c_list_lit's comment describes for a call argument
# — a program that runs and is simply not what was written — and it survived here because
# a struct field's list is usually appended to afterwards, which hides a length that
# started at the wrong number. A non-empty literal has its own element type and its own
# elements, so it takes the ordinary path.
fn c_field_init(mut &em: Emitter, fty: Ty, arg: Expr, sb: Subst) -> str {
	if ty_is_chan(fty) {
		c_chan_check(c_infer(em, arg), fty, "field")
	}

	# a declared `T?` field takes a bare value or `nil` and wraps it, so `P(nil)` builds an
	# ABSENT field rather than a present one holding whatever `nil` lowered to; a bare `[]`
	# takes the field's element type. Both are c_fit_copied's, which every destination-typed
	# site asks — this one is only the chan check plus that.
	return c_fit_copied(em, fty, arg, sb)
}

# --- value semantics -----------------------------------------------------------------------
#
# "Two names of a value type never alias: writing through one is never visible through the
# other" (docs/core/memory.md). A scalar or a plain struct gets that from C's own `=`. A `list`
# does not: it is a handle onto a heap buffer, so a C `=` hands out a second name for the
# SAME elements — and a struct holding one inherits the problem however deep it sits.
#
# So a copy of anything that holds a list goes through a generated per-type helper, and
# every place a value is COPIED calls it: a binding, an assignment, a field of a struct
# being built. The helper is where the rule lives, rather than each of those sites knowing
# how to walk a type.
#
# Why the bug survived so long: appending through a shared buffer is invisible. A zrt_list
# carries its own length, so a push bumps only the writer's, and the reader — whose length
# never moved — sees nothing. Every list the compiler's own source touches is append-only,
# so its own tests could never have caught this. It takes a write to an index the other
# holder can already see, which is what test-data/codegen/value_semantics.zg does.

# c_needs_copy reports whether copying a value of this type has to do more than a C `=`.
fn c_needs_copy(mut &em: Emitter, t: Ty) -> bool {
	return true if c_is_list(t) or c_is_map(t)

	# A TUPLE is the third composite, and it was missing: `mut t := (a, 0)` bit-copied the
	# list `a`, so `t.0[0] = 99` was read back through `a`. Its elements are a list of
	# types, so the same question is asked of each.
	for e in ty_tuple_elems(t) {
		return true if c_needs_copy(em, e)
	}

	nm := c_named_of(t)
	return false if nm == ""

	# A struct cannot contain itself BY VALUE — that would have no finite size — so this
	# recursion always terminates. A self-referential type reaches itself through a list,
	# which answers true above without recursing.
	mut i := 0
	for i < em.fld_struct.len() {
		return true if em.fld_struct[i] == nm and c_needs_copy(em, em.fld_ty[i])
		i = i + 1
	}
	return false
}

# c_copied renders an expression as an INDEPENDENT copy of itself, when its type needs one.
#
# A freshly built value — a call's result, a constructor, a literal — is already nobody
# else's, so copying it would only cost. Only an lvalue can be a second name for something.
fn c_copied(mut &em: Emitter, t: Ty, e: Expr, sb: Subst) -> str {
	rendered := c_expr(em, e, sb)
	return rendered if not c_is_lvalue(e) or not c_needs_copy(em, t)
	return c_copy_of(em, t, rendered)
}

# c_copy_of is HOW a copy is spelled, given something already rendered: a list through the
# runtime, anything else through its generated helper. It is separate from c_copied so
# that the helpers below spell a copy the same way every call site does — the rule for
# what a deep copy IS lives in one function, and a second kind of type that needs one is
# added here alone.
fn c_copy_of(mut &em: Emitter, t: Ty, x: str) -> str {
	# the source is BOUND before its address is taken, because `&(x)` needs x to be a place
	# and not everything copied is one. `m[k]` lowers to a statement expression, so reading
	# a list out of a map — `v := c["k"]` — reached cc as "cannot take the address of an
	# rvalue of type 'zrt_list'", against C nobody wrote. Binding costs one header copy,
	# which is a handful of words, and it makes the addressability question go away rather
	# than answering it at each call site.
	if c_is_list(t) or c_is_map(t) {
		em.used_rt = true

		# `c_type` of either is exactly the runtime type name, and the copy is that plus
		# `_copy` — so the two containers are one template rather than two spellings of it
		ct := c_type(t)
		return "({ " + ct + " zgt_cs = (" + x + "); " + ct + " zgt_cp; " + ct + "_copy(&zgt_cp, &zgt_cs); zgt_cp; })"
	}
	return f"{c_tuple_cname(ty_tuple_elems(t))}_copy({x})" if c_is_tuple(t)
	return f"zg_copy_{c_named_of(t)}({x})"
}

# c_copy_helpers emits one `zg_copy_<T>` per struct that holds a list, after the typedefs
# and before anything that calls them, and the ELEMENT VTABLE that lets a list of that
# struct use it.
fn c_copy_helpers(mut &em: Emitter, f: File) -> str {
	mut out := ""
	for sd in f.structs {
		if c_needs_copy(em, TNamed(sd.name)) {
			out = out + c_copy_helper(em, sd) + c_elem_vt_helper(em, sd.name)
		}
	}
	return out
}

# c_elem_vt is the element vtable a `list[T]` is built with — how the runtime duplicates
# one element when it copies a buffer.
#
# Every list was built with `zg_listvt`, which is {NULL, NULL} — the memcpy fast path,
# correct for a scalar and wrong for anything holding a heap buffer. A `list[Row]` where
# `Row` holds a `list[int]` copied its Rows bit for bit, so both lists' Rows named ONE
# inner buffer and `h[0].ys[0] = 8` was read back through `g`. The mechanism to say
# otherwise has been in the runtime header since the container was written; nothing ever
# supplied it.
#
# A nested LIST needs no per-type vtable: `zrt_list_copy` copies a header, and the header
# carries its own elemsz and its own vt, so one thunk serves every element type.
fn c_elem_vt(mut &em: Emitter, t: Ty) -> str {
	k := c_elem_kind(em, t)

	return "zg_listvt" if k == ""
	return k + "_listvt" if c_is_tuple(t)

	return "zg_listvt_" + k
}

# c_elem_copy_fn is the thunk itself, for a table that takes one rather than a whole
# vtable. A map's `key_copy` / `val_copy` have exactly the signature a list element's
# `copy` has, so the same thunks serve both — a `map[str, list[int]]` duplicates its
# values through the function a `list[list[int]]` duplicates its elements through.
fn c_elem_copy_fn(mut &em: Emitter, t: Ty) -> str {
	k := c_elem_kind(em, t)

	return "NULL" if k == ""
	return k + "_elemcopy" if c_is_tuple(t)

	return "zg_elemcopy_" + k
}

# c_elem_kind is the one dispatch behind both: which FAMILY of thunk a type needs, or ""
# for a POD that takes the memcpy path. The two above spell it — `zg_listvt_` and
# `zg_elemcopy_` — and had the four-way decision written out twice, so a kind added to one
# gave maps a memcpy copy of a type lists copied properly, which is the bug this whole
# mechanism exists to prevent.
fn c_elem_kind(mut &em: Emitter, t: Ty) -> str {
	return "list" if c_is_list(t)
	return "map" if c_is_map(t)
	return "" if not c_needs_copy(em, t)
	return c_tuple_cname(ty_tuple_elems(t)) if c_is_tuple(t)

	return c_named_of(t)
}

# The vtable carries a COPY and no drop: this emitter is leak-style, so nothing generates
# a teardown for a struct, and a drop thunk here would be the only one — freeing halves of
# values whose other halves nobody frees.
fn c_elem_vt_helper(mut &em: Emitter, nm: str) -> str {
	ct := "zg_" + nm
	cp := c_copy_of(em, TNamed(nm), f"*(const {ct}*)src")
	mut out := "static void zg_elemcopy_" + nm + "(void *dst, const void *src) {\n"
	out = out + "    *(" + ct + "*)dst = " + cp + ";\n}\n"
	return out + "static const zrt_elem_vt zg_listvt_" + nm + " = {zg_elemcopy_" + nm + ", NULL};\n\n"
}

fn c_copy_helper(mut &em: Emitter, sd: StructDecl) -> str {
	nm := "zg_" + sd.name
	mut out := "static " + nm + " zg_copy_" + sd.name + "(" + nm + " v) {\n"
	out = out + "    " + nm + " r = v;\n"
	for fd in sd.fields {
		if c_needs_copy(em, fd.ty) {
			out = out + "    r.zg_" + fd.name + " = " + c_copy_of(em, fd.ty, "v.zg_" + fd.name) + ";\n"
		}
	}
	return out + "    return r;\n}\n\n"
}

# c_struct_typedef emits a value struct as a C typedef with zg_-mangled fields.
fn c_struct_typedef(sd: StructDecl) -> str {
	mut out := "typedef struct {\n"
	mut i := 0
	for i < sd.fields.len() {
		fd := sd.fields[i]
		out = out + "    " + c_type(fd.ty) + " zg_" + fd.name + ";\n"
		i = i + 1
	}
	return out + "} zg_" + sd.name + ";\n\n"
}

# c_named_of returns the struct name of a TNamed type, or "" otherwise.
fn c_named_of(t: Ty) -> str {
	return match t {
		TNamed(nm) => nm
		_          => ""
	}
}

fn c_build_enums(mut &em: Emitter, f: File) {
	mut i := 0
	for i < f.enums.len() {
		ed := f.enums[i]
		em.enum_names.append(ed.name)
		mut j := 0
		for j < ed.variants.len() {
			v := ed.variants[j]
			em.var_name.append(v.name)
			em.var_enum.append(ed.name)
			em.var_tag.append(v.tag)
			mut k := 0
			for k < v.fields.len() {
				em.vf_variant.append(v.name)
				em.vf_index.append(k)

				# a field whose type is the enclosing enum is boxed (leak-style void*)
				em.vf_boxed.append(c_named_of(v.fields[k]) == ed.name)
				em.vf_ty.append(v.fields[k])
				k = k + 1
			}
			j = j + 1
		}
		i = i + 1
	}
}

# c_is_flat_enum reports whether a name is a declared enum whose every variant is tag-only.
# That is the enum GRAMMAR:573 gives an observable integer value to — `int(v)` reads it and
# `E.of(n)` reverses it; a payload enum's tag is opaque and match-only.
#
# It is read off the tables already there rather than recorded beside the name: vf_variant
# holds exactly the variants that HAVE a payload field, so an enum is flat when none of its
# variants is in it.
fn c_is_flat_enum(mut &em: Emitter, en: str) -> bool {
	return false if not c_name_in(em.enum_names, en)

	mut i := 0
	for i < em.vf_variant.len() {
		return false if c_variant_enum(em, em.vf_variant[i]) == en
		i = i + 1
	}
	return true
}

# c_is_boxed reports whether payload field `idx` of variant `variant` is a ref-boxed
# (self-recursive) field.
fn c_is_boxed(mut &em: Emitter, variant: str, idx: int) -> bool {
	mut i := 0
	for i < em.vf_variant.len() {
		return em.vf_boxed[i] if em.vf_variant[i] == variant and em.vf_index[i] == idx
		i = i + 1
	}
	return false
}

fn c_variant_field_ty(mut &em: Emitter, variant: str, idx: int) -> Ty {
	mut i := 0
	for i < em.vf_variant.len() {
		return em.vf_ty[i] if em.vf_variant[i] == variant and em.vf_index[i] == idx
		i = i + 1
	}
	return TUnknown
}

# c_bind_env registers an enum constructor arm's payload names in the variable
# environment with their field types, so type inference inside the arm resolves them.
fn c_bind_env(mut &em: Emitter, a: Arm, st: Ty) {
	if a.pat == 3 and c_is_either(st) {
		# an Either's sides are not in the variant table: they are the TYPE's own two, so the
		# binding takes whichever the pattern names. Answering `Err` for every Right is what a
		# Result-shaped assumption looks like — a `Right(b)` over an `Either[A, B]` then had
		# type Err, and `b.s` reached cc as an unmangled member of the wrong struct.
		if a.binds.len() > 0 {
			if c_result_tag(a.ctor) == 0 {
				c_add_var(em, a.binds[0], c_either_left(st), false)
			} else {
				c_add_var(em, a.binds[0], c_either_right(st), false)
			}
		}
	} else if a.pat == 3 {
		mut i := 0
		for i < a.binds.len() {
			c_add_var(em, a.binds[i], c_variant_field_ty(em, a.ctor, i), false)
			i = i + 1
		}
	}
}

# c_needs_runtime reports whether any enum has a boxed field, so the translation unit
# must include and link the runtime.
fn c_needs_runtime(mut &em: Emitter) -> bool {
	mut i := 0
	for i < em.vf_boxed.len() {
		return true if em.vf_boxed[i]
		i = i + 1
	}
	return false
}

# c_qualified_variant answers the enum name when `target.fld` is `Enum.Variant`, and "" for
# every other field access. The variant has to belong to THAT enum: `Color.Apple` names a
# variant of another one, and answering it would make the qualification decorative.
fn c_qualified_variant(mut &em: Emitter, target: Expr, fld: str) -> str {
	en := c_ident_name(target)

	return "" if en == "" or not c_name_in(em.enum_names, en)
	return "" if not c_is_variant(em, fld) or c_variant_enum(em, fld) != en

	return en
}

# c_last_segment is a module path's namespace: `util/text` is reached as `text`.
fn c_last_segment(path: str) -> str {
	b := list[byte](path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

fn c_is_variant(mut &em: Emitter, name: str) -> bool {
	mut i := 0
	for i < em.var_name.len() {
		return true if em.var_name[i] == name
		i = i + 1
	}
	return false
}

fn c_variant_enum(mut &em: Emitter, name: str) -> str {
	mut i := 0
	for i < em.var_name.len() {
		return em.var_enum[i] if em.var_name[i] == name
		i = i + 1
	}
	return ""
}

fn c_variant_tag(mut &em: Emitter, name: str) -> int {
	mut i := 0
	for i < em.var_name.len() {
		return em.var_tag[i] if em.var_name[i] == name
		i = i + 1
	}
	return 0
}

# c_enum_typedef emits an enum as a C tagged union: an int32 tag plus a union of the
# payload-carrying variants (omitted when every variant is tag-only).
fn c_enum_typedef(ed: EnumDecl) -> str {
	mut out := "typedef struct {\n    int32_t tag;\n"
	mut anyf := false
	mut i := 0
	for i < ed.variants.len() {
		if ed.variants[i].fields.len() > 0 {
			anyf = true
		}
		i = i + 1
	}
	if anyf {
		out = out + "    union {\n"
		i = 0
		for i < ed.variants.len() {
			v := ed.variants[i]
			if v.fields.len() > 0 {
				out = out + "        struct { "
				mut j := 0
				for j < v.fields.len() {
					# a self-recursive field is a ref-box (void*), else its value type
					mut ct := c_type(v.fields[j])
					if c_named_of(v.fields[j]) == ed.name {
						ct = "void*"
					}
					out = out + ct + " f" + strconv.to_string(j, 10) + "; "
					j = j + 1
				}
				out = out + "} " + v.name + ";\n"
			}
			i = i + 1
		}
		out = out + "    } u;\n"
	}
	return out + "} zg_" + ed.name + ";\n\n"
}

# c_refbox_helpers emits, for an enum with self-recursive fields, a no-op drop and a
# refnew that boxes a value into a leaked ref cell (never released — batch tool).
fn c_refbox_helpers(ed: EnumDecl) -> str {
	mut anybox := false
	mut i := 0
	for i < ed.variants.len() {
		v := ed.variants[i]
		mut j := 0
		for j < v.fields.len() {
			if c_named_of(v.fields[j]) == ed.name {
				anybox = true
			}
			j = j + 1
		}
		i = i + 1
	}
	return "" if not anybox
	nm := ed.name
	mut out := "static void zg_noopdrop_" + nm + "(void* p) { (void)p; }\n"
	out = out + "static void* zg_refnew_" + nm + "(zg_" + nm + " v) {\n"
	out = out + "    void* r = zrt_ref_alloc(sizeof(zg_" + nm + "), &zg_noopdrop_" + nm + ");\n"
	out = out + "    *(zg_" + nm + "*)zrt_ref_payload(r) = v;\n"
	out = out + "    return r;\n}\n\n"
	return out
}

# --- operators -----------------------------------------------------------------

# c_binop maps a Zerg binary operator spelling to its C form; the wrapping operators
# lower to the plain C operator (arithmetic does not yet trap).
fn c_binop(oper: str) -> str {
	return "&&" if oper == "and"
	return "||" if oper == "or"
	return "*" if oper == "*%"
	return "+" if oper == "+%"
	return "-" if oper == "-%"

	return oper
}

fn c_unop(oper: str) -> str {
	return "!" if oper == "not"
	return "-" if oper == "-%"

	return oper
}

# --- integer literal normalisation ---------------------------------------------

# c_int_dec renders an integer lexeme (decimal / 0x / 0o / 0b, with '_' groups) as a
# plain decimal string, matching how the bootstrap lowers integer literals. What a lexeme is
# WORTH is a lexical fact and lives with the lexer, so the formatter can ask the same question
# without a second implementation of it (F408 needs it to tell `1 | 2` from `1 | 3`).
# c_str_lit renders a Zerg str as a C string literal, escaping every byte outside
# printable ASCII as a THREE-DIGIT OCTAL escape.
#
# Not `\xHH`, which is what `quote` (lexer.zg) emits for the token dump: C's hex escape
# consumes as many hex digits as follow it, with no two-digit limit, so `"aéb"` came out as
# `"a\xc3\xa9b"` and cc read `\xa9b` as one escape — "hex escape sequence out of range",
# a build that fails on a string a reader would call ordinary. An octal escape is at most
# three digits, so `\303\251b` cannot run on. The seed has emitted octal all along.
# c_str_cell renders a str LITERAL as the managed-str value every other str now is: the
# payload of a cell, not a bare `char*`.
#
# It has to be, because a release cannot ask what it is holding. A managed str is a pointer
# INTO `[zrt_ref_hdr | bytes]` and giving one back means stepping back one header — which on
# a plain C literal reads whatever the linker put in front of the string. Nothing at runtime
# tells the two apart, so either every str is a cell or none can ever be freed. That is the
# row src/compiler/README.md calls a representation change rather than more emitted code.
#
# The cell is `static` and IMMORTAL: file lifetime, so the statement expression's value
# outlives it nowhere, and a refcount zrt_retain/zrt_release both no-op on, so a literal
# flows through retain, release and comparison exactly as a heap string does. The seed has
# emitted this shape since S2 (emit_str.go, strLiteral); this is the same cell.
fn c_str_cell(mut &em: Emitter, s: str) -> str {
	em.used_rt = true
	em.tmp_n = em.tmp_n + 1
	nm := f"zgt_sl{em.tmp_n}"

	# C counts DECODED bytes, so the array is sized from the value and not from the escaped
	# spelling c_str_lit produces
	n := list[byte](s).len() + 1
	return f"({{ static struct {{ zrt_ref_hdr h; char b[{n}]; }} {nm} = {{{{ZRT_RC_IMMORTAL, NULL}}, {c_str_lit(s)}}}; (const char *)zrt_ref_payload(&{nm}); }})"
}

fn c_str_lit(s: str) -> str {
	mut out: list[byte] = []
	out.append(byte(34)) # "
	for c in list[byte](s) {
		v := int(c)
		if v == 34 {
			out.append(byte(92))
			out.append(byte(34))
		} else if v == 92 {
			out.append(byte(92))
			out.append(byte(92))
		} else if v == 10 {
			out.append(byte(92))
			out.append(b'n')
		} else if v == 9 {
			out.append(byte(92))
			out.append(b't')
		} else if v == 13 {
			out.append(byte(92))
			out.append(b'r')
		} else if v >= 32 and v <= 126 {
			out.append(c)
		} else {
			out.append(byte(92))
			out.append(byte(48 + v / 64))
			out.append(byte(48 + v / 8 % 8))
			out.append(byte(48 + v % 8))
		}
	}
	out.append(byte(34)) # "
	return str(out)
}

fn c_int_dec(mut &em: Emitter, lex: str) -> str {
	chk_int_literal(em, lex)

	return strconv.to_string(int_value(lex), 10)
}

fn c_bool(b: bool) -> str {
	return "true" if b
	return "false"
}

# --- expression emission -------------------------------------------------------

# c_expr renders an expression as C. `bind` / `sub` implement a single-name substitution:
# an EIdent equal to `bind` emits `sub` verbatim instead of a mangled name — this is how a
# match arm's bound scrutinee name is spliced into its guard and body.
fn c_expr(mut &em: Emitter, e: Expr, sb: Subst) -> str {
	return match e {
		EInt(lex) => c_int_dec(em, lex)
		EFloat(lex) => lex
		EStr(v) => c_str_cell(em, v)
		EBool(b) => c_bool(b)
		ENil => "0"
		EIdent(n) => c_ident_val(em, n, sb)
		EUnary(oper, x) => c_unexpr(em, oper, x, sb)
		EBinary(oper, a, b) => c_binexpr(em, oper, a, b, sb)
		ECall(name, args) => c_call(em, name, args, sb)
		EField(target, fld) => c_fieldref(em, target, fld, sb)
		EOptChain(target, fld) => c_optchain(em, target, fld, sb)
		ETry(x) => c_try(em, x, sb)
		EIndex(target, idx) => c_index(em, target, idx, sb)
		EMethod(target, meth, args) => c_method(em, target, meth, args, sb)
		EListLit(elems) => c_list_lit(em, elems, sb)
		EConv(ty, x, nm) => c_conv(em, ty, x, nm, sb)
		EIf(cond, then_e, else_e) => c_ternary(em, cond, then_e, else_e, sb)
		EMatch(scrut, arms) => c_match(em, scrut, arms, sb)

		# A range reaching HERE is one used as a value — a slice bound or a match arm —
		# rather than as a `for`'s iterable, which c_forin takes before this point. Those
		# forms have no lowering yet, and saying so is better than emitting something that
		# reads as an int.
		ERange(lo, hi, inclusive) => c_range_unsupported()
		ETuple(elems) => c_tuple_lit(em, elems, sb)
		EMapLit(ks, vs) => c_map_lit(em, ks, vs, sb)
		EFn(ps, has_ret, ret, body) => c_lambda(em, ps, has_ret, ret, body)
		EChanNew(t, cap) => c_chan_new(em, t, cap, sb)
		ERecv(ch) => c_recv(em, ch, sb)
		EForce(x) => c_force(em, x, sb)
		ECoalesce(a, b, jump) => c_coalesce(em, a, b, jump, sb)
		EGuard(body) => c_guard(em, body, sb)
		EIs(x, name) => c_is_test(em, x, name, sb)
	}
}

# --- reading a Result back --------------------------------------------------------

# c_force lowers `e!`: the Left, or the Right re-raised as an abort right here. The work
# is in the per-carrier helper, so this is only the call — which is what keeps `!` from
# knowing how a carrier is spelled.
fn c_force(mut &em: Emitter, x: Expr, sb: Subst) -> str {
	t := c_infer(em, x)
	raise f"NotImplemented: `!` on a {ty_name(t)} — it forces a Result[T] or a T?" if not c_is_carrier(t)
	name := c_carrier_of(em, t)
	return f"zg_force_{name}({c_expr(em, x, sb)})"
}

# c_coalesce lowers `a ?? b`: the Left of `a`, or the fallback. The operand is bound to a
# temp first because it is read twice — the tag and then the value — and `a` is most
# often a receive, which is the most side-effecting expression the language has.
#
# The DIVERGENT form (`?? break`, `?? return …`) needs a statement where the value would
# go, so it takes the if/else shape instead of the conditional one. Its statements go
# through the ordinary c_stmt, which is what gives `break` the loop's defers for free.
# Nothing falls out of the else branch — the parser only routes statements that LEAVE
# here — so the result temp is read only where it was written.
fn c_coalesce(mut &em: Emitter, a: Expr, b: Expr, jump: list[Stmt], sb: Subst) -> str {
	t := c_infer(em, a)
	raise f"NotImplemented: `??` on a {ty_name(t)} — its left side is a Result[T] or a T?" if not c_is_carrier(t)

	elem := c_carrier_elem(t)
	cn := c_carrier_of(em, t)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_co" + tag
	head := f"({{ {cn} {tmp} = {c_expr(em, a, sb)};"
	return head + " " + c_res_is_left(tmp) + " ? " + c_res_taken(em, tmp, elem) + " : (" + c_fit_copied(em, elem, b, sb) + "); })" if jump.len() == 0

	val := "zgt_cov" + tag
	mut out := f"{head} {c_type(elem)} {val};"
	out = out + " if (" + c_res_is_left(tmp) + ") { " + val + " = " + c_res_taken(em, tmp, elem) + "; } else { "
	for s in jump {
		out = out + c_stmt(em, s, "")
	}
	return out + f"}} {val}; }})"
}

# --- guard: the way back from the abort tier --------------------------------------
#
# `guard { … }` runs its block under a CATCHING abort handler and answers a `Result[T]`:
# the block's value as the Left, or — when something inside aborted — the Err it carried
# as the Right. It is the only construct that stops an abort, which is why the whole of
# the runtime's handler protocol shows up here and nowhere else:
#
#   zrt_handler_push_catch  links a frame and marks it `catches`, so an abort landing on
#                           it prints NO diagnostic — the program is handling the error
#                           and the message rides in the Err instead;
#   setjmp(frame.buf)       arms the landing pad. It has to be evaluated in the ENCLOSING
#                           function's own activation — a longjmp into a frame that has
#                           returned is undefined — which is why this is a C statement
#                           expression rather than a call to a helper;
#   zrt_abort               unwinds every pending defer/drop down to frame.mark and
#                           longjmps here, leaving the frame LINKED: the landing pad owns
#                           the pop, on both paths, which is what keeps the handler chain
#                           balanced when a guard is caught and when it is not;
#   zrt_taken_err           hands back the Err the abort carried.
#
# The chain lives in the per-coroutine zrt_tls the scheduler swaps at every context
# switch, so a `guard` catches aborts on the CURRENT stack only — a coroutine spawned
# inside the block has a handler chain of its own and its crash is untouched, exactly as
# docs/code/errors.md says.
#
# One C hazard is inherited rather than solved, and is the reason a guarded block is
# usually written as one call: an automatic variable of the enclosing function that is
# MODIFIED inside the block and read after a caught abort has an indeterminate value
# unless it is `volatile` (C99 7.13.2.1). A variable only read, or written before the
# guard, is unaffected — longjmp restores the register state setjmp saw.
fn c_guard(mut &em: Emitter, body: list[Stmt], sb: Subst) -> str {
	em.used_rt = true
	c_guard_no_jump(body, false)

	vt := c_guard_val_ty(em, body)
	cn := c_carrier_name(em, c_guard_elem(vt), TErr)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	fr := "zgt_gf" + tag
	res := "zgt_gr" + tag

	n := body.len()
	mut upto := n
	if n > 0 and c_is_expr_stmt(body[n - 1]) {
		upto = n - 1
	}

	# A GUARDED BLOCK IS A BLOCK, and this is the one that walks its statements itself
	# rather than through c_block — so it has to do by hand the half c_block does for every
	# other one: remember how tall the pending-release list was, and give back what the body
	# added before the braces close.
	#
	# Without it the entries outlive the C block their names are declared in, and the next
	# `return` renders them where nothing of that name exists: cc, `use of undeclared
	# identifier`, against generated C. It stayed invisible while channels were the only
	# thing on that list — no corpus case opens one inside a `guard` — and surfaced the day
	# a second type joined.
	keep := em.rel_cnames.len()
	mut inner := ""
	mut i := 0
	for i < upto {
		inner = inner + c_stmt(em, body[i], "")
		i = i + 1
	}
	inner = inner + c_guard_ok(em, body, upto, vt, res, sb)

	# after the value has been taken, and inside the braces: the answer is copied out by
	# c_guard_ok, so releasing here cannot take storage the result is still naming
	inner = inner + c_scope_end(em, keep, " ")

	mut out := "({ zrt_frame " + fr + "; " + cn + " " + res + " = {0}; zrt_handler_push_catch(&" + fr + ");"
	out = out + " if (setjmp(" + fr + ".buf) == 0) { " + inner
	out = out + " zrt_unwind_to(" + fr + ".mark); zrt_handler_pop(&" + fr + "); }"
	out = out + " else { zrt_handler_pop(&" + fr + "); " + c_res_mark_right(res) + " " + c_res_err(res) + " = zrt_taken_err(); }"
	return out + " " + res + "; })"
}

# c_guard_ok writes the Left: the block ran to its end, so its value is the answer.
fn c_guard_ok(mut &em: Emitter, body: list[Stmt], upto: int, vt: Ty, res: str, sb: Subst) -> str {
	# a block whose last statement is not an expression has no value at all (GRAMMAR: it
	# is `nil`), so the tag alone is what there is to say
	return c_res_mark_left(res) if upto == body.len()

	val := c_expr(em, c_expr_stmt_of(body[upto]), sb)

	# FLATTENING: a block that already yields a Result IS the answer. An abort inside and a
	# Right handed back are the same ending, so they must not nest (docs/code/errors.md).
	return f"{res} = {val};" if c_is_result(vt)

	# a value-less last expression still has to RUN — it was written for its effect
	return f"{val}; {c_res_mark_left(res)}" if c_is_nil_ty(vt)

	# COPIED, not aliased: the answer outlives the block, and the block now gives back what
	# its bindings own on the way out. `guard { xs := […]; xs }` handed the result a second
	# name for a buffer the release below was about to free.
	return f"{c_res_mark_left(res)} {c_res_ok(res)} = {c_copied(em, vt, c_expr_stmt_of(body[upto]), sb)};"
}

# c_guard_val_ty is the guarded BLOCK's value type. GRAMMAR gives a block the value of its
# last statement, and only an expression statement has one — every other statement, and an
# empty block, yields `nil`.
#
# It is deliberately computed from the source BEFORE the block is emitted, because
# c_infer(EGuard) has to answer the same thing for a caller that types the guard without
# lowering it (`guard { … } ?? 0` types its left side first). That is also the one thing it
# cannot do: a name bound INSIDE the block is not in scope yet, so it is refused by name
# rather than typed as whatever `int64_t` would make of it.
fn c_guard_val_ty(mut &em: Emitter, body: list[Stmt]) -> Ty {
	n := body.len()

	return TNil if n == 0
	return TNil if not c_is_expr_stmt(body[n - 1])

	t := c_infer(em, c_expr_stmt_of(body[n - 1]))

	raise "NotImplemented: a `guard` whose block ends in a name bound inside it — give the block a call or a literal as its value" if c_is_unknown(t)
	return TNil if c_is_nil_ty(t)

	return t
}

# c_guard_elem is the guard's Result PAYLOAD: the block's value type, or — when that is
# already a Result — the type it carries, which is the flattening rule.
fn c_guard_elem(vt: Ty) -> Ty {
	return c_result_elem(vt) if c_is_result(vt)
	return vt
}

fn c_is_expr_stmt(s: Stmt) -> bool {
	return match s {
		SExpr(_) => true
		_        => false
	}
}

fn c_expr_stmt_of(s: Stmt) -> Expr {
	return match s {
		SExpr(x) => x
		_        => ENil
	}
}

# c_guard_no_jump refuses a jump that would LEAVE the guarded block: a `return`, or a
# `break`/`continue` belonging to a loop outside the guard. Either one jumps out of the C
# statement expression with the catching frame still linked, and the next abort anywhere
# in the program lands on an activation that has already returned. There is no lowering
# for that short of a second unwind path, so it is named instead of miscompiled.
#
# `in_loop` is set for the body of a loop written INSIDE the guard, whose break belongs to
# it and never crosses the frame.
fn c_guard_no_jump(body: list[Stmt], in_loop: bool) {
	for s in body {
		match s {
			SReturn(has_val, e) => c_guard_jump_err("return")
			SReturnIf(v, cond) => c_guard_jump_err("return")
			SBreak => c_guard_loop_jump("break", in_loop)
			SContinue => c_guard_loop_jump("continue", in_loop)
			SIf(cond, then_b, has_else, else_b) => c_guard_no_jump_two(then_b, else_b, in_loop)
			SIfLet(nm, v, then_b, has_else, else_b) => c_guard_no_jump_two(then_b, else_b, in_loop)
			SFor(is_cond, cond, body_b) => c_guard_no_jump(body_b, true)
			SForIn(nm, it, body_b) => c_guard_no_jump(body_b, true)
			SSelect(arms) => c_guard_no_jump_sel(arms, in_loop)
			_ => c_skip()
		}
	}
}

fn c_guard_no_jump_two(a: list[Stmt], b: list[Stmt], in_loop: bool) {
	c_guard_no_jump(a, in_loop)
	c_guard_no_jump(b, in_loop)
}

fn c_guard_no_jump_sel(arms: list[SelArm], in_loop: bool) {
	for a in arms {
		c_guard_no_jump(a.body, in_loop)
	}
}

fn c_guard_loop_jump(kw: str, in_loop: bool) {
	return if in_loop
	c_guard_jump_err(kw)
}

fn c_guard_jump_err(kw: str) {
	raise f"NotImplemented: `{kw}` leaving a `guard` block — the guard's handler would stay installed on a frame that has returned"
}

# c_binexpr lowers a binary expression, special-casing string concatenation and equality
# (which are not C operators on const char*).
fn c_binexpr(mut &em: Emitter, oper: str, a: Expr, b: Expr, sb: Subst) -> str {
	ta := c_infer(em, a)
	chk_binary(em, oper, ta, c_infer(em, b))
	if c_is_str(ta) {
		if oper == "+" {
			em.used_str = true
			em.used_rt = true
			return f"zrt_str_concat({c_expr(em, a, sb)}, {c_expr(em, b, sb)})"
		}

		return f"(strcmp({c_expr(em, a, sb)}, {c_expr(em, b, sb)}) == 0)" if oper == "=="
		return f"(strcmp({c_expr(em, a, sb)}, {c_expr(em, b, sb)}) != 0)" if oper == "!="
	}

	# enum equality compares the tag (the subset only == tag-only enums like Kind)
	# `==` and `<` ask the same question of an aggregate: C has no answer for either, and
	# the impl that would (`Eq`, `Ord`) is what `#[derive]` stands for and this compiler does
	# not generate. Guarding only equality left `<` to reach cc.
	eq := c_is_cmp_op(oper)
	return f"(({c_expr(em, a, sb)}).tag {oper} ({c_expr(em, b, sb)}).tag)" if c_is_enum_ty(em, ta) and (oper == "==" or oper == "!=")

	# EVERY OTHER AGGREGATE. C has no `==` for a struct, a list, a map or a tuple, so the
	# operator used to reach cc as `invalid operands to binary expression` against generated
	# code — including on a `#[derive(Eq)]` struct, whose decorator this compiler reads and
	# drops because it generates no impls. What is missing is named where it is missed.
	raise f"NotImplemented: `{oper}` on a {ty_name(ta)} — it needs the impl `#[derive(Eq)]` / `#[derive(Ord)]` stands for, which this compiler does not generate" if eq and c_is_aggregate(em, ta)

	ca := c_expr(em, a, sb)
	cb := c_expr(em, b, sb)
	return c_floordiv(em, ta, c_infer(em, b), ca, cb) if oper == "//"

	# The RESULT's type decides whether this operation can overflow, not the left operand's.
	# `0 - 7.5` is a float subtraction whose left side is an untyped integer literal
	# adopting the context (docs/core/types.md); handing `c_arith` the left type sent it
	# through the checked INTEGER path, which truncated the 7.5 to 7 on the way into
	# zrt_sub_i64 and printed a denormal. Silent, and in every mixed expression.
	return c_arith(em, oper, c_infer_binary(em, oper, a, b), ca, cb)
}

# c_floordiv lowers `a // b`. Its result is always an `int`, so the operand types decide
# only HOW: two integers are the integer division the language already has — already
# Euclidean, already checked — and a float pair goes through the helper that divides as a
# double and lands in int64 through the same range check `int(x)` is.
fn c_floordiv(mut &em: Emitter, ta: Ty, tb: Ty, a: str, b: str) -> str {
	em.used_rt = true
	return f"(zrt_floordiv_f((double)({a}), (double)({b})))" if c_is_float(ta) or c_is_float(tb)

	return f"(zrt_div_i64((int64_t)({a}), (int64_t)({b})))"
}

# c_arith lowers a binary operator that has a CHECK, and every other one as the bare C
# operator it always was.
#
# docs/core/types.md: `+`, `-`, `*` raise OverflowError; `/` and `%` raise DivideByZeroError
# on a zero divisor; a shift by a distance outside the type's width raises. The
# `%`-suffixed `+%`, `-%`, `*%` are the wrapping forms and keep the bare operator — that
# pairing is the reason there are two of each, and it meant nothing while both emitted the
# same C.
#
# It is not only a different answer from the specified one. A signed overflow, a division by
# zero and a shift past the width are all UNDEFINED BEHAVIOUR in C, so the old lowering had
# no answer at all to stand behind.
fn c_arith(mut &em: Emitter, oper: str, t: Ty, a: str, b: str) -> str {
	return f"({a} {c_binop(oper)} {b})" if not (c_is_int(t) or c_is_byte(t))

	fn_name := c_arith_fn(oper)
	return f"({a} {c_binop(oper)} {b})" if fn_name == ""

	# `used_rt` is only ever RAISED. It says the program needs the runtime, and clearing it
	# on the way past a non-arithmetic operator withdrew a claim somebody else had made —
	# the list element vtables went undeclared and cc reported them.
	em.used_rt = true

	# a SHIFT carries the OPERAND's width, because that is what bounds the distance: a byte
	# shifts within 8 even though the value travels as an i64.
	return c_arith_narrow(em, t, f"{fn_name}({a}, {b}, {c_scalar_bits(t)})") if oper == "<<" or oper == ">>"
	return c_arith_narrow(em, t, f"{fn_name}({a}, {b})")
}

# c_arith_fn names the runtime checker for an operator, or "" for one that has none. The
# wrapping `+%` / `-%` / `*%` are deliberately absent: they ARE the bare operator.
fn c_arith_fn(oper: str) -> str {
	return "zrt_add_i64" if oper == "+"
	return "zrt_sub_i64" if oper == "-"
	return "zrt_mul_i64" if oper == "*"
	return "zrt_div_i64" if oper == "/"
	return "zrt_mod_i64" if oper == "%"
	return "zrt_shl_i64" if oper == "<<"
	return "zrt_shr_i64" if oper == ">>"

	return ""
}

# c_arith_narrow keeps a narrow result narrow. The helpers work in i64 — a byte's operands
# promote to one in C anyway — so the result comes back through the SAME checked conversion
# `byte(x)` is, and `byte(255) + byte(255)` is the 510 that raises rather than the 254 it
# silently wrapped to. Going through c_conv_scalar rather than spelling the call out is what
# keeps the target's bound stated in one place.
fn c_arith_narrow(mut &em: Emitter, t: Ty, call: str) -> str {
	return f"({call})" if not c_is_byte(t)

	return c_conv_scalar(em, c_scalar_class(t), c_scalar_bits(t), TInt, t, call)
}

# c_is_int_lit reports whether an expression is an integer literal written out in the
# source, which is what makes `-1` a constant rather than a negation.
fn c_is_int_lit(x: Expr) -> bool {
	return match x {
		EInt(_) => true
		_       => false
	}
}

# c_unexpr lowers a prefix operator. Like c_ternary it is a function only so its operand
# can be checked before it is rendered, a match arm having nowhere to put a statement.
fn c_unexpr(mut &em: Emitter, oper: str, x: Expr, sb: Subst) -> str {
	chk_unary(em, oper, x)
	inner := c_expr(em, x, sb)

	# unary `-` has exactly one overflow — the type's minimum, which has no positive
	# counterpart — and negating it is undefined in C. `-%` is the wrapping form and stays
	# the bare operator, the same pairing the binary three have.
	#
	# `-1` is the SPELLING of a negative constant, not an operation on 1 — the literal is
	# already range-checked, and routing it through the runtime would pull the checked
	# helper into every program that writes a negative number.
	#
	# The type is asked for only here: c_infer walks the operand's whole subtree and opens a
	# scope on the way, and every `not` in the program would otherwise pay for it.
	if oper == "-" and not c_is_int_lit(x) {
		t := c_infer(em, x)
		if c_is_int(t) or c_is_byte(t) {
			em.used_rt = true

			return c_arith_narrow(em, t, f"zrt_neg_i64({inner})")
		}
	}
	return f"({c_unop(oper)}{inner})"
}

# c_is_test lowers `x is Name`. An Err is the one value in the language carrying a runtime
# type tag — its `kind` — so an error-kind test is a comparison of that tag, exactly as the
# seed lowers it. Every other `x is T` is a general runtime type test, which needs tags no
# value carries this phase; it is refused BY NAME here rather than lowered to something
# that reads as a bool. Both refusals matter more than they look: until this function
# existed the `is` token was consumed by nobody and dropped, so a test emitted a stray `0;`
# and an undeclared `zg_<Name>` — C that cannot be traced back to the Zerg that meant it.
fn c_is_test(mut &em: Emitter, x: Expr, name: str, sb: Subst) -> str {
	t := c_infer(em, x)
	kind := c_err_kind(name)

	raise f"NotImplemented: `is {name}` — only the built-in error kinds can be named in an `is` test" if kind == 0
	raise f"`is {name}` wants an Err on its left, found a {ty_name(t)}" if not c_is_err_ty(t)

	return f"(({c_expr(em, x, sb)}).kind == {kind})"
}

# c_is_aggregate reports the types C cannot compare with `==`: a declared struct, and the
# runtime containers. An enum is not one — its tag is compared above — and neither is a
# carrier, whose `==` is refused by the null-safety rules before it reaches here.
# c_is_cmp_op is the operators whose meaning on an aggregate comes from a derived impl.
fn c_is_cmp_op(oper: str) -> bool {
	return oper == "==" or oper == "!=" or oper == "<" or oper == ">" or oper == "<=" or oper == ">="
}

fn c_is_aggregate(mut &em: Emitter, t: Ty) -> bool {
	# an ENUM is a composite too, and it was the one this predicate did not name: `f"{c}"`
	# on a `Color` cast the tagged union to int64_t and cc reported it against generated C.
	# Its rendering is `int(c)` — the discriminant — which the programmer has to write,
	# because a NAME for the variant is what `Display` would give and there is none.
	return true if c_is_enum_ty(em, t)

	return c_is_struct_name(em, c_named_of(t)) or c_is_list(t) or c_is_map(t) or c_is_tuple(t)
}

# c_is_enum_ty reports whether a type is a declared enum (a TNamed matching an enum).
fn c_is_enum_ty(mut &em: Emitter, t: Ty) -> bool {
	nm := c_named_of(t)
	return false if nm == ""
	mut i := 0
	for i < em.enum_names.len() {
		return true if em.enum_names[i] == nm
		i = i + 1
	}
	return false
}

# c_conv lowers a type conversion. list[byte](str) goes through the emitted string helper
# and the scalar casts are plain C casts; `str(x)` is the one that reads its SOURCE type.
#
# `str` is two conversions wearing one name. Over a `list[byte]` it is the bridge back to a
# string — the meaning every `str(out)` in this tree relies on. Over anything else it is
# `display()`: the text a value shows as, which is what `print` writes and what an
# f-string's `{x}` interpolates.
#
# Dispatching on the source is what makes the second of those exist at all. Emitting the
# bridge unconditionally handed `zgs_from_bytes` an `int64_t`, so `str(n)` was not a thing
# anyone could write — a cc type error with no Zerg diagnostic in front of it. The three
# display leaves are already in the runtime header for the seed's f-strings.
fn c_conv(mut &em: Emitter, ty: Ty, x: Expr, nm: str, sb: Subst) -> str {
	inner := c_expr(em, x, sb)
	xt0 := c_infer(em, x)
	if c_is_str(ty) {
		em.used_str = true
		em.used_rt = true

		return inner if c_is_str(c_infer(em, x))
		if c_is_list(xt0) {
			# ONLY a `list[byte]`. The bridge reinterprets the buffer as characters, so
			# `f"{xs}"` on a `list[int]` printed the low byte of each element and on a
			# `list[list[int]]` printed the low bytes of a heap POINTER. `print xs` refuses
			# a composite; this hole let the same value out through an f-string hole.
			raise f"`str(…)` over a list is the BYTE bridge, and this is {ty_name(xt0)} — a composite has no rendering of its own, so render its elements" if not c_is_byte(c_list_elem(xt0))

			# zrt_str_from_bytes CONSUMES the list — it drops it on the success path and on
			# the raise, so a caller passing a temporary owes no post-call drop that an
			# unwind would skip. That means it must be handed a list nobody else holds: a
			# fresh rvalue goes straight in, and one that NAMES storage is copied first.
			# The old zgs_from_bytes borrowed instead, so substituting one for the other
			# without this dropped the caller's own list out from under it — a double drop
			# the moment the binding's own release ran, and heap corruption before that.
			return f"zrt_str_from_bytes({c_copied(em, xt0, x, sb)})" if c_is_lvalue(x)

			return f"zrt_str_from_bytes({inner})"
		}

		c_display_check(em, xt0)
		return c_display(xt0, inner)
	}
	if c_is_list(ty) {
		em.used_str = true
		em.used_rt = true

		# `list[T](x)` is the str -> bytes BRIDGE and nothing else. Anything but a str was
		# emitted as `zgs_to_bytes(x)` and reported by cc — `list[int]([1,2,3])` as
		# "passing 'zrt_list' to parameter of incompatible type 'const char *'".
		raise f"`list[…](…)` converts a `str` to its bytes, and this is {ty_name(xt0)} — a list is built with `[…]`, not converted into" if not c_is_str(xt0)

		# `list[rune](s)` is the OTHER documented bridge (docs/runtime/builtins.md) and the
		# runtime has it — `zrt_str_runes` decodes the code points, and the seed emits it.
		# What this compiler lacks is `rune` as a type at all, which is why the form is
		# named rather than described as a rule about what a str's bytes are.
		raise "NotImplemented: `list[rune](s)` decodes a str's code points — this compiler has no `rune` type, only `list[byte](s)`" if c_named_of(c_list_elem(ty)) == "rune"
		raise f"`list[{ty_name(c_list_elem(ty))}](…)` — the bytes of a `str` are `list[byte]`" if not c_is_byte(c_list_elem(ty))

		return f"zrt_str_bytes({inner})"
	}

	# `int(v)` over an enum reads its DISCRIMINANT (GRAMMAR:577), which is the tag field —
	# not the value, which is a struct. Casting the struct is what this used to emit, and C
	# rejected it against a file in .zerg-cache that nobody wrote.
	xt := c_infer(em, x)

	# a CARRIER is not a value to convert: `int(k)` where k is a `K?` used to cast the
	# carrier struct, which cc rejected against generated code. The unwrap is the language's
	# and has to be written.
	raise f"`{nm}(…)` converts a value, and {ty_name(xt)} may not have one — unwrap it first with `??`, `!` or `if v := …`" if c_is_carrier(xt)
	if c_name_in(em.enum_names, c_named_of(xt)) {
		raise f"enum `{c_named_of(xt)}` carries a payload, so its tag is opaque and match-only — `int(v)` reads the discriminant of an enum whose every variant is fieldless" if not c_is_flat_enum(em, c_named_of(xt))

		# `int(v)` is the ONE conversion an enum has. Every other one fell through to a plain
		# C cast OF THE STRUCT, which cc rejected against generated code — the report this
		# compiler exists to get in front of.
		raise f"an enum converts to `int` — its discriminant — and to nothing else, so `{nm}(…)` over `{c_named_of(xt)}` is not a conversion the language has" if not c_is_int(ty)

		return f"((int64_t)({inner}).tag)"
	}

	# A `str` SOURCE is PARSED, never re-constructed: `int(s)` / `uint(s)` / `float(s)` read
	# the number's text through the runtime, raising ValueError on a malformed string and
	# OverflowError on one out of range (docs/runtime/builtins.md, "Parsing a string").
	#
	# Falling through to the cast below reinterpreted the str's POINTER as the target, and
	# the two halves of that failed differently: `int("42")` printed an address with no
	# diagnostic at all, while `float("3.5")` was reported by cc against generated C. The
	# runtime helpers have existed since the seed emitted them; this compiler simply never
	# reached them.
	if c_is_str(xt) {
		em.used_rt = true

		return f"((int64_t)zrt_parse_uint({inner}))" if nm == "uint"
		return f"zrt_parse_int({inner})" if c_is_int(ty)
		return f"zrt_parse_float({inner})" if c_is_float(ty)

		raise f"`{nm}(…)` does not parse a `str` — only `int(s)`, `uint(s)` and `float(s)` read a number out of one"
	}

	# THE TARGET'S SHAPE COMES FROM THE SPELLING, and only for `uint`. This compiler models
	# `uint` as `int64_t` (parser.zg), so `ty` is TInt for both `int(x)` and `uint(x)` and
	# the type genuinely cannot tell them apart — it is the one scalar property the Ty
	# carries no room for. Supplying it here keeps `c_conv_scalar` a lowering over shapes
	# rather than over spellings, and it is where a `TUint` would plug in if `uint` ever
	# becomes its own type. [deviation] The same flattening means `x: uint = -5` and a
	# `uint` parameter are still unchecked; only the conversion is.
	mut dc := c_scalar_class(ty)
	mut db := c_scalar_bits(ty)
	if nm == "uint" {
		dc = SC_UNSIGNED
		db = 64
	}
	return c_conv_scalar(em, dc, db, xt, ty, inner)
}

# The conversion-relevant SHAPE of a scalar: what the value is, independent of how wide it
# is. This is the seed's `sema.ScalarClass` (src/bootstrap/internal/sema/convert.go), ported
# rather than re-derived — the two compilers have to agree about which conversions are
# lossless, and stating the rule twice in two shapes is how they stop agreeing.
const SC_NONE := 0
const SC_SIGNED := 1
const SC_UNSIGNED := 2
const SC_FLOAT := 3
const SC_BOOL := 4

# c_scalar_class answers a type's scalar class, or SC_NONE for a type that is not a
# convertible scalar. A `str` deliberately has none: it is PARSED, which c_conv handles
# above, and a value is built from it with `list[byte](s)` rather than cast.
fn c_scalar_class(t: Ty) -> int {
	return SC_SIGNED if c_is_int(t)
	return SC_UNSIGNED if c_is_byte(t)
	return SC_FLOAT if c_is_float(t)
	return SC_BOOL if c_is_bool_ty(t)

	return SC_NONE
}

fn c_scalar_bits(t: Ty) -> int {
	return 8 if c_is_byte(t)
	return 1 if c_is_bool_ty(t)

	return 64
}

# c_lossless reports whether every value of the source shape is representable in the
# target's, which is what lets the conversion stay a plain C cast with no range check and
# no runtime call. It is the seed's `sema.Lossless`, rule for rule.
fn c_lossless(sc: int, sb: int, dc: int, db: int) -> bool {
	# `bool(x)` is a zero test and never out of range; widening INTO a float never raises,
	# because an out-of-range float is ±Inf, which docs/core/types.md makes an IEEE value
	# rather than an abort.
	return true if dc == SC_BOOL or dc == SC_FLOAT
	return true if sc == SC_BOOL

	if dc == SC_SIGNED {
		return sb <= db if sc == SC_SIGNED

		# an unsigned source needs one more bit than it has, for the sign
		return sb < db if sc == SC_UNSIGNED
	}
	if dc == SC_UNSIGNED {
		return sb <= db if sc == SC_UNSIGNED

		# a signed source may be negative, which no unsigned target holds
		return false if sc == SC_SIGNED
	}
	return false
}

# The target's bounds, rendered as C. The 64-bit ends use <stdint.h>'s macros: the decimal
# spelling of INT64_MIN is not a C integer constant — it parses as a negation of a value one
# past INT64_MAX — and UINT64_MAX needs a suffix to stay unsigned. The float forms are the
# same bounds as doubles, where the 64-bit text rounds to 2^63 / 2^64, which is what the
# helper's open-interval test wants.

fn c_signed_lo(bits: int) -> str {
	return "INT64_MIN" if bits >= 64

	return "-128"
}

fn c_signed_hi(bits: int) -> str {
	return "INT64_MAX" if bits >= 64

	return "127"
}

fn c_unsigned_hi(bits: int) -> str {
	return "UINT64_MAX" if bits >= 64

	return "255"
}

fn c_float_lo(bits: int) -> str {
	return "-9223372036854775808.0" if bits >= 64

	return "-128.0"
}

fn c_float_hi(dc: int, bits: int) -> str {
	if dc == SC_UNSIGNED {
		return "18446744073709551615.0" if bits >= 64

		return "255.0"
	}
	return "9223372036854775807.0" if bits >= 64

	return "127.0"
}

# c_conv_scalar lowers `T(x)` between two scalars. Zerg converts by RE-CONSTRUCTION and a
# value that does not fit the target ABORTS with OverflowError (docs/runtime/builtins.md),
# so a NARROWING conversion goes through the runtime's checked helper while one the shapes
# prove lossless stays a plain C cast and costs nothing.
#
# Every conversion here used to be that plain cast, whatever the widths, which is C's
# truncation wearing Zerg's syntax: `byte(300)` gave 44, and `int(1e30)` was undefined
# behaviour that happened to print INT64_MAX. Both are the OverflowError the documentation
# promises and the seed already raises.
#
# The target's shape arrives as (dc, db) rather than being read off `ty`, because `uint`
# has no Ty of its own here; `ty` is still needed for the C type the result is cast to.
fn c_conv_scalar(mut &em: Emitter, dc: int, db: int, xt: Ty, ty: Ty, inner: str) -> str {
	sc := c_scalar_class(xt)

	# NOT A SCALAR ON EITHER SIDE. Naming only the aggregates left `TChan`, `TErr` and an
	# unresolved `TNamed` falling through to the cast below — the same class this whole
	# function exists to close, one type-family over. TUnknown keeps the plain cast: a type
	# inference could not work out is not evidence the program is wrong.
	raise f"`{ty_name(ty)}(…)` converts a scalar, and {ty_name(xt)} is not one" if sc == SC_NONE and not c_is_unknown(xt)

	return f"(({c_type(ty)})({inner}))" if sc == SC_NONE or c_lossless(sc, c_scalar_bits(xt), dc, db)

	em.used_rt = true
	ct := c_type(ty)

	# float -> integer truncates toward zero, and the helper's bounds are the TRUNCATED
	# value's, so 255.7 converts to 255 while 256.0 raises. NaN and the infinities fail the
	# same comparisons and abort on the same path.
	if sc == SC_FLOAT {
		return f"(({ct})zrt_conv_u_from_f((double)({inner}), {c_float_hi(dc, db)}))" if dc == SC_UNSIGNED

		return f"(({ct})zrt_conv_i_from_f((double)({inner}), {c_float_lo(db)}, {c_float_hi(dc, db)}))"
	}
	if dc == SC_UNSIGNED {
		return f"(({ct})zrt_conv_u_from_u((uint64_t)({inner}), {c_unsigned_hi(db)}))" if sc == SC_UNSIGNED

		return f"(({ct})zrt_conv_u_from_i((int64_t)({inner}), {c_unsigned_hi(db)}))"
	}
	return f"(({ct})zrt_conv_i_from_u((uint64_t)({inner}), {c_signed_hi(db)}))" if sc == SC_UNSIGNED

	return f"(({ct})zrt_conv_i_from_i((int64_t)({inner}), {c_signed_lo(db)}, {c_signed_hi(db)}))"
}

# c_display is the runtime leaf that renders one scalar as its display text. A `byte` goes
# through the unsigned one, and anything whose type did not survive inference falls to the
# integer one — where the C cast is what reports it, rather than this pass guessing.
# c_display is the runtime leaf that renders one SCALAR. A composite has no rendering here
# — the structural one is `Display`'s job and there is no derive for it — so it is named
# rather than cast, which is what reached cc as "operand of type 'zg_P'".
fn c_display_check(mut &em: Emitter, t: Ty) {
	# an ENUM's advice is not a struct's: it has variants and not fields, and the thing a
	# reader can actually write is the discriminant
	raise f"NotImplemented: rendering a {ty_name(t)} as text — an enum has no name for its variant without the structural `Display` this compiler does not generate; `int(v)` gives its discriminant, or `match` it" if c_is_enum_ty(em, t)
	raise f"NotImplemented: rendering a {ty_name(t)} as text — a composite needs the structural `Display` this compiler does not generate; render its fields" if c_is_aggregate(em, t) or c_is_carrier(t)
}

fn c_display(t: Ty, inner: str) -> str {
	return match t {
		TBool  => f"zrt_display_bool({inner})"
		TFloat => f"zrt_display_float((double)({inner}))"
		TByte  => f"zrt_display_uint((uint64_t)({inner}))"
		_      => f"zrt_display_int((int64_t)({inner}))"
	}
}

# c_index lowers `xs[i]` to a runtime list read, casting the element pointer to the
# element C type inferred for the target.
fn c_index(mut &em: Emitter, target: Expr, idx: Expr, sb: Subst) -> str {
	em.used_rt = true
	tty := c_infer(em, target)

	# a CARRIER is not a thing to index: `a[0]` on a `list[int]?` handed the runtime the
	# carrier struct where a list header goes, which cc reported as a WARNING — so the
	# program linked and segfaulted. The unwrap is the language's and has to be written.
	raise f"`[…]` indexes a value, and {ty_name(tty)} may not have one — unwrap it first with `??`, `!` or `if v := …`" if c_is_carrier(tty)

	# A `str` was whitelisted by the guard below and rejected by the statement after it —
	# one rule about one type, held in two places that said opposite things. It is asked
	# once, here, and the guard no longer mentions it.
	if c_is_str(tty) {
		chk_str_not_indexable(em)

		return "0"
	}

	raise f"`[…]` indexes a list or a map, and this is {ty_name(tty)}" if not c_is_list(tty) and not c_is_map(tty) and not c_is_unknown(tty)

	return c_map_index(em, target, idx, tty, sb) if c_is_map(tty)
	return c_slice(em, target, idx, tty, sb) if c_is_range(idx)

	ct := c_type(c_list_elem(tty))

	# the TARGET keeps the write mode and the INDEX does not: `xs[js[0]] = 9` writes into
	# `xs` and reads `js`, and unsharing `js` for it would be a copy nobody asked for
	w := em.lv_write
	tgt := c_expr(em, target, sb)
	em.lv_write = false
	ix := c_expr(em, idx, sb)
	em.lv_write = w

	at := c_list_at_fn(w)

	# c_is_PLACE and not c_is_lvalue: the type-blind question calls `m[k]` an lvalue, and
	# it is not — it lowers to a statement expression, so `c["k"][0]` took the address of
	# an rvalue and cc said so about C nobody wrote. c_is_place is the same question with
	# the types that tell them apart, and it is what the mutating-method path already asks.
	return f"(*({ct}*){at}(&({tgt}), {ix}))" if c_is_place(em, target)

	# a call/conversion result is an rvalue; materialise it so its address is taken
	return "({ zrt_list zgt_ix = " + tgt + "; (*(" + ct + "*)" + at + "(&zgt_ix, " + ix + ")); })"
}

# c_list_at_fn picks the runtime slot accessor. They differ by exactly one thing — the
# write one unshares the buffer first — and choosing between them is the whole of what
# the compiler owes copy-on-write. Getting it wrong the safe way (always unsharing) makes
# every indexed read duplicate a buffer; getting it wrong the other way lets a write
# through one name be seen through another, which is the language's value semantics.
fn c_list_at_fn(write: bool) -> str {
	return "zrt_list_at" if write
	return "zrt_list_at_ref"
}

# c_lvalue lowers an expression that is being WRITTEN to. It is c_expr with the write
# mode on, which is where the mode belongs: an assignment target is the only thing that
# knows it is one, and it is exactly one node above the indexes that need to know.
fn c_lvalue(mut &em: Emitter, e: Expr, sb: Subst) -> str {
	# saved and RESTORED, the discipline c_index thirty lines up already follows. Clobbering
	# to false is correct only while nothing lowers an lvalue inside one, which is a
	# property of today's callers rather than of this function.
	w := em.lv_write
	em.lv_write = true
	out := c_expr(em, e, sb)
	em.lv_write = w
	return out
}

# c_is_place is c_is_lvalue WITH TYPES: an expression that names storage a caller can take
# the address of. `m[k]` is the one that needs them — it looks like an index and lowers to a
# statement expression, so it is a value however much it reads as a place. c_is_lvalue is
# type-blind and cannot tell the two indexes apart.
# A place is a place ALL THE WAY DOWN. `mk().xs` is an lvalue by shape — a field access —
# and its target is a call, which has no address, so `&(mk().xs)` reached cc. The question
# is about the whole path and was asked only about the last step.
fn c_is_place(mut &em: Emitter, e: Expr) -> bool {
	return false if not c_is_lvalue(e)
	return false if c_is_index(e) and c_is_map(c_infer(em, c_index_target(e)))

	# a bare name is where the recursion stops: it is storage, and it has no target
	return true if c_ident_name(e) != ""

	return c_is_place(em, chk_store_target(e))
}

# c_place_why names what an expression is, for the diagnostic above.
# It names the step of the path that is NOT storage, which is not always the expression it
# was handed: `mk().xs[0] = 9` fails at `mk()`, and calling the whole thing "a call result"
# is true of the call and not of the `mk().xs` this was asked about. c_is_place became a
# whole-path question and this is its other half.
fn c_place_why(mut &em: Emitter, e: Expr) -> str {
	return "a map index" if c_is_index(e) and c_is_map(c_infer(em, c_index_target(e)))
	return "a slice" if c_is_index(e) and c_is_range(c_index_key(e))
	return "a call result" if c_ident_name(e) == "" and not c_is_lvalue(e)

	# an lvalue by SHAPE whose path stops being storage further down — name where it stops
	return c_place_why(em, chk_store_target(e)) if c_is_lvalue(e) and c_ident_name(e) == ""

	return "a call result"
}

# c_meth_mutates reports the list methods that write through their receiver.
fn c_meth_mutates(meth: str) -> bool {
	return meth == "append"
}

fn c_is_lvalue(e: Expr) -> bool {
	return match e {
		EIdent(_) => true
		EField(_, _) => true
		EOptChain(_, _) => false
		ETry(_) => false
		EIndex(t, i) => not c_is_range(i)
		_ => false
	}
}

# `target.meth(args)` is FOUR different things wearing one syntax, told apart by what the
# target's type turns out to be:
#
#   * a LIST target      — the runtime list methods (len / append);
#   * a VALUE receiver   — a method on a named type, called as `zg_<Type>_<meth>` with the
#                          receiver passed first, since the parser made `this` parameter 0;
#   * a FIELD holding a function — `this.action(c)` calls the callback the value carries,
#                          which is a different thing from a method of the same name;
#   * anything else      — a module-qualified free call (`ascii.is_digit`), emitted as the
#                          bare mangled function, because a module flattens into this unit
#                          and `ascii` is a namespace rather than a value.
#
# The order matters and so does the last case being the fallback: a module name infers to
# no type at all, so it can never be mistaken for a receiver. The reverse mistake — a
# receiver read as a namespace — would emit a call to a function nothing declares, which
# the C compiler rejects. Neither way is silent.
#
# Which one it is has to be decided identically when the call is EMITTED and when it is
# TYPED, so it is decided once, here, and both ask. Deciding it twice is how the two drift.
enum MethKind {
	MList
	MMap
	MRecv
	MFnField
	MFree
}

fn c_meth_kind(mut &em: Emitter, tty: Ty, meth: str) -> MethKind {
	return MList if c_is_list(tty)
	return MMap if c_is_map(tty)
	return MRecv if c_has_method(em, c_named_of(tty), meth)
	return MFnField if c_is_fn(c_field_ty(em, c_named_of(tty), meth))

	return MFree
}

fn c_method(mut &em: Emitter, target: Expr, meth: str, args: list[Expr], sb: Subst) -> str {
	# `E.of(n)` is not a method on a value: the target NAMES A TYPE. It is answered before
	# inference is asked anything, because an enum name is not a binding and infers to
	# nothing — which is why this used to come out as "the method `of` on a ?".
	en := c_ident_name(target)
	return c_enum_of(em, en, meth, args, sb) if en != "" and c_name_in(em.enum_names, en)

	tty := c_infer(em, target)
	recv := c_named_of(tty)
	return match c_meth_kind(em, tty, meth) {
		MList    => c_list_method(em, target, meth, args, tty, sb)
		MMap     => c_map_method(em, target, meth, tty, sb)
		MRecv    => f"{c_fn_cname(recv, meth)}({c_recv_args(em, c_sig_key(recv, meth), target, args, sb)})"
		MFnField => f"({c_fnptr_cast(c_field_ty(em, recv, meth))}{c_expr(em, target, sb)}.zg_{meth})({c_args(em, args, sb)})"
		_        => c_free_method(em, target, meth, args, sb)
	}
}

fn c_list_method(mut &em: Emitter, target: Expr, meth: str, args: list[Expr], tty: Ty, sb: Subst) -> str {
	em.used_rt = true

	# every list method takes the list's ADDRESS, and a slice, a call result or a map index
	# has none — it is materialised into a temp first so `xs[a..b].len()` is addressable.
	#
	# A method that MUTATES cannot be served that way: the temp is a copy, so the edit
	# lands on it and is lost. `m["a"].append(3)` did exactly that — it compiled, and the
	# append silently did nothing. A read-only method on a copy is the same answer as on
	# the original; a mutating one is not, and is refused rather than dropped.
	if not c_is_place(em, target) {
		raise f"NotImplemented: `{meth}` MUTATES its list, and `{c_place_why(em, target)}` is a value rather than a place — bind it to a name first" if c_meth_mutates(meth)

		return c_list_method_rv(em, target, meth, args, tty, sb)
	}

	# A MUTATING METHOD reaches its receiver the way an assignment reaches its target, and
	# for the same reason: `d[0].append(5)` edits the inner list's HEADER, and that header
	# lives inside `d`'s buffer. Lowering the receiver as a read left the buffer shared, so
	# the header `c` sees grew a element too — the append went through `zrt_list_push`,
	# which unshares the INNER buffer and knows nothing about the outer one it sits in.
	return c_list_method_on(em, c_lvalue(em, target, sb), meth, args, tty, sb) if c_meth_mutates(meth)
	return c_list_method_on(em, c_expr(em, target, sb), meth, args, tty, sb)
}

# c_list_method_on is the lowering itself, given a target already rendered — so the lvalue
# and rvalue paths spell a method exactly the same way.
fn c_list_method_on(mut &em: Emitter, tgt: str, meth: str, args: list[Expr], tty: Ty, sb: Subst) -> str {
	return f"((int64_t)zrt_list_len(&({tgt})))" if meth == "len"

	# the guard asks `c_meth_mutates`, so the two cannot drift: a method added there and not
	# here raises rather than silently doing nothing, and one added here without being named
	# there cannot get past this line. `len` is the only read-only method, so everything
	# that reaches this point writes through its receiver — which is what decides whether
	# the receiver is lowered as a place.
	raise f"NotImplemented: the list method `{meth}` — this compiler has `len` and `append`" if not c_meth_mutates(meth)

	if meth == "append" {
		# the element is copied INTO the list, so the list owns it and the caller's name
		# for it goes on being its own
		et := c_type(c_list_elem(tty))
		el := c_fit_copied(em, c_list_elem(tty), args[0], sb)
		return "({ " + et + " zgt_le = " + el + "; zrt_list_push(&(" + tgt + "), &zgt_le); })"
	}
	return tgt
}

# c_ident_name is the name a bare identifier expression spells, or "" for anything else.
fn c_ident_name(e: Expr) -> str {
	return match e {
		EIdent(n) => n
		_         => ""
	}
}

# c_enum_of lowers `E.of(n)` (GRAMMAR:578): the variant whose discriminant is `n`, or nil.
# It answers a `E?` rather than an `E` because the reverse is PARTIAL — an integer that no
# variant claims has no variant to be, and the language's way of saying so is an optional.
#
# The discriminants are compile-time constants, so the membership test is written out as a
# chain of comparisons against them; the tag itself is the number, which is what makes the
# reverse a test and not a table.
fn c_enum_of(mut &em: Emitter, en: str, meth: str, args: list[Expr], sb: Subst) -> str {
	# `Shape.Line(5)` — a variant CONSTRUCTOR named by its enum, the payload-carrying half
	# of `Color.Red`. It arrives here rather than at c_fieldref because a call is a method
	# shape, and `of` is the other thing an enum name answers.
	return c_variant_ctor(em, meth, args, sb) if c_is_variant(em, meth) and c_variant_enum(em, meth) == en

	raise f"NotImplemented: `{en}.{meth}(…)` — an enum type answers `of(n)` and its own variants, and `{meth}` is neither" if meth != "of"
	raise f"`{en}.of(n)` takes one integer — the discriminant to reverse" if args.len() != 1
	raise f"enum `{en}` carries a payload, so its tag is opaque and match-only — `of(n)` reverses the discriminant of an enum whose every variant is fieldless" if not c_is_flat_enum(em, en)

	cn := c_opt_name(em, TNamed(en))
	n := c_expr(em, args[0], sb)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	v := "zgt_ofv" + tag
	r := "zgt_ofr" + tag

	mut test := ""
	mut i := 0
	for i < em.var_name.len() {
		if em.var_enum[i] == en {
			if test != "" {
				test = test + " || "
			}
			test = test + v + " == " + strconv.to_string(em.var_tag[i], 10)
		}
		i = i + 1
	}

	mut out := f"({{ int64_t {v} = {n}; {cn} {r};"
	out = out + f" if ({test}) {{ {c_res_mark_left(r)} {c_res_ok(r)} = (zg_{en}){{ .tag = (int32_t){v} }}; }}"
	return out + f" else {{ {c_res_mark_right(r)} }} {r}; }})"
}

# c_free_method is the last resort: a `target.meth(…)` whose target type carries no such
# method. It is a real call only when `meth` names a function — otherwise the old fallback
# emitted `zg_meth(…)` for a function nobody declared, and the diagnostic came from the C
# compiler pointing at generated code. `s.len()` is the common way in: a str has no
# methods here, and the message now says so at the Zerg level.
fn c_free_method(mut &em: Emitter, target: Expr, meth: str, args: list[Expr], sb: Subst) -> str {
	# `Type.f(…)` is an ASSOCIATED FUNCTION (GRAMMAR:490) — the named-constructor form,
	# `User.from_json(…)`. A TYPE NAME on the left is how a reader spells one, and the
	# answer used to be "the method `make` on a ?": the target is a type rather than a
	# value, so inference had nothing to name and the message pointed at the hole rather
	# than at the form. The parser gives every `fn` in an `impl` a receiver, so there is no
	# such function to call yet — which is a thing to say, not a `?`.
	tn := c_ident_name(target)

	raise f"NotImplemented: `{tn}.{meth}(…)` is an associated function — this compiler gives every `fn` in an `impl` a receiver, so a method is reached through an instance (`x.{meth}(…)`) and never through its type" if tn != "" and c_is_struct_name(em, tn)
	raise f"NotImplemented: the method `{meth}` on a {ty_name(c_infer(em, target))}" if not c_name_in(em.sig_names, meth)

	return f"zg_{meth}({c_call_args(em, meth, args, sb)})"
}

# c_recv_args renders a method call's arguments: the receiver first, then the written
# ones. Their parameter indices are shifted by one against the table, because `this` holds
# index 0 there — get that wrong and a `mut &` argument is passed by value to the slot
# after the one that wanted its address.
fn c_recv_args(mut &em: Emitter, key: str, target: Expr, args: list[Expr], sb: Subst) -> str {
	# the receiver is parameter 0 and goes through c_arg like any other argument: a plain
	# method takes it BY VALUE, so it is copied, and a `mut fn` declared it `mut &`, so it
	# takes the caller's variable itself. Routing it here rather than copying it outright is
	# what makes `mut fn` work at all — and it brings the borrow's own rules with it, which
	# GRAMMAR:302 asks for by name: "the call site must hold the receiver in a `mut`
	# binding". `pos` is 0 because a receiver has no written position; chk_ref_arg says
	# "the receiver" rather than an argument number for it.
	recv := c_arg(em, key, 0, 0, target, sb)
	return recv + c_args_from(em, key, 1, args, true, sb)
}

# c_call emits an enum-variant construction as a tagged-union literal, a struct
# construction as a plain compound literal (both are PascalCase constructors), and any
# other call as a function call.
# c_list_lit builds a list literal used AS A VALUE — passed to a function, returned,
# handed straight to a method. It lowers the way `append` does: allocate, then push each
# element in order, inside a statement expression that yields the list.
#
# Before this, a list literal in an expression emitted `(zrt_list){0}` and its ELEMENTS
# WERE DROPPED — `f([a, b])` silently passed an empty list. Nothing said so, which made it
# the worst kind of wrong: a program that ran and was simply not what was written.
#
# An empty literal keeps the zeroed form. It carries no element type of its own, so the
# one that fits comes from the declaration it initializes, and the binding and field paths
# already supply it.
fn c_list_lit(mut &em: Emitter, elems: list[Expr], sb: Subst) -> str {
	return "(zrt_list){0}" if elems.len() == 0
	em.used_rt = true

	ety := c_infer(em, elems[0])
	et := c_type(ety)
	mut out := "({ zrt_list zgt_ll = zg_empty_list(sizeof(" + et + "), &" + c_elem_vt(em, ety) + ");"
	mut i := 0
	for i < elems.len() {
		tmp := "zgt_ll" + strconv.to_string(i, 10)
		out = out + " " + et + " " + tmp + " = " + c_expr(em, elems[i], sb) + ";"
		out = out + " zrt_list_push(&zgt_ll, &" + tmp + ");"
		i = i + 1
	}
	return out + " zgt_ll; })"
}

fn c_call(mut &em: Emitter, name: str, args: list[Expr], sb: Subst) -> str {
	if c_is_intrinsic(name) {
		em.used_rt = true
		return f"{c_intrinsic(name)}({c_args(em, args, sb)})"
	}

	# a built-in error constructor, `ValueError("bad input")`. It is PascalCase, so without
	# this it reads as a struct constructor and emits a compound literal of a type nothing
	# declared — which cc rejects, loudly but a long way from the source that meant it.
	if c_err_kind(name) > 0 {
		raise f"`{name}` is testable but not constructible: a sender able to raise the end-of-stream sentinel would close its channel wearing it, and its consumer would read the crash as a clean finish" if not c_err_constructible(name)
		em.used_rt = true
		return f"zrt_err_new_kind({c_err_kind(name)}, {c_args(em, args, sb)})"
	}

	# calling a BINDING that holds a function: cast the stored generic pointer back to the
	# signature its type carries, then call through it
	bt := c_lookup_var(em, name)
	return f"({c_fnptr_cast(bt)}{c_ident_val(em, name, sb)})({c_args(em, args, sb)})" if c_is_fn(bt)
	if c_is_ctor(name) {
		return c_variant_ctor(em, name, args, sb) if c_is_variant(em, name)

		# `Left(v)` and `Right(e)` are CONTEXT-TYPED: they name a side of an Either and have
		# no type of their own, so they are read where the wanted type is known (c_either_wrap)
		# and reaching here means there was no such place. Saying that is the difference
		# between a form used wrongly and a form that does not exist.
		raise f"`{name}(…)` says which side of an `Either` a value is, so it needs a declared one to be — annotate the binding, or write it where a `Result`/`Either` result or parameter is expected" if c_ctor_side_of(name, args.len()) >= 0

		# A PascalCase call that names no declared type is not a constructor of anything.
		# It used to emit a compound literal of that name anyway, which cc rejected against
		# generated C.
		if not c_is_struct_name(em, name) {
			c_builtin_check(name)

			raise f"no type named `{name}` to construct"
		}
		return "(zg_" + name + "){" + c_struct_args(em, name, args, sb) + "}"
	}

	# NOTHING DECLARES THIS FUNCTION. It used to be spelled `zg_<name>(…)` and handed to
	# cc, which reported a call to an undeclared function against a file under .zerg-cache
	# — for a typo, or for one of the specified-but-unbuilt builtins (`addr`, `ptr`), which
	# is exactly the answer this should be giving by name.
	if not c_is_free_fn(em, name) {
		c_builtin_check(name)

		raise f"undefined function `{name}`"
	}

	rels := c_owned_args(em, name, 0, args)
	return c_call_releasing(em, f"zg_{name}", name, args, rels, sb) if c_any_owned(rels)

	return f"zg_{name}({c_call_args(em, name, args, sb)})"
}

# c_struct_args emits a struct constructor's arguments, giving each field's type as
# context so an empty-list argument is initialised correctly.
fn c_struct_args(mut &em: Emitter, sname: str, args: list[Expr], sb: Subst) -> str {
	# MORE arguments than the struct has fields reached cc as an "excess elements in struct
	# initializer" WARNING, so it compiled and the extra values were dropped. Too few has
	# been named since c_struct_rest existed; this is the same question from the other side.
	n := c_struct_field_n(em, sname)
	raise f"`{sname}` has {strconv.to_string(n, 10)} fields and this gives {strconv.to_string(args.len(), 10)}" if args.len() > n

	mut out := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + c_field_init(em, c_struct_field_ty_at(em, sname, i), args[i], sb)
		i = i + 1
	}
	return out + c_struct_rest(em, sname, args.len(), args.len() > 0)
}

# c_struct_rest fills the fields a construction left off the end. GRAMMAR group 7: there
# are NO zero values — a field with no default is REQUIRED — and the ONE implicit default
# is `nil` for a `T?` field, its natural absent state.
#
# Neither half was here. A short construction emitted a short C initializer and let the C
# compiler zero the rest, which for an optional means tag 0: PRESENT, holding whatever zero
# is. `P(1)` on a struct with a `str?` printed `(null)` — an absent field read as a present
# one. And a missing NON-optional field was equally silent, so the whole rule was decided
# by C's zeroing rather than by the language.
fn c_struct_rest(mut &em: Emitter, sname: str, given: int, lead: bool) -> str {
	mut out := ""
	mut i := given
	mut sep := lead
	for i < c_struct_field_n(em, sname) {
		ft := c_struct_field_ty_at(em, sname, i)
		raise f"`{sname}` needs a value for field {i} ({ty_name(ft)}): only a `T?` field has an implicit default, and it is `nil`" if not c_is_opt(ft)
		if sep {
			out = out + ", "
		}
		sep = true
		out = out + "(" + c_opt_name(em, c_opt_elem(ft)) + "){ .tag = 1 }"
		i = i + 1
	}
	return out
}

fn c_struct_field_n(mut &em: Emitter, sname: str) -> int {
	mut n := 0
	mut i := 0
	for i < em.fld_struct.len() {
		if em.fld_struct[i] == sname {
			n = n + 1
		}
		i = i + 1
	}
	return n
}

# c_call_args emits a call's arguments, taking the address of any argument bound to a
# mutable-reference parameter (which is a C pointer).
fn c_call_args(mut &em: Emitter, fname: str, args: list[Expr], sb: Subst) -> str {
	return c_args_from(em, fname, 0, args, false, sb)
}

# c_args_from renders a call's written arguments against the parameters starting at `base`,
# then the defaults for whatever was left off. `base` is 0 for a free call and 1 for a
# method, whose receiver already stands where parameter 0 does — the shift is written down
# once here rather than in each caller, because getting it wrong passes a `mut &` argument
# by value into the slot after the one that wanted its address.
fn c_args_from(mut &em: Emitter, key: str, base: int, args: list[Expr], lead: bool, sb: Subst) -> str {
	chk_call_arity(em, key, base, args.len())

	# the aliasing rule is about a CALL rather than an argument, so it is asked once here
	# and not inside the per-argument walk below
	if base == 0 {
		chk_ref_alias(em, key, args)
	}

	mut out := ""
	mut i := 0
	for i < args.len() {
		if lead or i > 0 {
			out = out + ", "
		}
		out = out + c_arg(em, key, base + i, i + 1, args[i], sb)
		i = i + 1
	}
	return out + c_default_args(em, key, base + args.len(), lead or args.len() > 0)
}

# c_owned_args answers WHICH of a call's arguments hand it something the CALLER has to give
# back, as one release function per written argument and "" for the rest.
#
# A plain call argument is a BORROW — the language says so (docs/code/coroutine.md, and
# conc_chan_dir pins it): passing a handle moves no count, which is why a callee neither
# copies its channel parameter nor releases it. That is exactly right for `f(ch)`, where the
# caller's binding is still holding one. It leaves a hole for `f(source())`: the argument is
# a freshly built handle carrying one reference, the callee borrows it, and when the call
# returns there is no name left anywhere that could give it back.
#
# So the caller keeps it and releases it after the call (c_call_releasing). "Freshly built"
# is the same test c_let_chan makes — anything that is not existing storage — and the answer
# is a release FUNCTION rather than a bool because the type decides which one: a send-capable
# handle gives back a send count as well as a holder count, and the two are not the same
# release. That is also what makes this list the place the other owning types join when they
# grow a drop, rather than a channel-shaped question asked in a channel-shaped way.
fn c_owned_args(mut &em: Emitter, key: str, base: int, args: list[Expr]) -> list[str] {
	mut rels: list[str] = []
	mut i := 0
	for i < args.len() {
		row := c_param_row(em, key, base + i)
		mut rel := ""
		if row >= 0 and ty_is_chan(em.pr_ty[row]) and not c_is_lvalue(args[i]) {
			# a `mut &` parameter takes the caller's own storage, which is a name and so
			# never one of these — but say it here rather than rely on the lvalue test to
			# have covered it, because the two questions are different ones
			if not em.pr_ref[row] {
				rel = c_chan_release_fn(c_chan_dir(em.pr_ty[row]))
			}
		}
		rels.append(rel)
		i = i + 1
	}
	return rels
}

# c_any_owned is whether c_owned_args found anything at all — the common answer is no, and
# a call with nothing to give back must render exactly the C it rendered before.
fn c_any_owned(rels: list[str]) -> bool {
	for r in rels {
		return true if r != ""
	}
	return false
}

# c_call_releasing renders a call that is handed something the caller has to give back. It
# is a STATEMENT EXPRESSION — the same shape this emitter already uses to index a map —
# because the release has to happen after the call and an expression has nowhere else to put
# it:
#
#     ({ zrt_chan *zgt_t0 = source(); int64_t zgt_tr = zg_drain(zgt_t0);
#        zrt_chan_release(zgt_t0); zgt_tr; })
#
# The result is held in a temporary of its own so the release lands BETWEEN the call and the
# value: releasing first would hand the caller a value read out of a channel it had already
# given back, and releasing after the whole expression is what there is no place to write.
# A call that answers nothing skips that temporary, because C has no `void` object to
# declare — the statement expression's value is then the release, which is what a discarded
# call wants anyway.
#
# Every temporary is numbered from em.tmp_n rather than from its position, so a call nested
# in another call's argument cannot shadow the name the outer one is still holding.
fn c_call_releasing(mut &em: Emitter, cfn: str, key: str, args: list[Expr], rels: list[str], sb: Subst) -> str {
	chk_call_arity(em, key, 0, args.len())
	chk_ref_alias(em, key, args)

	mut decls := ""
	mut call := cfn + "("
	mut frees := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			call = call + ", "
		}
		rendered := c_arg(em, key, i, i + 1, args[i], sb)
		if rels[i] == "" {
			call = call + rendered
		} else {
			em.tmp_n = em.tmp_n + 1
			tn := f"zgt_t{em.tmp_n}"
			decls = decls + f"zrt_chan *{tn} = {rendered}; "
			call = call + tn
			frees = frees + f"{rels[i]}({tn}); "
		}
		i = i + 1
	}
	call = call + c_default_args(em, key, args.len(), args.len() > 0) + ")"

	ret := c_lookup_sig_ret(em, key)
	return f"({{ {decls}{call}; {frees}}})" if ty_eq(ret, TVoid)

	em.tmp_n = em.tmp_n + 1
	rn := f"zgt_t{em.tmp_n}"
	return f"({{ {decls}{c_type(ret)} {rn} = {call}; {frees}{rn}; }})"
}

# c_arg renders ONE argument against the parameter it fills. A `mut &` parameter takes the
# caller's variable itself — that is the whole point of the writeback — and every other
# one takes a value the callee OWNS, which is why it is copied.
#
# Copying here rather than at the `return` is what lets a function hand back a parameter:
# once the callee's copy is its own, returning it aliases nothing, and a call's result can
# go on being treated as nobody else's. Copying at the return instead would have to copy a
# local that is about to die, which is pure waste and needs escape analysis to avoid.
# `idx` is the PARAMETER's index and `pos` is the argument's place as written — they differ
# by one on a method, whose receiver fills parameter 0 without appearing at the call. The
# first is what reads the parameter table; the second is what a diagnostic may say out loud.
fn c_arg(mut &em: Emitter, fname: str, idx: int, pos: int, a: Expr, sb: Subst) -> str {
	# the one place that reads the row directly rather than through the per-column
	# helpers: it needs two answers about the same parameter, and asking twice would walk
	# the whole program's parameter table twice for every argument of every call
	row := c_param_row(em, fname, idx)

	# the check is handed the row's TYPE rather than the name and index it would look the
	# row up from — the scan above is the one this function exists not to repeat
	chk_argument(em, fname, row, pos, a)

	# a `mut &` argument is the caller's own storage, handed over to be WRITTEN — so it is
	# lowered like an assignment target and not like a read. `f(mut &xs[0])` took the
	# address of a slot in a buffer that may be shared, and the callee's write was read
	# back through every other holder.
	if row >= 0 and em.pr_ref[row] {
		chk_ref_arg(em, fname, pos, a)
		return f"&({c_lvalue(em, a, sb)})"
	}
	return c_expr(em, a, sb) if row < 0

	# guarded on the DECLARED type, which is already in hand: c_chan_check answers nothing
	# unless it is a channel, and the c_infer it would otherwise take walks the argument's
	# whole tree — on every argument of every call — only to be thrown away.
	if ty_is_chan(em.pr_ty[row]) {
		c_chan_check(c_infer(em, a), em.pr_ty[row], f"argument {idx} of `{fname}`")
	}
	return c_fit_copied(em, em.pr_ty[row], a, sb)
}

# c_captured renders the value a `spawn` or a `defer` stores in its env — the same value
# the callee would OWN at an ordinary call, which is why it is copied. c_arg is the wrong
# tool for it: that one renders straight into an argument list and re-runs the checks
# chk_callsite has already made, so calling it here would say everything twice. The COPY is
# not optional, and both statements skipped it: `defer take(xs)` handed the callee the
# caller's own buffer, so a later `xs[0] = 99` was seen by a call that is documented to
# have taken a snapshot. An ordinary `take(xs)` copied all along — the two disagreed.
#
# A CHANNEL is the exception the language draws on purpose: a handle is shared, and the
# capture takes its own reference rather than a copy. `spawn`'s loop does that above; a
# copy here would be a second, wrong answer to the same question.
fn c_captured(mut &em: Emitter, key: str, idx: int, a: Expr) -> str {
	row := c_param_row(em, key, idx)

	return c_expr(em, a, c_nosub()) if row < 0 or ty_is_chan(em.pr_ty[row])

	return c_fit_copied(em, em.pr_ty[row], a, c_nosub())
}

fn c_param_ty(mut &em: Emitter, fname: str, idx: int) -> Ty {
	row := c_param_row(em, fname, idx)
	return TUnknown if row < 0
	return em.pr_ty[row]
}

# c_default_args fills in the parameters a call left off the end, in declaration order,
# taking each one's declared default. C has no such notion, so the backfill happens here:
# every emitted call is fully applied whatever the source wrote.
#
# It stops at the first parameter with no default, which is also where the language stops
# — a parameter without one is mandatory, and a call missing it is a call that is wrong.
# Emitting the arguments it DOES have and no more would produce C that cc rejects, which
# is the failure this compiler wants when a program is wrong.
#
# c_defaults_from is the one encoding of that rule: the default EXPRESSIONS of every
# parameter from `at` onward. It was written twice — once to render them for an ordinary
# call, once to append them for a spawn — and the two disagreed about the receiver shift.
#
# The row is read directly, for the reason c_arg gives: two answers about one parameter,
# and the per-column helpers would scan the whole program's parameter table for each.
fn c_defaults_from(mut &em: Emitter, key: str, at: int) -> list[Expr] {
	mut out: list[Expr] = []
	mut i := at
	mut row := c_param_row(em, key, i)
	for row >= 0 and em.pr_hasdef[row] {
		out.append(em.pr_def[row])
		i = i + 1
		row = c_param_row(em, key, i)
	}
	return out
}

fn c_default_args(mut &em: Emitter, fname: str, given: int, sep: bool) -> str {
	mut out := ""
	mut lead := sep
	mut i := given
	for d in c_defaults_from(em, fname, given) {
		if lead {
			out = out + ", "
		}
		lead = true

		# a default is an argument, so it meets its parameter's type like any other — which
		# is what gives `fn take(xs: list[int] = [])` an element size. Rendered with c_expr
		# it was the bare `(zrt_list){0}`, and every append into it memcpy'd nothing.
		out = out + c_fit_copied(em, c_param_ty(em, fname, i), d, c_nosub())
		i = i + 1
	}
	return out
}

# c_variant_ctor builds `(zg_Enum){.tag = N, .u.Var = {.f0 = a, ...}}` (the payload part
# omitted for a tag-only variant).
fn c_variant_ctor(mut &em: Emitter, name: str, args: list[Expr], sb: Subst) -> str {
	# the same disagreement as a pattern that binds too much, from the other side: `Line(7,
	# 8)` on a `Line(int)` wrote a union member that was never declared, and cc reported it
	# against generated C
	chk_variant_arity(em, name, args.len(), "gives")

	en := c_variant_enum(em, name)
	mut out := "(zg_" + en + "){.tag = " + strconv.to_string(c_variant_tag(em, name), 10)
	if args.len() > 0 {
		out = out + ", .u." + name + " = {"
		mut i := 0
		for i < args.len() {
			if i > 0 {
				out = out + ", "
			}
			mut val := c_field_init(em, c_variant_field_ty(em, name, i), args[i], sb)
			if c_is_boxed(em, name, i) {
				# box a self-recursive payload into a leaked ref cell
				val = f"zg_refnew_{en}({val})"
			}
			out = out + ".f" + strconv.to_string(i, 10) + " = " + val
			i = i + 1
		}
		out = out + "}"
	}
	return out + "}"
}

# c_ident_val resolves a bare name: a match binding wins, then a nullary enum variant
# (constructed as a tag-only literal), otherwise a mangled variable reference.
fn c_ident_val(mut &em: Emitter, n: str, sb: Subst) -> str {
	mut i := 0
	for i < sb.names.len() {
		return sb.repls[i] if sb.names[i] == n
		i = i + 1
	}
	return "(zg_" + c_variant_enum(em, n) + "){.tag = " + strconv.to_string(c_variant_tag(em, n), 10) + "}" if c_is_variant(em, n)
	if c_is_ref_name(em, n) {
		# a mutable-reference parameter is a pointer; dereference it on use
		return f"(*zg_{n})"
	}

	# A bare function NAME used where a value is wanted is that function as a value. It is
	# only reached when nothing has bound the name, so a binding always wins — which is the
	# ordinary scoping rule, and it means a local can shadow a function without surprise.
	if c_is_free_fn(em, n) and not c_is_bound(em, n) {
		em.used_fnptr = true
		return f"((zg_fnptr)zg_{n})"
	}

	# NOTHING IN SCOPE ANSWERS TO THIS NAME. It used to be spelled `zg_<n>` and handed to
	# cc, which reported "use of undeclared identifier" against a file under .zerg-cache —
	# for the commonest mistake anyone makes, a typo. The seed has said `undefined name`
	# all along.
	#
	# A module constant, a struct name and a variant are all bound by the time a body is
	# emitted, so the check is one question: did anything bind it?
	# `this` is not an ordinary unknown name. GRAMMAR:330 says it is not a parameter and
	# GRAMMAR:332 that a `fn` whose body uses it with no instance bound is a compile error —
	# so the thing to say is which rule was broken, not that the name is unknown. It is
	# bound exactly when the enclosing `fn` was declared in an `impl` or a `spec`, because
	# that is where the parser puts the receiver.
	#
	# A CHECKED rule rather than a refusal, so it carries the place every other rule does:
	# it is a statement about a program the language rejects, not a form this compiler has
	# not built, and the C emitted after a finding is discarded.
	if n == "this" and not c_is_bound(em, n) {
		chk_at(em, "`this` is a method's receiver, and this function has none — a `fn` outside an `impl` or a `spec` is not called on an instance")
		return "0"
	}
	if not c_is_bound(em, n) and not c_is_struct_name(em, n) {
		c_builtin_check(n)

		raise f"undefined name `{n}`"
	}

	# every read of a binding funnels through here, which is what makes this the one place
	# a use after `del` has to be caught
	c_live_use(em, n)
	return c_var_cname(em, n)
}

fn c_is_bound(mut &em: Emitter, n: str) -> bool {
	return not c_is_unknown(c_lookup_var(em, n))
}

# c_fn_ty_of builds the `fn(P...) -> R` type of a named free function, reading the
# parameter types back out of the table c_build_sigs filled.
fn c_fn_ty_of(mut &em: Emitter, n: str) -> Ty {
	# one pass: c_build_sigs appends a function's parameters contiguously and in index
	# order, so collecting the rows that name it collects them already in order
	mut ptys: list[Ty] = []
	mut i := 0
	for i < em.pr_fn.len() {
		if em.pr_fn[i] == n {
			ptys.append(em.pr_ty[i])
		}
		i = i + 1
	}
	return TFn(ptys, c_lookup_sig_ret(em, n))
}

fn c_args(mut &em: Emitter, args: list[Expr], sb: Subst) -> str {
	mut out := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + c_expr(em, args[i], sb)
		i = i + 1
	}
	return out
}

# c_match lowers a match expression to a right-nested C ternary, the last arm as the
# final else (the subset requires an exhaustive catch-all last arm).
#
# The scrutinee is bound to a temp first unless it is already an lvalue. Every arm's
# condition and body has the scrutinee spliced into it, so pasting the expression itself
# would evaluate it once PER ARM — which for `match f(x)` is a call repeated and for
# `match <-ch` is a second value taken off the channel and thrown away. An lvalue is left
# alone: re-reading a name costs nothing and does nothing, and leaving it alone is what
# keeps the emitted C for everything that already worked exactly where it was.
#
# A scrutinee whose type inference could not name is also left alone: the temp needs a C
# type to be declared with, and guessing one would turn a typing gap into wrong C.
fn c_match(mut &em: Emitter, scrut: Expr, arms: list[Arm], sb: Subst) -> str {
	st := c_infer(em, scrut)
	c_check_arm_pats(em, arms, st)
	c_check_exhaustive(em, arms, st)
	s := c_expr(em, scrut, sb)
	return c_arms(em, arms, 0, s, st, sb) if c_is_lvalue(scrut) or c_is_unknown(st)

	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_ms" + tag
	return f"({{ {c_type(st)} {tmp} = {s}; {c_arms(em, arms, 0, tmp, st, sb)}; }})"
}

# c_check_arm_pats refuses a constructor pattern that names a variant the subject cannot be.
# The arm's test is `s.tag == <the variant's tag>`, and every carrier in this backend has a
# `tag` — so the test COMPILED against the wrong type and compared unrelated numbers. Over a
# `K?` it was worse than wrong: the optional's present-tag is 0 and the first variant's tag
# is 0, so `match K.of(1) { A => … }` took the `A` arm whenever the value was present at all,
# whichever variant it held. `c_variant_tag` answering 0 for a name it does not know made an
# undeclared variant match the same way.
fn c_check_arm_pats(mut &em: Emitter, arms: list[Arm], st: Ty) {
	chk_arm_types(em, arms, st)

	# a subject inference could not name has nothing to check the pattern against; guessing
	# would turn a typing gap into a refusal of a working program
	return if c_is_unknown(st) or c_is_either(st)

	mut i := 0
	for i < arms.len() {
		a := arms[i]
		if a.pat == 3 {
			en := c_variant_enum(em, a.ctor)

			raise f"no variant named `{a.ctor}` — a constructor pattern names a variant of the subject's enum" if en == ""
			raise f"variant pattern `{a.ctor}` cannot match a subject of type {ty_name(st)}" if c_named_of(st) != en

			# HERE and not in c_bind_env, which is a lowering helper: c_arms calls it from
			# both c_arm_cond and c_arm_body, so a check hung there fired twice for every
			# arm but the last — the count of a diagnostic depended on where the arm sat.
			chk_variant_arity(em, a.ctor, a.binds.len(), "pattern binds")
		}
		i = i + 1
	}
}

# c_check_exhaustive refuses a `match` that does not cover its scrutinee. The lowering below
# uses the LAST arm as the final `else` without testing its condition, so a match missing a
# case did not fail — it answered the last arm's body for every value nothing else matched.
# `match k { A => "a"; B => "b" }` over a three-variant enum returned "b" for `C`, and for a
# scrutinee with no enum behind it `match n { 1 => "a"; 2 => "b" }` returned "b" for 3. That
# is a wrong answer with no diagnostic anywhere, which is the one outcome the repo does not
# tolerate; the seed has refused both since it had enums, so this is the shipped compiler
# catching up to it, message included.
#
# A GUARDED arm does not count toward coverage (GRAMMAR:410 — the compiler cannot prove the
# guard holds), so `A if c => …` still leaves `A` uncovered.
fn c_check_exhaustive(mut &em: Emitter, arms: list[Arm], st: Ty) {
	# an unguarded catch-all covers whatever the arms above it did not
	ca := c_catchall_at(arms)
	if ca >= 0 {
		# every arm after it is dead code AND breaks the lowering, which would hand the
		# trailing arm the `else` the catch-all was written to take
		raise "this catch-all arm makes the following arms unreachable" if ca < arms.len() - 1
		return
	}

	# an Either has exactly two sides, and naming both is exhaustive
	if c_is_either(st) {
		raise "non-exhaustive match: missing the Left case" if not c_arm_covers(arms, "Left")
		raise "non-exhaustive match: missing the Right case" if not c_arm_covers(arms, "Right")

		return
	}

	# an enum is exhaustive when every variant is named
	en := c_named_of(st)
	if en != "" and c_name_in(em.enum_names, en) {
		mut i := 0
		for i < em.var_name.len() {
			raise f"non-exhaustive match: missing variant {en}.{em.var_name[i]}" if em.var_enum[i] == en and not c_arm_covers(arms, em.var_name[i])
			i = i + 1
		}
		return
	}

	# a bool has two values, and they are literal arms rather than constructors
	if c_is_bool_ty(st) {
		raise "non-exhaustive match: missing the `true` case" if not c_arm_covers_bool(arms, true)
		raise "non-exhaustive match: missing the `false` case" if not c_arm_covers_bool(arms, false)

		return
	}

	# anything else — an int, a str, a type inference could not name — has a domain no arm
	# list can cover, so it takes a catch-all
	raise "non-exhaustive match: missing a catch-all `_` arm"
}

# c_catchall_at is the index of the first UNGUARDED catch-all arm (`_` or a binding), or -1.
fn c_catchall_at(arms: list[Arm]) -> int {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return i if (a.pat == 1 or a.pat == 2) and not a.has_guard
		i = i + 1
	}
	return 0 - 1
}

# c_arm_covers reports whether some UNGUARDED constructor arm names `ctor`.
fn c_arm_covers(arms: list[Arm], ctor: str) -> bool {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return true if a.pat == 3 and not a.has_guard and a.ctor == ctor
		i = i + 1
	}
	return false
}

fn c_is_bool_ty(t: Ty) -> bool {
	return match t {
		TBool => true
		_     => false
	}
}

# c_arm_covers_bool reports whether some UNGUARDED literal arm names the truth value `v`.
fn c_arm_covers_bool(arms: list[Arm], v: bool) -> bool {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return true if a.pat == 0 and not a.has_guard and c_is_bool_lit(a.lit, v)
		i = i + 1
	}
	return false
}

fn c_is_bool_lit(e: Expr, v: bool) -> bool {
	return match e {
		EBool(b) => b == v
		_        => false
	}
}

fn c_arms(mut &em: Emitter, arms: list[Arm], i: int, s: str, st: Ty, sb: Subst) -> str {
	a := arms[i]
	return c_arm_body(em, a, s, st, sb) if i == arms.len() - 1

	cond := c_arm_cond(em, a, s, st, sb)
	body := c_arm_body(em, a, s, st, sb)
	rest := c_arms(em, arms, i + 1, s, st, sb)
	return f"({cond} ? {body} : {rest})"
}

# c_result_tag is which side of a Result a constructor pattern names. A Result is not a
# declared enum — it has no row in the variant table — so `Left` and `Right` are answered
# here rather than looked up, and anything else is a pattern the type does not have.
fn c_result_tag(ctor: str) -> int {
	return 0 if ctor == "Left"
	return 1 if ctor == "Right"

	raise f"NotImplemented: the pattern `{ctor}` on a Result[T] — it has Left and Right"
}

# c_arm_subst extends sb with an arm's bindings: a bind arm aliases the scrutinee; an enum
# constructor arm aliases each payload name to its `s.u.Var.fK` field access.
fn c_arm_subst(mut &em: Emitter, a: Arm, s: str, st: Ty, sb: Subst) -> Subst {
	return c_extend(sb, a.bind, s) if a.pat == 1
	if a.pat == 3 and c_is_either(st) {
		# `Left(v)` reads the value, `Right(e)` the Err; neither is a tagged union of the
		# kind the variant table describes, so the field is named directly
		return sb if a.binds.len() == 0
		return c_extend(sb, a.binds[0], c_res_ok(s)) if c_result_tag(a.ctor) == 0

		return c_extend(sb, a.binds[0], c_res_err(s))
	}
	if a.pat == 3 {
		en := c_variant_enum(em, a.ctor)
		mut r := sb
		mut i := 0
		for i < a.binds.len() {
			mut acc := f"{s}.u.{a.ctor}.f{i}"
			if c_is_boxed(em, a.ctor, i) {
				# unbox a self-recursive payload back to the enum value
				acc = f"(*(zg_{en}*)zrt_ref_payload({acc}))"
			}
			r = c_extend(r, a.binds[i], acc)
			i = i + 1
		}
		return r
	}
	return sb
}

# c_arm_guard renders a match arm's `if …`. It is one function for the three places that
# render it because a guard is a CONDITION — it lands in a C `&&`, where C's truthiness
# rule would answer a question this language does not ask that way — and three renders
# meant three chances to forget that.
fn c_arm_guard(mut &em: Emitter, a: Arm, sb: Subst) -> str {
	chk_condition(em, a.guard_expr, "a match arm's guard")
	return c_expr(em, a.guard_expr, sb)
}

fn c_arm_cond(mut &em: Emitter, a: Arm, s: str, st: Ty, sb: Subst) -> str {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)
	out := c_arm_cond_in(em, a, s, st, sb)
	c_scope_close(em, outer)
	return out
}

fn c_arm_cond_in(mut &em: Emitter, a: Arm, s: str, st: Ty, sb: Subst) -> str {
	if a.pat == 0 {
		return c_arm_range(em, a, s, st, sb) if c_is_range(a.lit)

		# `A | B =>` is an OR-PATTERN in GRAMMAR and a bitwise-or to this parser, so the arm
		# would be compared against `A | B` folded into one value — matching neither side, and
		# saying nothing about it. Refusing is the repo's rule for exactly this shape: a program
		# the compiler cannot lower is turned away by name rather than emitted wrong.
		raise "NotImplemented: an or-pattern — `|` in a pattern is read as the bitwise operator here, so the arm would match neither side. Write consecutive integers as a range (`1..=2`), or one arm each" if c_is_or_pattern(a.lit)

		# literal pattern: scrutinee equals the literal. The equality is SYNTHESISED here as
		# text rather than built as an EBinary, so it reached no operand rule — and
		# `match x { nil => … }` over an optional lowered to a comparison with 0 exactly as
		# `x == nil` used to, in the file next door. One rule, two spellings.
		chk_binary(em, "==", st, c_infer(em, a.lit))
		return f"({s} == {c_expr(em, a.lit, sb)})"
	}

	if a.pat == 3 {
		mut base := f"({s}.tag == {c_variant_tag(em, a.ctor)})"
		if c_is_either(st) {
			base = f"({c_res_tag(s)} == {c_result_tag(a.ctor)})"
		}
		return f"({base} && {c_arm_guard(em, a, c_arm_subst(em, a, s, st, sb))})" if a.has_guard
		return base
	}
	return c_arm_guard(em, a, c_arm_subst(em, a, s, st, sb)) if a.has_guard
	return "1"
}

# c_range_needs_hi refuses an OPEN-ENDED range where the lowering has no length to put in place
# of the missing bound. `c_range_hi` answers nil there and `c_expr(ENil)` is `"0"`, so the loop
# or the slice silently ran zero times — the shape the arm path now handles deliberately, and
# these two do not handle at all.
fn c_range_needs_hi(e: Expr, what: str) {
	raise "NotImplemented: an open-ended range has no upper bound here — " + what if c_is_range(e) and c_is_nil_expr(c_range_hi(e))
}

# c_arm_range lowers a RANGE arm's test. GRAMMAR defines `200..300 =>` as match-only sugar for
# the guard `_ if _ in 200..300`, so it matches by CONTAINMENT rather than by `equal` — and it
# lowers to the same two comparisons a slice bound does, from the same three accessors.
#
# Reaching this at all used to be an emitter crash. `c_arm_cond` asked `c_expr` for the arm's
# "literal", a range has no value to be, and the answer was the `c_range_unsupported` raise —
# so a form GRAMMAR has had all along was refused with "a range used as a value".
#
# The scrutinee appears twice, which is what `c_match`'s temp is for: an expression scrutinee
# is materialised before the arms are laid out, so nothing is evaluated a second time here.
fn c_is_or_pattern(e: Expr) -> bool {
	return match e {
		EBinary(oper, x, y) => oper == "|"
		_ => false
	}
}

# c_arm_range lowers `1..=2 =>`. Like the literal arm below it, the comparisons are built
# as TEXT and so meet no operand rule of their own — a third spelling of the same equality
# problem, eight lines from the comment that said there were two.
fn c_arm_range(mut &em: Emitter, a: Arm, s: str, st: Ty, sb: Subst) -> str {
	chk_binary(em, ">=", st, c_infer(em, c_range_lo(a.lit)))
	lo := c_expr(em, c_range_lo(a.lit), sb)
	mut base := f"({s} >= {lo})"
	if not c_is_nil_expr(c_range_hi(a.lit)) {
		hi := c_expr(em, c_range_hi(a.lit), sb)
		mut cmp := " < "
		if c_range_incl(a.lit) {
			cmp = " <= "
		}
		base = f"(({s} >= {lo}) && ({s}{cmp}{hi}))"
	} else if c_range_incl(a.lit) {
		# `500..=` is not a range: GRAMMAR gives '..=' a mandatory bound, and the parser
		# reads the missing one as nil rather than saying so
		raise "NotImplemented: `..=` with no upper bound is not a range — write `500..` for open-ended"
	}

	# a guard on a range arm is AND-ed on, the way a constructor pattern's is: the range says
	# which values reach the guard, and the guard has the last word
	return f"({base} && {c_arm_guard(em, a, sb)})" if a.has_guard
	return base
}

# An arm's bindings belong to the ARM. Nothing popped them, so `match b { A(x) => x … }`
# left `x` bound for the rest of the block — shadowing an outer `x` with a name that is a
# SUBSTITUTION into `v.u.A.f0` and never a C variable, so the outer one came back as
# `use of undeclared identifier 'zg_x__2'` from cc. The seed gets this right, which is how
# it was found.
fn c_arm_body(mut &em: Emitter, a: Arm, s: str, st: Ty, sb: Subst) -> str {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)

	# COPIED, because a match used as a value hands its answer to whoever asked. An arm's
	# payload binding is a SUBSTITUTION into the scrutinee's own field, so `mut ys := match
	# b { One(q) => q … }` handed back the enum's own list header and a write through `ys`
	# was read back through `b`. It is the carrier extraction's rule, one shape along.
	out := c_copied(em, c_infer(em, a.body), a.body, c_arm_subst(em, a, s, st, sb))
	c_scope_close(em, outer)
	return out
}

# --- type inference ------------------------------------------------------------

# c_infer_match types a match from its FIRST arm, with that arm's payload bound — which is
# what c_arm_body does before lowering one, and what this did not do before inferring one.
# `xs := match b { One(q) => q … }` answered TUnknown, so the binding it initialised was
# never declared and the error surfaced somewhere else; where the answer was merely WRONG
# rather than unknown, the argument and return checks went blind and cc reported it.
#
# The bindings are popped again: inference must not leave anything behind.
fn c_infer_match(mut &em: Emitter, scrut: Expr, arms: list[Arm]) -> Ty {
	return TUnknown if arms.len() == 0

	return c_infer_arm_body(em, arms[0], c_infer(em, scrut))
}

# c_infer_arm_body types ONE arm's body with that arm's payload bound, and pops it again.
fn c_infer_arm_body(mut &em: Emitter, a: Arm, st: Ty) -> Ty {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)
	t := c_infer(em, a.body)
	c_scope_close(em, outer)
	return t
}

fn c_infer(mut &em: Emitter, e: Expr) -> Ty {
	return match e {
		EInt(_) => TInt
		EFloat(_) => TFloat
		EStr(_) => TStr
		EBool(_) => TBool
		ENil => TNil
		EIdent(n) => c_infer_ident(em, n)
		EUnary(oper, x) => c_infer_unary(em, oper, x)
		EBinary(oper, a, b) => c_infer_binary(em, oper, a, b)
		ECall(name, args) => c_infer_call(em, name)
		EField(target, fld) => c_field_ty_of(em, target, fld)
		EOptChain(target, fld) => c_optchain_ty(em, target, fld)
		ETry(x) => c_carrier_elem(c_infer(em, x))
		EIndex(target, idx) => c_elem_ty(em, target, idx)
		EMethod(target, meth, args) => c_infer_methcall(em, target, meth)
		EListLit(elems) => c_infer_listlit(em, elems)
		EConv(ty, x, nm) => ty
		EIf(cond, then_e, else_e) => c_infer(em, then_e)
		EMatch(scrut, arms) => c_infer_match(em, scrut, arms)
		ERange(lo, hi, inclusive) => TUnknown
		ETuple(elems) => c_tuple_ty(em, elems)
		EMapLit(ks, vs) => c_map_lit_ty(em, ks, vs)
		EFn(ps, has_ret, ret, body) => c_lambda_ty(ps, has_ret, ret)
		EChanNew(t, cap) => TChan(t, 0)
		ERecv(ch) => TOpt(ty_chan_elem(c_infer(em, ch)))
		EForce(x) => c_carrier_elem(c_infer(em, x))
		ECoalesce(a, b, jump) => c_infer_coalesce(em, a, b)
		EGuard(body) => TEither(c_guard_elem(c_guard_val_ty(em, body)), TErr)
		EIs(x, name) => TBool
	}
}

# c_infer_methcall types a method call from the SAME decision c_method lowers it by, so
# the two cannot disagree about what a call is. Typing it off the receiver is what makes a
# CHAIN work — the target of `.b()` in `a.b().c()` is itself a method call, so this
# recurses and each link is typed from the one before it.
# c_infer_coalesce types `a ?? b`. The value is a's payload OR b, so when the fallback is
# itself an optional the whole expression still is one — which is what makes the chain
# `a ?? b ?? 7` right-associate into a value rather than into a type nothing can name.
fn c_infer_coalesce(mut &em: Emitter, a: Expr, b: Expr) -> Ty {
	tb := c_infer(em, b)
	return tb if c_is_opt(tb)
	return c_carrier_elem(c_infer(em, a))
}

fn c_infer_methcall(mut &em: Emitter, target: Expr, meth: str) -> Ty {
	# `E.of(n)` is partial, so it answers `E?` — see c_enum_of
	en := c_ident_name(target)
	if en != "" and c_name_in(em.enum_names, en) {
		return TOpt(TNamed(en)) if meth == "of"

		# `Shape.Line(5)` is a value of `Shape`. It is total where `of` is partial: the
		# variant is named rather than looked up, so there is nothing to fail.
		return TNamed(en) if c_is_variant(em, meth) and c_variant_enum(em, meth) == en
	}

	tty := c_infer(em, target)
	recv := c_named_of(tty)
	return match c_meth_kind(em, tty, meth) {
		MList    => c_list_method_ret(meth)
		MMap     => c_map_method_ret(meth)
		MRecv    => c_lookup_sig_ret(em, c_sig_key(recv, meth))
		MFnField => c_fn_ret(c_field_ty(em, recv, meth))
		_        => c_lookup_sig_ret(em, meth)
	}
}

# c_elem_ty is what `x[i]` yields: a map indexes to its VALUE type, a list to its element.
fn c_elem_ty(mut &em: Emitter, target: Expr, idx: Expr) -> Ty {
	t := c_infer(em, target)

	# a slice is the same kind of container as what it came from
	return t if c_is_range(idx)
	return c_map_val_ty(t) if c_is_map(t)

	return c_list_elem(t)
}

# c_list_method_rv is a list method on an RVALUE: bind it, then call the method on the
# binding, so the whole thing is still one expression.
fn c_list_method_rv(mut &em: Emitter, target: Expr, meth: str, args: list[Expr], tty: Ty, sb: Subst) -> str {
	src := c_expr(em, target, sb)
	inner := c_list_method_on(em, "zgt_rv", meth, args, tty, sb)
	return "({ zrt_list zgt_rv = " + src + "; " + inner + "; })"
}

fn c_map_method_ret(meth: str) -> Ty {
	return TInt if meth == "len"
	return TBool if meth == "has"

	return TNil
}

fn c_list_method_ret(meth: str) -> Ty {
	return TInt if meth == "len"
	raise f"NotImplemented: the list method `{meth}` — this compiler has `len` and `append`" if meth != "append"

	return TNil
}

fn c_infer_call(mut &em: Emitter, name: str) -> Ty {
	return c_intrinsic_ret(name) if c_is_intrinsic(name)
	return TNamed(c_variant_enum(em, name)) if c_is_variant(em, name)

	# a BUILT-IN ERROR constructor answers an `Err`, not a type of its own name. It reads as
	# a constructor and it is PascalCase, so the ctor rule below would have typed
	# `e := ValueError("x")` as `zg_ValueError` — a C type nobody declares, which cc reported
	# against generated code the programmer cannot open. The whole taxonomy is one runtime
	# type with a kind tag, which is what makes `e is ValueError` a comparison rather than a
	# cast, and what lets a bound Err be re-raised or handed to `from`.
	return TErr if c_err_kind(name) > 0
	return TNamed(name) if c_is_ctor(name)

	# A BINDING HOLDING A FUNCTION answers the function type's result. `g := double; n :=
	# g(21)` typed the call from the SIGNATURE table, which has no `g` in it, so the answer
	# was unknown, `n` was never declared, and the error arrived at the next line as
	# `undefined name n`. A binding always wins over a declared name here, which is the
	# ordinary scoping rule and the one c_ident already follows.
	bt := c_lookup_var(em, name)
	return c_fn_ret(bt) if c_is_fn(bt)

	return c_lookup_sig_ret(em, name)
}

# c_is_intrinsic reports whether a name is a runtime intrinsic (a __zrt_ primitive).
fn c_is_intrinsic(name: str) -> bool {
	b := list[byte](name)
	return false if b.len() < 2
	return b[0] == b'_' and b[1] == b'_'
}

# c_intrinsic maps a __zrt_ intrinsic to its runtime C symbol.
fn c_intrinsic(name: str) -> str {
	return "zrt_write_str" if name == "__zrt_write"
	return "zrt_read_fd" if name == "__zrt_read"

	b := list[byte](name)
	mut out: list[byte] = []
	mut i := 2
	for i < b.len() {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# c_intrinsic_ret gives the result type of the intrinsics the compiler's I/O uses.
# c_intrinsic_ret is what a runtime leaf answers. An intrinsic carries NO SIGNATURE — it
# is a name the emitter lowers directly — so this table is the only place its result type
# is written down, and an entry missing here is a leaf this compiler believes answers
# nothing. That was harmless while nothing compared types and stopped being harmless the
# moment `chk_fits` did: `a: str = __zrt_arch()` became "cannot bind nil to a str binding",
# for a leaf that has returned a `const char *` since it was written.
#
# Every leaf whose result a program BINDS belongs here. The fallback stays `TNil` rather
# than TUnknown because that is what a leaf answering nothing really is, and the emitter
# reads it as such; a leaf that answers something and is missing is a bug in this table,
# which is now a bug that a binding will report.
fn c_intrinsic_ret(name: str) -> Ty {
	return TList(TByte) if name == "__zrt_read"
	return TList(TStr) if name == "__zrt_listdir"
	return TInt if name == "__zrt_open" or name == "__zrt_exec" or name == "__zrt_proc_spawn" or name == "__zrt_proc_wait"
	return TInt if name == "__zrt_open_write"
	return TInt if name == "__zrt_time_unix" or name == "__zrt_time_mono"
	return TInt if name == "__zrt_atomic_load" or name == "__zrt_atomic_store" or name == "__zrt_atomic_swap" or name == "__zrt_atomic_add"
	return TStr if name == "__zrt_getenv" or name == "__zrt_arch" or name == "__zrt_platform" or name == "__zrt_exe_path"
	return TBool if name == "__zrt_has_env" or name == "__zrt_exists" or name == "__zrt_mkdir" or name == "__zrt_atomic_cas"

	return TNil
}

# c_infer_listlit types a list literal from its FIRST element. An empty one names no
# element type at all, so it stays unknown and takes the type of whatever it initializes.
fn c_infer_listlit(mut &em: Emitter, elems: list[Expr]) -> Ty {
	return TUnknown if elems.len() == 0
	return TList(c_infer(em, elems[0]))
}

fn c_infer_ident(mut &em: Emitter, n: str) -> Ty {
	return TNamed(c_variant_enum(em, n)) if c_is_variant(em, n)
	t := c_lookup_var(em, n)

	# nothing bound the name, but a function answers to it: the name IS that function
	return c_fn_ty_of(em, n) if c_is_unknown(t) and c_is_free_fn(em, n)
	return t
}

fn c_infer_unary(mut &em: Emitter, oper: str, x: Expr) -> Ty {
	return TBool if oper == "not"
	return c_infer(em, x)
}

fn c_infer_binary(mut &em: Emitter, oper: str, a: Expr, b: Expr) -> Ty {
	return TBool if c_is_bool_op(oper)

	# `//` is the language's ONE integer division, spelled so the reader sees an integer
	# whatever the operands are (docs/core/types.md) — so it answers `int` before the
	# float and byte rules below get a say. That IS the operator.
	return TInt if oper == "//"
	return TStr if oper == "+" and c_is_str(c_infer(em, a))
	return TFloat if c_is_float(c_infer(em, a)) or c_is_float(c_infer(em, b))

	# BYTE ARITHMETIC STAYS IN BYTE. `mut n := b'a'; n = n + 1` is the ordinary thing to
	# write and `n + 1` typed `int`, so nothing could be stored back — a type with no
	# arithmetic out of it and no way in. Answering `byte` is what lets the value return to
	# where it came from, and it is why a narrowing `int` -> `byte` is NOT a fit: nothing
	# needs one, and admitting it turned `take(1000)` on a `byte` parameter into a silent
	# truncation that cc warned about in generated C.
	return TByte if c_is_byte(c_infer(em, a)) and not c_is_float(c_infer(em, b))

	return TInt
}

# --- statement emission --------------------------------------------------------

fn c_stmt(mut &em: Emitter, s: Stmt, ind: str) -> str {
	return match s {
		SLet(name, ty, has_type, is_mut, ival) => c_let(em, name, ty, has_type, is_mut, ival, ind)
		SAssign(lhs, rhs) => c_assign(em, lhs, rhs, ind)
		SPrint(e) => c_print(em, e, ind)
		SReturn(has_val, e) => c_return(em, has_val, e, ind)
		SReturnIf(val, cond) => c_return_if(em, val, cond, ind)
		SExpr(e) => c_expr_stmt(em, e, ind)
		SIf(cond, then_body, has_else, else_body) => c_if(em, cond, then_body, has_else, else_body, ind)
		SIfLet(name, value, then_body, has_else, else_body) => c_iflet(em, name, value, then_body, has_else, else_body, ind)
		SFor(has_cond, cond, body) => c_for(em, has_cond, cond, body, ind)
		SForIn(var, iter, body) => c_forin(em, var, iter, body, ind)
		SRaise(x, hc, c) => c_raise(em, x, hc, c, ind)
		SDefer(x) => c_defer(em, x, ind)
		SSpawn(x) => c_spawn(em, x, ind)
		SSend(ch, v) => c_send(em, ch, v, ind)
		SSelect(arms) => c_select(em, arms, ind, false)
		SForSelect(arms) => c_for_select(em, arms, ind)
		SDel(n) => c_del(em, n, ind)
		SClose(ch, at_exit) => c_close(em, ch, at_exit, ind)
		SBreak => c_jump(em, "break", ind)
		SContinue => c_jump(em, "continue", ind)
		SNop => ""

		# a marker, not a statement: it records where the next one starts and emits nothing
		SAt(l, c) => c_at(em, l, c)
	}
}

# c_expr_stmt lowers a bare expression statement. A `guard` in statement position is a
# guard whose Result nobody reads — which is legal, and is what `guard { risky() }` means —
# but the C it lowers to is a statement expression, and one whose value is discarded draws
# a -Wunused-value. Writing the discard down as a cast says the same thing to the reader
# and keeps the build log free of nine warnings nobody should have to learn to ignore.
# c_at records the position the SAt marker carries, and hands cc the same answer as a
# `#line` directive.
#
# That directive is what makes the C a DETAIL rather than a place a programmer has to go.
# Everything downstream of this compiler — a cc diagnostic about generated C, a debugger
# stopping in it, a profiler naming a function — spoke in terms of a file under
# `.zerg-cache` that nobody wrote. With `#line` they all name the `.zg` the person is
# editing, for the cost of one directive per statement.
#
# It must start at column 0, and it is emitted with a newline on BOTH sides rather than
# only after: a `guard` lowers to a GNU statement-expression that puts its statements
# inline, so a directive with no leading break landed mid-line and cc read it as an
# expression. A statement whose C spans several lines has only its
# first line mapped exactly; the rest are attributed to the lines after it, which is the
# ordinary trade every transpiler that emits these makes.
#
# A source with no path gets no directive: pointing cc at "" would be worse than leaving it
# pointing at the C it can actually open.
fn c_at(mut &em: Emitter, l: int, c: int) -> str {
	em.at_line = l
	em.at_col = c
	return "" if em.at_path == ""
	ls := strconv.to_string(l, 10)
	return f"\n#line {ls} \"{em.at_path}\"\n"
}

fn c_expr_stmt(mut &em: Emitter, e: Expr, ind: str) -> str {
	rendered := c_expr(em, e, c_nosub())
	return f"{ind}(void)({rendered});\n" if c_is_guard(e)
	return f"{ind}{rendered};\n"
}

fn c_is_guard(e: Expr) -> bool {
	return match e {
		EGuard(_) => true
		_         => false
	}
}

fn c_is_listlit(e: Expr) -> bool {
	return match e {
		EListLit(_) => true
		_           => false
	}
}

# c_is_empty_listlit is `[]` and only `[]` — the literal that carries no element type and
# needs one from the declaration it initializes. A literal WITH elements carries both.
fn c_is_empty_listlit(e: Expr) -> bool {
	return match e {
		EListLit(elems) => elems.len() == 0
		_ => false
	}
}

# c_assign lowers `lhs = rhs`. Re-assigning a list literal to a name re-initialises the
# list (leak-style: the old buffer is abandoned); otherwise the lhs (a name, field, or
# index) is emitted as a C lvalue.
fn c_assign(mut &em: Emitter, lhs: Expr, rhs: Expr, ind: str) -> str {
	chk_assignable(em, lhs)

	# `m[k] = v` INSERTS, so it is a set rather than a store through the index
	if c_is_index(lhs) {
		tt := c_infer(em, c_index_target(lhs))
		if c_is_map(tt) {
			em.used_rt = true
			return c_map_set(em, c_index_target(lhs), c_index_key(lhs), rhs, tt, ind)
		}
	}
	lt := c_infer(em, lhs)
	chk_assigned(em, lhs, lt, rhs)
	lv := c_lvalue(em, lhs, c_nosub())

	# assigning INTO an optional takes the same wrap a declaration does: `x = nil` makes it
	# absent, `x = 5` present. Without it the C compiler saw an int where a carrier goes.
	return f"{ind}{lv} = {c_carrier_fit(em, lt, rhs, c_nosub())};\n" if c_is_carrier(lt)
	if c_is_list(lt) and c_is_listlit(rhs) {
		# re-init the (name or field) list to empty, then push any literal elements
		em.used_rt = true
		et := c_type(c_list_elem(lt))
		mut out := f"{ind}zrt_list_init(&({lv}), sizeof({et}), &{c_elem_vt(em, c_list_elem(lt))});\n"
		return out + c_pushes(em, f"({lv})", et, rhs, ind)
	}

	# Every other assignment copies through the one rule — including a list, which used to
	# have its own branch here saying the same thing a second way.
	return f"{ind}{lv} = {c_copied(em, lt, rhs, c_nosub())};\n"
}

# c_elem_exprs renders a list literal's elements AT the element type the declaration gives,
# and in the CURRENT scope — before a binding that would shadow one of the names they
# mention enters it.
# Rendering them at their own types put a bare int into a slot whose C type is an optional's
# carrier — `xs: list[int?] = [nil, 1]` — so the tag it was read back through was whatever
# the value's first bytes happened to be, when it compiled at all.
fn c_elem_exprs(mut &em: Emitter, lit: Expr, elem: Ty) -> list[str] {
	mut out: list[str] = []
	match lit {
		EListLit(elems) => c_elem_exprs_into(em, elems, elem, out)
		_ => c_skip()
	}
	return out
}

fn c_elem_exprs_into(mut &em: Emitter, elems: list[Expr], elem: Ty, mut &out: list[str]) {
	for e in elems {
		out.append(c_fit_copied(em, elem, e, c_nosub()))
	}
}

fn c_skip() {
	nop
}

# c_pushes_strs assembles the pushes from already-rendered element expressions.
fn c_pushes_strs(target: str, et: str, vals: list[str], ind: str) -> str {
	mut out := ""
	for v in vals {
		out = out + ind + "{ " + et + " zgt_le = " + v + "; zrt_list_push(&" + target + ", &zgt_le); }\n"
	}
	return out
}

# c_pushes emits a zrt_list_push per element of a list literal.
fn c_pushes(mut &em: Emitter, target: str, et: str, lit: Expr, ind: str) -> str {
	return match lit {
		EListLit(elems) => c_pushes_of(em, target, et, elems, ind)
		_ => ""
	}
}

fn c_pushes_of(mut &em: Emitter, target: str, et: str, elems: list[Expr], ind: str) -> str {
	mut out := ""
	mut i := 0
	for i < elems.len() {
		out = out + ind + "{ " + et + " zgt_le = " + c_expr(em, elems[i], c_nosub()) + "; zrt_list_push(&" + target + ", &zgt_le); }\n"
		i = i + 1
	}
	return out
}

# c_const_globals declares each module constant as a C global and records its type, so
# c_reset_env can put it in scope. The VALUE is not written here: a C global's initializer
# must be a constant expression and `const s = "a" + "b"` is not one, so the assignment
# goes into main alongside the init() calls — which is also what makes the order defined.
# A module constant is ONE object, not one per unit. Every unit used to emit `static` for
# every constant in the program, and the assignment was emitted only in the unit that has
# `main` and only for the constants that unit declares — so a constant declared in an
# imported module was never assigned ANYWHERE and every reader saw a zero. `lib.LIMIT` and
# the `pub fn limit()` written to work around it both answered 0, silently, and `--emit c`
# and `--emit bin` disagreed because the single-unit path has no other unit to be wrong in.
#
# The unit that DECLARES it defines it; every other unit declares it `extern`. `whole` is
# the single-unit build, where own IS the program and `static` is right.
fn c_const_globals(mut &em: Emitter, f: File, own: File, whole: bool) -> str {
	mut out := ""
	for c in f.consts {
		name := c_let_name(c)

		# Every module flattens into ONE namespace, so two that declare the same constant
		# mangle to one symbol. The FUNCTION case has been refused by name since the tables
		# were written; this one linked — two definitions of `zg_N`, tolerated by a linker
		# that still allows a common symbol — and the reader got whichever the linker chose.
		# On a toolchain with `-fno-common` it is a duplicate symbol instead.
		raise f"NotImplemented: two modules both define `{name}` — this compiler flattens every module into one namespace, so the two cannot be told apart" if c_name_in(em.k_names, name)

		ty := c_infer(em, c_let_value(c))
		em.k_names.append(name)
		em.k_tys.append(ty)
		if whole {
			out = out + f"static {c_type(ty)} zg_{name};\n"
		} else if c_const_in(own, name) {
			out = out + f"{c_type(ty)} zg_{name};\n"
		} else {
			out = out + f"extern {c_type(ty)} zg_{name};\n"
		}
	}
	return out
}

fn c_const_in(f: File, name: str) -> bool {
	for c in f.consts {
		return true if c_let_name(c) == name
	}
	return false
}

# c_const_assigns is the constants' values, assigned before any init() runs.
fn c_const_assigns(mut &em: Emitter, f: File) -> str {
	mut out := ""
	for c in f.consts {
		out = out + f"    zg_{c_let_name(c)} = {c_expr(em, c_let_value(c), c_nosub())};\n"
	}
	return out
}

fn c_let_name(s: Stmt) -> str {
	return match s {
		SLet(n, _, _, _, _) => n
		_ => ""
	}
}

fn c_let_value(s: Stmt) -> Expr {
	return match s {
		SLet(_, _, _, _, v) => v
		_ => ENil
	}
}

# c_init_calls is the `init()` invocations main opens with, in declaration order.
fn c_init_calls(f: File) -> str {
	mut out := ""
	for fd in f.fns {
		if is_init_name(fd.name) {
			out = out + "    zg_" + fd.name + "();\n"
		}
	}
	return out
}

# --- concurrency ----------------------------------------------------------------
#
# A channel is the runtime's zrt_chan by pointer, and the three operations map onto the
# runtime one for one. Both send and receive need the value's ADDRESS — the runtime
# copies elemsz bytes through it — so each goes through a temp: a literal has no
# address, and neither does a call result.
#
# A receive yields a real `Result[T]` on the carrier above, so every operator that reads
# a Result back — `!`, `??`, `if v := <-ch`, `match <-ch { Left … Right … }` — works on a
# receive with no channel-specific code behind it. It also means a close can say WHY:
# there is somewhere to put "no value, and here is the reason", which a bare `T` had not.
fn c_chan_new(mut &em: Emitter, t: Ty, cap: Expr, sb: Subst) -> str {
	em.used_rt = true
	em.used_conc = true
	c_chan_elem_check(t)
	return f"zrt_chan_new(sizeof({c_type(t)}), (size_t)({c_expr(em, cap, sb)}))"
}

# c_chan_elem_check refuses `chan[T?]`, and it is the price of the receive answering `T?`.
# `T?` does not nest, so a receive on a channel of optionals would answer nil for two
# different facts — "the value that was sent is absent" and "the stream is over" — with no
# way to tell them apart. One loud rule is worth more than that ambiguity; a value that
# might be absent travels in a struct, or as a sentinel the receiver agrees on.
fn c_chan_elem_check(t: Ty) {
	raise "a channel of optionals is refused — a receive answers `T?`, so `nil` would mean both the value and the end of the stream. Wrap it in a struct, or send a sentinel" if c_is_opt(t)
}

# --- channel direction ------------------------------------------------------------
#
# A direction is a purely COMPILE-TIME property: `chan[T]`, `chan[T]<-` and `<-chan[T]`
# are all one `zrt_chan*`, so nothing below decides a C type. What it decides is two
# things — which operations a name may perform, and which of the runtime's two reference
# counts a handle joins when it is handed over (c_spawn, c_del).

# c_chan_dir is a channel end's direction: 0 bidirectional, 1 send-only (`chan[T]<-`),
# 2 receive-only (`<-chan[T]`). Anything that is not a channel answers 0, so a caller may
# ask without testing first.
fn c_chan_dir(t: Ty) -> int {
	return match t {
		TChan(_, d) => d
		_           => 0
	}
}

# c_chan_dir_ok reports whether an end of direction `have` may fill a slot declared
# `want`. Narrowing is the spec's one-way built-in upcast: a bidirectional end becomes
# either single direction, and a single direction never goes back and never crosses.
fn c_chan_dir_ok(have: int, want: int) -> bool {
	return true if want == have
	return true if have == 0

	return false
}

# c_chan_check is the narrowing check at every place a channel end fills a declared slot:
# a call argument, a `return`, a typed binding, a struct or variant field. It emits
# nothing — a direction costs no code — so this is the whole of it.
fn c_chan_check(have: Ty, want: Ty, site: str) {
	raise f"a channel direction only narrows: a {ty_name(have)} cannot fill a {ty_name(want)} ({site})" if ty_is_chan(have) and ty_is_chan(want) and not c_chan_dir_ok(c_chan_dir(have), c_chan_dir(want))
}

# c_chan_op_check is the OTHER half of a direction: not where a handle may go, but what a
# name may DO with one. `op` numbers the operation the way c_chan_dir numbers the ends —
# 0 receive, 1 send, 2 close — and each refusal is worded exactly once here, for the six
# lowering sites that ask: `<-ch`, `ch <- v`, `close(ch)`, both kinds of `select` arm, and
# `for v in ch`. A seventh gets the wording rather than a paraphrase of it.
fn c_chan_op_check(t: Ty, op: int) {
	dir := c_chan_dir(t)
	if op == 0 and dir == 1 {
		# the guarantee the send-only end exists for: it cannot receive (steal) values
		raise "cannot receive on a send-only " + ty_name(t)
	}

	raise "cannot send on a receive-only " + ty_name(t) if op == 1 and dir == 2
	raise f"cannot close a receive-only channel {ty_name(t)}: a consumer may not end a stream on the producers' behalf" if op == 2 and dir == 2
}

# --- what a direction does to the two reference counts -----------------------------
#
# The runtime keeps two counts on a channel (src/runtime/csrc/chan.c): `rc`, the holder
# count, whose last holder frees the object; and `senders`, the count of SEND-CAPABLE
# holders, whose reaching zero is what CLOSES the channel. There are two pairs of
# operations over them:
#
#     zrt_chan_copy(c)            rc++
#     zrt_chan_release(c)         rc--                       (frees at zero)
#     zrt_chan_sender_copy(c)     rc++, senders++
#     zrt_chan_sender_release(c)  senders--  (closes at zero), then rc--
#
# So per-direction counting is not a new mechanism — it is choosing which pair to call.
# A handle's direction says whether it is send-capable, and therefore whether it counts
# toward the close:
#
#   handle's direction        handed over (copy)     that handle dropped (release)
#   ------------------------  ---------------------  ------------------------------
#   bidirectional chan[T]     zrt_chan_sender_copy   zrt_chan_sender_release
#   send-only     chan[T]<-   zrt_chan_sender_copy   zrt_chan_sender_release
#   receive-only  <-chan[T]   zrt_chan_copy          zrt_chan_release
#
# Now the paths an end can travel, and what each does:
#
#   a BINDING            takes a reference of its OWN, by its own direction, and gives it
#                        back when its scope ends (c_let_chan registers it on the
#                        pending-release list; c_release_from is what spends it). An
#                        initializer naming existing storage is copied; a freshly built
#                        handle already carries exactly one reference and is taken over.
#                        This is what makes "close early by narrowing the scope" work with
#                        no statement at all.
#   a `spawn` argument   a handle is duplicated, and its direction is the CALLEE
#                        PARAMETER's, not the caller variable's — that is the whole point:
#                        `spawn consumer(ch)` where consumer takes a `<-chan[T]` must not
#                        add a sender. Copy on capture, release in the spawn thunk's defer
#                        (which runs on the crash path too).
#   a plain call argument  no copy and no release. The callee borrows the caller's handle
#                        for the duration of a call the caller is blocked inside, so the
#                        counts cannot move under it and there is nothing to balance.
#   a parameter          same: it is the borrowed handle, dropped by doing nothing.
#   a return             the handle travels out, so it carries a reference of its own,
#                        taken by the RETURN TYPE's direction — and then this frame's own
#                        bindings are released, as on any other exit.
#   `del name`           nothing at all. It REVOKES the name and no count moves, because
#                        the binding it names is on the pending-release list and its scope
#                        will give the reference back whether or not it was revoked.
#
# The single rule underneath all of it: a count moves only where a HANDLE moves, and every
# handle has exactly one owner.

fn c_chan_copy_fn(dir: int) -> str {
	return "zrt_chan_copy" if dir == 2
	return "zrt_chan_sender_copy"
}

fn c_chan_release_fn(dir: int) -> str {
	return "zrt_chan_release" if dir == 2
	return "zrt_chan_sender_release"
}

fn c_recv(mut &em: Emitter, ch: Expr, sb: Subst) -> str {
	em.used_rt = true
	em.used_conc = true
	cty := c_infer(em, ch)

	c_chan_op_check(cty, 0)
	elem := ty_chan_elem(cty)
	return f"{c_recv_helper(em, elem)}({c_expr(em, ch, sb)})"
}

# c_recv_helper registers one element type's receive helper and answers its name.
#
# There has to be a helper because the runtime reports closure through zrt_chan_recv's
# RETURN value while writing the element through a pointer, and a C expression can be one
# of those or the other, not both. The helper is where the two become one `Result[T]`.
#
# A CLEAN close is an ABSENCE and a CRASH close is a FAILURE, and the language already has
# a different answer for each: `T?` for the first, `raise` for the second. So the receive
# hands back `T?` — nil once the stream is over, and over for good — while a crash close
# raises the producer's own Err, message, cause and kind intact.
#
# That split is what makes the reason impossible to drop. A Result made the caller ask
# WHICH kind of Right it had before it could tell "the stream ended" from "the producer
# died"; anyone who forgot lost the death. Here the two cannot be confused, because they
# do not arrive by the same route.
fn c_recv_helper(mut &em: Emitter, elem: Ty) -> str {
	cn := c_opt_name(em, elem)
	name := "zg_recv_" + c_ident_safe(c_type(elem))
	return name if c_name_in(em.rcv_names, name)
	em.rcv_names.append(name)
	mut d := "static " + cn + " " + name + "(zrt_chan *ch) {\n"
	d = d + "    " + cn + " r = {0};\n"
	d = d + "    " + c_res_tag("r") + " = (int32_t)zrt_chan_recv(ch, &" + c_res_ok("r") + ");\n"
	d = d + "    if (" + c_res_is_right("r") + ") {\n"
	d = d + "        zrt_err e = zrt_chan_close_err(ch);\n"
	d = d + "        if (e.kind != ZRT_ERR_STOP_ITERATION) { zrt_raise_err(e); }\n"
	d = d + "    }\n"
	d = d + "    return r;\n}\n"
	em.rcv_decls.append(d)
	return name
}

# c_send lowers `ch <- v`. The payload is SNAPSHOTTED at the send (docs/code/coroutine.md,
# the Send table), which for anything holding a list means a deep copy and not a C `=`:
# the runtime memcpy's the bytes it is handed, so handing it the sender's own list handle
# gave the receiver a second name for the sender's buffer. Writing through either was then
# visible through the other — across a coroutine boundary, which is the one place the whole
# memory model says cannot happen ("no shared mutable Zerg state").
#
# c_copied is the same rule every other copy site uses, and it costs nothing where nothing
# is shared: a scalar, or a freshly built value that is nobody else's yet, renders as
# itself.
fn c_send(mut &em: Emitter, ch: Expr, v: Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true
	cty := c_infer(em, ch)
	c_chan_op_check(cty, 1)

	elem := ty_chan_elem(cty)
	ct := c_type(elem)
	mut sv := c_fit_copied(em, elem, v, c_nosub())
	if c_is_opt(elem) {
		sv = c_carrier_fit(em, elem, v, c_nosub())
	}
	return ind + "{ " + ct + " zgt_sv = " + sv + "; zrt_chan_send(" + c_expr(em, ch, c_nosub()) + ", &zgt_sv); }\n"
}

# c_spawn lowers `spawn f(args)`. It is the same shape as a defer — a per-site env
# struct and a thunk that unpacks it — with two differences: the env outlives the
# statement, so it is heap-allocated and freed by the thunk, and the call runs on a
# coroutine of its own rather than at scope exit.
fn c_spawn(mut &em: Emitter, x: Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true

	cal := c_callee_of(em, x, "spawn")
	args := cal.args
	idx := em.dfn_n
	em.dfn_n = idx + 1
	tag := strconv.to_string(idx, 10)
	if args.len() == 0 {
		em.dfn_decls.append("static void zg_spawn_" + tag + "(void *p) { (void)p; " + cal.cname + "(); }\n")
		return f"{ind}zrt_spawn(zg_spawn_{tag}, NULL);\n"
	}

	# ONE pass over the arguments for everything the env struct needs to know: each one's
	# type, its field, its place in the call, and — for a channel — the direction it is
	# captured and released at. Each answer is asked for once. Nothing here renders an
	# argument's VALUE: c_expr mutates the emitter, so a pass whose strings are discarded
	# still bumps the temp counter, registers carriers and can append a whole static
	# function nobody calls. The values are rendered exactly once, below.
	#
	# A channel argument is a HANDLE, not a value: the coroutine gets its own handle and
	# drops it when it returns. Without that the channel's counts never move and it can
	# never close — every `for select` waits forever.
	#
	# WHICH handle is decided by the CALLEE PARAMETER's direction, not by the caller's
	# variable. A consumer declared `<-chan[T]` takes a holder and not a sender, so it does
	# not hold the channel open; before this every spawned argument took a sender, and a
	# consumer you spawned counted as a producer that never finished. `dirs` carries that
	# direction per argument, or -1 for an argument that is not a channel at all.
	mut fields := ""
	mut call := ""
	mut drops := ""
	mut dirs: list[int] = []
	mut i := 0
	for i < args.len() {
		fi := "f" + strconv.to_string(i, 10)
		at := c_infer(em, args[i])
		fields = fields + " " + c_type(at) + " " + fi + ";"
		if i > 0 {
			call = call + ", "
		}
		call = call + "e->" + fi
		mut dir := 0 - 1
		if ty_is_chan(at) {
			dir = c_chan_dir(c_param_ty(em, cal.key, i))
			drops = drops + " " + c_chan_release_fn(dir) + "(e->" + fi + ");"
		}
		dirs.append(dir)
		i = i + 1
	}
	em.dfn_decls.append("typedef struct {" + fields + " } zg_spawnenv_" + tag + ";\n")

	# The teardown is a DEFER, not a statement after the call, because a coroutine can
	# leave without returning. An unhandled abort longjmps straight past everything
	# following the call, and what got skipped was the sender release — so the channel
	# kept a sender that no longer existed, never reached zero, never closed, and every
	# receiver waiting on it blocked forever. A crash became a deadlock.
	#
	# A defer runs on both exits, which is exactly the difference: on the ordinary one it
	# is the coroutine giving up its handles, and on the crash one it is what lets the
	# close carry the crash Err a receiver is meant to see (Fork-C).
	dropfn := "zg_spawndrop_" + tag
	mut dd := "static void " + dropfn + "(void *p) { zg_spawnenv_" + tag + " *e = (zg_spawnenv_" + tag + "*)p; (void)e;"
	dd = dd + drops + " zrt_free(p); }\n"
	em.dfn_decls.append(dd)
	mut th := "static void zg_spawn_" + tag + "(void *p) { zg_spawnenv_" + tag + " *e = (zg_spawnenv_" + tag + "*)p;"
	th = th + " zrt_defer(" + dropfn + ", p);"
	th = th + " " + cal.cname + "(" + call + "); }\n"
	em.dfn_decls.append(th)
	mut out := f"{ind}zg_spawnenv_{tag} *zgt_se{tag} = (zg_spawnenv_{tag}*)zrt_alloc(sizeof(zg_spawnenv_{tag}));\n"
	mut j := 0
	for j < args.len() {
		mut v := c_captured(em, cal.key, j, args[j])
		if dirs[j] >= 0 {
			v = f"{c_chan_copy_fn(dirs[j])}({v})"
		}
		out = out + ind + "zgt_se" + tag + "->f" + strconv.to_string(j, 10) + " = " + v + ";\n"
		j = j + 1
	}
	return f"{out}{ind}zrt_spawn(zg_spawn_{tag}, zgt_se{tag});\n"
}

# c_close lowers `close(ch)` — the one built-in a channel has. It marks the CHANNEL
# no-longer-sendable. That is a property of the channel and not of a holder, so it moves
# no count: `ch` keeps its reference and stays readable, a receive drains what is buffered
# and then answers the Right, and closing an already-closed channel changes nothing. One
# runtime call is the whole lowering.
#
# It does NOT replace auto-close, which stays the everyday shape — a producer closes by
# FINISHING. Two things depend on that and a flag cannot do either: a crashing producer
# never reaches a `close` call, and its unwind is what carries the crash Err to the
# receiver; and four producers fanning into one channel need no coordination because the
# last one to return closes it. A channel-level close called by one of them would end the
# stream for its siblings, which is the footgun this language was designed around. `close`
# is the conditional, early form: end this stream before my scope does.
#
# Two refusals, and both are bugs the type system can catch: a non-channel has no send end
# at all, and a receive-only end must not be able to end a stream on the producers' behalf.
#
# `at_exit` is `defer close(ch)`: the same close, at the enclosing block's exit. It goes
# through the ORDINARY defer machinery, because c_close_callee makes the close look like
# any other call — which is the whole reason `close` is a statement node rather than an
# intercepted ECall. As a call it had no symbol to put in a thunk's env, so `defer`,
# `spawn` and every other position a call can reach each needed a refusal of its own.
fn c_close(mut &em: Emitter, ch: Expr, at_exit: bool, ind: str) -> str {
	cal := c_close_callee(em, ch)
	return c_defer_of(em, cal, ind) if at_exit
	return f"{ind}{cal.cname}({c_expr(em, ch, c_nosub())});\n"
}

# c_close_callee is `close(ch)` as a CALLEE — the runtime function and its one argument —
# after the two checks a close owes. There is no user symbol behind it: `close` is a
# keyword, so it cannot be defined, shadowed or overloaded, and the file method `f.close()`
# is an EMethod that never comes near here.
fn c_close_callee(mut &em: Emitter, ch: Expr) -> Callee {
	t := c_infer(em, ch)
	raise "close requires a channel, found " + ty_name(t) if not ty_is_chan(t)
	c_chan_op_check(t, 2)
	em.used_rt = true
	em.used_conc = true
	mut args: list[Expr] = []
	args.append(ch)
	return Callee("zrt_chan_close", args, "")
}

# c_del lowers `del name`: it REVOKES the name, and nothing else. The revocation is the
# whole statement — c_live_del records it and c_live_use rejects a later read, which is
# what makes `del` mean one thing for every type.
#
# It emits no C. A channel handle is not released here because the binding already owes
# its reference to the pending-release list, and the scope that ends pays it — releasing
# again would be the double-release the list exists to rule out. Giving up the SEND end
# early is `close(ch)`, a statement of its own, and it keeps its holder on purpose.
fn c_del(mut &em: Emitter, name: str, ind: str) -> str {
	c_live_del(em, name)
	return f"{ind}/* del {name} */\n"
}

# c_select lowers `select { … }` onto zrt_select: an array of case descriptors, one call
# that picks a ready arm (or parks on all of them), and an if-chain on what it returned.
#
# A receive arm's value has to land somewhere the runtime can write BEFORE the call — it
# takes an address — so each recv arm declares a slot up front and hands over its address.
# The arm's BINDING is assembled from that slot later, inside the branch that won, because
# a `Result[T]` needs the `closed` flag the call has not set yet.
#
# `close` and `_` are not cases. They are flags on the call and constants in the answer,
# which is exactly how the runtime models them.
fn c_select(mut &em: Emitter, arms: list[SelArm], ind: str, loop: bool) -> str {
	em.used_rt = true
	em.used_conc = true

	in2 := ind + "    "
	mut n := 0
	mut has_def := "false"

	# the LOOP is the only exit an exhausted select has: `for select` ends there, and a
	# one-shot select has nowhere to go, which is what DeadlockError says
	mut has_exit := "false"
	if loop {
		has_exit = "true"
	}
	for a in arms {
		if a.op == 0 or a.op == 1 {
			n = n + 1
		} else {
			has_def = "true"
		}
	}
	tag := strconv.to_string(em.dfn_n, 10)
	em.dfn_n = em.dfn_n + 1
	cs := "zgt_cs" + tag
	mut out := ind + "{\n" + in2 + "zrt_sel_case " + cs + "[" + strconv.to_string(n, 10) + "];\n"

	# the case array, and a slot for every receive arm's value. `elems` keeps each case's
	# element type as it is worked out, indexed the way the case array is, so the dispatch
	# below can build a recv arm's carrier without inferring the arm's channel a second
	# time — that expression may be a call, and c_infer walks its whole tree.
	mut elems: list[Ty] = []
	mut idx := 0
	for a in arms {
		if a.op == 0 {
			cty := c_infer(em, a.ch)
			c_chan_op_check(cty, 0)
			elem := ty_chan_elem(cty)
			elems.append(elem)
			nm := f"zgt_rv{tag}_{idx}"
			out = out + in2 + c_type(elem) + " " + nm + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].op = ZRT_SEL_RECV;\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].ch = " + c_expr(em, a.ch, c_nosub()) + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].val = &" + nm + ";\n"
			idx = idx + 1
		} else if a.op == 1 {
			cty := c_infer(em, a.ch)
			c_chan_op_check(cty, 1)
			elem := ty_chan_elem(cty)
			elems.append(elem)
			nm := f"zgt_sv{tag}_{idx}"

			# COPIED, like `ch <- v` — the payload is snapshotted at the send. This arm
			# rendered the value with c_expr, so a `list` handed to a select send was the
			# sender's own buffer under the receiver's name, with no reference taken, on
			# two worker threads at once.
			out = f"{out}{in2}{c_type(elem)} {nm} = {c_fit_copied(em, elem, a.val, c_nosub())};\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].op = ZRT_SEL_SEND;\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].ch = " + c_expr(em, a.ch, c_nosub()) + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].val = &" + nm + ";\n"
			idx = idx + 1
		}
	}
	out = out + in2 + "int zg_pick" + tag + " = zrt_select(" + cs + ", " + strconv.to_string(n, 10) + ", " + has_def + ", " + has_exit + ");\n"

	# the dispatch. Each recv arm's binding is already in scope, so its body just runs.
	#
	# Exactly one arm runs, so for the liveness they are branches of one `if`: each body is
	# analysed from the SAME entry state and their ends are joined. Without the restore a
	# `del` in the first arm would be carried into the second, and a perfectly good read
	# there would be refused.
	entry := c_live_save(em)
	mut acc := entry
	mut acc_set := false
	mut first := true
	mut k := 0
	for a in arms {
		mut cond := ""
		if a.op == 0 or a.op == 1 {
			cond = f"zg_pick{tag} == {k}"
			k = k + 1
		} else {
			cond = f"zg_pick{tag} == ZRT_SEL_DEFAULT"
		}
		mut kw := "} else if ("
		if first {
			kw = "if ("
			first = false
			out = out + in2
		}
		out = out + kw + cond + ") {\n"

		# A receive arm binds the VALUE — a plain `T`, not a carrier. An arm that fires has
		# a value by construction: a cleanly closed channel is an absence, so the runtime
		# drops that arm rather than firing it, and a crash close is a failure, so it is
		# raised rather than handed over. Neither can reach a body, so nothing here has to
		# ask whether what it was handed is real.
		#
		# That is the whole of the fix for the chapter's one silent wrong answer, which used
		# to be a `closed` flag nobody read: an arm that fired on a closed channel ran over
		# the slot from the PREVIOUS receive and printed a value nobody sent. There is no
		# flag now because there is no such arm.
		if a.op == 0 and a.bind != "" {
			elem := elems[k - 1]

			# bound right before the body, not up front: every recv arm may call its
			# variable `v`, and one environment entry per arm would leave each body
			# reading the last one's
			em.env_names.append(a.bind)
			em.env_tys.append(elem)
			em.env_cnames.append(f"zgt_rv{tag}_{k - 1}")
			em.env_dead.append(0)
			em.env_mut.append(false)
			em.env_scope.append(em.scope_cur)
		}
		c_live_restore(em, entry)
		out = out + c_block(em, a.body, in2 + "    ")
		if acc_set {
			c_live_merge(em, acc)
		}
		acc = c_live_save(em)
		acc_set = true
	}
	c_live_restore(em, acc)
	if not first {
		out = out + in2 + "}\n"
	}
	if loop {
		# an exhausted `for select` leaves the loop: every watched receive channel has ended
		out = out + in2 + f"if (zg_pick{tag} == ZRT_SEL_DONE) {{ break; }}\n"
	}
	return out + ind + "}\n"
}

# c_for_select lowers `for select { … }`: the same wait, one ready arm per round, wrapped in
# the loop whose end it owns. `break` and `continue` inside an arm are this loop's, which is
# what makes the C `for (;;)` the honest lowering rather than a flag.
fn c_for_select(mut &em: Emitter, arms: list[SelArm], ind: str) -> str {
	# the same two things c_loop_block does for an ordinary loop body, and for the same
	# reasons: a `break` or a `continue` in an arm must release what the BODY owns and no
	# more — without the mark it released the enclosing function's channels on its way round
	# the loop, which closed a channel the loop was still reading and deadlocked — and a loop
	# may run zero times, so the body's end state joins the entry state rather than replacing
	# it.
	entry := c_live_save(em)
	outer_rel := em.loop_rel
	em.loop_rel = em.rel_cnames.len()
	body := c_select(em, arms, ind + "    ", true)
	em.loop_rel = outer_rel
	c_live_merge(em, entry)
	return ind + "for (;;) {\n" + body + ind + "}\n"
}

# --- lambdas ----------------------------------------------------------------------
#
# A `fn(x: T) -> R { … }` in expression position is LIFTED to a top-level C function and
# the expression becomes a pointer to it. That works because this compiler already carries
# a held function as one type — `zg_fnptr`, cast back to its real signature at the call —
# so a lambda with nothing captured is indistinguishable from a named function used as a
# value, which already worked.
#
# CAPTURE is the line. A body naming anything that is not one of its parameters, a global,
# or another function would need an environment to carry it, and an environment is a
# different value shape than a bare pointer. That is refused by name rather than half-done.
fn c_lambda(mut &em: Emitter, ps: list[Param], has_ret: bool, ret: Ty, body: list[Stmt]) -> str {
	free := c_lambda_free(em, ps, body)
	raise f"NotImplemented: a closure capturing `{free}` — a lambda may only use its parameters" if free != ""
	tag := strconv.to_string(em.lam_n, 10)
	em.lam_n = em.lam_n + 1
	name := "lambda__" + tag

	# the lambda's body is emitted with its OWN environment; the one belonging to the
	# function being emitted is put back afterwards, since the lambda is in the middle of
	# one of its expressions
	saved_names := em.env_names
	saved_tys := em.env_tys
	saved_cnames := em.env_cnames
	saved_dead := em.env_dead
	saved_mut := em.env_mut
	saved_scope := em.env_scope
	saved_open := em.open_scopes
	saved_cur := em.scope_cur
	saved_rel_cnames := em.rel_cnames
	saved_rel_fns := em.rel_fns
	saved_loop_rel := em.loop_rel
	saved_refs := em.ref_names
	em.lam_defs.append(c_fn(em, FnDecl(name, "", ps, has_ret, ret, body, false, em.at_path, em.at_line, em.at_col)))
	em.env_names = saved_names
	em.env_tys = saved_tys
	em.env_cnames = saved_cnames
	em.env_dead = saved_dead
	em.env_mut = saved_mut
	em.env_scope = saved_scope
	em.open_scopes = saved_open
	em.scope_cur = saved_cur
	em.rel_cnames = saved_rel_cnames
	em.rel_fns = saved_rel_fns
	em.loop_rel = saved_loop_rel
	em.ref_names = saved_refs
	em.used_fnptr = true
	return f"((zg_fnptr)zg_{name})"
}

fn c_lambda_ty(ps: list[Param], has_ret: bool, ret: Ty) -> Ty {
	mut tys: list[Ty] = []
	for pm in ps {
		tys.append(pm.ty)
	}
	mut r := TVoid
	if has_ret {
		r = ret
	}
	return TFn(tys, r)
}

# c_lambda_free is the first name a lambda's body uses that it did not declare — "" when
# there is none. A parameter, a module constant, and a function are all fine; anything
# else would have to be carried in an environment.
fn c_lambda_free(mut &em: Emitter, ps: list[Param], body: list[Stmt]) -> str {
	mut ids: list[str] = []
	mut calls: list[str] = []
	mut ns: list[str] = []
	walk_body(body, ids, calls, ns)
	mut bound: list[str] = []
	for pm in ps {
		bound.append(pm.name)
	}
	collect_binds(body, bound)
	for id in ids {
		return id if not c_name_in(bound, id) and not c_name_in(em.k_names, id) and not c_name_in(em.sig_names, id)
	}
	return ""
}

fn c_name_in(names: list[str], name: str) -> bool {
	for n in names {
		return true if n == name
	}
	return false
}

# --- defer ----------------------------------------------------------------------
#
# GRAMMAR runs a defer at the enclosing BLOCK's exit, on every path out, last-scheduled-
# first — which is the runtime's cleanup stack exactly. A block holding one takes a mark
# on entry and unwinds to it on the way out; `return` unwinds the whole function's stack
# and `break`/`continue` the loop's.
#
# What may be deferred is a direct CALL, which is the same limit the seed sets. The call's
# arguments are captured BY VALUE into a per-site env struct at the point the defer runs,
# so a later reassignment of an argument does not change what the deferred call sees.
fn c_defer(mut &em: Emitter, x: Expr, ind: str) -> str {
	return c_defer_of(em, c_callee_of(em, x, "defer"), ind)
}

# c_defer_of schedules an already-resolved CALLEE at the enclosing block's exit. `defer f(a)`
# reaches it through c_defer and `defer close(ch)` through c_close, and neither knows about
# the other: a deferred thing is a function and its arguments, whatever wrote it down.
fn c_defer_of(mut &em: Emitter, cal: Callee, ind: str) -> str {
	em.used_rt = true
	args := cal.args
	idx := em.dfn_n
	em.dfn_n = idx + 1
	tag := strconv.to_string(idx, 10)
	if args.len() == 0 {
		# a C brace in an f-string has to be doubled, and a line that is mostly braces reads
		# better as concatenation
		em.dfn_decls.append("static void zg_dfn_" + tag + "(void *p) { (void)p; " + cal.cname + "(); }\n")
		return f"{ind}zrt_defer(zg_dfn_{tag}, NULL);\n"
	}

	mut fields := ""
	mut vals := ""
	mut call := ""
	mut i := 0
	for i < args.len() {
		ft := c_type(c_infer(em, args[i]))
		fields = fields + " " + ft + " f" + strconv.to_string(i, 10) + ";"
		if i > 0 {
			vals = vals + ", "
			call = call + ", "
		}
		vals = vals + c_captured(em, cal.key, i, args[i])
		call = call + "e->f" + strconv.to_string(i, 10)
		i = i + 1
	}
	em.dfn_decls.append("typedef struct {" + fields + " } zg_denv_" + tag + ";\n")
	em.dfn_decls.append("static void zg_dfn_" + tag + "(void *p) { zg_denv_" + tag + " *e = (zg_denv_" + tag + "*)p; " + cal.cname + "(" + call + "); }\n")
	mut out := ind + "zg_denv_" + tag + " zgt_de" + tag + " = { " + vals + " };\n"
	return f"{out}{ind}zrt_defer(zg_dfn_{tag}, &zgt_de{tag});\n"
}

# Callee is the three things a `spawn` and a `defer` each need about what they are about
# to call: the C symbol, the arguments in the order that symbol takes them, and the key
# its row in the parameter table is under.
#
# Both statements build the same per-site env struct and the same thunk that unpacks it,
# so the question "what is being called" is asked in one place. Before this they each had
# their own copy of it, and each copy knew only about a direct call.
struct Callee {
	cname: str
	args: list[Expr]
	key: str
}

# c_callee_of answers that question, or refuses by name. `what` is the statement asking,
# so the diagnostic says `spawn` or `defer` rather than describing both.
#
# The three shapes the spec gives are a plain function `f(a)`, a method `obj.run()`, and a
# namespaced function `mod.work()`. A closure literal is NOT among them and cannot be: a
# lambda here may capture nothing (c_lambda refuses it), so there would be no environment
# to hand a coroutine even if the shape were accepted.
fn c_callee_of(mut &em: Emitter, x: Expr, what: str) -> Callee {
	raw := c_callee_raw(em, x, what)

	# The DEFAULTS a call left off are filled in HERE, before anything else sees the
	# argument list. An ordinary call backfills them in c_args_from; `spawn` and `defer`
	# render their arguments with a loop of their own, so neither did — `spawn work(5)` on
	# `fn work(a: int, b: int = 10)` reached cc as "too few arguments to function call"
	# against a thunk this compiler wrote, while the same call unspawned compiled and
	# printed 15.
	#
	# Filling them in at the callee, rather than in each of the two statements, is what
	# makes the divergence impossible rather than merely fixed: the env struct, the borrow
	# refusal and the argument check all read one list, and it is the whole list.
	#
	# The default's expression is captured at the `spawn` / `defer` statement like every
	# other argument, which is the semantics both forms already have — arguments are a
	# snapshot taken where the statement is written, not where the call runs.
	# checked BEFORE the backfill, against the arguments the programmer actually wrote. A
	# default is judged at the declaration, so re-judging it here said the same thing twice
	# — and the second copy named "argument 2" of a call whose source has one argument.
	chk_callsite(em, raw.key, raw.args, what)

	mut cal := raw
	cal.args = c_with_defaults(em, cal.key, cal.args)

	# `spawn` and `defer` resolve a callee and render its arguments with a loop of their
	# own, so neither has ever passed through c_args_from — the one place every other call
	# is measured against its signature. `spawn work(1)` on a two-parameter function
	# reached cc, which reported "too few arguments" about a thunk this compiler wrote.
	# They are also the two forms whose bad arguments are hardest to read back from
	# generated C, since the call the programmer wrote is not the call cc sees.
	return cal
}

# c_with_defaults answers `args` with the default expressions of every parameter the call
# left off the end appended. A key nothing registered has no parameters to ask about, so
# an intrinsic or a constructor comes back unchanged.
fn c_with_defaults(mut &em: Emitter, key: str, args: list[Expr]) -> list[Expr] {
	# a `list` parameter is by value in this compiler, so `out` is already this call's own
	mut out := args
	for d in c_defaults_from(em, key, out.len()) {
		out.append(d)
	}
	return out
}

fn c_callee_raw(mut &em: Emitter, x: Expr, what: str) -> Callee {
	n := c_call_name(x)

	return Callee(c_fn_cname("", n), c_call_args_of(x), n) if n != ""
	raise f"NotImplemented: {what} of anything but a function, a method, or a namespaced function" if not c_is_method_expr(x)

	tgt := c_meth_target_of(x)
	m := c_meth_name_of(x)
	margs := c_meth_args_of(x)
	recv := c_named_of(c_infer(em, tgt))

	if not c_has_method(em, recv, m) {
		# `mod.work()` — a module namespace flattens into the one program-wide function
		# space, so a namespaced callee IS the free function of that name, exactly as an
		# ordinary `mod.work()` call is lowered
		raise f"NotImplemented: {what} of `{m}` — not a function, a method, or a namespaced function" if not c_name_in(em.sig_names, m)
		return Callee(c_fn_cname("", m), margs, m)
	}

	# a method's receiver is parameter 0 — the parser put `this` there when it flattened the
	# impl block — so it leads the argument list and the parameter table lines up with no
	# shift. It is captured BY VALUE, like every other argument.
	mut all: list[Expr] = []
	all.append(tgt)
	for a in margs {
		all.append(a)
	}
	return Callee(c_fn_cname(recv, m), all, c_sig_key(recv, m))
}

fn c_is_method_expr(e: Expr) -> bool {
	return match e {
		EMethod(_, _, _) => true
		_ => false
	}
}

fn c_meth_target_of(e: Expr) -> Expr {
	return match e {
		EMethod(t, _, _) => t
		_ => ENil
	}
}

fn c_meth_name_of(e: Expr) -> str {
	return match e {
		EMethod(_, m, _) => m
		_ => ""
	}
}

fn c_meth_args_of(e: Expr) -> list[Expr] {
	mut none: list[Expr] = []
	return match e {
		EMethod(_, _, a) => a
		_ => none
	}
}

fn c_call_name(e: Expr) -> str {
	return match e {
		ECall(n, _) => n
		_           => ""
	}
}

fn c_call_args_of(e: Expr) -> list[Expr] {
	mut none: list[Expr] = []
	return match e {
		ECall(_, a) => a
		_           => none
	}
}

fn c_has_defer(body: list[Stmt]) -> bool {
	for st in body {
		return true if c_is_defer(st)
	}
	return false
}

# c_is_defer is asked of a statement, not of a keyword: `defer close(ch)` schedules work at
# the block's exit exactly as `defer f()` does, so a block holding one needs the same mark.
# Answering only for SDefer left the close on the cleanup stack with no unwind to run it.
fn c_is_defer(s: Stmt) -> bool {
	return match s {
		SDefer(_) => true
		SClose(ch, at_exit) => at_exit
		_ => false
	}
}

# c_return_if is the postfix guard's return. It goes through c_return so the defers run on
# this path too — a guard is an exit like any other, and it is the path a `defer` most
# often exists for.
fn c_return_if(mut &em: Emitter, val: Expr, cond: Expr, ind: str) -> str {
	body := c_return(em, true, val, ind + "    ")
	return ind + "if " + c_cond(em, cond, "a conditional `return`") + " {\n" + body + ind + "}\n"
}

# c_jump is `break` / `continue` with the loop's defers run first and everything the loop
# BODY bound released after them — the same two halves, in the same order, as the `return`
# above. Emitting the keyword alone is what made `for { ch := chan[int](1); … break }`
# leave a sender behind: the channel never reached zero, never closed, and the deadlock
# that followed surfaced on main, nowhere near the `break`.
#
# The releases stop at em.loop_rel rather than at zero: a binding made OUTSIDE the loop is
# still in scope after the jump, and its own block releases it.
fn c_jump(mut &em: Emitter, kw: str, ind: str) -> str {
	rel := c_release_from(em, em.loop_rel, ind)
	return rel + f"{ind}{kw};\n" if em.loop_mark == ""
	return f"{ind}zrt_unwind_to({em.loop_mark});\n" + rel + f"{ind}{kw};\n"
}

# --- maps -----------------------------------------------------------------------
#
# A map is the runtime's `zrt_map` by value, plus one static vtable per distinct shape
# saying how to hash and compare its key. The runtime provides the hash/eq leaves for the
# two key types the language builds in.
fn c_map_vt(mut &em: Emitter, kt: Ty, vt: Ty) -> str {
	name := f"zg_mapvt_{c_ident_safe(c_type(kt))}_{c_ident_safe(c_type(vt))}"
	for n in em.mvt_names {
		return name if n == name
	}

	# A KEY NEEDS `Hash`, and this compiler has two: int and str (GRAMMAR — a map key needs
	# both equality and a hash, and neither is automatic). A `byte` key took the INT hash
	# and eq, which read 8 bytes out of a 1-byte slot — so `{b'a': 1}` built, and the lookup
	# that followed raised `KeyError` for a key that was right there. The seed has refused
	# this all along; `zerg` reached it by inference the day a byte literal carried its type.
	# a key whose type inference could not name is left alone, as every other rule here
	# does: guessing turns a typing gap into a refusal of a working program
	raise f"NotImplemented: a map key of type {ty_name(kt)} — a key needs `Hash`, and this compiler has one for `int` and for `str`" if not c_is_int(kt) and not c_is_str(kt) and not c_is_unknown(kt)

	mut hash := "zrt_hash_int"
	mut eq := "zrt_eq_int"
	if c_is_str(kt) {
		hash = "zrt_hash_str"
		eq = "zrt_eq_str"
	}
	em.mvt_names.append(name)

	# NULL copy is the runtime's memcpy fast path, which is what a POD key or value wants.
	# A key or value that OWNS storage gets the same thunk a list element of that type
	# gets: without one, `zrt_map_copy` bit-copied a `list` value and both maps' entries
	# named one buffer. The drops stay NULL — this emitter is leak-style throughout.
	kc := c_elem_copy_fn(em, kt)
	vc := c_elem_copy_fn(em, vt)
	em.mvt_decls.append(f"static const zrt_map_vt {name} = {{ {hash}, {eq}, {kc}, NULL, {vc}, NULL }};\n")
	return name
}

fn c_map_lit_ty(mut &em: Emitter, ks: list[Expr], vs: list[Expr]) -> Ty {
	return TMap(TUnknown, TUnknown) if ks.len() == 0
	return TMap(c_infer(em, ks[0]), c_infer(em, vs[0]))
}

fn c_is_maplit(e: Expr) -> bool {
	return match e {
		EMapLit(_, _) => true
		_             => false
	}
}

# c_map_lit_as builds a map literal AT a declared type, so an empty one is still the map
# the declaration says it is.
fn c_map_lit_as(mut &em: Emitter, want: Ty, lit: Expr, sb: Subst) -> str {
	return match lit {
		EMapLit(ks, vs) => c_map_lit_at(em, c_map_key_ty(want), c_map_val_ty(want), ks, vs, sb)
		_ => ""
	}
}

fn c_map_lit(mut &em: Emitter, ks: list[Expr], vs: list[Expr], sb: Subst) -> str {
	kt := c_map_key_ty(c_map_lit_ty(em, ks, vs))
	vt := c_map_val_ty(c_map_lit_ty(em, ks, vs))
	return c_map_lit_at(em, kt, vt, ks, vs, sb)
}

# c_map_lit builds the map in a statement expression: init, then one set per entry, in
# the order they were written.
fn c_map_lit_at(mut &em: Emitter, kt: Ty, vt: Ty, ks: list[Expr], vs: list[Expr], sb: Subst) -> str {
	em.used_rt = true

	vtn := c_map_vt(em, kt, vt)
	kc := c_type(kt)
	vc := c_type(vt)
	mut out := f"({{ zrt_map zgt_mm; zrt_map_init(&zgt_mm, sizeof({kc}), sizeof({vc}), &{vtn});"
	mut i := 0
	for i < ks.len() {
		out = out + f" {{ {kc} zgt_mk = {c_expr(em, ks[i], sb)}; {vc} zgt_mv = {c_fit_copied(em, vt, vs[i], sb)}; zrt_map_set(&zgt_mm, &zgt_mk, &zgt_mv); }}"
		i = i + 1
	}
	return out + " zgt_mm; })"
}

# c_slice lowers `xs[a..b]` — GRAMMAR says a slice IS an index by a range, which is why it
# needs no node of its own.
#
# The elements are copied into a fresh list rather than shared with the source. A list is
# a value in this language, so a slice that aliased its source would be the odd one out —
# and the runtime has no slice primitive to alias with anyway. The source is materialised
# into a temp first, so a call result is indexed once rather than per element.
fn c_slice(mut &em: Emitter, target: Expr, idx: Expr, tty: Ty, sb: Subst) -> str {
	c_range_needs_hi(idx, "a slice needs an upper bound — `xs[a..xs.len()]`")

	src := c_expr(em, target, sb)
	lo := c_expr(em, c_range_lo(idx), sb)
	mut hi := c_expr(em, c_range_hi(idx), sb)
	if c_range_incl(idx) {
		hi = f"({hi}) + 1"
	}

	# the loop is the RUNTIME's: duplicating an element is `vt->copy` or a memcpy depending
	# on the element type, which is a rule list.c already states twice. Emitting the loop
	# here pushed raw slots — a memcpy whatever the type — so a slice of a `list[list[int]]`
	# named the parent's inner buffers and a write through it was read back through both.
	em.used_rt = true
	mut out := "({ zrt_list zgt_ss = " + src + "; zrt_list zgt_sl;"
	out = out + " zrt_list_slice(&zgt_sl, &zgt_ss, (size_t)(" + lo + "), (size_t)(" + hi + "));"
	return out + " zgt_sl; })"
}

# c_map_index lowers `m[k]`. The key is materialised into a temp because zrt_map_index
# takes its ADDRESS, and a literal or call result has none.
fn c_map_index(mut &em: Emitter, target: Expr, idx: Expr, tty: Ty, sb: Subst) -> str {
	kc := c_type(c_map_key_ty(tty))
	vc := c_type(c_map_val_ty(tty))
	tgt := c_expr(em, target, sb)

	# the map is BOUND when it is not a place, for the reason c_index binds a list: a map
	# index takes the map's ADDRESS, and `n["a"]["b"]` or `({"a": 9})["a"]` has none —
	# which reached cc as "cannot take the address of an rvalue of type 'zrt_map'".
	return f"({{ {kc} zgt_mk = {c_expr(em, idx, sb)}; (*({vc}*)zrt_map_index(&({tgt}), &zgt_mk)); }})" if c_is_place(em, target)

	return f"({{ zrt_map zgt_mx = {tgt}; {kc} zgt_mk = {c_expr(em, idx, sb)}; (*({vc}*)zrt_map_index(&zgt_mx, &zgt_mk)); }})"
}

# c_map_set lowers `m[k] = v`. Both sides go through temps for the same reason.
fn c_map_set(mut &em: Emitter, target: Expr, idx: Expr, rhs: Expr, tty: Ty, ind: str) -> str {
	kc := c_type(c_map_key_ty(tty))
	vc := c_type(c_map_val_ty(tty))

	# `m[k] = v` INSERTS, so the map is WRITTEN and its target is an assignment target like
	# any other: `h[0]["z"] = 3` edits a map header that lives inside `h`'s buffer, and
	# lowering `h[0]` as a read left that buffer shared with `g`.
	tgt := c_lvalue(em, target, c_nosub())
	k := c_expr(em, idx, c_nosub())
	v := c_fit_copied(em, c_map_val_ty(tty), rhs, c_nosub())
	return f"{ind}{{ {kc} zgt_mk = {k}; {vc} zgt_mv = {v}; zrt_map_set(&({tgt}), &zgt_mk, &zgt_mv); }}\n"
}

fn c_map_method(mut &em: Emitter, target: Expr, meth: str, tty: Ty, sb: Subst) -> str {
	em.used_rt = true
	tgt := c_expr(em, target, sb)

	return f"((int64_t)zrt_map_len(&({tgt})))" if meth == "len"
	return f"zrt_map_has(&({tgt}), &zgt_mk)" if meth == "has"

	raise f"NotImplemented: the map method `{meth}`"
}

fn c_index_target(e: Expr) -> Expr {
	return match e {
		EIndex(t, _) => t
		_            => ENil
	}
}

fn c_index_key(e: Expr) -> Expr {
	return match e {
		EIndex(_, i) => i
		_            => ENil
	}
}

fn c_is_index(e: Expr) -> bool {
	return match e {
		EIndex(_, _) => true
		_            => false
	}
}

fn c_is_map(t: Ty) -> bool {
	return match t {
		TMap(_, _) => true
		_          => false
	}
}

fn c_map_key_ty(t: Ty) -> Ty {
	return match t {
		TMap(k, _) => k
		_          => TUnknown
	}
}

fn c_map_val_ty(t: Ty) -> Ty {
	return match t {
		TMap(_, v) => v
		_          => TUnknown
	}
}

# --- tuples ---------------------------------------------------------------------
#
# A tuple is a plain C struct, one carrier per distinct SHAPE. The name is built from the
# element types, so two tuples of the same shape share one carrier and two of different
# shapes cannot collide.
fn c_tuple_ty(mut &em: Emitter, elems: list[Expr]) -> Ty {
	mut tys: list[Ty] = []
	for e in elems {
		tys.append(c_infer(em, e))
	}
	return TTuple(tys)
}

# c_tuple_cname is the carrier's C name. It is a PURE function of the shape because c_type
# needs the same spelling and has no Emitter to ask — registering the typedef is
# c_tuple_name's job, and every tuple reaches it through its literal.
# c_tuple_copy_helper emits the tuple's copy and the element thunk that lets a list of it
# reach one. It is the struct helper's shape with `f0`-style fields instead of names.
fn c_tuple_copy_helper(mut &em: Emitter, name: str, tys: list[Ty]) -> str {
	mut out := f"static {name} {name}_copy({name} v) {{\n    {name} r = v;\n"
	mut i := 0
	for i < tys.len() {
		fi := f"f{strconv.to_string(i, 10)}"
		if c_needs_copy(em, tys[i]) {
			out = out + f"    r.{fi} = " + c_copy_of(em, tys[i], f"v.{fi}") + ";\n"
		}
		i = i + 1
	}
	out = out + "    return r;\n}\n"
	out = out + f"static void {name}_elemcopy(void *dst, const void *src) {{ *({name}*)dst = {name}_copy(*(const {name}*)src); }}\n"
	return out + f"static const zrt_elem_vt {name}_listvt = {{{name}_elemcopy, NULL}};\n"
}

fn c_tuple_cname(tys: list[Ty]) -> str {
	mut name := "zgt_tup"
	for t in tys {
		name = name + "_" + c_ident_safe(c_type(t))
	}
	return name
}

# c_tuple_name is c_tuple_cname plus the typedef it needs. A C identifier cannot hold `*`
# or a space, so each element type is flattened into one.
# c_tuple_decl registers a tuple shape and answers its DECLARATION TEXT — the typedef, plus
# the copy helper a tuple owes when it holds a list, a map or another such tuple (without
# it the tuple's field named the source's buffer). A shape already registered answers "".
#
# The ELEMENTS are registered first, depth first. `c_type` of a tuple element is a pure
# function of its shape and registers nothing, so `(1, (2, 3))` used to emit the outer
# typedef naming an inner one that no pass had written — cc reported `unknown type name`
# against generated C for a program with a tuple inside a tuple.
fn c_tuple_decl(mut &em: Emitter, tys: list[Ty]) -> str {
	mut out := ""
	for t in tys {
		if c_is_tuple(t) {
			out = out + c_tuple_decl(em, ty_tuple_elems(t))
		}
	}
	name := c_tuple_cname(tys)
	for n in em.tup_names {
		return out if n == name
	}
	mut decl := "typedef struct {"
	mut i := 0
	for i < tys.len() {
		decl = decl + f" {c_type(tys[i])} f{strconv.to_string(i, 10)};"
		i = i + 1
	}
	em.tup_names.append(name)
	out = out + decl + f" }} {name};\n"
	if c_needs_copy(em, TTuple(tys)) {
		out = out + c_tuple_copy_helper(em, name, tys)
	}
	return out
}

# c_tuple_name is c_tuple_decl for a tuple first met while a BODY is lowered: the text goes
# into the on-demand block, which is emitted after the declarations. c_type_decls calls
# c_tuple_decl directly instead, so a tuple a DECLARATION names is placed among the other
# typedefs in dependency order.
fn c_tuple_name(mut &em: Emitter, tys: list[Ty]) -> str {
	d := c_tuple_decl(em, tys)
	if d != "" {
		em.tup_decls.append(d)
	}
	return c_tuple_cname(tys)
}

fn c_ident_safe(s: str) -> str {
	mut out: list[byte] = []
	for c in list[byte](s) {
		if ascii.is_alpha(c) or ascii.is_digit(c) or c == b'_' {
			out.append(c)
		} else if c == b'*' {
			out.append(b'p')
		}
	}
	return str(out)
}

fn c_tuple_lit(mut &em: Emitter, elems: list[Expr], sb: Subst) -> str {
	mut tys: list[Ty] = []
	for e in elems {
		tys.append(c_infer(em, e))
	}

	name := c_tuple_name(em, tys)
	mut out := f"({name}){{"
	mut i := 0
	for i < elems.len() {
		if i > 0 {
			out = out + ", "
		}

		# each element is COPIED into the tuple, like a struct's constructor argument: the
		# tuple owns what it holds, and `(a, 0)` used to store `a`'s own list header, so a
		# write through `t.0` was read back through `a`
		out = out + c_copied(em, tys[i], elems[i], sb)
		i = i + 1
	}
	return out + "}"
}

# c_fieldref lowers `x.name`. A field whose name is a NUMBER is a tuple element — GRAMMAR
# reads a tuple back by static index, `t.0`, and the parser gives that the same EField node
# a struct field gets, so the number is what tells them apart.
fn c_field_ty_of(mut &em: Emitter, target: Expr, fld: str) -> Ty {
	# `Color.Red` is a value of `Color`, and it is answered here for the same reason
	# c_fieldref answers it: an enum name infers to nothing, so asking about the target
	# first would lose the shape.
	en := c_qualified_variant(em, target, fld)
	return TNamed(en) if en != ""

	# `lib.LIMIT` — a module-qualified name is the name it ends with; see c_fieldref
	ns := c_ident_name(target)
	return c_lookup_var(em, fld) if c_name_in(em.mod_names, ns) and c_is_bound(em, fld)

	t := c_infer(em, target)
	if c_is_tuple(t) and c_all_digits(fld) {
		ts := c_tuple_tys(t)

		# `int(s)` is a CAST here, not a parse — the index has to come from strconv
		i := strconv.parse_int(fld, 10)
		return ts[i] if i >= 0 and i < ts.len()
		return TUnknown
	}

	# An Err is a RUNTIME struct, not a declared one, so its two readable fields are
	# answered here. They are deliberately the whole set: a message to report and a kind
	# to compare, which is what `Right(e)` needs to be worth binding.
	if c_is_err_ty(t) {
		return TStr if fld == "msg"
		return TInt if fld == "kind"

		raise f"NotImplemented: the field `{fld}` on an Err — it has `msg` and `kind`"
	}
	return c_field_ty(em, c_named_of(t), fld)
}

fn c_fieldref(mut &em: Emitter, target: Expr, fld: str, sb: Subst) -> str {
	# `Color.Red` — a variant NAMED BY ITS ENUM. The bare `Red` is what the grammar makes
	# normative (a bare name is a variant when it resolves to one, GRAMMAR:428), and it
	# stays; this is the same value said unambiguously, which is what a reader reaches for
	# when two enums are in scope and the bare names do not say which is meant. It is
	# answered before inference for the reason `E.of(n)` is: an enum name is not a binding,
	# so `c_infer` has nothing to say about it and the message was `undefined name `Color``.
	en := c_qualified_variant(em, target, fld)
	return "(zg_" + en + "){.tag = " + strconv.to_string(c_variant_tag(em, fld), 10) + "}" if en != ""

	# `lib.LIMIT` — a MODULE-QUALIFIED name. A module flattens into this unit, so the
	# qualifier says where the name came from and the last segment IS the name — which is
	# the rule the CALL path has followed since it was written (`ascii.is_digit`). The
	# field path did not, so it lowered `lib` as a value and reported `undefined name lib`:
	# about the qualifier, which is the one part of the expression that is not a name.

	# the enum is named and the field is not one of ITS variants. Falling through said
	# `undefined name `Color`` — about the one name in the expression that IS defined.
	tn := c_ident_name(target)
	if tn != "" and c_name_in(em.enum_names, tn) {
		raise f"`{fld}` is not a variant of `{tn}`" if not c_is_variant(em, fld)
		raise f"`{fld}` is a variant of `{c_variant_enum(em, fld)}`, not of `{tn}`"
	}

	ns := c_ident_name(target)
	if c_name_in(em.mod_names, ns) and c_is_bound(em, fld) {
		# `lib.LIMIT` — a module-qualified NAME. A module flattens into this unit, so the
		# qualifier says where the name came from and the last segment IS the name, which
		# is the rule the CALL path has followed since it was written (`ascii.is_digit`).
		return c_var_cname(em, fld)
	}

	# a REAL module and a member it does not have. Falling through lowered `lib` as a value
	# and said `undefined name lib` — about the qualifier, which is the part that is right.
	raise f"module `{ns}` has no `{fld}`" if c_name_in(em.mod_names, ns)

	tgt := c_expr(em, target, sb)
	return f"{tgt}.f{fld}" if c_all_digits(fld)

	# an Err's fields are the runtime's own, so they carry no `zg_` mangling
	tt := c_infer(em, target)
	return f"{tgt}.{fld}" if c_is_err_ty(tt)

	# A FIELD THE TYPE DOES NOT HAVE was spelled `zg_<fld>` and handed to cc, which reported
	# "no member named 'zgt_z' in 'zg_P'" against generated code — the same class as an
	# undefined name, and answerable from the same tables. A target whose type inference
	# could not name is left alone: guessing there would refuse a working program.
	nm := c_named_of(tt)
	raise f"no field `{fld}` on {nm}" if nm != "" and c_is_struct_name(em, nm) and c_is_unknown(c_field_ty(em, nm, fld))
	return f"{tgt}.zg_{fld}"
}

fn c_all_digits(s: str) -> bool {
	b := list[byte](s)
	return false if b.len() == 0
	for c in b {
		return false if not ascii.is_digit(c)
	}
	return true
}

fn c_is_tuple(t: Ty) -> bool {
	return match t {
		TTuple(_) => true
		_         => false
	}
}

fn c_tuple_tys(t: Ty) -> list[Ty] {
	mut none: list[Ty] = []
	return match t {
		TTuple(ts) => ts
		_          => none
	}
}

fn c_range_unsupported() -> str {
	raise "NotImplemented: a range used as a value — it is a `for … in` iterable so far"
}

fn c_is_range(e: Expr) -> bool {
	return match e {
		ERange(_, _, _) => true
		_ => false
	}
}

# The range accessors. emit.zg's match is an EXPRESSION — every arm yields a value — so a
# node is taken apart one field at a time rather than in a block-bodied arm.
fn c_range_lo(e: Expr) -> Expr {
	return match e {
		ERange(a, _, _) => a
		_ => ENil
	}
}

fn c_range_hi(e: Expr) -> Expr {
	return match e {
		ERange(_, b, _) => b
		_ => ENil
	}
}

fn c_range_incl(e: Expr) -> bool {
	return match e {
		ERange(_, _, incl) => incl
		_ => false
	}
}

# c_forrange lowers `for v in a..b` to a counted loop. The loop variable is an int and is
# in scope for the body, which is what makes the bound expressions ordinary ints too. The
# upper bound is read once into a temp, so an expression bound is not re-evaluated on
# every iteration the way a C `for` header would.
fn c_forrange(mut &em: Emitter, var: str, iter: Expr, body: list[Stmt], ind: str) -> str {
	c_range_needs_hi(iter, "a `for … in` needs an upper bound")

	lo := c_expr(em, c_range_lo(iter), c_nosub())
	hi := c_expr(em, c_range_hi(iter), c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, TInt, false)

	# the C name the binding actually took: a second loop over the same source name is a
	# SHADOWING binding, and c_add_var gives it `zg_v__1` rather than `zgt_v`
	cv := c_var_cname(em, var)
	in2 := ind + "    "
	mut out := ind + "{\n" + in2 + "int64_t zgt_hi = " + hi + ";\n"

	# An INCLUSIVE range whose high end is the type's maximum has no value to step to after
	# it: `v++` there overflows, which is undefined in C and in practice loops forever. The
	# step is the condition instead — 1 while there is another value, 0 at the last one — so
	# the loop ends without ever computing a value outside the range.
	#
	# Testing `!=` rather than `<` is safe because the loop variable is IMMUTABLE — the
	# body cannot move it off the sequence, so the only way to reach `hi` is to step to it.
	if c_range_incl(iter) {
		head := f"for (int64_t {cv} = {lo}, zgt_more = ({cv} <= zgt_hi); zgt_more; "
		out = out + in2 + head + "zgt_more = (" + cv + " != zgt_hi), " + cv + " += zgt_more) {\n"
	} else {
		out = out + in2 + "for (int64_t " + cv + " = " + lo + "; " + cv + " < zgt_hi; " + cv + "++) {\n"
	}
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

# c_forin lowers `for v in xs { ... }` to an index loop over the runtime list.
# c_forchan lowers `for v in ch`. The channel IS the iterator: it yields values until its
# last sender leaves, and that close is the StopIteration which ends the loop. There is no
# generator type and no `yield` keyword in this language because this is where they would
# have gone — a producer coroutine sending to a channel is the generator, and the `send`
# is the yield.
#
# A closed channel still hands over what it is holding, so the loop drains the buffer
# before it ends; that is zrt_chan_recv's own rule, not something repeated here.
#
# The one thing a close does NOT say by itself is WHY. An ordinary close and a sender that
# crashed both end the receive, so the reason is read after the loop, and it is read as the
# whole Err: the StopIteration KIND is the ordinary end, and anything else is the Err of a
# sender that died while this loop was reading it — re-raised here, message, cause and kind
# intact. Ending quietly instead would turn a crash into a short answer, which is the
# failure this language is least willing to produce, and re-raising a stand-in string
# would keep the failure while losing the reason for it.
fn c_forchan(mut &em: Emitter, var: str, iter: Expr, t: Ty, body: list[Stmt], ind: str) -> str {
	em.used_conc = true
	c_chan_op_check(t, 0)

	elem := ty_chan_elem(t)
	et := c_type(elem)
	it := c_expr(em, iter, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, elem, false)
	cv := c_var_cname(em, var)

	# The loop's handle OWNS what it holds when the iterable was not already storage. `for v
	# in ch` borrows the binding `ch` and gives nothing back; `for v in source()` is handed a
	# freshly built handle carrying exactly one reference, and this loop is the only thing
	# that will ever be in a position to return it. It is the same rule c_let_chan states for
	# a binding — a name takes a reference and gives it back — reaching the one holder that
	# is not a name.
	#
	# The handle is NUMBERED when it owns, because the release then joins the pending list
	# and a `return` inside the body renders every pending name at the return site: two
	# nested loops both spelling their handle `zgt_cit` would release the inner one twice and
	# the outer one never. The number is the pending list's own height, which is unique among
	# the entries that can be live together and moves only when the program does. A borrowed
	# handle registers nothing, so it keeps the plain name and its C is unchanged.
	keep := em.rel_cnames.len()
	owns := not c_is_lvalue(iter)
	mut cit := "zgt_cit"
	if owns {
		cit = f"zgt_cit_{keep}"
	}

	# a block, so the handle and the loop variable are scoped to the loop and sequential
	# or nested `for … in ch` loops cannot collide on the name
	in2 := ind + "    "
	mut out := ind + "{\n" + in2 + "zrt_chan *" + cit + " = " + it + ";\n"
	if owns {
		c_pend_release(em, cit, c_chan_release_fn(c_chan_dir(t)))
	}
	out = out + in2 + et + " " + cv + ";\n"
	out = out + in2 + "while (zrt_chan_recv(" + cit + ", &" + cv + ") == 0) {\n"
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"

	# The close reason is read BEFORE the handle is given back, and the release sits between
	# the read and the raise: zrt_chan_close_err answers by value, so the Err outlives the
	# handle, and putting the release here is what keeps the crash path from being the one
	# path that leaks.
	out = out + in2 + "{ zrt_err zgt_ce = zrt_chan_close_err(" + cit + ");\n"
	out = out + c_scope_end(em, keep, in2 + "  ")
	out = out + in2 + "  if (zgt_ce.kind != ZRT_ERR_STOP_ITERATION) { zrt_raise_err(zgt_ce); } }\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

fn c_forin(mut &em: Emitter, var: str, iter: Expr, body: list[Stmt], ind: str) -> str {
	# A RANGE is not a container, so it never touches the list runtime: `for i in a..b` is
	# the counted C loop it already means.
	return c_forrange(em, var, iter, body, ind) if c_is_range(iter)
	em.used_rt = true

	# A CHANNEL is the other thing that is iterated without being a container: the loop
	# is the receive, and the close is what ends it.
	ct := c_infer(em, iter)
	return c_forchan(em, var, iter, ct, body, ind) if ty_is_chan(ct)

	# A MAP binds the KEY, walked in insertion order (docs/code/collections.md) — the value
	# is reached with `m[k]`. It used to fall through to the list path below, which handed
	# cc a `zrt_map` where a `zrt_list` was declared.
	return c_formap(em, var, iter, ct, body, ind) if c_is_map(ct)

	# `for c in s` walks a str's CODE POINTS, which needs the UTF-8 decode this compiler
	# does not have. It used to fall through to the list path, handing cc a `const char*`
	# where a `zrt_list` was declared.
	raise "NotImplemented: `for c in <str>` binds each code point, which needs the UTF-8 decode this compiler does not have — walk `list[byte](s)` for the bytes" if c_is_str(ct)

	elem := c_list_elem(c_infer(em, iter))
	et := c_type(elem)
	it := c_expr(em, iter, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, elem, false)
	cv := c_var_cname(em, var)

	# wrap in a block and COPY the iterable into a local. It used to be a header bit-copy —
	# addressable, and enough for a call-result rvalue — which meant the loop held a
	# pointer into a buffer it had taken no reference to: `for v in xs { xs.append(v) }`
	# grew `xs` past its capacity, `zrt_list_grow` freed the buffer, and the loop read on
	# from the free'd one. ASan called it a heap-use-after-free; without it the loop simply
	# read rubbish. A copy is what the language says a loop iterates anyway — the sequence
	# as it was when the loop started — and under copy-on-write it costs an increment.
	in2 := ind + "    "
	mut out := ind + "{\n" + in2 + "zrt_list zgt_it = " + c_copy_of(em, c_infer(em, iter), it) + ";\n"
	out = out + in2 + "for (size_t zgt_i = 0; zgt_i < zrt_list_len(&zgt_it); zgt_i++) {\n"
	out = out + in2 + "    " + et + " " + cv + " = (*(" + et + "*)zrt_list_at_ref(&zgt_it, zgt_i));\n"
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

# c_formap is the list loop over a map's KEYS, on the runtime's insertion-ordered accessor.
# The map is materialised into a local for the same reason the list is: a call result has no
# address, and two sequential loops must not clash on the temp name.
fn c_formap(mut &em: Emitter, var: str, iter: Expr, ct: Ty, body: list[Stmt], ind: str) -> str {
	kt := c_map_key_ty(ct)
	kc := c_type(kt)
	it := c_expr(em, iter, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, kt, false)

	cv := c_var_cname(em, var)

	in2 := ind + "    "

	# COPIED, for the reason c_forin gives: a bare header meant the loop pointed into a
	# buffer it had taken no reference to, so an insert in the body reallocated `entries`
	# and the loop read on from the free'd block
	mut out := ind + "{\n" + in2 + "zrt_map zgt_mit = " + c_copy_of(em, c_infer(em, iter), it) + ";\n"
	out = out + in2 + "for (size_t zgt_i = 0; zgt_i < zrt_map_len(&zgt_mit); zgt_i++) {\n"
	out = out + in2 + "    " + kc + " " + cv + " = (*(" + kc + "*)zrt_map_key_at(&zgt_mit, zgt_i));\n"
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

fn c_let(mut &em: Emitter, name: str, ty: Ty, has_type: bool, is_mut: bool, ival: Expr, ind: str) -> str {
	chk_fresh_binding(em, name)

	mut eff := ty
	if has_type {
		chk_binding(em, name, ty, ival)
		if ty_is_chan(ty) {
			c_chan_check(c_infer(em, ival), ty, f"binding `{name}`")
		}
	} else {
		eff = c_infer(em, ival)
	}

	# A MAP LITERAL takes its shape from the declaration. `c_map_lit_ty` reads the entries,
	# so an EMPTY `{:}` sized its value slot as int64_t: `mut m: map[str, P] = {:}` then
	# `m["a"] = P(3,4)` silently read back a TRUNCATED value, and a carrier value was a cc
	# error instead. The declared type is what the map is built with when one is written.
	if has_type and c_is_map(eff) and c_is_maplit(ival) {
		c_add_var(em, name, eff, is_mut)
		return f"{ind}zrt_map {c_var_cname(em, name)} = {c_map_lit_as(em, eff, ival, c_nosub())};\n"
	}

	return c_let_list(em, name, eff, is_mut, ival, ind) if c_is_list(eff)
	return c_let_chan(em, name, eff, is_mut, ival, ind) if ty_is_chan(eff)

	# an optional does not fit a declaration that promised a value: there is no implicit
	# unwrap in the language, and letting one through emitted a carrier where a scalar went
	raise f"`{name}` is declared {ty_name(eff)} and the value is {ty_name(c_infer(em, ival))}: unwrap it with `?? …`, `!` or `if {name} := …`" if has_type and not c_is_opt(eff) and c_is_opt(c_infer(em, ival))

	# a declared `T?` takes the value the declaration promises, wrapping a bare one
	if has_type and c_is_carrier(eff) {
		c_add_var(em, name, eff, is_mut)
		return f"{ind}{c_type(eff)} {c_var_cname(em, name)} = {c_carrier_fit(em, eff, ival, c_nosub())};\n"
	}

	# The initializer is rendered BEFORE the binding enters scope: in `mut n := n` the
	# right-hand side names the OUTER n, and resolving it after would make the new
	# variable initialize itself.
	val := c_copied(em, eff, ival, c_nosub())
	c_add_var(em, name, eff, is_mut)
	return f"{ind}{c_type(eff)} {c_var_cname(em, name)} = {val};\n"
}

# c_let_chan declares a CHANNEL binding, which owns what it holds. Two halves:
#
# It TAKES a reference. An initializer that names existing storage — another binding, a
# parameter — is somebody else's handle, so this binding takes one of its own, by ITS OWN
# direction: `tx: chan[int]<- = ch` counts as a sender, `rx: <-chan[int] = ch` counts only
# as a holder. A freshly built handle (`chan[T](n)`, a call's result) already carries
# exactly one reference and this binding takes it over, so copying there would leak one.
#
# And it GIVES IT BACK at scope exit (c_pend_release). That is the half this emitter did
# not have, and its absence is why a narrowed binding used to be a bare alias and why the
# spec's "close early by narrowing the scope" could not work: nothing ever gave the origin
# handle up, so `senders` never reached zero on its own and every stream needed a statement
# to end it. With both halves the counts move only where a handle moves, and every handle
# has exactly one owner.
fn c_let_chan(mut &em: Emitter, name: str, eff: Ty, is_mut: bool, ival: Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true
	dir := c_chan_dir(eff)
	mut val := c_expr(em, ival, c_nosub())
	if c_is_lvalue(ival) {
		val = f"{c_chan_copy_fn(dir)}({val})"
	}
	c_add_var(em, name, eff, is_mut)
	cn := c_var_cname(em, name)
	c_pend_release(em, cn, c_chan_release_fn(dir))
	return f"{ind}zrt_chan *{cn} = {val};\n"
}

# c_pend_release records that `cname` owns something `relfn` gives back, until its scope
# ends. It is the ONE way onto the pending-release list, so a type that starts owning its
# storage joins by calling this and needs no exit path of its own.
fn c_pend_release(mut &em: Emitter, cname: str, relfn: str) {
	em.rel_cnames.append(cname)
	em.rel_fns.append(relfn)
}

# c_release_from renders the release of every pending binding at index `keep` or above,
# innermost first. It is what every exit from a block goes through — falling off the end,
# a `return`, a `break` or a `continue` — and it only RENDERS: dropping the entries is the
# business of the one exit that actually ends the scope (c_scope_end). A `return` and a
# jump are each one path out of several, and the block still has to release on its own.
#
# Releases are emitted rather than deferred, which is the one thing this does not share
# with the seed. The cost is a binding in a frame that ABORTS: its release is skipped and
# the handle leaks, as everything else in this emitter does on that path. It buys not
# having to hand the runtime the address of a C local whose block may end before the
# cleanup stack is unwound, which would be a use-after-free rather than a leak. A
# coroutine's own handle is unaffected either way: `spawn` releases its capture from the
# thunk's defer, which does run on the crash path, and that is what closes a channel whose
# producer died.
fn c_release_from(mut &em: Emitter, keep: int, ind: str) -> str {
	mut out := ""
	mut i := em.rel_cnames.len() - 1
	for i >= keep {
		out = out + ind + em.rel_fns[i] + "(" + em.rel_cnames[i] + ");\n"
		i = i - 1
	}
	return out
}

# c_scope_end is c_release_from for the exit that ends the scope: it renders the releases
# and then drops them, so the statements after the block no longer see them.
fn c_scope_end(mut &em: Emitter, keep: int, ind: str) -> str {
	return "" if em.rel_cnames.len() <= keep
	out := c_release_from(em, keep, ind)
	em.rel_cnames = c_strs_take(em.rel_cnames, keep)
	em.rel_fns = c_strs_take(em.rel_fns, keep)
	return out
}

# c_ints_drop_last removes the last element IN PLACE. Taking the list by value and
# answering a fresh one would copy the stack twice to lose one element, on every block.
fn c_ints_drop_last(mut &xs: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < xs.len() - 1 {
		out.append(xs[i])
		i = i + 1
	}
	xs = out
}

fn c_strs_take(xs: list[str], n: int) -> list[str] {
	mut out: list[str] = []
	mut i := 0
	for i < n {
		out.append(xs[i])
		i = i + 1
	}
	return out
}

# c_let_list declares a list binding: a list-literal initializer becomes an init plus a
# push per element; any other initializer (a call or another list) is a plain copy.
# c_let_list declares a LIST binding, which owns its buffer and gives it back at scope exit
# (c_pend_release) exactly as a channel binding gives back its handle.
#
# The address is what is registered, because zrt_list_drop takes the header by pointer — the
# pending list holds text and a function, so `&name` is all "by reference" has to mean here.
#
# A list is REFCOUNTED underneath (copy-on-write), which is what makes the drop safe at every
# site a list leaves this scope by: `return xs` copies, and so does pushing one into a
# channel, a struct field or a `spawn` capture. Each of those retains, so the holder dropped
# here is never the last one when somebody else is still reading.
fn c_let_list(mut &em: Emitter, name: str, eff: Ty, is_mut: bool, ival: Expr, ind: str) -> str {
	em.used_rt = true

	# as in c_let: the initializer names what was in scope BEFORE this binding
	if c_is_listlit(ival) {
		et := c_type(c_list_elem(eff))
		vals := c_elem_exprs(em, ival, c_list_elem(eff))
		c_add_var(em, name, eff, is_mut)
		cname := c_var_cname(em, name)
		c_pend_release(em, "&" + cname, "zrt_list_drop")
		mut out := f"{ind}zrt_list {cname}; zrt_list_init(&{cname}, sizeof({et}), &{c_elem_vt(em, c_list_elem(eff))});\n"
		return out + c_pushes_strs(cname, et, vals, ind)
	}

	# Anything else — another list, a call's result — binds through the one copy rule, the
	# same one every other site uses.
	val := c_copied(em, eff, ival, c_nosub())
	c_add_var(em, name, eff, is_mut)
	cn := c_var_cname(em, name)
	c_pend_release(em, "&" + cn, "zrt_list_drop")
	return f"{ind}zrt_list {cn} = {val};\n"
}

fn c_print(mut &em: Emitter, e: Expr, ind: str) -> str {
	ty := c_infer(em, e)

	# An optional has no display of its own: it is a value that may not be there, and what
	# to show for the absent side is the program's decision. `print x ?? "…"` or `print x!`
	# says which one was meant; printing the carrier itself used to reach cc as an integer
	# cast of a struct.
	raise f"`print` needs a value, and {ty_name(ty)} may not have one — say which with `?? …` or `!`" if c_is_opt(ty)

	# A COMPOSITE has no rendering: the structural one is `Display`'s job and this compiler
	# generates none, so the arm below cast a struct, a list or a tuple to `long long` and
	# cc reported it against C nobody wrote. `print(a, b)` is the way into this that a
	# reader does not see coming — there is no two-argument `print`, so it builds a TUPLE
	# and prints that. c_display_check is the same refusal `str(…)` already makes.
	c_display_check(em, ty)
	ex := c_expr(em, e, c_nosub())
	return match ty {
		TStr => f"{ind}printf(\"%s\\n\", {ex});\n"

		# an Err shows as what went wrong; the kind is there to be compared, not read out
		TErr   => f"{ind}printf(\"%s\\n\", ({ex}).msg);\n"
		TFloat => f"{ind}printf(\"%g\\n\", {ex});\n"
		TBool  => f"{ind}printf(\"%s\\n\", ({ex}) ? \"true\" : \"false\");\n"
		_      => f"{ind}printf(\"%lld\\n\", (long long)({ex}));\n"
	}
}

fn c_return(mut &em: Emitter, has_val: bool, e: Expr, ind: str) -> str {
	# the value is computed BEFORE the defers run, which is what makes `defer` unable to
	# change what is returned
	mut pre := ""
	if em.fn_mark != "" {
		pre = f"{ind}zrt_unwind_to({em.fn_mark});\n"
	}

	# every binding in scope gives its reference back on this path too, after the defers
	# (which may still name one) and after the return value has been computed. The whole
	# list goes: a `return` leaves the FUNCTION, and c_reset_env starts each one empty.
	pre = pre + c_release_from(em, 0, ind)

	# `return nil` is a RETURN WITH NO VALUE everywhere except where the declared result is
	# a carrier: `-> Result[nil]` wants a Left holding nil, and `-> int?` an absent one, so
	# the nil is a value there and has to travel the value path below.
	return f"{pre}{ind}return {c_carrier_fit(em, em.fn_ret, e, c_nosub())};\n" if has_val and c_is_nil_expr(e) and c_is_carrier(em.fn_ret)
	if has_val and not c_is_nil_expr(e) {
		# the returned expression's type is wanted twice — once to check it against the
		# signature, and again on the two conditions that rarely coincide, a channel return
		# type and a defer to unwind past. chk_returned answers with what it inferred, so
		# the walk happens once rather than once per asker.
		et := chk_returned(em, e)
		ret_chan := ty_is_chan(em.fn_ret)
		if ret_chan {
			c_chan_check(et, em.fn_ret, "return")
		}

		# a carrier result FITS the value rather than rendering it: `Left(v)` and `Right(e)`
		# have no type of their own to render as, so the declared result is what decides what
		# they mean — and asking c_expr first would refuse them before that happened
		# c_fit_copied, not c_expr: the caller OWNS what it is handed. c_arg copies into a
		# call so that returning a by-value local needn't copy again — but a borrowed one is
		# not a local, and `fn leak(mut &xs: list[int]) -> list[int] { return xs }` handed
		# back a second name for the caller's own buffer. It is also the site that gives a
		# bare `return []` the declared element type; without it the list had elemsz 0 and
		# every later append memcpy'd nothing.
		mut v := ""
		if ret_chan {
			v = c_expr(em, e, c_nosub())
		} else {
			v = c_fit_copied(em, em.fn_ret, e, c_nosub())
		}

		# A channel travelling OUT is a handle the caller will own, so it carries a reference
		# of its own — taken by the RETURN TYPE's direction, which is what makes
		# `fn source() -> <-chan[int] { ch := chan[int](); spawn p(ch); return ch }` work:
		# the caller gets a receive-only holder, `ch`'s own send end goes with this scope, and
		# the producer is left as the last sender. Without the copy the release below would
		# take the count the caller is about to rely on.
		if ret_chan and c_is_lvalue(e) {
			em.used_conc = true
			v = f"{c_chan_copy_fn(c_chan_dir(em.fn_ret))}({v})"
		}
		return f"{ind}return {v};\n" if pre == ""
		rt := c_type(et)
		return ind + "{ " + rt + " zgt_rv = " + v + ";\n" + pre + ind + "return zgt_rv; }\n"
	}
	return f"{pre}{ind}return;\n"
}

fn c_is_nil_expr(e: Expr) -> bool {
	return match e {
		ENil => true
		_    => false
	}
}

# Each branch is analysed from the SAME entry liveness and the two ends are joined, so a
# `del` on one arm leaves the name inconsistent rather than dead — and a use after the `if`
# gets the message that says so. With no `else`, the fall-through path is the entry state.
fn c_if(mut &em: Emitter, cond: Expr, then_body: list[Stmt], has_else: bool, else_body: list[Stmt], ind: str) -> str {
	mut out := ind + "if " + c_cond(em, cond, "an `if`") + " {\n"
	entry := c_live_save(em)
	out = out + c_block(em, then_body, ind + "    ")
	then_end := c_live_save(em)
	c_live_restore(em, entry)
	out = out + ind + "}"
	if has_else {
		out = out + " else {\n" + c_block(em, else_body, ind + "    ") + ind + "}"
	}
	c_live_merge(em, then_end)
	return out + "\n"
}

# c_iflet lowers `if v := e { … } else { … }`: run the block only on a Left, with `v`
# holding what it carried. The whole thing is wrapped in a C block so the carrier temp is
# scoped to it and two of these in a row cannot collide.
#
# The binding's C name comes from c_add_var rather than being written down here, because
# an outer `v` may already be in scope and C has no shadowing inside a function.
fn c_iflet(mut &em: Emitter, name: str, value: Expr, then_body: list[Stmt], has_else: bool, else_body: list[Stmt], ind: str) -> str {
	t := c_infer(em, value)
	raise f"NotImplemented: `if {name} := …` over a {ty_name(t)} — it binds the Left of a Result[T] or a T?" if not c_is_carrier(t)

	elem := c_carrier_elem(t)
	cn := c_carrier_of(em, t)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_il" + tag

	# the initializer is rendered BEFORE the binding enters scope, as in c_let
	val := c_expr(em, value, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, name, elem, false)

	cv := c_var_cname(em, name)
	in2 := ind + "    "
	mut out := f"{ind}{{\n{in2}{cn} {tmp} = {val};\n"
	out = out + in2 + "if (" + c_res_is_left(tmp) + ") {\n"
	out = out + in2 + "    " + c_type(elem) + " " + cv + " = " + c_res_taken(em, tmp, elem) + ";\n"
	entry := c_live_save(em)
	out = out + c_block(em, then_body, in2 + "    ")
	then_end := c_live_save(em)
	c_live_restore(em, entry)
	out = out + in2 + "}"
	if has_else {
		out = out + " else {\n" + c_block(em, else_body, in2 + "    ") + in2 + "}"
	}
	c_live_merge(em, then_end)
	c_scope_close(em, outer_scope)
	return out + "\n" + ind + "}\n"
}

fn c_for(mut &em: Emitter, has_cond: bool, cond: Expr, body: list[Stmt], ind: str) -> str {
	mut head := ind + "for (;;) {\n"
	if has_cond {
		head = ind + "while " + c_cond(em, cond, "a `for`") + " {\n"
	}
	return head + c_loop_block(em, body, ind + "    ") + ind + "}\n"
}

# c_loop_block emits a loop BODY. It exists for two things the C does not say: a loop may
# run zero times, so the body's end state joins with the entry state instead of replacing
# it — a name revoked inside a loop is INCONSISTENT after it, not dead — and this is where
# a `break` or a `continue` inside the body learns how much of the pending-release list is
# the body's own.
fn c_loop_block(mut &em: Emitter, body: list[Stmt], ind: str) -> str {
	entry := c_live_save(em)
	outer_rel := em.loop_rel
	em.loop_rel = em.rel_cnames.len()
	out := c_block(em, body, ind)
	em.loop_rel = outer_rel
	c_live_merge(em, entry)
	return out
}

# c_raise lowers `raise e` to the runtime's abort path: it unwinds to the innermost
# handler, which is an enclosing `guard`'s catching frame when there is one and the
# program's reporting root when there is not. Before this existed, `raise` parsed as
# nothing at all: the error path fell off the end of the function and the caller carried
# on with whatever was in the return register.
# c_cond renders a condition for `if` / `while`. Most expressions already come back fully
# parenthesized, and wrapping those again produces `if ((a == b))` — which the C compiler
# warns about, 112 times in one build of this compiler. That noise is not free: it is what
# a real warning has to be spotted among, and one nearly was not.
fn c_cond(mut &em: Emitter, x: Expr, site: str) -> str {
	chk_condition(em, x, site)
	rendered := c_expr(em, x, c_nosub())
	return rendered if c_is_wrapped(rendered)
	return f"({rendered})"
}

# c_ternary lowers `a if c else b`. It is its own function only so the condition can be
# checked before it is rendered — a match arm has nowhere to put a statement.
fn c_ternary(mut &em: Emitter, cond: Expr, then_e: Expr, else_e: Expr, sb: Subst) -> str {
	chk_condition(em, cond, "an `if` expression")
	return f"({c_expr(em, cond, sb)} ? {c_expr(em, then_e, sb)} : {c_expr(em, else_e, sb)})"
}

# c_is_wrapped reports whether s is enclosed by ONE pair of parentheses — its first
# character opening the pair its last character closes, rather than two adjacent groups
# like `(a) + (b)`.
fn c_is_wrapped(s: str) -> bool {
	b := list[byte](s)
	return false if b.len() < 2 or b[0] != b'(' or b[b.len() - 1] != b')'
	mut depth := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'(' {
			depth = depth + 1
		}
		if b[i] == b')' {
			depth = depth - 1
			return false if depth == 0 and i < b.len() - 1
		}
		i = i + 1
	}
	return true
}

fn c_raise(mut &em: Emitter, x: Expr, has_cause: bool, cause: Expr, ind: str) -> str {
	em.used_rt = true

	# `raise ValueError("…")` already names an Err, and so does an Err VALUE — the `e` a
	# `Right(e)` handed over. Only a bare message needs one built around it; wrapping
	# either of the others would make an Err whose payload is an Err, and re-raising a
	# caught one is the whole point of being able to bind it.
	err := c_err_value(em, x)

	# `from cause` chains: the new Err records the cause as its `unwrap()`, so a `guard`
	# reads back the whole chain rather than only its last link. The runtime builds it from
	# a MESSAGE and a cause, so an Err-valued operand hands over its message.
	return f"{ind}zrt_raise_err(zrt_err_chain({err}, {c_err_cause(em, cause)}));\n" if has_cause
	return f"{ind}zrt_raise_err({err});\n"
}

# c_err_value renders an expression AS an Err: one that already is an Err passes through,
# and anything else — a bare message — has one built around it.
fn c_err_value(mut &em: Emitter, x: Expr) -> str {
	return c_expr(em, x, c_nosub()) if c_is_err_ctor(em, x) or c_is_err_ty(c_infer(em, x))
	return f"zrt_err_new({c_expr(em, x, c_nosub())})"
}

# c_err_cause renders the `from` operand. A cause is an Err — that is what a cause chain is
# made of — and anything else is refused by name here rather than handed to the runtime as
# whatever C type it happened to be.
fn c_err_cause(mut &em: Emitter, cause: Expr) -> str {
	raise f"a `from` cause is an `Err`, and {ty_name(c_infer(em, cause))} is not one — bind the Err a `guard` gave back (`Right(e) => raise … from e`)" if not c_is_err_ctor(em, cause) and not c_is_err_ty(c_infer(em, cause))
	return c_expr(em, cause, c_nosub())
}

fn c_is_err_ctor(mut &em: Emitter, x: Expr) -> bool {
	return match x {
		ECall(nm, _) => c_err_kind(nm) > 0
		_            => false
	}
}

# c_err_kind maps a built-in error name to the kind tag the runtime carries, or 0 for a
# name that is not one. The numbers are MIRRORED from the runtime's ZRT_ERR_* enum and
# from the seed's own table, so a `raise ValueError(…)` and a runtime abort that says
# "ValueError" reify to the same kind whichever compiler built the program.
# c_err_kinds is THE table of nameable error kinds, in kind order: the i-th name has kind
# i + 1, and kind 0 is the untyped Err a bare `raise` carries. Those numbers are the
# runtime's ABI (zergrt.h's zrt_err_kind), so the ORDER here is not free.
#
# Both directions read this one list — c_err_kind maps a name to its number, and the
# prelude's zg_err_kindname maps the number back to the `Kind: ` prefix a forced Err
# reports under. A second copy is how a tenth kind arrives with half a mapping and loses
# its prefix silently, which is exactly the failure the prefix exists to prevent.
#
# The last three are the ones the concurrency chapter names. DeadlockError and
# SendOnClosedError are raised by the runtime, and StopIteration is the sentinel a clean
# channel close carries — a kind rather than a message, which is what lets a receiver tell
# an ordinary ending from a crash without matching on text.
fn c_err_kinds() -> list[str] {
	return [
		"ValueError",
		"OverflowError",
		"IOError",
		"EncodingError",
		"IndexError",
		"KeyError",
		"DeadlockError",
		"SendOnClosedError",
		"StopIteration",
		"DivideByZeroError"
	]
}

fn c_err_kind(name: str) -> int {
	kinds := c_err_kinds()
	mut i := 0
	for i < kinds.len() {
		return i + 1 if kinds[i] == name
		i = i + 1
	}
	return 0
}

# c_err_constructible splits the table in the one place it is not symmetric: every kind can
# be NAMED on the right of `is`, but StopIteration cannot be CALLED. It is the sentinel a
# clean close carries, so a program able to build one could hand a consumer a crash wearing
# the marker for an ordinary ending — and `err is StopIteration` would answer yes. Testing
# by kind is only worth more than comparing the message because this asymmetry holds.
fn c_err_constructible(name: str) -> bool {
	return name != "StopIteration"
}

# c_scope_open starts a scope and answers the one to go back to. Every construct that
# BINDS A NAME opens one, not only `c_block`: a loop variable, an `if let` binding and a
# match arm's binds all belong to their own construct, and leaving them in the enclosing
# block made them outlive it — the same defect c_in_scope exists to fix, one construct
# over — and made a later `i := …` collide with a `for i in …` that had already ended.
fn c_scope_open(mut &em: Emitter) -> int {
	outer := em.scope_cur
	em.scope_n = em.scope_n + 1
	em.scope_cur = em.scope_n
	em.open_scopes.append(em.scope_cur)
	return outer
}

# c_scope_close ends the scope c_scope_open started, given what it answered.
fn c_scope_close(mut &em: Emitter, outer: int) {
	em.scope_cur = outer
	c_ints_drop_last(em.open_scopes)
}

fn c_block(mut &em: Emitter, body: list[Stmt], ind: str) -> str {
	keep := em.rel_cnames.len()

	# a fresh id, so a name bound here is a REDECLARATION only against the other bindings
	# of this same block — not against an outer one it shadows, and not against a sibling
	# block that happens to use the same name
	outer_scope := c_scope_open(em)

	mut out := ""
	if c_has_defer(body) {
		out = c_block_marked(em, body, ind)
	} else {
		mut i := 0
		for i < body.len() {
			out = out + c_stmt(em, body[i], ind)
			i = i + 1
		}
	}

	c_scope_close(em, outer_scope)

	# a binding made in this block gives its reference back here. A `return` inside the
	# block already released everything on its way out, so what follows one is dead C.
	return out + c_scope_end(em, keep, ind)
}

# c_block_marked wraps a block that schedules a defer: a mark on entry, an unwind on the
# way out. The mark's NAME is what a return or a jump inside unwinds to, so it is saved
# and restored around the body — an inner block must not leave its own mark visible to the
# statements that follow it.
fn c_block_marked(mut &em: Emitter, body: list[Stmt], ind: str) -> str {
	tag := strconv.to_string(em.dfn_n, 10)
	mark := f"zgt_mk{tag}"
	em.dfn_n = em.dfn_n + 1
	outer_fn := em.fn_mark
	if em.fn_mark == "" {
		em.fn_mark = mark
	}
	mut out := f"{ind}size_t {mark} = zrt_scope_mark();\n"
	mut i := 0
	for i < body.len() {
		out = out + c_stmt(em, body[i], ind)
		i = i + 1
	}
	em.fn_mark = outer_fn
	return out + f"{ind}zrt_unwind_to({mark});\n"
}

# --- declaration emission ------------------------------------------------------

fn c_ret_type(fn_d: FnDecl) -> str {
	return c_type(fn_d.ret) if fn_d.has_ret and not c_is_nil_ty(fn_d.ret)
	return "void"
}

fn c_is_nil_ty(t: Ty) -> bool {
	return match t {
		TNil  => true
		TVoid => true
		_     => false
	}
}

fn c_param_types(fn_d: FnDecl) -> str {
	return "void" if fn_d.params.len() == 0
	mut out := ""
	mut i := 0
	for i < fn_d.params.len() {
		if i > 0 {
			out = out + ", "
		}
		pm := fn_d.params[i]
		mut ct := c_type(pm.ty)
		if pm.is_ref {
			ct = ct + "*"
		}
		out = out + ct
		i = i + 1
	}
	return out
}

fn c_proto(fn_d: FnDecl) -> str {
	return f"{c_ret_type(fn_d)} {c_fn_cname(fn_d.recv, fn_d.name)}({c_param_types(fn_d)});\n"
}

# c_check_loop_jump refuses a `break` or a `continue` that belongs to no loop. Without it
# the jump lowered to a bare C `break;` and the first complaint came from cc, about a file
# under .zerg-cache the programmer never wrote — `'break' statement not in loop or switch
# statement`, at a line number in generated C. The seed has always named it at the source.
#
# A `select` arm is NOT a loop: it lowers to if/else, so an arm INHERITS whatever loop it
# is written in. That is what keeps the shape the concurrency chapter is written in legal —
# `for select { … <-quit => break }` — while the same arm outside a loop is refused.
fn c_check_loop_jump(body: list[Stmt], in_loop: bool) {
	for s in body {
		match s {
			SBreak => c_loop_jump_err("break", in_loop)
			SContinue => c_loop_jump_err("continue", in_loop)
			SIf(cond, then_b, has_else, else_b) => c_check_loop_jump_two(then_b, else_b, in_loop)
			SIfLet(nm, v, then_b, has_else, else_b) => c_check_loop_jump_two(then_b, else_b, in_loop)
			SFor(is_cond, cond, body_b) => c_check_loop_jump(body_b, true)
			SForIn(nm, it, body_b) => c_check_loop_jump(body_b, true)
			SSelect(arms) => c_check_loop_jump_sel(arms, in_loop)
			_ => c_skip()
		}
	}
}

fn c_check_loop_jump_two(a: list[Stmt], b: list[Stmt], in_loop: bool) {
	c_check_loop_jump(a, in_loop)
	c_check_loop_jump(b, in_loop)
}

fn c_check_loop_jump_sel(arms: list[SelArm], in_loop: bool) {
	for a in arms {
		c_check_loop_jump(a.body, in_loop)
	}
}

fn c_loop_jump_err(kw: str, in_loop: bool) {
	return if in_loop
	raise f"`{kw}` outside of a loop: it belongs to a `for`, and a `select` arm is not one — it inherits the loop it is written in"
}

fn c_fn(mut &em: Emitter, fn_d: FnDecl) -> str {
	em.at_path = fn_d.path
	c_reset_env(em)
	c_check_loop_jump(fn_d.body, false)

	# a lambda is emitted through here in the middle of an enclosing function's expression,
	# so the enclosing return type is put back on the way out
	saved_ret := em.fn_ret
	em.fn_ret = fn_d.ret

	# the parameters bind in a scope between the module and the body, so a parameter may
	# shadow a module constant and the body may shadow a parameter — `mut n := n`
	c_scope_open(em)

	mut sig := f"{c_ret_type(fn_d)} {c_fn_cname(fn_d.recv, fn_d.name)}("
	if fn_d.params.len() == 0 {
		sig = sig + "void"
	} else {
		mut i := 0
		for i < fn_d.params.len() {
			if i > 0 {
				sig = sig + ", "
			}
			pm := fn_d.params[i]
			c_add_var(em, pm.name, pm.ty, pm.is_ref)
			if pm.is_ref {
				em.ref_names.append(pm.name)
				sig = sig + c_type(pm.ty) + "* zg_" + pm.name
			} else {
				sig = sig + c_type(pm.ty) + " zg_" + pm.name
			}
			i = i + 1
		}
	}
	sig = sig + ") {\n"

	# A BLOCK'S VALUE IS ITS LAST STATEMENT'S (docs/surface/grammar.md:396), and a function
	# body is a block. Written without a `return`, the value used to be computed and thrown
	# away: `fn(a: int) -> int { a + 5 }` emitted `(zgt_a + 5);` and then fell off the end of
	# a non-void C function, so the call answered whatever was in the return register.
	#
	# Only a trailing EXPRESSION statement is a value. A body ending in anything else while
	# declaring a result is a missing return, and is refused below rather than given one.
	mut body := fn_d.body
	if fn_d.has_ret {
		last := body.len() - 1
		if body.len() == 0 or not c_stmt_diverges(body[last]) {
			raise f"`{fn_d.name}` is declared to answer {ty_name(fn_d.ret)}, and its body falls off the end — a block's value is its last statement's, so end it with a `return` or with the expression it answers" if body.len() == 0 or not c_is_expr_stmt(body[last])

			body[last] = SReturn(true, c_expr_stmt_of(body[last]))
		}
	}
	out := sig + c_block(em, body, "    ") + "}\n\n"
	em.fn_ret = saved_ret
	return out
}

# c_body_diverges reports whether a body's last statement leaves the function — a `return`
# (unconditional), a `raise`, or an `if` whose branches all do. It is what decides whether a
# declared result still needs one.
fn c_body_diverges(body: list[Stmt]) -> bool {
	return false if body.len() == 0
	return c_stmt_diverges(body[body.len() - 1])
}

fn c_stmt_diverges(s: Stmt) -> bool {
	return match s {
		SReturn(_, _) => true
		SRaise(_, _, _) => true
		SIf(_, t, has_else, e) => has_else and c_body_diverges(t) and c_body_diverges(e)
		_ => false
	}
}

# The entry point is the FREE function `main`; a method named `main` is an ordinary method
# of its type and must not be mistaken for it, which is what the receiver test rules out.
# c_has_main reports whether a File declares the program entry. It is `pub` because the
# DRIVER asks the same question to choose what to build — a source is a module until
# something asks it to be a program — and two answers to "is this a program" would let the
# driver emit a library while the emitter writes a main wrapper.
pub fn c_has_main(f: File) -> bool {
	mut i := 0
	for i < f.fns.len() {
		return true if f.fns[i].name == "main" and f.fns[i].recv == ""
		i = i + 1
	}
	return false
}

# c_main_ret_is_int reports whether the entry point answers an `int`, which is the one
# return shape that becomes the process exit code. `-> Result[nil]` is not one of these:
# parse_type still erases it to nil, so it emits a void main and takes the nil path, which
# is the same shim the seed picks for it.
fn c_main_ret_is_int(f: File) -> bool {
	mut i := 0
	for i < f.fns.len() {
		fn_i := f.fns[i]
		if fn_i.name == "main" and fn_i.recv == "" and fn_i.has_ret {
			return match fn_i.ret {
				TInt => true
				_    => false
			}
		}
		i = i + 1
	}
	return false
}

fn c_main_has_args(f: File) -> bool {
	mut i := 0
	for i < f.fns.len() {
		return true if f.fns[i].name == "main" and f.fns[i].recv == "" and f.fns[i].params.len() > 0
		i = i + 1
	}
	return false
}

# emit_c lowers one Zerg source file to a complete C translation unit.
pub fn emit_c(src: str) -> str {
	return c_emit_file(parse(src))
}

# merge_files parses several sources (a flattened module and its imported modules) and
# returns them as one File, declarations in source order. The whole-program view every
# pass wants: the emitter lowers it, the linter walks it.
pub fn merge_files(srcs: list[str]) -> File {
	mut none: list[str] = []
	return merge_files_at(srcs, none)
}

# merge_files_at is merge_files with each source's PATH beside it, so every function it
# declares remembers the file it was written in. A whole program is one File by the time
# anything is emitted, and a diagnostic that cannot name the file is half an address; a
# short `paths` list simply leaves the rest unnamed rather than being an error.
pub fn merge_files_at(srcs: list[str], paths: list[str]) -> File {
	mut fs: list[File] = []
	mut i := 0
	for i < srcs.len() {
		mut path := ""
		if i < paths.len() {
			path = paths[i]
		}
		fs.append(parse_at(srcs[i], path))
		i = i + 1
	}
	return merge_asts(fs)
}

# emit_files lowers several sources to one C translation unit — the whole program in one
# object, which is what a single `zerg build` of an entry file produces.
pub fn emit_files(srcs: list[str]) -> str {
	mut none: list[str] = []
	return emit_files_at(srcs, none)
}

# emit_files_at is emit_files with the sources' paths, which the diagnostics need.
pub fn emit_files_at(srcs: list[str], paths: list[str]) -> str {
	mut diags: list[Diag] = []
	return emit_files_diag(srcs, paths, diags)
}

# emit_files_diag is emit_files_at that also reports what it found.
pub fn emit_files_diag(srcs: list[str], paths: list[str], mut &diags: list[Diag]) -> str {
	return c_emit_file_at(merge_files_at(srcs, paths), diags)
}

# emit_unit lowers ONE module for separate compilation, from ALREADY PARSED input: `prog`
# is the whole program, `own` the module whose bodies this unit defines. The result
# declares the program but defines only the module, so the objects of two modules that
# share an import can be linked together — which whole-program emission cannot do, since
# each object would carry its own copy of the shared module.
#
# It takes trees rather than sources because a build emits one unit per module: parsing
# the whole program again for each of them made a six-module build parse six times, and
# that, not the C compiler, was where its time went.
pub fn emit_unit(prog: File, own: File) -> str {
	mut diags: list[Diag] = []
	return emit_unit_at(prog, own, diags)
}

# emit_unit_at is emit_unit that also reports what it found. A build refuses to hand the
# C to cc when this list comes back non-empty.
pub fn emit_unit_at(prog: File, own: File, mut &diags: list[Diag]) -> str {
	return c_emit_unit(prog, own, false, diags)
}

# merge_asts joins already-parsed files into the whole-program view, in order.
pub fn merge_asts(fs: list[File]) -> File {
	mut imports: list[str] = []
	mut structs: list[StructDecl] = []
	mut enums: list[EnumDecl] = []
	mut specs: list[SpecDecl] = []
	mut impls: list[ImplDecl] = []
	mut fns: list[FnDecl] = []
	mut consts: list[Stmt] = []
	for f in fs {
		for c in f.consts {
			consts.append(c)
		}
		for im in f.imports {
			imports.append(im)
		}
		for s in f.structs {
			structs.append(s)
		}
		for e in f.enums {
			enums.append(e)
		}
		for sp in f.specs {
			specs.append(sp)
		}
		for ip in f.impls {
			impls.append(ip)
		}
		for fnd in f.fns {
			fns.append(fnd)
		}
	}
	return File(imports, structs, enums, specs, impls, fns, consts)
}

# c_emit_file lowers a parsed File. The body is generated first (so list use sets
# em.used_rt), then the header is assembled with the runtime include and the shared list
# vtable added only when the program needs them.
fn c_emit_file(f: File) -> str {
	mut diags: list[Diag] = []
	return c_emit_file_at(f, diags)
}

fn c_emit_file_at(f: File, mut &diags: list[Diag]) -> str {
	return c_emit_unit(f, f, true, diags)
}

# c_emit_unit lowers ONE compilation unit. `prog` is the whole program — every type and
# every signature, so a body can be typed and every call has a prototype — while `own` is
# the module whose function bodies this unit actually defines. Passing the same File as
# both is the whole-program build; passing a module as `own` is separate compilation, and
# the difference is the only thing that keeps two objects from defining the same symbol.
# c_emit_unit lowers a unit and REPORTS what it found: `diags` collects every ill-formed
# program finding, so a caller can refuse the whole build rather than hand cc a C file
# built out of a program that does not typecheck. It is an out-parameter rather than a
# second return value because the C is what every caller wants and the findings are what
# only the driver does.
fn c_emit_unit(prog: File, own: File, whole: bool, mut &diags: list[Diag]) -> str {
	f := prog
	mut em := Emitter([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], false, false, false, [], [], [], [], [], [], [], [], [], [], [], [], [], [], 0, [], 0, [], [], false, "", "", 0, [], [], TVoid, 0, "", 0, 0, [], 0, 0, [], [], false, 0)
	c_build_type_names(em, f)
	c_build_sigs(em, f)
	c_build_structs(em, f)
	c_build_enums(em, f)
	c_check_named_types(em, f)
	c_scan_fnptr(em, f)
	for im in f.imports {
		em.mod_names.append(c_last_segment(im))
	}

	# AFTER the tables, not inside the walk that fills them. A default is an expression, so
	# judging it asks c_infer, and c_infer asks the signature, struct and enum tables — from
	# inside c_build_sigs it would see only the declarations that happen to come EARLIER in
	# the file. `b: str = later()` was refused or accepted depending on whether `later` was
	# written above or below, which is the order-dependence the rule exists to remove.
	c_check_defaults(em, f)

	# and the specs, which need the same whole-program view for the same reason: an `impl`
	# in one file names a spec declared in another, and the driver has already merged them
	chk_spec_impls(em, f)

	mut types := ""

	# the carriers a DECLARATION names, ahead of what names them: a payload that is not a
	# declared type needs nothing before it, and one that is a struct follows that struct.
	carriers := c_carrier_decl_types(em, f)

	# the tuples a DECLARATION names go through the same dependency sweep as the enums,
	# structs and carriers: a struct field of tuple type reaches no tuple literal, and a
	# tuple holding a declared type has to come out after it
	tuples := c_tuple_decl_types(em, f)

	# the force helpers land on zg_force_fail, so it goes ahead of the FIRST carrier
	# wherever that is — here when a declaration named one, with the on-demand carriers
	# below otherwise. Exactly one of the two writes it.
	if carriers.len() > 0 {
		types = types + c_carrier_prelude()
	}
	types = types + c_type_decls(em, f, carriers, tuples)
	mut i := 0
	for i < f.enums.len() {
		types = types + c_refbox_helpers(f.enums[i])
		i = i + 1
	}

	# after the typedefs, because a helper names the struct it copies, and before the
	# prototypes and bodies, which are what call them
	types = types + c_copy_helpers(em, f)

	# the constants are declared before the prototypes, so a body may name one
	globals := c_const_globals(em, f, own, whole)
	mut protos := ""
	i = 0
	for i < f.fns.len() {
		protos = protos + c_proto(f.fns[i])
		i = i + 1
	}
	mut defs := ""
	i = 0
	for i < own.fns.len() {
		defs = defs + c_fn(em, own.fns[i])
		i = i + 1
	}
	mut mainw := ""
	if c_has_main(own) {
		# every `init()` runs before main, in the order it was declared — GRAMMAR's FIFO,
		# each once
		inits := c_const_assigns(em, f) + c_init_calls(own)
		if c_main_has_args(own) {
			# main(args): build the arg list from argv via the runtime
			em.used_rt = true
			mainw = "int main(int argc, char** argv) {\n" + inits + "    zg_main(zrt_os_args(argc, argv));\n    return 0;\n}\n"
			if em.used_conc {
				# the scheduler's program-entry shims all take a NULLARY function pointer
				# (zergrt.h) — there is no shape that carries an argument — so running
				# main(args) as coroutine 0 needs a runtime shim that does not exist yet
				raise "NotImplemented: main(args) in a program that uses concurrency"
			}
		} else if c_main_ret_is_int(own) {
			# main's value IS the exit code. Calling an `int64_t (*)(void)` through the
			# `void (*)(void)` shim was undefined behaviour AND threw the code away, so
			# every concurrent `fn main() -> int` exited 0 whatever it returned.
			mainw = "int main(void) {\n" + inits + "    return (int)zg_main();\n}\n"
			if em.used_conc {
				mainw = "int main(void) {\n" + inits + "    return (int)zrt_sched_main_int(zg_main);\n}\n"
			}
		} else {
			mainw = "int main(void) {\n" + inits + "    zg_main();\n    return 0;\n}\n"
			if em.used_conc {
				# a concurrent program runs main AS COROUTINE 0 — the scheduler drains
				# the run queue afterwards, so a fire-and-forget spawn still finishes
				mainw = "int main(void) {\n" + inits + "    return zrt_sched_main_nil(zg_main);\n}\n"
			}
		}
	}

	# A separately-compiled unit declares the WHOLE program's prototypes, and any of them
	# may name a runtime type, so it needs the runtime header even when its own bodies
	# touch nothing from it. A whole-program build still decides from use, which keeps a
	# value-only program's C free of the include.
	rt := c_needs_runtime(em) or em.used_rt or not whole
	mut hdr := "// Generated by zergc (self-host). Do not edit.\n"
	hdr = hdr + "#include <stdio.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <string.h>\n"
	if em.used_str {
		hdr = hdr + "#include <stdlib.h>\n"
	}
	if em.used_fnptr {
		hdr = hdr + c_fnptr_typedef()
	}
	if rt {
		hdr = hdr + "#include \"zergrt.h\"\n"
	}
	hdr = hdr + "\n"
	if em.used_rt {
		hdr = hdr + "static const zrt_elem_vt zg_listvt = {NULL, NULL};\n"
		hdr = hdr + "static void zg_elemcopy_list(void *dst, const void *src) { zrt_list_copy((zrt_list*)dst, (const zrt_list*)src); }\n"
		hdr = hdr + "static const zrt_elem_vt zg_listvt_list = {zg_elemcopy_list, NULL};\n"
		hdr = hdr + "static void zg_elemcopy_map(void *dst, const void *src) { zrt_map_copy((zrt_map*)dst, (const zrt_map*)src); }\n"
		hdr = hdr + "static const zrt_elem_vt zg_listvt_map = {zg_elemcopy_map, NULL};\n"
		hdr = hdr + "static zrt_list zg_empty_list(size_t esz, const zrt_elem_vt *vt) { zrt_list l; zrt_list_init(&l, esz, vt); return l; }\n\n"
	}

	# the tuple carriers found while the bodies were lowered. The ones a DECLARATION names
	# went through the type sweep instead, in dependency order among the enums, structs and
	# result carriers — c_tuple_decl registers the shape either way, so a tuple is emitted
	# exactly once whichever of the two first met it.
	mut tups := ""
	for d in em.tup_decls {
		tups = tups + d
	}
	for d in em.mvt_decls {
		tups = tups + d
	}

	# The Result carriers come LAST of the typedefs, because a carrier holds its payload
	# BY VALUE and the payload may be any of the shapes above it: a scalar, a runtime list
	# or map, a struct, an enum, a tuple. Everything it could name has been written by
	# here. The force helpers ride along with them, ahead of the bodies that call them.
	mut ress := ""
	if em.res_decls.len() > 0 and carriers.len() == 0 {
		ress = c_carrier_prelude()
	}
	for d in em.res_decls {
		ress = ress + d
	}

	# the defer thunks go AFTER the prototypes — each one calls a program function — and
	# before the bodies that schedule them
	mut dfns := ""
	for d in em.rcv_decls {
		dfns = dfns + d
	}
	for d in em.dfn_decls {
		dfns = dfns + d
	}

	# a lifted lambda is a whole function, emitted BEFORE the bodies that name it: the
	# prototypes above cover the program's own functions, not one this pass invented, so
	# the definition has to be what the use sees
	mut lams := ""
	for d in em.lam_defs {
		lams = lams + d
	}
	for d in em.diags {
		diags.append(d)
	}
	return f"{hdr}{types}{tups}{ress}{globals}{protos}\n{dfns}{lams}{defs}{mainw}"
}
