# ast — the syntax tree of the self-hosting Zerg compiler (M2).
#
# The node set covers the Zerg-boot subset the compiler is written in and the examples
# corpus targets: function declarations, the statement forms (bindings, assignment,
# print, return / return-if, if / else, for, break / continue, nop, bare expression),
# and the expression forms (literals, identifiers, unary / binary operators, calls,
# and match). Expr and Stmt are recursive enums (auto-boxed by the runtime); the parser
# builds them and the emitter walks them to C.
#
# Literal nodes keep the surface lexeme (EInt / EFloat) so numbers emit verbatim, per the
# language's literal-surface invariant; EStr keeps the decoded value and the emitter
# re-escapes it into a C string literal. The value-type node is named Ty, not Type, which
# the bootstrap reserves.

# Ty is the small set of value types the subset needs, plus TVoid for a function with no
# return and TUnknown as the inference bottom.
#
# TFn is a function's type — its parameters and its result, and only that, which is what
# the language says a function type is. It exists so a function can be held: bound to a
# name, stored in a field, passed as an argument. Only a NAMED top-level function can be
# held that way here; a closure literal captures, and capture is not in the subset.
enum Ty {
	TInt
	TFloat
	TStr
	TBool
	TNil
	TVoid
	TUnknown
	TByte
	TNamed(str)
	TList(Ty)
	TFn(list[Ty], Ty)
	TTuple(list[Ty])
	TMap(Ty, Ty)

	# TChan carries its element type and its DIRECTION — 0 bidirectional, 1 send-only
	# (`chan[T]<-`), 2 receive-only (`<-chan[T]`). A direction is a purely compile-time
	# property: all three are the same `zrt_chan*` at runtime, so it rides as a field
	# rather than as three variants that would triple every match over Ty.
	TChan(Ty, int)

	# TEither is `Either[X, Y]`, the one sum type of the value tier: a Left that is the
	# value, or a Right that is what gets propagated instead. `Result[T]` is the case whose
	# Right is `Err`, and it is spelled that way rather than held as a variant of its own —
	# two representations of one type is how an operator comes to handle a Result and miss
	# the Either it is.
	#
	# TErr is `Err` itself, the Right payload of a Result. It is the runtime's zrt_err by
	# value.
	TEither(Ty, Ty)

	# TOpt is `T?`, the optional. GRAMMAR group 8 defines it as `Either[T, nil]` — the same
	# shape as a Result with `nil` where the Err would be — so it lowers to a carrier with
	# the same tag/value layout and shares every accessor. What it does NOT share is why a
	# force fails: a Result's Right carries an Err to re-raise, and an optional's carries
	# nothing, so forcing an absent one raises a message of its own.
	TOpt(Ty)
	TErr
}

# Expr is an expression node.
enum Expr {
	EInt(str)
	EFloat(str)
	EStr(str)
	EBool(bool)
	ENil
	EIdent(str)
	EUnary(str, Expr)
	EBinary(str, Expr, Expr)
	ECall(str, list[Expr])
	EField(Expr, str)

	# EOptChain is `a?.b` (GRAMMAR group 8): read `.b` when `a` is present, else nil IN
	# PLACE — the result is itself an optional, which is what lets a chain keep going
	# without a test at every link.
	EOptChain(Expr, str)

	# ETry is `x?` (GRAMMAR group 8): unwrap the payload, or early-return the absent side
	# from the ENCLOSING function. It is the one operator that is a control transfer wearing
	# an expression's clothes, which is why the function's own result type decides whether
	# it can be written at all.
	ETry(Expr)
	EIndex(Expr, Expr)
	EMethod(Expr, str, list[Expr])
	EListLit(list[Expr])
	EConv(Ty, Expr)
	EIf(Expr, Expr, Expr)
	EMatch(Expr, list[Arm])

	# ERange is `a..b` / `a..=b`. GRAMMAR puts it between comparison and addition, so
	# `v in 0..10` reads `v in (0..10)`. `inclusive` is the `..=` form.
	ERange(Expr, Expr, bool)

	# ETuple is `(a, b)`. A tuple is read back by STATIC index — `t.0` — which parses as
	# an EField whose name is a number, so no separate access node is needed.
	ETuple(list[Expr])

	# EMapLit is `{k: v, …}` and the empty `{:}`. The keys and values are held as two
	# parallel lists, in the order they were written — a map keeps insertion order.
	EMapLit(list[Expr], list[Expr])

	# EFn is `fn(p: T) -> R { … }` in expression position. It carries what a FnDecl does
	# minus the name, because that is what it is: a function with nowhere to put its name.
	EFn(list[Param], bool, Ty, list[Stmt])

	# EChanNew is `chan[T](cap)`, and ERecv is the prefix `<-ch`. A send is a STATEMENT
	# (GRAMMAR: it yields no value), so it is in Stmt rather than here.
	EChanNew(Ty, Expr)
	ERecv(Expr)

	# EForce is `e!` — read the Left out of a Result, or re-raise the Right as an abort
	# here. It is the operator that turns "this might have ended" back into a plain value
	# for code that has nothing better to do about it than stop.
	EForce(Expr)

	# ECoalesce is `a ?? b` — the Left of `a`, or `b` when `a` is a Right. The third field
	# is the DIVERGENT form, `a ?? break` / `?? continue` / `?? return …` / `?? raise …`:
	# the spec writes `for { v := <-ch ?? break }` as the way to drain a channel, and a
	# jump is a statement, so it cannot be carried in the second field. When the third is
	# non-empty the second is ignored.
	ECoalesce(Expr, Expr, list[Stmt])

	# EGuard is `guard { … }`, and it is an EXPRESSION (GRAMMAR:614) yielding `Result[T]`
	# where T is the block's value: an abort inside the block becomes Right(err) instead of
	# ending the program, a normal completion becomes Left(v). It is the sole way back from
	# the abort tier, which is why it carries a whole block rather than an expression — the
	# thing being guarded is usually several statements.
	EGuard(list[Stmt])

	# EIs is the type test `x is Name` (GRAMMAR:219, at the comparison level and equally
	# non-associative). The right side is held as a NAME rather than a parsed Ty because
	# the grammar spells it `type-name` and nothing resolves it here — the emitter decides
	# what a name means. This phase answers only the built-in error kinds, which are the
	# one taxonomy carrying a runtime tag to compare.
	EIs(Expr, str)
}

# Arm is one match arm. `pat` selects the pattern shape: 0 = literal (match `lit` by
# equality), 1 = binding (bind the scrutinee to `bind`), 2 = wildcard `_`, 3 = enum
# constructor (`ctor` names the variant; `binds` names its payload fields). An arm may
# carry an `if` guard.
struct Arm {
	pat: int
	lit: Expr
	bind: str
	ctor: str
	binds: list[str]
	has_guard: bool
	guard_expr: Expr
	body: Expr
}

# Stmt is a statement node. Blocks are plain list[Stmt]; the `has_*` flags stand in for
# the optional parts the subset's flat enums cannot express as optionals.
enum Stmt {
	# SLet is a binding: the name, its declared type, whether one was WRITTEN, whether it
	# is `mut`, and the initializer. The two bools are in that order — has_type first —
	# which is worth saying because they are the same type and a swap type-checks.
	SLet(str, Ty, bool, bool, Expr)
	SAssign(Expr, Expr)
	SPrint(Expr)
	SReturn(bool, Expr)
	SReturnIf(Expr, Expr)
	SExpr(Expr)
	SIf(Expr, list[Stmt], bool, list[Stmt])
	SFor(bool, Expr, list[Stmt])
	SForIn(str, Expr, list[Stmt])

	# `for select { … }` — the multi-way wait as a LOOP: one ready arm per round, and the
	# loop ends when every watched receive channel has. It is its own node rather than an
	# SFor around an SSelect because the ending is the loop's, not the select's.
	SForSelect(list[SelArm])

	# SRaise is `raise e (from cause)?` (GRAMMAR group 8). The cause rides as a flag plus an
	# expression, the way every other optional part of a statement does here — the subset's
	# flat enums cannot hold an optional.
	SRaise(Expr, bool, Expr)
	SBreak
	SContinue
	SNop

	# SDefer is `defer f(a)`. GRAMMAR runs it at the enclosing BLOCK's exit, on every path
	# out, last-scheduled-first.
	SDefer(Expr)

	# SSpawn is `spawn f(a)` — fire-and-forget. SSend is `ch <- v`.
	SSpawn(Expr)
	SSend(Expr, Expr)

	# SSelect is `select { … }`. Its arms are a struct rather than four Stmt variants
	# because every arm carries the same four things in different combinations.
	SSelect(list[SelArm])

	# SDel is `del name` — it REVOKES the name, for every type alike. It used to mean
	# something else for a channel, giving up a send end while leaving the name readable;
	# that is `close(ch)` now, and a channel binding gives up what it holds when its scope
	# ends, so `del` no longer has to be pressed into either job.
	SDel(str)

	# SClose is `close(ch)` — end this stream before my scope does. It is a STATEMENT and
	# not a call: `close` is a keyword, there is no symbol to take the address of, and it
	# yields no value, so it is shaped like SDel rather than pretending to be an ECall the
	# emitter has to intercept before every dispatch.
	#
	# The bool is `defer close(ch)`: the same close, run at the enclosing block's exit on
	# every path out. It rides here rather than inside SDefer because SDefer carries an
	# EXPRESSION and this is not one — and the two lower through one callee anyway.
	SClose(Expr, bool)

	# SIfLet is `if v := e { … } else { … }` — run the block only when `e` is a Left, with
	# `v` bound to what it held. It is a statement of its own rather than an SIf over some
	# condition expression because the binding only exists inside the then-branch, which no
	# condition can express.
	SIfLet(str, Expr, list[Stmt], bool, list[Stmt])

	# SAt is a POSITION MARKER, not a statement anybody wrote: the parser puts one before
	# each statement of a block, carrying that statement's line and column. It emits
	# nothing.
	#
	# It exists because a diagnostic without a line number is half a diagnostic, and the
	# alternative — a span field on all 21 Stmt variants and all 28 Expr ones — is 239
	# match arms across this compiler for one answer. A marker travels WITH the statement
	# through every list that holds one, which a parallel table indexed by source order
	# could not: a lambda's body is emitted at a different time from where it was written,
	# and a match arm's statements are visited more than once.
	#
	# It goes BEFORE its statement, never after, so the last element of a block is still
	# the statement whose value the block answers.
	SAt(int, int)
}

# SelArm is one select arm. `op` is 0 recv, 1 send, 3 default — the same order
# the runtime's ZRT_SEL_* constants use for the first two, so the emitter maps rather
# than translates. `bind` is the receive arm's optional name ("" when absent or `_`).
pub struct SelArm {
	op: int
	bind: str
	ch: Expr
	val: Expr
	body: list[Stmt]
}

# Param is one function parameter: its name, declared type, whether it is a mutable
# reference (`mut &name: T`), which lowers to a C pointer, and an optional DEFAULT — the
# expression a call uses when it omits the argument.
#
# A default is what makes an input optional; the language has no overloading, so this is
# where the flexibility comes from. Only a self-contained constant is carried, which is
# also all the seed lowers correctly (docs/code/functions.md) — a default built from an
# operator or a call is specified to be evaluated per call and is not honoured here.
struct Param {
	name: str
	ty: Ty
	is_ref: bool
	has_def: bool
	def: Expr
}

# FnDecl is a function declaration: name, the type it is a METHOD of ("" for a free
# function), parameters, an optional return type (has_ret false means it returns nothing),
# the body block, and whether it was declared `pub`. Visibility does not change the
# emitted C — but the linter needs it: an unused PRIVATE function is dead code, while an
# unused public one is simply part of a module's interface.
#
# A method is a plain FnDecl with `recv` set. The parser flattens an `impl T { … }` block
# into these, prepending a `this: T` parameter, so the receiver is an ordinary first
# argument from here down and nothing else in the compiler has to know about impls. Only
# the C NAME differs: a free function is one flat `zg_<name>`, a method is
# `zg_<T>_<name>`, which is also what keeps a method off the flat name space a program
# shares with every module it imports.
struct FnDecl {
	name: str
	recv: str
	params: list[Param]
	has_ret: bool
	ret: Ty
	body: list[Stmt]
	is_pub: bool

	# path is the file this function was READ FROM. A diagnostic needs it, and a whole
	# program is merged into one File before emission, so by then nothing else remembers
	# which module a statement came from. It rides here rather than on the SAt marker
	# because a function comes wholly from one file — one field instead of one per
	# statement — and rides on a STRUCT rather than an enum, so it costs its construction
	# sites and no match arm anywhere.
	path: str
}

# Diag is one finding about an ill-formed program: what is wrong, and where. It is a
# VALUE rather than an abort because a compiler that dies on the first mistake makes a
# person find the second one by fixing the first — and because a renderer cannot draw a
# source line under a message that has already killed the process.
#
# `line` and `col` are 1-based and are where the STATEMENT starts; `path` is "" for a
# source parsed without one, and the renderer then says the line and column alone.
pub struct Diag {
	path: str
	line: int
	col: int
	msg: str
}

# FieldDef is one struct field: its name and declared type.
struct FieldDef {
	name: str
	ty: Ty
}

# StructDecl is a struct type declaration: its name and fields in source order.
struct StructDecl {
	name: str
	fields: list[FieldDef]
}

# VariantDef is one enum variant: its name, its payload field types (empty for a tag-only
# variant), and its DISCRIMINANT — the integer the variant is, which defaults to the
# previous one plus one (from 0) and so is its position until a declaration says otherwise.
#
# It is a field rather than the position it used to be because GRAMMAR:572 lets a fieldless
# enum spell its own values (`A = 3`), and those values are OBSERVABLE: `int(v)` reads one
# back and `E.of(n)` reverses it. A payload enum keeps its tag opaque and may not spell one.
struct VariantDef {
	name: str
	fields: list[Ty]
	tag: int
}

# EnumDecl is an enum type declaration: its name and variants in source (tag) order.
struct EnumDecl {
	name: str
	variants: list[VariantDef]
}

# File is a whole parsed source file: its import paths, and its struct, enum, and
# function declarations in source order. Imports are kept (rather than skipped with the
# rest of the out-of-subset surface) because the driver resolves them into the source
# list it compiles, and the linter reports the ones nothing uses.
pub struct File {
	imports: list[str]
	structs: list[StructDecl]
	enums: list[EnumDecl]
	fns: list[FnDecl]

	# consts are the module-level `const` bindings, each an SLet. They are not statements
	# of any function: they become C globals, assigned once before anything runs.
	consts: list[Stmt]
}

# --- rendering ---------------------------------------------------------------------------

# dump_ast renders a parsed file as an indented tree — the `--emit ast` view. It is a
# debugging aid, so it shows SHAPE rather than every payload: each declaration, and each
# statement by kind with the expression kinds under it. That is what answers "did the
# parser see what I wrote", which is the only question this view exists for.
pub fn dump_ast(f: File) -> str {
	mut out := "file\n"
	for im in f.imports {
		out = out + "\timport \"" + im + "\"\n"
	}
	for s in f.structs {
		out = out + "\tstruct " + s.name + "\n"
		for fd in s.fields {
			out = out + "\t\tfield " + fd.name + ": " + ty_name(fd.ty) + "\n"
		}
	}
	for e in f.enums {
		out = out + "\tenum " + e.name + "\n"
		for v in e.variants {
			out = out + "\t\tvariant " + v.name + "\n"
		}
	}
	for fn_d in f.fns {
		out = out + "\t" + fn_kind(fn_d) + " " + qual_name(fn_d) + "(" + params_of(fn_d) + ")"
		if fn_d.has_ret {
			out = out + " -> " + ty_name(fn_d.ret)
		}
		out = out + "\n"
		out = out + dump_block(fn_d.body, "\t\t")
	}
	return out
}

fn fn_kind(f: FnDecl) -> str {
	return "pub fn" if f.is_pub
	return "fn"
}

# qual_name shows a method as `Type.name`, so the `--emit ast` view says which impl a
# function came from — the tree is otherwise flat and two types may name a method alike.
fn qual_name(f: FnDecl) -> str {
	return f"{f.recv}.{f.name}" if f.recv != ""
	return f.name
}

fn params_of(f: FnDecl) -> str {
	mut out := ""
	mut i := 0
	for i < f.params.len() {
		if i > 0 {
			out = out + ", "
		}
		p := f.params[i]
		if p.is_ref {
			out = out + "mut &"
		}
		out = out + p.name + ": " + ty_name(p.ty)
		i = i + 1
	}
	return out
}

fn dump_block(body: list[Stmt], ind: str) -> str {
	mut out := ""
	for s in body {
		out = out + dump_stmt(s, ind)
	}
	return out
}

fn dump_stmt(s: Stmt, ind: str) -> str {
	return match s {
		SLet(name, ty, has_ty, is_mut, value) => f"{ind}let {name} = {expr_kind(value)}\n"
		SAssign(target, value) => f"{ind}assign {expr_kind(target)} = {expr_kind(value)}\n"
		SPrint(x) => f"{ind}print {expr_kind(x)}\n"
		SReturn(has_value, value) => f"{ind}return {expr_kind(value)}\n"
		SReturnIf(value, cond) => f"{ind}return-if {expr_kind(cond)}\n"
		SExpr(x) => f"{ind}expr {expr_kind(x)}\n"
		SIf(cond, then_b, has_else, else_b) => dump_if(cond, then_b, else_b, ind)
		SIfLet(name, value, then_b, has_else, else_b) => ind + "if-let " + name + "\n" + dump_block(then_b, ind + "\t") + dump_block(else_b, ind + "\t")
		SFor(is_cond, cond, body_b) => ind + "for " + expr_kind(cond) + "\n" + dump_block(body_b, ind + "\t")
		SForIn(name, iter, body_b) => ind + "for " + name + " in " + expr_kind(iter) + "\n" + dump_block(body_b, ind + "\t")
		SForSelect(arms) => ind + "for-select\n"
		SRaise(x, _, _) => f"{ind}raise {expr_kind(x)}\n"
		SBreak => ind + "break\n"
		SContinue => ind + "continue\n"
		_ => ind + "nop\n"
	}
}

fn dump_if(cond: Expr, then_b: list[Stmt], else_b: list[Stmt], ind: str) -> str {
	mut out := ind + "if " + expr_kind(cond) + "\n" + dump_block(then_b, ind + "\t")
	if else_b.len() > 0 {
		out = out + ind + "else\n" + dump_block(else_b, ind + "\t")
	}
	return out
}

# expr_kind names an expression's shape, with the leaf's own text where it has one.
fn expr_kind(e: Expr) -> str {
	return match e {
		EInt(lex) => "int " + lex
		EFloat(lex) => "float " + lex
		EStr(v) => "str"
		EBool(v) => "bool"
		ENil => "nil"
		EIdent(n) => "ident " + n
		EUnary(oper, x) => "unary " + oper
		EBinary(oper, a, b) => "binary " + oper
		ECall(name, args) => "call " + name
		EField(target, name) => "field ." + name
		EOptChain(target, name) => "optional chain ?." + name
		ETry(x) => "try `?`"
		EIndex(target, idx) => "index"
		EMethod(target, meth, args) => "method ." + meth
		EListLit(elems) => "list-literal"
		EConv(ty, x) => "convert " + ty_name(ty)
		EIf(cond, then_e, else_e) => "if-expr"
		EMatch(scrut, arms) => "match"
		ERange(lo, hi, inclusive) => "range"
		ETuple(elems) => "tuple"
		EMapLit(ks, vs) => "map-literal"
		EFn(ps, has_ret, ret, body) => "fn-expr"
		EChanNew(t, cap) => "chan-new"
		ERecv(ch) => "recv"
		EForce(x) => "force"
		ECoalesce(a, b, jump) => "coalesce"
		EGuard(body) => "guard"
		EIs(x, name) => "is " + name
		_ => "?"
	}
}

# ty_name spells a type the way the source does.
# either_name spells an Either the way it is written: the one whose Right is `Err` is
# `Result[T]`, which is the name the language gives that case.
fn either_name(l: Ty, r: Ty) -> str {
	return f"Result[{ty_name(l)}]" if is_err_ty(r)
	return f"Either[{ty_name(l)}, {ty_name(r)}]"
}

fn is_err_ty(t: Ty) -> bool {
	return match t {
		TErr => true
		_    => false
	}
}

# ty_eq is whether two types are THE SAME type. It exists because `ty_name` was being used
# for the job, and `ty_name` is the DIAGNOSTIC SPELLING of a type: it collapses TUnknown,
# TTuple and TMap onto `"?"`, so `ty_name(a) == ty_name(b)` answers yes for a tuple and a
# map, and for two tuples of different shapes. That is only safe where the spelling is
# unique — the scalars — which is why every caller of it as an equality had to restrict
# itself to those, and why a struct bound to the wrong struct still reached cc.
#
# TUnknown equals NOTHING, including itself. A type the compiler could not work out is not
# evidence that two things are the same; a caller that wants to let an unknown through says
# so itself, which is what makes this answer mean one thing.
fn ty_eq(a: Ty, b: Ty) -> bool {
	return match a {
		TNamed(an)      => ty_eq_named(an, b)
		TList(ae)       => ty_eq_list(ae, b)
		TOpt(ae)        => ty_eq_opt(ae, b)
		TMap(ak, av)    => ty_eq_map(ak, av, b)
		TChan(ae, ad)   => ty_eq_chan(ae, ad, b)
		TEither(al, ar) => ty_eq_either(al, ar, b)
		TFn(aps, ar)    => ty_eq_fn(aps, ar, b)
		TTuple(aes)     => ty_eq_tuple(aes, b)
		TUnknown        => false

		# every remaining variant is a scalar with a spelling of its own, so the name IS
		# the identity there — the one place the shortcut this function replaces was right
		_ => ty_name(a) == ty_name(b)
	}
}

fn ty_eq_named(an: str, b: Ty) -> bool {
	return match b {
		TNamed(bn) => an == bn
		_          => false
	}
}

fn ty_eq_list(ae: Ty, b: Ty) -> bool {
	return match b {
		TList(be) => ty_eq(ae, be)
		_         => false
	}
}

fn ty_eq_opt(ae: Ty, b: Ty) -> bool {
	return match b {
		TOpt(be) => ty_eq(ae, be)
		_        => false
	}
}

fn ty_eq_map(ak: Ty, av: Ty, b: Ty) -> bool {
	return match b {
		TMap(bk, bv) => ty_eq(ak, bk) and ty_eq(av, bv)
		_            => false
	}
}

# A DIRECTION is part of a channel's type: `chan[int]<-` and `<-chan[int]` are not
# interchangeable, and the emitter has its own direction check that says so more precisely.
fn ty_eq_chan(ae: Ty, ad: int, b: Ty) -> bool {
	return match b {
		TChan(be, bd) => ad == bd and ty_eq(ae, be)
		_             => false
	}
}

fn ty_eq_either(al: Ty, ar: Ty, b: Ty) -> bool {
	return match b {
		TEither(bl, br) => ty_eq(al, bl) and ty_eq(ar, br)
		_ => false
	}
}

fn ty_eq_fn(aps: list[Ty], ar: Ty, b: Ty) -> bool {
	return match b {
		TFn(bps, br) => ty_eq(ar, br) and ty_eq_all(aps, bps)
		_            => false
	}
}

fn ty_eq_tuple(aes: list[Ty], b: Ty) -> bool {
	return match b {
		TTuple(bes) => ty_eq_all(aes, bes)
		_           => false
	}
}

# ty_eq_all compares two type lists element-wise. A length mismatch is answered first, so
# the loop never indexes past either one.
fn ty_eq_all(xs: list[Ty], ys: list[Ty]) -> bool {
	return false if xs.len() != ys.len()
	mut i := 0
	for i < xs.len() {
		return false if not ty_eq(xs[i], ys[i])
		i = i + 1
	}
	return true
}

fn ty_name(t: Ty) -> str {
	return match t {
		TInt          => "int"
		TFloat        => "float"
		TStr          => "str"
		TBool         => "bool"
		TNil          => "nil"
		TVoid         => "void"
		TByte         => "byte"
		TNamed(n)     => n
		TList(e)      => f"list[{ty_name(e)}]"
		TFn(ps, r)    => f"fn({ty_names(ps)}) -> {ty_name(r)}"
		TChan(e, dir) => chan_ty_name(e, dir)
		TEither(l, r) => either_name(l, r)
		TOpt(e)       => f"{ty_name(e)}?"
		TErr          => "Err"
		_             => "?"
	}
}

# ty_is_chan / ty_chan_elem are the two shape questions asked about a channel type, and
# they live here — beside the spelling — because both the parser and the emitter ask them.
# The parser needs them to read the directional forms and the emitter needs them on nearly
# every lowering path; a type is a type, and one pair is what keeps the two from drifting.
fn ty_is_chan(t: Ty) -> bool {
	return match t {
		TChan(_, _) => true
		_           => false
	}
}

fn ty_chan_elem(t: Ty) -> Ty {
	return match t {
		TChan(e, _) => e
		_           => TUnknown
	}
}

# chan_ty_name spells a channel end the way the source does, direction and all, so a
# diagnostic about one can say which end it is talking about.
fn chan_ty_name(elem: Ty, dir: int) -> str {
	return f"chan[{ty_name(elem)}]<-" if dir == 1
	return f"<-chan[{ty_name(elem)}]" if dir == 2

	return f"chan[{ty_name(elem)}]"
}

fn ty_names(ts: list[Ty]) -> str {
	mut out := ""
	mut i := 0
	for i < ts.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + ty_name(ts[i])
		i = i + 1
	}
	return out
}
