# `zerg doc`. What a module exposes is `zerg/doc.zg`'s answer and how it is laid out is
# `doc_render.zg`'s; what is here is the command — the four things a reader may name, the rule
# that tells them apart, and the sentence for a name that is none of them.
#
# THE FOUR FORMS, and they are read in this order:
#
#     zerg doc                  the modules that can be read
#     zerg doc strings          that module's whole document
#     zerg doc --brief strings  its exposed surface, one line each
#     zerg doc strings.split    one declaration — `log.Logger.level` for a method
#     zerg doc path/to/file.zg  a file or a directory, documented where it stands
#
# Each of them is the READER'S document — the `##` lines of every comment — unless `--all` asks
# for the maintainer's, which is every comment as written (#18). A listing is the reader's
# alone, so `--all` beside `--brief`, `--check` or no name at all is refused rather than
# ignored: a flag that changes nothing on the page it was given to is a question the reader
# believes was answered.
#
# A PATH IS RECOGNISED FIRST, and only when it exists: a name carrying a `/` or ending in `.zg`
# that names nothing on disk is not a path, it is a mistake, and it falls through to the same
# refusal every other unknown name gets. Then a whole module, because that is the common
# question and `strings` is not a declaration of anything. Only then is the name split, and
# what is left over is a name nothing answers.
#
# NOTHING HERE BUILDS ANYTHING. `module_sources` resolves by name without the three checks an
# import is held to, so a module that ships and cannot be compiled is still a module that can
# be read — `atomic` is the one, and its header comes out of the token stream while its
# declarations are reported missing. The document of a module nobody can import is the only
# documentation that module has.

import "./diag"
import "./doc_render"
import "./doc_run"
import "./layout"
import "./source"
import "./test"
import "./test_fixture"
import "./test_pkg"
import (
	"cli"
	"io"
	"strconv"

	"/zerg"
)

pub fn doc_cmd() -> cli.Command {
	return (
		cli.command("doc", "read what a module exposes and the comments that document it")
		.flag("a", "all", "every comment as written, the maintainer's `#` notes beside the reader's `##` text")
		.flag("b", "brief", "one line for each declaration instead of the whole comment")
		.flag("c", "check", "name the exposed declarations that carry no `##` comment, run every example, and exit 1 if anything is missing or wrong")
		.opt("t", "timeout", "under --check, seconds one module's examples may take to build, and then to run", f"{test.TEST_TIMEOUT}")
		.add(cli.positional("name", "a module, one of its declarations, or a path to a source"))
		.run(do_doc)
	)
}

fn do_doc(c: cli.Ctx) -> int {
	raise doc_all_alone(c) if c.has("all") and (c.has("brief") or c.has("check") or c.args().len() == 0)
	return run_doc_check(c.args(), doc_timeout(c.get("timeout"))) if c.has("check")

	return run_doc(c.args(), doc_render.DocView(c.has("brief"), c.has("all")))
}

# doc_all_alone is the refusal for `--all` where it would change nothing: every listing — the
# index, `--brief`, and what `--check` counts — is the reader's `##` text and nothing else.
fn doc_all_alone(c: cli.Ctx) -> str {
	mut what := "the index of modules"
	if c.has("brief") {
		what = "`--brief`'s summary"
	} else if c.has("check") {
		what = "what `--check` counts"
	}
	return f"`--all` is the maintainer's page for one module, declaration or path, and has nothing to add to {what}, which reads the `##` text alone"
}

# run_doc answers the one thing that was asked for, and writes it once.
#
# ONE NAME AT A TIME. `zerg doc strings os` would have to decide whether that is two documents
# or one, and neither answer is worth a flag: what a reader wants from two modules is two runs,
# and what a script wants is a loop.
#
# The device is asked ONCE, here, and handed down as a value. A renderer that asked for itself
# would be a function whose answer depends on where the process's output happens to be pointed,
# which is exactly the function a test cannot ask anything of.
fn run_doc(args: list[str], v: doc_render.DocView) -> int {
	raise "`zerg doc` reads one thing at a time — a module, one of its declarations, or a path" if args.len() > 1

	col := doc_render.doc_colour()
	if args.len() == 0 {
		io.write(doc_render.render_doc_list(doc_index(), col))
		return 0
	}

	name := args[0]
	if doc_is_path(name) {
		files := doc_path_files(name)
		raise doc_no_source(name) if files.len() == 0

		io.write(doc_render.render_doc_module(doc_read(doc_path_name(name), files), v, col))
		return 0
	}

	whole := source.module_sources(name, ".", ".")
	if whole.len() > 0 {
		io.write(doc_render.render_doc_module(doc_read(source.path_tail(name), whole), v, col))
		return 0
	}

	return run_doc_decl(name, v.all, col)
}

# run_doc_check is `--check`: the document read for what is MISSING from it, rather than for
# what is in it. Every exposed declaration whose comment is empty is named, at the place it
# was declared, and the run exits 1 if there were any.
#
# EMPTY MEANS NO `##` LINE (#18). A declaration with `#` notes above it and no reader text is
# undocumented to every reader the page has, and this is where a `##` forgotten on a whole
# comment is caught — the page would otherwise go quietly blank under the signature.
#
# THE MARK ALREADY EXISTED and this is not a second copy of it. `zerg doc strings` renders
# `(undocumented)` beside such a declaration, which is how a READER meets one — in the middle
# of the document, one module at a time, with no place to jump to. What did not exist was a
# way to ASK: `make doc-check` pinned the count at 18 and asserted it as an equality, which
# catches the number moving and cannot catch it staying still. Write a comment for one
# declaration and add a bare `pub` somewhere else in the same change and the pin is satisfied
# by two errors cancelling. A list of NAMES cannot be satisfied that way, and a name with a
# `path:line` in front of it is the difference between a count and a work item.
#
# A FILE THAT DID NOT PARSE IS A FINDING HERE, not a note. Everywhere else in this command an
# unreadable file is reported and the document is rendered around it, because a partial
# document is worth more than none. `--check` is the one caller that must not do that: its
# whole answer is "nothing is missing", and a module whose declarations never reached the
# document would answer it by having nothing to report. `atomic` is that module today.
#
# DECLARATIONS, NOT MEMBERS. A struct's fields and an enum's variants each carry their own
# comment and neither is marked in the rendering, so checking them here would report work
# nothing else in this tree calls owed. The rule this holds is the one the document already
# states about itself.
fn run_doc_check(args: list[str], secs: int) -> int {
	raise "`zerg doc --check` reads one thing at a time — a module, or a path" if args.len() > 1

	mut mods: list[zerg.DocModule] = []
	if args.len() == 0 {
		mods = doc_index()
	} else {
		mods.append(doc_check_one(args[0]))
	}

	mut out := ""
	mut total := 0
	mut undoc := 0
	mut unread := 0
	mut ran := 0
	mut wrong := 0
	mut strays := 0
	tmp := doc_run.example_dir()
	for m in mods {
		for f in m.files {
			if not f.ok {
				out = out + f"{f.path}: does not parse, so what it exposes is in no document\n"
				unread = unread + 1
			}
		}
		for d in m.decls {
			total = total + 1
			if d.doc.len() == 0 {
				out = out + f"{d.path}:{d.line}: `{doc_check_name(m, d)}` is exposed and carries no `##` comment\n"
				undoc = undoc + 1
			}
		}
		for s in m.strays {
			out = out + doc_stray_says(s)
			strays = strays + 1
		}
		bad := doc_run.run_examples(m, tmp, secs, ran)
		if bad != "" {
			out = out + bad
			wrong = wrong + 1
		}
	}
	doc_run.drop_dir(tmp)

	io.write(out)
	io.write(f"{total} exposed declarations, {undoc} of them undocumented, {unread} file(s) unreadable, {strays} fence(s) not recognised, {ran} example line(s) run, {wrong} module(s) whose examples are wrong\n")
	return 1 if undoc + unread + strays + wrong > 0

	return 0
}

# doc_stray_says is the finding for a fence line nothing ran — an orphaned ` ```output ` fence
# named as that, and a misspelled fence as one.
fn doc_stray_says(s: zerg.DocStray) -> str {
	return f"{s.path}:{s.line}: an output fence with no example above it, so nothing is held to it\n" if s.orphan
	return f"{s.path}:{s.line}: an example marked `##` on some of its lines and `#` on others, so the reader is shown part of what was run\n" if s.mixed

	return f"{s.path}:{s.line}: `{s.text}` is shaped like an example fence and is not one — a fence is exactly ```zerg or ```output after the `# `, so nothing ran it\n"
}

# doc_timeout reads `--timeout`, and refuses what is not a whole number of seconds from one up.
# `int_of` would have read `abc` as the default and `0` as a limit every example outlasts, and
# both are a typo that should be said rather than run.
fn doc_timeout(v: str) -> int {
	why := f"`--timeout` is a whole number of seconds, one or more — `{v}` is not"
	b := bytearray(v)
	raise why if b.len() == 0 or b.len() > 9
	for x in b {
		raise why if x < b'0' or x > b'9'
	}
	n := strconv.parse_int(v, 10)
	raise why if n < 1

	return n
}

# doc_check_one resolves the one name `--check` was given, by the same two doors `run_doc`
# opens and in the same order — a path that is really there, then a module — so that a name
# which reads one way for `zerg doc` cannot read another way for `zerg doc --check`.
fn doc_check_one(name: str) -> zerg.DocModule {
	if doc_is_path(name) {
		files := doc_path_files(name)
		raise doc_no_source(name) if files.len() == 0

		return doc_read(doc_path_name(name), files)
	}

	whole := source.module_sources(name, ".", ".")
	raise doc_no_such(name) if whole.len() == 0

	return doc_read(source.path_tail(name), whole)
}

# doc_check_name spells a declaration the way a reader would type it back into `zerg doc`,
# which is the same spelling `doc_no_decl` lists and the same key `doc_find` reaches.
fn doc_check_name(m: zerg.DocModule, d: zerg.DocDecl) -> str {
	return f"{m.name}.{d.name}" if d.recv == ""

	return f"{m.name}.{d.recv}.{d.name}"
}

# run_doc_decl reads `module.declaration`, which is the form left once the name has resolved to
# neither a path nor a module.
#
# IT SPLITS AT THE FIRST `.`, not the last. A method is asked for as `log.Logger.level`, and the
# module is the first segment of that: splitting at the last one leaves `log.Logger`, which
# resolves to nothing and turns a question with an answer into a refusal. What follows the first
# dot is handed to `doc_find` exactly as written, because `Logger.level` is the same key the
# renderer groups a method under — one spelling of a method, in the tool and in the document.
#
# ONE NAME MAY BE TWO DECLARATIONS, and both are printed. `doc_find` answers every declaration
# with the key rather than the first in source order, because a module may declare `pub struct
# Pair` and `pub fn Pair` — the language keeps them apart by position and `zerg lint` accepts
# it — and a page that showed the struct alone would be a document with a declaration missing
# and nothing said about it.
#
# `--brief` is not read here. A single declaration is shown whole, which is what a reader asking
# for one wants; brief is what shortens a LISTING, and a listing of one is the thing itself.
fn run_doc_decl(name: str, all: bool, col: bool) -> int {
	at := doc_first_of(name, b'.')
	raise doc_no_such(name) if at < 0

	b := bytearray(name)
	mod := diag.line_slice(b, 0, at)
	key := diag.line_slice(b, at + 1, b.len())

	files := source.module_sources(mod, ".", ".")
	raise doc_no_such(name) if files.len() == 0

	m := doc_read(source.path_tail(mod), files)
	hits := zerg.doc_find(m, key)
	raise doc_no_decl(m, key) if hits.len() == 0

	io.write(doc_render.render_doc_decls(m, hits, all, col))
	return 0
}

# --- what was named ---------------------------------------------------------------------------

# doc_is_path reports whether the name is a path that is really there. Both halves matter: a
# bare `strings` is a module however many files of that name exist elsewhere, and a
# `notes/draft.zg` that has been deleted is not a path this can read.
fn doc_is_path(name: str) -> bool {
	return false if not layout.has_suffix(name, ".zg") and doc_first_of(name, b'/') < 0

	return __zrt_exists(name)
}

# doc_path_files is the sources a path names, resolved by `module_at` and not by a listing of
# its own: what makes a directory of `.zg` files a module — and which of them are left out —
# is written down once, in `source.zg`, and a second copy here would be the one that forgets
# about test files the day the convention moves.
fn doc_path_files(name: str) -> list[str] {
	p := doc_no_slash(name)
	return source.module_at(layout.dir_of(p), doc_path_name(name))
}

# doc_path_name is what the document is titled when a path was named: the last segment with the
# `.zg` taken off, which is the name that path would be imported by.
fn doc_path_name(name: str) -> str {
	seg := source.path_tail(doc_no_slash(name))
	return test_pkg.drop_suffix(seg, ".zg") if layout.has_suffix(seg, ".zg")

	return seg
}

# doc_no_slash drops the trailing slashes a shell's completion leaves on a directory, so that
# `src/compiler/cmd/` and `src/compiler/cmd` are one question.
fn doc_no_slash(path: str) -> str {
	b := bytearray(path)
	mut hi := b.len()
	for hi > 1 and b[hi - 1] == b'/' {
		hi = hi - 1
	}
	return diag.line_slice(b, 0, hi)
}

# doc_first_of is where `c` first appears in a name, or -1. Two questions are asked of it —
# where the module name ends, and whether the name carries a path separator at all — and they
# are one scan rather than two because the second differs from the first only in the byte.
fn doc_first_of(name: str, c: byte) -> int {
	b := bytearray(name)
	mut i := 0
	for i < b.len() {
		return i if b[i] == c
		i = i + 1
	}
	return -1
}

# --- reading -------------------------------------------------------------------------------

# doc_read is the extraction, given the files: their text and their paths, row for row, which
# is the pairing `doc_module` attaches a comment with and names a file it could not parse by.
fn doc_read(name: str, files: list[str]) -> zerg.DocModule {
	mut srcs: list[str] = []
	mut paths: list[str] = []
	for f in files {
		srcs.append(source.read_source(f))
		paths.append(f)
	}
	return zerg.doc_module(name, srcs, paths)
}

# doc_index is every module that can be read, extracted. It is the whole standard library and
# whatever modules stand beside the reader, which is exactly the list the refusal names — one
# answer to "what is there", so a name that is turned away is turned away against the same
# listing `zerg doc` on its own prints.
fn doc_index() -> list[zerg.DocModule] {
	mut out: list[zerg.DocModule] = []
	for n in doc_module_names() {
		files := source.module_sources(n, ".", ".")
		if files.len() > 0 {
			out.append(doc_read(n, files))
		}
	}
	return out
}

# doc_module_names is what `module_sources` can resolve, in the order a reader cares about it:
# the modules beside them first, then the standard library. A name in both is one module — the
# nearer one, which is the one `module_sources` would have resolved.
fn doc_module_names() -> list[str] {
	mut out: list[str] = []
	for n in source.local_modules(".") {
		out.append(n)
	}
	for n in source.stdlib_modules() {
		if not test_fixture.str_in(out, n) {
			out.append(n)
		}
	}
	return out
}

# --- refusals -------------------------------------------------------------------------------

# doc_no_such is the sentence for a name that is not a path, not a module, and not a module's
# declaration. It LISTS WHAT CAN BE READ, because the failure is almost always a name the reader
# guessed and the answer is almost always in that list — and because the alternative, letting
# the resolution reach the loader, would report `E5002 cannot resolve import` about an import
# nobody wrote.
fn doc_no_such(name: str) -> str {
	return f"nothing here is called `{name}` — `zerg doc` reads a module (`strings`), one of its declarations (`strings.split`, `log.Logger.level`), or a path to a source file" + doc_can_see()
}

# doc_no_source is the refusal for a path that IS there and holds nothing this can read: a
# directory with no `.zg` file in it, or one whose only sources are test files.
#
# IT USED TO PRINT NOTHING AND EXIT 0. `module_at` answered an empty list, `doc_read` built a
# `DocModule` with no files, and the renderer had no file to render — so `zerg doc docs/`,
# `zerg doc mk/` and `zerg doc ./` each wrote zero bytes and reported success. That is the one
# thing this tool's extractor says in as many words it is not (zerg/doc.zg: "silent about what
# it could not read"), and a trailing slash left by a shell's completion is how a reader
# arrives at it.
#
# It ends with the same listing every other refusal ends with, because the reader who typed a
# directory meant to read something and the something is almost always on it.
fn doc_no_source(name: str) -> str {
	return f"`{name}` holds no source `zerg doc` can read — a directory is read as the module it would be, which is its `.zg` files, and a `*_test.zg` is on no module's surface" + doc_can_see()
}

# doc_can_see is the listing both refusals end with. It is one function because the two
# sentences differ and the list under them must not: a name turned away by either is turned
# away against exactly the index `zerg doc` on its own prints.
fn doc_can_see() -> str {
	mut out := "\n\nthe modules it can see:"
	for n in doc_module_names() {
		out = out + "\n  " + n
	}
	return out
}

# doc_no_decl is the same courtesy one level down: the module was found and the declaration was
# not, so what is listed is what that module declares. A field is deliberately not among them —
# `doc_find` reaches declarations, and a field is shown inside the entry for the type that holds
# it.
#
# A FILE THAT DID NOT PARSE IS SAID SO HERE TOO. `zerg doc atomic.load` answered "the module
# `atomic` declares nothing called `load`" and then listed nothing at all, which is a sentence
# about a module whose declarations are MISSING read as one about a module that has none. The
# whole-module path has printed that note since it was written (`doc_note`); this one is the
# same module reached by the other door, so it is the same note, from the same function.
#
# The listing is left off entirely when there is nothing in it, because "what it does declare:"
# above an empty list is the claim the note has just corrected.
fn doc_no_decl(m: zerg.DocModule, key: str) -> str {
	mut out := f"the module `{m.name}` declares nothing called `{key}`"
	for f in m.files {
		if not f.ok {
			out = out + "\n\n" + doc_render.doc_note_text(f)
		}
	}
	return out if m.decls.len() == 0

	out = out + "\n\nwhat it does declare:"
	for d in m.decls {
		if d.recv == "" {
			out = out + f"\n  {m.name}.{d.name}"
		} else {
			out = out + f"\n  {m.name}.{d.recv}.{d.name}"
		}
	}
	return out
}
