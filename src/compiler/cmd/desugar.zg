# `zerg desugar`. The rewrite is `zerg/desugar.zg`'s; what is here is the command and the
# gate a source has to pass before it is rewritten — a file of its own beside `fmt.zg`, for
# the reason `zergc.zg` gives for the command being beside `fmt`.

import "./diag"
import "./source"
import "./walkdir"
import (
	"cli"
	"io"

	"/zerg"
)

# desugar takes the same two flags `fmt` does, and they mean the same things: `--check`
# asks the question without touching anything, and `--off` names a rule to leave alone.
pub fn desugar_cmd() -> cli.Command {
	return (
		cli.command("desugar", "rewrite sources into the core forms their sugar is defined as")
		.flag("c", "check", "report what is not already core and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. D103; repeatable").repeated())
		.add(cli.positional("path", "a `.zg` file, or a directory whose tree is rewritten").required().repeated())
		.run(do_desugar)
	)
}

fn do_desugar(c: cli.Ctx) -> int {
	# A PATH, NOT ONLY A FILE — see `do_fmt`.
	files := walkdir.sources_from(c.args())

	return walkdir.NOTHING_FOUND if files.len() == 0

	return run_desugar_check(files, c.all("off")) if c.has("check")

	run_desugar(files, c.all("off"))
	return 0
}

# run_desugar rewrites each source into the core forms its sugar is defined as. It is
# `run_fmt` with the other pass, except for the gate a source has to pass first: see
# desugar_reads.
#
# It writes IN PLACE, like `zerg fmt`, because the thing that runs it is a gate over a
# whole tree rather than a person over one file — `make desugar` copies the corpus and
# desugars the copy. Undoing the sugar in a source somebody is keeping is not what this is
# for, and the docs say so.
fn run_desugar(files: list[str], off: list[str]) {
	for f in files {
		src := source.read_source(f)
		desugar_reads(src, f)

		out := zerg.desugar_src_off(src, off, f)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# desugar_reads ends the run, with the finding `zerg build` would report, when a source is not
# a program — before anything is rewritten, so the file is left exactly as it was found.
#
# It lexes first, for the reason `zerg fmt` does: this rewrite is made out of the token stream
# too, so text the lexer could not read is text the output would not carry.
#
# THEN IT PARSES, which is where it asks more than fmt. fmt stops at bracket balance because a
# formatter has to work on source the compiler cannot read, and its rules are about spacing.
# Every D rule is a claim that two spellings are the SAME PROGRAM, and a file the parser
# refuses is no program to be the same as. The balance gate let one through: `assert s == "…",
# f"bad {s}"` is E2005, and D104 read the `,` into the condition and wrote `if not (zga == "…",
# "bad " + str(s))` — a tuple condition the compiler refused a second time, as E3048, about a
# line the user never wrote. The parse is not guarded: its refusal is the answer.
fn desugar_reads(src: str, f: str) {
	diag.lex_check(src, f)
	zerg.parse_at(src, f)
}

# run_desugar_check is the question `make desugar`'s fixpoint gate asks: is there any sugar
# left in this file. A desugared source that desugars again to something else would mean
# one of these rules produces what another one rewrites, which is the one way a pass like
# this can be wrong without any program behaving differently.
#
# IT COMPARES TWO FORMATTED TEXTS, and that is the whole of what makes the answer be about
# sugar. What `zerg desugar` WRITES is canonical-formatted core, so comparing it against the
# raw source asked a wider question than the flag does: a file holding no sugar at all failed
# when its whitespace was not what `zerg fmt` would produce, and it failed saying "still
# holds sugar", which is a sentence that sends the reader looking for something that is not
# there. A four-space-indented `fn main() { x := 1 }` was the whole reproduction.
#
# `desugar_print_only` is that same pass with every D rule declined, so what is left between
# the two texts is exactly the rewriting. It is NOT `zerg fmt`: that runs F401, which rewrites
# `if not (c) { raise x }` back into `raise x if not (c)` — the very form D104 desugars — so
# comparing against it failed a correctly desugared source for having been desugared. The
# `test-data/desugar` fixpoint case found that within one gate run of the first attempt.
fn run_desugar_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := source.read_source(f)
		desugar_reads(src, f)
		if zerg.desugar_src_off(src, off, f) != zerg.desugar_print_only(src) {
			io.ewrite(f"{f}: still holds sugar (run `zerg desugar`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}
