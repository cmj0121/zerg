# lib — one public function and one module-private helper. A cross-module reference
# to the private helper is a compile error (Phase 1g visibility enforcement).
pub fn public_fn() -> int {
	return 1
}

# helper is module-private: reachable only inside lib, never as lib.helper. Every module
# still flattens into one C namespace — what decides the question is the DIRECTORY each
# declaration was read from, compared with the directory doing the reading.
fn helper() -> int {
	return 2
}
