# 17 — Integer arithmetic is checked.
#
# `+`, `-`, `*` and unary `-` RAISE on overflow; the `%`-suffixed `+%`, `-%`, `*%`
# and `-%` wrap instead — that pairing is why the language has two of each, and it
# meant nothing while both emitted the same C. `/` and `%` are Euclidean, so the
# remainder is never negative and `a % n` is a valid index whatever the sign of
# `a`. A zero divisor and a shift outside the type's width raise.
#
# Every one of these was C's undefined behaviour before: a wrong answer with no
# diagnostic, from an operator that had no defined answer to give.
#
# It ASSERTS rather than prints, because `make examples` gates on the exit status,
# and `guard { … } ?? d` is how a raise is demoted to a value here.
# A zero divisor raises a kind of its own, and `is` is how a program tells it from an
# overflow — the one distinction a caller of `guard` has any reason to make here.
import "strconv"

fn kind_of(e: Err) -> str {
	return "divzero" if e is DivideByZeroError
	return "overflow" if e is OverflowError

	return "other"
}

fn check_str(what: str, got: str, want: str) {
	raise f"{what}: got {got}, want {want}" if got != want
}

fn check(what: str, got: int, want: int) {
	raise f"{what}: got {got}, want {want}" if got != want
}

fn main() {
	mut max := 9223372036854775807
	mut min := max
	min = -% max
	min = min -% 1

	# overflow raises, and the wrapping form still wraps
	check("max + 1 raises", guard {
			max + 1
		} ?? 7, 7)
	check("min - 1 raises", guard {
			min - 1
		} ?? 7, 7)
	check("mul raises", guard {
			max * 2
		} ?? 7, 7)
	check("neg of min raises", guard {
			-min
		} ?? 7, 7)
	check("max +% 1 wraps", max +% 1, min)
	check("min -% 1 wraps", min -% 1, max)

	# ordinary arithmetic is untouched
	check("addition", 2 + 3, 5)
	check("precedence", 2 + 3 * 4 - 1, 13)

	# Euclidean: the remainder is never negative, for either sign of the divisor
	mut a := 0 - 7
	check("-7 % 3", a % 3, 2)
	check("-7 / 3", a / 3, 0 - 3)
	mut b := 0 - 3
	check("7 % -3", 7 % b, 1)
	check("7 / -3", 7 / b, 0 - 2)
	check("7 % 3", 7 % 3, 1)
	check("the identity holds", (a / 3) * 3 + a % 3, a)

	# a zero divisor, and the one division that overflows
	mut zero := 0
	check("a / 0 raises", guard {
			7 / zero
		} ?? 7, 7)
	check("a % 0 raises", guard {
			7 % zero
		} ?? 7, 7)
	mut neg1 := 0 - 1
	check("min / -1 raises", guard {
			min / neg1
		} ?? 7, 7)
	check("min % -1 is zero", min % neg1, 0)

	# a shift outside the width, at both ends
	check("1 << 64 raises", guard {
			1 << 64
		} ?? 7, 7)
	check("1 << 62", 1 << 62, 4611686018427387904)
	check("int >> is arithmetic", (0 - 8) >> 1, 0 - 4)

	# a byte stays a byte, so its overflow is a byte's
	check("byte 100+100", int(byte(100) + byte(100)), 200)
	check(
		"byte 255+255 raises",
		int(
			guard {
				byte(255) + byte(255)
			} ?? byte(7)
		),
		7
	)
	check("byte << 8 raises", int(guard {
				byte(1) << 8
			} ?? byte(7)), 7)
	check("byte 200/3", int(byte(200) / byte(3)), 66)
	check("byte 200%3", int(byte(200) % byte(3)), 2)
	mut zbyte := byte(0)
	check("byte / 0 raises", int(guard {
				byte(1) / zbyte
			} ?? byte(7)), 7)
	mut five := byte(5)
	check("negating a byte raises", int(guard {
				-five
			} ?? byte(7)), 7)

	# the two kinds are distinguishable, which is what makes them worth reifying
	check_str(
		"a zero divisor",
		kind_of(
			match guard {
				7 / zero
			} {
				Left(_)  => ValueError("did not raise")
				Right(e) => e
			}
		),
		"divzero"
	)
	check_str(
		"an overflow",
		kind_of(
			match guard {
				max + 1
			} {
				Left(_)  => ValueError("did not raise")
				Right(e) => e
			}
		),
		"overflow"
	)

	# A loop over an INCLUSIVE range ending at the maximum has no value to step to after
	# the last one. Both compilers wrote `v++` there, which is the same signed overflow
	# every operator above now refuses — and it ran forever rather than once.
	mut steps := 0
	for i in max..=max {
		steps = steps + 1
	}
	check("an inclusive range ending at the maximum runs once", steps, 1)

	mut ord := 0
	for i in 1..=3 {
		ord = ord * 10 + i
	}
	check("an ordinary inclusive range is unchanged", ord, 123)

	# The stdlib's two digit-peeling loops were written against C's TRUNCATING division:
	# they read `v % 10` as a signed digit and `v / 10` as a step toward zero. Under the
	# Euclidean rule neither holds — `-1 / 10` is -1 — so both looped forever on any
	# negative input, and no gate called them with one.
	check_str("write_int is not the only caller of /", strconv.to_string(-42, 10), "-42")
	check_str("a negative in another base", strconv.to_string(-255, 16), "-ff")
	check_str("the bottom of the range renders", strconv.to_string(min, 10), "-9223372036854775808")
	check_str("zero is unchanged", strconv.to_string(0, 10), "0")
	check_str("a positive is unchanged", strconv.to_string(255, 16), "ff")

	# parse_int built the magnitude up and negated it at the end, which cannot represent
	# the minimum: "-9223372036854775808" is a legal `int` whose positive form is not one.
	# It reached the right answer only because the overflow wrapped twice. Accumulating
	# downward reaches every value in range — and an input past either end now raises
	# rather than silently becoming a different number.
	check("the bottom of the range parses", strconv.parse_int("-9223372036854775808", 10), min)
	check("the top of the range parses", strconv.parse_int("9223372036854775807", 10), max)
	check("an ordinary negative parses", strconv.parse_int("-42", 10), 0 - 42)
	check("another base parses", strconv.parse_int("-ff", 16), 0 - 255)
	check(
		"one past the top raises",
		guard {
			strconv.parse_int("9223372036854775808", 10)
		} ?? 7,
		7
	)
	check(
		"one past the bottom raises",
		guard {
			strconv.parse_int("-9223372036854775809", 10)
		} ?? 7,
		7
	)

	# `//` is the same Euclidean division, spelled so the reader sees an integer whatever
	# the operands are. On two ints it IS `/` — one integer division, not two rules — and
	# on two floats it lands in `int` without an `int(...)` round trip.
	check("7 // 2", 7 // 2, 7 / 2)
	check("a negative dividend", a // 3, a / 3)
	check("a negative divisor", 7 // b, 7 / b)

	mut f75 := 7.5
	mut f2 := 2.0
	mut fneg2 := 0.0 - 2.0
	check("7.5 // 2.0", f75 // f2, 3)
	check("-7.5 // 2.0", (0.0 - f75) // f2, 0 - 4)
	check("7.5 // -2.0", f75 // fneg2, 0 - 3)
	check("-7.5 // -2.0", (0.0 - f75) // fneg2, 4)
	check("a zero divisor still raises", guard {
			7 // zero
		} ?? 7, 7)
	mut fzero := 0.0
	check("a zero float divisor raises", guard {
			f75 // fzero
		} ?? 7, 7)

	# mixed operands: an untyped integer literal adopts the float context, and the
	# operation is the float one. Handing the emitter the LEFT operand's type instead of
	# the result's sent this through the checked integer path, which truncated the 7.5 on
	# the way in and printed a denormal.
	check_str("a literal adopts the float context", f"{0 - 7.5}", "-7.5")
	check_str("and on the right too", f"{1 + 2.5}", "3.5")

	print "arithmetic: ok"
}
