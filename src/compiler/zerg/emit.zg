# emit — AST to C for the self-hosting Zerg compiler (M3).
#
# Lowers a parsed File to C over the same shape the Go bootstrap emits: an include
# header, forward declarations, the function definitions with `zg_`-mangled names, and
# an `int main` wrapper that calls `zg_main`. The bar is functional equivalence, not
# byte-identical C — the emitted C must compile and behave identically to the bootstrap
# build.
#
# Expressions are built as strings (each match arm yields C text), so no void-valued
# match is needed. A small type inference — over the function signature table and the
# per-function variable environment held in Emitter — picks the printf format for `print`
# and resolves numeric promotion. All helpers are `c_`-prefixed to stay clear of the
# lexer / parser names in this one flattened module.
import "./ast"
import "./check"
import "./generic"
import "./lexer"
import "./lint"
import "./parser"
import "./rule"
import "./token"
import (
	"ascii"
	"strconv"
)

# Emitter carries the per-function variable environment (name -> type) and the
# whole-file function signature table (name -> return type).
# Mods is THE MODULE IDENTITY TABLE as it travels: every source path a program was loaded
# from, and the module each one belongs to, row for row.
#
# It is a struct rather than two arguments because it crosses five public entries and the
# language-server boundary, and two lists that must stay the same length are one value. What
# fills it is `cmd/unit.zg`, which is the only thing that knows: see `c_mod_of`.
pub struct Mods {
	pub paths: list[str]
	pub names: list[str]

	# What each IMPORT of the build resolved to, row for row: the file that wrote one, the path
	# as written, and the module identity it named. The first two are what the emitter sees in
	# the tree; the third is what it cannot work out, because it does not know the roots a
	# prefix expands under — and `c_mod_of`'s comment says why it must not guess.
	pub imp_at: list[str]
	pub imp_path: list[str]
	pub imp_mod: list[str]
}

# mods_of is how a table is BUILT from outside this module, and it is a function rather than
# the constructor because the seed cannot spell one: `zerg.Mods(ps, ns)` in `cmd` lowers to the
# type name where the call should be, and cc says so. A call crosses the boundary in both
# compilers.
pub fn mods_of(paths: list[str], names: list[str], imp_at: list[str], imp_path: list[str], imp_mod: list[str]) -> Mods {
	return Mods(paths, names, imp_at, imp_path, imp_mod)
}

pub struct Emitter {
	pub env_names: list[str]
	pub env_tys: list[ast.Ty]

	# env_cnames is each binding's C NAME. A Zerg binding may shadow one already in scope
	# — `mut n := n` rebinding a parameter is the ordinary way to get a mutable copy — but
	# C has no shadowing inside a function, so the second one has to be spelled
	# differently or the C compiler rejects the redefinition.
	pub env_cnames: list[str]

	# env_dead is each binding's liveness after a `del`, in the same order: 0 live, 1
	# revoked on every path reaching here, 2 revoked on some paths and not others. It is
	# what makes `del` mean anything — without it `del v` followed by a use of `v` compiled
	# happily for every type, and the statement was a comment with a keyword in front.
	pub env_dead: list[int]

	# env_mut is whether each binding may be WRITTEN, in the same order. The parser has
	# always read `mut`, and until now nothing carried it past the AST: `x := 1` followed
	# by `x = 2` compiled, and so did a write to a parameter, to a field of an immutable
	# binding, and to a module `const`. That is not a missing diagnostic but a missing
	# GUARANTEE — the memory model's "no shared mutable Zerg state" rests on a binding
	# being unwritable unless it says otherwise, and nothing was holding the other end.
	pub env_mut: list[bool]

	# env_scope is the id of the BLOCK each binding was made in, in the same order. A
	# binding is not popped when its block ends — the C names already handed out have to
	# stay reserved — so "already declared here" cannot be read off the list's shape, and
	# depth alone would make two SIBLING blocks look like one scope. A fresh id per block
	# entry is what tells `x := 1; x := 2` (an error) from the same two lines in different
	# `if` arms (fine) and from shadowing an outer binding or a parameter (fine, and
	# `mut n := n` is the ordinary way to get a writable copy of one).
	pub env_scope: list[int]

	# env_const is whether each binding was declared with the `const` KEYWORD, in the same
	# order — shadow-proof, GRAMMAR group 4, since a plain `x := 1` is just as immutable but
	# may still be shadowed. It is a COLUMN here rather than a registry of its own because
	# that is what it always was: every row of the registry it replaces was appended at the
	# same moment, with the same name and the same block id, as an env row — so the two
	# could only ever have gone out of step, never apart, and the open-scope walk the rule
	# needs is the walk c_in_scope already does.
	pub env_const: list[bool]

	# env_cval is what each binding's initializer FOLDED to, in the same order — a value when
	# the initializer is a const-expr and the binding cannot be written, and the absence of one
	# otherwise. It is what makes GRAMMAR group 7's "module-level or LOCAL" true for a local:
	# `n := 4` followed by `[0; n]` needs n's VALUE at compile time, and the environment is the
	# only structure that already knows which `n` that is.
	#
	# It is a column beside env_names rather than a table keyed by name because the question is
	# scoped: a table would answer `4` for an `n` that a nearer binding has shadowed. A row
	# that is a module constant carries no value here on purpose — kv_vals below is its one
	# home — so the two can never disagree about the same constant.
	pub env_cval: list[check.Folded]

	# rel_cnames / rel_fns are the PENDING RELEASES: every binding in scope that owns what
	# it holds, in declaration order, paired with the runtime function that gives it back.
	# Today only channel bindings are on it — a channel binding owns a holder count, and a
	# send count too when it is send-capable, and giving those back is what makes the spec's
	# "close early by narrowing the scope" idiom work without any statement at all — but the
	# list is deliberately type-agnostic: a `str`, `list` or `map` binding joins it by
	# registering a name and a release function, and every exit path already handles it.
	#
	# The list is not READ any more, only counted: a release is registered on the runtime's
	# cleanup stack where the binding is declared, and every exit gives it back by unwinding
	# to a mark. What the depth still decides is whether a block needs a mark at all.
	pub rel_cnames: list[str]
	pub rel_fns: list[str]
	pub sig_names: list[str]

	# sig_nparams / sig_nreq are how many arguments a call to each signature MAY give and
	# must give — the parameter count, and the count before the first defaulted one. They
	# are recorded here rather than counted on demand because the question is asked once
	# per CALL SITE, and counting means walking the whole program's parameter table: two
	# scans of ~1.7k rows at every call in the program, for two integers that are fixed
	# the moment the signature is read.
	pub sig_nparams: list[int]
	pub sig_nreq: list[int]
	pub sig_rets: list[ast.Ty]
	pub sig_hasret: list[bool]

	# tk_names / tk_kinds / tk_unders is THE type registry: one row per declared type
	# name, its kind (TK_STRUCT / TK_ENUM / TK_SPEC / TK_TYPEDEF), and — for a typedef —
	# what it was declared over. It is one table because "what kind of type is this name"
	# is one question: it was four tables and five spellings, and `c_is_type_name` was the
	# four-term disjunction that had to be edited in step with all of them.
	pub tk_names: list[str]
	pub tk_kinds: list[int]
	pub tk_unders: list[ast.Ty]

	# tk_mod / tk_pub are the SAME PAIR sig_mod / sig_pub carry for a function: the module a
	# type was declared in, and whether its declaration said `pub`. A type name is flattened
	# into one program-wide space here, so without them the registry could say what a name
	# denotes and not who is allowed to write it — which is why a module-private struct was
	# nameable, and returnable, from anywhere.
	pub tk_mod: list[str]
	pub tk_pub: list[bool]

	# tk_path is sig_path's twin: the FILE that declared the type, which the module cannot
	# answer once #57 makes the file the unit of naming.
	pub tk_path: list[str]
	pub fld_struct: list[str]
	pub fld_name: list[str]
	pub fld_ty: list[ast.Ty]

	# fld_pub is the field's own `pub` (GRAMMAR#field). It was read for E4045 — a private
	# field must carry a default — and then thrown away, so the rule that the default exists
	# FOR (external code constructs the type without naming a value it may not read) had no
	# second half: the value it may not read was readable.
	pub fld_pub: list[bool]

	# fld_hasdef / fld_def carry each field's DEFAULT, so a construction that omits a
	# trailing field can be filled in from the declaration — the same pair `pr_hasdef` /
	# `pr_def` carry for a parameter, and read by the same kind of backfill.
	pub fld_hasdef: list[bool]
	pub fld_def: list[ast.Expr]
	pub var_name: list[str]
	pub var_enum: list[str]
	pub var_tag: list[int]

	# vf_enum is the OWNING ENUM of a payload row, and it is here for the same reason
	# var_enum is: a variant name is a name INSIDE an enum, so a row keyed by the bare name
	# alone answers whichever enum was declared first. Two enums that each declare a
	# `Circle(…)` had one arity, one field type and one boxedness between them.
	pub vf_enum: list[str]
	pub vf_variant: list[str]
	pub vf_index: list[int]
	pub vf_boxed: list[bool]
	pub vf_ty: list[ast.Ty]
	pub used_rt: bool
	pub used_str: bool

	# used_fnptr records that some function was held as a VALUE, so the generic function
	# pointer the header typedefs is only there for a program that has one.
	pub used_fnptr: bool
	pub ref_names: list[str]
	pub pr_fn: list[str]
	pub pr_idx: list[int]
	pub pr_ref: list[bool]

	# pr_ty is each parameter's TYPE, parallel to pr_fn / pr_idx. It is what lets a bare
	# function name be given a type when it is used as a value: `fn(P...) -> R` needs the
	# P's, and the return table alone has only the R.
	pub pr_ty: list[ast.Ty]

	# pr_hasdef / pr_def carry each parameter's DEFAULT, so a call that omits a trailing
	# argument can be given it. The default belongs to the callee's declaration, and a call
	# site is nowhere near it, which is the whole reason it has to be in a table.
	pub pr_hasdef: list[bool]
	pub pr_def: list[ast.Expr]

	# k_decls / k_tys are the module CONSTANTS. They are C globals, so they are in scope
	# in every function — c_reset_env seeds the per-function env from them rather than
	# starting empty, which is what lets a body name one.
	#
	# The DECLARATION is kept whole rather than shredded into columns. It used to be six
	# parallel lists, and four of them — the name, `const`, `mut`, `pub` — were a
	# column-by-column copy of ConstDecl with nothing done to the value on the way in, while
	# the module was `c_mod_of` of its path. A copied column can go stale against the row it
	# was copied from and no rule notices; a row cannot. `k_tys` stays a column of its own
	# because it is the one piece of NEW information: the type as INFERRED here, which for
	# an annotated declaration that does not fit is deliberately not the one written.
	pub k_decls: list[ast.ConstDecl]
	pub k_tys: list[ast.Ty]

	# kv_names / kv_vals are the module constants' FOLDED VALUES — one row per module-level
	# binding, in declaration order, holding what its initializer works out to or the news
	# that it works out to nothing.
	#
	# They are filled by a pass of their own (c_build_const_vals) ahead of every table below,
	# because the first thing that asks for a compile-time value is c_build_enums — a
	# discriminant may name a constant — and k_decls above is not filled until the globals are
	# rendered, which is most of a unit later. Folding a VALUE needs no types, so the pass can
	# run that early; inferring the constant's TYPE cannot, which is why the two stay apart.
	pub kv_names: list[str]
	pub kv_vals: list[check.Folded]

	# tup_names are the tuple shapes already declared — one C struct per distinct shape,
	# generated on demand. The declaration TEXT goes into res_decls: tuples and carriers
	# spell each other, so the two share one stream in the order they were met, rather than
	# two sections whose fixed order is wrong for whichever nesting came second.
	pub tup_names: list[str]

	# mvt_names / mvt_decls are the map VTABLES — one static per distinct key/value shape,
	# holding the hash and equality for the key type.
	pub mvt_names: list[str]
	pub mvt_decls: list[str]

	# dfn_decls are the generated defer thunks and their env structs, one per site.
	# fn_mark is the cleanup-stack mark a `return` unwinds to, and loop_mark the one a
	# `break` or `continue` unwinds to — empty when there is no defer to run.
	pub dfn_decls: list[str]
	pub dfn_n: int

	# lam_defs are the lambdas lifted out of expression position, each a whole C function,
	# and lam_n numbers them.
	pub lam_defs: list[str]
	pub lam_n: int

	# rcv_names / rcv_decls are the per-element-type receive helpers, and used_conc
	# records that this program touched a channel or a spawn — which is what decides
	# whether main runs under the scheduler and whether the concurrency units link.
	pub rcv_names: list[str]
	pub rcv_decls: list[str]
	pub used_conc: bool
	pub fn_mark: str
	pub loop_mark: str

	# res_names / res_decls are the `Result[T]` CARRIERS — one C struct per distinct
	# payload shape, plus the `zg_force_*` helper that reads it back. They are registered
	# exactly the way tup_names are, and for the same reason: the name is a pure function
	# of the shape, so two modules of one program spell it alike. res_decls is the one
	# on-demand stream — carrier AND tuple declarations, in the order they were met.
	pub res_names: list[str]
	pub res_decls: list[str]

	# fn_ret is the return type of the function currently being emitted, TVoid when it
	# declares none. A `return` is a place a value fills a DECLARED slot, so it is one of
	# the sites where a channel direction has to be checked — and the declared type is
	# nowhere near the statement, so it rides here. c_fn saves and restores it, which is
	# what keeps a lambda's own return type from leaking into the function it sits inside.
	#
	# There is no `has_ret` beside it: a function that declares no return type has TVoid
	# here, and every reader is asking whether this is a CHANNEL, which TVoid is not.
	pub fn_ret: ast.Ty

	# op_n numbers the temporaries the Result operators need. It is DELIBERATELY not
	# dfn_n: that counter names the defer thunks, the spawn envs and the block marks, and
	# a new operator drawing from it would renumber every one of them downstream — a
	# whole-file diff for a change that touched one expression, and the first thing a
	# fixpoint failure would show.
	pub op_n: int

	# scope_n hands out block ids and scope_cur is the block being emitted. They are
	# separate from every other counter here because they must not renumber anything: a
	# scope id never reaches the emitted C, so drawing these from dfn_n or op_n would move
	# temp names for a change that emits nothing.
	# at_line / at_col are where the statement being emitted STARTS, updated by the SAt
	# marker the parser puts before each one. Every diagnostic reads them, which is what
	# turns a message into a message with a place.
	pub at_path: str
	pub at_line: int
	pub at_col: int

	# diags is every ILL-FORMED-PROGRAM finding this emission has made, rendered, in the
	# order they were found. They are COLLECTED rather than raised because an error was a
	# process death: a file with three mistakes in it reported one, and the programmer
	# learned about the second only after fixing the first.
	#
	# A checking rule can carry on where an emitting one cannot, which is why only the
	# check.zg rules are on this list. Emit's own `NotImplemented` refusals still raise:
	# they mean this compiler cannot lower the form at all, so there is nothing to carry
	# on with. The C built after a finding is discarded, never handed to cc.
	pub diags: list[ast.Diag]

	pub scope_n: int
	pub scope_cur: int

	# open_scopes is the ids of the blocks currently being emitted, outermost first. A
	# binding is NOT popped when its block ends, so without this a name resolves to the
	# innermost binding that ever existed rather than the innermost one still in scope:
	# `x := 1` then `if … { x := 2 }` then a read of `x` resolved to the inner binding's
	# C name, which C has already closed the brace on.
	pub open_scopes: list[int]

	# ns_names is THE SET OF NAMESPACE BINDINGS this program's imports introduce: the names a
	# qualified expression may write to the left of a `.`.
	#
	# A `ns_mods` column stood beside it once, holding each import's module PATH, and it was
	# deleted as unread: a module flattens into the one program-wide space, so every reader
	# of a qualified name goes on to look the MEMBER up rather than the module.
	#
	# ns_at is a different column and answers a different question — not "which module does
	# this binding name" but "which module WROTE it". That is the one fact no transitivity
	# needs (docs/runtime/package.md: "importing a package gives you its public surface only,
	# never the packages it imports in turn"), and dropping it is exactly why the rule could
	# not be stated: with only the name set, "is `lib` a namespace" is a question about the
	# whole build, and a module that never imported `lib` got the same yes as the one that
	# did.
	#
	# The name is the `as` alias when there is one and the path's last segment otherwise
	# (GRAMMAR#import-spec) — the parser decides that, since it is a fact about the surface.
	# Recomputing it here from the path alone is what made `import "a/text" as at` bind
	# `text`, so `at.SIGN` was `undefined name at` in a program that had said what `at` was.
	#
	# Without it a qualified name could not be told from a typo: `foo.n` with no `foo`
	# anywhere got the advice written for `lib.LIMIT`, because the guard was "nothing else
	# answers to this name" and a misspelling answers to nothing either.
	pub ns_names: list[str]

	# ns_at is the FILE THAT WROTE each binding, row for row beside ns_names — the path
	# of the importing file, which is what `ImportDecl.at` carries and `c_mod_of` reduces. A
	# name imported by two modules gets two rows: the set is a set of PAIRS now, since the
	# same namespace legitimately belongs to several modules and dropping the duplicate would
	# drop one of them.
	pub ns_at: list[str]

	# ns_mods is WHICH MODULE each binding names, row for row beside ns_names — the import
	# path as written, which is exactly what the loader records as that module's identity, so
	# the two compare literally.
	#
	# A COLUMN OF THIS NAME STOOD HERE ONCE AND WAS DELETED AS UNREAD. The note that removed
	# it said "a module flattens into the one program-wide space, so every reader of a
	# qualified name goes on to look the MEMBER up rather than the module" — which was true,
	# and was the bug: `b.helper()` answered a `helper` module `a` declared, and printed it.
	# The prefix decided nothing. This is the column that lets it decide.
	pub ns_mods: list[str]

	# ns_pub is whether that import was a RE-EXPORT (`import pub "…"`), row for row. A module
	# that re-exports another puts its public surface onto its own, which is the one answer to
	# "is this member yours" that is neither yes nor a mistake — `examples/1g/reexport` is the
	# program, and it is what turned red the first time the rule above was asked.
	pub ns_pub: list[bool]

	# lv_write is set while the ASSIGNMENT TARGET of a statement is being lowered, and it
	# is what tells `xs[0] = 9` from `x := xs[0]`. A list's buffer is copy-on-write, so a
	# read takes the slot as it is and a write must first make the buffer this list's
	# alone; the two are the same expression on the page and differ only in which side of
	# an `=` they sit on, which no expression node records.
	#
	# It travels DOWN a target — through a field and through an index — because every list
	# on the path is written into: `xs[0].ys[1] = 9` stores into the struct that lives in
	# `xs`'s buffer, so unsharing `ys` alone would edit a header other holders can see.
	pub lv_write: bool

	# tmp_n numbers the temporaries a call has to hold on to because the CALLER owns them
	# (c_call_releasing). Its own counter, for the reason op_n has one: a name that reaches
	# the emitted C must not renumber because something unrelated grew a thunk, or every
	# fixpoint failure starts with a whole-file diff to read past.
	pub tmp_n: int

	# fn_mark_used records that something in this function's body unwound to the function's
	# mark, which is what decides whether the mark is declared at all. It cannot be known
	# before the body is walked and the mark's NAME cannot be known after, so the name is
	# handed out up front and the declaration is prepended once the walk has answered.
	pub fn_mark_used: bool

	# force_mark hands the next c_block the mark NAME to use instead of minting its own. A
	# loop body needs that, because a `break` inside it unwinds to that name and the jump is
	# rendered before the block has finished deciding whether it needs a mark at all.
	pub force_mark: str

	# loop_keep is the pending-release depth at the loop BODY's entry and loop_mark_used
	# whether a jump inside it actually emitted an unwind. Together they are what keeps a
	# loop that owns nothing from paying a scope mark and an unwind EVERY ITERATION: the
	# jump asks the depth, and the block asks whether the jump spoke.
	pub loop_keep: int
	pub loop_mark_used: bool

	# loop_defer is the OTHER thing a jump has to give back, and the depth above cannot see
	# it: a `defer` puts a record on the same cleanup stack without passing through the
	# pending-release list, so a loop body holding one grew the stack by something
	# `rel_cnames` never counted. It is the exact twin of fn_mark_used, which is what lets a
	# `return` run the defers it is jumping over — and the two are set on the same line of
	# c_defer_of, because a defer is one fact about two exits rather than two facts.
	pub loop_defer: bool

	# ty_names / ty_unders are the `type X = Y` declarations: a name and the type it takes
	# its REPRESENTATION from. They are not struct_names, because a typedef has no fields and
	# is not constructed like one — `Celsius(20)` is a conversion, not a struct literal — and
	# they are not a substitution table either, because the whole point is that `Celsius` and
	# `int` stay different types everywhere the program can see.

	# into_src is the TARGET name of every `impl Into[T] for S` the program declares. It used
	# to be a pair, with the type argument beside it, so that a typed position could find a
	# user conversion from the two types alone — a position converts nothing now, so what is
	# left of the registry is the one question that survives it: has this type an `into`
	# already (c_into_user_from), which is the "one Into per type" refusal.
	pub into_src: list[str]

	# want_lints is whether anybody asked for the L5xx findings. A build does not — it passes a
	# list it discards — and the dedupe below them is quadratic, so asking first is what keeps
	# an ordinary build from paying for output nobody reads.
	pub want_lints: bool

	# lints are the ADVISORY findings the lowering walk notices — L5xx, every place a value
	# converted or a literal adopted without the source saying so. They are kept apart from
	# `diags` because they must not fail a build: the language allows every one of them, and
	# what a lint says is that the page does not show what the program means.
	pub lints: list[ast.Diag]

	# gen_names / gen_tpls are the GENERIC TEMPLATES — every `fn f[T](…)` in the program, by
	# name. A template is not a function: it has no C symbol, no prototype and no body, and
	# nothing but this table ever sees it. What reaches C is one specialization per distinct
	# set of type arguments, below.
	pub gen_names: list[str]
	pub gen_tpls: list[ast.FnDecl]

	# inst_names / inst_fns are the specializations asked for so far, the mangled name beside
	# the ordinary FnDecl that substitution produced. The list GROWS WHILE IT IS BEING WALKED
	# — a specialized body may call another template — which is why the drain that emits them
	# is a watermark loop rather than a `for`.
	pub inst_names: list[str]
	pub inst_fns: list[ast.FnDecl]

	# impl_on / impl_target are every `impl <Spec> for <Type>`, as a pair of lists. Two
	# questions read it and they are the same question: whether `==` on an aggregate has an
	# `Eq` behind it (docs/core/derive.md makes `Eq` the SOLE source of it), and whether a
	# generic's type argument meets the bound its parameter carries. It was an Eq-only list
	# until the second asker arrived and wanted the same rows.
	pub impl_on: list[str]
	pub impl_target: list[str]

	# sig_mod / sig_pub are, per signature, the MODULE that declared it and whether that
	# declaration is `pub`. Visibility is the one question about a name that the flattened
	# namespace cannot answer on its own: every module's names land in one space, so by the
	# time a call is resolved there is nothing left to say where the callee came from. These
	# two lists are what remembers it, recorded where the signature is.
	pub sig_mod: list[str]
	pub sig_pub: list[bool]

	# sig_path is the FILE that declared it, which the module cannot answer: #57 makes the
	# file the unit of naming, so a bare name resolves to a declaration in the SAME FILE and
	# a module holding thirteen of them is thirteen different answers. It rides beside
	# sig_mod rather than replacing it because visibility is still asked of both — a name is
	# reachable from a sibling FILE through an import, and from another MODULE only when the
	# module's surface carries it.
	pub sig_path: list[str]

	# sig_unsafe is the third such column: whether the declaration sat inside a module-level
	# `unsafe { … }` group, which GRAMMAR group 12 makes callable only from unsafe. It is
	# recorded beside the other two for the same reason — the namespace is flat by the time a
	# call is resolved, and the CONTEXT a declaration was written in is exactly what is lost.
	pub sig_unsafe: list[bool]

	# in_unsafe_fn is whether the function being emitted RIGHT NOW is one of them, which is
	# the other half of the rule: the check is a comparison between the callee's context and
	# the caller's, and nothing else on this struct says which function the walk is inside.
	# c_fn saves and restores it, because a lambda is emitted through c_fn in the middle of
	# the enclosing function's expression.
	pub in_unsafe_fn: bool

	# depth counts how many recursion levels of the expression walk are active — one per
	# c_expr or c_infer entry, the two doors every recursive descent into an expression
	# goes through. The parser bounds NESTING, but a flat chain (`1 + 1 + … + 1`, or a
	# long method chain) never gets deeper in the parser — it loops — while the walk here
	# recurses once per link and died of SIGSEGV at about 310 links. c_deeper is the
	# counted refusal that fires first.
	pub depth: int

	# mod_tagged is every PRIVATE free-function name two or more modules declare. Such a name
	# is answerable — nothing outside a module can reach its private names, so a bare call
	# means the caller's own — but the two need different C symbols, and this is the list of
	# names that get one.
	pub mod_tagged: list[str]

	# mod_order is the program's module names, SORTED, and a name's tag is its position here.
	# Sorted rather than first-seen because `fixpoint` compares emitted C byte for byte: a
	# tag that depended on the order files were read would move the output without the
	# program changing.
	pub mod_order: list[str]

	# seq_pre is the declarations the expression BEING RENDERED has to run before it, in
	# source order — the temporaries that give a call's arguments and an operator's operands
	# the left-to-right evaluation docs/core/memory.md specifies and C does not. It is a
	# field rather than a return value because the operands are rendered deep inside helpers
	# that hand back a fragment of an argument list and know nothing of the expression the
	# fragment lands in; c_expr, which does, takes the list on the way out and wraps the
	# whole node in the statement expression the declarations belong to. Every c_expr saves
	# and clears it on the way in, so a nested render can never leave a declaration behind
	# in an expression that is not its own.
	pub seq_pre: str

	# sub is the identifier substitution an enclosing BLOCK EXPRESSION left standing, and it
	# is the only one that reaches a statement. Every other substitution is a parameter — a
	# match arm hands its bindings straight to the expression it lowers — but a block
	# expression carries STATEMENTS, and c_stmt has no Subst to pass along. c_sub_active
	# merges this into whatever each c_expr was handed; see the paragraph there for why the
	# set lives here rather than in twenty-four signatures.
	#
	# It is saved and restored around every construct that emits a body of its OWN — a
	# lambda's, above all — because a substitution belongs to the block that opened it and
	# means nothing inside a function lifted out of it.
	pub sub: Subst

	# top_names / top_kinds are WHAT THE TOP LEVEL DECLARES: every name in the one namespace
	# a struct, an enum, a type, a spec, a free function and a module constant share, and
	# which of the six each one is. c_build_top_names computes exactly this while refusing a
	# name declared twice, and it used to throw the table away at the end of that walk.
	#
	# The import rule then walked the same six lists again to ask the same question, in a
	# different order and with a different wording for each answer. Two wordings for one
	# fact is the drift this file keeps finding; a second walk is also a second EXTENT, and
	# these two had already diverged — this one runs over the program with its templates
	# still in it, so `import "x/foo"` beside `fn foo[T](…)` was a collision the second walk
	# could not see.
	pub top_names: list[str]
	pub top_kinds: list[str]

	# frz_idxs are the collections FROZEN by the `for … in` loops enclosing the statement
	# being emitted — pushed as each body opens and popped as it closes.
	# docs/code/collections.md freezes the walked collection against STRUCTURAL change
	# (growing, shrinking, rebinding) for the loop's whole extent, and the rule is local by
	# design: the loop knows the collection it walks, so this stack is the entire analysis.
	#
	# A BINDING, NOT A NAME, which is the difference between the rule and a string match. A
	# plain `:=` may be shadowed (GRAMMAR group 4 exempts only `const`), so a body that
	# declares its own `xs` inside `for x in xs` names a SECOND collection — and comparing
	# the spelling refused an append to it, in a sentence that was not true of that `xs`. An
	# environment row is the identity that survives shadowing: rows are appended and never
	# popped within a function, so the index recorded here stays the loop's own binding,
	# while c_live_idx answers the inner row for every name the body rebinds.
	#
	# Only a BARE name is pushed — an iterable that is a field path, a slice or a call
	# result has no row to record, which is the [deviation] docs/code/collections.md carries.
	pub frz_idxs: list[int]

	# frz_paths are the same freeze for an iterable that has no environment row: a field
	# path, or an index by an integer literal. What says two of them are the same collection
	# is that they are spelled the same way — see chk_path_text (check.zg).
	pub frz_paths: list[str]

	# unit_paths / unit_mods are THE MODULE IDENTITY TABLE: every source path this program was
	# loaded from, and the module each one belongs to. It is filled by the LOADER and read by
	# `c_mod_of`, and it is the whole of what makes a module an identity rather than a string
	# operation on a filename.
	#
	# The loader is the only thing that knows. A module is what an import RESOLVED to — the
	# written path for an imported one, the entry file for the program's own — and `cmd/unit.zg`
	# already has both: `Unit.name` is that identity and `Unit.paths` is which files wear it.
	# Deriving it here instead, from the path alone, made `src/stdlib/strings.zg` and
	# `src/stdlib/io.zg` ONE module because they share a directory, so every one of `io`'s
	# module-private names was reachable from `strings` with no import and no `pub`.
	#
	# A PATH THIS TABLE DOES NOT HOLD IS ITS OWN MODULE, which is the conservative answer and
	# deliberately not the quiet one: it shares its private names with nothing, so a file the
	# loader failed to register is refused loudly rather than silently let through. `""` is
	# still reserved for a declaration NO FILE WROTE, which `c_synthetic_path` answers for.
	pub unit_paths: list[str]
	pub unit_mods: list[str]

	# The loader's answer to "what did this import resolve to", row for row. A binding records
	# the module IDENTITY it named rather than the path somebody typed, so `./lib` and `/lib`
	# are one module here — which is what they are on disk (#67).
	pub imp_at: list[str]
	pub imp_path: list[str]
	pub imp_mod: list[str]
}

# Subst is an active set of identifier substitutions: an EIdent whose name appears in
# `names` emits the parallel `repls` entry instead of a mangled name. It splices a match
# arm's bound names — a scrutinee alias, or an enum payload field access — into the arm's
# guard and body.
pub struct Subst {
	pub names: list[str]
	pub repls: list[str]
}

fn c_nosub() -> Subst {
	return Subst([], [])
}

fn c_extend(sb: Subst, name: str, repl: str) -> Subst {
	mut nn := sb.names
	mut rr := sb.repls
	nn.append(name)
	rr.append(repl)
	return Subst(nn, rr)
}

# c_sub_active is the substitution an expression is actually rendered under: the one its
# caller handed down, PLUS whatever an enclosing block expression left standing on the
# emitter.
#
# It exists because a substitution has to reach STATEMENTS, and c_stmt carries no Subst.
# The set is threaded through c_expr's own parameter, so a match arm's `Left(v) =>` spliced
# `v` into an arm body that was an expression and stopped at the first `{`: inside a block
# body every statement is lowered by c_stmt, which hands c_expr an EMPTY set, and `v` came
# out as `zg_v` — a C identifier nothing declares. Threading Subst through all twenty-four
# statement forms would put the same parameter in twenty-four signatures to serve one
# construct, so the active set lives on the emitter and is merged in HERE, at the one
# funnel every expression already passes through.
#
# The caller's set wins on a name they share, because it is the inner one. The common case
# is an empty `em.sub` and no merge at all, which is what keeps this off the hot path — the
# whole cost outside a block expression is one length test.
fn c_sub_active(mut &em: Emitter, sb: Subst) -> Subst {
	return sb if em.sub.names.len() == 0

	# the caller's entries go in FIRST because c_ident_val answers with the first match
	mut out := sb
	mut i := 0
	for i < em.sub.names.len() {
		out = c_extend(out, em.sub.names[i], em.sub.repls[i])
		i = i + 1
	}
	return out
}

# --- type helpers --------------------------------------------------------------

# c_type maps a value type to its C spelling.
fn c_type(t: ast.Ty) -> str {
	return match t {
		Ty.TInt => "int64_t"
		Ty.TFloat => "double"
		Ty.TStr => "const char*"
		Ty.TBool => "bool"
		Ty.TVoid => "void"
		Ty.TByte => "uint8_t"
		Ty.TUint => "uint64_t"
		Ty.TRune => "int32_t"
		Ty.TNamed(nm) => "zg_" + nm
		Ty.TList(_) => "zrt_list"
		Ty.TFn(_, _) => "zg_fnptr"
		Ty.TTuple(ts) => c_tuple_cname(ts)
		Ty.TMap(_, _) => "zrt_map"
		Ty.TChan(_, _) => "zrt_chan*"
		Ty.TEither(l, r) => c_carrier_cname(l, r)
		Ty.TOpt(el) => c_opt_cname(el)
		Ty.TErr => "zrt_err"
		_ => "int64_t"
	}
}

# --- the Result carrier -----------------------------------------------------------
#
# `Result[T]` is a plain C struct: a tag, the value, and the Err saying why there is not
# one. That encoding is shared with the Go seed and with the runtime's own zrt_result_nil,
# on purpose — the same program built by either toolchain has to behave the same way. The
# fields themselves are spelled in one place, beside the typedef further down.
#
# c_carrier_cname is the name, and it is a PURE function of the payload shape for two
# reasons, both of them hard. c_type has to be able to spell it and has no Emitter to
# ask, which is the constraint c_tuple_cname already lives under. And a build emits ONE
# TRANSLATION UNIT PER MODULE, each with an Emitter of its own, so any serial number
# would give the same shape two different names in two units and the prototypes would
# stop matching. A shape key cannot drift, because it depends on nothing.
#
# Two payloads whose C type coincides — `Result[list[int]]` and `Result[list[str]]` are
# both `zrt_list` — share one carrier. That is harmless: the C is identical, and the
# tuple carriers have behaved this way since they existed.
fn c_carrier_cname(left: ast.Ty, right: ast.Ty) -> str {
	return "zg_res_" + c_ident_safe(c_type(left)) if c_is_err_ty(right)
	return f"zg_eit_{c_ident_safe(c_type(left))}_{c_ident_safe(c_type(right))}"
}

# c_opt_cname is the C name of `T?`'s carrier. It is DISTINCT from the Result's even
# though the layout is the same: the two differ in what an absent value means and in what
# forcing one does, and giving them one name would make `Result[int]` and `int?` the same
# type to every check that compares C names.
fn c_opt_cname(elem: ast.Ty) -> str {
	return "zg_opt_" + c_ident_safe(c_type(elem))
}

# c_opt_name registers the carrier for `T?` and answers its C name — the optional's half of
# what c_carrier_name does for an Either.
fn c_opt_name(mut &em: Emitter, elem: ast.Ty) -> str {
	c_spelled_register(em, ast.Ty.TOpt(elem))
	return c_opt_cname(elem)
}

# c_opt_wrap builds a `T?` from something that is not one yet: `nil` is the ABSENT value
# and anything else is present. It is what makes a declared optional mean what it says —
# `x: int? = nil` used to lower to `int64_t zgt_x = 0`, so absent and the number zero were
# the same value and no diagnostic stood between them.
fn c_opt_wrap(mut &em: Emitter, where: str, elem: ast.Ty, e: ast.Expr, sb: Subst) -> str {
	cn := c_opt_name(em, elem)
	return "(" + cn + "){ .tag = 1 }" if c_is_nil_lit(e)

	# A BLOCK WHOSE VALUE IS `nil` IS THE ABSENT ONE TOO. GRAMMAR (group 2) gives a block
	# ending in anything but an expression the value `nil`, so `x: int? = { … nop }` is the
	# literal above written the long way — with the difference that it has STATEMENTS, and
	# they still have to run. The block is rendered for its effects and the carrier answers
	# absent, which is exactly what the literal case does with nothing to run.
	#
	# Only a block. Every other nil-valued expression here is a call to something that
	# answers nothing, and letting THAT stand for absence would turn a mistake — `x: int? =
	# report()` — into a quiet nil, which is the rule chk_slot_fits below is for.
	return f"({{ {c_expr(em, e, sb)}; ({cn}){{ .tag = 1 }}; }})" if c_is_block_expr(e) and c_is_nil_ty(c_infer(em, e))

	return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, where, elem, e, sb) + " }"
}

fn c_is_block_expr(e: ast.Expr) -> bool {
	return match e {
		Expr.EBlock(_) => true
		_ => false
	}
}

fn c_is_nil_lit(e: ast.Expr) -> bool {
	return match e {
		Expr.ENil => true
		_         => false
	}
}

# c_carrier_fit renders `e` where a CARRIER is wanted — a `T?`, a `Result[T]`, an
# `Either[X, Y]`. One of the same shape passes through; anything else is injected into it.
# Every place a declared carrier meets a value goes through here, which is what makes a
# declaration mean what it says: `-> Result[nil] { return nil }` returns a Left, not a bare
# nil that the caller then reads a tag out of.
fn c_carrier_fit(mut &em: Emitter, where: str, want: ast.Ty, e: ast.Expr, sb: Subst) -> str {
	et := c_infer(em, e)

	# COPIED, and this one line is where a carrier is copied AT ALL. A carrier of the right
	# shape passes straight through here, so it never reaches c_copy_of — which is where the
	# rule looks like it lives — and this was a bare `c_expr`: a bit copy that took no
	# reference. Three paths ran through it, and each one of them is a defect of its own once
	# the callee, the return or the new binding registers a drop: `f(got)` on a `str?`
	# parameter would give one payload back twice, `return got` would hand the caller a
	# payload the unwind had already released, and `x = y` would leave two names counting one
	# reference.
	#
	# c_copied, not c_copy_of: only an LVALUE is a second name for something. A carrier just
	# built — a call's result, a wrap — is nobody else's and copying it would only cost.
	return c_copied(em, want, e, sb) if c_is_carrier(et) and c_carrier_ty_cname(et) == c_carrier_ty_cname(want)

	# AN `if` EXPRESSION FILLS A CARRIER BRANCH BY BRANCH, and until it did, the branch that
	# was not the first one did not reach a carrier at all. `c_infer` answers an if-expr with
	# its THEN branch's type, so `x: int? = if c { 1 } else { nil }` looked like a plain `int`
	# arriving at an `int?`, and the wrap below took the WHOLE ternary as one payload: the
	# `nil` lowered to a zero inside a PRESENT carrier, so `x ?? 99` answered 0 and the absence
	# the reader wrote was gone with nothing reported at any stage.
	#
	# chk_branch_types is what says the two sides agree, and it already knew this shape — its
	# own comment calls them "two spellings of one `int?`". They are, once each spelling is
	# put into the carrier on its own, which is what this does. It is not a rule about `nil`:
	# every branch is fitted, so a widening or a user conversion on one side lands the same
	# way, and a carrier already fitted answers at the line above without being wrapped twice.
	#
	# The two checks c_ternary would have run are run here, because distributing the fit is
	# what keeps it from being reached.
	mut fitted := ""
	match e {
		Expr.EIf(cond, then_e, else_e) => {
			check.chk_condition(em, cond, "an `if` expression")
			check.chk_branch_types(em, then_e, else_e)

			ct := c_expr(em, cond, sb)
			a := c_carrier_fit(em, where, want, then_e, sb)
			b := c_carrier_fit(em, where, want, else_e, sb)
			fitted = f"({ct} ? {a} : {b})"
		}
		_ => {
			nop
		}
	}
	return fitted if fitted != ""

	# THE PAYLOAD IS A SLOT OF ITS OWN, and the label has to say so or the sentence is false.
	# A bare value entering a carrier is INJECTED as the payload, so the comparison one level
	# down is against the payload's type — which is right, and is where the mistake is. What
	# was not right is that the label travelled unchanged: `x: int? = "s"` reported _the
	# binding `x` is int_ about a binding the reader had declared `int?` two words earlier,
	# and the `?` was the only part of it they could see.
	#
	# It is refined HERE because this is the one place both wraps start, so a `Result[T]`'s
	# payload and an optional's get the same treatment, and a carrier nested in a carrier
	# reads as what it is — "the int? payload of the Result[int?] payload of …".
	inner := check.chk_payload_says(where, want)
	return c_opt_wrap(em, inner, c_opt_elem(want), e, sb) if ast.ty_is_opt(want)

	return c_either_wrap(em, inner, want, e, sb)
}

# c_fit_copied is what every site where a DECLARED type meets a value calls: a carrier is
# filled, anything else is copied. Filling has to be part of the copy rather than beside it,
# because a carrier's payload may itself be one — `Result[int?]` used to take the bare int
# into a field whose type is the optional's carrier, so the tag it was read back through was
# whatever the value's first bytes happened to be.
#
# `where` NAMES THE SLOT, and it is REQUIRED — which is the whole point of it. This function
# is the enumeration of the typed positions docs/core/types.md lists: a value cannot reach a
# declared type without passing through here, so making every caller name itself is what turns
# "did anyone remember to check this one" into a question the compiler asks. It has eighteen
# callers. The rule used to be attached at thirteen of them BY HAND, and the five it was not
# are a carrier's payload — the recursion five lines below — which is why `x: float? = i` for
# an `int` value printed `5`.
#
# "One rule, N slots, written at fewer" is the bug this file has now had to fix six times: the
# empty list literal, the byte widening, the list element, the struct field, the enum payload,
# the carrier payload. A slot that forgets the rule no longer compiles.
#
# The check here is a FLOOR, not the only rule. Five positions keep one of their own above it
# — a binding, an assignment, a `return`, an argument, a parameter's default — because each
# can say more than a positional label can ("cannot bind str to a int binding: `n`" names the
# binding; this one could only say "the binding is int"). Those speak first and this never
# speaks for them. What it speaks for is the position nobody thought to give a rule.
fn c_fit_copied(mut &em: Emitter, where: str, want: ast.Ty, e: ast.Expr, sb: Subst) -> str {
	check.chk_slot_fits(em, where, want, e)

	return c_carrier_fit(em, where, want, e, sb) if c_is_carrier(want)

	# a bare `[]` carries NO element type of its own, so it takes the destination's. Without
	# that it lowered to `(zrt_list){0}` — a list of zero-byte elements — and every later
	# push memcpy'd nothing: `take([])` then two appends read back 0. The rule lived on the
	# struct-field path alone, so a field got it and an argument did not.
	if c_is_list(want) and c_is_empty_listlit(e) {
		em.used_rt = true
		return f"zg_empty_list(sizeof({c_type(c_list_elem(want))}), &{c_elem_vt(em, c_list_elem(want))})"
	}

	# A LIST LITERAL IS BUILT AT THE DECLARED ELEMENT TYPE, element by element — the same
	# thing a `list` binding has always done, now done wherever the literal lands. Without it
	# the buffer's stride, vtable and every element came from the FIRST element's type, so
	# `f([i, 2, 3])` on a `list[float]` parameter wrote int64_t bit patterns into a buffer read
	# back as doubles. Each element is a typed position of its own, which is also where `Into`
	# fires on it.
	return c_list_lit_vals(em, c_list_elem(want), c_elem_exprs(em, e, c_list_elem(want))) if c_is_list(want) and c_is_listlit(e)
	return c_into(em, want, e, sb)
}

# A POSITION EMITS NO CONVERSION. This is where the compiler used to write the `.into()` the
# specification once said a position writes — `x: float = i` lowering to the same checked
# conversion `float(i)` emits, and `s: str = c` lowering to the `impl Into[str] for C` method
# — and Option B deleted the whole route: a position may WRAP a value (a carrier, a spec's
# box), and it never converts one, so the only value that ever reaches a slot is one already
# of the slot's type.
#
# What is left is the copy, which is not a conversion: a literal ADOPTS its position (`x: byte
# = 5` is a byte written as a byte, its fit decided at compile time by chk_lit_fits), and
# everything else arrives already typed. Both spellings the route served are now refused by
# chk_fits_expr with the written form as the fix, and `L501` — the lint that reported each
# such application while it was still legal — retires with them.
fn c_into(mut &em: Emitter, want: ast.Ty, e0: ast.Expr, sb: Subst) -> str {
	# CARVE-OUT (c): a closure's omitted parameter types — and its omitted return type —
	# come from the function type it is CHECKED AGAINST, which is a fact about THIS POSITION
	# and not about the closure. It is filled here because c_fit_copied's eighteen slots come
	# through here, and so does a declared binding, which lowers through c_into directly and
	# would otherwise have been the one position where a closure could not adopt.
	#
	# NOT because this is "the one place every declared type meets its value" — it is not,
	# and the difference matters to whoever adds the next carve-out. Carve-out (b), the
	# composite literal with nothing to speak for it, is answered ABOVE this in c_fit_copied
	# and again on the assignment and `list`-binding paths. Two carve-outs at two depths is
	# the "one rule, N slots" shape this file has had to undo three times; folding (b) down
	# to here would make the sentence true, and is its own cut.
	#
	# It happens at EMIT and the check has already passed, because chk_fits_expr asks the
	# same question of the same rewrite — the closure is filled, then compared as an
	# ordinary function type. Nothing downstream ever sees an unknown parameter, which is
	# what keeps inference bottom-up: by the time anything asks this closure's type, it has
	# one of its own.
	e := c_fn_typed(want, e0)

	# A LITERAL THAT ADOPTED `float` COMPUTES IN `float`, which C will not do on its own: the
	# leaves are integer tokens, so `x: float = 1 / 2` renders as an integer division and lands
	# `0` in a double. The literals took the position's type before the operator ran, so the
	# operator runs on doubles — which is the whole of what "guess, then compute in the guessed
	# type" means at this end of the compiler.
	#
	# An integer target needs nothing here. Every operand and every intermediate was measured
	# against it by chk_lit_pair_in_range, so the C arithmetic and the checked arithmetic the
	# checker folded with cannot disagree about a value both have already agreed fits.
	return c_lit_checked(em, e) if c_is_float(want) and c_is_lit_tree(e)

	# A LITERAL PAST i64 AT A `uint` POSITION is rendered from its own bound, and here rather
	# than in c_int_dec because here is where the target is known. c_int_dec measures against
	# `int` — correct for a literal with nothing to ask, and the reason the upper half of `uint`
	# was unwritable — and it would report the value it cannot hold instead of writing it.
	return c_uint_lit(e) if c_is_uint(want) and c_is_wide_uint_lit(e)

	return c_copied(em, want, e, sb)
}

# c_is_lit_tree is chk_lit_float_tree — the checker's answer about which literal trees adopt a
# c_no_builtin_into is the sentence for `1.into()`, and it is a REFUSAL rather than a gap.
#
# `Into` is a spec a type opts into, and no built-in type opts in — deliberately, and for two
# separate reasons. Between two numbers the conversion is written `T(x)`: that is the whole of
# Option B, and an `.into()` beside it would need the POSITION to say which target it meant,
# which docs/core/type-system.md forbids in the same breath ("a demand never solves a type
# parameter"). And to text there is nothing to opt into at all: `display` is a built-in value
# rendering rather than a spec, so `str(x)` answers for every type and needs no bound.
#
# It reads the RECEIVER's type rather than the name alone, because a user type that implements
# `Into` has a real `into` and must reach it.
fn c_no_builtin_into(mut &em: Emitter, meth: str, target: ast.Expr) {
	return if meth != "into"

	t := c_infer(em, target)
	return if not check.chk_is_scalar(t)

	raise c_diag(em, rule.Rule.IntoNotBuiltIn, f"`into` is a method of the `Into` spec, and no built-in type implements it — between numbers the conversion is written `{ast.ty_name(t)}(…)` at the target type, and a value's text is `str(x)`, which every type answers")
}

# c_is_wide_uint_lit is an integer literal that fits a u64 and NOT an i64 — the half of `uint`
# c_int_dec cannot render. One that fits both goes the ordinary way, so this changes nothing
# about a literal any position could already carry.
fn c_is_wide_uint_lit(e: ast.Expr) -> bool {
	return match e {
		Expr.EInt(lex, _, _) => lexer.uint_fits(lex) and not lexer.int_fits(lex)
		_ => false
	}
}

# c_uint_lit writes the value with C's unsigned-long-long suffix. Without it the constant is a
# decimal C reads as a `long long`, which cannot hold it — the compiler would hand cc a number
# it then complains about, against generated code nobody wrote.
fn c_uint_lit(e: ast.Expr) -> str {
	return match e {
		Expr.EInt(lex, _, _) => str(lexer.uint_value(lex)) + "ULL"
		_ => ""
	}
}

# float, asked here rather than restated, so the emitter cannot render a tree the checker did
# not admit — with one thing added: an OPERATOR has to stand somewhere in it. A bare literal
# is a literal tree and needs no help, because C reads `2` into a double as `2.0`; what needs
# help is an operator standing between two of them.
fn c_is_lit_tree(e: ast.Expr) -> bool {
	return match e {
		Expr.EUnary(o, x) => o == "-" and c_is_lit_tree(x)
		Expr.EBinary(_, _, _) => check.chk_lit_float_tree(e)
		_ => false
	}
}

# c_lit_as_float renders the tree with every leaf a double, so C's own promotion rules never
# get a chance to make an integer of it. The leaf is written from its VALUE rather than from
# its lexeme, because a lexeme may carry a base prefix or a digit separator that C does not
# read the same way — `0xFF` it would, `1_000` it would not.
#
# IT IS THE ONLY WALK THE TREE GETS, and that is the trap in it. Every other expression is
# rendered by c_expr, which visits each node and carries the checks with it — c_int_dec asks
# whether the lexeme fits i64, c_binexpr asks chk_binary and with it the constant divisor. A
# tree rendered here is never walked by c_expr at all, so both questions went unasked:
# `x: float = 99999999999999999999 + 1` printed `1`, and `n + 1 / 0` printed `inf`. So the
# checks come first, explicitly, and c_lit_checked is what every caller must use.
fn c_lit_as_float(e: ast.Expr) -> str {
	return match e {
		Expr.EInt(lex, _, _) => f"((double){strconv.to_string(lexer.int_value(lex), 10)})"
		Expr.EUnary(_, x) => f"(-{c_lit_as_float(x)})"
		Expr.EBinary(o, a, b) => f"({c_lit_as_float(a)} {o} {c_lit_as_float(b)})"
		_ => ""
	}
}

# c_lit_checked is c_lit_as_float with the walk's questions asked of every node first: the
# width of each leaf, and a constant zero divisor anywhere in the tree. Rendering carries on
# after a finding, as every rule here does — the C is thrown away once the list is non-empty.
fn c_lit_checked(mut &em: Emitter, e: ast.Expr) -> str {
	c_lit_widths(em, e)
	c_skip_bool(check.chk_const_divisors(em, e))

	return c_lit_as_float(e)
}

# c_lit_widths asks c_int_dec's question of every leaf without taking its answer: the rendering
# is c_lit_as_float's, and what is wanted here is only the finding.
fn c_lit_widths(mut &em: Emitter, e: ast.Expr) {
	match e {
		Expr.EInt(lex, _, _) => check.chk_int_literal(em, lex)
		Expr.EUnary(_, x) => c_lit_widths(em, x)
		Expr.EBinary(_, a, b) => c_lit_widths_pair(em, a, b)
		_ => c_skip()
	}
}

fn c_lit_widths_pair(mut &em: Emitter, a: ast.Expr, b: ast.Expr) {
	c_lit_widths(em, a)
	c_lit_widths(em, b)
}

# a match arm is an expression, so discarding a bool needs a name to discard it into
fn c_skip_bool(b: bool) {
	return if b

	return
}

# c_either_wrap injects a value into an Either. `Either.Left(v)` and `Either.Right(e)` say
# which side explicitly — they are CONTEXT-TYPED, having no type of their own to be — and a
# bare value picks the side its type matches. The sides of an Either differ (parse_type refuses
# `Either[T, T]`), which is what makes that unambiguous.
fn c_either_wrap(mut &em: Emitter, where: str, want: ast.Ty, e: ast.Expr, sb: Subst) -> str {
	lt := c_either_left(want)
	rt := c_either_right(want)
	cn := c_carrier_name(em, lt, rt)

	# a `Left`/`Right` with the wrong arity is that form used wrongly, not a value whose type
	# happens to be unknown — saying so beats "this is Left", which is what the bare-value
	# path below reports for it
	c_check_ctor_arity(em, e)

	side := c_ctor_side(em, e)
	if side >= 0 {
		inner := c_call_args_of(e)[0]
		return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, where, lt, inner, sb) + " }" if side == 0
		return "(" + cn + "){ .tag = 1, .err = " + c_fit_copied(em, where, rt, inner, sb) + " }"
	}

	et := c_infer(em, e)

	return "(" + cn + "){ .tag = 1, .err = " + c_fit_copied(em, where, rt, e, sb) + " }" if ast.ty_name(et) == ast.ty_name(rt)
	raise c_diag(em, rule.Rule.EitherBareValue, f"a {ast.ty_name(want)} takes a {ast.ty_name(lt)} or a {ast.ty_name(rt)}, and this is {ast.ty_name(et)} — say the side with `Either.Left(…)` or `Either.Right(…)`") if ast.ty_name(et) != ast.ty_name(lt) and not c_is_unknown(et)

	return "(" + cn + "){ .tag = 0, .ok = " + c_fit_copied(em, where, lt, e, sb) + " }"
}

# c_ctor_side is which side of an Either a `Left(v)` / `Right(e)` call names — 0, 1, or -1
# for anything that is not one. They are the only calls whose meaning depends on where they
# are written, which is why they are read here rather than in c_call.
# c_either_no_context is the one complaint both spellings earn. `Left` and `Right` name a
# SIDE and have no type of their own, so they are read where the wanted type is known;
# written where there is none, what is wrong is the missing context and not the form.
#
# It is one function because it is one rule — a code answers to a rule, and the qualified
# and unqualified spellings of it are not two.
fn c_either_no_context(mut &em: Emitter, what: str) {
	raise c_diag(em, rule.Rule.EitherSideUndeclared, f"`{what}(…)` says which side of an `Either` a value is, so it needs a declared one to be — annotate the binding, or write it where a `Result`/`Either` result or parameter is expected")
}

fn c_ctor_side(mut &em: Emitter, e: ast.Expr) -> int {
	return match e {
		Expr.ECall(nm, args, _) => c_ctor_side_bare(em, nm, args.len())
		Expr.EMethod(target, meth, args) => c_ctor_side_of(c_either_qual(target, meth), args.len())
		_ => 0 - 1
	}
}

# c_ctor_side_bare is the UNQUALIFIED spelling, and it is refused. `Left` and `Right` are
# variants of `Either` and the rule about a variant does not have exceptions for a built-in:
# an enum puts its own name into the value namespace and not its variants'. They were the
# last two names in the language that read as themselves, and the reason was mechanical —
# this compiler matched them by name because they are context-typed — rather than a decision
# anybody had made.
#
# It still answers the side, so the program gets ONE finding about the spelling rather than
# a second one about a value whose type could not be worked out.
fn c_ctor_side_bare(mut &em: Emitter, nm: str, n: int) -> int {
	side := c_ctor_side_of(nm, n)
	if side >= 0 {
		check.chk_at(em, rule.Rule.EitherSideNamedBare, f"`{nm}` is a side of an `Either`, and a variant is named through its type — write `Either.{nm}(…)`")
	}

	return side
}

# c_either_qual answers the side a QUALIFIED constructor names — `Either.Left(v)`, the form
# GRAMMAR asks for now that a variant is reached through its type. It answers "" for every
# other method call, so the two shapes go through one table.
#
# `Left` and `Right` are the two constructors this file reads by NAME rather than by
# resolving them, because they are context-typed: they have no type of their own and take
# the one the position wants. That is why qualifying them was not free — every other variant
# was already resolved through its enum, and these two are matched here.
fn c_either_qual(target: ast.Expr, meth: str) -> str {
	return match target {
		Expr.EIdent(nm) => c_either_qual_of(nm, meth)
		_ => ""
	}
}

fn c_either_qual_of(nm: str, meth: str) -> str {
	return meth if nm == "Either" or nm == "Result"

	return ""
}

# c_check_ctor_arity refuses `Left()` / `Right(a, b)`: each side of an Either holds exactly
# one value.
fn c_check_ctor_arity(mut &em: Emitter, e: ast.Expr) {
	match e {
		Expr.ECall(nm, args, _) => c_check_ctor_arity_of(em, nm, args.len())
		Expr.EMethod(target, meth, args) => c_check_ctor_arity_of(em, c_either_qual(target, meth), args.len())
		_ => c_skip()
	}
}

fn c_check_ctor_arity_of(mut &em: Emitter, nm: str, n: int) {
	raise c_diag(em, rule.Rule.EitherSideOneValue, f"`{nm}(…)` names one side of an `Either`, which holds exactly one value — this has {strconv.to_string(n, 10)}") if (nm == "Left" or nm == "Right") and n != 1
}

fn c_ctor_side_of(nm: str, n: int) -> int {
	return 0 if nm == "Left" and n == 1
	return 1 if nm == "Right" and n == 1

	return 0 - 1
}

# c_optchain lowers `a?.b` (GRAMMAR group 8): read `.b` when `a` is present, else nil IN
# PLACE. The result is itself an optional, which is what lets a chain keep going — every
# link answers the same shape, so only the end of it needs a `??` or a `!`.
#
# The operand is bound to a temp because it is read twice, the tag and then the payload,
# exactly as `??` does; and the branch is a statement rather than a ternary because the two
# sides fill different fields of the answer.
fn c_optchain(mut &em: Emitter, target: ast.Expr, fld: str, sb: Subst) -> str {
	t := c_infer(em, target)
	raise c_diag(em, rule.Rule.OptionalChainOnNonOptional, f"`?.` reads through an optional, and {ast.ty_name(t)} is not one — use `.` for a value that is always there") if not ast.ty_is_opt(t)
	inner := c_opt_elem(t)
	ft := c_field_ty(em, c_named_of(inner), fld)
	raise c_diag(em, rule.Rule.NoSuchFieldInChain, f"no field `{fld}` on {ast.ty_name(inner)} (optional chain `?.{fld}`)") if c_is_unknown(ft)

	# a field that is ALREADY optional flattens: `T??` is not a type — GRAMMAR's
	# `type ::= base-type '?'?` allows exactly one marker — and "nil in place" means the
	# chain answers the same shape whether the absence came from the operand or the field.
	mut oft := ft
	if ast.ty_is_opt(ft) {
		oft = c_opt_elem(ft)
	}

	src := c_opt_name(em, inner)
	dst := c_opt_name(em, oft)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	tv := "zgt_oc" + tag
	rv := "zgt_ocr" + tag
	mut out := f"({{ {src} {tv} = {c_expr(em, target, sb)}; {dst} {rv};"
	acc := f"{c_res_ok(tv)}.zg_{fld}"
	mut take := f"{c_res_mark_left(rv)} {c_res_ok(rv)} = {acc};"
	if ast.ty_is_opt(ft) {
		# the field carries its own tag, so the answer IS the field
		take = f"{rv} = {acc};"
	}
	out = out + " if (" + c_res_is_left(tv) + ") { " + take + " }"
	return out + " else { " + c_res_mark_right(rv) + " } " + rv + "; })"
}

# c_try lowers `x?` (GRAMMAR group 8): the payload, or an early return of the absent side
# from the ENCLOSING function. It is a control transfer written as an expression, so what
# it needs is not a lowering trick but a RESULT TYPE that can carry the thing it returns —
# which is why the function's own signature decides whether it can be written at all.
#
# Scoped to the optional. A `Result[T]` operand needs `Result[T]` to survive in a signature,
# and this compiler still erases it there, so that half is refused by name rather than
# early-returning a carrier the caller was never given.
#
# The early return runs the same cleanup an ordinary `return` does — the defers, then every
# binding's release — because it IS an ordinary return, just written inside an expression.
fn c_try(mut &em: Emitter, x: ast.Expr, sb: Subst) -> str {
	t := c_infer(em, x)

	raise c_diag(em, rule.Rule.NotYetTryOnType, f"NotImplemented: `?` on a {ast.ty_name(t)} — it unwraps the Left of a carrier, and that is a `T?`, a `Result[T]` or an `Either[X, Y]`") if not c_is_carrier(t)
	raise c_diag(em, rule.Rule.TryCarrierMismatch, f"`?` early-returns the RIGHT of {ast.ty_name(t)}, so the enclosing function must answer a carrier with the same right — this one answers {ast.ty_name(em.fn_ret)}") if not c_is_carrier(em.fn_ret)

	# the two rights must MATCH: `?` hands the operand's right side straight out of the
	# function, so a `Result[T]` cannot propagate out of one answering `int?` — there would
	# be no Err to put in the absent side, and no absence to make of an Err.
	raise c_diag(em, rule.Rule.TryRightUnanswered, f"`?` propagates the right of {ast.ty_name(t)} out of a function answering {ast.ty_name(em.fn_ret)}, and the two rights differ — convert first (`opt.ok_or(err)`, `res.ok()`)") if not c_right_matches(t, em.fn_ret)

	src := c_carrier_of(em, t)
	rcn := c_carrier_of(em, em.fn_ret)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tv := "zgt_tr" + tag
	mut out := f"({{ {src} {tv} = {c_expr(em, x, sb)};"
	out = out + " if (" + c_res_is_right(tv) + ") {"
	if c_needs_fn_unwind(em) {
		em.fn_mark_used = true
		out = out + " zrt_unwind_to(" + em.fn_mark + ");"
	}

	# the right side travels UNCHANGED — an optional's carries nothing, and an Either's
	# carries the value that is the whole reason the early return happened
	mut right := f"({rcn}){{ .tag = 1 }}"
	if not ast.ty_is_opt(em.fn_ret) {
		right = f"({rcn}){{ .tag = 1, .err = {c_res_err(tv)} }}"
	}
	return out + " return " + right + "; } " + c_res_ok(tv) + "; })"
}

# c_right_matches reports whether two carriers propagate the same thing: an optional's
# right is `nil` and carries nothing, and an Either's is its declared right type.
fn c_right_matches(a: ast.Ty, b: ast.Ty) -> bool {
	return ast.ty_is_opt(b) if ast.ty_is_opt(a)
	return false if ast.ty_is_opt(b)

	return ast.ty_name(c_either_right(a)) == ast.ty_name(c_either_right(b))
}

fn c_optchain_ty(mut &em: Emitter, target: ast.Expr, fld: str) -> ast.Ty {
	t := c_infer(em, target)
	return ast.Ty.TUnknown if not ast.ty_is_opt(t)
	ft := c_field_ty(em, c_named_of(c_opt_elem(t)), fld)

	return ast.Ty.TUnknown if c_is_unknown(ft)
	return ft if ast.ty_is_opt(ft)

	return ast.Ty.TOpt(ft)
}

fn c_opt_elem(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TOpt(e) => e
		_          => ast.Ty.TUnknown
	}
}

# c_is_carrier / c_carrier_elem are what the OPERATORS ask, rather than asking for a
# Result: `??`, `!` and `if v := …` read a tag and a value, and both carriers have those.
# The two only part company where the absent side is built or explained.
pub fn c_is_carrier(t: ast.Ty) -> bool {
	return c_is_either(t) or ast.ty_is_opt(t)
}

fn c_carrier_elem(t: ast.Ty) -> ast.Ty {
	return c_opt_elem(t) if ast.ty_is_opt(t)
	return c_result_elem(t)
}

# c_carrier_of registers whichever carrier a type is and answers its C name.
fn c_carrier_of(mut &em: Emitter, t: ast.Ty) -> str {
	return c_opt_name(em, c_opt_elem(t)) if ast.ty_is_opt(t)
	return c_carrier_name(em, c_either_left(t), c_either_right(t))
}

# c_is_result is the Either whose Right is `Err` — the shape `guard` and a receive answer
# with, and the one `?` propagates out of a function. c_is_either is any of them.
fn c_is_result(t: ast.Ty) -> bool {
	return c_is_either(t) and c_is_err_ty(c_either_right(t))
}

fn c_is_either(t: ast.Ty) -> bool {
	return match t {
		Ty.TEither(_, _) => true
		_ => false
	}
}

fn c_result_elem(t: ast.Ty) -> ast.Ty {
	return c_either_left(t)
}

fn c_either_left(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TEither(l, _) => l
		_ => ast.Ty.TUnknown
	}
}

fn c_either_right(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TEither(_, r) => r
		_ => ast.Ty.TUnknown
	}
}

fn c_is_err_ty(t: ast.Ty) -> bool {
	return match t {
		Ty.TErr => true
		_       => false
	}
}

# --- the carrier's field layout, written down once ---------------------------------
#
# THE LAYOUT LIVES HERE AND NOWHERE ELSE. The typedef below declares it and the accessors
# beside it are how every operator reads and writes one, so `??`, `!`, `guard`, `match`,
# `if let`, `select` and the receive helper name no field of their own. That is not tidiness:
# the layout has to stay byte-compatible with the Go seed's emit_result.go, because the same
# program built by either toolchain has to behave the same way — and the fixpoint gate cannot
# see it drift, since the self-hosted compiler is only ever compared with itself. One place
# to change is the whole of the protection.
#
# `tag == 0` is Left(v) and reads `.ok`; `tag == 1` is Right(err) and reads `.err`.

fn c_res_tag(r: str) -> str {
	return r + ".tag"
}

fn c_res_ok(r: str) -> str {
	return r + ".ok"
}

# c_res_taken is a carrier's payload TAKEN OUT as a value of its own. A carrier is a value
# holding a value, so the thing extracted from one is a copy of it — `mut c := a ?? []` on
# a `list[int]?` handed back the carrier's own header, uncounted, and a write through `c`
# was read back through `a`. The temp the payload comes out of is about to die, so the copy
# is what gives the result a reference of its own.
fn c_res_taken(mut &em: Emitter, r: str, elem: ast.Ty) -> str {
	return c_res_ok(r) if not c_needs_copy(em, elem)
	return c_copy_of(em, elem, c_res_ok(r))
}

# c_carrier_temp_drop names the drop for a carrier THIS EXPRESSION OWNS, or "" for one it
# only borrows. `!`, `??` and `if x := …` all materialise the carrier they read, because
# each reads it twice — the tag, then the value — and each copies the payload out; a carrier
# that named no storage is then left holding the other reference with nothing to give it
# back. The three used to ask that in three spellings, which is three chances to get the
# polarity backwards.
#
# The lvalue test comes FIRST because it is a match on the expression's own tag, where
# c_carrier_drop_fn walks the struct table and registers the carrier.
fn c_carrier_temp_drop(mut &em: Emitter, t: ast.Ty, e: ast.Expr) -> str {
	return "" if not c_owns_value(e)

	return c_carrier_drop_fn(em, t)
}

# c_carrier_owns is whether a carrier holds anything that has to be given back, and it asks
# about BOTH SIDES.
#
# It used to ask only the Left, in both of the places that ask — so an `Either[int, str]` was
# judged to own nothing, got no drop and no copy at all, and every `Either.Right(f"…")` leaked
# the string it was built from. The wrap that builds a Right hands the carrier a
# reference; nothing took it back. A leak and never a double free, which is why nothing
# crashed and why macOS ASan, having no LeakSanitizer, never said a word.
#
# A `Result[T]` is unaffected either way: its Right is an `Err`, whose storage belongs to the
# runtime, so `c_needs_copy` answers no for it exactly as it did.
fn c_carrier_owns(mut &em: Emitter, t: ast.Ty) -> bool {
	return c_needs_copy(em, c_carrier_elem(t)) if ast.ty_is_opt(t)

	return c_needs_copy(em, c_either_left(t)) or c_needs_copy(em, c_either_right(t))
}

# c_carrier_drop_fn names the drop c_carrier_decl generated for this carrier, or "" when
# neither side owns anything and none was generated. The test is c_carrier_decl's own, in the
# same words, because the two are one question asked from either side.
fn c_carrier_drop_fn(mut &em: Emitter, t: ast.Ty) -> str {
	return "" if not c_carrier_owns(em, t)
	return "zg_drop_" + c_carrier_of(em, t)
}

fn c_res_err(r: str) -> str {
	return r + ".err"
}

fn c_res_is_left(r: str) -> str {
	return c_res_tag(r) + " == 0"
}

fn c_res_is_right(r: str) -> str {
	return c_res_tag(r) + " != 0"
}

# c_res_mark_left / c_res_mark_right are the discriminant WRITES — a whole C statement,
# because that is how a carrier is filled in the statement contexts (`guard`, `select`)
# where a compound literal cannot go.
fn c_res_mark_left(r: str) -> str {
	return c_res_tag(r) + " = 0;"
}

fn c_res_mark_right(r: str) -> str {
	return c_res_tag(r) + " = 1;"
}

# c_carrier_name registers the carrier for `Either[L, R]` and answers its C name. Every
# operator that reads one back goes through the accessors above rather than writing `.ok` /
# `.err` itself, which is what lets an optional and an either share the whole set.
fn c_carrier_name(mut &em: Emitter, left: ast.Ty, right: ast.Ty) -> str {
	c_spelled_register(em, ast.Ty.TEither(left, right))
	return c_carrier_cname(left, right)
}

# c_spelled_register places a type's typedef into the on-demand stream — the registering
# face of c_spelled_pre, for a type first met while a BODY is lowered rather than by the
# declaration sweep. Like c_spelled_pre it is asked of ANY type: one that spells a scalar
# or a runtime container answers "nothing to do" by itself, so a call site never dispatches
# on the kind, and a third kind of spelled type inherits every site for free. That sentence
# used to be aspiration: the carriers had this function, the tuples had c_tuple_name's tail,
# and c_const_globals hand-wrote the dispatch a third time.
fn c_spelled_register(mut &em: Emitter, t: ast.Ty) {
	d := c_spelled_pre(em, t)
	if d != "" {
		em.res_decls.append(d)
	}
}

# c_carrier_emit is the ONE gate a carrier's declaration text comes through: it marks the
# shape emitted and answers its text, or "" for a shape already out. Every placer — the
# on-demand register above, the declaration sweep, and a tuple typedef that spells a
# carrier element inline — asks here, so no path can write the same `zg_force_…` twice.
fn c_carrier_emit(mut &em: Emitter, c: ast.Ty) -> str {
	name := c_carrier_ty_cname(c)
	return "" if c_name_in(em.res_names, name)

	em.used_rt = true
	em.res_names.append(name)
	return c_carrier_decl(em, c)
}

# c_spelled_pre answers the typedefs a type's C SPELLING names, or "" for one that spells
# a scalar or a runtime container (`list[(int, int)]` is `zrt_list` — the tuple inside is
# behind a pointer and named nowhere). It is what a typedef about to spell `c_type(t)` for
# a field calls first: the tuple and the carrier renderers each ask it of their members, so
# a tuple holding a carrier and a carrier holding a tuple both come out inner-first no
# matter which of the two the program met first.
#
# The mutual recursion terminates the way c_needs_copy's does: a Ty is a finite tree, and
# both arms descend only into strictly smaller components of it — a tuple's elements, a
# carrier's payloads. c_carrier_emit also marks a shape before its declaration descends, so
# even a shape the walk meets twice answers "" instead of being walked again.
fn c_spelled_pre(mut &em: Emitter, t: ast.Ty) -> str {
	return c_tuple_decl(em, ast.ty_tuple_elems(t)) if c_is_tuple(t)
	return c_carrier_emit(em, t) if c_is_carrier(t)

	return ""
}

# c_carrier_decl writes ONE carrier: a tag, the Left, and — unless it is an optional, whose
# absent side carries nothing — the Right. The field names are the same for all three, so
# every accessor and every operator works on any of them without asking which it is.
#
# The layout has to stay byte-compatible with the Go seed's emit_result.go, because the same
# program built by either toolchain has to behave the same way.
fn c_carrier_decl(mut &em: Emitter, c: ast.Ty) -> str {
	name := c_carrier_ty_cname(c)
	left := c_carrier_left(c)
	ct := c_type(left)

	# the typedef about to be written SPELLS its payload's C type, so a payload that is
	# itself a tuple or a carrier must have its own typedef out first — `x: (int, int)? =
	# nil` wrote `zgt_tup_…` into this struct with nobody having written the tuple, and cc
	# reported it against generated C
	mut d := c_spelled_pre(em, left)
	if ast.ty_is_opt(c) {
		d = d + f"typedef struct {{ int32_t tag; {ct} ok; }} {name};\n"
	} else {
		d = d + c_spelled_pre(em, c_either_right(c))
		d = d + f"typedef struct {{ int32_t tag; {ct} ok; {c_type(c_either_right(c))} err; }} {name};\n"
	}
	d = d + "static " + ct + " zg_force_" + name + "(" + name + " r) {\n"

	# forcing a Right RE-RAISES it when it is an Err — the reason it is there is in it. An
	# optional's absent side and a general Either's Right carry no abort, so forcing one
	# raises a message of its own.
	#
	# The Err goes up WHOLE — message, cause and kind — and the runtime renders the kind's
	# name onto the abort line, so a clean close (the message "channel closed" under the
	# kind StopIteration) is still told apart from a crash without this having to build the
	# prefix itself. It used to, in a `zg_err_kindname` prelude that was a second copy of
	# the taxonomy's numbering.
	mut fail := "zrt_raise_err(zrt_err_new(\"force-unwrap of a Right\"));"
	if ast.ty_is_opt(c) {
		fail = "zrt_raise_err(zrt_err_new(\"force-unwrap of nil\"));"
	} else if c_is_err_ty(c_either_right(c)) {
		fail = "zrt_raise_err(" + c_res_err("r") + ");"
	}
	d = d + "    if (" + c_res_is_right("r") + ") { " + fail + " }\n"

	# the payload is TAKEN OUT, so it comes out as a value of its own — `r` is a by-value
	# parameter about to die, and returning its header uncounted made `a!` a second name
	# for the carrier's buffer
	d = d + "    return " + c_res_taken(em, "r", left) + ";\n}\n"

	# and the PAIR, for a carrier whose payload owns something: a drop, and — this is the
	# half that was missing — a copy.
	#
	# The drop alone is why `got := <-c` registered nothing. The argument written here used
	# to be that registering it would let two names for one value each give it back, and
	# that is true of a carrier with no copy: a carrier is a value holding a value, so
	# without one the second name is a bit pattern nobody counted. With one, each name holds
	# a reference of its own and gives back exactly what it took, which is the rule every
	# other owning type in this file already follows.
	#
	# The copy retains only a PRESENT payload: `tag != 0` carries nothing, and retaining
	# whatever bytes sit in `ok` would count a cell the carrier does not hold.
	# WHETHER TO EMIT THE PAIR IS THE QUESTION THE CALL SITES ASK, and it is asked in their
	# words. This used to compare c_drop_stmt's TEXT against the do-nothing spelling, while
	# c_copy_of, c_elem_kind and c_drop_thunk each decided to name these helpers from
	# c_needs_copy — so a payload the two dispatches disagreed about got no helpers and was
	# named anyway. `(int, str)?` was that payload, and cc reported the undefined symbol.
	return d if not c_carrier_owns(em, c)

	# EACH SIDE IS GIVEN BACK BY THE ARM THAT HOLDS IT. The Left arm is written whenever the
	# Left owns something and the Right arm whenever the Right does, so a carrier where only
	# one of them does gets exactly one arm — and an optional, which has no Right, gets the
	# Left arm alone as it always did.
	mut df := ""
	if c_needs_copy(em, left) {
		df = "    if (" + c_res_is_left("(*r)") + ") { " + c_drop_stmt(em, left, "r->ok") + " }\n"
	}
	mut cf := ""
	if c_needs_copy(em, left) {
		cf = "    if (" + c_res_is_left("v") + ") { " + c_res_ok("v") + " = " + c_copy_of(em, left, c_res_ok("v")) + "; }\n"
	}
	if not ast.ty_is_opt(c) {
		right := c_either_right(c)
		if c_needs_copy(em, right) {
			df = df + "    if (" + c_res_is_right("(*r)") + ") { " + c_drop_stmt(em, right, "r->err") + " }\n"
			cf = cf + "    if (" + c_res_is_right("v") + ") { " + c_res_err("v") + " = " + c_copy_of(em, right, c_res_err("v")) + "; }\n"
		}
	}

	d = d + "static void zg_drop_" + name + "(" + name + " *r) {\n" + df + "}\n"
	d = d + "static " + name + " zg_copy_" + name + "(" + name + " v) {\n" + cf + "    return v;\n}\n"

	# and the ELEMENT VTABLE, because a `list[str?]`, a map value and a struct field of
	# carrier type all reach the pair through a thunk rather than by name — and so does
	# c_drop_thunk, which is what a binding's `zrt_defer` is given. Nothing else would
	# generate one: a carrier is not in `f.structs`, so a missing thunk is cc reporting an
	# undefined symbol against generated code.
	return d + c_elem_vt_helper(em, c)
}

# c_carrier_ty_cname / c_carrier_left read a carrier TYPE — an optional or an either —
# without the caller having to know which of the two it holds.
fn c_carrier_ty_cname(c: ast.Ty) -> str {
	return c_opt_cname(c_opt_elem(c)) if ast.ty_is_opt(c)
	return c_carrier_cname(c_either_left(c), c_either_right(c))
}

fn c_carrier_left(c: ast.Ty) -> ast.Ty {
	return c_opt_elem(c) if ast.ty_is_opt(c)
	return c_either_left(c)
}

# A held function is stored as ONE C type, `zg_fnptr` — a generic function pointer PLUS an
# environment slot — and the pointer is cast back to its real signature at the call. C
# guarantees exactly that round trip between function pointer types and no more, which is
# why the code half is a function pointer rather than `void*`: converting a function pointer
# to an object pointer is not something the standard promises. The environment is an object
# pointer and is kept in a field of its own for the same reason — the two cannot share one
# slot under any cast C blesses.
#
# THE ENVIRONMENT IS ALWAYS NULL TODAY. A lambda that captures nothing needs none, and a
# lambda that captures fills it with a per-site struct of the values it closed over. Every
# fn value reaches its code through ONE C signature — the environment first, then the
# declared parameters — so a call site never has to know which of the two it is holding;
# c_fnval_thunk is what gives a plain function that shape.
#
# A single storage type is also what keeps the declarator problem away. A C function
# pointer spells its name INSIDE the type — `int64_t (*f)(const char*)` — and every type
# in this emitter is a string that gets a name appended to it. A typedef sidesteps that
# for every function type at once, with no table of them to build and keep.
fn c_fnptr_typedef() -> str {
	return "typedef struct { void (*fn)(void); const void *env; } zg_fnptr;\n"
}

# c_fnptr_helpers is the (copy, drop) pair for a held function — ONE pair for the whole
# program, not one per lambda, and that is the whole of why a fn value can be owned at all.
#
# Every other type in this file picks its drop by its STATIC type. A function type cannot:
# `fn(int) -> int` is the type of every lambda with that shape, and each has a different
# environment to tear down. So the per-site part goes into the CELL — zrt_ref_hdr carries a
# drop, and zrt_release runs it at zero — and the type layer is left with one release that
# knows nothing about what it is releasing.
#
# `env` holds the PAYLOAD pointer and the header is recovered as `- 1`, which is what a
# managed `str` already does (fmt.c). The alternative, storing the header, would need every
# thunk and every cast to change with it, and any site that was missed would be a silent
# release at the wrong address — nothing here would see it.
#
# BOTH ARE NULL-GUARDED, so a NAMED function held as a value — `{thunk, NULL}` — costs a
# branch and nothing else. That is why one pair serves both and the type never has to ask
# which kind of fn value it is holding.
fn c_fnptr_helpers() -> str {
	mut out := "static zg_fnptr zg_copy_fnptr(zg_fnptr v) {\n"
	out = out + "    if (v.env != NULL) { zrt_retain((zrt_ref_hdr *)v.env - 1); }\n    return v;\n}\n"
	out = out + "static void zg_drop_fnptr(zg_fnptr *v) {\n"
	out = out + "    if (v->env != NULL) { zrt_release((zrt_ref_hdr *)v->env - 1); v->env = NULL; }\n}\n"
	out = out + "static void zg_elemcopy_fnptr(void *dst, const void *src) {\n"
	out = out + "    *(zg_fnptr*)dst = zg_copy_fnptr(*(const zg_fnptr*)src);\n}\n"
	out = out + "static void zg_elemdrop_fnptr(void *elem) { zg_drop_fnptr((zg_fnptr*)elem); }\n"
	return out + "static const zrt_elem_vt zg_listvt_fnptr = {zg_elemcopy_fnptr, zg_elemdrop_fnptr};\n"
}

# c_fnptr_cast is the cast back to a real signature, `(R (*)(const void *, P, ...))`.
#
# THE ENVIRONMENT IS ALWAYS THE FIRST PARAMETER, whether or not there is one to pass. A
# closure has an env and a plain function has none, and a call site cannot know which it is
# holding — so every fn value is reached through one shape, and what differs is what the
# thing behind it does with the pointer. c_fnval_thunk is what gives a plain function that
# shape.
fn c_fnptr_cast(t: ast.Ty) -> str {
	return match t {
		Ty.TFn(ps, r) => f"({c_type(r)} (*)(const void *{c_ptypes_after(ps)}))"
		_             => ""
	}
}

fn c_ptypes_after(ps: list[ast.Ty]) -> str {
	mut out := ""
	for pt in ps {
		out = out + ", " + c_type(pt)
	}
	return out
}

pub fn c_is_fn(t: ast.Ty) -> bool {
	return match t {
		Ty.TFn(_, _) => true
		_            => false
	}
}

fn c_fn_ret(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TFn(_, r) => r
		_            => ast.Ty.TUnknown
	}
}

# c_args_after renders the arguments of a call through a function VALUE, after the leading
# environment. It takes the function TYPE rather than its parameter list, because the type
# is what the arity rule needs and destructuring it at each caller is how that rule came to
# be asked at neither: `f(v, 1)` on a `fn (int) -> int` rendered a third argument into a
# two-argument cast and cc reported it.
fn c_args_after(mut &em: Emitter, fty: ast.Ty, args: list[ast.Expr], sb: Subst) -> str {
	check.chk_fnval_arity(em, fty, args.len())

	# A CALL THROUGH A FUNCTION VALUE SEQUENCES ITS ARGUMENTS, exactly as a direct call
	# does. This was the last combining form in either compiler still handing its operands
	# to one C construct and inheriting C's unspecified order (docs/core/memory.md).
	#
	# It is asked HERE and not in `c_args_typed`, which this shares with the intrinsics and
	# the built-in error constructors: those two stay unsequenced, and they stay unsequenced
	# in the seed too. The two compilers must agree about which operands are sequenced or
	# `make oracle` becomes a tripwire waiting for a program that can tell — so the boundary
	# is drawn in the same place on both sides, and moving it is a change to both.
	rendered := c_args_typed(em, c_fn_params(fty), args, sb, c_needs_order(args, 0))
	return "" if rendered == ""

	return ", " + rendered
}

# c_fn_params is c_fn_ret's other half — a function TYPE's parameter list, or an empty one
# from anything else. It lives here rather than beside its caller so the two halves of one
# destructuring are read together.
pub fn c_fn_params(t: ast.Ty) -> list[ast.Ty] {
	return match t {
		Ty.TFn(ps, _) => ps
		_             => []
	}
}

pub fn c_is_unknown(t: ast.Ty) -> bool {
	return match t {
		Ty.TUnknown => true
		_           => false
	}
}

pub fn c_is_byte(t: ast.Ty) -> bool {
	return match t {
		Ty.TByte => true
		_        => false
	}
}

# c_is_uint is `uint` alone. It is deliberately NOT folded into c_is_int: the two are the
# pair docs/core/types.md refuses to mix, so every rule that says "an integer" has to say
# which one it means, and a predicate covering both would let the mixing back in by the
# side door.
pub fn c_is_uint(t: ast.Ty) -> bool {
	return match t {
		Ty.TUint => true
		_        => false
	}
}

# c_is_rune is `rune` alone — a code point, which is a signed 32-bit value because that is
# what holds every one of them with room to say "not a character" at -1.
pub fn c_is_rune(t: ast.Ty) -> bool {
	return match t {
		Ty.TRune => true
		_        => false
	}
}

pub fn c_is_str(t: ast.Ty) -> bool {
	return match t {
		Ty.TStr => true
		_       => false
	}
}

# c_list_elem returns the element type of a list type, or TUnknown otherwise.
pub fn c_list_elem(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TList(e) => e
		_           => ast.Ty.TUnknown
	}
}

pub fn c_is_list(t: ast.Ty) -> bool {
	return match t {
		Ty.TList(_) => true
		_           => false
	}
}

pub fn c_is_float(t: ast.Ty) -> bool {
	return match t {
		Ty.TFloat => true
		_         => false
	}
}

pub fn c_is_int(t: ast.Ty) -> bool {
	return match t {
		Ty.TInt => true
		_       => false
	}
}

# c_is_bool_op reports whether a binary operator yields a bool (comparisons and the
# logical connectives).
fn c_is_bool_op(oper: str) -> bool {
	return true if oper == "==" or oper == "!=" or oper == "<" or oper == ">" or oper == "<=" or oper == ">="
	return oper == "and" or oper == "or"
}

# --- environment + signatures --------------------------------------------------

fn c_reset_env(mut &em: Emitter) {
	em.env_names = []
	em.env_tys = []
	em.env_cnames = []
	em.env_dead = []
	em.env_mut = []
	em.env_scope = []
	em.env_const = []
	em.env_cval = []
	em.frz_idxs = []
	em.frz_paths = []

	# scope 0 is the module: the constants below live there and it is open in every
	# function. c_fn opens one more for the parameters, and the body block one after that.
	em.scope_cur = 0
	em.open_scopes = [0]
	em.rel_cnames = []
	em.rel_fns = []
	em.loop_keep = 0
	em.loop_mark_used = false
	em.loop_defer = false
	em.loop_mark = ""
	em.force_mark = ""
	em.fn_mark_used = false
	em.ref_names = []

	# a module constant is a global: in scope everywhere, so every function body starts
	# with them already bound
	mut i := 0
	for i < em.k_decls.len() {
		# a module binding is writable exactly when it was declared `mut` — legally so inside
		# a module-level `unsafe { … }` group, where it is the language's mutable global
		# (docs/runtime/ffi.md); a safe-code `mut` is refused (chk_top_muts) but stays writable
		# too, so its writes do not each add a second finding about immutability on top of the
		# one that counts. Scope 0 is the module, so a constant is in scope in every function
		# and a local that shadows one is in a block of its own; and a KEYWORD `const` is
		# shadow-proof in every body the way a local `const` is (chk_const_rebind). All of that
		# is c_const_bind's, which c_const_globals also calls as it registers each row.
		c_const_bind(em, em.k_decls[i], em.k_tys[i])
		i = i + 1
	}
}

# c_add_var binds a name. `is_mut` is whether it may be written afterwards, and every
# caller answers it from the form it is emitting rather than from a default: a `mut`
# binding and a `mut &` parameter say yes; a plain binding, a by-value parameter, a loop
# variable and a pattern binding all say no. `is_const` is whether the name was declared
# with the `const` KEYWORD — only c_let can say yes, since `binding` is the one production
# that mints a `const` — and it is answered here so the shadow-proofing registry has the
# same one home the environment has.
#
# The rebind check runs FIRST: every name-introducing site — binding, loop variable,
# match-arm bind, parameter — enters the environment through this gate, so this is where
# "no later binding may take a const's name" covers all of them at once; and asking before
# the rows are appended is what keeps a `const` from colliding with itself.
# c_fold_initializer is what a declaration contributes to env_cval: its initializer's value
# when the binding cannot be written, and nothing when it can. It is a function of its own so
# that the `mut` exemption is stated once — the rule is about the BINDING, not about the
# expression, and reading it off `is_mut` at the one call site would put the rule inside a
# forty-line function that is about something else.
fn c_fold_initializer(mut &em: Emitter, is_mut: bool, ival: ast.Expr) -> check.Folded {
	return check.Folded(false, 0) if is_mut

	return check.chk_const_eval(em, ival)
}

fn c_add_var(mut &em: Emitter, name: str, t: ast.Ty, is_mut: bool, is_const: bool) {
	c_add_var_named(em, name, t, c_fresh_cname(em, name), is_mut, is_const)
}

# c_add_var_named is c_add_var for a binding whose C NAME was decided by whoever is making
# it, rather than minted here — a `select` arm's receive binding is the one such site, since
# the value is already sitting in the per-arm temp the wait wrote it into.
#
# It exists because that site was writing the environment's columns BY HAND, and a row
# written by hand is a row that can be the wrong shape. It was: seven of the eight columns
# were appended and `env_cval` was not, so from the first receive binding onwards every
# later binding's index into `env_names` pointed one row too far into `env_cval` — and
# `chk_fold_name` reads that column by exactly that index. A program with a `select` in it
# folded a range bound to the NEXT binding's value and matched against a number written
# nowhere, silently. It also skipped the two rules every other binder passes (E3054, E9070).
#
# The columns are appended in ONE place now, so the count cannot drift again.
fn c_add_var_named(mut &em: Emitter, name: str, t: ast.Ty, cname: str, is_mut: bool, is_const: bool) {
	check.chk_const_rebind(em, name)
	check.chk_no_shadow_ns(em, name)
	c_no_shadow_sub(em, name)

	em.env_names.append(name)
	em.env_tys.append(t)
	em.env_cnames.append(cname)
	em.env_dead.append(0)
	em.env_mut.append(is_mut)
	em.env_scope.append(em.scope_cur)

	# a `const` is shadow-proof from here to the end of its block, which is this row's block
	em.env_const.append(is_const)

	# NOTHING IS A COMPILE-TIME VALUE BY DEFAULT. Every binder in the language arrives here —
	# a parameter, a loop variable, a match-arm bind, a declaration — and only one of them can
	# carry a folded value, so the row is opened empty and c_let fills the one case in. A
	# default the other way round would make a loop variable fold to whatever the last
	# declaration of that name was, silently, which is exactly the shape of bug a column
	# parallel to env_names exists to prevent.
	em.env_cval.append(check.Folded(false, 0))
}

# EnvCols is those same eight columns as ONE value, for the sites that put a whole
# environment BACK.
#
# The comment above says the columns are appended in one place so the count cannot drift.
# Restoring them was the other direction of exactly that argument, and it was being done by
# hand at two sites: a lambda's body is emitted with its own environment (c_lambda), and a
# block's last statement is typed with a throwaway one (c_last_val_ty). c_lambda listed
# SEVEN — `env_cval` was not among them — so a lambda that bound anything at all, a
# parameter included, left the fold column longer than `env_names` while every other column
# was put back. chk_fold_name indexes the one by the other, so from there on a binding read
# a DIFFERENT row's folded value: `n := 3` then `[0; n]` after a lambda was refused as "not
# a compile-time constant", naming the one part of the line that was fine.
#
# A ninth column is one edit here, not a fresh chance for a site to remember eight.
struct EnvCols {
	pub names: list[str]
	pub tys: list[ast.Ty]
	pub cnames: list[str]
	pub dead: list[int]
	pub muts: list[bool]
	pub scope: list[int]
	pub consts: list[bool]
	pub cval: list[check.Folded]
}

fn c_env_save(mut &em: Emitter) -> EnvCols {
	return EnvCols(em.env_names, em.env_tys, em.env_cnames, em.env_dead, em.env_mut, em.env_scope, em.env_const, em.env_cval)
}

fn c_env_restore(mut &em: Emitter, saved: EnvCols) {
	em.env_names = saved.names
	em.env_tys = saved.tys
	em.env_cnames = saved.cnames
	em.env_dead = saved.dead
	em.env_mut = saved.muts
	em.env_scope = saved.scope
	em.env_const = saved.consts
	em.env_cval = saved.cval
}

# c_no_shadow_sub refuses a binding that takes a name an ACTIVE substitution holds.
#
# A substitution is text, not a scope: c_ident_val answers from it before it ever asks what
# is bound, so a `v := 1` inside `match x { A(v) => { v := 1  v } }` would declare a C local
# that every later read of `v` walked straight past — the arm's payload answering in its
# place, silently and with no diagnostic. Shadowing a pattern binding inside its own arm is
# a rare thing to write and a wrong answer when written, so it is named rather than lowered.
#
# It sits in c_add_var because that is the one funnel every binder in the language reaches:
# a declaration, a parameter, a loop variable, a match arm's own binds.
fn c_no_shadow_sub(mut &em: Emitter, name: str) {
	mut i := 0
	for i < em.sub.names.len() {
		raise c_diag(em, rule.Rule.NotYetRebindMatchBinding, f"NotImplemented: `{name}` re-binds a name a `match` arm's pattern already binds in this block — the arm's binding is spliced in as text, so the new one would never be read. Pick another name") if em.sub.names[i] == name
		i = i + 1
	}
}

# c_fresh_cname is the C name a new binding takes: `zg_<name>`, or `zg_<name>__<n>` when
# that is already taken by a binding still in scope.
fn c_fresh_cname(mut &em: Emitter, name: str) -> str {
	base := "zg_" + name
	mut cand := base
	mut n := 0
	for c_cname_taken(em, cand) {
		n = n + 1
		cand = f"{base}__{n}"
	}
	return cand
}

# c_in_scope is whether a binding's block is still open. A closed block's bindings stay in
# the environment — their C names must not be handed out twice — but nothing may NAME them.
#
# It used to have a twin that asked the same question about a block ID rather than a row,
# because the `const` registry recorded ids with no env row to index through. That registry
# is a column on these rows now (env_const), so every asker has a row and the twin has
# nothing left to be for.
pub fn c_in_scope(mut &em: Emitter, idx: int) -> bool {
	for sid in em.open_scopes {
		return true if sid == em.env_scope[idx]
	}
	return false
}

fn c_cname_taken(mut &em: Emitter, cand: str) -> bool {
	for c in em.env_cnames {
		return true if c == cand
	}
	return false
}

# c_var_cname resolves a source name to the C name its binding took — the innermost one
# STILL IN SCOPE, so a shadowing binding wins from its declaration until its block ends.
#
# It and c_lookup_var both defer to c_live_idx rather than repeating its walk. They used to
# be three copies of one loop, which meant the scoping rule had three homes: adding
# `c_in_scope` to it was one edit made three times, and the next rule would be too.
fn c_var_cname(mut &em: Emitter, name: str) -> str {
	idx := c_live_idx(em, name)
	return em.env_cnames[idx] if idx >= 0
	return "zg_" + name
}

# c_tmp mints a fresh C name for a temporary this emitter has to hold on to. Every use of
# it is a name that must not collide with one still live — a call nested in another call's
# argument, an index inside an index — so the counter is global to the unit rather than to
# the site. Getting that wrong shadows a live temporary and produces C that compiles and is
# wrong, which is why the increment is not left to twelve call sites to remember.
fn c_tmp(mut &em: Emitter, pfx: str) -> str {
	em.tmp_n = em.tmp_n + 1
	return pfx + strconv.to_string(em.tmp_n, 10)
}

# c_needs_fn_unwind is whether a `return` — or a `?` taking its early exit — has anything to
# give back on its way out. The pending list is exactly what is live AT THIS POINT, so a
# `return` written above a binding owes it nothing, and a `defer` scheduled earlier sets the
# flag because it puts a record on the same stack without passing through the list.
fn c_needs_fn_unwind(mut &em: Emitter) -> bool {
	return em.rel_cnames.len() > 0 or em.fn_mark_used
}

# c_new_mark is the same for a cleanup-stack mark: a name for a `size_t` holding the depth
# a scope was entered at, which every exit from that scope unwinds back to.
fn c_new_mark(mut &em: Emitter) -> str {
	em.dfn_n = em.dfn_n + 1
	return "zgt_mk" + strconv.to_string(em.dfn_n, 10)
}

fn c_lookup_var(mut &em: Emitter, name: str) -> ast.Ty {
	idx := c_live_idx(em, name)
	return em.env_tys[idx] if idx >= 0
	return ast.Ty.TUnknown
}

# --- `del` liveness ----------------------------------------------------------------
#
# `del name` revokes a name's access (GRAMMAR group 11, docs/core/memory.md). The
# revocation is the entire statement — it emits no C — so it is worth only as much as the
# check that a revoked name is never read again, and the check has to be FLOW-SENSITIVE or
# it says the wrong thing about an `if` that revokes on one branch.
#
# The model is the seed's (src/bootstrap/internal/sema/sema.go, the `liveness` type and
# mergeDead), carried on the flat env stack this emitter already keeps: a name dead on
# every path reaching a use is a hard use-after-del, dead on some paths but not others is
# its own case, and the two get different words because they are different mistakes.
#
# It rides the emission walk rather than a pass of its own, which is why the merge points
# are written out at each control-flow form: the emitter already visits a body exactly
# once, in source order.

# c_live_idx is the index of the innermost binding of a name, or -1 when nothing binds it.
pub fn c_live_idx(mut &em: Emitter, name: str) -> int {
	mut i := em.env_names.len() - 1
	for i >= 0 {
		return i if em.env_names[i] == name and c_in_scope(em, i)
		i = i - 1
	}
	return -1
}

# c_live_del marks a name revoked on this path. Revoking is idempotent, so a symmetric
# `del` on both branches of an `if` merges cleanly back to revoked.
fn c_live_del(mut &em: Emitter, name: str) {
	idx := c_live_idx(em, name)
	return if idx < 0
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i == idx {
			out.append(1)
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_use refuses a read of a revoked name. This is the whole payoff: what used to be a
# use-after-free waiting to happen is a diagnostic at the line that wrote it.
#
# THROUGH THE CHECKING CHANNEL, which is where both of these belonged all along. They are
# rules the compiler genuinely checks — a flow-sensitive analysis over the environment is
# not a form it has failed to build — and they reported by `raise`, so they carried neither
# a code nor a place. docs/conformance.md counted them among the handful of checked rules
# that had fallen on the refusals' side of that split; chk_at is the other side, and it
# hands over both. It also collects rather than stopping, so a file that reads two revoked
# names is told about both.
fn c_live_use(mut &em: Emitter, name: str) {
	idx := c_live_idx(em, name)

	return if idx < 0
	if em.env_dead[idx] == 1 {
		check.chk_at(em, rule.Rule.UseAfterDel, f"`{name}` is used after del — `del {name}` revoked this name's access to its storage (GRAMMAR#del-stmt), and the revocation holds for the rest of the block")
	}
	if em.env_dead[idx] == 2 {
		check.chk_at(em, rule.Rule.UseAfterDelOnSomePaths, f"`{name}` is used after del on some paths — one branch above revoked it and another did not, and `del` is flow-consistent: a name dead on ANY path is dead on all of them from there on")
	}
}

# c_live_save copies the current liveness, so a branch can be analysed from the shared
# entry state and its end merged rather than leaking into its sibling.
fn c_live_save(mut &em: Emitter) -> list[int] {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		out.append(em.env_dead[i])
		i = i + 1
	}
	return out
}

# c_live_restore puts a saved entry state back, so the next branch starts where the first
# one did. A binding the branch declared is past the end of the saved list and stays as it
# is — it is out of scope by the time this matters.
fn c_live_restore(mut &em: Emitter, saved: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i < saved.len() {
			out.append(saved[i])
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_merge joins one path's end state into the current one, entry by entry.
fn c_live_merge(mut &em: Emitter, other: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < em.env_dead.len() {
		if i < other.len() {
			out.append(c_live_join(em.env_dead[i], other[i]))
		} else {
			out.append(em.env_dead[i])
		}
		i = i + 1
	}
	em.env_dead = out
}

# c_live_join is the two-path join: revoked on both stays revoked, live on both stays live,
# and one of each is the inconsistent case a later use is refused for.
fn c_live_join(a: int, b: int) -> int {
	return 0 if a == 0 and b == 0
	return 1 if a == 1 and b == 1

	return 2
}

# c_sig_key is how a function is looked up in the signature and parameter tables. A free
# function is keyed by its bare name; a method by `Type#name`. The '#' cannot occur in an
# identifier, so a method can never be mistaken for the free function of the same name —
# which is the whole point, since `App.parse` and the compiler's own `parse` must coexist.
pub fn c_sig_key(recv: str, name: str) -> str {
	return name if recv == ""
	return f"{recv}#{name}"
}

# c_fn_cname is the C symbol a function is emitted as. Free functions share one flat
# `zg_<name>` space with every module of the program; a method is `zg_<Type>_<name>`, off
# that space and unable to collide with it, since a type name is PascalCase and so cannot
# be confused with the snake_case free functions it sits beside.
# c_fn_cname_in is a free function's C name AS SEEN FROM a module. It differs from
# c_fn_cname for one case: a private name two modules both declare, which needs two symbols.
# Everything else keeps `zg_<name>`, so the change costs nothing anywhere it is not needed.
#
# The tag is the module's position in a SORTED list of the program's modules. Sorted rather
# than first-seen because `fixpoint` compares emitted C byte for byte, and a tag that
# depended on the order files were read would move the output without the program changing.
fn c_fn_cname_in(mut &em: Emitter, mod: str, recv: str, name: str) -> str {
	return c_fn_cname(recv, name) if recv != "" or mod == "" or not c_name_in(em.mod_tagged, name)

	return f"zg_m{strconv.to_string(c_mod_tag(em, mod), 10)}_{name}"
}

# c_mod_tag answers a module's position among the program's modules, in sorted order. The
# list is built once, from what the signature pass recorded.
fn c_mod_tag(mut &em: Emitter, mod: str) -> int {
	if em.mod_order.len() == 0 {
		mut names: list[str] = []
		for m in em.sig_mod {
			if m != "" and not c_name_in(names, m) {
				names.append(m)
			}
		}
		em.mod_order = c_sorted_names(names)
	}
	mut i := 0
	for i < em.mod_order.len() {
		return i if em.mod_order[i] == mod
		i = i + 1
	}
	return 0
}

# c_sorted_names is an insertion sort over module names — a handful of them, once, and the
# ORDER is what has to be reproducible rather than the sort fast.
#
# IT SORTS BY THE MODULE'S NAME AND NOT BY ITS PATH, and that is the whole of what makes the
# order reproducible. A module's identity here is the DIRECTORY it was read from, so the same
# program built as `zerg build src/compiler/zergc.zg` and as `zerg build /abs/…/zergc.zg`
# named its modules two different ways — and sorting those strings put them in two different
# ORDERS, because the standard library's directory is absolute either way while the project's
# was not. The same private function came out `zg_m2_has_str` in one build and `zg_m4_has_str`
# in the other: 450 KB of a 4.5 MB C file differing for a program nobody changed.
#
# The last segment is the name a reader writes and a reader's spelling of the ENTRY path
# cannot reach it. Ties — two modules whose paths end in the same segment, `a/text` and
# `b/text` — keep the order they were first seen in, which is the import walk's and is a
# property of the program rather than of the filesystem: `<=` and not `<` is what makes the
# insertion stable, and `<` here would reverse them instead.
fn c_sorted_names(names: list[str]) -> list[str] {
	mut out: list[str] = []
	for n in names {
		mut at := 0
		for at < out.len() and ast.last_segment(out[at]) <= ast.last_segment(n) {
			at = at + 1
		}
		mut next: list[str] = []
		mut i := 0
		for i < out.len() {
			if i == at {
				next.append(n)
			}
			next.append(out[i])
			i = i + 1
		}
		if at >= out.len() {
			next.append(n)
		}
		out = next
	}
	return out
}

fn c_fn_cname(recv: str, name: str) -> str {
	return c_spec_cname(name) if c_is_mangled(name)
	return "zg_" + name if recv == ""

	return f"zg_{recv}_{name}"
}

# c_is_mangled / c_spec_cname are the SPECIALIZATION's C name. A mangled name carries `$`,
# which no Zerg identifier may hold — that is what makes it unforgeable — and which is not a
# C identifier character either: clang and gcc accept it as an extension, and `-std=c11
# -pedantic-errors` rejects it outright, so it could never have left this machine.
#
# Replacing `$` with `_` alone is NOT enough, and the program that shows it is one line long:
# a user function called `id_int` beside a template `id[T]` instantiated at `int` would both
# want `zg_id_int`. So specializations take a prefix of their own, off the flat space a
# program shares, exactly as a method's `zg_<Type>_<name>` is off it.
fn c_is_mangled(name: str) -> bool {
	for b in bytearray(name) {
		return true if b == b'$'
	}
	return false
}

fn c_spec_cname(name: str) -> str {
	mut out := "zgg_"
	for b in bytearray(name) {
		out = out + c_cname_byte(b)
	}
	return out
}

fn c_cname_byte(b: byte) -> str {
	mut one: list[byte] = []
	if b == b'$' {
		one.append(b'_')
	} else {
		one.append(b)
	}
	return str(one)
}

# c_sig_seen is `c_name_in(em.sig_names, key)` without the copy. `c_name_in` takes its list
# BY VALUE, and this question is asked once per function — 788 of them in a self-build — so
# the copy alone was ~310k element copies per unit for a scan that needs none.
fn c_sig_seen(mut &em: Emitter, key: str) -> bool {
	mut i := 0
	for i < em.sig_names.len() {
		return true if em.sig_names[i] == key
		i = i + 1
	}
	return false
}

# c_build_generics records every generic TEMPLATE. It runs before c_build_sigs, which then
# skips them: a template has no signature to record, because its parameter types name things
# that are not types yet.
fn c_build_generics(mut &em: Emitter, f: ast.File) {
	for fn_i in f.fns {
		if c_is_template(fn_i) {
			raise c_diag_at(fn_i.path, fn_i.line, fn_i.col, rule.Rule.NotYetGenericMethod, f"NotImplemented: a generic METHOD `{fn_i.recv}.{fn_i.name}[…]` — this compiler instantiates a free function, and a method's specializations would each need a name in its type's namespace") if fn_i.recv != ""
			c_check_gen_dup(em, f, fn_i)
			em.gen_names.append(fn_i.name)
			em.gen_tpls.append(fn_i)
		}
	}
}

# c_check_gen_dup is the DUPLICATE-DECLARATION rule for a template. It has to be made here
# because a template is removed from the program before c_build_sigs runs, so the two rules
# that pass holds — a method declared twice, and two modules defining one name — never see
# one. Every collision a template can be in was therefore silent, and the template WON:
#
#   fn to_string[T](x: T, base: int) -> str { return "HIJACKED" }
#   print strconv.to_string(42, 10)          # printed HIJACKED
#
# because a module's names flatten into the one program-wide function space here, so the
# stdlib's `to_string` and a local template of that name are the same name — and `c_call`
# asks `c_is_generic` before it asks anything else. The seed refuses the same program.
fn c_check_gen_dup(mut &em: Emitter, f: ast.File, tpl: ast.FnDecl) {
	name := tpl.name

	# REPORTED at the declaration, not raised. This pass runs before any statement is
	# emitted, so the SAt markers have said nothing and the declaration's own place is the
	# only one there is — which the reject gate insists on, and rightly: a rule that cannot
	# say where is a rule the reader has to go and find.
	if c_name_in(em.gen_names, name) {
		check.chk_at_place(em, tpl.path, tpl.line, tpl.col, rule.Rule.DeclaredTwiceOneGeneric, f"`{name}` is declared twice, once as a generic — a template shares the one flat function namespace with every module of the program, so a second declaration of that name cannot be told apart from it")
		return
	}
	for other in f.fns {
		if other.name == name and other.recv == "" and not c_is_template(other) {
			check.chk_at_place(em, tpl.path, tpl.line, tpl.col, rule.Rule.GenericAndPlainFn, f"`{name}` is declared both as a generic and as a plain function — a template shares the one flat function namespace, so the two cannot be told apart; rename one")
			return
		}
	}
}

# c_without_templates is the funnel. A template is not a function, and the honest way to say
# that is to TAKE IT OUT of the program every later pass walks — `em.gen_tpls` is where it
# lives from here.
#
# It was three `tparams.len() == 0` guards instead, at the passes that had been noticed, and
# the ones that had not each reached cc with a type the programmer never wrote: the
# declaration-type sweep (now c_decl_types) declared `typedef struct { int32_t tag; zg_T ok; }`
# for an UNCALLED `fn wrap[T](x: T) -> T?`, and did the same for a `(T, T)`.
# Every future walk over `f.fns` would have been another slot; now there is nothing to miss.
fn c_without_templates(f: ast.File) -> ast.File {
	mut out := f
	mut keep: list[ast.FnDecl] = []
	for fn_i in f.fns {
		if not c_is_template(fn_i) {
			keep.append(fn_i)
		}
	}
	out.fns = keep
	return out
}

# c_is_template names the concept ONCE. It was `tparams.len() > 0` at four sites, which is
# four places to edit the day a template is something other than "has type parameters" —
# a generic method, when that lands, being exactly that day.
fn c_is_template(fn_d: ast.FnDecl) -> bool {
	return fn_d.tparams.len() > 0
}

# c_generic_row is the template's index, or -1. One lookup answers both questions asked of
# this table — whether a name IS a template and which one — the way c_sig_row and
# c_param_row do next door, so the two cannot drift apart or scan it twice.
#
# The names are kept in a list of their own beside the FnDecls rather than read off them:
# indexing a `list[FnDecl]` COPIES the declaration, body and all, and this is asked once per
# call expression in the program. It is the same reason c_sig_seen scans by hand.
fn c_generic_row(mut &em: Emitter, name: str) -> int {
	mut i := 0
	for i < em.gen_names.len() {
		return i if em.gen_names[i] == name
		i = i + 1
	}
	return 0 - 1
}

# c_is_generic is asked of EVERY call expression in the program, twice — once to lower it
# and once to type it. A program with no generics at all was paying a list copy and a scope
# mark for each: measured at 15ms of a 19ms regression on `make build`, recovered by asking
# the cheap question first.
fn c_is_generic(mut &em: Emitter, name: str) -> bool {
	return false if em.gen_names.len() == 0

	return c_generic_row(em, name) >= 0
}

# c_instantiate answers the SPECIALIZATION's name for one call, creating it the first time.
# The type arguments are solved from what the call actually passes, so `assert_eq(1, 1)`
# needs no `[int]` written; the specialization is then an ordinary function and the call to
# it is an ordinary call, checked against a signature with real types in it.
fn c_instantiate(mut &em: Emitter, name: str, args: list[ast.Expr]) -> str {
	tpl := em.gen_tpls[c_generic_row(em, name)]
	mut actuals: list[ast.Ty] = []
	for a in args {
		actuals.append(c_infer(em, a))
	}
	mut decls: list[ast.Ty] = []
	for pm in tpl.params {
		decls.append(pm.ty)
	}
	sol := generic.gen_solve(tpl.tparams, decls, actuals)
	return c_instantiate_at(em, name, sol)
}

# c_instantiate_at is the half of c_instantiate that happens once the type arguments are
# known, whoever worked them out. A call that WRITES them — `id[int](7)` — has said what it
# means and inference has nothing to add; a call that does not is solved from its arguments
# and arrives here with the same list. Splitting the two apart is what keeps the checks, the
# dedup and the budget in one place rather than one copy per way in.
fn c_instantiate_at(mut &em: Emitter, name: str, sol: list[ast.Ty]) -> str {
	tpl := em.gen_tpls[c_generic_row(em, name)]

	# ONE TYPE ARGUMENT PER PARAMETER. `gen_solve` always answers one per parameter, so while
	# inference was the only way in this was an invariant nothing had to state; a call that
	# WRITES its type arguments decides the length itself, and `pair[int](…)` on a
	# two-parameter template used to substitute the first and let the second reach C
	# untouched.
	#
	# IT WAS BRIEFLY AN ICE HERE, on the reasoning that the parser refuses a written type
	# argument list (E2035) so nothing could reach this. That is wrong, and the counterexample
	# is one line: `p_builtin_type_ctor` in parser.zg exempts `map`, `set`, `list`, `chan`,
	# `ptr` and `array`, because for those a `[ … ]` is the TYPE's own arguments rather than
	# a call's — and four of those six are not reserved words, so `fn set[T](…)` is a
	# declaration a program may make and `set[int, str](1)` reaches here with two. The
	# parser's exemption is about a spelling; this is about a template's arity, and one does
	# not stand in for the other.
	raise c_diag(em, rule.Rule.TypeParamCount, f"`{name}` has {strconv.to_string(tpl.tparams.len(), 10)} type parameters and this gives {strconv.to_string(sol.len(), 10)}") if sol.len() != tpl.tparams.len()

	# THE DEDUP SCAN COMES FIRST. A key already here was checked when it was made, and both
	# checks below walk `sol` — one of them into `c_impls`, a scan of every impl in the
	# program. Every call site reaches this twice, so re-checking was pure repeat work.
	key := generic.gen_mangle(name, sol)
	return key if c_name_in(em.inst_names, key)

	c_check_solved(em, tpl, sol)
	c_check_bounds(em, tpl, sol)
	c_check_inst_budget(em, name)
	inst := generic.subst_fn(tpl, sol, c_place(em))
	em.inst_names.append(key)
	em.inst_fns.append(inst)
	c_add_sig(em, inst)
	return key
}

# ZG_MAX_INSTANTIATIONS bounds monomorphization, and the bound is not a tuning knob: it is
# the only thing standing between the compiler and a program it cannot finish.
#
# POLYMORPHIC RECURSION is the shape that needs it — a template calling itself at a LARGER
# type, `fn deep[T](x: T, n: int) { deep([x], n - 1) }`, whose instantiations are `int`,
# `list[int]`, `list[list[int]]`, … forever. Whether it terminates depends on `n`, which is a
# runtime value, so no compiler can answer it by looking; every monomorphizing language stops
# at a depth instead. This one used to spin until it was killed, saying nothing.
const ZG_MAX_INSTANTIATIONS := 512

fn c_check_inst_budget(mut &em: Emitter, name: str) {
	raise c_diag(em, rule.Rule.GenericInstantiationDepth, f"`{name}` has been instantiated {strconv.to_string(ZG_MAX_INSTANTIATIONS, 10)} times and is still asking for more — a generic that calls itself at a LARGER type (`f([x])` inside `f[T]`) has no finite set of specializations, and monomorphization cannot end. Give the recursion a concrete type") if em.inst_names.len() >= ZG_MAX_INSTANTIATIONS
}

# c_check_solved refuses a call that leaves a type parameter unanswered. Guessing one would
# make the program compile as something nobody wrote, and the parameter is unanswered
# precisely because no argument mentions it — which is a call that has not said what it means.
fn c_check_solved(mut &em: Emitter, tpl: ast.FnDecl, sol: list[ast.Ty]) {
	mut i := 0
	for i < sol.len() {
		# The place is THE CALL's — the emission walk's own marker (SAt) — and not the
		# template's line: the template is fine, a second call to the same generic may well
		# decide every parameter. The sentence says "this call", and without a place there was
		# no way to tell which one.
		raise c_diag(em, rule.Rule.TypeParamUndecided, f"the type parameter `{tpl.tparams[i]}` of `{tpl.name}` is not decided by this call — no argument's type mentions it, so there is nothing to solve it from") if c_is_unknown(sol[i])
		i = i + 1
	}
}

# c_check_bounds is `[T: Eq]` — the specialization's type argument must implement the spec
# the parameter is bounded by. It is checked HERE, at the instantiation, because that is
# where a concrete type first exists to check; inside the template `T` implements whatever
# the bound says and nothing more.
fn c_check_bounds(mut &em: Emitter, tpl: ast.FnDecl, sol: list[ast.Ty]) {
	mut i := 0
	for i < sol.len() and i < tpl.tbounds.len() {
		# A bound is a CONJUNCTION, carried joined by `+`: every spec in it has to be met,
		# and the one that is not is the one named. Reporting the whole bound instead would
		# make a reader check each in turn to find which.
		# It RAISES rather than reporting through chk_at, and that is deliberate: a failed
		# bound means the specialization must not be built, and a collected finding would let
		# the walk carry on into a body whose type does not meet the promise it was written
		# against — which reports the consequence first and buries the cause.
		for b in c_split_bounds(tpl.tbounds[i]) {
			raise c_diag(em, rule.Rule.TypeParamBoundUnmet, f"`{ast.ty_name(sol[i])}` does not implement `{b}`, which `{tpl.name}`'s type parameter `{tpl.tparams[i]}` is bounded by") if not c_satisfies(em, sol[i], b)
		}
		i = i + 1
	}
}

# c_split_bounds takes `Eq+Hash` back apart. An empty bound answers nothing to check, which
# is why the loop above needs no `!= ""` of its own.
pub fn c_split_bounds(bound: str) -> list[str] {
	mut out: list[str] = []
	return out if bound == ""

	mut cur: list[byte] = []
	for ch in bytearray(bound) {
		if ch == b'+' {
			out.append(str(cur))
			cur = []
		} else {
			cur.append(ch)
		}
	}
	out.append(str(cur))
	return out
}

# c_satisfies is whether a type meets a bound. A BUILT-IN type meets `Eq` inherently — `==`
# on two ints is the operator and not an impl — and a declared one meets it by having the
# impl, which is the same list `==` on an aggregate reads.
fn c_satisfies(mut &em: Emitter, t: ast.Ty, bound: str) -> bool {
	return c_eq_legal(em, t) if bound == "Eq"

	return c_impls(em, c_named_of(t), bound)
}

fn c_build_sigs(mut &em: Emitter, f: ast.File) {
	for fn_i in f.fns {
		key := c_sig_key(fn_i.recv, fn_i.name)

		# A NAME DECLARED TWICE, and the two halves of that are different rules.
		#
		# On a TYPE it is the language's: "Every method and associated fn on a type shares
		# one namespace, spec or inherent alike; a duplicate is an error" (GRAMMAR#impl-decl) —
		# which is also how a second `impl Spec for T` arrives, since a type has one
		# canonical implementation of a spec (docs/core/specs.md). It used to be reported as
		# two modules colliding, about one module and one type.
		#
		# For a FREE function it is this compiler's: every module flattens into one scope
		# here, so two modules declaring one name mangle to the same C symbol. That used to
		# be reported by the LINKER — `duplicate symbol '_zg_name'`, no file, no line — one
		# reporter further away than cc.
		if c_sig_seen(em, key) {
			raise c_diag_at(fn_i.path, fn_i.line, fn_i.col, rule.Rule.MethodDeclaredTwice, f"`{fn_i.recv}` declares `{fn_i.name}` twice — every method on a type shares one namespace, spec or inherent alike, and a type has one canonical implementation of a spec") if fn_i.recv != ""

			# TWO MODULES, ONE NAME. A PRIVATE one is answerable: nothing outside its module
			# can reach it (chk_visible), so a bare call always means the one in the caller's
			# own module, and the two only have to be told apart in C. That is what
			# c_mod_tag does, by the module's position in a SORTED list — a counter would
			# depend on the order files were read, and `fixpoint` compares emitted C byte for
			# byte.
			#
			# A PUBLIC collision is not answerable here and is still refused. The export
			# surface has no package to be unique within (docs/runtime/package.md declines a
			# global registry on purpose), so the answer is a compile error plus a link-name
			# override — which is what docs/runtime/ffi.md already specifies, and which needs the
			# package layer to exist first.
			c_mod_collide(em, fn_i, c_first_with_key(f, key, fn_i))
		}
		c_add_sig(em, fn_i)
	}
}

# c_first_with_key is the EARLIER declaration a key was already taken by — the half of a
# collision no place line can carry, since the marker points at the second one.
#
# IT READS THE DECLARATION AND NOT A COLUMN, which is what lets c_mod_collide answer all three
# of its questions — which file, which line, and whether it was `pub` — from ONE source. The
# signature tables carry a module and a `pub` flag per row, and reading half the answer from
# there and half from here would be two sources that only have to agree until they do not.
#
# The scan is on the path that has already found a duplicate, and c_sig_seen — a scan of the
# same table, run for every function — is what told it so, so this costs nothing that walk did
# not already cost.
#
# `fallback` is the answer of last resort and is unreachable from the only caller: c_sig_seen
# has just said the key IS taken, and every row of that table below c_add_sig's other caller
# comes from this same list. A function that ends without answering is E3032 here, so the case
# has to be written; giving it the CURRENT declaration is what keeps a wrong answer from
# pointing at somebody else's function.
fn c_first_with_key(f: ast.File, key: str, fallback: ast.FnDecl) -> ast.FnDecl {
	for d in f.fns {
		return d if c_sig_key(d.recv, d.name) == key
	}
	return fallback
}

# c_mod_collide answers a name declared twice at the top level, and there are three shapes of
# that. `prev` is the earlier declaration; the rules below are told apart by where it was
# WRITTEN, because that is the only thing that separates them:
#
#   one FILE declaring it twice        permanently ill-formed, whatever this compiler grows
#   two files of one directory         one flat namespace, so no tag can separate them
#   two directories, one `pub`         no package for a public name to be unique within
#   two directories, both private      answerable, and recorded here for a module tag
#
# THE FIRST IS NOT THE SECOND, and reporting it as one sent a reader looking for a module that
# is not there: two `#[test]` functions of one name in one `*_test.zg` were refused with "two
# modules both define `test_same`". It gets a rule of its own rather than a second wording of
# E9082, because the two have different LIFETIMES — E9082 is a `NotImplemented` that the package
# layer retires, and a name declared twice in one file is refused by every compiler there will
# ever be.
fn c_mod_collide(mut &em: Emitter, fn_i: ast.FnDecl, prev: ast.FnDecl) {
	# ONE FILE IS NOT THIS WALK'S TO ANSWER. c_build_top_names RECORDS it as E4073, and a
	# record is rendered at the end of the run while every rule here RAISES — so answering it
	# here as well would not be a second wording, it would be the only one the reader ever
	# sees, and it would be the wrong one.
	return if prev.path == fn_i.path

	raise c_diag_at(fn_i.path, fn_i.line, fn_i.col, rule.Rule.NotYetTwoModulesDefine, f"NotImplemented: two modules both define `{fn_i.name}` and at least one is `pub` — a public name has no package to be unique within (docs/runtime/package.md), so telling the two apart needs the link-name override docs/runtime/ffi.md specifies") if fn_i.is_pub or prev.is_pub
	raise c_mod_flat_collide(fn_i.path, fn_i.line, fn_i.col, fn_i.name, prev.path) if check.c_mod_of(em, fn_i.path) == check.c_mod_of(em, prev.path)

	if not c_name_in(em.mod_tagged, fn_i.name) {
		em.mod_tagged.append(fn_i.name)
	}
}

# c_add_sig records one function's signature and its parameter rows. It is a function of its
# own because a SPECIALIZATION arrives after this pass has run — it is created by the call
# that asks for it — and has to reach the same tables by the same route, or the argument
# rules would read a row that is not there.
fn c_add_sig(mut &em: Emitter, fn_i: ast.FnDecl) {
	key := c_sig_key(fn_i.recv, fn_i.name)
	em.sig_names.append(key)
	em.sig_mod.append(check.c_mod_of(em, fn_i.path))
	em.sig_pub.append(fn_i.is_pub)
	em.sig_path.append(fn_i.path)
	em.sig_unsafe.append(fn_i.in_unsafe)
	em.sig_rets.append(fn_i.ret)
	em.sig_hasret.append(fn_i.has_ret)
	em.sig_nparams.append(fn_i.params.len())
	em.sig_nreq.append(c_required_params(fn_i))
	mut j := 0
	for j < fn_i.params.len() {
		em.pr_fn.append(key)
		em.pr_idx.append(j)
		em.pr_ref.append(fn_i.params[j].is_ref)
		em.pr_ty.append(fn_i.params[j].ty)
		em.pr_hasdef.append(fn_i.params[j].has_def)
		em.pr_def.append(fn_i.params[j].def)
		j = j + 1
	}
}

# c_param_row finds a parameter's row in the tables c_build_sigs filled, or -1 when the
# function has no such parameter. Everything asked ABOUT a parameter — is it a reference,
# what is its type, does it have a default, what is that default — reads its row, so the
# search happens once per question rather than once per field, and the answers cannot
# drift apart.
#
# c_build_sigs appends a function's parameters CONTIGUOUSLY in index order, so the row a
# function's parameter 0 sits at fixes every other one; the scan below stops as soon as it
# is past that block, which is what keeps a fully-applied call — nearly every call — from
# walking the whole program's parameters to learn it has no default to backfill.
# c_required_params is how many arguments a call to this function must give: every
# parameter up to the first one with a default, since a default may only follow defaults.
fn c_required_params(fn_d: ast.FnDecl) -> int {
	mut n := 0
	for pm in fn_d.params {
		return n if pm.has_def
		n = n + 1
	}
	return n
}

# c_sig_row is a signature's index in the sig_* columns, or -1 when nothing registered it.
pub fn c_sig_row(mut &em: Emitter, key: str) -> int {
	# THE READER'S OWN MODULE FIRST, where two of them declare the name. A private name two
	# modules both have is two rows, and the first is whichever file was read first — so
	# every rule that reads a row by name alone would answer about the other module's
	# function: its visibility, its arity, its parameter types.
	here := check.c_mod_of(em, em.at_path)
	if here != "" {
		mut j := 0
		for j < em.sig_names.len() {
			return j if em.sig_names[j] == key and em.sig_mod[j] == here
			j = j + 1
		}
	}

	mut i := 0
	for i < em.sig_names.len() {
		return i if em.sig_names[i] == key
		i = i + 1
	}
	return -1
}

pub fn c_param_row(mut &em: Emitter, fname: str, idx: int) -> int {
	mut i := 0
	mut seen := false
	for i < em.pr_fn.len() {
		if em.pr_fn[i] == fname {
			return i if em.pr_idx[i] == idx
			seen = true
		} else if seen {
			# past the function's own block: it has no parameter idx
			return -1
		}
		i = i + 1
	}
	return -1
}

fn c_is_ref_name(mut &em: Emitter, name: str) -> bool {
	mut i := 0
	for i < em.ref_names.len() {
		return true if em.ref_names[i] == name
		i = i + 1
	}
	return false
}

fn c_lookup_sig_ret(mut &em: Emitter, name: str) -> ast.Ty {
	mut i := 0
	for i < em.sig_names.len() {
		if em.sig_names[i] == name {
			return em.sig_rets[i] if em.sig_hasret[i]
			return ast.Ty.TVoid
		}
		i = i + 1
	}
	return ast.Ty.TUnknown
}

# c_has_method reports whether type `recv` declares a method `meth`, and c_is_free_fn
# whether a bare name is a free function — a method is excluded from the second, since it
# is keyed by its type and has no bare name to be reached by.
#
# Both ask about EXISTENCE, which the signature table answers with TUnknown: a declared
# function that returns nothing is TVoid, and no declared return type is ever TUnknown, so
# the two cannot be confused. Deriving them from the one lookup rather than scanning the
# table again is what keeps them from drifting away from it.
fn c_has_method(mut &em: Emitter, recv: str, meth: str) -> bool {
	return false if recv == ""
	return not c_is_unknown(c_lookup_sig_ret(em, c_sig_key(recv, meth)))
}

fn c_is_free_fn(mut &em: Emitter, n: str) -> bool {
	return not c_is_unknown(c_lookup_sig_ret(em, n))
}

# c_builtin_check raises for a documented built-in this compiler has not built, and returns
# for every other name so the caller reports whatever it was going to.
#
# The built-in set is CLOSED (docs/runtime/builtins.md) — a user cannot add to it — so a
# program naming one of these has not made a typo, and answering "undefined name `sizeof`"
# tells a reader the language does not have it when the documentation says it does. Every
# one of them is built by the SEED, which is what makes the wording matter: the form exists,
# this compiler is the one that is behind.
#
# Every report site funnels through here, so the answer does not depend on whether the name
# was reached as a call, as a constructor, as a bare value or as a binding's annotation.
#
# This is one THIRD of that closed set. The conversions and the str/list bridges are decided
# by `is_conv`/`conv_ty` in parser.zg, and the error constructors by `c_err_kinds` here — so
# nothing can yet assert that every row of builtins.md is either built or named. Whoever
# unifies the three should start from those two names.
# THE PLACE IS THE FUNNEL'S, which is the whole reason it is one function. Every name below
# is refused from six call sites in four positions — a call, a constructor, a bare value, a
# type annotation and a return type — and none of them carried a `--> file:line:col`, so a
# reader was told `ptr` is not built and left to find which of their signatures said it. The
# trailer is appended once by the channel (c_diag) rather than at each raise, for the reason
# the sentences are written once here: a seventh caller inherits it instead of forgetting it.
pub fn c_builtin_check(mut &em: Emitter, n: str) {
	c_fixed_width_check(em, n)

	raise c_diag(em, rule.Rule.NotYetRefBox, "NotImplemented: a refcounted box `Ref(x)` / `deref(r)` — this compiler has no `Ref[T]` type") if n == "Ref" or n == "deref"
	raise c_diag(em, rule.Rule.NotYetRawPointerBuiltin, f"NotImplemented: the raw-pointer built-in `{n}` — bare-metal memory access, which is `unsafe`-only and not built here") if n == "addr" or n == "ptr"
	raise c_diag(em, rule.Rule.NotYetCompileTimeBuiltin, f"NotImplemented: the compile-time built-in `{n}[T]` — this compiler does not compute a type's layout") if n == "sizeof" or n == "alignof"

	# `set([1, 2])` read as "undefined function `set`", the message a misspelled call gets.
	# Why a set is spelled as a CONSTRUCTOR and not as a brace literal is GRAMMAR#map-lit's
	# note: `{1}` cannot be told from a one-statement block.
	raise c_diag(em, rule.Rule.NotYetSetBuiltin, "NotImplemented: the built-in `set` — a set is built through its constructor (`set([1, 2])`, `set()` for the empty one) because `{1}` cannot be told from a block, and this compiler has `list[T]` and `map[K, V]` only") if n == "set"
}

# c_fixed_width_check names the fixed-width ladder rather than letting it read as a typo.
#
# `i8` … `i64`, `u8` … `u64`, `f32` and `f64` are types the specification has and this compiler
# does not (docs/core/types.md). Because a width is an ordinary IDENTIFIER rather than a
# keyword, `i32(x)` reported "undefined function `i32`" — the message any misspelled call gets —
# so a reader was told the name is unknown and would go looking for their own typo. A `[not
# yet]` is a legitimate state; an unnamed refusal is not (docs/conformance.md).
#
# THE TEN NAMES ARE WRITTEN OUT, because being exact about which they are is the whole rule:
# `i7` and `u128` are not the ladder and must stay ordinary unknown names, since a message
# about a ladder that would not contain them either is worse than none. Spelled instead as
# the shape they have — a class letter, then a width the language names — that exactness was
# something a reader had to derive from three tests and a substring, and the list it stood in
# for is ten entries long.
fn c_fixed_width_check(mut &em: Emitter, n: str) {
	ladder := ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64"]
	return if not c_name_in(ladder, n)

	raise c_diag(em, rule.Rule.NotYetFixedWidthLadder, f"NotImplemented: `{n}` is part of the fixed-width ladder — `i8`…`i64`, `u8`…`u64`, `f32` and `f64` are specified as stdlib types and none is declared yet; the built-in widths are `int`, `uint`, `byte`, `rune` and `float`")
}

# c_type_decls writes every type declaration a unit needs, IN DEPENDENCY ORDER: the enums,
# the structs, and the carriers over them. C needs the complete type of everything a
# declaration holds BY VALUE ahead of it, and all three kinds hold each other — a struct
# field may be an enum, an enum's payload may be a struct, and a carrier holds whichever it
# wraps. Three fixed passes could only ever be right by luck, and were not: enums went first
# on the assumption that "a struct is never held by an enum", which `enum E { Wrap(Later) }`
# is not. Each sweep here emits whatever has all of its dependencies already out.
#
# A group that can never be emitted is a CYCLE — `struct A { b: B }` with `struct B { a: A }`
# — a type of infinite size rather than an ordering problem, and it is named as such.
fn c_type_decls(mut &em: Emitter, f: ast.File, carriers: list[ast.Ty], tuples: list[ast.Ty]) -> str {
	mut out := ""

	# EVERY name this pass will emit, collected ONCE. It is what "does this dependency have
	# to wait?" is asked against, and the answer cannot change while the sweep runs — so
	# deriving it per dependency was waste, and expensive waste: the lists it came from were
	# reached through a by-value `File`, which is the whole program's AST. That copy, taken
	# twice per dependency per sweep, was a fifth of every compile.
	mut all: list[str] = []
	for ed in f.enums {
		all.append(ed.name)
	}
	for sd in f.structs {
		all.append(sd.name)
	}
	for c in carriers {
		all.append(c_carrier_ty_cname(c))
	}
	for t in tuples {
		all.append(c_tuple_cname(ast.ty_tuple_elems(t)))
	}

	mut done: list[str] = []

	# THE TYPEDEFS COME FIRST, and they are a real C `typedef`: `type Celsius = int` is
	# `typedef int64_t zg_Celsius;`, which is exactly what the language says it is — a new
	# name over the same representation, costing nothing at runtime. Emitting one is also
	# what keeps c_type unchanged: a typedef is a TNamed like any other, so the fifty-odd
	# places that render a type do not have to learn about it.
	#
	# They precede the structs because a struct field may be declared with one, and they need
	# no dependency sweep of their own: a typedef over a typedef is refused at declaration.
	for td in f.types {
		out = out + f"typedef {c_type(td.under)} zg_{td.name};\n"
		done.append(td.name)
	}
	if f.types.len() > 0 {
		out = out + "\n"
	}

	mut es := f.enums
	mut ss := f.structs
	mut cs := carriers
	mut ts := tuples

	for es.len() > 0 or ss.len() > 0 or cs.len() > 0 or ts.len() > 0 {
		# `done` is the only thing a sweep moves, so its length before and after IS whether
		# progress was made — and a sweep that emits nothing never will
		n0 := done.len()

		mut es2: list[ast.EnumDecl] = []
		for ed in es {
			if c_deps_done(c_enum_deps(ed), done, all) {
				out = out + c_enum_typedef(ed)

				# the copy and drop PROTOTYPES, here and not with their bodies, for the
				# reason the struct arm below gives and for one more of its own: the ref-box
				# helpers are emitted before the bodies are, and `zg_refnew_<E>` now hands
				# the cell a drop that runs `zg_drop_<E>`. A prototype needs only the typedef
				# just written, which keeps that order from deciding whether the C compiles —
				# and an enum whose payload is another enum is the same problem one level in.
				if c_needs_copy(em, ast.Ty.TNamed(ed.name)) {
					out = out + f"static zg_{ed.name} zg_copy_{ed.name}(zg_{ed.name} v);\n"
					out = out + f"static void zg_drop_{ed.name}(zg_{ed.name} *v);\n"
				}
				done.append(ed.name)
			} else {
				es2.append(ed)
			}
		}
		es = es2

		mut ss2: list[ast.StructDecl] = []
		for sd in ss {
			if c_deps_done(c_struct_deps(sd), done, all) {
				out = out + c_struct_typedef(sd)

				# the copy helper's PROTOTYPE, here rather than with its body: this sweep
				# emits carriers and structs in dependency order, so a carrier's force
				# helper — which copies the value it unwraps — can be emitted before the
				# struct's helper is. A prototype needs only the typedef just written, and
				# it is what keeps that order from deciding whether the C compiles.
				if c_needs_copy(em, ast.Ty.TNamed(sd.name)) {
					out = out + f"static zg_{sd.name} zg_copy_{sd.name}(zg_{sd.name} v);\n"
					out = out + f"static void zg_drop_{sd.name}(zg_{sd.name} *v);\n"
				}
				done.append(sd.name)
			} else {
				ss2.append(sd)
			}
		}
		ss = ss2

		mut cs2: list[ast.Ty] = []
		for c in cs {
			cn := c_carrier_ty_cname(c)
			if c_deps_done(c_carrier_deps(c), done, all) {
				# through the emit gate, not c_carrier_decl directly: a carrier already
				# written inline by a tuple that spells it answers "" here instead of a
				# second `zg_force_…` definition
				out = out + c_carrier_emit(em, c)
				done.append(cn)
			} else {
				cs2.append(c)
			}
		}
		cs = cs2

		# the same arm again for TUPLES. A tuple is a typedef like a carrier is, it names
		# the declared types its elements hold, and a struct field of tuple type depends on
		# it — so it belongs in the sweep rather than in a block emitted before or after it,
		# which is where it was and why `pair: (Q, int)` had to be turned away.
		mut ts2: list[ast.Ty] = []
		for t in ts {
			elems := ast.ty_tuple_elems(t)
			tn := c_tuple_cname(elems)
			if c_deps_done(c_ty_list_deps(elems), done, all) {
				out = out + c_tuple_decl(em, elems)
				done.append(tn)
			} else {
				ts2.append(t)
			}
		}
		ts = ts2

		# IT SAYS WHICH TYPE AND NOT WHERE, and that is a gap this compiler owes once rather
		# than here: a StructDecl and an EnumDecl carry no position at all, so there is nothing
		# to point at — and unlike every rule about a statement, a cycle is a property of the
		# declarations and of nothing that runs, so no marker has been set either. The NAME is
		# what a reader searches for, which is why the sentence leads with it.
		raise c_diag(em, rule.Rule.ByValueCycle, f"`{c_stuck_name(es, ss, cs)}` is part of a cycle of by-value declarations — a type holding itself, however indirectly, has no size; hold it behind a `list`, or box it as a self-recursive enum payload") if done.len() == n0
	}
	return out
}

# c_deps_done reports whether every DECLARED type a declaration names by value is already
# out. A name this program does not declare — a scalar, a runtime container — needs nothing
# ahead of it.
#
# A SELF REFERENCE IS A DEPENDENCY LIKE ANY OTHER HERE, and it used to be skipped for every
# kind of declaration. That skip is an ENUM's — c_enum_deps makes it now, where the reason for
# it is — and it was wrong for a STRUCT: a field of its own type has no size, and skipping the
# self-dependency let such a struct declare itself satisfied. The sweep then never reported the
# cycle, C was handed a struct containing itself, and before cc could say so the copy helper
# walked the field, asked about the same struct, and recursed until the stack ran out. The
# compiler died of signal 11 on a three-line program.
#
# The indirect cycles were caught all along — `A` holding `B` holding `A`, and `p: P?` through
# the carrier — because neither dep IS the declaration's own name. One skip made the simplest
# case the only invisible one. A field holding the type behind a `list` contributes no dep at
# all and is unaffected: that, and the boxed enum payload, are the two ways to write a
# recursive shape.
fn c_deps_done(deps: list[str], mut &done: list[str], mut &all: list[str]) -> bool {
	for dep in deps {
		if c_name_in(all, dep) {
			return false if not c_name_in(done, dep)
		}
	}
	return true
}

fn c_struct_deps(sd: ast.StructDecl) -> list[str] {
	mut deps: list[str] = []
	for fd in sd.fields {
		c_ty_struct_deps(fd.ty, deps)
	}
	return deps
}

# c_enum_deps leaves the enum's OWN name out, and that omission IS THE DIFFERENCE BETWEEN A
# POINTER AND A FIELD: a self-recursive payload is auto-boxed, so what the variant holds is a
# pointer and its size is known — the compiler's own `Ty` is one. Nothing has to be emitted
# ahead of a pointer, so it is not a dependency, and saying so here is what keeps the sweep
# itself free of exceptions.
fn c_enum_deps(ed: ast.EnumDecl) -> list[str] {
	mut deps: list[str] = []
	for v in ed.variants {
		for t in v.fields {
			c_ty_struct_deps(t, deps)
		}
	}

	mut out: list[str] = []
	for dep in deps {
		if dep != ed.name {
			out.append(dep)
		}
	}
	return out
}

fn c_carrier_deps(c: ast.Ty) -> list[str] {
	mut deps: list[str] = []
	if ast.ty_is_opt(c) {
		c_ty_struct_deps(c_opt_elem(c), deps)
	} else {
		c_ty_struct_deps(c_either_left(c), deps)
		c_ty_struct_deps(c_either_right(c), deps)
	}
	return deps
}

# c_ty_struct_deps collects the declared type names a type needs COMPLETE where it is used
# by value. A carrier holds its payload by value, so `Y?` and `Result[Y]` need Y as surely
# as a bare `Y` does — which is why the ordering could not be read off a field's own name.
# A `list[Y]` needs nothing: the runtime container holds its elements behind a pointer.
fn c_ty_struct_deps(t: ast.Ty, mut &out: list[str]) {
	match t {
		Ty.TNamed(nm) => out.append(nm)
		Ty.TOpt(el) => out.append(c_carrier_ty_cname(ast.Ty.TOpt(el)))
		Ty.TEither(l, r) => out.append(c_carrier_ty_cname(ast.Ty.TEither(l, r)))
		Ty.TTuple(ts) => out.append(c_tuple_cname(ts))
		_ => c_skip()
	}
}

# c_ty_list_deps is the declared types a list of types names, which is what a tuple's
# elements are.
fn c_ty_list_deps(ts: list[ast.Ty]) -> list[str] {
	mut out: list[str] = []
	c_ty_struct_deps_list(ts, out)
	return out
}

fn c_ty_struct_deps_list(ts: list[ast.Ty], mut &out: list[str]) {
	for t in ts {
		c_ty_struct_deps(t, out)
	}
}

# c_stuck_name names one member of the group that could not be emitted, for the diagnostic.
fn c_stuck_name(es: list[ast.EnumDecl], ss: list[ast.StructDecl], cs: list[ast.Ty]) -> str {
	for ed in es {
		return ed.name
	}
	for sd in ss {
		return sd.name
	}
	for c in cs {
		return c_carrier_ty_cname(c)
	}
	return "?"
}

# Site is ONE place a DECLARATION spells a type: a struct field, an enum variant's payload,
# a parameter, a result. It carries the type itself plus everything any reader of that fact
# has ever needed — the place string a refusal quotes, the type parameters bound where it
# was written, and the position, empty for the forms that carry none.
#
# A module constant is NOT a site here: its global is rendered after the on-demand typedef
# sections, so c_const_globals registers what it spells at the moment it spells it.
#
# The list exists because three passes asked this one question and each answered it with a
# walk of its own over f.structs, f.enums and f.fns — c_decl_types for the typedefs a site
# needs written first, c_check_named_types for a name that resolves to nothing, and
# c_scan_fnptr for whether `zg_fnptr` is spelled anywhere. Three enumerations of one list is
# three chances to be short an entry, and every one of them has been: the enum-payload site
# was missing from the tuple sweep, then from the carrier sweep, then from c_scan_fnptr —
# where an enum holding a function and never constructed emitted `zg_fnptr` with no typedef
# and left cc to report it against generated C nobody wrote.
#
# In a language with no closures, a materialized list IS the visitor. c_decl_sites answers
# once and each consumer reads the fields it needs, so a site added here is added for all
# three and cannot be owed to any of them by hand.
pub struct Site {
	pub ty: ast.Ty
	pub place: str
	pub tparams: list[str]
	pub path: str
	pub line: int
	pub col: int

	# decl_pub is whether the DECLARATION spelling this type is itself exported, which is the
	# other half of the normative sentence "a declaration can never be more visible than the
	# types it names" (docs/runtime/package.md). It belongs on the site rather than being
	# recomputed by the rule because only the site knows which declaration it came off: a
	# struct field is exported when BOTH the struct and the field are `pub`, and a result is
	# exported when its function is.
	pub decl_pub: bool
}

# c_decl_sites is that list, in DECLARATION ORDER — structs, then enums, then functions,
# and a function's result before its parameters. The order is load-bearing for two of the
# three readers: typedefs are emitted in the order they are collected, and the first
# unresolvable name is the one reported.
fn c_decl_sites(f: ast.File) -> list[Site] {
	# a struct field and an enum payload are written where no type parameter is in scope —
	# one empty list, spelled once
	mut free: list[str] = []
	mut out: list[Site] = []

	# THE FIELD'S OWN LINE, not the struct's. Both of these passed `"", 0, 0` because neither
	# declaration recorded a position when the list was written, and the reader below leaves
	# `em.at_*` alone for a site with no path — so a field naming a type nothing declares was
	# reported at whatever the previous unit had last emitted, and at the top of a file that
	# is nothing at all: `E4056 no type named `Zork` (field `A.v`)` over `--> 0:0`. A FieldDef
	# and a VariantDef each carry a line and a column of their own, and the file is the
	# declaration's. A visibility rule cannot work without the path at all: the module it
	# compares against IS the directory that path names.
	for sd in f.structs {
		for fd in sd.fields {
			# A field exports its type only when the struct AND the field are both `pub`: a
			# private field of a public struct is not on anyone's surface.
			out.append(Site(fd.ty, f"field `{sd.name}.{fd.name}`", free, sd.path, fd.line, fd.col, sd.is_pub and fd.is_pub))
		}
	}
	for ed in f.enums {
		for v in ed.variants {
			mut i := 0
			for i < v.fields.len() {
				# a variant carries no `pub` of its own (GRAMMAR#variant) — the enum's marker
				# is the whole of its visibility, and a payload travels with the variant
				out.append(Site(v.fields[i], f"payload {strconv.to_string(i, 10)} of `{ed.name}.{v.name}`", free, ed.path, v.line, v.col, ed.is_pub))
				i = i + 1
			}
		}
	}
	for fn_i in f.fns {
		# A TEMPLATE'S TYPE PARAMETERS ARE BOUND, and everything else in its signature is
		# not: `fn f[T](x: T, y: Nope)` owes the same answer about `Nope` that a plain
		# function does. So the bound names travel with the site rather than the template
		# being skipped, which would have left an unknown type in a generic's signature to
		# reach cc under whatever name a specialization gave it.
		out.append(Site(fn_i.ret, f"the result of `{fn_i.name}`", fn_i.tparams, fn_i.path, fn_i.line, fn_i.col, fn_i.is_pub))
		for pm in fn_i.params {
			out.append(Site(pm.ty, c_param_says(fn_i, pm), fn_i.tparams, fn_i.path, fn_i.line, fn_i.col, fn_i.is_pub))
		}
	}
	return out
}

# c_param_says names a parameter in a sentence, and the RECEIVER is the one it must not name
# as a parameter. A method's `this` is synthesized — the author wrote `pub fn shout()` and no
# parameter at all — so "parameter `this` of `shout`" points at a word that is not in the
# file, and this same compiler refuses `this` as a parameter name elsewhere (E2013), which
# makes the sentence advice the language would reject.
#
# The receiver is the parameter NAMED `this` on a declaration that has a receiver, which is
# what c_build_sigs synthesizes; a free function has none and every parameter of it is one.
fn c_param_says(fn_i: ast.FnDecl, pm: ast.Param) -> str {
	return f"the receiver of `{fn_i.name}`" if fn_i.recv != "" and pm.name == "this"

	return f"parameter `{pm.name}` of `{fn_i.name}`"
}

# c_decl_types collects every TUPLE and every CARRIER a declaration spells, in ONE walk.
# Those typedefs have to exist before the struct and enum typedefs that name them, and one
# registered while a body is emitted lands after them: a struct holding a `Q?` reached cc
# as `unknown type name 'zg_opt_zg_Q'`.
#
# It gathers optionals AND eithers, which is what a `-> Result[nil]` in the stdlib needs:
# the type is spelled in one module's prototype and the carrier registered in another, so a
# caller compiled on its own had the name and not the typedef.
#
# ONE walk, on purpose. This was two collectors — tuples and carriers — each enumerating
# the declaration sites for itself, and each missed the same site the other did: an enum
# variant's payload was left out of the tuple sweep and then, the same week, out of the
# carrier sweep — `A((int, int))` and `A(int?)` both reached cc as an unknown type name.
fn c_decl_types(sites: list[Site], mut &tups: list[ast.Ty], mut &cars: list[ast.Ty]) {
	for s in sites {
		c_decl_collect(s.ty, tups, cars)
	}
}

# c_decl_collect walks a type to the tuples and carriers inside it, innermost first, so a
# shape holding another is listed after the one it holds. A container is transparent:
# `list[T?]` needs the same carrier a bare `T?` does, and a tuple's elements are collected
# too — `(int?, int)` spells the optional's carrier inside its own typedef, which is how a
# tuple-only walk let it reach cc.
#
# A FUNCTION TYPE is opaque, which is where this walk and c_check_named_ty's part company
# on purpose rather than by drift: every function type is one C type, `zg_fnptr`, so
# nothing a `fn(int?) -> …` mentions is ever spelled in the C and nothing inside it needs a
# typedef. c_check_named_ty descends into it because an unresolvable NAME in there is still
# a name the reader wrote and is owed an answer about.
fn c_decl_collect(t: ast.Ty, mut &tups: list[ast.Ty], mut &cars: list[ast.Ty]) {
	match t {
		Ty.TTuple(ts) => c_decl_collect_tuple(ts, tups, cars)
		Ty.TOpt(el) => c_decl_collect_carrier(ast.Ty.TOpt(el), tups, cars)
		Ty.TEither(l, r) => c_decl_collect_carrier(ast.Ty.TEither(l, r), tups, cars)
		Ty.TList(el) => c_decl_collect(el, tups, cars)
		Ty.TChan(el, _) => c_decl_collect(el, tups, cars)
		Ty.TMap(k, v) => c_decl_collect_two(k, v, tups, cars)
		_ => c_skip()
	}
}

fn c_decl_collect_two(a: ast.Ty, b: ast.Ty, mut &tups: list[ast.Ty], mut &cars: list[ast.Ty]) {
	c_decl_collect(a, tups, cars)
	c_decl_collect(b, tups, cars)
}

fn c_decl_collect_tuple(ts: list[ast.Ty], mut &tups: list[ast.Ty], mut &cars: list[ast.Ty]) {
	for t in ts {
		c_decl_collect(t, tups, cars)
	}
	name := c_tuple_cname(ts)
	for t in tups {
		return if c_tuple_cname(ast.ty_tuple_elems(t)) == name
	}
	tups.append(ast.Ty.TTuple(ts))
}

# c_decl_collect_carrier adds a carrier once per SHAPE, then descends into its payloads — a
# `Result[T?]` needs the optional's carrier written before its own.
fn c_decl_collect_carrier(c: ast.Ty, mut &tups: list[ast.Ty], mut &cars: list[ast.Ty]) {
	nm := c_carrier_ty_cname(c)
	for x in cars {
		return if c_carrier_ty_cname(x) == nm
	}
	if ast.ty_is_opt(c) {
		c_decl_collect(c_opt_elem(c), tups, cars)
	} else {
		c_decl_collect_two(c_either_left(c), c_either_right(c), tups, cars)
	}
	cars.append(c)
}

# c_check_named_types refuses a DECLARATION that names a type nothing declares. Every
# other named type resolves to a C typedef this unit writes; one that resolves to nothing
# was still spelled `zg_<Name>` and handed to cc, which rejected it against a line of
# generated C under .zerg-cache — the same "loudly, but a long way from the source" the
# error-constructor case above already names. `Ref[T]` is the one that matters today: the
# self-hosted compiler has no Ref, so `std/atomic` reached cc as `zg_Ref` rather than being
# turned away here.
#
# It runs over DECLARATIONS only — c_decl_sites's list, which is what "a declaration spells
# a type" means for this compiler — because those are written out before any body is, so
# this is the earliest point where the whole program's type names are known and nothing has
# been emitted yet. A VARIANT'S PAYLOAD is on that list, and it was once the site this pass
# did not walk: `Leaf(int, 1)` declared a payload of type `1`, and the emitter wrote `zg_1`
# into a union member for cc to complain about.
fn c_check_named_types(mut &em: Emitter, f: ast.File, sites: list[Site]) {
	# an `impl` on a PRIMITIVE arrives as a synthesized `this` of that type, and that is
	# knowable here and nowhere below: `c_check_type_name` sees a name and a site string, so
	# it had to claim "an `impl` on the built-in type" for any site and then print the site
	# it was given — `… `int` (parameter `this` of `tag`)`. It is a question about the
	# DECLARATION rather than about a type it spells, which is why it is not a site.
	for fn_i in f.fns {
		raise c_diag_at(fn_i.path, fn_i.line, fn_i.col, rule.Rule.NotYetImplOnBuiltin, f"NotImplemented: an `impl` on the built-in type `{fn_i.recv}` — this compiler gives a method a declared struct or enum receiver") if fn_i.recv != "" and parser.is_conv(fn_i.recv)
	}

	for s in sites {
		# the declaration's own place. This pass runs before any statement is emitted, so the
		# SAt markers have said nothing and `em.at_*` still holds the last unit's — which is
		# why every site carries one rather than some of them doing so. The guard that used
		# to stand here, skipping a site whose path was empty, was the half of the defect
		# that made a missing position look deliberate.
		em.at_path = s.path
		c_mark(em, s.line, s.col)
		c_check_named_ty(em, s.ty, s)
	}
}

# c_check_named_ty walks a type to its named leaves. A container is transparent here: the
# name that fails to resolve is just as unspellable inside a `list[…]` or a `chan[…]`.
# THE SITE TRAVELS WHOLE rather than as the two of its fields a leaf used to be handed. It
# was `site: str, bound: list[str]` through five signatures, and the visibility rules below
# need a third fact off the same declaration (whether it is `pub`) — which would have been a
# third parameter in all five. A site is one thing; passing one thing says so, and the next
# fact a leaf rule needs is already there.
pub fn c_check_named_ty(mut &em: Emitter, t: ast.Ty, s: Site) {
	match t {
		Ty.TNamed(nm) => c_check_type_name(em, nm, s)
		Ty.TList(el) => c_check_named_ty(em, el, s)
		Ty.TChan(el, _) => c_check_named_ty(em, el, s)
		Ty.TMap(k, v) => c_check_named_ty_two(em, k, v, s)
		Ty.TEither(l, r) => c_check_named_ty_two(em, l, r, s)
		Ty.TOpt(el) => c_check_named_ty(em, el, s)
		Ty.TTuple(ts) => c_check_named_ty_list(em, ts, s)
		Ty.TFn(ps, r) => c_check_named_fn(em, ps, r, s)
		_ => c_skip()
	}
}

fn c_check_named_ty_two(mut &em: Emitter, a: ast.Ty, b: ast.Ty, s: Site) {
	c_check_named_ty(em, a, s)
	c_check_named_ty(em, b, s)
}

fn c_check_named_ty_list(mut &em: Emitter, ts: list[ast.Ty], s: Site) {
	for t in ts {
		c_check_named_ty(em, t, s)
	}
}

fn c_check_named_fn(mut &em: Emitter, ps: list[ast.Ty], r: ast.Ty, s: Site) {
	c_check_named_ty_list(em, ps, s)
	c_check_named_ty(em, r, s)
}

fn c_check_type_name(mut &em: Emitter, nm: str, s: Site) {
	site := s.place
	if c_is_type_name(em, nm) {
		# THE NAME RESOLVES, AND THAT IS ONLY HALF THE QUESTION. A type flattens into one
		# program-wide space here, so resolving says the declaration EXISTS and says nothing
		# about whether this module may write it, or whether the declaration doing the writing
		# is allowed to hand it on. Both rules are asked of every leaf, because both are about
		# a name in a type position and this is where every one of them arrives.
		check.chk_ty_visible(em, nm)
		check.chk_ty_exported(em, nm, site, s.decl_pub)
		return
	}

	# a TYPE PARAMETER of the template this signature belongs to. It names no declared type
	# on purpose — that is what makes it a parameter — and it is gone by the time anything
	# is emitted, because a specialization has a real type in its place.
	return if c_name_in(s.tparams, nm)

	# `This` is the SELF TYPE (GRAMMAR#param), so it names something only where there is a
	# self — inside an `impl`, where c_impl_ty has already substituted it. Reaching here
	# means there was none, and saying "no type named `This`" invites the reader to go and
	# declare one. Checked rather than refused, for the reason c_ident gives.
	if nm == "This" {
		check.chk_at(em, rule.Rule.ThisOutsideImpl, f"`This` is the self type, and {site} is outside an `impl` — there is no type for it to name")
		return
	}

	# A `spec` IS a type in the language — the third of the three roles docs/core/specs.md
	# gives it, beside the bound and the interface — and this compiler has not built that
	# one. Saying "no type named `Tag`" about a spec the reader declared three lines above
	# invites them to go and declare it again.
	raise c_diag(em, rule.Rule.NotYetSpecAsType, f"NotImplemented: the `spec` `{nm}` used as a TYPE ({site}) — a spec is a bound and an interface here, not yet a value's type; take the concrete type, or a generic parameter bounded by it") if c_is_spec_name(em, nm)

	# EVERY BUILT-IN NAME THE LANGUAGE HAS AND THIS COMPILER DOES NOT, not only the ladder. A
	# type position reached `c_fixed_width_check` alone, so `p: ptr` reported "no type named
	# `ptr`" while `ptr(x)` in a CALL had been named all along — one name, two positions, and
	# only one of them told the reader what it was looking at.
	c_builtin_check(em, nm)

	raise c_diag(em, rule.Rule.NoSuchType, f"no type named `{nm}` ({site})")
}

# c_typedef_of answers what a `type X = Y` name is underneath, or TUnknown for a name that
# is not one. It is the ONE place the representation is looked through: everywhere else the
# two are different types, which is what a strong typedef means.
fn c_typedef_of(mut &em: Emitter, nm: str) -> ast.Ty {
	r := c_ty_row(em, nm)
	return ast.Ty.TUnknown if not c_row_is_typedef(em, r)

	return em.tk_unders[r]
}

# c_row_is_typedef is asked by the two readers of `tk_unders`, and it is asked BECAUSE the
# table is now one: a struct, an enum and a spec have rows too, and their underlying type is
# the TUnknown a row needs to exist, not a representation anybody may read. Without this
# `c_repr_of(TNamed("SomeStruct"))` would answer TUnknown instead of the struct — which no
# emitted byte happened to depend on, and would have been a silent wrong answer waiting for
# the first caller that did.
fn c_row_is_typedef(mut &em: Emitter, r: int) -> bool {
	return false if r < 0

	return em.tk_kinds[r] == TK_TYPEDEF
}

# c_is_typedef asks the NAME list, not what the name is underneath: a typedef whose
# underlying type nothing declares is registered as unknown so its uses stay quiet, and it is
# still a declared type name — the mistake is in the declaration, which has already said so.
# c_ty_row is THE typedef lookup, for the same reason c_var_row is the variant one: two
# readers, one table. `c_repr_of` used to say so in a comment — "one scan answers both `is it
# one` and `what is it`" — while being the only one that did.
# What a declared type NAME denotes. Four kinds and no match over them — every reader
# compares — so they are constants rather than an enum, the same call c_scalar_class makes
# below for the same reason.
const TK_NONE := 0
const TK_STRUCT := 1
const TK_ENUM := 2
const TK_SPEC := 3
const TK_TYPEDEF := 4

# c_ty_register is the ONLY writer, and the FIRST writer of a name wins. A duplicate across
# kinds is already reported by c_check_type_dup; what is left is which of the two the rest
# of the compiler then believes, and one table has to answer that once. It answers "the
# first declared", in the order the builders run — typedefs, structs, enums, then specs —
# which is why the spec pass is last: `struct A` beside `spec A` is a struct with a
# duplicate reported against it, and not a spec that no longer constructs.
fn c_ty_register(mut &em: Emitter, nm: str, kind: int, under: ast.Ty, path: str, is_pub: bool) {
	return if c_ty_row(em, nm) >= 0

	em.tk_names.append(nm)
	em.tk_kinds.append(kind)
	em.tk_unders.append(under)
	em.tk_mod.append(check.c_mod_of(em, path))
	em.tk_pub.append(is_pub)
	em.tk_path.append(path)
}

# c_ty_mod / c_ty_pub are the registry's answer to "who declared this, and did they export
# it". An UNREGISTERED name answers the sentinel pair — no module, exported — which is what
# keeps every rule that asks quiet about a built-in, a type parameter, or a name whose
# declaration was itself refused. A rule that guessed there would refuse a working program
# for a reason its author cannot see, which is chk_visible's standing discipline.
# c_ty_path is c_ty_mod's twin for #57's file rule, and answers the same sentinel — the empty
# path, which every rule reads as "be quiet" — for a name the registry does not hold.
pub fn c_ty_path(mut &em: Emitter, nm: str) -> str {
	r := c_ty_row(em, nm)
	return "" if r < 0

	return em.tk_path[r]
}

pub fn c_ty_mod(mut &em: Emitter, nm: str) -> str {
	r := c_ty_row(em, nm)
	return "" if r < 0

	return em.tk_mod[r]
}

pub fn c_ty_pub(mut &em: Emitter, nm: str) -> bool {
	r := c_ty_row(em, nm)
	return true if r < 0

	return em.tk_pub[r]
}

fn c_ty_row(mut &em: Emitter, nm: str) -> int {
	mut i := 0
	for i < em.tk_names.len() {
		return i if em.tk_names[i] == nm
		i = i + 1
	}
	return -1
}

# c_ty_kind is what a name DENOTES — one lookup, one answer. Every predicate below is this
# and a comparison, which is the point: a name cannot be a struct to one reader and not a
# type to another, and adding a fifth kind is a row rather than an edit in five places.
fn c_ty_kind(mut &em: Emitter, nm: str) -> int {
	r := c_ty_row(em, nm)
	return TK_NONE if r < 0

	return em.tk_kinds[r]
}

pub fn c_is_typedef(mut &em: Emitter, nm: str) -> bool {
	return c_ty_kind(em, nm) == TK_TYPEDEF
}

fn c_is_spec_name(mut &em: Emitter, nm: str) -> bool {
	return c_ty_kind(em, nm) == TK_SPEC
}

# c_is_enum_name and c_is_enum_ty are the same question of a name and of a type. Both are
# here because the second was written as `c_name_in(em.enum_names, …)` at seven call sites
# and as a function at five more — one question, two spellings, and the table exposed to
# both.
fn c_is_enum_name(mut &em: Emitter, nm: str) -> bool {
	return c_ty_kind(em, nm) == TK_ENUM
}

# c_repr_of is a type as its REPRESENTATION — itself, unless it is a typedef, in which case
# what it was declared over. Only the emitter asks this, and only where C needs a type: the
# checker must never, because the distinctness is the feature.
pub fn c_repr_of(mut &em: Emitter, t: ast.Ty) -> ast.Ty {
	r := c_ty_row(em, c_named_of(t))

	# a typedef whose underlying type nothing declares answers UNKNOWN rather than itself:
	# that is what keeps its uses quiet while the declaration carries the diagnostic. A name
	# that is a type of any OTHER kind answers itself, which is what "unless it is a typedef"
	# has always meant.
	return t if not c_row_is_typedef(em, r)

	return em.tk_unders[r]
}

# c_scalar_repr is what a `type X = Y` COMPUTES IN, and the one place the strong typedef is
# looked through for an operator rather than for a representation.
#
# The two are not in tension, which is the whole of the rule: an identity decides what may
# MEET what — a `Celsius` is never an `int` at a typed position, and never will be — while an
# operator decides what may be DONE with it. `docs/core/types.md` says `X` takes on `Y`'s
# implementation, and a `UserId` that behaves like an `int` but cannot be added to another
# `UserId` is not the tool that sentence describes.
#
# It recurses, because a typedef's underlying type may be one: `type A = B` over `type B =
# int` computes in `int`. A type that is not a typedef answers ITSELF, so every other caller's
# type passes through untouched.
pub fn c_scalar_repr(mut &em: Emitter, t: ast.Ty) -> ast.Ty {
	nm := c_named_of(t)
	return t if nm == ""

	u := c_typedef_of(em, nm)
	return t if c_is_unknown(u)

	return c_scalar_repr(em, u)
}

# c_is_type_name is whether a name is a declared TYPE of any kind. It was the same four-term
# disjunction written out in three places — the typedef registry, the typedef's own check,
# and c_check_type_name — so a fifth kind of type name would have been three edits with two
# of them silent if missed.
pub fn c_is_type_name(mut &em: Emitter, nm: str) -> bool {
	k := c_ty_kind(em, nm)
	return k == TK_STRUCT or k == TK_ENUM or k == TK_TYPEDEF
}

fn c_is_struct_name(mut &em: Emitter, nm: str) -> bool {
	return c_ty_kind(em, nm) == TK_STRUCT
}

# c_scan_fnptr decides up front whether the program spells a function type anywhere in a
# DECLARATION. It has to run before anything is emitted, because those declarations are
# written out before any body is: a struct or enum typedef naming `zg_fnptr` would otherwise
# reach the C compiler ahead of the typedef that defines it. (A body that merely holds a
# function in a local sets the flag as it goes; by then the header has not been assembled
# yet, which is why only the declaration sites need a sweep of their own.)
#
# It reads c_decl_sites for the same reason its two neighbours do. Written as its own walk
# it enumerated struct fields and function signatures and forgot an enum variant's payload,
# so `enum E { Op(fn(int) -> int) }` — declared and never constructed, the one case no body
# rescues — emitted `struct { zg_fnptr f0; }` above the typedef and cc reported it.
fn c_scan_fnptr(mut &em: Emitter, sites: list[Site]) {
	for s in sites {
		if c_is_fn(s.ty) {
			em.used_fnptr = true
		}
	}
}

# c_build_top_names refuses a NAME DECLARED TWICE at the top level.
#
# THE TOP LEVEL IS ONE NAMESPACE, and six kinds of declaration live in it: a `struct`, an
# `enum`, a `type`, a `spec`, a free `fn` and a module constant. A type name is not merely
# beside the value names — GRAMMAR#struct-decl puts it INTO them, since `struct User` is
# what makes `User(…)` a call — so "a type and a function cannot share a name (a duplicate
# is an error — Zerg has no overloading)" is the same rule as "two functions cannot", and
# every module of a program flattens into one scope here besides. Nothing checked it, and
# the shapes failed several different ways:
#
#   struct A {v} + struct A {w}   MERGED into one struct of two fields; `A(7)` then wanted
#                                 two arguments, a wrong answer with no diagnostic
#   struct A {v} + struct A {v}   cc: "typedef redefinition", against .zerg-cache
#   enum E + enum E               the same cc error
#   spec T + spec T               silently ignored; the second's members required nothing
#   struct A + fn A               cc: "redefinition of 'zg_A' as different kind of symbol",
#                                 and BEFORE that `A(3)` quietly meant the constructor, so
#                                 the program said something its reader did not write
#   const A + struct A            the same cc error, against the constant's global
#
# The last two are why this walk owns the FUNCTIONS and the CONSTANTS as well as the types.
# The constant-versus-function half was checked once, in c_const_globals, and a rule with
# two checks has two extents: that one knew nothing about types, so `const A := 1` beside
# `struct A` reached cc while `const A := 1` beside `fn A()` did not. One walk over every
# top-level declaration is one extent, and it cannot drift from itself.
#
# It runs before the tables are built, so a later pass never sees the second declaration
# and cannot be confused by it — which is also what keeps the constructor from winning an
# argument it should never have been in.
fn c_build_top_names(mut &em: Emitter, f: ast.File) {
	mut seen: list[str] = []
	mut kind: list[str] = []

	# WHERE THE FIRST ONE WAS, because the two halves of this collision are two rules. A
	# `File` here is the whole program's declarations, each carrying the path it was written
	# in, so one file declaring a name twice and two files of one module declaring it are
	# both in this walk — and only the second is about module flattening.
	mut wpath: list[str] = []
	mut wline: list[int] = []
	for sd in f.structs {
		c_check_type_dup(em, seen, kind, wpath, wline, sd.name, "a struct", sd.path, sd.line, sd.col)
	}
	for ed in f.enums {
		c_check_type_dup(em, seen, kind, wpath, wline, ed.name, "an enum", ed.path, ed.line, ed.col)
	}
	for td in f.types {
		c_check_type_dup(em, seen, kind, wpath, wline, td.name, "a type declaration", td.path, td.line, td.col)
	}
	for sp in f.specs {
		# ALL SIX KINDS KNOW WHERE THEY WERE WRITTEN, so all six report the same way: they say
		# where, and they accumulate rather than ending the run at the first finding. A
		# StructDecl and an EnumDecl carried no place once and those two raised instead, which
		# is the split c_dup_report's comment records as gone.
		c_check_type_dup(em, seen, kind, wpath, wline, sp.name, "a spec", sp.path, sp.line, sp.col)
	}

	# THE FUNCTIONS AFTER THE TYPES, so the finding lands on the `fn` in EITHER source order.
	# A collision is reported at the SECOND declaration the walk meets, and the walk's order
	# is this one rather than the file's — so `fn A` beside `struct A` says the same thing,
	# and says it at the function, whichever of the two the reader wrote first.
	#
	# FREE functions only. A method is keyed by its receiving type — `impl Bar { fn Foo() }`
	# mangles to `zg_Bar_Foo` and lives in that type's namespace (GRAMMAR#impl-decl), which
	# is a different rule with its own report in c_build_sigs — so a method may share a name
	# with a type and nothing is ambiguous about it.
	for fn_i in f.fns {
		if fn_i.recv == "" {
			c_check_type_dup(em, seen, kind, wpath, wline, fn_i.name, "a function", fn_i.path, fn_i.line, fn_i.col)
		}
	}

	# AND THE CONSTANTS LAST, which is where c_const_globals reported this rule's
	# constant-versus-function half from, so the place a reader is pointed at does not move:
	# the collision is reported at the constant's own declaration in both orders.
	for c in f.consts {
		c_check_type_dup(em, seen, kind, wpath, wline, c.name, "a module constant", c.path, c.line, c.col)
	}

	# AND THE TABLE IS KEPT. What the six loops above have in hand is "what the top level
	# declares, and which kind each one is" — which is the whole of the question the import
	# rule asks (chk_decl_kind), and that rule used to answer it by walking the same six
	# lists over again. Two walks is two extents and two wordings of one fact.
	em.top_names = seen
	em.top_kinds = kind

	# and one level down, where the same question has the same answer and three more ways
	# of going wrong: a repeated FIELD and a repeated PARAMETER both reached cc as a C
	# redefinition against .zerg-cache, and a repeated VARIANT was accepted — the second
	# took the next discriminant, so it was unreachable, and a `match` naming the first was
	# "exhaustive" over an enum that had two.
	for sd in f.structs {
		mut fnames: list[str] = []
		for fd in sd.fields {
			fnames.append(fd.name)
			c_check_private_field(em, sd, fd)
		}
		c_check_names_distinct(fnames, "a field", sd.name, sd.path, sd.line, sd.col)
		for fd in sd.fields {
			c_check_field_default(sd, fnames, fd)
		}
	}
	for ed in f.enums {
		mut vnames: list[str] = []
		for v in ed.variants {
			vnames.append(v.name)
		}
		c_check_names_distinct(vnames, "a variant", ed.name, ed.path, ed.line, ed.col)
	}
	for fn_i in f.fns {
		# a FnDecl knows where it was written too
		mut pseen: list[str] = []
		for pm in fn_i.params {
			if c_name_in(pseen, pm.name) {
				check.chk_at_place(em, fn_i.path, fn_i.line, fn_i.col, rule.Rule.ParamNameTwice, f"`{fn_i.name}` declares a parameter named `{pm.name}` twice")
			}
			pseen.append(pm.name)
		}
	}
}

# c_check_private_field is GRAMMAR's FIELD VISIBILITY & DEFAULTS rule, the half that is
# about the field's DECLARATION rather than about a construction.
#
# A non-`pub` field is module-private, and it MUST carry a default. The two halves of the
# note are one rule: the field-wise `T(...)` constructor is public, and there are NO zero
# values — so a field with no default is one every construction has to supply a value for.
# Outside the module a private field may not even be READ, and asking a caller for a value
# it can never see back is a type nothing out there can build. A default is what makes the
# argument omittable, which is what makes such a type constructible at all.
#
# Until field defaults existed the rule was UNENFORCEABLE — there was no way to write the
# thing it demands — so the compiler accepted a private field with no default and the MUST
# was dead in both directions. It arrives with them for that reason.
#
# A `T?` is the exception the note itself names: its implicit default is `nil`, so it is
# already omittable and needs no `=`.
fn c_check_private_field(mut &em: Emitter, sd: ast.StructDecl, fd: ast.FieldDef) {
	return if fd.is_pub or fd.has_def or ast.ty_is_opt(fd.ty)

	check.chk_at_place(em, sd.path, fd.line, fd.col, rule.Rule.PrivateFieldNeedsDefault, f"the field `{fd.name}` of `{sd.name}` is module-private, so it must carry a default (`{fd.name}: {ast.ty_name(fd.ty)} = …`) — a construction outside the module cannot supply a value for a field it may not read. Write `pub` to expose the field instead")
}

# c_check_field_default refuses a default that names ANOTHER FIELD of the same struct, which
# is the one shape of default this compiler cannot lower — and the shape that goes wrong
# silently rather than loudly.
#
# The default is materialised at the CONSTRUCTION, where the struct's fields are not names in
# scope, so `b: int = a * 2` reads whatever `a` means THERE. With no such name it is `E3069
# undefined name`, which is a true sentence about the wrong thing — `a` is a field, right
# above. With a module constant called `a` it is worse: the default quietly reads the
# constant, and `P(3).b` was 200 for `a := 100` where the field would have made it 6.
#
# It is the same refusal `docs/code/functions.md` records for a parameter default that reads
# an earlier parameter, for the same reason, and the seed has gated it on both since it was
# written. Refusing by name is what this compiler owes a form it cannot lower.
fn c_check_field_default(sd: ast.StructDecl, fnames: list[str], fd: ast.FieldDef) {
	return if not fd.has_def

	nm := c_default_names_field(fnames, fd.def)

	# with a place, which a refusal usually has none of: this one runs over a DECLARATION and
	# the field carries its own line and column, so there is a position to give and no reason
	# to make the reader find the struct themselves
	raise c_diag_at(sd.path, fd.line, fd.col, rule.Rule.NotYetDefaultReadsField, f"NotImplemented: the default on field `{fd.name}` of `{sd.name}` reads the field `{nm}` — a default is materialised at the construction, where a field is not a name in scope, so `{nm}` would resolve to whatever else carries that name (or to nothing at all)") if nm != ""
}

# c_default_names_field is the first of `fnames` a default expression mentions, or "". The
# walk is ITERATIVE over `expr_parts` for the reason `p_expr_root`'s is: a walk that runs
# over an arbitrary program's expression must not be able to fail at depth.
fn c_default_names_field(fnames: list[str], e: ast.Expr) -> str {
	mut nodes: list[ast.Expr] = [e]
	mut i := 0
	for i < nodes.len() {
		nm := c_ident_name(nodes[i])
		return nm if nm != "" and c_name_in(fnames, nm)

		for k in ast.expr_parts(nodes[i]) {
			nodes.append(k)
		}
		i = i + 1
	}
	return ""
}

# c_check_names_distinct takes the DECLARATION's place rather than reading the emission
# marker, for the reason c_check_field_default does: it runs while the top-level names are
# registered, before a statement has been emitted for the marker to point at.
fn c_check_names_distinct(names: list[str], what: str, whose: str, path: str, line: int, col: int) {
	mut seen: list[str] = []
	for n in names {
		raise c_diag_at(path, line, col, rule.Rule.MemberDeclaredTwice, f"`{whose}` declares {what} named `{n}` twice") if c_name_in(seen, n)

		seen.append(n)
	}
}

fn c_check_type_dup(mut &em: Emitter, mut &seen: list[str], mut &kind: list[str], mut &wpath: list[str], mut &wline: list[int], name: str, what: str, path: str, line: int, col: int) {
	mut i := 0
	for i < seen.len() {
		if seen[i] == name {
			c_dup_report(em, name, kind[i], what, path, line, col, wpath[i], wline[i])
			return
		}
		i = i + 1
	}
	seen.append(name)
	kind.append(what)
	wpath.append(path)
	wline.append(line)
}

# c_dup_report is the one place a duplicate declaration is worded, so all six kinds of
# declaration say the same thing about the same rule. TWO SENTENCES MEANS TWO RULES, so
# there are two codes: colliding with a DIFFERENT kind of declaration and colliding with the
# same kind are separate mistakes with separate answers.
#
# BOTH RECORD, and neither raises. There used to be a c_dup_say between this and the channel,
# to CHOOSE one — a struct and an enum were registered with no place, so those two raised and
# the other four said where — and the choice went when its reason did: a StructDecl and an
# EnumDecl each carry the line their keyword is on now, so all six have a place to give and
# there is nothing left for a chooser to decide.
#
# A FOLLOW-ON IS THE PRICE OF RECORDING, and it is paid rather than dodged. A duplicate
# `struct A` used to end the run; now the walk carries on, so `A(7)` against the SECOND
# declaration also reports `E3067 the field `w` … has no value`. That second sentence is true
# of the program as the compiler must read it, and it goes away when the duplicate does.
#
# Suppressing it would need a list of names a rule has already condemned, consulted by every
# later rule that resolves one — a mechanism, for one cascade, whose first missed consultation
# is a rule going quiet about a real mistake. Reporting every finding in one run is what the
# specification asks for (docs/conformance.md), and a cascade is what "every" costs.
fn c_dup_report(mut &em: Emitter, name: str, prev: str, what: str, path: str, line: int, col: int, wpath: str, wline: int) {
	if prev != what {
		check.chk_at_place(em, path, line, col, rule.Rule.DeclaredTwiceDifferentKind, f"`{name}` is declared twice — once as {prev}, once as {what}")
		return
	}

	# TWO OF THE SAME KIND, and for two of the six kinds that is not this walk's answer to
	# give. A second free function of one name may be two MODULES each declaring a PRIVATE
	# one, which c_build_sigs tells apart by a module tag rather than refusing — reporting
	# it here would refuse a program the language allows. A second module constant is
	# c_const_globals', which says which of the two it means. Both are recorded here all
	# the same, because a CONSTANT colliding with a FUNCTION is this walk's rule and it
	# needs the first of each on the list to see it.
	# ONE FILE IS THE OTHER RULE, and it is asked before the two kinds below are handed back:
	# a second free function may be two MODULES each declaring a private one, which is legal,
	# but two of them in ONE FILE never is. Asking it here is what keeps this rule's extent to
	# one walk — the property the head of c_build_top_names claims and the reason a code may
	# be reported from exactly one place.
	if wpath == path {
		check.chk_at_place(em, path, line, col, rule.Rule.DeclaredTwiceInFile, c_twice_in_file_says(name, wline))
		return
	}

	return if what == "a function" or what == "a module constant"

	# THE OTHER HALF is what module flattening is actually about: a thing the reader can only
	# have done across files. Said about two declarations in one file it hands them an
	# explanation for something they did not do, and loses the one fact no caret can carry —
	# where the first declaration is.
	check.chk_at_place(em, path, line, col, rule.Rule.DeclaredTwiceSameKind, f"`{name}` is declared twice — a type name is one name, and every module of a program flattens into one namespace here")
}

# c_build_typedefs registers the `type X = Y` declarations. It runs BEFORE the structs, so a
# struct field declared `Celsius` finds the name already known.
# c_build_specs registers every `spec` as a type name, so a name that fails to resolve as a
# TYPE can say which of the two it is: a spec used where a type goes, or a typo.
#
# It runs LAST of the four registrars. A name declared as both a spec and something else is
# reported by c_build_top_names and then belongs to the other one — which is the answer the
# separate tables used to give by accident, each saying yes to its own question, and the
# answer the constructor path needs: `struct A` beside `spec A` still constructs.
fn c_build_specs(mut &em: Emitter, f: ast.File) {
	for sp in f.specs {
		c_ty_register(em, sp.name, TK_SPEC, ast.Ty.TUnknown, sp.path, sp.is_pub)
	}
}

fn c_build_typedefs(mut &em: Emitter, f: ast.File) {
	for td in f.types {
		# chk_typedef ANSWERS the underlying type it validated, so the registry does not
		# recompute it: a typedef whose underlying type nothing declares is registered as
		# UNKNOWN, which keeps every USE quiet while the declaration carries the diagnostic.
		c_ty_register(em, td.name, TK_TYPEDEF, check.chk_typedef(em, td, f), td.path, td.is_pub)
	}
}

fn c_build_structs(mut &em: Emitter, f: ast.File) {
	mut i := 0
	for i < f.structs.len() {
		sd := f.structs[i]
		c_ty_register(em, sd.name, TK_STRUCT, ast.Ty.TUnknown, sd.path, sd.is_pub)
		mut j := 0
		for j < sd.fields.len() {
			fd := sd.fields[j]
			em.fld_struct.append(sd.name)
			em.fld_name.append(fd.name)
			em.fld_ty.append(fd.ty)
			em.fld_pub.append(fd.is_pub)
			em.fld_hasdef.append(fd.has_def)
			em.fld_def.append(fd.def)
			j = j + 1
		}
		i = i + 1
	}
}

# c_fld_pub is whether a field carries `pub`. A field NOBODY DECLARED answers yes, which is
# the same sentinel c_ty_pub keeps and for the same reason: the mistake there is that the
# field does not exist (E3072 says so), and a visibility finding on top of it would be a
# second message about one mistake, naming a rule that is not what went wrong.
pub fn c_fld_pub(mut &em: Emitter, sname: str, fname: str) -> bool {
	mut i := 0
	for i < em.fld_struct.len() {
		return em.fld_pub[i] if em.fld_struct[i] == sname and em.fld_name[i] == fname
		i = i + 1
	}
	return true
}

fn c_field_ty(mut &em: Emitter, sname: str, fname: str) -> ast.Ty {
	mut i := 0
	for i < em.fld_struct.len() {
		return em.fld_ty[i] if em.fld_struct[i] == sname and em.fld_name[i] == fname
		i = i + 1
	}
	return ast.Ty.TUnknown
}

# c_struct_field_ty_at returns the type of a struct's idx-th field (declaration order).
fn c_struct_field_ty_at(mut &em: Emitter, sname: str, idx: int) -> ast.Ty {
	row := c_struct_field_row(em, sname, idx)
	return ast.Ty.TUnknown if row < 0
	return em.fld_ty[row]
}

# c_field_init emits a constructor argument, initialising an EMPTY list `[]` to a properly
# sized runtime list from the destination field's element type (a bare `[]` carries no
# element type of its own, and would otherwise emit a malformed zero list).
#
# The emptiness test is the whole point of it, and it used to be missing: any list literal
# took this branch, so `Bag([1, 2, 3])` built a struct whose field was an EMPTY list and
# said nothing. That is the same defect c_list_lit's comment describes for a call argument
# — a program that runs and is simply not what was written — and it survived here because
# a struct field's list is usually appended to afterwards, which hides a length that
# started at the wrong number. A non-empty literal has its own element type and its own
# elements, so it takes the ordinary path.
# `where` names the slot for a diagnostic — "field 2 of `P`", "payload 1 of `Shape.Line`".
# It is passed straight down to c_fit_copied, which is where the fit is CHECKED: a struct
# literal's field was checked and an enum variant's payload was not, though they are the same
# slot lowered by the same function twelve lines apart, and the label is now what carries the
# difference between them rather than a second call nobody remembered to make.
fn c_field_init(mut &em: Emitter, where: str, fty: ast.Ty, arg: ast.Expr, sb: Subst) -> str {
	# `where` and not the word "field": the label the FIT check is about to use already names
	# this slot exactly ("field 2 of `P`", "payload 1 of `Shape.Line`"), and a second, vaguer
	# spelling of the same slot is a second answer to one question.
	if ast.ty_is_chan(fty) {
		c_chan_check(em, c_infer(em, arg), fty, where)
	}

	# a declared `T?` field takes a bare value or `nil` and wraps it, so `P(nil)` builds an
	# ABSENT field rather than a present one holding whatever `nil` lowered to; a bare `[]`
	# takes the field's element type. Both are c_fit_copied's, which every destination-typed
	# site asks — this one is only the chan check plus that.
	return c_fit_copied(em, where, fty, arg, sb)
}

# --- value semantics -----------------------------------------------------------------------
#
# "Two names of a value type never alias: writing through one is never visible through the
# other" (docs/core/memory.md). A scalar or a plain struct gets that from C's own `=`. A `list`
# does not: it is a handle onto a heap buffer, so a C `=` hands out a second name for the
# SAME elements — and a struct holding one inherits the problem however deep it sits.
#
# So a copy of anything that holds a list goes through a generated per-type helper, and
# every place a value is COPIED calls it: a binding, an assignment, a field of a struct
# being built. The helper is where the rule lives, rather than each of those sites knowing
# how to walk a type.
#
# Why the bug survived so long: appending through a shared buffer is invisible. A zrt_list
# carries its own length, so a push bumps only the writer's, and the reader — whose length
# never moved — sees nothing. Every list the compiler's own source touches is append-only,
# so its own tests could never have caught this. It takes a write to an index the other
# holder can already see, which is what test-data/codegen/value_semantics.zg does.

# c_needs_copy reports whether copying a value of this type has to do more than a C `=`.
fn c_needs_copy(mut &em: Emitter, t: ast.Ty) -> bool {
	return true if c_is_list(t) or c_is_map(t)

	# A str is a refcounted cell (c_str_cell), so giving one a second name is a COPY like
	# any other — a retain, which is what makes the two names' releases balance. A literal's
	# cell is immortal, so retain and release both no-op on it and a program that holds
	# nothing but literals behaves exactly as it did.
	return true if c_is_str(t)

	# A CARRIER owns WHICHEVER SIDE IT HOLDS — that is what `if v := c { … }` retaining what
	# it binds already says — so it owes a copy exactly when either side does. Answering
	# `false` here is what made `got := <-c` a second name for one reference: the value was
	# bit-copied in and nothing was registered, because a type that needs no copy is a type
	# that owes nothing back. Asking only the LEFT was the same miss one level along: a
	# `list[Either[int, str]]` was a list of things needing no copy.
	return c_carrier_owns(em, t) if c_is_carrier(t)

	# A HELD FUNCTION owns its environment, whatever it captured — the question cannot be
	# asked of what is in there, because a `fn(int) -> int` is the type of every lambda with
	# that shape and each closed over something different. A named function's environment is
	# NULL and the copy no-ops on it, so answering `true` for every function type costs a
	# branch and buys one rule.
	return true if c_is_fn(t)

	# A TUPLE is the third composite, and it was missing: `mut t := (a, 0)` bit-copied the
	# list `a`, so `t.0[0] = 99` was read back through `a`. Its elements are a list of
	# types, so the same question is asked of each.
	for e in ast.ty_tuple_elems(t) {
		return true if c_needs_copy(em, e)
	}

	nm := c_named_of(t)
	return false if nm == ""

	# A struct cannot contain itself BY VALUE — that would have no finite size — so this
	# recursion always terminates. A self-referential type reaches itself through a list,
	# which answers true above without recursing.
	mut i := 0
	for i < em.fld_struct.len() {
		return true if em.fld_struct[i] == nm and c_needs_copy(em, em.fld_ty[i])
		i = i + 1
	}

	# AN ENUM OWNS ITS PAYLOAD, and it was the one composite this question never reached: a
	# self-recursive slot is boxed behind a refcounted cell, so copying one has to RETAIN
	# rather than duplicate — and a payload holding a str or a list owes the same walk a
	# struct field does.
	#
	# A BOXED SLOT ANSWERS WITHOUT RECURSING, and that is a termination rule and not a
	# shortcut: the type of a boxed slot IS the enum being asked about, so recursing into it
	# never returns. It is also the only back edge there is — every other payload is by value,
	# and a by-value cycle has no size and is refused at E4026 — so declining to follow it
	# leaves a DAG. The seed carries the same rule with the same note (emit_ref.go), written
	# after the version without it looped forever.
	mut j := 0
	for j < em.vf_variant.len() {
		if em.vf_enum[j] == nm {
			return true if em.vf_boxed[j]
			return true if c_needs_copy(em, em.vf_ty[j])
		}
		j = j + 1
	}
	return false
}

# c_copied renders an expression as an INDEPENDENT copy of itself, when its type needs one.
#
# A freshly built value — a call's result, a constructor, a literal — is already nobody
# else's, so copying it would only cost. Only an lvalue can be a second name for something.
fn c_copied(mut &em: Emitter, t: ast.Ty, e: ast.Expr, sb: Subst) -> str {
	rendered := c_expr(em, e, sb)
	return rendered if not c_is_lvalue(e) or not c_needs_copy(em, t)
	return c_copy_of(em, t, rendered)
}

# c_copy_of is HOW a copy is spelled, given something already rendered: a list through the
# runtime, anything else through its generated helper. It is separate from c_copied so
# that the helpers below spell a copy the same way every call site does — the rule for
# what a deep copy IS lives in one function, and a second kind of type that needs one is
# added here alone.
fn c_copy_of(mut &em: Emitter, t: ast.Ty, x: str) -> str {
	# the source is BOUND before its address is taken, because `&(x)` needs x to be a place
	# and not everything copied is one. `m[k]` lowers to a statement expression, so reading
	# a list out of a map — `v := c["k"]` — reached cc as "cannot take the address of an
	# rvalue of type 'zrt_list'", against C nobody wrote. Binding costs one header copy,
	# which is a handful of words, and it makes the addressability question go away rather
	# than answering it at each call site.
	if c_is_list(t) or c_is_map(t) {
		em.used_rt = true

		# `c_type` of either is exactly the runtime type name, and the copy is that plus
		# `_copy` — so the two containers are one template rather than two spellings of it
		ct := c_type(t)
		return "({ " + ct + " zgt_cs = (" + x + "); " + ct + " zgt_cp; " + ct + "_copy(&zgt_cp, &zgt_cs); zgt_cp; })"
	}
	return f"{c_tuple_cname(ast.ty_tuple_elems(t))}_copy({x})" if c_is_tuple(t)
	if c_is_str(t) {
		em.used_rt = true
		return f"zrt_str_retain({x})"
	}

	# a carrier's helper is named after the carrier's own C name, which is not `zg_` plus a
	# declared name — so it is spelled here rather than falling into the line below, which
	# would render `zg_copy_(x)` and leave cc to explain it
	return f"zg_copy_{c_carrier_of(em, t)}({x})" if c_is_carrier(t)

	# and a function's is the one global pair, for the reason c_fnptr_helpers gives
	return f"zg_copy_fnptr({x})" if c_is_fn(t)

	return f"zg_copy_{c_named_of(t)}({x})"
}

# c_copy_helpers emits one `zg_copy_<T>` per struct that holds a list, after the typedefs
# and before anything that calls them, and the ELEMENT VTABLE that lets a list of that
# struct use it.
fn c_copy_helpers(mut &em: Emitter, f: ast.File) -> str {
	mut out := ""
	for sd in f.structs {
		if c_needs_copy(em, ast.Ty.TNamed(sd.name)) {
			out = out + c_copy_helper(em, sd) + c_drop_helper(em, sd) + c_elem_vt_helper(em, ast.Ty.TNamed(sd.name))
		}
	}

	# The enums, through the same three helpers and in the same order, because they are the
	# same pair of obligations: what the copy retains the drop releases. They come after the
	# structs and it does not matter which way round — every name either side calls was
	# prototyped with its typedef.
	for ed in f.enums {
		if c_needs_copy(em, ast.Ty.TNamed(ed.name)) {
			out = out + c_enum_copy_helper(em, ed) + c_enum_drop_helper(em, ed) + c_elem_vt_helper(em, ast.Ty.TNamed(ed.name))
		}
	}
	return out
}

# c_enum_copy_helper is c_copy_helper for a tagged union: one `case` per variant that owns
# anything, and a bit copy for the rest. A BOXED payload is copied by retaining the cell —
# that is what makes a recursive value refcount-shared rather than deep-cloned, and it is
# the sentence docs/core/memory.md writes about copying one.
fn c_enum_copy_helper(mut &em: Emitter, ed: ast.EnumDecl) -> str {
	nm := "zg_" + ed.name
	mut out := "static " + nm + " zg_copy_" + ed.name + "(" + nm + " v) {\n"
	out = out + "    " + nm + " r = v;\n    switch (v.tag) {\n"
	for vd in ed.variants {
		body := c_enum_variant_copy(em, ed.name, vd)
		if body != "" {
			out = out + "    case " + strconv.to_string(c_variant_tag_in(em, ed.name, vd.name), 10) + ":\n" + body + "        break;\n"
		}
	}
	return out + "    default: break;\n    }\n    return r;\n}\n\n"
}

fn c_enum_variant_copy(mut &em: Emitter, en: str, vd: ast.VariantDef) -> str {
	mut out := ""
	mut i := 0
	for i < vd.fields.len() {
		slot := f".u.{vd.name}.f{i}"
		if c_is_boxed(em, en, vd.name, i) {
			em.used_rt = true
			out = out + "        r" + slot + " = zrt_ref_copy(v" + slot + ");\n"
		} else if c_needs_copy(em, vd.fields[i]) {
			out = out + "        r" + slot + " = " + c_copy_of(em, vd.fields[i], "v" + slot) + ";\n"
		}
		i = i + 1
	}
	return out
}

# c_enum_drop_helper is that helper read backwards, slot by slot, in REVERSE declaration
# order — the order docs/core/memory.md pins for an enum payload. (A struct's drop walks its
# fields FORWARD, which the same page pins the other way; that is a gap of c_drop_helper's
# and not a second reading of the rule.)
fn c_enum_drop_helper(mut &em: Emitter, ed: ast.EnumDecl) -> str {
	nm := "zg_" + ed.name
	mut out := "static void zg_drop_" + ed.name + "(" + nm + " *v) {\n    switch (v->tag) {\n"
	for vd in ed.variants {
		body := c_enum_variant_drop(em, ed.name, vd)
		if body != "" {
			out = out + "    case " + strconv.to_string(c_variant_tag_in(em, ed.name, vd.name), 10) + ":\n" + body + "        break;\n"
		}
	}
	return out + "    default: break;\n    }\n}\n\n"
}

fn c_enum_variant_drop(mut &em: Emitter, en: str, vd: ast.VariantDef) -> str {
	mut out := ""
	mut i := vd.fields.len() - 1
	for i >= 0 {
		slot := f"v->u.{vd.name}.f{i}"
		if c_is_boxed(em, en, vd.name, i) {
			em.used_rt = true
			out = out + "        zrt_release(" + slot + ");\n"
		} else if c_needs_copy(em, vd.fields[i]) {
			out = out + "        " + c_drop_stmt(em, vd.fields[i], slot) + "\n"
		}
		i = i - 1
	}
	return out
}

# c_elem_vt is the element vtable a `list[T]` is built with — how the runtime duplicates
# one element when it copies a buffer.
#
# Every list was built with `zg_listvt`, which is {NULL, NULL} — the memcpy fast path,
# correct for a scalar and wrong for anything holding a heap buffer. A `list[Row]` where
# `Row` holds a `list[int]` copied its Rows bit for bit, so both lists' Rows named ONE
# inner buffer and `h[0].ys[0] = 8` was read back through `g`. The mechanism to say
# otherwise has been in the runtime header since the container was written; nothing ever
# supplied it.
#
# A nested LIST needs no per-type vtable: `zrt_list_copy` copies a header, and the header
# carries its own elemsz and its own vt, so one thunk serves every element type.
fn c_elem_vt(mut &em: Emitter, t: ast.Ty) -> str {
	k := c_elem_kind(em, t)

	return "zg_listvt" if k == ""

	return "zg_listvt_" + k
}

# c_elem_copy_fn is the thunk itself, for a table that takes one rather than a whole
# vtable. A map's `key_copy` / `val_copy` have exactly the signature a list element's
# `copy` has, so the same thunks serve both — a `map[str, list[int]]` duplicates its
# values through the function a `list[list[int]]` duplicates its elements through.
fn c_elem_copy_fn(mut &em: Emitter, t: ast.Ty) -> str {
	k := c_elem_kind(em, t)

	return "NULL" if k == ""

	return "zg_elemcopy_" + k
}

# c_elem_kind is the one dispatch behind both: which FAMILY of thunk a type needs, or ""
# for a POD that takes the memcpy path. The two above spell it — `zg_listvt_` and
# `zg_elemcopy_` — and had the four-way decision written out twice, so a kind added to one
# gave maps a memcpy copy of a type lists copied properly, which is the bug this whole
# mechanism exists to prevent.
fn c_elem_kind(mut &em: Emitter, t: ast.Ty) -> str {
	return "list" if c_is_list(t)
	return "map" if c_is_map(t)

	# A str is a refcounted CELL, so a list of them holds references and owes them back. It
	# reached c_named_of below and answered "" — the memcpy path — so `list[str]` retained
	# each element as it was pushed, released none of them, and an unshared copy of the buffer
	# gave two buffers one reference between them.
	return "str" if c_is_str(t)
	return "" if not c_needs_copy(em, t)
	return c_tuple_cname(ast.ty_tuple_elems(t)) if c_is_tuple(t)

	# a carrier's kind is its own C name, for the reason c_copy_of gives one line up: there
	# is no declared name to build it out of. Without this a `list[str?]` took the memcpy
	# vtable and a named carrier had no drop thunk to defer.
	return c_carrier_of(em, t) if c_is_carrier(t)

	# and a function's is the one kind every function type shares
	return "fnptr" if c_is_fn(t)

	return c_named_of(t)
}

# The vtable carries BOTH halves. It used to carry only the copy, with the note that a drop
# thunk would be the only teardown in a leak-style emitter and so would free halves of
# values whose other halves nobody frees. That is no longer true — a struct binding, a
# by-value parameter and a list buffer all give themselves back now — and the copy without
# the drop is the asymmetry: a `list[Row]` deep-copied every Row it duplicated and released
# none of them, so the copying was itself what leaked.
#
# IT TAKES THE TYPE, not a name. A struct, an enum and a CARRIER all need this trio and
# only the first two are spelled `zg_<name>`: a carrier's C type is its own cname, and a
# version that built the spelling out of a name could not serve it. Asking c_elem_kind,
# c_type, c_copy_of and c_drop_fn instead means the three kinds differ in their answers
# and not in their code — which is the whole reason c_elem_kind exists.
fn c_elem_vt_helper(mut &em: Emitter, t: ast.Ty) -> str {
	k := c_elem_kind(em, t)
	ct := c_type(t)
	cp := c_copy_of(em, t, f"*(const {ct}*)src")
	dr := c_drop_fn(em, t)
	mut out := "static void zg_elemcopy_" + k + "(void *dst, const void *src) {\n"
	out = out + "    *(" + ct + "*)dst = " + cp + ";\n}\n"
	out = out + "static void zg_elemdrop_" + k + "(void *elem) { " + dr + "((" + ct + "*)elem); }\n"
	return out + "static const zrt_elem_vt zg_listvt_" + k + " = {zg_elemcopy_" + k + ", zg_elemdrop_" + k + "};\n\n"
}

# c_drop_helper is c_copy_helper read backwards, and the two are written next to each other
# so they stay that way: a field the copy retains and the drop does not release is a leak,
# and a field the drop releases and the copy did not retain is a use-after-free. Both walk
# the same fields under the same c_needs_copy test, which is the only reason that holds.
#
# It takes the value BY POINTER — a drop is a statement about storage, not about a value —
# and it does not clear what it drops. Every caller is at the end of that storage's life.
fn c_drop_helper(mut &em: Emitter, sd: ast.StructDecl) -> str {
	nm := "zg_" + sd.name
	mut out := "static void zg_drop_" + sd.name + "(" + nm + " *v) {\n"
	for fd in sd.fields {
		if c_needs_copy(em, fd.ty) {
			out = out + "    " + c_drop_stmt(em, fd.ty, "v->zg_" + fd.name) + "\n"
		}
	}
	return out + "}\n\n"
}

# c_drop_stmt spells one give-back as a C statement, given the PLACE holding the value. It
# is the single encoding of "how is a T given back", the way c_copy_of is the single
# encoding of how one is copied — a new owning type is added in these two and nowhere else.
#
# A type that owns nothing answers with a `(void)` cast rather than with nothing, so a
# caller can write the statement unconditionally; c_drop_fn is the question to ask when the
# answer has to be a function name.
fn c_drop_stmt(mut &em: Emitter, t: ast.Ty, place: str) -> str {
	f := c_drop_fn(em, t)
	return f"(void)({place});" if f == ""
	return f"{f}({c_drop_arg(em, t, place)});"
}

# c_drop_fn is what gives a value of this type back, or "" for one that owes nothing.
#
# IT ANSWERS FOR EXACTLY THE TYPES c_needs_copy ANSWERS TRUE FOR, and that is not a
# coincidence to be re-derived at each call site — it is the invariant every emitter here
# relies on: a helper is generated for the types that need a copy, and named by the types
# that need a drop, so a kind the two dispatches disagree about is C naming a function
# nobody declared. A TUPLE used to be that kind: `c_needs_copy` walked its elements and
# said true while this said "" (there is no declared name to build `zg_drop_<name>` out
# of), so `(int, str)` leaked its str, and `(int, str)?` — whose carrier decides what to
# emit from HERE and is read through c_needs_copy — reached cc as an undefined symbol.
#
# A STRUCT AND AN ENUM ARE THE SAME ANSWER, `zg_drop_<name>`, because they are the same
# question: a declared type that owns what its parts own. The enum was excluded here and
# nowhere else, which is why a recursive chain had a boxed cell nobody released — the
# registration points were all in place and this dispatch turned every one of them away.
fn c_drop_fn(mut &em: Emitter, t: ast.Ty) -> str {
	return "zrt_list_drop" if c_is_list(t)
	return "zrt_map_drop" if c_is_map(t)
	return "zrt_str_release" if c_is_str(t)

	# the tuple's, named after the SHAPE the way its copy is — c_tuple_decl generates the
	# pair together, under this same question asked as c_needs_copy
	return f"{c_tuple_cname(ast.ty_tuple_elems(t))}_drop" if c_is_tuple(t) and c_needs_copy(em, t)

	# the carrier's, which c_carrier_decl generates beside its copy and answers "" for when
	# the payload owns nothing
	return c_carrier_drop_fn(em, t) if c_is_carrier(t)

	# and the one release every held function shares, which reaches the per-site teardown
	# through the environment cell's own drop rather than through this name
	return "zg_drop_fnptr" if c_is_fn(t)

	nm := c_named_of(t)

	return "" if nm == "" or (not c_is_struct_name(em, nm) and not c_is_enum_name(em, nm))
	return "" if not c_needs_copy(em, t)

	return "zg_drop_" + nm
}

# c_drop_arg spells what the give-back is handed: a list, a map and a struct are all given
# back through the address of their storage, a str by its own value.
fn c_drop_arg(mut &em: Emitter, t: ast.Ty, place: str) -> str {
	return place if c_is_str(t)
	return "&" + place
}

fn c_copy_helper(mut &em: Emitter, sd: ast.StructDecl) -> str {
	nm := "zg_" + sd.name
	mut out := "static " + nm + " zg_copy_" + sd.name + "(" + nm + " v) {\n"
	out = out + "    " + nm + " r = v;\n"
	for fd in sd.fields {
		if c_needs_copy(em, fd.ty) {
			out = out + "    r.zg_" + fd.name + " = " + c_copy_of(em, fd.ty, "v.zg_" + fd.name) + ";\n"
		}
	}
	return out + "    return r;\n}\n\n"
}

# c_struct_typedef emits a value struct as a C typedef with zg_-mangled fields.
fn c_struct_typedef(sd: ast.StructDecl) -> str {
	mut out := "typedef struct {\n"
	mut i := 0
	for i < sd.fields.len() {
		fd := sd.fields[i]
		out = out + "    " + c_type(fd.ty) + " zg_" + fd.name + ";\n"
		i = i + 1
	}
	return out + "} zg_" + sd.name + ";\n\n"
}

# c_named_of returns the struct name of a TNamed type, or "" otherwise.
pub fn c_named_of(t: ast.Ty) -> str {
	return match t {
		Ty.TNamed(nm) => nm
		_             => ""
	}
}

# c_build_enums registers every enum's variants, and it is where a discriminant becomes a
# NUMBER: GRAMMAR#variant gives the position a const-expr, so the value may be `2 + 3` or the
# name of a module constant, and neither is known until the program is whole and its constants
# are folded (c_build_const_vals, which runs just before this).
#
# The numbering rule is GRAMMAR's: an unspelled variant is one past the previous one, from 0,
# so a spelled value moves every variant after it. A discriminant that does not fold is
# reported at the variant, and the variant then takes its positional number so the rest of the
# enum still has a shape to be checked against — one bad discriminant should be one finding,
# not one per variant after it.
fn c_build_enums(mut &em: Emitter, f: ast.File) {
	mut i := 0
	for i < f.enums.len() {
		ed := f.enums[i]
		c_ty_register(em, ed.name, TK_ENUM, ast.Ty.TUnknown, ed.path, ed.is_pub)

		mut next := 0
		mut taken: list[int] = []
		mut j := 0
		for j < ed.variants.len() {
			v := ed.variants[j]
			mut tag := next
			if v.has_discr {
				fv := check.chk_const_eval(em, v.discr)
				if fv.ok {
					tag = fv.value
				} else {
					check.chk_at_place(em, ed.path, v.line, v.col, rule.Rule.DiscriminantNotConstant, f"the discriminant of `{ed.name}.{v.name}` is not a compile-time constant — GRAMMAR#variant gives the position a const-expr, which is literals, other compile-time constants and the operators over them, and no function calls")
				}
			}
			raise c_diag_at(ed.path, v.line, v.col, rule.Rule.EnumDiscriminantRepeated, f"an enum discriminant is distinct across variants, and `{v.name} = {tag}` repeats one already given") if c_tag_taken(taken, tag)
			taken.append(tag)
			next = tag + 1
			em.var_name.append(v.name)
			em.var_enum.append(ed.name)
			em.var_tag.append(tag)
			mut k := 0
			for k < v.fields.len() {
				em.vf_enum.append(ed.name)
				em.vf_variant.append(v.name)
				em.vf_index.append(k)

				# a field whose type is the enclosing enum is boxed into a refcounted cell
				# (void*), whose drop is the enum's own — c_refbox_helpers
				em.vf_boxed.append(c_named_of(v.fields[k]) == ed.name)
				em.vf_ty.append(v.fields[k])
				k = k + 1
			}
			j = j + 1
		}
		i = i + 1
	}
}

# c_tag_taken is whether a discriminant has already been handed out inside the enum being
# built. It walks the values COLLECTED SO FAR rather than em.var_tag, which holds every
# variant of every enum in the program and would call `B.X = 0` a repeat of `A.Y = 0`.
fn c_tag_taken(taken: list[int], tag: int) -> bool {
	for t in taken {
		return true if t == tag
	}
	return false
}

# c_is_flat_enum reports whether a name is a declared enum whose every variant is tag-only.
# That is the enum GRAMMAR#variant gives an observable integer value to — `int(v)` reads it and
# `E.of(n)` reverses it; a payload enum's tag is opaque and match-only.
#
# It is read off the tables already there rather than recorded beside the name: vf_enum /
# vf_variant hold exactly the variants that HAVE a payload field, so an enum is flat when
# none of its variants is in them.
fn c_is_flat_enum(mut &em: Emitter, en: str) -> bool {
	return false if not c_is_enum_name(em, en)

	mut i := 0
	for i < em.vf_variant.len() {
		return false if em.vf_enum[i] == en
		i = i + 1
	}
	return true
}

# c_is_boxed reports whether payload field `idx` of `en`'s variant `variant` is a ref-boxed
# (self-recursive) field.
#
# THE ENUM IS PART OF THE QUESTION, and it is the parameter every reader of this table gained
# at once: a payload row is a row about a variant of ONE enum, and a lookup by the bare name
# answered from whichever enum declared that name first. Two enums that each carry a
# `Node(int)` shared one row — one type, one arity, one boxedness — and the second enum's
# constructor wrote the first enum's union member.
fn c_is_boxed(mut &em: Emitter, en: str, variant: str, idx: int) -> bool {
	mut i := 0
	for i < em.vf_variant.len() {
		return em.vf_boxed[i] if em.vf_enum[i] == en and em.vf_variant[i] == variant and em.vf_index[i] == idx
		i = i + 1
	}
	return false
}

fn c_variant_field_ty(mut &em: Emitter, en: str, variant: str, idx: int) -> ast.Ty {
	mut i := 0
	for i < em.vf_variant.len() {
		return em.vf_ty[i] if em.vf_enum[i] == en and em.vf_variant[i] == variant and em.vf_index[i] == idx
		i = i + 1
	}
	return ast.Ty.TUnknown
}

# c_bind_env registers an arm's pattern bindings in the variable environment with the types
# they hold, so type inference inside the arm resolves them.
#
# A NAME PATTERN BINDS TOO (GRAMMAR#binding-pat), and it was the one shape this did not
# register. `match n { x => x }` therefore typed its arm body from a name nothing in the
# environment answered for, and the whole match came back TUnknown — so `w := match n { x
# => x }` declared `w` with no type, `c_is_bound` reads exactly that as "nothing bound it",
# and the only finding was `undefined name` on the NEXT line, about a name the reader can
# see being bound. `=> x * 1` escaped it by inferring from the literal instead, which is
# what made the shape look arbitrary. A bind arm holds the SCRUTINEE's own type, which is
# the same thing c_arm_subst splices in as text one function along.
fn c_bind_env(mut &em: Emitter, a: ast.Arm, st: ast.Ty) {
	if a.pat == 1 {
		c_add_var(em, a.bind, st, false, false)
	} else if a.pat == 3 and c_is_either(st) {
		# an Either's sides are not in the variant table: they are the TYPE's own two, so the
		# binding takes whichever the pattern names. Answering `Err` for every Right is what a
		# Result-shaped assumption looks like — a `Right(b)` over an `Either[A, B]` then had
		# type Err, and `b.s` reached cc as an unmangled member of the wrong struct.
		if a.binds.len() > 0 {
			if c_result_tag(em, a.ctor) == 0 {
				c_add_var(em, a.binds[0], c_either_left(st), false, false)
			} else {
				c_add_var(em, a.binds[0], c_either_right(st), false, false)
			}
		}
	} else if a.pat == 3 {
		# the SCRUTINEE'S enum names the variant: a constructor pattern is written inside a
		# match on a value, so which enum's `Circle` this is was never in doubt — the table
		# was what could not say it
		en := c_named_of(st)
		mut i := 0
		for i < a.binds.len() {
			c_add_var(em, a.binds[i], c_variant_field_ty(em, en, a.ctor, i), false, false)
			i = i + 1
		}
	}
}

# c_needs_runtime reports whether any enum has a boxed field, so the translation unit
# must include and link the runtime.
fn c_needs_runtime(mut &em: Emitter) -> bool {
	mut i := 0
	for i < em.vf_boxed.len() {
		return true if em.vf_boxed[i]
		i = i + 1
	}
	return false
}

# c_qualified_variant answers the enum name when `target.fld` is `Enum.Variant`, and "" for
# every other field access. The variant has to belong to THAT enum: `Color.Apple` names a
# variant of another one, and answering it would make the qualification decorative.
fn c_qualified_variant(mut &em: Emitter, target: ast.Expr, fld: str) -> str {
	en := c_ident_name(target)

	return "" if en == "" or not c_is_enum_name(em, en)
	return "" if not c_is_variant_in(em, en, fld)

	return en
}

# --- namespaces ---------------------------------------------------------------------
#
# AN `import` BINDS A NAMESPACE (GRAMMAR#import-stmt), and until now the binding was not a
# thing this compiler had. Every qualified name was resolved by DROPPING its qualifier and
# looking the last identifier up in the one flattened program — so `bogus.text.shout(…)`
# and `util.shout(…)` compiled and ran beside the `text.shout(…)` the file had actually
# imported, because nothing anywhere asked what `bogus` or `util` named. A prefix nobody
# reads is not a namespace; it is punctuation.
#
# What follows is the ONE reading of those bindings. Every shape of qualified name — a
# member READ (c_fieldref, c_field_ty_of), a namespaced CALL (c_free_method), and the
# callee of a `spawn` / `defer` (c_callee_raw) — asks c_ns_kind and nothing else. They were
# three separate resolutions before, which is why they disagreed: one consulted a table of
# module names, and the other two consulted nothing at all.

# c_build_namespaces fills the binding rows from the program's imports, honouring `as`.
#
# The names are the WHOLE program's, not this module's, which is the documented flatten
# (docs/runtime/package.md): a module the build reaches at all is one every module can
# name. A duplicate is dropped rather than added twice — a module imported by two files is
# the ordinary case, and it costs nothing to keep the set a set.
fn c_build_namespaces(mut &em: Emitter, f: ast.File) {
	for im in f.imports {
		# `im.at` IS THE BINDING'S SCOPE, and it used to be reduced to that file's directory.
		# A binding belongs to the FILE that wrote it: a module's files sharing one namespace
		# meant an `import "strings"` in one of them put `strings` in every sibling's scope,
		# so a file could name something it never asked for and a sibling's private helper
		# could collide with a stdlib name it had no idea was in the room.
		#
		# A pair already recorded is still dropped — a file may write the same import twice
		# only by writing it twice, and the parser already refuses that.
		here := im.at
		if not c_ns_bound_in(em, im.name, here) {
			em.ns_names.append(im.name)
			em.ns_at.append(here)
			em.ns_mods.append(c_imp_canon(em, im.at, im.path))
			em.ns_pub.append(im.is_pub)
		}
	}
}

# c_imp_canon is the module identity an import named, looked up in the loader's answer rather
# than computed here. It falls back to the written path for an import the table does not hold —
# a synthetic tree, or a build that handed no resolutions — which is the behaviour every rule
# had before the table existed.
fn c_imp_canon(mut &em: Emitter, at: str, path: str) -> str {
	mut i := 0
	for i < em.imp_at.len() {
		return em.imp_mod[i] if em.imp_at[i] == at and em.imp_path[i] == path

		i = i + 1
	}
	return path
}

# c_is_ns is whether an import ANYWHERE IN THE BUILD bound this name as a namespace. It is
# still the whole-build question, and it is still the right one to ask first: it is what
# tells a real module from a typo, and that distinction does not depend on who is asking.
pub fn c_is_ns(mut &em: Emitter, n: str) -> bool {
	for nm in em.ns_names {
		return true if nm == n
	}
	return false
}

# c_ns_bound_in is the SAME QUESTION ASKED BY A MODULE — did THIS module import it. The two
# are deliberately separate calls rather than one with a flag, because the answers mean
# different things and the callers act on them differently: `c_is_ns` says the name is not a
# typo, and this says the module is allowed to write it.
#
# An UNKNOWN reader module answers yes. No marker covers the code being emitted before the
# first statement of the first function, and a rule that guessed there would refuse a
# program for a reason nothing on the page explains — the silence chk_visible has always
# kept for the same case.
pub fn c_ns_bound_in(mut &em: Emitter, n: str, here: str) -> bool {
	return true if here == ""

	mut i := 0
	for i < em.ns_names.len() {
		return true if em.ns_names[i] == n and em.ns_at[i] == here
		i = i + 1
	}
	return false
}

# c_ns_names_mod is whether the prefix `n`, AS THIS MODULE READS IT, names the module a
# declaration came from. It is the question `b.helper()` was never asked.
#
# THE COMPARISON IS LITERAL, and it is only possible since #36: a module's identity is the
# import path it was reached by, so `ns_mods` (what the import wrote) and `c_mod_of` (what
# the loader recorded) are the same string for the same module. While identity was a
# DIRECTORY there was nothing here to compare against.
#
# QUIET WHEN THE READER IS UNKNOWN, and quiet when this module bound the name to nothing —
# the first is the silence chk_visible keeps for code emitted before any statement, and the
# second is `chk_ns_bound`'s finding rather than this one's. A rule that spoke in either case
# would report a program twice for one mistake.
pub fn c_ns_names_mod(mut &em: Emitter, n: str, decl_mod: str) -> bool {
	return true if decl_mod == ""

	here := em.at_path
	return true if here == ""

	mut bound := false
	mut i := 0
	for i < em.ns_names.len() {
		if em.ns_names[i] == n and em.ns_at[i] == here {
			bound = true
			return true if em.ns_mods[i] == decl_mod

			# OR THE MODULE RE-EXPORTS IT. `mid` writing `import pub "./deep"` puts `deep`'s
			# public names on `mid`'s surface, so `mid.hello()` is `deep`'s `hello` and is
			# not a mistake (docs/runtime/package.md, and `examples/1g/reexport`).
			return true if c_ns_reexports(em, em.ns_mods[i], decl_mod, 0)
		}
		i = i + 1
	}
	return not bound
}

# c_ns_reexports is whether module `mod` puts module `want`'s surface on its own — directly,
# or through a chain of re-exports, since `import pub` is exactly the statement that another
# module's public names are now this one's.
#
# BOUNDED, because a re-export chain is data and this walk is recursion. Eight is far past any
# real surface and the import graph is a DAG anyway (E5014); the bound is here so that a bug in
# the graph is a wrong answer rather than a dead compiler.
fn c_ns_reexports(mut &em: Emitter, mod: str, want: str, depth: int) -> bool {
	return false if depth > 8

	# THE ROW'S SCOPE IS A FILE and the question is about a MODULE, so the two are compared
	# through `c_mod_of`. A binding belongs to the file that wrote it; a SURFACE belongs to the
	# module — `import pub` in any one of a module's files puts the named module on that
	# module's surface, which is what a dependent sees.
	mut i := 0
	for i < em.ns_names.len() {
		if em.ns_pub[i] and check.c_mod_of(em, em.ns_at[i]) == mod {
			return true if em.ns_mods[i] == want
			return true if c_ns_reexports(em, em.ns_mods[i], want, depth + 1)
		}
		i = i + 1
	}
	return false
}

# c_ns_owns_fn is c_ns_names_mod for a FUNCTION, and it exists so the three shapes that can
# write a namespaced call — an ordinary one, a `spawn`, a `defer` — ask it in one spelling.
# c_ns_declares_fn is the POSITIVE question `c_ns_owns_fn` is not: does module `ns` declare a
# FUNCTION of this name. The one below answers true when no signature row exists at all — it is
# asked of a name already known to be a function — and asking it about a name that might be
# anything reported a module constant, and a member that is not there, as functions.
fn c_ns_declares_fn(mut &em: Emitter, ns: str, name: str) -> bool {
	r := c_sig_row_of(em, name)
	return false if r < 0

	return c_ns_names_mod(em, ns, em.sig_mod[r])
}

fn c_ns_owns_fn(mut &em: Emitter, ns: str, name: str) -> bool {
	r := c_sig_row_of(em, name)
	return true if r < 0

	return c_ns_names_mod(em, ns, em.sig_mod[r])
}

# NsKind is WHAT THE PREFIX OF A QUALIFIED NAME TURNED OUT TO BE. Three answers and not
# two, because "not a namespace" covers two situations a caller has to tell apart:
#
#   NsNone     the prefix is not a qualifier at all — a bound value, a type, an enum, a
#              variant, or an expression that is not a chain of names (`xs[0].len()`).
#              Whatever it is, the ordinary value path answers for it.
#   NsModule   a namespace binding: the member is looked for in the modules.
#   NsUnknown  a chain whose ROOT name nothing in the program bound. This is the whole of
#              what an invented prefix was — a name, in the one position where names were
#              never resolved — and it is an undefined name like any other.
#[derive(Eq)]
enum NsKind {
	NsNone
	NsModule
	NsUnknown
}

# c_ns_root is the name a `.`-CHAIN STARTS FROM — `bogus` for `bogus`, and for `bogus.text`.
# It is the root and not the immediate target because a namespace qualifier is ONE
# identifier (GRAMMAR#import-stmt): in `bogus.text.shout(…)` the `.shout` is applied to the
# field read `bogus.text`, so the name that has to be bound for any of it to mean something
# is `bogus`. A chain that bottoms out in anything else — a call, an index, a literal — has
# no root name and is a value.
fn c_ns_root(e: ast.Expr) -> str {
	n := c_ident_name(e)
	return n if n != ""

	return match e {
		Expr.EField(x, _) => c_ns_root(x)
		_ => ""
	}
}

# c_ns_kind is THE QUESTION A QUALIFIED NAME ASKS ABOUT ITS PREFIX, decided once so that a
# member read and a call cannot answer it differently — which they did, the read consulting
# a table of module names and the call consulting nothing.
#
# It is SILENT: it decides, and the caller reports, because one of the callers (c_field_ty_of)
# is asking what an expression's type is rather than judging it, and a rule that fires from
# inside inference fires as many times as inference runs.
fn c_ns_kind(mut &em: Emitter, target: ast.Expr) -> NsKind {
	n := c_ns_root(target)
	return NsKind.NsNone if n == ""

	if c_is_ns(em, n) {
		# a namespace, and the qualifier is the identifier ITSELF: `text.SIGN.len()` reads a
		# member and then calls a method on the value it is, which is the field path's
		# business and not a namespaced call
		return NsKind.NsModule if c_ident_name(target) != ""
		return NsKind.NsNone
	}

	# a binding, a struct, an enum or a variant answers for its own `.` — a field, an
	# associated name, a variant. None is a namespace, and none is undefined either.
	return NsKind.NsNone if c_is_bound(em, n) or c_is_struct_name(em, n) or c_is_enum_name(em, n) or c_is_variant(em, n)

	return NsKind.NsUnknown
}

# --- a module-qualified TYPE name ----------------------------------------------------
#
# A TYPE NAME IS ALSO ITS CONSTRUCTOR (GRAMMAR group 7's CONSTRUCTION note), and reaching
# the type through an `import` used to buy only half of that. `GRAMMAR#base-type` derives
# `type-name type-args? ('.' identifier)*`, so `lib.Point` is a type wherever a type is
# wanted — and parse_base_type has read it that way since it was written, by DROPPING the
# qualifier: every module of a program flattens into one scope (docs/runtime/package.md), so
# the qualifier says where the type came from and the last segment IS the name.
#
# The VALUE position never learned it. `p: lib.Point = lib.Point(1, 2)` was accepted on the
# left of the `=` and refused on the right, in one line, with `E3084 module `lib` has no
# `Point`` — a sentence that is false, since the module declares exactly that. What each
# qualified path asked was narrower than the rule: the CALL path asked only whether the last
# segment named a function, and the FIELD path only whether it named a constant, so a type
# was a member neither of them could see. `lib.Color.Red` and an `as` alias went the same
# way, and `lib.make()` beside them worked, which is what made it read as a namespace bug
# rather than a missing rule.
#
# It is fixed as a REWRITE and not as a fifth branch per path, because there is one rule
# here and four shapes that would have had to spell it: a construction, a variant read, an
# enum's `of`, and the inference half of each. Dropping the qualifier turns every one of
# them into the unqualified form the compiler already lowers correctly, so nothing below
# this point knows a qualifier was involved — which is precisely the arrangement the TYPE
# position has always had.
#
# WHICH module answers is the flatten's business and not this rule's: `b.Point` resolves a
# `Point` module `a` declared, exactly as `b.COUNT` resolves a constant `a` declared. That
# is the documented deviation (docs/runtime/package.md), and it is one deviation rather than
# two.
fn c_ns_unqualify(mut &em: Emitter, e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EField(t, f) => c_ns_unqualify_field(em, t, f)
		Expr.EMethod(t, m, args) => c_ns_unqualify_meth(em, t, m, args)
		_ => e
	}
}

# c_ns_unqualify_field is `lib.Point` read as a value — the prefix of `lib.Color.Red`, and
# the whole of `lib.Color` in `lib.Color.of(n)`. The target is rewritten too when the pair
# is not one, because the qualifier sits at the ROOT of a `.`-chain and the segment that
# names the type may be anywhere along it.
fn c_ns_unqualify_field(mut &em: Emitter, t: ast.Expr, f: str) -> ast.Expr {
	if c_ns_names_type(em, t, f) {
		# THE QUALIFIER IS ABOUT TO BE DROPPED, so this is the last point that knows one was
		# written. `lib.Colour.Red` names a real module and a real type, and whether THIS
		# module may write that name is a separate question from whether the name resolves —
		# the same pairing the call and the member-read paths already ask.
		check.chk_ns_bound(em, c_ns_root(t))
		return ast.Expr.EIdent(f)
	}

	return ast.Expr.EField(c_ns_unqualify(em, t), f)
}

# c_ns_unqualify_meth is `lib.Point(1, 2)` — a CONSTRUCTION, which is a call whose callee is
# a type name and so becomes the ECall the unqualified spelling parses to.
fn c_ns_unqualify_meth(mut &em: Emitter, t: ast.Expr, m: str, args: list[ast.Expr]) -> ast.Expr {
	if c_ns_names_type(em, t, m) {
		# `lib.Counter("a")` — a CONSTRUCTION through a namespace, the field path's question
		# one node up
		check.chk_ns_bound(em, c_ns_root(t))
		mut none: list[ast.Ty] = []
		return ast.Expr.ECall(m, args, none)
	}

	return ast.Expr.EMethod(c_ns_unqualify(em, t), m, args)
}

# c_ns_names_type is the pair this rule is about: a MODULE qualifier, and a segment that
# names a type the program declares. Both halves are required. Without the first an invented
# prefix would resolve — `bogus.Point(1, 2)` is an undefined name and stays one — and
# without the second a genuine missing member would stop being reported, which is the rule
# E3084 is for.
fn c_ns_names_type(mut &em: Emitter, t: ast.Expr, member: str) -> bool {
	return false if c_ns_kind(em, t) != NsKind.NsModule
	return false if not c_is_struct_name(em, member) and not c_is_enum_name(em, member) and not c_is_typedef(em, member)

	# AND THE MODULE THAT DECLARES IT IS THE ONE THE PREFIX NAMES, which is the same rule the
	# call and the constant paths ask — `b.Box(1)` resolved a `Box` module `a` declared and
	# constructed it. Answering false here hands the pair back to the ordinary field path,
	# which reports it as the member `b` has not got.
	return c_ns_names_mod(em, c_ns_root(t), c_ty_mod(em, member))
}

# c_undefined_name is THE report of a name nothing in the program bound, and it is one
# function because it is one rule. It is reached from two shapes — a name read on its own
# (c_ident_val) and the invented prefix of a qualified one (c_free_method, c_callee_raw) —
# and those are the same finding: `bogus` in `bogus.f()` is an undefined name, and the only
# reason it never read as one is that the expression around it threw it away before anything
# looked. The seed has said exactly that all along.
pub fn c_undefined_name(mut &em: Emitter, n: str) {
	check.chk_at(em, rule.Rule.UndefinedName, f"undefined name `{n}`")
}

# c_undefined_fn is the same finding one position along — a name in CALLEE position that
# nothing declares — and it is one function for the same reason c_undefined_name is one.
#
# Two shapes reach it: an ordinary call (c_call), and a `spawn` or `defer` callee
# (c_chk_callable), which used to reach nothing at all and spelled `zg_<name>()` into its
# thunk for cc to report. A code is an identity, so the two sites answer with the ONE rule
# rather than with two copies of its sentence — which is also what the catalogue's
# reported-once gate holds this file to.
#
# The built-in check comes first here rather than at each caller: a documented built-in this
# compiler has not built is not a typo, and telling a reader "undefined function `sizeof`"
# says the language lacks a form its own documentation describes.
fn c_undefined_fn(mut &em: Emitter, n: str) {
	c_builtin_check(em, n)

	raise c_diag(em, rule.Rule.UndefinedFunction, f"undefined function `{n}`")
}

# c_not_callable is the rule that A BINDING SHADOWS THE FUNCTION OF ITS NAME even when it
# holds something that cannot be called. The innermost binding wins, which is the language's
# shadowing rule — so this is not a collision to report but a call that cannot happen, and
# the sentence says what the name holds.
#
# REPORTED rather than raised, so it carries the place every checked rule does: it is a
# statement about a program the language rejects, not a form this compiler has not built.
# Both callers carry on afterwards and the C they emit is thrown away.
fn c_not_callable(mut &em: Emitter, n: str, bt: ast.Ty) {
	check.chk_at(em, rule.Rule.NotCallable, f"`{n}` holds an {ast.ty_name(bt)}, and an {ast.ty_name(bt)} is not callable — the innermost binding wins, so the `{n}` in scope here is that value and not the function of the same name")
}

# c_bare_variant is the rule that a variant is NEVER A NAME ON ITS OWN (GRAMMAR group 7's
# CONSTRUCTION note): an enum puts its own name into the value namespace and not its
# variants', so `Color.Red` and never `Red`. That is what keeps two enums that both declare
# a `Red` from competing for it — and what stops an enum GAINING a variant from taking a
# name a program was already using for something else.
#
# It is one function because it is one rule: the value position and the call position are
# the same mistake, and a code answers to a rule rather than to a site.
#
# `Left` and `Right` are not reached here. They are the two constructors this compiler reads
# by NAME rather than by resolving them, because they are context-typed — no type of their
# own, taking the one the position wants — so they are not in the variant table at all. Both
# spellings work; requiring the qualified one is a separate decision about a built-in's
# documented surface (docs/code/errors.md).
fn c_bare_variant(mut &em: Emitter, name: str) {
	check.chk_at(em, rule.Rule.VariantNamedBare, f"`{name}` is a variant of `{c_variant_enum(em, name)}`, and a variant is named through its enum — write `{c_variant_enum(em, name)}.{name}`")
}

# c_var_row is THE variant lookup BY BARE NAME. `var_name` / `var_enum` / `var_tag` are one
# table in three columns, and each of the three readers below used to walk it itself — the
# shape this file already criticises at the signature table, where a column-per-reader pair
# walked the rows twice per call site.
#
# It matters more than the walk it saves: three scans are three chances for the answers to
# disagree about which row they meant. They cannot now, because there is one row.
#
# A BARE NAME IS AMBIGUOUS BY CONSTRUCTION and this answers the FIRST enum that declares it,
# which is all a bare name can mean. That is enough for the two questions asked of it — "is
# this name a variant of anything" and "which enum should the reader have written" (E3079,
# c_bare_variant) — and it is not enough for anything else. Every question about a variant a
# spelling has already NAMED THE ENUM of goes to c_var_row_in below.
fn c_var_row(mut &em: Emitter, name: str) -> int {
	mut i := 0
	for i < em.var_name.len() {
		return i if em.var_name[i] == name
		i = i + 1
	}
	return -1
}

# c_var_row_in is that lookup INSIDE ONE ENUM, and it is what a variant name means: docs/core/
# types.md makes an enum a value namespace, so `Red` is a name in `Colour` and another name in
# `Signal`, and the two are different variants that happen to be spelled alike.
#
# The flat table could not say that. `Signal.Red` asked which enum owns the bare `Red`, got
# `Colour` — the first declaration, program-wide — and was refused with a sentence that was
# false about the program it was reporting on. The second enum's variant was unreachable and
# the enum itself unusable. The seed has resolved it per-enum since it had enums
# (enumVariantSym in infer.go), which is what makes this a rule `zerg` LOST rather than one
# nobody wrote.
fn c_var_row_in(mut &em: Emitter, en: str, name: str) -> int {
	mut i := 0
	for i < em.var_name.len() {
		return i if em.var_name[i] == name and em.var_enum[i] == en
		i = i + 1
	}
	return -1
}

fn c_is_variant(mut &em: Emitter, name: str) -> bool {
	return c_var_row(em, name) >= 0
}

fn c_is_variant_in(mut &em: Emitter, en: str, name: str) -> bool {
	return c_var_row_in(em, en, name) >= 0
}

fn c_variant_tag_in(mut &em: Emitter, en: str, name: str) -> int {
	r := c_var_row_in(em, en, name)
	return 0 if r < 0

	return em.var_tag[r]
}

fn c_variant_enum(mut &em: Emitter, name: str) -> str {
	r := c_var_row(em, name)
	return "" if r < 0

	return em.var_enum[r]
}

fn c_variant_tag(mut &em: Emitter, name: str) -> int {
	r := c_var_row(em, name)
	return 0 if r < 0

	return em.var_tag[r]
}

# c_enum_typedef emits an enum as a C tagged union: an int32 tag plus a union of the
# payload-carrying variants (omitted when every variant is tag-only).
fn c_enum_typedef(ed: ast.EnumDecl) -> str {
	mut out := "typedef struct {\n    int32_t tag;\n"
	mut anyf := false
	mut i := 0
	for i < ed.variants.len() {
		if ed.variants[i].fields.len() > 0 {
			anyf = true
		}
		i = i + 1
	}
	if anyf {
		out = out + "    union {\n"
		i = 0
		for i < ed.variants.len() {
			v := ed.variants[i]
			if v.fields.len() > 0 {
				out = out + "        struct { "
				mut j := 0
				for j < v.fields.len() {
					# a self-recursive field is a ref-box (void*), else its value type
					mut ct := c_type(v.fields[j])
					if c_named_of(v.fields[j]) == ed.name {
						ct = "void*"
					}
					out = out + ct + " f" + strconv.to_string(j, 10) + "; "
					j = j + 1
				}
				out = out + "} " + v.name + ";\n"
			}
			i = i + 1
		}
		out = out + "    } u;\n"
	}
	return out + "} zg_" + ed.name + ";\n\n"
}

# c_refbox_helpers emits, for an enum with self-recursive fields, the cell's drop and a
# refnew that boxes a value into it.
#
# The drop used to be a NO-OP — `zg_noopdrop_<E>` — and that single function was the whole
# of the leak docs/core/memory.md described: the cell was refcounted, every holder retained
# and released it correctly, and when the count reached zero the runtime called something
# that did nothing, so the boxed value's own payload was never given back and neither was
# the next cell in the chain. Now it runs the enum's drop, which releases the next cell,
# which drops in turn — a chain frees at its last holder's scope exit, as written.
#
# WHICH RECURSES, ONE C FRAME PER NODE. A chain longer than the native stack now overflows
# where before it completed, because before, nothing was freed. That is a real regression
# and it is written down in the marker rather than hidden; an iterative drop is a separate cut.
fn c_refbox_helpers(ed: ast.EnumDecl) -> str {
	mut anybox := false
	mut i := 0
	for i < ed.variants.len() {
		v := ed.variants[i]
		mut j := 0
		for j < v.fields.len() {
			if c_named_of(v.fields[j]) == ed.name {
				anybox = true
			}
			j = j + 1
		}
		i = i + 1
	}
	return "" if not anybox
	nm := ed.name
	mut out := "static void zg_dropbox_" + nm + "(void* p) { zg_drop_" + nm + "((zg_" + nm + "*)p); }\n"
	out = out + "static void* zg_refnew_" + nm + "(zg_" + nm + " v) {\n"
	out = out + "    void* r = zrt_ref_alloc(sizeof(zg_" + nm + "), &zg_dropbox_" + nm + ");\n"
	out = out + "    *(zg_" + nm + "*)zrt_ref_payload(r) = v;\n"
	out = out + "    return r;\n}\n\n"
	return out
}

# --- operators -----------------------------------------------------------------

# c_binop maps a Zerg binary operator spelling to its C form. The WRAPPING operators are the
# ones that need care: `+%` is a plain C `+`, and a plain C `+` on two signed operands is
# UNDEFINED on overflow — which is the one input `+%` exists for. It gave the right answer at
# -O2 on clang today and is exactly the construct a compiler is allowed to assume never
# happens; UBSan says so out loud. They go through c_wrap_fn instead, where the arithmetic is
# done on the unsigned bit pattern — the operation `+%` actually names — and cast back.
fn c_binop(oper: str) -> str {
	return "&&" if oper == "and"
	return "||" if oper == "or"

	return oper
}

# c_wrap_fn names the runtime helper for a `%`-suffixed operator, or "" for one that is not
# wrapping. It is beside c_arith_fn on purpose: those two are the two halves of every
# arithmetic operator the language has, and a spelling missing from both is a bare C operator.
fn c_wrap_fn(oper: str) -> str {
	return "zrt_wrap_add" if oper == "+%"
	return "zrt_wrap_sub" if oper == "-%"
	return "zrt_wrap_mul" if oper == "*%"

	return ""
}

fn c_unop(oper: str) -> str {
	return "!" if oper == "not"
	return "-" if oper == "-%"

	return oper
}

# --- integer literal normalisation ---------------------------------------------

# c_int_dec renders an integer lexeme (decimal / 0x / 0o / 0b, with '_' groups) as a
# plain decimal string, matching how the bootstrap lowers integer literals. What a lexeme is
# WORTH is a lexical fact and lives with the lexer, so the formatter can ask the same question
# without a second implementation of it (F408 needs it to tell `1 | 2` from `1 | 3`).
# c_str_lit renders a Zerg str as a C string literal, escaping every byte outside
# printable ASCII as a THREE-DIGIT OCTAL escape.
#
# Not `\xHH`, which is what `quote` (lexer.zg) emits for the token dump: C's hex escape
# consumes as many hex digits as follow it, with no two-digit limit, so `"aéb"` came out as
# `"a\xc3\xa9b"` and cc read `\xa9b` as one escape — "hex escape sequence out of range",
# a build that fails on a string a reader would call ordinary. An octal escape is at most
# three digits, so `\303\251b` cannot run on. The seed has emitted octal all along.
# c_str_cell renders a str LITERAL as the managed-str value every other str now is: the
# payload of a cell, not a bare `char*`.
#
# It has to be, because a release cannot ask what it is holding. A managed str is a pointer
# INTO `[zrt_ref_hdr | bytes]` and giving one back means stepping back one header — which on
# a plain C literal reads whatever the linker put in front of the string. Nothing at runtime
# tells the two apart, so either every str is a cell or none can ever be freed. That is the
# row src/compiler/README.md calls a representation change rather than more emitted code.
#
# The cell is `static` and IMMORTAL: file lifetime, so the statement expression's value
# outlives it nowhere, and a refcount zrt_retain/zrt_release both no-op on, so a literal
# flows through retain, release and comparison exactly as a heap string does. The seed has
# emitted this shape since S2 (emit_str.go, strLiteral); this is the same cell.
fn c_str_cell(mut &em: Emitter, s: str) -> str {
	em.used_rt = true
	nm := c_tmp(em, "zgt_sl")

	# C counts DECODED bytes, so the array is sized from the value and not from the escaped
	# spelling c_str_lit produces
	n := bytearray(s).len() + 1
	return f"({{ static struct {{ zrt_ref_hdr h; char b[{n}]; }} {nm} = {{{{ZRT_RC_IMMORTAL, NULL}}, {c_str_lit(s)}}}; (const char *)zrt_ref_payload(&{nm}); }})"
}

fn c_str_lit(s: str) -> str {
	mut out: list[byte] = []
	out.append(byte(34)) # "
	for c in bytearray(s) {
		v := int(c)
		if v == 34 {
			out.append(byte(92))
			out.append(byte(34))
		} else if v == 92 {
			out.append(byte(92))
			out.append(byte(92))
		} else if v == 10 {
			out.append(byte(92))
			out.append(b'n')
		} else if v == 9 {
			out.append(byte(92))
			out.append(b't')
		} else if v == 13 {
			out.append(byte(92))
			out.append(b'r')
		} else if v >= 32 and v <= 126 {
			out.append(c)
		} else {
			out.append(byte(92))
			out.append(byte(48 + v / 64))
			out.append(byte(48 + v / 8 % 8))
			out.append(byte(48 + v % 8))
		}
	}
	out.append(byte(34)) # "
	return str(out)
}

fn c_int_dec(mut &em: Emitter, lex: str) -> str {
	check.chk_int_literal(em, lex)

	return strconv.to_string(lexer.int_value(lex), 10)
}

# c_float_dec is c_int_dec's other half: it takes the DIGIT SEPARATORS out of a float's
# surface lexeme, so what reaches C is a C float constant.
#
# A literal node keeps the lexeme it was written as (ast.zg's literal-surface invariant), so
# `zerg fmt` can put a number back exactly as the author typed it. That is the AST's job and
# not the emitter's, and the emitter handed that surface straight to cc — an int normalised
# through c_int_dec, a float verbatim. `1_0.5` reached clang as `1_0.5` and it reported
# `invalid suffix '_0.5' on integer constant`: against generated source, for a separator the
# lexer had deliberately accepted.
fn c_float_dec(lex: str) -> str {
	b := bytearray(lex)
	mut out: list[byte] = []
	for ch in b {
		if ch != b'_' {
			out.append(ch)
		}
	}
	return str(out)
}

fn c_bool(b: bool) -> str {
	return "true" if b
	return "false"
}

# --- expression emission -------------------------------------------------------

# c_deeper takes one level of the expression walk, and refuses the program once the budget
# is spent — BEFORE the recursion happens, so the stack the refusal is reported from is a
# healthy one. The budget is ZG_MAX_NESTING, the parser's own.
#
# It is not defence in depth. p_expr_root bounds every tree the parser BUILDS, so no
# WRITTEN expression reaches this walk deeper than the budget — but the emitter does not
# only walk written trees, it COMPOSES them, and a composed one is deeper than either half.
# A default parameter is spliced into every call that omits it (c_defaults_from), so a
# 190-term default backfilled into a 190-term call is a 380-level walk that no source
# expression states. This counter is the ONLY thing that bounds a composed tree, which is
# why the two are not one rule at two altitudes:
#
#   p_expr_root  — the tree as WRITTEN, refused where it is built, so lint, lsp and
#                  monomorphization inherit the bound without a counter of their own.
#   c_deeper     — the tree as WALKED, which is what the native stack actually pays for.
#
# The second was once the only one, and the arrangement held only for as long as every walk
# running BEFORE the emitter remembered to count too. Monomorphization did not, and a
# 400-term chain in a template some call instantiated died of SIGSEGV with nothing on
# stderr. That is what p_expr_root fixed; it did not make this one redundant.
#
# The exits are balanced by the two wrappers below and nowhere else: every recursive
# entry into an expression goes through c_expr or c_infer, so the pair is the natural
# chokepoint, and a raise abandons the walk entirely so a skipped decrement can never be
# observed by a later statement. Both halves have a name (c_shallower) so both are
# greppable; an increment that answers to a name and a decrement that does not is how the
# two come to be in different numbers.
fn c_deeper(mut &em: Emitter) {
	em.depth = em.depth + 1
	return if em.depth <= ZG_MAX_NESTING

	raise c_diag(em, rule.Rule.ChainTooDeep, f"this expression chains more than {strconv.to_string(ZG_MAX_NESTING, 10)} levels deep — a translation limit of this compiler (docs/conformance.md): its emitter and checker recurse once per operator, call or method link, and refusing here is what a recursive walk can still say before the native stack it runs on overflows without a word")
}

# --- the emitter's reporting channel ------------------------------------------------------
#
# EVERY REFUSAL RAISED HERE GOES THROUGH c_diag OR c_diag_at, and this is the third and last
# stage to be given one. `check.zg` has chk_at / chk_at_place, `parser.zg` has p_diag /
# p_diag_at, and these two are deliberately the same pair: the general one reads the place the
# walk is standing on, the `_at` one takes a place the caller knows, and the general one is
# written in terms of the other so the layout is stated once.
#
# THE CODE IS AN ARGUMENT, for the reason chk_at's comment gives: this compiler diagnoses its
# own arity, so a rule added without a code does not compile. Spelled into the message instead
# it is a convention, and a convention is what 50 of these 126 sites had already drifted out
# of — half the emitter's refusals said which rule fired and half said only what was wrong.
#
# THE FORCED DIFFERENCE FROM check.zg IS THE SAME ONE THE PARSER HIT, and it is worth naming
# because it is why these return a string instead of recording one. A checked rule records a
# Diag and lets emission carry on, so a file with three mistakes reports three; a refusal ENDS
# the run, and after it there is no half-lowered C worth walking. So these BUILD the message
# and the site `raise`s it — which also keeps the `raise` where the reader is, since a call
# that raises is not a diverge this compiler can see (a function ending in one still owes its
# answer, E3032) and a third of these sites are the postfix `raise … if c` guard, a statement
# form and not a call.
#
# scripts/error-codes-check.sh holds the file to it by the same assertion it holds parser.zg
# to: no `raise` in either file takes a string LITERAL. What that does and does not catch is
# written out there, and it is a ratchet rather than a proof.

# --- the wordings reached from two sites ------------------------------------------------
#
# A CODE IS A RULE'S IDENTITY, so one sentence raised from two places is two rules wearing
# one number and scripts/error-codes-check.sh reports it as such. Each sentence below is one
# function here rather than the same string written out twice.
#
# WHICH two places differ by rule. The three method wordings are asked once by the pass that
# EMITS the call and once by the pass that TYPES it, which is the arrangement c_meth_kind's
# comment explains. The flat-namespace collision is asked of a declaration and of a module
# constant, two walks over two tables. The two exhaustiveness wordings are one pass reaching
# one rule once per side.

fn c_err_method_unknown(mut &em: Emitter, meth: str) -> str {
	return c_diag(em, rule.Rule.NotYetErrMethod, f"NotImplemented: the method `{meth}` on a Err — the `Error` interface is `message`, `unwrap` and `code`")
}

fn c_carrier_method_unknown(mut &em: Emitter, tty: ast.Ty, meth: str) -> str {
	return c_diag(em, rule.Rule.NotYetCarrierMethod, f"NotImplemented: the method `{meth}` on a {ast.ty_name(tty)} — a carrier answers `ok_or` on a `T?` and `ok` on an `Either`")
}

fn c_list_method_unknown(mut &em: Emitter, meth: str) -> str {
	return c_diag(em, rule.Rule.NotYetListMethod, f"NotImplemented: the list method `{meth}` — this compiler has `len` and `append`")
}

# c_twice_in_file_says is the sentence for a name declared twice IN ONE FILE, which is one of
# the two shapes the collision arrives in and is a rule of its own because the two have
# different LIFETIMES — this one is ill-formed in every compiler there will ever be, while the
# other is a limit the package layer retires.
#
# It is a function and not a literal at the site because the site moved: the signature and
# constant walks each used to raise it, so the same code was reported from three places and
# `error-codes-check` says a code is reported from exactly one. c_dup_report is that one now —
# it is the single walk over every top-level declaration, which is where a rule about a name
# being declared twice belongs.
#
# The first declaration's LINE is what the place cannot carry: the marker points at the second
# one, and both halves of a duplicate are worth having.
fn c_twice_in_file_says(name: str, first: int) -> str {
	return f"`{name}` is declared twice in this file — the first is at line {strconv.to_string(first, 10)}, and one scope declares a name once"
}

# TWO FILES UNDER ONE DIRECTORY is this compiler's limit and not the language's, so it keeps
# its `NotImplemented` and the package layer retires it.
#
# IT NAMES BOTH FILES, because "two modules" is a READING of the evidence and the files are the
# evidence. A directory is a module and a lone `.zg` file is one too (`module_at` answers the
# file first), so two declarations under one directory may be two modules or two files of one,
# and nothing at this stage can tell which — what it CAN say is where each of them is written.
# Asserting the first reading is what made it wrong about the same-file case above; naming the
# files is right about all of them.
fn c_mod_flat_collide(path: str, line: int, col: int, name: str, other: str) -> str {
	return c_diag_at(path, line, col, rule.Rule.NotYetNamespaceCollision, f"NotImplemented: `{other}` and `{path}` both define `{name}` — this compiler flattens every module into one namespace, so two declarations under one directory cannot be told apart, whether they are two modules or two files of one")
}

# The two below are one rule over a two-valued domain, which is why they read a side rather
# than each spelling a sentence: an Either has a Left and a Right and a bool has a `true` and
# a `false`, and "the arm list does not name them all" is one thing to be told either way.
fn c_arm_missing_side(mut &em: Emitter, side: str) -> str {
	return c_diag(em, rule.Rule.MatchMissingEitherSide, f"non-exhaustive match: missing the {side} case")
}

fn c_arm_missing_bool(mut &em: Emitter, v: str) -> str {
	return c_diag(em, rule.Rule.MatchMissingBoolCase, f"non-exhaustive match: missing the `{v}` case")
}

# c_diag is the ordinary one: the statement the emission walk is inside, which is the SAt
# marker c_at records and the resolution this stage has.
fn c_diag(mut &em: Emitter, code: rule.Rule, msg: str) -> str {
	return c_diag_at(em.at_path, em.at_line, em.at_col, code, msg)
}

# c_place is the place trailer ALONE, for a rule that is raised somewhere else entirely and
# needs to be told where the reader was. `c_diag` builds a whole message; this hands over
# only the "--> path:line:col" half, which is what a rule living in `ast.zg` takes.
#
# It exists for ONE caller and the caller says why: specializing a template can reach a type
# the source does not spell, and the place worth reporting is the instantiation (#55).
fn c_place(mut &em: Emitter) -> str {
	return "\n" + ast.place_line(em.at_path, em.at_line, em.at_col)
}

# c_diag_at is for a rule that KNOWS its place rather than standing on it, and the emitter has
# two kinds. One runs over a DECLARATION before any statement is emitted — a field's default,
# a duplicate variant name — where the marker still holds the previous statement's position
# and the declaration carries its own. The other runs in a pass with no Emitter at all: the
# `#[derive]` expansion is source-to-source and happens before one exists, so it takes no `em`
# and answers from the declaration it is expanding.
fn c_diag_at(path: str, line: int, col: int, code: rule.Rule, msg: str) -> str {
	return f"{rule.rule_code(code)} {msg}" + "\n" + ast.place_line(path, line, col)
}

# c_shallower gives back the level c_deeper took.
fn c_shallower(mut &em: Emitter) {
	em.depth = em.depth - 1
}

# c_expr renders an expression as C. `bind` / `sub` implement a single-name substitution:
# an EIdent equal to `bind` emits `sub` verbatim instead of a mangled name — this is how a
# match arm's bound scrutinee name is spliced into its guard and body.
#
# It counts a level of the expression walk (c_deeper) and hands the node to c_expr_node,
# so every recursive render pays the depth check without each arm's helper knowing it.
#
# It is also where the ORDERING temporaries land. A node whose operands had to be sequenced
# (c_ordered) leaves their declarations on em.seq_pre, and they belong to THIS node and no
# other — so the list is saved and cleared on the way in, and whatever the node put there is
# wrapped around the node's own rendering on the way out. Every operand is rendered by a
# nested c_expr doing the same, which is what keeps a call inside a call's argument from
# leaving a declaration in the enclosing expression's wrapper.
fn c_expr(mut &em: Emitter, e: ast.Expr, sb: Subst) -> str {
	c_deeper(em)
	keep := em.seq_pre
	em.seq_pre = ""
	out := c_expr_node(em, c_ns_unqualify(em, e), c_sub_active(em, sb))
	pre := em.seq_pre
	em.seq_pre = keep
	c_shallower(em)
	return out if pre == ""

	return f"({{ {pre}{out}; }})"
}

fn c_expr_node(mut &em: Emitter, e: ast.Expr, sb: Subst) -> str {
	return match e {
		Expr.EInt(lex, _, _) => c_int_dec(em, lex)
		Expr.EFloat(lex) => c_float_dec(lex)
		Expr.EStr(v) => c_str_cell(em, v)
		Expr.EBool(b) => c_bool(b)
		Expr.ENil => "0"
		Expr.EIdent(n) => c_ident_val(em, n, sb)
		Expr.EUnary(oper, x) => c_unexpr(em, oper, x, sb)
		Expr.EBinary(oper, a, b) => c_binexpr(em, oper, a, b, sb)
		Expr.ECall(name, args, ts) => c_call_written(em, name, args, ts, sb)
		Expr.EField(target, fld) => c_fieldref(em, target, fld, sb)
		Expr.EOptChain(target, fld) => c_optchain(em, target, fld, sb)
		Expr.ETry(x) => c_try(em, x, sb)
		Expr.EIndex(target, idx) => c_index(em, target, idx, sb)
		Expr.EMethod(target, meth, args) => c_method(em, target, meth, args, sb)
		Expr.EListLit(elems) => c_list_lit(em, elems, sb)
		Expr.EFill(v, n) => c_fill_lit(em, v, n, sb)
		Expr.EConv(ty, x, nm) => c_conv(em, ty, x, nm, sb)
		Expr.EIf(cond, then_e, else_e) => c_ternary(em, cond, then_e, else_e, sb)
		Expr.EMatch(scrut, arms) => c_match(em, scrut, arms, sb)

		# A range reaching HERE is one used as a value — a slice bound or a match arm —
		# rather than as a `for`'s iterable, which c_forin takes before this point. Those
		# forms have no lowering yet, and saying so is better than emitting something that
		# reads as an int.
		Expr.ERange(lo, hi, inclusive) => c_range_unsupported(em)
		Expr.ETuple(elems) => c_tuple_lit(em, elems, sb)
		Expr.EMapLit(ks, vs) => c_map_lit(em, ks, vs, sb)
		Expr.EFn(ps, has_ret, ret, body) => c_lambda(em, ps, has_ret, ret, body)
		Expr.EChanNew(t, cap) => c_chan_new(em, t, cap, sb)
		Expr.ERecv(ch) => c_recv(em, ch, sb)
		Expr.EForce(x) => c_force(em, x, sb)
		Expr.ECoalesce(a, b, jump) => c_coalesce(em, a, b, jump, sb)
		Expr.EGuard(body) => c_guard(em, body, sb)
		Expr.EBlock(body) => c_block_expr(em, body, sb)
		Expr.EIs(x, name) => c_is_test(em, x, name, sb)
		Expr.EIn(x, set) => c_in_test(em, x, set, sb)
	}
}

# --- reading a Result back --------------------------------------------------------

# c_force lowers `e!`: the Left, or the Right re-raised as an abort right here. The work
# is in the per-carrier helper, so this is only the call — which is what keeps `!` from
# knowing how a carrier is spelled.
fn c_force(mut &em: Emitter, x: ast.Expr, sb: Subst) -> str {
	t := c_infer(em, x)
	raise c_diag(em, rule.Rule.NotYetForceOnType, f"NotImplemented: `!` on a {ast.ty_name(t)} — it forces a Result[T] or a T?") if not c_is_carrier(t)

	name := c_carrier_of(em, t)
	rendered := c_expr(em, x, sb)
	df := c_carrier_temp_drop(em, t, x)

	# A carrier that NAMES storage is somebody else's and is only read here. One that does
	# not — a receive, a call's result — is this expression's own, and the force copies its
	# payload out and leaves the carrier holding a second reference nothing will ever give
	# back. The drop is after the force, because the force is what raises on a Right.
	return f"zg_force_{name}({rendered})" if df == ""

	cn := c_tmp(em, "zgt_t")
	vn := c_tmp(em, "zgt_t")
	et := c_type(c_carrier_elem(t))
	return f"({{ {name} {cn} = {rendered}; {et} {vn} = zg_force_{name}({cn}); {df}(&{cn}); {vn}; }})"
}

# c_coalesce lowers `a ?? b`: the Left of `a`, or the fallback. The operand is bound to a
# temp first because it is read twice — the tag and then the value — and `a` is most
# often a receive, which is the most side-effecting expression the language has.
#
# The DIVERGENT form (`?? break`, `?? return …`) needs a statement where the value would
# go, so it takes the if/else shape instead of the conditional one. Its statements go
# through the ordinary c_stmt, which is what gives `break` the loop's defers for free.
# Nothing falls out of the else branch — the parser only routes statements that LEAVE
# here — so the result temp is read only where it was written.
fn c_coalesce(mut &em: Emitter, a: ast.Expr, b: ast.Expr, jump: list[ast.Stmt], sb: Subst) -> str {
	t := c_infer(em, a)
	raise c_diag(em, rule.Rule.NotYetCoalesceOnType, f"NotImplemented: `??` on a {ast.ty_name(t)} — its left side is a Result[T] or a T?") if not c_is_carrier(t)

	elem := c_carrier_elem(t)
	cn := c_carrier_of(em, t)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_co" + tag
	head := f"({{ {cn} {tmp} = {c_expr(em, a, sb)};"

	# the carrier is bound here whether or not it is somebody else's, because it is READ
	# TWICE. Giving it back is the other question, and it is asked the way c_force asks it:
	# only a carrier that names no storage is this expression's own. The drop is a no-op on
	# the fallback side by construction — there is no payload to give back on a Right — so it
	# can sit after the choice rather than inside one arm of it.
	df := c_carrier_temp_drop(em, t, a)
	if jump.len() == 0 {
		alt := c_fit_copied(em, "the `??` fallback", elem, b, sb)
		return head + " " + c_res_is_left(tmp) + " ? " + c_res_taken(em, tmp, elem) + " : (" + alt + "); })" if df == ""

		v0 := "zgt_cov" + tag
		pick := f"{c_res_is_left(tmp)} ? {c_res_taken(em, tmp, elem)} : ({alt})"
		return f"{head} {c_type(elem)} {v0} = {pick}; {df}(&{tmp}); {v0}; }})"
	}

	val := "zgt_cov" + tag
	mut out := f"{head} {c_type(elem)} {val};"
	mut give := ""
	if df != "" {
		give = f" {df}(&{tmp});"
	}
	out = out + " if (" + c_res_is_left(tmp) + ") { " + val + " = " + c_res_taken(em, tmp, elem) + ";" + give + " } else { "
	for s in jump {
		out = out + c_stmt(em, s, "")
	}
	return out + f"}} {val}; }})"
}

# --- a block as an expression ------------------------------------------------------
#
# `{ … }` where an expression is wanted is a BLOCK EXPRESSION (GRAMMAR, group 2: a block is
# a primary), and its value is its LAST statement's — an expr-stmt yields its expr, and any
# other statement, or an empty block, yields `nil`.
#
# IT IS `guard` WITHOUT THE HANDLER, and deliberately the same code one field along: the
# same value rule (c_block_val_ty and c_guard_val_ty share c_last_val_ty), the same GNU
# statement expression, the same "copy the value BEFORE the scope unwinds". What a guard
# adds is the catching frame and the demotion of an abort to a Right; strip those and this
# is what is left, which is why the two were never going to be two lowerings.
#
# The SCOPE is c_block's, not the guard's frame: a block expression binds names and owns
# storage exactly as a bare block statement does, so it takes the same mark on entry and
# unwinds to it at the end. The one order that matters is that the VALUE is copied out
# first — `{ ys := [1, 2, 3]  ys }` yields the block's own buffer, and the unwind on the
# next line frees it, so what leaves has to be an independent copy (c_copied) rather than a
# second name for storage that is about to go.
fn c_block_expr(mut &em: Emitter, body: list[ast.Stmt], sb: Subst) -> str {
	vt := c_block_val_ty(em, body)

	n := body.len()
	mut upto := n
	if n > 0 and c_is_expr_stmt(body[n - 1]) {
		upto = n - 1
	}

	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	mark := "zgt_bm" + tag
	val := "zgt_bv" + tag

	# the substitution goes on the emitter for the length of this block, because the
	# statements below are lowered by c_stmt, which carries none (c_sub_active)
	saved_sub := em.sub
	em.sub = c_sub_active(em, sb)

	keep := em.rel_cnames.len()
	outer_scope := c_scope_open(em)

	mut inner := ""
	mut i := 0
	for i < upto {
		inner = inner + c_stmt(em, body[i], "")
		i = i + 1
	}

	# the value. A nil-valued last expression still has to RUN — it was written for its
	# effect — and there is simply nothing to hand back from it.
	mut yields := false
	if upto < n {
		last := c_expr_stmt_of(body[n - 1])
		if c_is_nil_ty(vt) {
			inner = inner + c_expr(em, last, c_nosub()) + "; "
		} else {
			yields = true
			inner = inner + f"{c_type(vt)} {val} = {c_copied(em, vt, last, c_nosub())}; "
		}
	}

	c_scope_close(em, outer_scope)
	needs := c_has_defer(body) or em.rel_cnames.len() > keep
	c_scope_forget(em, keep)
	em.sub = saved_sub

	mut out := "({ "
	if needs {
		em.used_rt = true
		out = out + f"size_t {mark} = zrt_scope_mark(); "
	}
	out = out + inner
	if needs {
		out = out + f"zrt_unwind_to({mark}); "
	}
	return out + f"{val}; }})" if yields

	# AN EMPTY STATEMENT EXPRESSION IS NOT C. `({ })` is a syntax error where `({ (void)0; })`
	# is the void value this block is worth, and an empty block — or one holding only `nop` —
	# renders to exactly nothing above.
	return out + "(void)0; })" if inner == "" and not needs
	return out + "})"
}

# c_block_val_ty is a block expression's value type, and c_guard_val_ty is the same question
# about the block a guard holds. Both defer to c_last_val_ty, because GRAMMAR states the
# rule once: the value is the last statement's, and only an expression statement has one.
fn c_block_val_ty(mut &em: Emitter, body: list[ast.Stmt]) -> ast.Ty {
	return c_last_val_ty(em, body, "a block used as an expression")
}

# c_last_val_ty answers what a `{ … }` is worth without lowering it, which is what a caller
# typing the block from outside needs — `x := { … }` asks for the binding's type before the
# block is ever emitted, and `guard { … } ?? 0` types its left side first.
#
# The last statement is typed against WHAT THE BLOCK BINDS, which is the part that cannot be
# skipped: `{ y := 1  y + 1 }` names `y` in its value, and `y` exists nowhere but inside this
# block. So the statements above it are walked for their bindings and registered, the value
# is inferred, and the environment is put back exactly as it was — the same save-and-restore
# a lambda's body already does, for the same reason. Nothing is emitted and no diagnostic is
# owed: a finding this walk would raise, the real emission raises too, and chk_at drops the
# repeat.
fn c_last_val_ty(mut &em: Emitter, body: list[ast.Stmt], what: str) -> ast.Ty {
	n := body.len()

	return ast.Ty.TNil if n == 0
	return ast.Ty.TNil if not c_is_expr_stmt(body[n - 1])

	saved_env := c_env_save(em)
	saved_open := em.open_scopes
	saved_cur := em.scope_cur

	outer := c_scope_open(em)
	c_block_binds(em, body, n - 1)
	t := c_infer(em, c_expr_stmt_of(body[n - 1]))
	c_scope_close(em, outer)

	c_env_restore(em, saved_env)
	em.open_scopes = saved_open
	em.scope_cur = saved_cur

	raise c_diag(em, rule.Rule.NotYetValueUnnameableType, f"NotImplemented: {what} whose value has no type this compiler can name — give the block's last expression a call, a literal or a typed binding") if c_is_unknown(t)
	return ast.Ty.TNil if c_is_nil_ty(t)

	return t
}

# c_block_binds registers what a block's statements BIND, so its last statement can be typed
# against them. Only a `binding` binds at a block's own level: a loop variable, an `if let`
# name and a match arm's binds all belong to the construct that owns them and are gone before
# the next statement, so there is deliberately nothing here for them.
fn c_block_binds(mut &em: Emitter, body: list[ast.Stmt], upto: int) {
	mut i := 0
	for i < upto {
		match body[i] {
			Stmt.SLet(name, ty, has_type, is_mut, is_const, ival) => c_block_bind_one(em, name, ty, has_type, is_mut, is_const, ival)
			_ => c_skip()
		}
		i = i + 1
	}
}

fn c_block_bind_one(mut &em: Emitter, name: str, ty: ast.Ty, has_type: bool, is_mut: bool, is_const: bool, ival: ast.Expr) {
	mut eff := ty
	if not has_type {
		eff = c_infer(em, ival)
	}
	c_add_var(em, name, eff, is_mut, is_const)
}

# --- guard: the way back from the abort tier --------------------------------------
#
# `guard { … }` runs its block under a CATCHING abort handler and answers a `Result[T]`:
# the block's value as the Left, or — when something inside aborted — the Err it carried
# as the Right. It is the only construct that stops an abort, which is why the whole of
# the runtime's handler protocol shows up here and nowhere else:
#
#   zrt_handler_push_catch  links a frame and marks it `catches`, so an abort landing on
#                           it prints NO diagnostic — the program is handling the error
#                           and the message rides in the Err instead;
#   setjmp(frame.buf)       arms the landing pad. It has to be evaluated in the ENCLOSING
#                           function's own activation — a longjmp into a frame that has
#                           returned is undefined — which is why this is a C statement
#                           expression rather than a call to a helper;
#   zrt_abort               unwinds every pending defer/drop down to frame.mark and
#                           longjmps here, leaving the frame LINKED: the landing pad owns
#                           the pop, on both paths, which is what keeps the handler chain
#                           balanced when a guard is caught and when it is not;
#   zrt_taken_err           hands back the Err the abort carried.
#
# The chain lives in the per-coroutine zrt_tls the scheduler swaps at every context
# switch, so a `guard` catches aborts on the CURRENT stack only — a coroutine spawned
# inside the block has a handler chain of its own and its crash is untouched, exactly as
# docs/code/errors.md says.
#
# One C hazard is inherited rather than solved, and is the reason a guarded block is
# usually written as one call: an automatic variable of the enclosing function that is
# MODIFIED inside the block and read after a caught abort has an indeterminate value
# unless it is `volatile` (C99 7.13.2.1). A variable only read, or written before the
# guard, is unaffected — longjmp restores the register state setjmp saw.
fn c_guard(mut &em: Emitter, body: list[ast.Stmt], sb: Subst) -> str {
	em.used_rt = true

	# the pre-pass walks the block's SAt markers so its refusal points at the jump; the
	# marker is put back because what follows lowers the guard STATEMENT, and a finding
	# made while doing so belongs to it and not to the last line inside it
	guard_line := em.at_line
	guard_col := em.at_col
	c_guard_no_jump(em, body, false)
	c_mark(em, guard_line, guard_col)

	vt := c_guard_val_ty(em, body)
	cn := c_carrier_name(em, c_guard_elem(vt), ast.Ty.TErr)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	fr := "zgt_gf" + tag
	res := "zgt_gr" + tag

	n := body.len()
	mut upto := n
	if n > 0 and c_is_expr_stmt(body[n - 1]) {
		upto = n - 1
	}

	# A GUARDED BLOCK IS A BLOCK, and this is the one that walks its statements itself
	# rather than through c_block — so it has to do by hand the half c_block does for every
	# other one: remember how tall the pending-release list was, and give back what the body
	# added before the braces close.
	#
	# Without it the entries outlive the C block their names are declared in, and the next
	# `return` renders them where nothing of that name exists: cc, `use of undeclared
	# identifier`, against generated C. It stayed invisible while channels were the only
	# thing on that list — no corpus case opens one inside a `guard` — and surfaced the day
	# a second type joined.
	keep := em.rel_cnames.len()
	mut inner := ""
	mut i := 0
	for i < upto {
		inner = inner + c_stmt(em, body[i], "")
		i = i + 1
	}
	inner = inner + c_guard_ok(em, body, upto, vt, res, sb)

	# The guard's own frame mark is what gives its bindings back, on BOTH ways out: the
	# normal path unwinds to it below, and the catch path is unwound by the runtime before
	# the longjmp lands here. So there is nothing to render — only the pending entries to
	# forget, since they belong to a scope that has ended.
	c_scope_forget(em, keep)

	mut out := "({ zrt_frame " + fr + "; " + cn + " " + res + " = {0}; zrt_handler_push_catch(&" + fr + ");"
	out = out + " if (setjmp(" + fr + ".buf) == 0) { " + inner
	out = out + " zrt_unwind_to(" + fr + ".mark); zrt_handler_pop(&" + fr + "); }"
	out = out + " else { zrt_handler_pop(&" + fr + "); " + c_res_mark_right(res) + " " + c_res_err(res) + " = zrt_taken_err(); }"
	return out + " " + res + "; })"
}

# c_guard_ok writes the Left: the block ran to its end, so its value is the answer.
fn c_guard_ok(mut &em: Emitter, body: list[ast.Stmt], upto: int, vt: ast.Ty, res: str, sb: Subst) -> str {
	# a block whose last statement is not an expression has no value at all (GRAMMAR: it
	# is `nil`), so the tag alone is what there is to say
	return c_res_mark_left(res) if upto == body.len()

	val := c_expr(em, c_expr_stmt_of(body[upto]), sb)

	# FLATTENING: a block that already yields a Result IS the answer. An abort inside and a
	# Right handed back are the same ending, so they must not nest (docs/code/errors.md).
	return f"{res} = {val};" if c_is_result(vt)

	# a value-less last expression still has to RUN — it was written for its effect
	return f"{val}; {c_res_mark_left(res)}" if c_is_nil_ty(vt)

	# COPIED, not aliased: the answer outlives the block, and the block now gives back what
	# its bindings own on the way out. `guard { xs := […]; xs }` handed the result a second
	# name for a buffer the release below was about to free.
	return f"{c_res_mark_left(res)} {c_res_ok(res)} = {c_copied(em, vt, c_expr_stmt_of(body[upto]), sb)};"
}

# c_guard_val_ty is the guarded BLOCK's value type, and it is c_last_val_ty because a guard's
# block is a block: GRAMMAR gives it the value of its last statement, and only an expression
# statement has one — every other statement, and an empty block, yields `nil`.
#
# It used to have a rule of its own, and with it a gap: the type was read straight off the
# last statement with nothing bound, so `guard { x := f()  check(x) }` — a name bound INSIDE
# the block, which is most of why a guard holds several statements — was refused by name.
# c_last_val_ty registers the block's own bindings first, so both forms type the same way.
fn c_guard_val_ty(mut &em: Emitter, body: list[ast.Stmt]) -> ast.Ty {
	return c_last_val_ty(em, body, "a `guard`")
}

# c_guard_elem is the guard's Result PAYLOAD: the block's value type, or — when that is
# already a Result — the type it carries, which is the flattening rule.
fn c_guard_elem(vt: ast.Ty) -> ast.Ty {
	return c_result_elem(vt) if c_is_result(vt)
	return vt
}

fn c_is_expr_stmt(s: ast.Stmt) -> bool {
	return match s {
		Stmt.SExpr(_) => true
		_             => false
	}
}

fn c_expr_stmt_of(s: ast.Stmt) -> ast.Expr {
	return match s {
		Stmt.SExpr(x) => x
		_             => ast.Expr.ENil
	}
}

# c_guard_no_jump refuses a jump that would LEAVE the guarded block: a `return`, or a
# `break`/`continue` belonging to a loop outside the guard. Either one jumps out of the C
# statement expression with the catching frame still linked, and the next abort anywhere
# in the program lands on an activation that has already returned. There is no lowering
# for that short of a second unwind path, so it is named instead of miscompiled.
#
# `in_loop` is set for the body of a loop written INSIDE the guard, whose break belongs to
# it and never crosses the frame.
#
# It reads the SAt markers as it goes, for the reason c_check_loop_jump does: this runs ahead
# of the guarded block's emission, so the marker still holds the statement before the `guard`
# and the jump this refuses would be reported at it.
fn c_guard_no_jump(mut &em: Emitter, body: list[ast.Stmt], in_loop: bool) {
	for s in body {
		match s {
			Stmt.SAt(l, c) => c_mark(em, l, c)
			Stmt.SReturn(has_val, e) => c_guard_jump_err(em, "return")
			Stmt.SReturnIf(v, cond) => c_guard_jump_err(em, "return")
			Stmt.SBreak => c_guard_loop_jump(em, "break", in_loop)
			Stmt.SContinue => c_guard_loop_jump(em, "continue", in_loop)
			Stmt.SIf(cond, then_b, has_else, else_b) => c_guard_no_jump_two(em, then_b, else_b, in_loop)
			Stmt.SIfLet(nm, v, then_b, has_else, else_b) => c_guard_no_jump_two(em, then_b, else_b, in_loop)
			Stmt.SFor(is_cond, cond, body_b) => c_guard_no_jump(em, body_b, true)
			Stmt.SForIn(nm, it, body_b) => c_guard_no_jump(em, body_b, true)
			Stmt.SSelect(arms) => c_guard_no_jump_sel(em, arms, in_loop)

			# and inside a bare block, where a `return` was leaving a `guard` unseen: the
			# E9043 that names the form never fired, and what the reader got instead was
			# _E3032 this function's answer is int, and this gives Result[int]_ — a true
			# sentence about a consequence, pointing nowhere near the `return` that caused it
			Stmt.SScope(body_b) => c_guard_no_jump(em, body_b, in_loop)
			_ => c_skip()
		}
	}
}

fn c_guard_no_jump_two(mut &em: Emitter, a: list[ast.Stmt], b: list[ast.Stmt], in_loop: bool) {
	c_guard_no_jump(em, a, in_loop)
	c_guard_no_jump(em, b, in_loop)
}

fn c_guard_no_jump_sel(mut &em: Emitter, arms: list[ast.SelArm], in_loop: bool) {
	for a in arms {
		c_guard_no_jump(em, a.body, in_loop)
	}
}

fn c_guard_loop_jump(mut &em: Emitter, kw: str, in_loop: bool) {
	return if in_loop
	c_guard_jump_err(em, kw)
}

fn c_guard_jump_err(mut &em: Emitter, kw: str) {
	raise c_diag(em, rule.Rule.NotYetJumpOutOfGuard, f"NotImplemented: `{kw}` leaving a `guard` block — the guard's handler would stay installed on a frame that has returned")
}

# c_str_concat joins two strings and gives back whichever operand it OWNS.
#
# zrt_str_concat reads both operands and answers a fresh cell, holding on to neither — so an
# operand that was itself fresh has nothing naming it once the call returns. That is EVERY
# interpolation in an f-string: `f"caller {x} {n}"` lowers to a chain of `+` over `display()`
# results, and each of those cells was leaked the moment it was joined. It is the largest
# single leak this emitter had, because it is one per interpolated value per f-string.
#
# So a fresh operand is held in a temporary and released after the join — the same statement
# expression shape c_call_releasing uses, for the same reason: the release has to happen
# after the call and an expression has nowhere else to put it. A LITERAL is fresh by this
# test and is deliberately skipped: its cell is immortal, so holding it would only make the
# emitted C longer. An operand that NAMES storage is somebody else's, and is borrowed.
#
# The ORDER of the two is decided here too, and with these same temporaries rather than with
# c_ordered's: this expression's declarations sit INSIDE its own statement expression and
# c_ordered's sit outside it, so a run split between the two mechanisms would be evaluated
# right-hand-side first. A left operand that owns nothing is bound anyway when the right one
# could tell — it costs a name and nothing else, and it keeps one list in one place.
fn c_str_concat(mut &em: Emitter, a: ast.Expr, b: ast.Expr, sb: Subst) -> str {
	ra := c_expr(em, a, sb)
	rb := c_expr(em, b, sb)
	oa := c_owns_value(a)
	ob := c_owns_value(b)
	seq := c_needs_order([a, b], 1)
	ba := oa or seq
	bb := ob or seq
	return f"zrt_str_concat({ra}, {rb})" if not ba and not bb

	mut decls := ""
	mut frees := ""
	mut la := ra
	mut lb := rb
	if ba {
		la = c_tmp(em, "zgt_t")
		decls = decls + f"const char *{la} = {ra}; "
		if oa {
			frees = frees + f"zrt_str_release({la}); "
		}
	}
	if bb {
		lb = c_tmp(em, "zgt_t")
		decls = decls + f"const char *{lb} = {rb}; "
		if ob {
			frees = frees + f"zrt_str_release({lb}); "
		}
	}
	rn := c_tmp(em, "zgt_t")
	return f"({{ {decls}const char *{rn} = zrt_str_concat({la}, {lb}); {frees}{rn}; }})"
}

# c_owns_value is THE ownership invariant this whole teardown rests on: an expression that
# names no storage hands over a value nobody else is holding, so whoever takes it owes it
# back. It is asked wherever a value is used and then has nowhere to go — a concat operand,
# a printed string, a carrier a `!` unwraps, a channel handed to a call, a `for … in`.
#
# The one carve-out is a string LITERAL. Its cell is immortal, so both halves of a refcount
# are no-ops on it and holding it in a temporary only makes the emitted C longer. That
# exemption used to live at one of the six sites that ask this question, which is why
# `print "hi"` bound a temporary and released an immortal cell.
fn c_owns_value(e: ast.Expr) -> bool {
	return false if c_is_strlit(e)
	return not c_is_lvalue(e)
}

fn c_is_strlit(e: ast.Expr) -> bool {
	return match e {
		Expr.EStr(_) => true
		_            => false
	}
}

# --- left-to-right evaluation order ---------------------------------------------
#
# docs/core/memory.md: "Function arguments, operator operands, and the elements of a
# `list`/`map` literal or a `set(...)` constructor evaluate in source order,
# deterministically." C promises none of that. The order in which a call's arguments — and
# the two operands of an operator that lowers to a call — are evaluated is UNSPECIFIED, and
# the two compilers this emitter feeds disagree about it: `zrt_add_i64(zg_a(), zg_b())`
# calls `a` first under clang on arm64 and `b` first under gcc on x86-64, so `print a() +
# b()` printed `a b` on one machine and `b a` on the other. One program, one source, two
# answers — which is a defect rather than an unstated choice, and it is not the backend's
# to decide.
#
# What C does sequence is a DECLARATION. So the operands are bound to temporaries of their
# own, in source order, inside the statement expression this emitter already uses for every
# other value it has to hold on to (c_call_releasing, c_match, c_str_concat) — and what
# reaches the operator or the argument list is a name, the calls behind it having already
# happened in the order they were written.
#
# The temporaries are DECLARED WITH `__auto_type`, not with a C type read off the argument's
# Zerg type. The value being bound is whatever the rendering already produced, and that is
# not always the type inference names for the expression: a `mut &` argument renders as an
# ADDRESS, a value at a typed slot renders through c_fit_copied at the PARAMETER's type, and
# a literal tree beside a float renders as a double. `__auto_type` says "the type this
# expression already has", which is the only claim this transformation is entitled to make —
# a written type here would be a second, independent answer about the same value, and the
# ways those two drift are what half the comments in this file are about.
fn c_ord_decl(t: str, rendered: str) -> str {
	return f"__auto_type {t} = {rendered}; "
}

# c_order_trivial is whether an operand can be left where it stands when the run around it
# is NOT being sequenced: a literal or a plain name — a local, a parameter, a module constant
# — reads no storage and calls nothing, so no other operand can tell whether it went first.
# Everything else — a call, an index, a field, a receive, a nested operator, a `match` — has
# an effect of its own or reads storage another operand may write, and is what makes the
# order of the run observable.
#
# It is only the TRIGGER. Once a run is being sequenced every operand in it is bound,
# trivial ones included, because a plain name IS observable from the other side: `f(x,
# bump(mut &x))` reads `x` and writes it in one argument list, and leaving the read where it
# stood would let it see the write C happened to do first.
fn c_order_trivial(e: ast.Expr) -> bool {
	return match e {
		Expr.EInt(_, _, _) => true
		Expr.EFloat(_) => true
		Expr.EStr(_) => true
		Expr.EBool(_) => true
		Expr.ENil => true
		Expr.EIdent(_) => true
		_ => false
	}
}

# c_needs_order is whether a run of operands has an order the emitted C could get wrong.
# `at` is the index of the run's SECOND operand — 1 where the run is exactly this list, and 0
# where an operand already stands in front of it, which is a method's receiver: the receiver
# is evaluated first and C sequences it against the arguments no better than it sequences
# them against each other.
#
# The FIRST operand is not asked about. Nothing is evaluated before it, so whatever it does
# it does first whichever order the C compiler picks; it is a later operand having an effect
# that makes the choice visible.
#
# That reasoning holds only while every operand is read ONCE, which is the second reason a
# caller passes 0: `v in lo..hi` names its subject at each bound, so the subject's second
# reading comes after the bounds and its own effect is what the order shows. c_in_range is the
# one such form, and it asks from 0 for that reason rather than for the receiver's.
fn c_needs_order(es: list[ast.Expr], at: int) -> bool {
	mut i := at
	for i < es.len() {
		return true if not c_order_trivial(es[i])
		i = i + 1
	}
	return false
}

# c_is_ref_param is whether the parameter at this index takes a `mut &`, which is the one
# argument a sequenced run LEAVES WHERE IT STANDS. Such an argument renders as an ADDRESS —
# `&(zg_xs)` — and taking the address of the caller's own storage calls nothing and reads
# nothing, so it can neither observe the order of the run nor be observed by it. It does not
# count toward the trigger either, for the same reason a bare name does not.
fn c_is_ref_param(mut &em: Emitter, key: str, idx: int) -> bool {
	row := c_param_row(em, key, idx)
	return false if row < 0

	return em.pr_ref[row]
}

# c_ref_args is that answer for each of a call's written arguments, in one pass. It is a LIST
# rather than a question asked where it is needed, because each answer is a scan of the whole
# program's parameter table and the ordering rule asks twice — once for the run, to decide
# whether it is sequenced at all, and once per argument, to decide whether that one is bound.
fn c_ref_args(mut &em: Emitter, key: str, base: int, args: list[ast.Expr]) -> list[bool] {
	mut out: list[bool] = []
	mut i := 0
	for i < args.len() {
		out.append(c_is_ref_param(em, key, base + i))
		i = i + 1
	}
	return out
}

# c_needs_order_args is c_needs_order over an ARGUMENT list, where a `mut &` argument is not
# an operand the order can be told apart by. `refs` is c_ref_args' answer for the same list.
fn c_needs_order_args(args: list[ast.Expr], refs: list[bool], at: int) -> bool {
	mut i := at
	for i < args.len() {
		return true if not c_order_trivial(args[i]) and not refs[i]
		i = i + 1
	}
	return false
}

# c_ordered binds one already-rendered operand of a sequenced run to a temporary, and hands
# back the name to use in its place. A run that needs no sequencing renders exactly the C it
# rendered before this existed, which is the property that keeps `n + 1`, `x == y` and `f(n,
# i)` out of the diff entirely.
fn c_ordered(mut &em: Emitter, seq: bool, rendered: str) -> str {
	return rendered if not seq

	t := c_tmp(em, "zgt_ord")
	em.seq_pre = em.seq_pre + c_ord_decl(t, rendered)
	return t
}

# c_is_shortcircuit names the two operators whose right operand may not be evaluated at all.
# `and` and `or` lower to C's `&&` and `||`, which are left-to-right AND skipping already —
# so they need nothing here, and sequencing them would be a wrong answer rather than a
# redundant one: a temporary evaluates the right side unconditionally, which is what `and`
# exists not to do. (`??`, `?.` and `?` are expressions of their own, not binary operators,
# and never reach c_binexpr.)
fn c_is_shortcircuit(oper: str) -> bool {
	return oper == "and" or oper == "or"
}

# c_binexpr lowers a binary expression, special-casing string concatenation and equality
# (which are not C operators on const char*).
fn c_binexpr(mut &em: Emitter, oper: str, a: ast.Expr, b: ast.Expr, sb: Subst) -> str {
	ta := c_infer(em, a)
	check.chk_binary(em, oper, ta, c_infer(em, b), a, b)
	if c_is_str(ta) {
		if oper == "+" {
			em.used_str = true
			em.used_rt = true
			return c_str_concat(em, a, b, sb)
		}

		# EVERY comparison on two strs is strcmp's, not just the two equalities. `<` `>` `<=`
		# `>=` fell through to the numeric path below and compared the two POINTERS: `"zzz" <
		# "aaa"` answered TRUE, silently, and the seed answered false. An ordering is what a
		# sort is built on, so the wrong answer does not stay local.
		#
		# `strcmp` is a CALL, so its two arguments are an argument list like any other and
		# get the same ordering the numeric path below gets.
		if c_is_cmp_op(oper) {
			seq := c_needs_order([a, b], 1)
			la := c_ordered(em, seq, c_expr(em, a, sb))
			lb := c_ordered(em, seq, c_expr(em, b, sb))
			return f"(strcmp({la}, {lb}) {oper} 0)"
		}
	}

	# AN AGGREGATE HAS NO C OPERATOR, and `Eq` is where its `==` comes from. C has no `==` for
	# a struct, an enum, a list, a map or a tuple, so the operator used to reach cc as
	# `invalid operands to binary expression` against code nobody wrote.
	#
	# An enum used to be answered here by comparing the two TAGS, which is right for a
	# fieldless enum and WRONG for a payload one: `Circle(1) == Circle(2)` answered true. It
	# was also equality with no impl behind it, which docs/core/derive.md rules out — there is
	# no auto-derived equality — and the seed refuses exactly that.
	if c_is_cmp_op(oper) {
		return c_eq_call(em, oper, a, b, sb) if (oper == "==" or oper == "!=") and c_has_eq(em, ta)

		# EQUALITY and ORDERING are two questions. `c_eq_legal` answers the first — and is
		# the same answer the `T: Eq` bound gives, which is the point of it being one
		# function. An ORDERING additionally has nothing on any aggregate, `Ord` being what
		# would supply it, so a `#[derive(Eq)]` struct answers `==` and still not `<`.
		#
		# ONLY WHEN THE TWO SIDES ARE THE SAME TYPE. `Color == Fruit` and `Color == 1` are
		# already reported by chk_binary above, and they are the better sentence — what is
		# wrong there is the pair, not a missing impl. Raising here as well replaced a
		# diagnostic about the program with one about a spec the program never mentioned.
		#
		# `ty_eq` and not `ty_name`, which is the same correction chk_binary's equality rule
		# took: a SPELLING is the same question only where a type has a name of its own, and
		# the pair that reaches here is a pair of aggregates, which is exactly where it is not.
		if not c_eq_legal(em, ta) or c_is_aggregate(em, ta) {
			if ast.ty_eq(ta, c_infer(em, b)) {
				c_eq_refuse(em, oper, ta)
			}
		}
	}

	# THE OTHER OPERAND IS A POSITION, so a literal tree standing beside a float is a tree of
	# floats — and C will not read it that way on its own. `n + 1 / 2` for a float `n` was
	# `2`: the checker had already typed the `1 / 2` as float (chk_lit_fits, at the operand
	# slot), and then this line rendered it with c_expr, which divides two integers. Silent,
	# and in every mixed expression — the same shape of miss c_into's comment describes at the
	# six slots it serves, at the seventh nobody had told.
	# THE OPERATION HAPPENS AT THE UNDERLYING TYPE when either side is a `type X = Y`. The
	# checker has already decided that the pair is legal — two of the same X, or nothing to do
	# with a typedef at all — so what is left here is picking the C the operator lowers to,
	# and a TNamed is not a scalar class: without this a `Celsius + Celsius` fell past every
	# width rule to a bare C `+`, which is the one arithmetic in this compiler that does not
	# check for overflow.
	tb := c_infer(em, b)
	ra := c_scalar_repr(em, ta)
	rb := c_scalar_repr(em, tb)
	pair_is_float := c_is_float(ra) or c_is_float(rb)

	# THE TWO OPERANDS ARE A RUN. Every arithmetic operator this compiler emits is a checked
	# runtime CALL (`zrt_add_i64(a, b)`), so its two operands are two arguments and C leaves
	# their order to the backend; the short-circuit pair is the one exception, and it is the
	# one that must keep skipping its right side.
	seq := c_needs_order([a, b], 1) and not c_is_shortcircuit(oper)
	ca := c_ordered(em, seq, c_operand(em, pair_is_float, a, sb))
	cb := c_ordered(em, seq, c_operand(em, pair_is_float, b, sb))
	return c_floordiv(em, ra, rb, ca, cb) if oper == "//"

	# The RESULT's type decides whether this operation can overflow, not the left operand's.
	# `0 - 7.5` is a float subtraction whose left side is an untyped integer literal
	# adopting the context (docs/core/types.md); handing `c_arith` the left type sent it
	# through the checked INTEGER path, which truncated the 7.5 to 7 on the way into
	# zrt_sub_i64 and printed a denormal. Silent, and in every mixed expression.
	return c_arith(em, oper, c_scalar_repr(em, c_infer_binary(em, oper, a, b)), ca, cb)
}

# c_operand renders one side of a binary expression. It is c_expr, plus the one thing c_expr
# cannot know: whether the OTHER side made this one a float.
#
# The pair's floatness is asked rather than the result's, because a comparison answers `bool`
# and its operands are still two floats — `n < 1 / 2` has to divide as a float exactly as
# `n + 1 / 2` adds as one.
fn c_operand(mut &em: Emitter, pair_is_float: bool, e: ast.Expr, sb: Subst) -> str {
	return c_lit_checked(em, e) if pair_is_float and c_is_lit_tree(e)

	return c_expr(em, e, sb)
}

# c_eq_legal is "does `==` mean anything on this type" — ONE predicate, asked by the operator
# that lowers it and by the bound that promises it. The two used to be separate expressions of
# one rule and they had already drifted: `T: Eq` admitted an `int?`, whose `==` the operator
# refuses, so the diagnostic landed on a line inside the TEMPLATE that the caller never wrote;
# and it admitted a `chan[int]`, which the operator did not refuse either — it fell past the
# aggregate guard to the numeric path and compared two POINTERS.
#
# A scalar and a `str` have it from the language. A declared type has it from an `Eq` impl,
# derived or written. Nothing else does: a carrier is not a value until it is unwrapped, and a
# channel is an identity the language never gave an equality to.
fn c_eq_legal(mut &em: Emitter, t: ast.Ty) -> bool {
	return false if c_is_carrier(t) or ast.ty_is_chan(t) or c_is_fn(t)
	return c_has_eq(em, t) if c_is_aggregate(em, t)

	return true
}

# c_eq_call lowers `a == b` / `a != b` on a type with an Eq impl as the CALL THE PROGRAMMER
# COULD HAVE WRITTEN. `eq` and `ne` are ordinary methods, so rewriting the expression and
# handing it back to c_expr gets the receiver copy, the name mangling and the argument rules
# from the one place that already has them — the same move `Into` makes for `.into()`.
fn c_eq_call(mut &em: Emitter, oper: str, a: ast.Expr, b: ast.Expr, sb: Subst) -> str {
	return c_expr(em, ast.Expr.EMethod(a, "eq", [b]), sb) if oper == "=="

	return c_expr(em, ast.Expr.EMethod(a, "ne", [b]), sb)
}

# c_eq_refuse names what is missing, and there are four different sentences under one gap —
# the comment here said three while the function answered five, and two of the five had no
# code, which is how a rule stays unpinnable: nothing in the file counts its own branches.
# The fifth turned out to be a rule the checker already owned, and is gone.
#
# A CHANNEL or a FUNCTION is an identity rather than a value, and a CARRIER may hold nothing
# to compare — both permanent answers of the language rather than gaps. Equality on a
# CONTAINER is
# docs/code/collections.md's `[not yet]` — a container is not a declaration, so there is
# nothing to decorate and no impl a program could write for it. Equality on a NAMED type
# exists the moment it has an `Eq`, so that one is an instruction rather than a refusal, and
# it is the only one of the four that tells the reader what to type.
# It REPORTS rather than answering a sentence, and that is what buys the place: it used to
# be `raise c_eq_says(…)`, so five rules about an expression the emitter is standing on said
# nothing about where it was. The channel is the same one every checked rule uses, and the
# C built after a finding is thrown away — the same reasoning that put `no field` on it.
fn c_eq_refuse(mut &em: Emitter, oper: str, t: ast.Ty) {
	# AN ORDERING IS ALREADY ANSWERED, by the checker's rule about `<` on two things that are
	# neither numbers nor strs — which has a place and the better sentence. This branch used
	# to raise its own `NotImplemented: an ordering comes from Ord`, and a raise ENDS THE RUN,
	# so those words replaced that rule's on every program that reached both. Nothing here
	# could see it: the case asserted the sentence that won. It reports nothing now, and the
	# code it used to carry is retired — one mistake earns one finding, and this is not it.
	return if oper != "==" and oper != "!="

	if ast.ty_is_chan(t) or c_is_fn(t) {
		check.chk_at(em, rule.Rule.IdentityHasNoEquality, f"a {ast.ty_name(t)} is an identity rather than a value, and the language gives it no equality — compare something it carries")
		return
	}
	if c_is_carrier(t) {
		check.chk_at(em, rule.Rule.OptionalCompare, f"a {ast.ty_name(t)} may hold no value, so `{oper}` has nothing to compare — unwrap it first with `??`, `!` or `if v := …`")
		return
	}
	if not c_is_struct_name(em, c_named_of(t)) and not c_is_enum_ty(em, t) {
		check.chk_at(em, rule.Rule.NotYetContainerEquality, f"NotImplemented: `{oper}` on a {ast.ty_name(t)} — structural equality over a container is unbuilt, and a container has no declaration to derive it on; compare the elements you mean to compare")
		return
	}

	check.chk_at(em, rule.Rule.EqRequired, f"`{oper}` on a {ast.ty_name(t)} needs an `Eq` — there is no structural equality by default, so add `#[derive(Eq)]` to the type or write `impl Eq for {ast.ty_name(t)}`")
}

# c_floordiv lowers `a // b`. Its result is always an `int`, so the operand types decide
# only HOW: two integers are the integer division the language already has — already
# Euclidean, already checked — and a float pair goes through the helper that divides as a
# double and lands in int64 through the same range check `int(x)` is.
fn c_floordiv(mut &em: Emitter, ta: ast.Ty, tb: ast.Ty, a: str, b: str) -> str {
	em.used_rt = true
	return f"(zrt_floordiv_f((double)({a}), (double)({b})))" if c_is_float(ta) or c_is_float(tb)

	return f"(zrt_div_i64((int64_t)({a}), (int64_t)({b})))"
}

# c_arith lowers a binary operator that has a CHECK, and every other one as the bare C
# operator it always was.
#
# docs/core/types.md: `+`, `-`, `*` raise OverflowError; `/` and `%` raise DivideByZeroError
# on a zero divisor; a shift by a distance outside the type's width raises. The
# `%`-suffixed `+%`, `-%`, `*%` are the wrapping forms and keep the bare operator — that
# pairing is the reason there are two of each, and it meant nothing while both emitted the
# same C.
#
# It is not only a different answer from the specified one. A signed overflow, a division by
# zero and a shift past the width are all UNDEFINED BEHAVIOUR in C, so the old lowering had
# no answer at all to stand behind.
#
# Which types are covered is asked of the SCALAR TABLE, never of a list of names. The gate
# here read `c_is_int(t) or c_is_byte(t)` — and c_is_int is TInt alone — so `uint` and `rune`
# took the bare operator: `u - 2` wrapped where the page says it raises, and `u / 0` was
# undefined behaviour that happened to print 0 while `i / 0` on the next line raised. The
# table already knew both were integers; nobody asked it.
fn c_arith(mut &em: Emitter, oper: str, t: ast.Ty, a: str, b: str) -> str {
	cls := c_scalar_class(t)

	# the WRAPPING three, which are the whole reason there are two spellings of each
	# operator. They wrap on the unsigned bit pattern rather than on a signed C operator,
	# whose overflow is undefined — see c_binop.
	wrap := c_wrap_fn(oper)
	if wrap != "" and (cls == SC_SIGNED or cls == SC_UNSIGNED) {
		em.used_rt = true

		return c_narrow_wrap(em, t, f"{wrap}({a}, {b})")
	}
	return f"({a} {c_binop(oper)} {b})" if cls != SC_SIGNED and cls != SC_UNSIGNED

	# Only a FULL-WIDTH unsigned needs the u64 family. A narrower one (a `byte`) fits an
	# int64 exactly, so it computes there and narrows back, which is what lets one set of
	# helpers cover every width the language has. `uint` is the one that does not fit: sent
	# through the signed helpers it would raise on values it holds perfectly well.
	unsigned := cls == SC_UNSIGNED and c_scalar_bits(t) >= 64
	fn_name := c_arith_fn(oper, unsigned)
	return f"({a} {c_binop(oper)} {b})" if fn_name == ""

	# `used_rt` is only ever RAISED. It says the program needs the runtime, and clearing it
	# on the way past a non-arithmetic operator withdrew a claim somebody else had made —
	# the list element vtables went undeclared and cc reported them.
	em.used_rt = true
	wide := c_arith_wide(unsigned)

	# a SHIFT carries the OPERAND's width, because that is what bounds the distance: a byte
	# shifts within 8 even though the value travels as an i64. The unsigned helpers are only
	# ever chosen at 64 bits, so they take no width argument.
	return c_arith_narrow(em, t, f"{fn_name}(({wide})({a}), ({wide})({b}), {c_scalar_bits(t)})") if (oper == "<<" or oper == ">>") and not unsigned
	return c_arith_narrow(em, t, f"{fn_name}(({wide})({a}), ({wide})({b}))")
}

# c_arith_wide is the C type the helpers compute in.
fn c_arith_wide(unsigned: bool) -> str {
	return "uint64_t" if unsigned

	return "int64_t"
}

# c_arith_fn names the runtime checker for an operator, or "" for one that has none. The
# wrapping `+%` / `-%` / `*%` are deliberately absent: they ARE the bare operator, and so are
# the bitwise three, which cannot fail.
fn c_arith_fn(oper: str, unsigned: bool) -> str {
	stem := c_arith_stem(oper)

	return "" if stem == ""

	return f"zrt_{stem}_u64" if unsigned

	return f"zrt_{stem}_i64"
}

fn c_arith_stem(oper: str) -> str {
	return "add" if oper == "+"
	return "sub" if oper == "-"
	return "mul" if oper == "*"
	return "div" if oper == "/"
	return "mod" if oper == "%"
	return "shl" if oper == "<<"
	return "shr" if oper == ">>"

	return ""
}

# c_arith_narrow keeps a narrow result narrow. The helpers work in 64 bits — a byte's or a
# rune's operands promote there in C anyway — so the result comes back through the SAME
# checked conversion `byte(x)` is, and `byte(255) + byte(255)` is the 510 that raises rather
# than the 254 it silently wrapped to. Going through c_conv_scalar rather than spelling the
# call out is what keeps the target's bound stated in one place.
#
# The question is the WIDTH, not the name: every scalar under 64 bits narrows, so a `rune`
# arriving here is covered by the same sentence a `byte` is. Asking `c_is_byte` instead let
# a rune multiply overflow its int32 storage in silence.
fn c_arith_narrow(mut &em: Emitter, t: ast.Ty, call: str) -> str {
	return f"({call})" if c_scalar_bits(t) >= 64

	return c_conv_scalar(em, c_scalar_class(t), c_scalar_bits(t), ast.Ty.TInt, t, call)
}

# c_narrow_wrap is c_arith_narrow for an operator that WRAPS, and the difference is the whole
# point of the `%` spelling. The value travels as an i64, so the wrap happens at 64 bits and
# then has to come back — and coming back through the CHECKED conversion is the raise the
# operator exists to opt out of. `byte(255) +% byte(1)` aborted with
# "integer conversion out of range" instead of answering `0`: the wrapping form became an
# alias for the operator it was written to avoid, at the one width where the difference shows.
#
# ONLY A NARROW UNSIGNED TARGET wraps here, and that is a decision rather than a limitation. A
# C cast to `uint8_t` is a defined truncation, which IS the wrap; a `rune` is `int32_t`, where
# the same cast is implementation-defined — and a rune's values are a PREDICATE and not a
# range (docs/core/types.md), so there is no bit pattern to wrap onto in the first place. A
# rune keeps the checked narrow, which is what refuses a surrogate.
fn c_narrow_wrap(mut &em: Emitter, t: ast.Ty, call: str) -> str {
	return f"({call})" if c_scalar_bits(t) >= 64
	return c_arith_narrow(em, t, call) if c_scalar_class(t) != SC_UNSIGNED

	return f"(({c_type(t)})({call}))"
}

# c_narrow_unsigned is the one shape c_narrow_wrap does anything for, asked on its own so the
# unary path can decide whether to pay for c_infer at all.
fn c_narrow_unsigned(t: ast.Ty) -> bool {
	return c_scalar_class(t) == SC_UNSIGNED and c_scalar_bits(t) < 64
}

# c_is_int_lit reports whether an expression is an integer literal written out in the
# source, which is what makes `-1` a constant rather than a negation.
pub fn c_is_int_lit(x: ast.Expr) -> bool {
	return match x {
		Expr.EInt(_, _, _) => true
		_ => false
	}
}

# c_unexpr lowers a prefix operator. Like c_ternary it is a function only so its operand
# can be checked before it is rendered, a match arm having nowhere to put a statement.
fn c_unexpr(mut &em: Emitter, oper: str, x: ast.Expr, sb: Subst) -> str {
	check.chk_unary(em, oper, x)
	inner := c_expr(em, x, sb)

	# unary `-` has exactly one overflow — the type's minimum, which has no positive
	# counterpart — and negating it is undefined in C. `-%` is the wrapping form and stays
	# the bare operator, the same pairing the binary three have.
	#
	# `-1` is the SPELLING of a negative constant, not an operation on 1 — the literal is
	# already range-checked, and routing it through the runtime would pull the checked
	# helper into every program that writes a negative number.
	#
	# The type is asked for only here: c_infer walks the operand's whole subtree and opens a
	# scope on the way, and every `not` in the program would otherwise pay for it.
	if oper == "-" and not c_is_int_lit(x) {
		t := c_infer(em, x)
		if c_neg_checked(t) {
			em.used_rt = true

			return c_arith_narrow(em, t, c_neg_call(t, inner))
		}
	}

	# `~` AND `-%` COMPUTE AT THE TYPE'S WIDTH, and C will do neither on its own: both operands
	# travel as an i64, so `~b` for a `byte` answered the 64-bit complement —
	# `18446744073709551603` where the specified answer is `243` — and `-%b` answered `-1`
	# where it is `255`. The result was right only where it landed straight back in a `byte`
	# slot, because the BINDING's conversion narrowed it; printed or converted, the width
	# leaked. That is the shape this file's worst defects have: an answer that is correct in
	# the one spelling a test naturally reaches for.
	#
	# The operator is asked FIRST and the type only after, because c_infer walks the operand's
	# whole subtree — every `not` in the program would otherwise pay for a question about two
	# operators it is not.
	if oper == "~" or oper == "-%" {
		t := c_infer(em, x)
		return c_narrow_wrap(em, t, f"({c_unop(oper)}{inner})") if c_narrow_unsigned(t)
	}
	return f"({c_unop(oper)}{inner})"
}

# c_neg_checked reports whether unary `-` on this type goes through a checked helper: every
# integer does, and `float` and `bool` do not.
fn c_neg_checked(t: ast.Ty) -> bool {
	cls := c_scalar_class(t)
	return cls == SC_SIGNED or cls == SC_UNSIGNED
}

# c_neg_call picks the helper. An UNSIGNED type has no negative values at all, so ZERO is
# the only one it can negate — a narrow unsigned reaches that answer through the i64 helper
# and the narrowing check after it, and `uint` cannot, because its top half is not int64's.
# Left with C's wrap, it gave `-u` the answer `-%u` is the way to ask for.
fn c_neg_call(t: ast.Ty, inner: str) -> str {
	return f"zrt_neg_u64((uint64_t)({inner}))" if c_scalar_class(t) == SC_UNSIGNED and c_scalar_bits(t) >= 64

	return f"zrt_neg_i64((int64_t)({inner}))"
}

# c_is_test lowers `x is Name`. An Err is the one value in the language carrying a runtime
# type tag — its `kind` — so an error-kind test is a comparison of that tag, exactly as the
# seed lowers it. Every other `x is T` is a general runtime type test, which needs tags no
# value carries this phase; it is refused BY NAME here rather than lowered to something
# that reads as a bool. Both refusals matter more than they look: until this function
# existed the `is` token was consumed by nobody and dropped, so a test emitted a stray `0;`
# and an undeclared `zg_<Name>` — C that cannot be traced back to the Zerg that meant it.
fn c_is_test(mut &em: Emitter, x: ast.Expr, name: str, sb: Subst) -> str {
	t := c_infer(em, x)
	kind := c_err_kind(name)

	raise c_diag(em, rule.Rule.NotYetIsErrorKind, f"NotImplemented: `is {name}` — an `is` test names one of the built-in error kinds here, and `{name}` is not one; GRAMMAR#cmp-expr takes any `type-name`, so this is a narrower test than the grammar writes") if kind == 0
	raise c_diag(em, rule.Rule.IsWantsErr, f"`is {name}` wants an Err on its left, found a {ast.ty_name(t)}") if not c_is_err_ty(t)

	# EXACTLY THIS KIND. `is` asks what a value IS, and the built-in taxonomy is not part of
	# that question — `e in ValueError` is, and it is a different operator at the same
	# precedence. Asking one of them both ways is how `is` stopped being able to tell an
	# IOError from something an IOError was raised from.
	return f"(({c_expr(em, x, sb)}).kind == {kind})"
}

# c_in_container lowers `x in xs` and `k in m` — the two sets whose members are VALUES rather
# than types. It is one function because they differ only in how the question is asked of the
# runtime: a map hashes the key (zrt_map_has, which the runtime has carried since maps landed,
# documented as "the `k in m` membership test" and called by nothing), and a list has to look.
#
# THE MEMBER MEETS THE ELEMENT TYPE like any other value entering a declared slot, through
# chk_slot_fits — so `1 in xs` for a `list[byte]` is the literal adopting `byte`, and a `str`
# looked for in a `list[int]` is refused with the sentence every other slot uses.
#
# THE SET IS DROPPED ONLY IF THIS EXPRESSION OWNS IT. `xs` names storage somebody else holds
# and is read in place; `f()` hands back a list nobody else does, and without the drop every
# `v in f()` leaked the whole buffer. c_owns_value is the same polarity the carrier temporaries
# use, asked in one place rather than spelled again here.
fn c_in_container(mut &em: Emitter, x: ast.Expr, set: ast.Expr, st: ast.Ty, sb: Subst) -> str {
	em.used_rt = true

	elem := c_in_elem_ty(st)

	# an AGGREGATE has no `==` of its own — the same refusal `a == b` gives, for the same
	# reason: a structural comparison is what a derived impl would supply and none is generated
	raise c_diag(em, rule.Rule.NotYetInOverNoEq, f"NotImplemented: `in` over {ast.ty_name(st)} — its elements are compared with `==`, and {ast.ty_name(elem)} has none") if c_is_aggregate(em, elem)

	n := c_tmp(em, "zgt_in")
	sv := n + "s"
	kv := n + "k"
	rv := n + "r"
	bt := c_type(ast.Ty.TBool)
	et := c_type(elem)

	give := c_in_give(em, set, st, sv)

	head := f"{c_type(st)} {sv} = {c_expr(em, set, sb)}; {et} {kv} = {c_fit_copied(em, "the value looked for by `in`", elem, x, sb)};"

	return f"({{ {head} {bt} {rv} = zrt_map_has(&{sv}, &{kv});{give} {rv}; }})" if c_is_map(st)

	iv := n + "i"
	at := f"(*({et} *)zrt_list_at_ref(&{sv}, {iv}))"

	nv := n + "n"

	# the LENGTH is read once: zrt_list_len is a call into another translation unit, so asking
	# it in the condition is one call per element rather than one for the loop
	return f"({{ {head} {bt} {rv} = false; size_t {nv} = zrt_list_len(&{sv}); for (size_t {iv} = 0; {iv} < {nv}; {iv}++) {{ if ({c_in_eq(at, kv, elem)}) {{ {rv} = true; break; }} }}{give} {rv}; }})"
}

# c_in_elem_ty is what a member of this set is: a list's element, a map's KEY. `in` asks a map
# about its keys, because that is what `m[k]` needs to know before it reads.
fn c_in_elem_ty(st: ast.Ty) -> ast.Ty {
	return c_list_elem(st) if c_is_list(st)

	return c_map_key_ty(st)
}

# c_in_give is what the set owes on the way out, or "" when it names storage this expression did
# not make. c_owns_value is the same polarity the carrier temporaries ask, and it answers the
# whole question here rather than handing back a name the caller re-tests for "".
fn c_in_give(mut &em: Emitter, set: ast.Expr, st: ast.Ty, sv: str) -> str {
	return "" if not c_owns_value(set)

	return f" {c_drop_fn(em, st)}(&{sv});"
}

# c_in_eq compares one element with the value looked for, the way `==` does it — a str through
# strcmp, everything else with C's own `==`. Written here rather than routed through c_binexpr
# because that one takes EXPRESSIONS and both sides of this are already-rendered C.
fn c_in_eq(at: str, kv: str, elem: ast.Ty) -> str {
	return f"strcmp({at}, {kv}) == 0" if c_is_str(elem)

	return f"{at} == {kv}"
}

# c_set_says names the set on the right of an `in` for a diagnostic. A RANGE is asked about by
# SHAPE rather than by type: nothing infers one yet, so asking c_infer answered `?` and the
# refusal named nothing a reader had written.
#
# It names the range's ELEMENT, because a bare "a range" no longer tells a reader anything:
# `v in lo..hi` is built now, and what is left refused is a range of something the bounds test
# cannot compare — so the type IS the finding, and the lower bound is what carries it.
fn c_set_says(mut &em: Emitter, set: ast.Expr) -> str {
	return match set {
		Expr.ERange(lo, _, _) => f"a range of {ast.ty_name(c_infer(em, lo))}"
		_ => ast.ty_name(c_infer(em, set))
	}
}

# c_in_range lowers `v in lo..hi` — GRAMMAR#range-expr makes a range's MEMBERS its set, and
# membership in a run of numbers is the pair of comparisons its bounds spell: `v >= lo` and
# `v < hi`, `<=` for the inclusive `..=`, and the lower bound alone for the open `lo..`, which
# has no upper bound to compare against.
#
# THE SUBJECT IS EVALUATED ONCE. The test names `v` at each bound, and `v` is an expression
# rather than a name — so splicing its lowering in twice does not ask the same question twice,
# it runs the program's code twice: `f() in 1..10` called `f()` once per bound, and the second
# call landed AFTER the lower bound, so the count and the order were both wrong. c_ordered
# binds each operand of the run to a temporary in source order, which is the machinery an
# argument list and an operator pair already use, and it answers both at once.
#
# The trigger is c_needs_order asked from index 0 rather than 1, and that is the whole
# difference between this form and every other run. The usual rule exempts the FIRST operand
# because nothing precedes it; here the first operand is the one written twice, so its second
# reading comes after every bound and any operand that can run code makes the order visible.
fn c_in_range(mut &em: Emitter, x: ast.Expr, set: ast.Expr, sb: Subst) -> str {
	lo := c_range_lo(set)
	hi := c_range_hi(set)
	open := c_is_nil_lit(hi)

	# THE RUN IS THE SUBJECT AND ITS BOUNDS, in the order they are written. An absent upper
	# bound is an open range and is not part of it at all — there is nothing to compare
	# against and nothing to evaluate.
	mut run := [x, lo]
	if not open {
		run.append(hi)
	}

	# WHAT C CAN COMPARE, and nothing wider. The lowering below writes C's `>=` and `<`
	# straight out, so a `str` bound would compare two POINTERS — the silent wrong answer
	# `"zzz" < "aaa"` was fixed for, arriving by a second route — and an aggregate has no
	# comparison at all. Refused by name rather than lowered, which is what the rest of `in`
	# does with a set it cannot read.
	off := c_in_range_offender(em, run)
	return c_in_refuse(em, set, f"a range's members are found by comparing its bounds, and {off} is not a type this compiler compares that way") if off != ""

	# THE OPERANDS MEET EACH OTHER as the comparisons they are. Writing the C by hand means
	# nothing else asks whether a subject and a bound are types `>=` relates — an optional, a
	# `type X = Y`, an int against a float — so the two comparisons are put to the same rule
	# `a >= b` goes through.
	check.chk_binary(em, ">=", c_infer(em, x), c_infer(em, lo), x, lo)
	if not open {
		check.chk_binary(em, c_range_cmp(set), c_infer(em, x), c_infer(em, hi), x, hi)
	}

	seq := c_needs_order(run, 0)
	sx := c_ordered(em, seq, c_expr(em, x, sb))
	slo := c_ordered(em, seq, c_expr(em, lo, sb))
	return f"(({sx}) >= ({slo}))" if open

	shi := c_ordered(em, seq, c_expr(em, hi, sb))
	return f"(({sx}) >= ({slo}) && ({sx}) {c_range_cmp(set)} ({shi}))"
}

# c_range_cmp is the comparison the UPPER bound is made with, which is the only thing `..` and
# `..=` differ by: an exclusive range stops before its bound and an inclusive one stops on it.
fn c_range_cmp(set: ast.Expr) -> str {
	return "<=" if c_range_incl(set)

	return "<"
}

# c_in_range_offender names the first operand of the bounds test whose type C's `>=` means
# nothing about, or "" when every one of them is fine. A `str` is compared by `strcmp` and an
# aggregate is not compared at all, so neither can be spliced into the C the lowering writes.
fn c_in_range_offender(mut &em: Emitter, run: list[ast.Expr]) -> str {
	mut i := 0
	for i < run.len() {
		t := c_infer(em, run[i])
		return ast.ty_name(t) if c_is_str(t) or c_is_aggregate(em, t)
		i = i + 1
	}
	return ""
}

# c_in_refuse is the ONE place `E9062` is reported from. Two rules answer with it — a set that
# is none of the three `in` reads, and a range whose bounds cannot be compared — and a code is
# an identity, so the sentence differs and the identity does not.
#
# It says WHERE (c_diag), which is the trailer docs/conformance.md owes every diagnostic and
# which this one had not got. `reject-fuzz` is what found it: retype one binding to `str` and
# the guard `x if x in 1..=3` two lines down is refused with nowhere to go and look.
fn c_in_refuse(mut &em: Emitter, set: ast.Expr, why: str) -> str {
	raise c_diag(em, rule.Rule.NotYetInOverType, f"NotImplemented: `in` over {c_set_says(em, set)} — {why}")
}

# c_in_test lowers `x in s` — is `x` a MEMBER of the set `s`?
#
# What a set is depends on what names it, and docs/surface/grammar.md gives `in` one rule for
# all of them: a container names its elements, a range names its members, and an ERROR KIND
# names itself and everything below it in the taxonomy. All three are read here; what is left
# refused is a set that is none of them, and it is named rather than emitted — a membership
# test that silently answered about the wrong set would be worse than one that says it is not
# built.
#
# It is the SUBJECT on the left, like `is` — `e in ValueError`, never `ValueError in e`. The
# reversed spelling reads as "this error has a ValueError inside it", which is the CAUSE chain,
# and telling those two apart is the whole reason `in` exists separately from `is`.
fn c_in_test(mut &em: Emitter, x: ast.Expr, set: ast.Expr, sb: Subst) -> str {
	name := c_ident_name(set)
	kind := c_err_kind(name)

	# WHAT SET IS THIS. A name the taxonomy knows is one; a container is the other, and
	# anything else is asked what its TYPE is so the refusal names the set the reader wrote
	# rather than the branch that happened to be taken.
	if kind == 0 {
		# A RANGE IS ASKED ABOUT BY SHAPE. Nothing infers a range type — a range used as a
		# VALUE is still refused — so the only range that reaches `in` is one written at the
		# operator, and c_infer would answer `?` about it.
		return c_in_range(em, x, set, sb) if c_is_range(set)

		st := c_infer(em, set)
		return c_in_container(em, x, set, st, sb) if c_is_list(st) or c_is_map(st)

		return c_in_refuse(em, set, "this compiler reads `in` over a list, a map, a range, or an error kind")
	}

	t := c_infer(em, x)
	raise c_diag(em, rule.Rule.InWantsErr, f"`in {name}` wants an Err on its left, found a {ast.ty_name(t)}") if not c_is_err_ty(t)

	em.used_rt = true

	return f"zrt_err_in({c_expr(em, x, sb)}, {kind})"
}

# c_is_aggregate reports the types C cannot compare with `==`: a declared struct, and the
# runtime containers. An enum is not one — its tag is compared above — and neither is a
# carrier, whose `==` is refused by the null-safety rules before it reaches here.
# c_is_cmp_op is the operators whose meaning on an aggregate comes from a derived impl.
fn c_is_cmp_op(oper: str) -> bool {
	return oper == "==" or oper == "!=" or oper == "<" or oper == ">" or oper == "<=" or oper == ">="
}

fn c_is_aggregate(mut &em: Emitter, t: ast.Ty) -> bool {
	# an ENUM is a composite too, and it was the one this predicate did not name: `f"{c}"`
	# on a `Color` cast the tagged union to int64_t and cc reported it against generated C.
	# Its rendering is `int(c)` — the discriminant — which the programmer has to write,
	# because a NAME for the variant is what `Display` would give and there is none.
	return true if c_is_enum_ty(em, t)

	return c_is_struct_name(em, c_named_of(t)) or c_is_list(t) or c_is_map(t) or c_is_tuple(t)
}

# c_is_enum_ty reports whether a type is a declared enum (a TNamed matching an enum).
pub fn c_is_enum_ty(mut &em: Emitter, t: ast.Ty) -> bool {
	return c_is_enum_name(em, c_named_of(t))
}

# c_conv lowers a type conversion. bytearray(str) goes through the emitted string helper
# and the scalar casts are plain C casts; `str(x)` is the one that reads its SOURCE type.
#
# `str` is two conversions wearing one name. Over a `list[byte]` it is the bridge back to a
# string — the meaning every `str(out)` in this tree relies on. Over anything else it is
# c_typedef_conv lowers `X(v)` for a `type X = Y`. The VALUE is converted to Y — with every
# range check that conversion owes, since a `type Small = byte` narrows exactly as `byte`
# does — and the result is then named X by the C typedef, which is a cast that changes no
# bits because X and Y are the same representation.
#
# The distinctness is entirely in the type: nothing here makes an X behave differently from a
# Y at runtime, and nothing should. What makes `Celsius` a type is that every rule in
# check.zg sees TNamed("Celsius") and not TInt.
fn c_typedef_conv(mut &em: Emitter, name: str, x: ast.Expr, sb: Subst) -> str {
	under := c_typedef_of(em, name)

	# a typedef this compiler could not make sense of — an underlying type nothing declares,
	# or one it does not build over — renders as a plain cast. The DECLARATION has already
	# said what is wrong; converting into it would raise about the use instead, which buries
	# the cause under a consequence at every call site.
	return f"(({c_type(ast.Ty.TNamed(name))})({c_expr(em, x, sb)}))" if c_is_unknown(under)

	return f"(({c_type(ast.Ty.TNamed(name))})({c_conv(em, under, x, ast.ty_name(under), sb)}))"
}

# chk_call_arity_exact is the one-argument rule a conversion has. A conversion takes the
# value it converts and nothing else, so `Celsius()` and `Celsius(1, 2)` are both wrong, and
# saying so here is what keeps args[0] from being read off an empty list.
fn chk_call_arity_exact(mut &em: Emitter, name: str, n: int) {
	return if n == 1

	check.chk_at(em, rule.Rule.ConvOneValue, f"`{name}(…)` converts ONE value — `type {name} = …` declares a type, and a conversion into it takes the value it is built from")
}

# `display()`: the text a value shows as, which is what `print` writes and what an
# f-string's `{x}` interpolates.
#
# Dispatching on the source is what makes the second of those exist at all. Emitting the
# bridge unconditionally handed `zgs_from_bytes` an `int64_t`, so `str(n)` was not a thing
# anyone could write — a cc type error with no Zerg diagnostic in front of it. The three
# display leaves are already in the runtime header for the seed's f-strings.
fn c_conv(mut &em: Emitter, ty: ast.Ty, x: ast.Expr, nm: str, sb: Subst) -> str {
	# the operand is rendered by the paths that emit it — the identity, bridge and
	# override returns above them answer through c_copied or a method call instead, so a
	# cell rendered here first would be built and thrown away
	xt0 := c_infer(em, x)

	# A CONSTANT KNOWN TO FAIL IS REPORTED NOW. docs/core/types.md says so of `byte(300)` by
	# name — "the value is known, the conversion is known to raise" — and the rule was built for
	# the literal ADOPTING a type (`b: byte = 300`) and never wired to the WRITTEN conversion,
	# which is the spelling the sentence uses. chk_const_into is that rule; all it needed was a
	# caller that has a target and a literal in hand, which is exactly what this is.
	#
	# It is asked of a scalar target only, and only of an all-literal operand: a conversion of a
	# VALUE is checked where it runs, which is what makes it a conversion rather than a constant.
	# NOT NOTED: a written conversion shows its type on the page, which is exactly what L502
	# reports the absence of — and `b'\n'` desugars to this very node, so noting it told the
	# reader to "write `byte(10)`" about a line that already said `b'\n'`.
	check.chk_conv_const(em, ty, x)

	# `uint(18446744073709551615)` IS THE MOST EXPLICIT SPELLING THERE IS, and it was the one
	# still refused: a conversion's operand is rendered before the target reaches c_conv_scalar,
	# so the literal met c_int_dec's `int` bound and reported a value it could not hold. The
	# target is in hand right here, which is the same reason c_into can answer for a typed
	# position — and the conversion is a no-op besides, the value already being of the type.
	return c_uint_lit(x) if c_is_uint(ty) and c_is_wide_uint_lit(x)

	if c_is_str(ty) {
		em.used_str = true
		em.used_rt = true

		# `str(s)` on a str is the identity, and the identity of a BORROW is a borrow — but
		# the expression it came from is a call, and every rule downstream reads a call as a
		# value nobody else holds. `s2 := str(s)` therefore bound a cell it had never taken a
		# reference to, and both names released it; an f-string's `{s}` lowers through here
		# too, so the same one-line hole was under every interpolated string. Copying makes
		# the answer match the shape: what leaves here is owned, as from any other call.
		return c_copied(em, xt0, x, sb) if c_is_str(xt0)
		if c_is_list(xt0) {
			# THE WAY BACK from the code points, and the mirror of `runearray(s)`: these two
			# round-trip, where the byte bridge round-trips only what was valid UTF-8 to
			# begin with. It takes the list by value like the byte bridge below, and for the
			# same reason.
			return f"zrt_str_from_runes({c_copied(em, xt0, x, sb)})" if c_is_rune(c_list_elem(xt0))

			# Otherwise ONLY a `list[byte]`. The bridge reinterprets the buffer as characters,
			# so `f"{xs}"` on a `list[int]` printed the low byte of each element and on a
			# `list[list[int]]` printed the low bytes of a heap POINTER. `print xs` refuses
			# a composite; this hole let the same value out through an f-string hole.
			raise c_diag(em, rule.Rule.StrOfListElement, f"`str(…)` over a list bridges bytes or code points, and this is {ast.ty_name(xt0)} — a composite has no rendering of its own, so render its elements") if not c_is_byte(c_list_elem(xt0))

			# zrt_str_from_bytes CONSUMES the list — it drops it on the success path and on
			# the raise, so a caller passing a temporary owes no post-call drop that an
			# unwind would skip. That means it must be handed a list nobody else holds: a
			# fresh rvalue goes straight in, and one that NAMES storage is copied first.
			# The old zgs_from_bytes borrowed instead, so substituting one for the other
			# without this dropped the caller's own list out from under it — a double drop
			# the moment the binding's own release ran, and heap corruption before that.
			return f"zrt_str_from_bytes({c_copied(em, xt0, x, sb)})"
		}

		# A USER OVERRIDE WINS before the built-in leaves are consulted: a type that
		# declares `display()` (or `debug`, its default) renders through it — this is the
		# path an f-string hole and `str(x)` share, so one dispatch serves both. The call
		# answers a fresh owned cell, exactly what this branch's other returns answer, so
		# the concat and print paths downstream release it the same way. A mis-shaped
		# override (the "" state) already earned its finding at the declaration; an inert
		# placeholder lets that finding print instead of a raise about a missing rendering.
		if meth := c_render_override(em, xt0) {
			return c_expr(em, ast.Expr.EMethod(x, meth, []), sb) if meth != ""
			return "\"\""
		}

		c_display_check(em, xt0, "this rendering")
		return c_display(xt0, c_expr(em, x, sb))
	}
	if c_is_list(ty) {
		em.used_str = true
		em.used_rt = true

		# `list[T](x)` is the str -> bytes BRIDGE and nothing else. Anything but a str was
		# emitted as `zgs_to_bytes(x)` and reported by cc — `list[int]([1,2,3])` as
		# "passing 'zrt_list' to parameter of incompatible type 'const char *'".
		raise c_diag(em, rule.Rule.ListConvOfNonStr, f"`list[…](…)` converts a `str` to its bytes, and this is {ast.ty_name(xt0)} — a list is built with `[…]`, not converted into") if not c_is_str(xt0)

		# THE TWO BRIDGES OUT OF A STR, and they answer different questions: `bytearray(s)`
		# is the raw octets and `runearray(s)` the code points it is UTF-8 for. A str with
		# any non-ASCII in it has different lengths under the two, which is the whole reason
		# the language spells both rather than picking one.
		inner := c_expr(em, x, sb)

		return f"zrt_str_runes({inner})" if c_is_rune(c_list_elem(ty))
		raise c_diag(em, rule.Rule.ListConvElementType, f"`list[{ast.ty_name(c_list_elem(ty))}](…)` — a `str` bridges to its bytes as `list[byte]` or its code points as `list[rune]`") if not c_is_byte(c_list_elem(ty))

		return f"zrt_str_bytes({inner})"
	}

	# `int(v)` over an enum reads its DISCRIMINANT (GRAMMAR#variant), which is the tag field —
	# not the value, which is a struct. Casting the struct is what this used to emit, and C
	# rejected it against a file in .zerg-cache that nobody wrote.
	xt := c_infer(em, x)

	# a CARRIER is not a value to convert: `int(k)` where k is a `K?` used to cast the
	# carrier struct, which cc rejected against generated code. The unwrap is the language's
	# and has to be written.
	raise c_diag(em, rule.Rule.ConvOfOptional, f"`{nm}(…)` converts a value, and {ast.ty_name(xt)} may not have one — unwrap it first with `??`, `!` or `if v := …`") if c_is_carrier(xt)
	if c_is_enum_ty(em, xt) {
		raise c_diag(em, rule.Rule.IntOnPayloadEnum, f"enum `{c_named_of(xt)}` carries a payload, so its tag is opaque and match-only — `int(v)` reads the discriminant of an enum whose every variant is fieldless") if not c_is_flat_enum(em, c_named_of(xt))

		# `int(v)` is the ONE conversion an enum has. Every other one fell through to a plain
		# C cast OF THE STRUCT, which cc rejected against generated code — the report this
		# compiler exists to get in front of.
		raise c_diag(em, rule.Rule.EnumConvOnlyInt, f"an enum converts to `int` — its discriminant — and to nothing else, so `{nm}(…)` over `{c_named_of(xt)}` is not a conversion the language has") if not c_is_int(ty)

		return f"((int64_t)({c_expr(em, x, sb)}).tag)"
	}

	# A `str` SOURCE is PARSED, never re-constructed: `int(s)` / `uint(s)` / `float(s)` read
	# the number's text through the runtime, raising ValueError on a malformed string and
	# OverflowError on one out of range (docs/runtime/builtins.md, "Parsing a string").
	#
	# Falling through to the cast below reinterpreted the str's POINTER as the target, and
	# the two halves of that failed differently: `int("42")` printed an address with no
	# diagnostic at all, while `float("3.5")` was reported by cc against generated C. The
	# runtime helpers have existed since the seed emitted them; this compiler simply never
	# reached them.
	if c_is_str(xt) {
		em.used_rt = true

		inner := c_expr(em, x, sb)

		return f"zrt_parse_uint({inner})" if c_is_uint(ty)
		return f"zrt_parse_int({inner})" if c_is_int(ty)
		return f"zrt_parse_float({inner})" if c_is_float(ty)

		# A CHECKED rule rather than a refusal: which targets read a number out of a str is
		# the language's answer and no future feature adds to it, so it belongs on the diag
		# list with the place the conversion was written. `0` stands in for the value it
		# would have built; the C after a finding is discarded.
		check.chk_at(em, rule.Rule.ConvNotFromStr, f"`{nm}(…)` does not parse a `str` — only `int(s)`, `uint(s)` and `float(s)` read a number out of one")
		return "0"
	}

	# WHICH PAIRS EXIST IS THE CHECKER'S QUESTION, and it is asked here rather than below,
	# because the lowering answers by SHAPE and so has an answer for every pair of scalars —
	# including the four docs/core/types.md declares absent.
	check.chk_conv_pair(em, ty, xt, nm)

	# The target's shape comes from its TYPE. It used to come from the SPELLING for `uint`
	# alone, because the type it parsed to was TInt and the class table could not tell the
	# two apart — a `uint` was a spelling rather than a type, and the deviation that admitted
	# it stood right here. TUint answers for itself now.
	return c_conv_scalar(em, c_scalar_class(ty), c_scalar_bits(ty), xt, ty, c_expr(em, x, sb))
}

# The conversion-relevant SHAPE of a scalar: what the value is, independent of how wide it
# is. This is the seed's `sema.ScalarClass` (src/bootstrap/internal/sema/convert.go), ported
# rather than re-derived — the two compilers have to agree about which conversions are
# lossless, and stating the rule twice in two shapes is how they stop agreeing.
const SC_NONE := 0
const SC_SIGNED := 1
const SC_UNSIGNED := 2
const SC_FLOAT := 3
const SC_BOOL := 4

# c_scalar_class answers a type's scalar class, or SC_NONE for a type that is not a
# convertible scalar. A `str` deliberately has none: it is PARSED, which c_conv handles
# above, and a value is built from it with `bytearray(s)` rather than cast.
pub fn c_scalar_class(t: ast.Ty) -> int {
	return SC_SIGNED if c_is_int(t) or c_is_rune(t)
	return SC_UNSIGNED if c_is_byte(t) or c_is_uint(t)
	return SC_FLOAT if c_is_float(t)
	return SC_BOOL if c_is_bool_ty(t)

	return SC_NONE
}

pub fn c_scalar_bits(t: ast.Ty) -> int {
	return 8 if c_is_byte(t)
	return 32 if c_is_rune(t)
	return 1 if c_is_bool_ty(t)

	return 64
}

# c_lossless reports whether every value of the source shape is representable in the
# target's, which is what lets the conversion stay a plain C cast with no range check and
# no runtime call. It is the seed's `sema.Lossless`, rule for rule.
fn c_lossless(sc: int, sb: int, dc: int, db: int) -> bool {
	# `bool(x)` is a zero test and never out of range; widening INTO a float never raises,
	# because an out-of-range float is ±Inf, which docs/core/types.md makes an IEEE value
	# rather than an abort.
	return true if dc == SC_BOOL or dc == SC_FLOAT
	return true if sc == SC_BOOL

	if dc == SC_SIGNED {
		return sb <= db if sc == SC_SIGNED

		# an unsigned source needs one more bit than it has, for the sign
		return sb < db if sc == SC_UNSIGNED
	}
	if dc == SC_UNSIGNED {
		return sb <= db if sc == SC_UNSIGNED

		# a signed source may be negative, which no unsigned target holds
		return false if sc == SC_SIGNED
	}
	return false
}

# The target's bounds, rendered as C. The 64-bit ends use <stdint.h>'s macros: the decimal
# spelling of INT64_MIN is not a C integer constant — it parses as a negation of a value one
# past INT64_MAX — and UINT64_MAX needs a suffix to stay unsigned. The float forms are the
# same bounds as doubles, where the 64-bit text rounds to 2^63 / 2^64, which is what the
# helper's open-interval test wants.

# ALL FIVE OF THESE ARE ONE TABLE, asked five ways: the C text of a bound for the integer
# paths, the C text of the same bound as a double for the float paths, and the NUMBER for
# the rule in check.zg that compares a literal against it at compile time.
#
# They used to answer for 64 and then fall through to the 8-bit bound for everything else,
# which was a correct table while `byte` was the only narrow type — and then `rune` arrived
# at 32 bits, took the byte bounds, and `rune('é') raised OverflowError on a value every rune
# holds. A range check whose range is wrong is worse than none, because it is trusted.
#
# The integer forms are <stdint.h>'s own names, which the emitted header already includes.
# That is not only shorter than a decimal: `INT32_MAX` in generated C says which width was
# meant, where `2147483647` leaves the reader to count digits. The fixed-width ladder
# docs/core/types.md adds as stdlib types needs nothing here but a c_scalar_bits arm.
fn c_signed_lo(bits: int) -> str {
	return f"INT{strconv.to_string(bits, 10)}_MIN"
}

fn c_signed_hi(bits: int) -> str {
	return f"INT{strconv.to_string(bits, 10)}_MAX"
}

fn c_unsigned_hi(bits: int) -> str {
	return f"UINT{strconv.to_string(bits, 10)}_MAX"
}

# The float pair cannot use those names — the comparison is done as a double, so the bound
# has to arrive as one — so they render the number and add the point. `c_bound_*` is what
# keeps them the same bound as the three above rather than a second opinion about it.
fn c_float_lo(bits: int) -> str {
	return strconv.to_string(c_bound_lo(SC_SIGNED, bits), 10) + ".0"
}

fn c_float_hi(dc: int, bits: int) -> str {
	return "18446744073709551615.0" if dc == SC_UNSIGNED and bits >= 64
	return "9223372036854775807.0" if bits >= 64

	return strconv.to_string(c_bound_hi(dc, bits), 10) + ".0"
}

# c_bound_lo / c_bound_hi are the bounds as NUMBERS, for the rule that compares a literal
# against them at compile time rather than emitting a comparison into C. A literal the
# checker says fits and the conversion says does not is exactly the drift these exist to
# prevent, so both read this.
pub fn c_bound_lo(cls: int, bits: int) -> int {
	return 0 if cls == SC_UNSIGNED

	return 0 - c_pow2(bits - 1)
}

pub fn c_bound_hi(cls: int, bits: int) -> int {
	return c_pow2(bits) - 1 if cls == SC_UNSIGNED

	return c_pow2(bits - 1) - 1
}

# c_pow2 is 2^n, stopping at the last one an i64 holds. The 64-bit bounds never come through
# here — they are named rather than computed, because INT64_MIN has no spelling as a C
# integer constant: written out it parses as the negation of a value one past INT64_MAX.
fn c_pow2(n: int) -> int {
	mut v := 1
	mut i := 0
	for i < n and i < 62 {
		v = v * 2
		i = i + 1
	}
	return v
}

# c_conv_scalar lowers `T(x)` between two scalars. Zerg converts by RE-CONSTRUCTION and a
# value that does not fit the target ABORTS with OverflowError (docs/runtime/builtins.md),
# so a NARROWING conversion goes through the runtime's checked helper while one the shapes
# prove lossless stays a plain C cast and costs nothing.
#
# Every conversion here used to be that plain cast, whatever the widths, which is C's
# truncation wearing Zerg's syntax: `byte(300)` gave 44, and `int(1e30)` was undefined
# behaviour that happened to print INT64_MAX. Both are the OverflowError the documentation
# promises and the seed already raises.
#
# The target's shape arrives as (dc, db) rather than being read off `ty`, so this stays a
# lowering over SHAPES — a width and a signedness — and the fixed-width ladder the spec adds
# as stdlib types needs nothing here. `ty` is still passed for the C type to cast to.
fn c_conv_scalar(mut &em: Emitter, dc: int, db: int, xt: ast.Ty, ty: ast.Ty, inner: str) -> str {
	# a `type X = Y` SOURCE converts as the Y it is represented by — `int(c)` on a `Celsius`
	# is the way back out, and it is the only place the representation is looked through,
	# because a conversion is exactly where the two types are meant to meet. The REPR is what
	# the guard below asks about too: a typedef whose underlying type nothing declares has
	# already been reported at its declaration, and raising here as well would bury that
	# sentence under one about the use.
	xr := c_repr_of(em, xt)
	sc := c_scalar_class(xr)

	# NOT A SCALAR ON EITHER SIDE. Naming only the aggregates left `TChan`, `TErr` and an
	# unresolved `TNamed` falling through to the cast below — the same class this whole
	# function exists to close, one type-family over. TUnknown keeps the plain cast: a type
	# inference could not work out is not evidence the program is wrong.
	raise c_diag(em, rule.Rule.ScalarConvOfNonScalar, f"`{ast.ty_name(ty)}(…)` converts a scalar, and {ast.ty_name(xt)} is not one") if sc == SC_NONE and not c_is_unknown(xr)

	return f"(({c_type(ty)})({inner}))" if sc == SC_NONE or c_lossless(sc, c_scalar_bits(xt), dc, db)

	em.used_rt = true
	ct := c_type(ty)

	# A RUNE's values are NOT A RANGE. U+D800..U+DFFF are surrogates — they exist only
	# inside UTF-16 and are not characters — so a rune is the one scalar target a (lo, hi)
	# pair cannot state, and the one that needs a predicate. zrt_conv_rune is that
	# predicate's only spelling in the emitted C, and it is the same zrt_is_rune the UTF-8
	# validator and the encoder ask: "a single valid Unicode code point" is one sentence.
	#
	# Without it a rune target took the generic signed-32 check, so `rune(0xD800)` and
	# `rune(0x110000)` both answered with a value that is not a character — caught much
	# later, at whatever str it was put into, or never.
	#
	# A widening source never reaches here (byte -> rune is lossless above, and correctly
	# so: no byte is a surrogate), which leaves only the sources that can actually miss.
	return f"(({ct})zrt_conv_rune({c_conv_to_i64(sc, inner)}))" if c_is_rune(c_repr_of(em, ty))

	# float -> integer truncates toward zero, and the helper's bounds are the TRUNCATED
	# value's, so 255.7 converts to 255 while 256.0 raises. NaN and the infinities fail the
	# same comparisons and abort on the same path.
	if sc == SC_FLOAT {
		return f"(({ct})zrt_conv_u_from_f((double)({inner}), {c_float_hi(dc, db)}))" if dc == SC_UNSIGNED

		return f"(({ct})zrt_conv_i_from_f((double)({inner}), {c_float_lo(db)}, {c_float_hi(dc, db)}))"
	}
	if dc == SC_UNSIGNED {
		return f"(({ct})zrt_conv_u_from_u((uint64_t)({inner}), {c_unsigned_hi(db)}))" if sc == SC_UNSIGNED

		return f"(({ct})zrt_conv_u_from_i((int64_t)({inner}), {c_unsigned_hi(db)}))"
	}
	return f"(({ct})zrt_conv_i_from_u((uint64_t)({inner}), {c_signed_hi(db)}))" if sc == SC_UNSIGNED

	return f"(({ct})zrt_conv_i_from_i((int64_t)({inner}), {c_signed_lo(db)}, {c_signed_hi(db)}))"
}

# c_conv_to_i64 brings a scalar to the int64 a bound test reads it as. A float cannot be
# cast there directly — an out-of-range double is undefined in C — so it goes through the
# same truncating range check `int(x)` is, and NaN and the infinities abort on that path
# rather than on the one after it.
fn c_conv_to_i64(sc: int, inner: str) -> str {
	return f"zrt_conv_i_from_f((double)({inner}), {c_float_lo(64)}, {c_float_hi(SC_SIGNED, 64)})" if sc == SC_FLOAT

	return f"(int64_t)({inner})"
}

# c_render_override answers the whole three-state rendering question in one place: which
# method, if any, a value of `t` renders through. `print`, an f-string hole and `str(…)`
# all ask here first, which is what makes an override an override: a `type X = Y` scalar
# used to render its underlying number with the impl never consulted, and a struct's was
# refused outright by the composite [not yet] below even when the impl supplied exactly
# the rendering that refusal says is missing.
#
#   nil          the type declares neither `display` nor `debug` — the structural
#                refusal downstream owns the answer.
#   "display" /  the override to dispatch through — "debug" when only that one is
#   "debug"      declared, since display's DEFAULT is debug (docs/runtime/format.md).
#                Only a method with the OVERRIDE SHAPE — the receiver alone, by value,
#                answering `str` — is answered.
#   ""           declared but MIS-SHAPED. chk_render_overrides has already made that a
#                finding at the declaration, so the caller emits an inert placeholder
#                instead of raising its own refusal — a raise ends the run before
#                collected findings print, and "a composite needs the structural Display"
#                about a program that plainly wrote one is the wrong sentence. The
#                placeholder never reaches cc: a finding ends the build first.
#
# One answer rather than an override/mis-shaped pair of questions, because the pair made
# every rendering site call both in the right order — and the second re-scanned what the
# first had just scanned.
fn c_render_override(mut &em: Emitter, t: ast.Ty) -> str? {
	nm := c_named_of(t)

	return nil if nm == ""
	return "display" if c_render_shape_ok(em, nm, "display")
	return "debug" if c_render_shape_ok(em, nm, "debug")
	return "" if c_has_method(em, nm, "display") or c_has_method(em, nm, "debug")

	return nil
}

# c_render_shape_ok is whether `recv` declares `meth` with the override contract's shape:
# one parameter (the receiver the parser prepends), taken by value, answering `str`.
# chk_render_overrides holds a declaration to the same rows, so what the checker approves
# and what this dispatches cannot drift apart.
pub fn c_render_shape_ok(mut &em: Emitter, recv: str, meth: str) -> bool {
	key := c_sig_key(recv, meth)
	row := c_sig_row(em, key)

	return false if row < 0
	return false if em.sig_nparams[row] != 1
	return false if not em.sig_hasret[row]

	return c_is_str(em.sig_rets[row]) and not c_param_is_ref(em, key, 0)
}

pub fn c_param_is_ref(mut &em: Emitter, key: str, idx: int) -> bool {
	row := c_param_row(em, key, idx)
	return false if row < 0
	return em.pr_ref[row]
}

# c_display is the runtime leaf that renders one scalar as its display text. A `byte` goes
# through the unsigned one, and anything whose type did not survive inference falls to the
# integer one — where the C cast is what reports it, rather than this pass guessing.
# c_display is the runtime leaf that renders one SCALAR. A composite has no rendering here
# — the structural one is `Display`'s job and there is no derive for it — so it is named
# rather than cast, which is what reached cc as "operand of type 'zg_P'".
fn c_display_check(mut &em: Emitter, t: ast.Ty, where: str) {
	# an ENUM's advice is not a struct's: it has variants and not fields, and the thing a
	# reader can actually write is the discriminant
	raise c_diag(em, rule.Rule.NotYetRenderEnumAsText, f"NotImplemented: rendering a {ast.ty_name(t)} as text — an enum has no name for its variant without the structural `Display` this compiler does not generate; `int(v)` gives its discriminant, or `match` it") if c_is_enum_ty(em, t)
	raise c_diag(em, rule.Rule.NotYetRenderAsText, f"NotImplemented: rendering a {ast.ty_name(t)} as text — a composite needs the structural `Display` this compiler does not generate; render its fields") if c_is_aggregate(em, t) or c_is_carrier(t)

	# NIL IS NOT A THING TO RENDER, and it is asked here because this is the one gate the
	# three rendering positions share — `print x`, an f-string's `{x}` and `str(x)`. A `fn`
	# with no `-> type` answers nil, so `print f()` cast a `void` to `long long` and cc
	# reported it against C nobody wrote; a written `print nil` cast nothing at all and
	# printed a number. `where` is the caller's, because a rendering reached from an f-string
	# hole is not the `print` a reader wrote.
	#
	# AFTER the two above, so a composite holding nil keeps the composite's own sentence: a
	# `list[…]` has no rendering whatever it holds, and that is the more useful thing to say.
	check.chk_no_nil_value(em, t, where)
}

fn c_display(t: ast.Ty, inner: str) -> str {
	return match t {
		Ty.TBool  => f"zrt_display_bool({inner})"
		Ty.TFloat => f"zrt_display_float((double)({inner}))"
		Ty.TByte  => f"zrt_display_uint((uint64_t)({inner}))"
		Ty.TUint  => f"zrt_display_uint({inner})"

		# an Err shows as what went wrong, the same text `print e` writes — the third
		# spelling of one question, which fell to the integer arm and cast a `zrt_err`
		# to `long long` for cc to report. The copy is zrt_str_dup's own reason: a msg
		# may be a managed payload, an immortal cell or a raised literal, and the caller
		# releases what this answers.
		Ty.TErr => f"zrt_str_dup(({inner}).msg)"
		_       => f"zrt_display_int((int64_t)({inner}))"
	}
}

# c_index lowers `xs[i]` to a runtime list read, casting the element pointer to the
# element C type inferred for the target.
fn c_index(mut &em: Emitter, target: ast.Expr, idx: ast.Expr, sb: Subst) -> str {
	em.used_rt = true
	tty := c_infer(em, target)

	# a CARRIER is not a thing to index: `a[0]` on a `list[int]?` handed the runtime the
	# carrier struct where a list header goes, which cc reported as a WARNING — so the
	# program linked and segfaulted. The unwrap is the language's and has to be written.
	raise c_diag(em, rule.Rule.IndexOfOptional, f"`[…]` indexes a value, and {ast.ty_name(tty)} may not have one — unwrap it first with `??`, `!` or `if v := …`") if c_is_carrier(tty)

	# A `str` was whitelisted by the guard below and rejected by the statement after it —
	# one rule about one type, held in two places that said opposite things. It is asked
	# once, here, and the guard no longer mentions it.
	if c_is_str(tty) {
		check.chk_str_not_indexable(em)

		return "0"
	}

	raise c_diag(em, rule.Rule.IndexOfNonContainer, f"`[…]` indexes a list or a map, and this is {ast.ty_name(tty)}") if not c_is_list(tty) and not c_is_map(tty) and not c_is_unknown(tty)

	return c_map_index(em, target, idx, tty, sb) if c_is_map(tty)

	# A LIST INDEX IS AN INT, and it was the last container slot with no rule at all. The map's
	# KEY gained one and this did not, so the subscript accepted anything: `xs["a"]` reached cc,
	# and `xs[1.5]` and `xs[true]` COMPILED AND RAN — the float silently truncated to 1 by a C
	# conversion cc only warned about, the bool read as 1. A wrong answer from a subscript is
	# the worst place to have one, since the reader's next question is about the element.
	#
	# `int` and nothing else: a `byte` or a `rune` index is a written `int(b)` away, and letting
	# either through here would be a position converting a value, which is the rule this whole
	# chapter turns on.
	c_list_index_int(em, idx)
	return c_slice(em, target, idx, tty, sb) if c_is_range(idx)

	ct := c_type(c_list_elem(tty))

	# the TARGET keeps the write mode and the INDEX does not: `xs[js[0]] = 9` writes into
	# `xs` and reads `js`, and unsharing `js` for it would be a copy nobody asked for
	w := em.lv_write
	tgt := c_expr(em, target, sb)
	em.lv_write = false
	ix := c_expr(em, idx, sb)
	em.lv_write = w

	at := c_list_at_fn(w)

	# c_is_PLACE and not c_is_lvalue: the type-blind question calls `m[k]` an lvalue, and
	# it is not — it lowers to a statement expression, so `c["k"][0]` took the address of
	# an rvalue and cc said so about C nobody wrote. c_is_place is the same question with
	# the types that tell them apart, and it is what the mutating-method path already asks.
	return f"(*({ct}*){at}(&({tgt}), {ix}))" if c_is_place(em, target)

	# A CALL OR CONVERSION RESULT IS AN RVALUE: it is materialised so its address can be
	# taken, and — because nothing else will ever name it — given back here. `print
	# (<-lists)![0]` receives a whole list, reads one element out of it and used to walk away
	# from the rest.
	#
	# The element is read out BEFORE the drop and copied if it owns anything, because it is a
	# slot in the buffer that is about to be freed. The temporaries are numbered from em.tmp_n
	# rather than fixed, so `f()[g()[0]]` cannot shadow the name the outer one is holding.
	ln := c_tmp(em, "zgt_t")
	vn := c_tmp(em, "zgt_t")
	et := c_list_elem(tty)
	slot := f"(*({ct}*){at}(&{ln}, {ix}))"
	mut val := slot
	if c_needs_copy(em, et) {
		val = c_copy_of(em, et, slot)
	}
	return f"({{ zrt_list {ln} = {tgt}; {ct} {vn} = {val}; zrt_list_drop(&{ln}); {vn}; }})"
}

# c_list_at_fn picks the runtime slot accessor. They differ by exactly one thing — the
# write one unshares the buffer first — and choosing between them is the whole of what
# the compiler owes copy-on-write. Getting it wrong the safe way (always unsharing) makes
# every indexed read duplicate a buffer; getting it wrong the other way lets a write
# through one name be seen through another, which is the language's value semantics.
fn c_list_at_fn(write: bool) -> str {
	return "zrt_list_at" if write
	return "zrt_list_at_ref"
}

# c_lvalue lowers an expression that is being WRITTEN to. It is c_expr with the write
# mode on, which is where the mode belongs: an assignment target is the only thing that
# knows it is one, and it is exactly one node above the indexes that need to know.
fn c_lvalue(mut &em: Emitter, e: ast.Expr, sb: Subst) -> str {
	# saved and RESTORED, the discipline c_index thirty lines up already follows. Clobbering
	# to false is correct only while nothing lowers an lvalue inside one, which is a
	# property of today's callers rather than of this function.
	w := em.lv_write
	em.lv_write = true
	out := c_expr(em, e, sb)
	em.lv_write = w
	return out
}

# c_is_place is c_is_lvalue WITH TYPES: an expression that names storage a caller can take
# the address of. `m[k]` is the one that needs them — it looks like an index and lowers to a
# statement expression, so it is a value however much it reads as a place. c_is_lvalue is
# type-blind and cannot tell the two indexes apart.
# A place is a place ALL THE WAY DOWN. `mk().xs` is an lvalue by shape — a field access —
# and its target is a call, which has no address, so `&(mk().xs)` reached cc. The question
# is about the whole path and was asked only about the last step.
pub fn c_is_place(mut &em: Emitter, e: ast.Expr) -> bool {
	return false if not c_is_lvalue(e)
	return false if c_is_index(e) and c_is_map(c_infer(em, c_index_target(e)))

	# a bare name is where the recursion stops: it is storage, and it has no target
	return true if c_ident_name(e) != ""

	return c_is_place(em, check.chk_store_target(e))
}

# c_place_why names what an expression is, for the diagnostic above.
# It names the step of the path that is NOT storage, which is not always the expression it
# was handed: `mk().xs[0] = 9` fails at `mk()`, and calling the whole thing "a call result"
# is true of the call and not of the `mk().xs` this was asked about. c_is_place became a
# whole-path question and this is its other half.
pub fn c_place_why(mut &em: Emitter, e: ast.Expr) -> str {
	return "a map index" if c_is_index(e) and c_is_map(c_infer(em, c_index_target(e)))
	return "a slice" if c_is_index(e) and c_is_range(c_index_key(e))
	return "a call result" if c_ident_name(e) == "" and not c_is_lvalue(e)

	# an lvalue by SHAPE whose path stops being storage further down — name where it stops
	return c_place_why(em, check.chk_store_target(e)) if c_is_lvalue(e) and c_ident_name(e) == ""

	return "a call result"
}

# c_meth_mutates reports the list methods that write through their receiver.
#
# IT IS A NAME LIST BECAUSE A BUILT-IN METHOD HAS NO DECLARATION. `mut fn` is where every
# other mutating method carries the fact, and a `list` is a runtime type: `append` is
# declared nowhere, so there is no `mut this` to read and the knowledge has to live in the
# compiler. That makes this line the "one rule, N slots" shape, and these are the slots — a
# method added to one and not the others is the defect:
#
#   here                 whether the receiver is lowered as a PLACE, and whether it is
#                        judged at all: BOTH E3088 (the receiver must be `mut`) and E3089
#                        (the collection is frozen inside its own `for`) are keyed off this
#                        answer, so a mutating method missing from it turns both rules off
#                        for itself, silently.
#   c_list_method_on     the lowering, which raises on a name it does not build
#   c_list_method_ret    the type the call answers
#
# The last two already refuse a name they do not know, so a method added there alone cannot
# get past them; this one is the permissive slot, and it is the one to update FIRST when
# `insert`, `remove`, `retain` or `clear` lands.
pub fn c_meth_mutates(meth: str) -> bool {
	return meth == "append"
}

fn c_is_lvalue(e: ast.Expr) -> bool {
	return match e {
		Expr.EIdent(_) => true
		Expr.EField(_, _) => true
		Expr.EOptChain(_, _) => false
		Expr.ETry(_) => false
		Expr.EIndex(t, i) => not c_is_range(i)
		_ => false
	}
}

# `target.meth(args)` is FOUR different things wearing one syntax, told apart by what the
# target's type turns out to be:
#
#   * a LIST target      — the runtime list methods (len / append);
#   * a VALUE receiver   — a method on a named type, called as `zg_<Type>_<meth>` with the
#                          receiver passed first, since the parser made `this` parameter 0;
#   * a FIELD holding a function — `this.action(c)` calls the callback the value carries,
#                          which is a different thing from a method of the same name;
#   * anything else      — a module-qualified free call (`ascii.is_digit`), emitted as the
#                          bare mangled function, because a module flattens into this unit
#                          and `ascii` is a namespace rather than a value.
#
# The order matters and so does the last case being the fallback: a module name infers to
# no type at all, so it can never be mistaken for a receiver. The reverse mistake — a
# receiver read as a namespace — would emit a call to a function nothing declares, which
# the C compiler rejects. Neither way is silent.
#
# Which one it is has to be decided identically when the call is EMITTED and when it is
# TYPED, so it is decided once, here, and both ask. Deciding it twice is how the two drift.
enum MethKind {
	MList
	MMap
	MErr
	MCarrier
	MRecv
	MFnField
	MFree
}

fn c_meth_kind(mut &em: Emitter, tty: ast.Ty, meth: str) -> MethKind {
	return MethKind.MList if c_is_list(tty)
	return MethKind.MMap if c_is_map(tty)

	# EVERY method on an `Err`, not only the three that exist. An `Err` has no declaration
	# to carry a method, so anything else would fall to the namespaced-call arm and be
	# emitted as a free function nobody declared — which is the shape this table's own
	# comment says must not happen. c_err_method names what it does not have.
	return MethKind.MErr if c_is_err_ty(tty)

	# and every method on a CARRIER, for the same reason: `T?` and `Either[L, R]` are types
	# the compiler builds rather than a program declares, so neither has anywhere to hang one.
	return MethKind.MCarrier if ast.ty_is_opt(tty) or c_is_either(tty)
	return MethKind.MRecv if c_has_method(em, c_named_of(tty), meth)
	return MethKind.MFnField if c_is_fn(c_field_ty(em, c_named_of(tty), meth))

	return MethKind.MFree
}

fn c_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], sb: Subst) -> str {
	# `E.of(n)` is not a method on a value: the target NAMES A TYPE. It is answered before
	# inference is asked anything, because an enum name is not a binding and infers to
	# nothing — which is why this used to come out as "the method `of` on a ?".
	en := c_ident_name(target)
	return c_enum_of(em, en, meth, args, sb) if en != "" and c_is_enum_name(em, en)

	# `Either.Left(v)` written where nothing says WHICH Either. The target names a built-in
	# type rather than a value, so inference answers nothing about it and this used to come
	# out as "the method `Left` on a ?" — the same shape the enum line above was written for.
	# The sides of an Either are context-typed, so the honest complaint is the missing
	# context, and it is the one the unqualified spelling has always made.
	if c_either_qual(target, meth) != "" {
		c_either_no_context(em, f"{en}.{meth}")
	}

	tty := c_infer(em, target)
	recv := c_named_of(tty)
	return match c_meth_kind(em, tty, meth) {
		MethKind.MList => c_list_method(em, target, meth, args, tty, sb)
		MethKind.MMap => c_map_method(em, target, meth, args, tty, sb)
		MethKind.MErr => c_err_method(em, target, meth, args, sb)
		MethKind.MCarrier => c_carrier_method(em, target, meth, args, tty, sb)
		MethKind.MRecv => f"{c_fn_cname(recv, meth)}({c_recv_args(em, c_sig_key(recv, meth), target, args, sb)})"
		MethKind.MFnField => c_fnfield_call(em, recv, meth, target, args, sb)
		_ => c_free_method(em, target, meth, args, sb)
	}
}

# c_err_method is the `Error` interface on a caught `Err` — the three questions the error
# tier answers about a VALUE rather than about its kind. `is` and `in` ask which kind it is,
# and they were the only questions that could be asked at all: the message it was raised
# with, the error it was raised FROM, and its code were carried by the runtime value and
# reachable from no Zerg expression, so a `guard` handed back an error a program could
# classify and not read.
#
# `message` RETAINS. A `str` is refcounted and the one in the Err belongs to the Err; handing
# the caller that pointer without a retain would let the caller's drop free a string the Err
# still holds — and the Err outlives the read whenever it sits in a `Result`.
#
# `unwrap` answers `Err?` and not `Err`, because a cause is exactly what an error may not
# have: `raise e` records none and `raise e from c` records one. The runtime spells the
# absence as a NULL `cause`, and this is where that becomes a tag a `match` can read.
#
# `code` answers `byte?`, and answers it ABSENT — always, today. That is not a hedge: no
# `Err` this compiler can construct carries a code, because the only errors there are are the
# built-in kinds and a code belongs to a user-defined error type, which is `[not yet]`. The
# method exists so the shape is right when that arrives, and what it reports meanwhile is
# true rather than convenient.
fn c_err_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], sb: Subst) -> str {
	em.used_rt = true

	# NONE of the three takes an argument, and an argument list nobody reads is a question
	# the program asked that nothing answered: `e.message(1)` compiled, with the `1`
	# evaluated nowhere and mentioned by nothing.
	raise c_diag(em, rule.Rule.NotYetErrMethodArgs, f"NotImplemented: the method `{meth}` on an Err takes no argument") if args.len() != 0

	return f"zrt_str_dup(({c_expr(em, target, sb)}).msg)" if meth == "message"

	if meth == "unwrap" {
		cn := c_opt_name(em, ast.Ty.TErr)
		t := c_tmp(em, "zgt_ec")
		head := "({ zrt_err *" + t + " = (" + c_expr(em, target, sb) + ").cause; "
		return head + t + " != NULL ? (" + cn + "){ .tag = 0, .ok = *" + t + " } : (" + cn + "){ .tag = 1 }; })"
	}
	return "(" + c_opt_name(em, ast.Ty.TByte) + "){ .tag = 1 }" if meth == "code"

	raise c_err_method_unknown(em, meth)
}

# c_carrier_method is the bridge between the two carriers — the one conversion the error
# chapter offers and neither carrier had.
#
# `opt.ok_or(err)` reads an absent optional as a failure and names what the failure IS;
# `res.ok()` reads a failed Result as an absence and forgets why. They are not symmetric and
# should not be: going one way needs a reason supplied, going the other throws one away, and
# writing that out is the point of having both spellings rather than a cast.
#
# Without them `T?` and `Result[T]` were two islands. A function answering `int?` could not
# be given to one taking `Result[int]` by any expression a program could write, so the choice
# of carrier propagated outward through every signature that touched it.
#
# The LEFT PAYLOAD IS COPIED, not aliased. A fresh carrier is not an lvalue, so the coalesce
# and force paths treat it as this expression's own and drop it — which, with a shared
# payload, releases a `str` the source optional still holds. That is a use-after-free the
# `int` payloads in the corpus could not show, and the two conversions here are the path the
# errors chapter tells a reader to take.
#
# The Right is dropped by value on the `ok()` path, exactly as `??` drops it — the carrier
# held a copy and nothing releases it there either. That is one behaviour, not two, and if it
# is a leak it is the same leak in both places.
fn c_carrier_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], tty: ast.Ty, sb: Subst) -> str {
	if meth == "ok_or" and ast.ty_is_opt(tty) {
		raise c_diag(em, rule.Rule.NotYetOkOrNoArg, "NotImplemented: `ok_or` takes the error to answer an absence with, and none was given") if args.len() == 0
		raise c_diag(em, rule.Rule.NotYetOkOrManyArgs, "NotImplemented: `ok_or` takes ONE error to answer an absence with") if args.len() != 1

		# The argument is the RIGHT of the Result being built, so it has to be an `Err`.
		# Without the check `o.ok_or(3)` assigned an `int` to a `zrt_err` field and the
		# diagnostic came from cc, against a line of generated C.
		at := c_infer(em, args[0])
		raise c_diag(em, rule.Rule.NotYetOkOrNotErr, "NotImplemented: `ok_or` answers an absence with an `Err`, and this is a " + ast.ty_name(at)) if not c_is_err_ty(at)

		elem := c_opt_elem(tty)
		on := c_opt_name(em, elem)
		rn := c_carrier_name(em, elem, ast.Ty.TErr)
		t := c_tmp(em, "zgt_ko")
		r := c_tmp(em, "zgt_kr")

		# The error is evaluated BEFORE the branch, not inside the `else`. Arguments evaluate
		# in source order ([Memory Model](../../docs/core/memory.md)) and the short-circuit
		# forms are a closed set `ok_or` is not in, so an argument that printed or raised did
		# it only when the optional happened to be absent — a conditional side effect the
		# language does not have anywhere else, and one nothing marked.
		e := c_tmp(em, "zgt_ke")
		mut out := "({ " + c_type(ast.Ty.TErr) + " " + e + " = " + c_expr(em, args[0], sb) + "; "
		out = out + on + " " + t + " = " + c_expr(em, target, sb) + "; " + rn + " " + r + ";"
		out = out + " if (" + c_res_is_left(t) + ") { " + c_res_mark_left(r) + " " + c_res_ok(r) + " = " + c_res_taken(em, t, elem) + "; }"
		out = out + " else { " + c_res_mark_right(r) + " " + c_res_err(r) + " = " + e + "; }"
		return out + " " + r + "; })"
	}
	if meth == "ok" and c_is_either(tty) {
		raise c_diag(em, rule.Rule.NotYetOkTakesNoArg, "NotImplemented: `ok` forgets the Right and takes no argument") if args.len() != 0

		left := c_either_left(tty)
		cn := c_carrier_ty_cname(tty)
		on := c_opt_name(em, left)
		t := c_tmp(em, "zgt_ko")
		o := c_tmp(em, "zgt_kv")
		mut out := "({ " + cn + " " + t + " = " + c_expr(em, target, sb) + "; " + on + " " + o + ";"
		out = out + " if (" + c_res_is_left(t) + ") { " + c_res_mark_left(o) + " " + c_res_ok(o) + " = " + c_res_taken(em, t, left) + "; }"
		out = out + " else { " + c_res_mark_right(o) + " }"
		return out + " " + o + "; })"
	}

	raise c_carrier_method_unknown(em, tty, meth)
}

# c_carrier_method_ret is the typing half. `ok_or` names the Err side itself, so the answer
# is a `Result[T]` whatever the optional held; `ok` keeps the Left and drops the Right.
fn c_carrier_method_ret(mut &em: Emitter, tty: ast.Ty, meth: str) -> ast.Ty {
	return ast.Ty.TEither(c_opt_elem(tty), ast.Ty.TErr) if meth == "ok_or" and ast.ty_is_opt(tty)

	# Raising rather than answering `TUnknown` for the same reason c_err_method_ret does:
	# the two tables must agree about which names EXIST, and only a raise makes them.
	raise c_carrier_method_unknown(em, tty, meth) if meth != "ok" or not c_is_either(tty)

	return ast.Ty.TOpt(c_either_left(tty))
}

# c_err_method_ret is the same three answers, for the pass that types the call rather than
# emits it. The two tables are read by one `c_meth_kind`, so they cannot disagree about
# WHICH method this is; this is where they must agree about what it gives back.
fn c_err_method_ret(mut &em: Emitter, meth: str) -> ast.Ty {
	return ast.Ty.TStr if meth == "message"
	return ast.Ty.TOpt(ast.Ty.TErr) if meth == "unwrap"

	# It RAISES on a name it does not know, exactly as c_list_method_ret does and unlike
	# c_map_method_ret, which answers quietly. The two tables are read by one `c_meth_kind`,
	# so they cannot disagree about WHICH method this is — but they could disagree about
	# whether it EXISTS, and a fourth method added to the emit side alone would then infer
	# `TUnknown` and be reported somewhere far from here.
	raise c_err_method_unknown(em, meth) if meth != "code"

	return ast.Ty.TOpt(ast.Ty.TByte)
}

fn c_list_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], tty: ast.Ty, sb: Subst) -> str {
	em.used_rt = true

	# every list method takes the list's ADDRESS, and a slice, a call result or a map index
	# has none — it is materialised into a temp first so `xs[a..b].len()` is addressable.
	#
	# A method that MUTATES cannot be served that way: the temp is a copy, so the edit
	# lands on it and is lost. `m["a"].append(3)` did exactly that — it compiled, and the
	# append silently did nothing. A read-only method on a copy is the same answer as on
	# the original; a mutating one is not, and is refused rather than dropped.
	if not c_is_place(em, target) {
		raise c_diag(em, rule.Rule.NotYetMutateListRvalue, f"NotImplemented: `{meth}` MUTATES its list, and `{c_place_why(em, target)}` is a value rather than a place — bind it to a name first") if c_meth_mutates(meth)

		return c_list_method_rv(em, target, meth, args, tty, sb)
	}

	# A MUTATING METHOD reaches its receiver the way an assignment reaches its target, and
	# for the same reason: `d[0].append(5)` edits the inner list's HEADER, and that header
	# lives inside `d`'s buffer. Lowering the receiver as a read left the buffer shared, so
	# the header `c` sees grew a element too — the append went through `zrt_list_push`,
	# which unshares the INNER buffer and knows nothing about the outer one it sits in.
	#
	# And so it is JUDGED the way an assignment's target is, first: a `mut this` method
	# writes its receiver, so the binding it roots in must be `mut` and must not be the
	# collection an enclosing `for` is walking. Only the assignment forms used to ask, so
	# `xs.append(4)` on a plain `xs` grew the frozen half of the model in silence.
	if c_meth_mutates(meth) {
		check.chk_recv_mut(em, target, meth)
		return c_list_method_on(em, c_lvalue(em, target, sb), meth, args, tty, sb)
	}
	return c_list_method_on(em, c_expr(em, target, sb), meth, args, tty, sb)
}

# c_list_method_on is the lowering itself, given a target already rendered — so the lvalue
# and rvalue paths spell a method exactly the same way.
fn c_list_method_on(mut &em: Emitter, tgt: str, meth: str, args: list[ast.Expr], tty: ast.Ty, sb: Subst) -> str {
	return f"((int64_t)zrt_list_len(&({tgt})))" if meth == "len"

	# the guard asks `c_meth_mutates`, so the two cannot drift: a method added there and not
	# here raises rather than silently doing nothing, and one added here without being named
	# there cannot get past this line. `len` is the only read-only method, so everything
	# that reaches this point writes through its receiver — which is what decides whether
	# the receiver is lowered as a place.
	raise c_list_method_unknown(em, meth) if not c_meth_mutates(meth)

	if meth == "append" {
		# the element is copied INTO the list, so the list owns it and the caller's name
		# for it goes on being its own
		et := c_type(c_list_elem(tty))
		el := c_fit_copied(em, f"the element `{meth}` adds", c_list_elem(tty), args[0], sb)
		return "({ " + et + " zgt_le = " + el + "; zrt_list_push(&(" + tgt + "), &zgt_le); })"
	}
	return tgt
}

# c_ident_name is the name a bare identifier expression spells, or "" for anything else.
pub fn c_ident_name(e: ast.Expr) -> str {
	return match e {
		Expr.EIdent(n) => n
		_ => ""
	}
}

# c_enum_of lowers `E.of(n)` (GRAMMAR#variant): the variant whose discriminant is `n`, or nil.
# It answers a `E?` rather than an `E` because the reverse is PARTIAL — an integer that no
# variant claims has no variant to be, and the language's way of saying so is an optional.
#
# The discriminants are compile-time constants, so the membership test is written out as a
# chain of comparisons against them; the tag itself is the number, which is what makes the
# reverse a test and not a table.
fn c_enum_of(mut &em: Emitter, en: str, meth: str, args: list[ast.Expr], sb: Subst) -> str {
	# `Shape.Line(5)` — a variant CONSTRUCTOR named by its enum, the payload-carrying half
	# of `Color.Red`. It arrives here rather than at c_fieldref because a call is a method
	# shape, and `of` is the other thing an enum name answers.
	return c_variant_ctor(em, en, meth, args, sb) if c_is_variant_in(em, en, meth)

	raise c_diag(em, rule.Rule.NotYetEnumTypeMethod, f"NotImplemented: `{en}.{meth}(…)` — an enum type answers `of(n)` and its own variants, and `{meth}` is neither") if meth != "of"
	raise c_diag(em, rule.Rule.OfTakesOneInt, f"`{en}.of(n)` takes one integer — the discriminant to reverse") if args.len() != 1
	raise c_diag(em, rule.Rule.OfOnPayloadEnum, f"enum `{en}` carries a payload, so its tag is opaque and match-only — `of(n)` reverses the discriminant of an enum whose every variant is fieldless") if not c_is_flat_enum(em, en)

	cn := c_opt_name(em, ast.Ty.TNamed(en))
	n := c_expr(em, args[0], sb)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1

	v := "zgt_ofv" + tag
	r := "zgt_ofr" + tag

	mut test := ""
	mut i := 0
	for i < em.var_name.len() {
		if em.var_enum[i] == en {
			if test != "" {
				test = test + " || "
			}
			test = test + v + " == " + strconv.to_string(em.var_tag[i], 10)
		}
		i = i + 1
	}

	mut out := f"({{ int64_t {v} = {n}; {cn} {r};"
	out = out + f" if ({test}) {{ {c_res_mark_left(r)} {c_res_ok(r)} = (zg_{en}){{ .tag = (int32_t){v} }}; }}"
	return out + f" else {{ {c_res_mark_right(r)} }} {r}; }})"
}

# c_free_method is the last resort: a `target.meth(…)` whose target type carries no such
# method. It is a real call only when `meth` names a function — otherwise the old fallback
# emitted `zg_meth(…)` for a function nobody declared, and the diagnostic came from the C
# compiler pointing at generated code. `s.len()` is the common way in: a str has no
# methods here, and the message now says so at the Zerg level.
fn c_free_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], sb: Subst) -> str {
	# `Type.f(…)` is an ASSOCIATED FUNCTION (GRAMMAR#impl-decl) — the named-constructor form,
	# `User.from_json(…)`. A TYPE NAME on the left is how a reader spells one, and the
	# answer used to be "the method `make` on a ?": the target is a type rather than a
	# value, so inference had nothing to name and the message pointed at the hole rather
	# than at the form. The parser gives every `fn` in an `impl` a receiver, so there is no
	# such function to call yet — which is a thing to say, not a `?`.
	tn := c_ident_name(target)

	raise c_diag(em, rule.Rule.NotYetAssociatedFn, f"NotImplemented: `{tn}.{meth}(…)` is an associated function — this compiler gives every `fn` in an `impl` a receiver, so a method is reached through an instance (`x.{meth}(…)`) and never through its type") if tn != "" and c_is_struct_name(em, tn)

	# WHAT THE PREFIX NAMES, asked once (c_ns_kind) and answered here for both halves of a
	# qualified call. It used to be asked by NOBODY on this path: whatever stood to the left
	# of the dot was discarded and `meth` looked up in the one flattened function space, so
	# `bogus.shout(…)` and `util.shout(…)` compiled into the same call as the `text.shout(…)`
	# the file had imported.
	ns := c_ns_kind(em, target)
	if ns == NsKind.NsModule {
		# AND WHETHER THIS MODULE IMPORTED IT. A namespace is a real one — that is what
		# NsModule means — and being real is not the same as being this module's to write.
		check.chk_ns_bound(em, c_ns_root(target))

		# A NAMESPACED GENERIC — `testing.assert_raises(guard { … })`. A module's names flatten into
		# the one program-wide function space, so this IS the free function of that name,
		# and a template reached this way has to be instantiated exactly as one reached
		# directly. Asking the sig table first would find nothing, a template having no
		# signature.
		return c_call(em, meth, args, sb) if c_is_generic(em, meth)

		# a REAL module and a member no module declares — the same rule the field path
		# reports (c_fieldref), because it is the same mistake. Falling through said "the
		# method `x` on a ?", which describes the namespace as a value of no type rather
		# than as the module it is.
		if not c_name_in(em.sig_names, meth) {
			check.chk_no_member(em, tn, meth)
			return "0"
		}

		# AND THE MODULE THAT DECLARES IT IS THE ONE THE PREFIX NAMES. The flatten makes
		# every module's names reachable from one space, which is what made `b.helper()`
		# answer a `helper` module `a` declared — and print it. The member is `b`'s or it is
		# not `b`'s, and the sentence for the second is the one already written.
		if not c_ns_owns_fn(em, tn, meth) {
			check.chk_no_member(em, tn, meth)
			return "0"
		}

		# A NAMESPACED call names the module out loud — `lib.helper()` — which makes it the
		# one shape where the reader has said which module they mean, and the one where
		# reading a module-private name is unambiguous rather than accidental.
		c_chk_visible_fn(em, meth, c_sig_row_of(em, meth))

		return f"{c_fn_cname_in(em, check.c_mod_of(em, em.at_path), "", meth)}({c_call_args(em, meth, args, sb)})"
	}

	# AN INVENTED PREFIX. The finding is about the prefix and there is nothing further to
	# say about the call, so it is reported and the expression lowers to a constant the
	# discarded C never runs — exactly what c_ident_val does with the same finding.
	if ns == NsKind.NsUnknown {
		c_undefined_name(em, c_ns_root(target))
		return "0"
	}

	# THE RECEIVER IS THE FINDING when inference could not name its type, because the sentence
	# below can only spell that type as `?`. `io.stdout.write("x")` reported "the method
	# `write` on a ?" — a sentence about the method, when the mistake is that `io` has no
	# `stdout`. The rule for that exists (chk_no_member, reached from c_fieldref) and had
	# simply never been asked here: this path INFERS the receiver's type and never LOWERS it,
	# so a receiver that is itself ill-formed reaches the fallback undiagnosed. The same shape
	# is why E5002's case notes "the method `thing` on a ?" for a module that does not resolve.
	#
	# Lowering it asks the receiver's own rule, and a rule that answers is the whole finding —
	# nothing further is true about the method on a value that does not exist. The finding
	# count is what says one answered, because these rules are CHECKED: they record and carry
	# on, and the raise below would otherwise bury a precise sentence under a vague one.
	if c_is_unknown(c_infer(em, target)) {
		before := em.diags.len()
		lowered := c_expr(em, target, sb)
		return lowered if em.diags.len() > before
	}

	# `into` ON A BUILT-IN IS NOT A GAP, and the generic sentence below would call it one.
	# `NotImplemented` says a thing the language has and this compiler does not; the language
	# ships NO `Into` impl for any built-in type, because a conversion between them is written
	# `T(x)` and a value's text is `str(x)`, which every type already answers. So the reader is
	# told what to write rather than told to wait.
	c_no_builtin_into(em, meth, target)

	raise c_diag(em, rule.Rule.NotYetMethodOnType, f"NotImplemented: the method `{meth}` on a {ast.ty_name(c_infer(em, target))}")
}

# c_recv_args renders a method call's arguments: the receiver first, then the written
# ones. Their parameter indices are shifted by one against the table, because `this` holds
# index 0 there — get that wrong and a `mut &` argument is passed by value to the slot
# after the one that wanted its address.
fn c_recv_args(mut &em: Emitter, key: str, target: ast.Expr, args: list[ast.Expr], sb: Subst) -> str {
	# the receiver is parameter 0 and goes through c_arg like any other argument: a plain
	# method takes it BY VALUE, so it is copied, and a `mut fn` declared it `mut &`, so it
	# takes the caller's variable itself. Routing it here rather than copying it outright is
	# what makes `mut fn` work at all — and it brings the borrow's own rules with it, which
	# GRAMMAR#fn-decl asks for by name: "the call site must hold the receiver in a `mut`
	# binding". `pos` is 0 because a receiver has no written position; chk_ref_arg says
	# "the receiver" rather than an argument number for it.
	#
	# The receiver is also the run's FIRST OPERAND — it is evaluated before every written
	# argument, and C sequences it against them no better than it sequences them against
	# each other. So the order question is asked here, where the receiver is still in hand;
	# c_args_from below asks it again of the same list and gets the same answer, its `lead`
	# saying that this operand stands in front. A `mut fn`'s receiver is a `mut &` like any
	# other and is left where it stands for the same reason.
	seq := c_needs_order_args(args, c_ref_args(em, key, 1, args), 0)
	recv := c_ordered(em, seq and not c_is_ref_param(em, key, 0), c_arg(em, key, 0, 0, target, sb))
	return recv + c_args_from(em, key, 1, args, true, sb)
}

# c_call emits an enum-variant construction as a tagged-union literal, a struct
# construction as a plain compound literal (both are PascalCase constructors), and any
# other call as a function call.
# c_list_lit builds a list literal used AS A VALUE — passed to a function, returned,
# handed straight to a method. It lowers the way `append` does: allocate, then push each
# element in order, inside a statement expression that yields the list.
#
# Before this, a list literal in an expression emitted `(zrt_list){0}` and its ELEMENTS
# WERE DROPPED — `f([a, b])` silently passed an empty list. Nothing said so, which made it
# the worst kind of wrong: a program that ran and was simply not what was written.
#
# An empty literal keeps the zeroed form. It carries no element type of its own, so the
# one that fits comes from the declaration it initializes, and the binding and field paths
# already supply it.
# It takes its element type from the FIRST element, which is what a literal with no
# destination has to do. Where there IS a destination the declared type is better, and
# c_fit_copied supplies it — see c_list_lit_vals.
# c_fill_lit lowers `[v; N]` — the FILL form, which GRAMMAR#list-lit defines as "N copies of
# v". Copies of the VALUE, so v is evaluated ONCE. It used to expand into a list literal of N
# copies of the EXPRESSION, and the emitter then rendered that expression N times: `[bump(c);
# 3]` called `bump` three times and the list held 1, 2, 3 — three different values, from a
# form whose whole meaning is that they are the same one.
#
# The first push takes the value itself and every later one takes a COPY, because a push owns
# what it is given: pushing one refcounted cell N times would leave N slots sharing a count of
# one, and the second release of it is a free of live memory. A type that needs no copy skips
# it and every slot reads the same bytes, which is what a copy of a POD is anyway.
fn c_fill_lit(mut &em: Emitter, v: ast.Expr, n: ast.Expr, sb: Subst) -> str {
	elems := c_fill_elems(em, v, n)
	cnt := elems.len()

	# nothing to share: zero copies is the empty list, and one is a literal of one element,
	# which evaluates v exactly once already
	return c_list_lit(em, elems, sb) if cnt < 2

	em.used_rt = true

	ety := c_infer(em, v)
	et := c_type(ety)

	mut out := "({ zrt_list zgt_ll = zg_empty_list(sizeof(" + et + "), &" + c_elem_vt(em, ety) + ");"
	out = out + " " + et + " zgt_fv = " + c_expr(em, v, sb) + ";"

	mut i := 0
	for i < cnt {
		tmp := "zgt_fc" + strconv.to_string(i, 10)
		mut src := "zgt_fv"
		if i > 0 and c_needs_copy(em, ety) {
			src = c_copy_of(em, ety, "zgt_fv")
		}
		out = out + " " + et + " " + tmp + " = " + src + ";"
		out = out + " zrt_list_push(&zgt_ll, &" + tmp + ");"
		i = i + 1
	}
	return out + " zgt_ll; })"
}

fn c_list_lit(mut &em: Emitter, elems: list[ast.Expr], sb: Subst) -> str {
	return "(zrt_list){0}" if elems.len() == 0

	# COPIED, and this is the untyped twin of the rule c_elem_exprs states for a literal that
	# HAS a declared element type to render at. A push owns what it is handed — the buffer's
	# vtable drops every element the last holder still has — so an element rendered as a bare
	# lvalue makes the list a second owner of storage it never took a reference to, and the
	# first of the two drops takes it out from under the name it was read from.
	#
	# This is the ONE position that renders a literal with nothing to render it at: a match
	# arm body, where `Expr.EBinary(_, a, b) => [a, b]` builds a list out of two names. Every
	# other list literal in the language reaches c_fit_copied and is built element by element
	# at the declared type.
	ety := c_infer(em, elems[0])
	mut vals: list[str] = []
	for e in elems {
		vals.append(c_copied(em, ety, e, sb))
	}
	return c_list_lit_vals(em, ety, vals)
}

# c_list_lit_vals assembles the literal from ALREADY-RENDERED elements, so that the two
# callers can disagree about how an element is rendered while agreeing about everything else.
# They do disagree, and it matters: one has a declared element type to render AT and the other
# only has the elements. `xs: list[float] = [i, 2, 3]` for an `int` binding `i` built a buffer
# of int64_t bit patterns and read them back as doubles — it printed 5.92879e-323 — because
# the sizeof, the element vtable and every push came from the first element's type instead of
# the one the declaration named.
fn c_list_lit_vals(mut &em: Emitter, ety: ast.Ty, vals: list[str]) -> str {
	return "(zrt_list){0}" if vals.len() == 0
	em.used_rt = true

	et := c_type(ety)
	mut out := "({ zrt_list zgt_ll = zg_empty_list(sizeof(" + et + "), &" + c_elem_vt(em, ety) + ");"
	mut i := 0
	for i < vals.len() {
		tmp := "zgt_ll" + strconv.to_string(i, 10)
		out = out + " " + et + " " + tmp + " = " + vals[i] + ";"
		out = out + " zrt_list_push(&zgt_ll, &" + tmp + ");"
		i = i + 1
	}
	return out + " zgt_ll; })"
}

# c_call_written is what is left of a call that WROTE its type arguments. The form is gone —
# GRAMMAR makes a postfix `[ … ]` always an index, and the parser refuses `id[int](7)` — so
# the only brackets that still reach here are a BUILT-IN TYPE's own, from `map[K, V](…)`,
# which names a type rather than instantiating a generic.
#
# The branch that reported a written argument on a non-template went with the form: with the
# parser refusing it, no call can arrive here naming something that is not generic.
fn c_call_written(mut &em: Emitter, name: str, args: list[ast.Expr], ts: list[ast.Ty], sb: Subst) -> str {
	return c_call(em, name, args, sb) if ts.len() == 0

	# A BUILT-IN TYPE CONSTRUCTOR IS NOT A GENERIC FUNCTION, and the rule below says the
	# opposite: "`map` is not generic" is a false statement about `map[str, int]()`, which
	# names exactly the two type arguments `map` takes. What it has not got is a no-argument
	# constructor — an empty map is a literal — so that is what is named instead.
	#
	# c_builtin_check goes FIRST, because it owns every built-in name this compiler has not
	# got: `set[str]()` would otherwise be told how to write an empty one, and there is no
	# `set` here to write.
	c_builtin_check(em, name)
	raise c_diag(em, rule.Rule.NotYetGenericConstructor, f"NotImplemented: `{name}[…](…)` as a constructor — this compiler builds an empty map with the literal `{{:}}` and an empty list with `[]`, so a built-in container's type arguments come from what it is bound to") if name == "map"

	return c_call(em, c_instantiate_at(em, name, ts), args, sb)
}

# c_infer_call_written is the same choice for the pass that types a call rather than emits
# it. Both have to instantiate, because the specialization's signature is what carries the
# return type, and both have to pick the SAME one.
fn c_infer_call_written(mut &em: Emitter, name: str, args: list[ast.Expr], ts: list[ast.Ty]) -> ast.Ty {
	# It stays SILENT where the emit side reports: a written type argument on a name that is
	# not generic is one mistake, and one diagnostic is what it should produce.
	return c_lookup_sig_ret(em, c_instantiate_at(em, name, ts)) if ts.len() > 0 and c_is_generic(em, name)

	return c_infer_call(em, name, args)
}

fn c_call(mut &em: Emitter, name: str, args: list[ast.Expr], sb: Subst) -> str {
	if c_is_intrinsic(em, name) {
		check.chk_intrinsic_call(em, name, args)
		em.used_rt = true
		return f"{c_intrinsic(name)}({c_args(em, args, sb)})"
	}

	# a built-in error constructor, `ValueError("bad input")`. It is PascalCase, so without
	# this it reads as a struct constructor and emits a compound literal of a type nothing
	# declared — which cc rejects, loudly but a long way from the source that meant it.
	if c_err_kind(name) > 0 {
		raise c_diag(em, rule.Rule.TestableNotConstructible, f"`{name}` is testable but not constructible: a sender able to raise the end-of-stream sentinel would close its channel wearing it, and its consumer would read the crash as a clean finish") if not c_err_constructible(name)
		em.used_rt = true
		return f"zrt_err_new_kind({c_err_kind(name)}, {c_args(em, args, sb)})"
	}

	# calling a BINDING that holds a function: cast the stored generic pointer back to the
	# signature its type carries, then call through it
	bt := c_lookup_var(em, name)
	return f"({c_fnptr_cast(bt)}({c_ident_val(em, name, sb)}).fn)({c_ident_val(em, name, sb)}.env{c_args_after(em, bt, args, sb)})" if c_is_fn(bt)

	# A BINDING THAT IS NOT A FUNCTION SHADOWS ONE ALL THE SAME. The name is looked up as a
	# binding first, because a binding holding a function is a call — and when it holds
	# something else the walk fell through to the FUNCTION of that name, emitting a call to
	# `zg_f` while `f` was an int64_t in scope. cc reported "called object type 'int64_t' is
	# not a function or function pointer" against generated code; the reader wrote `f := 2`
	# above their `f()` and was told nothing about it. The rule is c_not_callable's, which a
	# `spawn` and a `defer` callee ask as well. Emission carries on into the function of that
	# name and the C is thrown away.
	if not c_is_unknown(bt) {
		c_not_callable(em, name, bt)
	}

	if token.name_is_type(name) {
		if c_is_variant(em, name) {
			c_bare_variant(em, name)

			# the bare spelling is already the finding; the enum it is built as is the one a
			# bare name resolves to, which is what c_bare_variant just told the reader to write
			return c_variant_ctor(em, c_variant_enum(em, name), name, args, sb)
		}

		# `Left(v)` and `Right(e)` are CONTEXT-TYPED: they name a side of an Either and have
		# no type of their own, so they are read where the wanted type is known (c_either_wrap)
		# and reaching here means there was no such place. Saying that is the difference
		# between a form used wrongly and a form that does not exist.
		if c_ctor_side_of(name, args.len()) >= 0 {
			c_either_no_context(em, name)
		}

		# A TYPEDEF NAME IS A CONVERSION, not a construction. `Celsius(20)` builds a Celsius
		# out of an int the way every conversion in this language builds its target — by
		# re-construction, never by reinterpreting — and `int(c)` is the way back. It goes
		# through the same c_conv the built-in scalars use, with the typedef's underlying
		# type standing in for the shape, so the range checks a narrowing owes are the ones
		# it already knows how to emit.
		if c_is_typedef(em, name) {
			chk_call_arity_exact(em, name, args.len())

			return c_typedef_conv(em, name, args[0], sb)
		}

		# A PascalCase call that names no declared type is not a constructor of anything.
		# It used to emit a compound literal of that name anyway, which cc rejected against
		# generated C.
		if not c_is_struct_name(em, name) {
			c_builtin_check(em, name)

			raise c_diag(em, rule.Rule.NoSuchTypeToConstruct, f"no type named `{name}` to construct")
		}

		# A CONSTRUCTION NAMES THE TYPE, which is the value position the declaration walk
		# cannot see: c_decl_sites lists what DECLARATIONS spell, and `Secret("s")` in a body
		# spells the same name with none of them involved.
		check.chk_ty_visible(em, name)

		return "(zg_" + name + "){" + c_struct_args(em, name, args, sb) + "}"
	}

	# A GENERIC CALL. The template is not a function and has no C symbol; the SPECIALIZATION
	# is, so the call is rewritten to name it and handed back to this same function — which
	# then finds an ordinary free function and applies the argument rules to a signature with
	# real types in it. Nothing below this line knows a generic was involved.
	return c_call(em, c_instantiate(em, name, args), args, sb) if c_is_generic(em, name)

	# NOTHING DECLARES THIS FUNCTION. It used to be spelled `zg_<name>(…)` and handed to
	# cc, which reported a call to an undeclared function against a file under .zerg-cache
	# — for a typo, or for one of the specified-but-unbuilt builtins (`addr`, `ptr`), which
	# is exactly the answer this should be giving by name.
	if not c_is_free_fn(em, name) {
		c_undefined_fn(em, name)
	}

	# The callee is a real free function, so the last two questions are whether this module
	# is allowed to name it and whether safe code may reach it. They are asked HERE and not
	# at the lookup above because the lookup answers for every shape of call — a method, a
	# constructor, an intrinsic — and only a plain function has a module and an `unsafe`
	# group that could be the wrong ones.
	#
	# ONE ROW FOR BOTH: they read different columns of the same signature row, and looking it
	# up once here is the difference between one scan of that table per call site and two.
	sr := c_sig_row_of(em, name)
	c_chk_visible_fn(em, name, sr)
	c_chk_bare_fn(em, name, sr)
	c_chk_unsafe_fn(em, name, "this call is in safe code", sr)

	rels := c_owned_args(em, name, 0, args)
	return c_call_releasing(em, c_fn_cname_in(em, check.c_mod_of(em, em.at_path), "", name), name, args, rels, sb) if c_any_owned(rels)

	return f"{c_fn_cname_in(em, check.c_mod_of(em, em.at_path), "", name)}({c_call_args(em, name, args, sb)})"
}

# c_sig_row_of is a free function's signature row, or -1 when nothing registered one. It is
# the ONE scan the two rules below share: each used to do its own, so a call site asking both
# walked ~1.7k rows twice and built the key twice — which is the very cost the table's comment
# on `sig_nparams` explains two precomputed integers were added to avoid.
fn c_sig_row_of(mut &em: Emitter, name: str) -> int {
	return c_sig_row(em, c_sig_key("", name))
}

# c_chk_visible_fn is the visibility rule for a free function, asked about the row its caller
# already has.
#
# A row of -1 is quiet. A generated declaration — a `derive`d impl, a monomorphized
# specialization — has no module a reader could have written, and a rule that guessed there
# would refuse programs for a reason nobody can act on.
fn c_chk_visible_fn(mut &em: Emitter, name: str, r: int) {
	return if r < 0

	check.chk_visible(em, name, em.sig_mod[r], em.sig_pub[r])
}

# c_chk_bare_fn is #57's rule for the one spelling that has no qualifier to check: a BARE
# call. It reads the same row the two rules above read, and is a third function for their
# reason — the question is different and the place it is asked is different, since a
# namespaced call has already said which file it means.
fn c_chk_bare_fn(mut &em: Emitter, name: str, r: int) {
	return if r < 0

	check.chk_name_is_this_file(em, name, em.sig_path[r])
}

# c_chk_unsafe_fn reads the same row for the `unsafe` group's caller rule. It is a second
# function rather than a second question inside the one above because the two rules are asked
# at different places: visibility is a call's business alone, and this one is also owed where
# a bare function NAME becomes a VALUE — `f := poke` would otherwise be one line away from
# making the rule mean nothing. The ROW is what they share, not the question.
#
# A row of -1 is quiet, for the reason the visibility rule is: a generated declaration was
# written by nobody, so there is no context a reader could have been in.
fn c_chk_unsafe_fn(mut &em: Emitter, name: str, what: str, r: int) {
	return if r < 0

	check.chk_unsafe_reachable(em, name, em.sig_unsafe[r], what)
}

# c_chk_visible_const is the same rule for a module constant, against the rows
# c_const_globals recorded. A name not in the table is quiet for the reason a missing sig
# row is: the reference is answered elsewhere, and this rule only speaks about a
# declaration whose module it knows.
fn c_chk_visible_const(mut &em: Emitter, name: str) {
	i := c_k_idx(em, name)
	return if i < 0
	check.chk_visible(em, name, check.c_mod_of(em, em.k_decls[i].path), em.k_decls[i].is_pub)
}

# c_k_idx is a name's row in the module-constant table (k_decls and the k_tys beside it),
# or -1 when no module declares it. It exists because a module-QUALIFIED read must be
# answered from these rows and nowhere else: resolving `lib.COUNT` through the environment
# read the innermost live binding of `COUNT`, so a local of that name answered a question
# that named `lib`. It is also how "does any module declare this name" is asked, since the
# names are a field of the rows rather than a list of their own.
fn c_k_idx(mut &em: Emitter, name: str) -> int {
	mut i := 0
	for i < em.k_decls.len() {
		return i if em.k_decls[i].name == name
		i = i + 1
	}
	return -1
}

# c_struct_args emits a struct constructor's arguments, giving each field's type as
# context so an empty-list argument is initialised correctly.
fn c_struct_args(mut &em: Emitter, sname: str, args: list[ast.Expr], sb: Subst) -> str {
	# MORE arguments than the struct has fields reached cc as an "excess elements in struct
	# initializer" WARNING, so it compiled and the extra values were dropped. Too few has
	# been named since c_struct_rest existed; this is the same question from the other side.
	n := c_struct_field_n(em, sname)
	raise c_diag(em, rule.Rule.StructLiteralFieldCount, f"`{sname}` has {strconv.to_string(n, 10)} fields and this gives {strconv.to_string(args.len(), 10)}") if args.len() > n

	# A CONSTRUCTION IS AN ARGUMENT LIST TOO. It lowers to a C compound literal, whose
	# initializers C17 leaves unsequenced against each other exactly as it leaves a call's
	# arguments — so `P(a(), b())` needs the same temporaries `f(a(), b())` needs, and for
	# the same reason.
	seq := c_needs_order(args, 1)

	mut out := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + c_ordered(em, seq, c_field_init(em, check.chk_field_says(em, sname, i + 1), c_struct_field_ty_at(em, sname, i), args[i], sb))
		i = i + 1
	}
	return out + c_struct_rest(em, sname, args.len(), args.len() > 0, sb)
}

# c_struct_rest fills the fields a construction left off the end. GRAMMAR group 7: there
# are NO zero values — a field with no default is REQUIRED — and the ONE implicit default
# is `nil` for a `T?` field, its natural absent state.
#
# Neither half was here. A short construction emitted a short C initializer and let the C
# compiler zero the rest, which for an optional means tag 0: PRESENT, holding whatever zero
# is. `P(1)` on a struct with a `str?` printed `(null)` — an absent field read as a present
# one. And a missing NON-optional field was equally silent, so the whole rule was decided
# by C's zeroing rather than by the language.
#
# A DECLARED default is the third answer, and it is checked first, because it is the one the
# programmer wrote: a field with an `=` is filled from that expression whatever its type, so
# a `T?` with a default gets the default rather than `nil`. The expression is rendered HERE,
# at the construction that omitted the field, which is what makes it evaluated per
# construction — the same backfill, and the same consequence, as `c_default_args` gives a
# parameter default at a call.
fn c_struct_rest(mut &em: Emitter, sname: str, given: int, lead: bool, sb: Subst) -> str {
	mut out := ""
	mut i := given
	mut sep := lead
	for i < c_struct_field_n(em, sname) {
		ft := c_struct_field_ty_at(em, sname, i)
		if sep {
			out = out + ", "
		}
		sep = true

		# A CHECKED rule rather than a refusal, on the same argument as the rest of check.zg:
		# a construction short of a required field is a program the LANGUAGE rejects, not a
		# form this compiler has not built, so it owes the reader the place the construction
		# was written. `0` stands in for the value the field never got, which keeps the
		# initializer's shape so the walk carries on and names the fields after this one too;
		# the C built after a finding is discarded.
		if c_struct_field_hasdef(em, sname, i) {
			# a default is an argument, so it meets its field's type like any other — which is
			# what gives `xs: list[int] = []` an element size, exactly as it does for a
			# parameter default
			out = out + c_field_init(em, f"the default for {check.chk_field_says(em, sname, i + 1)}", ft, c_struct_field_def(em, sname, i), sb)
		} else if ast.ty_is_opt(ft) {
			out = out + "(" + c_opt_name(em, c_opt_elem(ft)) + "){ .tag = 1 }"
		} else {
			check.chk_at(em, rule.Rule.FieldMissingInLiteral, f"{check.chk_field_says(em, sname, i + 1)} has no value and no default ({ast.ty_name(ft)}): a construction binds by position and stopped short of it, and only a `T?` field has an implicit default — which is `nil`")
			out = out + "0"
		}
		i = i + 1
	}
	return out
}

# c_struct_field_row is the row a struct's idx-th field (declaration order) occupies in the
# field table. The three per-column readers below go through it rather than each walking the
# table themselves, which is the lesson `c_param_row` already carries for parameters: one
# scan, one encoding of "the idx-th field of this struct".
pub fn c_struct_field_row(mut &em: Emitter, sname: str, idx: int) -> int {
	mut n := 0
	mut i := 0
	for i < em.fld_struct.len() {
		if em.fld_struct[i] == sname {
			return i if n == idx
			n = n + 1
		}
		i = i + 1
	}
	return -1
}

# c_struct_field_hasdef is whether the idx-th field declared a default.
fn c_struct_field_hasdef(mut &em: Emitter, sname: str, idx: int) -> bool {
	row := c_struct_field_row(em, sname, idx)
	return false if row < 0
	return em.fld_hasdef[row]
}

# c_struct_field_def is the idx-th field's default expression; only ask when it has one.
fn c_struct_field_def(mut &em: Emitter, sname: str, idx: int) -> ast.Expr {
	row := c_struct_field_row(em, sname, idx)
	return ast.Expr.ENil if row < 0
	return em.fld_def[row]
}

fn c_struct_field_n(mut &em: Emitter, sname: str) -> int {
	mut n := 0
	mut i := 0
	for i < em.fld_struct.len() {
		if em.fld_struct[i] == sname {
			n = n + 1
		}
		i = i + 1
	}
	return n
}

# c_call_args emits a call's arguments, taking the address of any argument bound to a
# mutable-reference parameter (which is a C pointer).
fn c_call_args(mut &em: Emitter, fname: str, args: list[ast.Expr], sb: Subst) -> str {
	return c_args_from(em, fname, 0, args, false, sb)
}

# c_args_from renders a call's written arguments against the parameters starting at `base`,
# then the defaults for whatever was left off. `base` is 0 for a free call and 1 for a
# method, whose receiver already stands where parameter 0 does — the shift is written down
# once here rather than in each caller, because getting it wrong passes a `mut &` argument
# by value into the slot after the one that wanted its address.
fn c_args_from(mut &em: Emitter, key: str, base: int, args: list[ast.Expr], lead: bool, sb: Subst) -> str {
	check.chk_call_arity(em, key, base, args.len())

	# the aliasing rule is about a CALL rather than an argument, so it is asked once here
	# and not inside the per-argument walk below
	if base == 0 {
		check.chk_ref_alias(em, key, args)
	}

	# `lead` is also the answer to "does an operand already stand in front of these": it is
	# set exactly where a receiver has been rendered ahead of the written arguments, and a
	# receiver is the run's first operand. With one there every written argument is a LATER
	# operand, so any of them having an effect makes the order visible; without one the
	# first argument is the one nothing precedes.
	mut at := 1
	if lead {
		at = 0
	}

	refs := c_ref_args(em, key, base, args)
	seq := c_needs_order_args(args, refs, at)

	mut out := ""
	mut i := 0
	for i < args.len() {
		if lead or i > 0 {
			out = out + ", "
		}
		out = out + c_ordered(em, seq and not refs[i], c_arg(em, key, base + i, i + 1, args[i], sb))
		i = i + 1
	}
	return out + c_default_args(em, key, base + args.len(), lead or args.len() > 0)
}

# c_owned_args answers WHICH of a call's arguments hand it something the CALLER has to give
# back, as one release function per written argument and "" for the rest.
#
# A plain call argument is a BORROW — the language says so (docs/code/coroutine.md, and
# conc_chan_dir pins it): passing a handle moves no count, which is why a callee neither
# copies its channel parameter nor releases it. That is exactly right for `f(ch)`, where the
# caller's binding is still holding one. It leaves a hole for `f(source())`: the argument is
# a freshly built handle carrying one reference, the callee borrows it, and when the call
# returns there is no name left anywhere that could give it back.
#
# So the caller keeps it and releases it after the call (c_call_releasing). "Freshly built"
# is the same test c_let_chan makes — anything that is not existing storage — and the answer
# is a release FUNCTION rather than a bool because the type decides which one: a send-capable
# handle gives back a send count as well as a holder count, and the two are not the same
# release. That is also what makes this list the place the other owning types join when they
# grow a drop, rather than a channel-shaped question asked in a channel-shaped way.
fn c_owned_args(mut &em: Emitter, key: str, base: int, args: list[ast.Expr]) -> list[str] {
	mut rels: list[str] = []
	mut i := 0
	for i < args.len() {
		# the lvalue test FIRST: it is a match on the expression's own tag, and c_param_row
		# walks the whole program's parameter table. Asking them the other way round put a
		# second full scan on every argument of every call, which is the cost c_arg exists
		# not to pay twice.
		mut rel := ""
		mut row := -1
		if c_owns_value(args[i]) {
			row = c_param_row(em, key, base + i)
		}
		if row >= 0 and ast.ty_is_chan(em.pr_ty[row]) {
			# a `mut &` parameter takes the caller's own storage, which is a name and so
			# never one of these — but say it here rather than rely on the lvalue test to
			# have covered it, because the two questions are different ones
			if not em.pr_ref[row] {
				rel = c_chan_release_fn(c_chan_dir(em.pr_ty[row]))
			}
		}
		rels.append(rel)
		i = i + 1
	}
	return rels
}

# c_any_owned is whether c_owned_args found anything at all — the common answer is no, and
# a call with nothing to give back must render exactly the C it rendered before.
fn c_any_owned(rels: list[str]) -> bool {
	for r in rels {
		return true if r != ""
	}
	return false
}

# c_call_releasing renders a call that is handed something the caller has to give back. It
# is a STATEMENT EXPRESSION — the same shape this emitter already uses to index a map —
# because the release has to happen after the call and an expression has nowhere else to put
# it:
#
#     ({ zrt_chan *zgt_t0 = source(); int64_t zgt_tr = zg_drain(zgt_t0);
#        zrt_chan_release(zgt_t0); zgt_tr; })
#
# The result is held in a temporary of its own so the release lands BETWEEN the call and the
# value: releasing first would hand the caller a value read out of a channel it had already
# given back, and releasing after the whole expression is what there is no place to write.
# A call that answers nothing skips that temporary, because C has no `void` object to
# declare — the statement expression's value is then the release, which is what a discarded
# call wants anyway.
#
# Every temporary is numbered from em.tmp_n rather than from its position, so a call nested
# in another call's argument cannot shadow the name the outer one is still holding.
fn c_call_releasing(mut &em: Emitter, cfn: str, key: str, args: list[ast.Expr], rels: list[str], sb: Subst) -> str {
	check.chk_call_arity(em, key, 0, args.len())
	check.chk_ref_alias(em, key, args)

	# THE ORDER IS DECIDED WITH THESE DECLARATIONS and not with c_ordered's, for the reason
	# c_str_concat gives: this call's own temporaries are declared INSIDE its statement
	# expression and c_ordered's outside it, so a run split between the two would run its
	# later arguments first. The argument that owns something is already bound here, and one
	# that does not joins it whenever anything after the first can tell.
	refs := c_ref_args(em, key, 0, args)
	seq := c_needs_order_args(args, refs, 1)

	mut decls := ""
	mut call := cfn + "("
	mut frees := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			call = call + ", "
		}
		rendered := c_arg(em, key, i, i + 1, args[i], sb)
		if rels[i] == "" {
			if seq and not refs[i] {
				on := c_tmp(em, "zgt_ord")
				decls = decls + c_ord_decl(on, rendered)
				call = call + on
			} else {
				call = call + rendered
			}
		} else {
			tn := c_tmp(em, "zgt_t")
			decls = decls + f"zrt_chan *{tn} = {rendered}; "
			call = call + tn
			frees = frees + f"{rels[i]}({tn}); "
		}
		i = i + 1
	}
	call = call + c_default_args(em, key, args.len(), args.len() > 0) + ")"

	ret := c_lookup_sig_ret(em, key)
	return f"({{ {decls}{call}; {frees}}})" if ast.ty_eq(ret, ast.Ty.TVoid)

	rn := c_tmp(em, "zgt_t")
	return f"({{ {decls}{c_type(ret)} {rn} = {call}; {frees}{rn}; }})"
}

# c_arg renders ONE argument against the parameter it fills. A `mut &` parameter takes the
# caller's variable itself — that is the whole point of the writeback — and every other
# one takes a value the callee OWNS, which is why it is copied.
#
# Copying here rather than at the `return` is what lets a function hand back a parameter:
# once the callee's copy is its own, returning it aliases nothing, and a call's result can
# go on being treated as nobody else's. Copying at the return instead would have to copy a
# local that is about to die, which is pure waste and needs escape analysis to avoid.
# `idx` is the PARAMETER's index and `pos` is the argument's place as written — they differ
# by one on a method, whose receiver fills parameter 0 without appearing at the call. The
# first is what reads the parameter table; the second is what a diagnostic may say out loud.
fn c_arg(mut &em: Emitter, fname: str, idx: int, pos: int, a: ast.Expr, sb: Subst) -> str {
	# the one place that reads the row directly rather than through the per-column
	# helpers: it needs two answers about the same parameter, and asking twice would walk
	# the whole program's parameter table twice for every argument of every call
	row := c_param_row(em, fname, idx)

	# the check is handed the row's TYPE rather than the name and index it would look the
	# row up from — the scan above is the one this function exists not to repeat
	check.chk_argument(em, fname, row, pos, a)

	# a `mut &` argument is the caller's own storage, handed over to be WRITTEN — so it is
	# lowered like an assignment target and not like a read. `f(mut &xs[0])` took the
	# address of a slot in a buffer that may be shared, and the callee's write was read
	# back through every other holder.
	if row >= 0 and em.pr_ref[row] {
		check.chk_ref_arg(em, fname, pos, a)
		return f"&({c_lvalue(em, a, sb)})"
	}
	return c_expr(em, a, sb) if row < 0

	# guarded on the DECLARED type, which is already in hand: c_chan_check answers nothing
	# unless it is a channel, and the c_infer it would otherwise take walks the argument's
	# whole tree — on every argument of every call — only to be thrown away.
	# NAMED BY chk_slot_says, which is the same helper `E3038` uses for the same slot. This
	# spelled the label itself and spelled it from `idx` — the PARAMETER's index, which is
	# 0-based and differs from the argument's position by one on a method — so `take(r)`
	# reported "argument 0 of `take`" while the type mismatch one line up reported "argument
	# 1 of `take`" for the very same slot. A reader following the first looked at the wrong
	# parameter, and a reader who met both was told two things about one argument.
	if ast.ty_is_chan(em.pr_ty[row]) {
		c_chan_check(em, c_infer(em, a), em.pr_ty[row], check.chk_slot_says(fname, pos))
	}
	return c_fit_copied(em, check.chk_slot_says(fname, pos), em.pr_ty[row], a, sb)
}

# c_captured renders the value a `spawn` or a `defer` stores in its env — the same value
# the callee would OWN at an ordinary call, which is why it is copied. c_arg is the wrong
# tool for it: that one renders straight into an argument list and asks the BORROW rules,
# which chk_callsite has already asked of this call. The FIT is asked here, by c_fit_copied
# like everywhere else, and it costs nothing to ask a second time — it either agrees with
# chk_callsite or names a slot nobody had reached. The COPY is
# not optional, and both statements skipped it: `defer take(xs)` handed the callee the
# caller's own buffer, so a later `xs[0] = 99` was seen by a call that is documented to
# have taken a snapshot. An ordinary `take(xs)` copied all along — the two disagreed.
#
# A CHANNEL is the exception the language draws on purpose: a handle is shared, and the
# capture takes its own reference rather than a copy. `spawn`'s loop does that above; a
# copy here would be a second, wrong answer to the same question.
fn c_captured(mut &em: Emitter, key: str, idx: int, a: ast.Expr) -> str {
	row := c_param_row(em, key, idx)

	return c_expr(em, a, c_nosub()) if row < 0 or ast.ty_is_chan(em.pr_ty[row])

	return c_fit_copied(em, check.chk_slot_says(key, idx + 1), em.pr_ty[row], a, c_nosub())
}

# c_captured_ty is the type of the FIELD c_captured's value is stored in, and the pair is why it
# exists: `spawn` and `defer` each build an environment struct, and each typed its fields from
# `c_infer` of the ARGUMENT while c_captured rendered the value at the PARAMETER's type. The two
# agree until a position does something to a value on its way in — and then they do not:
#
#     spawn work(3 / 2)      # work(v: float)
#     zgt_se2->f0 = (((double)3) / ((double)2));   /* 1.5, into an int64_t field */
#
# printed `1`. It is the same disagreement `spawn work(1.5)` on a `float?` parameter turned into
# a cc error against generated C — the carrier is built at the parameter's type and stored in a
# field shaped like the argument. One function answers for both, beside the one that renders the
# value, because the two answers are one decision.
fn c_captured_ty(mut &em: Emitter, key: str, idx: int, a: ast.Expr) -> ast.Ty {
	row := c_param_row(em, key, idx)
	return c_infer(em, a) if row < 0 or ast.ty_is_chan(em.pr_ty[row])

	return em.pr_ty[row]
}

fn c_param_ty(mut &em: Emitter, fname: str, idx: int) -> ast.Ty {
	row := c_param_row(em, fname, idx)
	return ast.Ty.TUnknown if row < 0
	return em.pr_ty[row]
}

# c_default_args fills in the parameters a call left off the end, in declaration order,
# taking each one's declared default. C has no such notion, so the backfill happens here:
# every emitted call is fully applied whatever the source wrote.
#
# It stops at the first parameter with no default, which is also where the language stops
# — a parameter without one is mandatory, and a call missing it is a call that is wrong.
# Emitting the arguments it DOES have and no more would produce C that cc rejects, which
# is the failure this compiler wants when a program is wrong.
#
# c_defaults_from is the one encoding of that rule: the default EXPRESSIONS of every
# parameter from `at` onward. It was written twice — once to render them for an ordinary
# call, once to append them for a spawn — and the two disagreed about the receiver shift.
#
# The row is read directly, for the reason c_arg gives: two answers about one parameter,
# and the per-column helpers would scan the whole program's parameter table for each.
fn c_defaults_from(mut &em: Emitter, key: str, at: int) -> list[ast.Expr] {
	mut out: list[ast.Expr] = []
	mut i := at
	mut row := c_param_row(em, key, i)
	for row >= 0 and em.pr_hasdef[row] {
		out.append(em.pr_def[row])
		i = i + 1
		row = c_param_row(em, key, i)
	}
	return out
}

fn c_default_args(mut &em: Emitter, fname: str, given: int, sep: bool) -> str {
	mut out := ""
	mut lead := sep
	mut i := given
	for d in c_defaults_from(em, fname, given) {
		if lead {
			out = out + ", "
		}
		lead = true

		# a default is an argument, so it meets its parameter's type like any other — which
		# is what gives `fn take(xs: list[int] = [])` an element size. Rendered with c_expr
		# it was the bare `(zrt_list){0}`, and every append into it memcpy'd nothing.
		out = out + c_fit_copied(em, f"the default for {check.chk_slot_says(fname, i + 1)}", c_param_ty(em, fname, i), d, c_nosub())
		i = i + 1
	}
	return out
}

# c_variant_ctor builds `(zg_Enum){.tag = N, .u.Var = {.f0 = a, ...}}` (the payload part
# omitted for a tag-only variant).
fn c_variant_ctor(mut &em: Emitter, en: str, name: str, args: list[ast.Expr], sb: Subst) -> str {
	# the same disagreement as a pattern that binds too much, from the other side: `Line(7,
	# 8)` on a `Line(int)` wrote a union member that was never declared, and cc reported it
	# against generated C
	check.chk_variant_arity(em, en, name, args.len(), "gives")

	# THE PAYLOAD IS A RUN, like a call's arguments and a struct's fields. A compound literal
	# is one C construct and C leaves the order of its initialisers to the backend, so
	# `E.V(f(1), g(2))` ran whichever of the two the compiler felt like running first — the
	# one combining form left inheriting that, after every other one in this file had been
	# sequenced. It is asked from 0 because a variant has no receiver for the answer to be
	# about (docs/core/memory.md).
	seq := c_needs_order(args, 0)

	mut out := "(zg_" + en + "){.tag = " + strconv.to_string(c_variant_tag_in(em, en, name), 10)
	if args.len() > 0 {
		out = out + ", .u." + name + " = {"
		mut i := 0
		for i < args.len() {
			if i > 0 {
				out = out + ", "
			}
			mut val := c_field_init(em, f"payload {strconv.to_string(i + 1, 10)} of `{name}`", c_variant_field_ty(em, en, name, i), args[i], sb)
			if c_is_boxed(em, en, name, i) {
				# box a self-recursive payload into a refcounted cell that releases it
				val = f"zg_refnew_{en}({val})"
			}

			# the BOX is inside the temporary, not outside it: hoisting the unboxed value
			# would leave the allocation where the literal is and put it back out of order.
			out = f"{out}.f{i} = {c_ordered(em, seq, val)}"
			i = i + 1
		}
		out = out + "}"
	}
	return out + "}"
}

# c_ident_val resolves a bare name: a match binding wins, then a nullary enum variant
# (constructed as a tag-only literal), otherwise a mangled variable reference.
fn c_ident_val(mut &em: Emitter, n: str, sb: Subst) -> str {
	mut i := 0
	for i < sb.names.len() {
		return sb.repls[i] if sb.names[i] == n
		i = i + 1
	}
	if c_is_variant(em, n) {
		c_bare_variant(em, n)
		return "(zg_" + c_variant_enum(em, n) + "){.tag = " + strconv.to_string(c_variant_tag(em, n), 10) + "}"
	}

	# EVERY READ OF A BINDING FUNNELS THROUGH HERE, which is what makes this the one place a
	# use after `del` has to be caught — and it sits above the mutable-reference case rather
	# than below it because that case RETURNS. A `mut &` parameter is a pointer dereferenced
	# on use, so its reads left by the line below and never reached the check: `del x` on one
	# revoked nothing anybody could observe, and the parameter went on writing through to the
	# caller's variable, which is the one `del` target docs/core/memory.md says merely ends
	# the borrow. A name nothing binds has no row and no state, so asking early costs a
	# lookup that answers -1 and changes nothing for the shapes below.
	c_live_use(em, n)

	if c_is_ref_name(em, n) {
		# a mutable-reference parameter is a pointer; dereference it on use
		return f"(*zg_{n})"
	}

	# A bare function NAME used where a value is wanted is that function as a value. It is
	# only reached when nothing has bound the name, so a binding always wins — which is the
	# ordinary scoping rule, and it means a local can shadow a function without surprise.
	if c_is_free_fn(em, n) and not c_is_bound(em, n) {
		c_no_ref_param_value(em, n)
		c_chk_unsafe_fn(em, n, "naming it here would hand safe code the same call", c_sig_row_of(em, n))
		em.used_fnptr = true
		return f"((zg_fnptr){{(void (*)(void))zg_{c_fnval_thunk(em, n, c_fn_ty_of(em, n))}, NULL}})"
	}

	# NOTHING IN SCOPE ANSWERS TO THIS NAME. It used to be spelled `zg_<n>` and handed to
	# cc, which reported "use of undeclared identifier" against a file under .zerg-cache —
	# for the commonest mistake anyone makes, a typo. The seed has said `undefined name`
	# all along.
	#
	# A module constant, a struct name and a variant are all bound by the time a body is
	# emitted, so the check is one question: did anything bind it?
	# `this` is not an ordinary unknown name. GRAMMAR#param says it is not a parameter and
	# GRAMMAR#param that a `fn` whose body uses it with no instance bound is a compile error —
	# so the thing to say is which rule was broken, not that the name is unknown. It is
	# bound exactly when the enclosing `fn` was declared in an `impl` or a `spec`, because
	# that is where the parser puts the receiver.
	#
	# A CHECKED rule rather than a refusal, so it carries the place every other rule does:
	# it is a statement about a program the language rejects, not a form this compiler has
	# not built, and the C emitted after a finding is discarded.
	if n == "this" and not c_is_bound(em, n) {
		check.chk_at(em, rule.Rule.ThisWithoutReceiver, "`this` is a method's receiver, and this function has none — a `fn` outside an `impl` or a `spec` is not called on an instance")
		return "0"
	}
	if not c_is_bound(em, n) and not c_is_struct_name(em, n) {
		c_builtin_check(em, n)

		# The ordinary unknown name is the same kind of statement and takes the same channel.
		# It was a bare `raise` for as long as it existed, which said the sentence and nothing
		# else — and of every rule here this is the one that needs a place most, because the
		# wording locates nothing: a typo names the misspelling and a file may hold four
		# spellings of it, so the reader is told what is wrong and left to find where.
		c_undefined_name(em, n)
		return "0"
	}

	# A BARE read of a module constant answers the same visibility question the qualified
	# `lib.FLOOR` does (c_fieldref): c_reset_env binds every module's constants into every
	# function at scope 0, so without this ask a private constant was readable by bare
	# name from any module — silently, while the same shape of private FUNCTION is refused
	# with a place. The membership test is what keeps a LOCAL that shadows the constant out
	# of it: the local answers the read, and a local is nobody's export.
	#
	# chk_is_module_binding, not `env_scope[idx] == 0` spelled again. The two agree only
	# because c_reset_env seeds the module rows first AND nothing else ever binds at scope
	# 0; one predicate with two proxies in two files is a divergence waiting for the day
	# either half stops being true.
	idx := c_live_idx(em, n)
	if idx >= 0 and check.chk_is_module_binding(em, idx) {
		c_chk_visible_const(em, n)
	}
	return c_var_cname(em, n)
}

# c_is_bound is "did anything bind this name", and it asks the ENVIRONMENT rather than the
# type the environment holds. c_lookup_var answers `TUnknown` for a name it does not find,
# so reading boundness out of it conflated two different facts — no row, and a row whose
# type nothing could work out — and the second is exactly what a binding over a REJECTED
# expression leaves behind: `x := s[0]` on a `str` reports E3019 and binds `x` as unknown.
#
# Every later read of that name was then reported as _E3069 undefined name `x`_ — a CASCADE,
# a second error for a mistake already named, about a binding that is right there on the
# line above. `assert` made it worse than noise: its desugar hoists each operand into a
# temporary of its own, so a bad operand leaked _undefined name `zga_l3c9`_ — a name the
# author never wrote and cannot find in the file, one per conjunct of an `and`.
#
# Membership is what all four callers want. A local shadows a function by EXISTING, not by
# having a type worked out; `this` is bound by the receiver being there; and a name a
# statement bound is not a namespace and not undefined, whatever went wrong inside it.
fn c_is_bound(mut &em: Emitter, n: str) -> bool {
	return c_live_idx(em, n) >= 0
}

# c_fn_ty_of builds the `fn(P...) -> R` type of a named free function, reading the
# parameter types back out of the table c_build_sigs filled.
# c_fnval_thunk gives a plain function the shape every fn VALUE has: an environment first,
# then the declared parameters. It answers the thunk's name.
#
# A closure needs the environment and a named function has none, and a call site cannot know
# which of the two it is holding — so rather than two shapes and a discriminator, there is
# one shape and a thunk that ignores the pointer. It costs a static function per name taken
# as a value, which is a handful in any program that does it at all.
fn c_fnval_thunk(mut &em: Emitter, target: str, t: ast.Ty) -> str {
	name := f"fnval__{strconv.to_string(em.lam_n, 10)}"
	em.lam_n = em.lam_n + 1

	ps := c_fn_params(t)
	mut sig := ""
	mut call := ""
	mut i := 0
	for i < ps.len() {
		sig = sig + f", {c_type(ps[i])} a{strconv.to_string(i, 10)}"
		if i > 0 {
			call = call + ", "
		}
		call = call + f"a{strconv.to_string(i, 10)}"
		i = i + 1
	}

	mut ret := "return "
	if ast.ty_name(c_fn_ret(t)) == "void" {
		ret = ""
	}
	em.lam_defs.append(f"static {c_type(c_fn_ret(t))} zg_{name}(const void *zg_envp{sig}) {{ (void)zg_envp; {ret}zg_{target}({call}); }}\n")
	return name
}

fn c_fn_ty_of(mut &em: Emitter, n: str) -> ast.Ty {
	# one pass: c_build_sigs appends a function's parameters contiguously and in index
	# order, so collecting the rows that name it collects them already in order
	mut ptys: list[ast.Ty] = []
	mut i := 0
	for i < em.pr_fn.len() {
		if em.pr_fn[i] == n {
			ptys.append(em.pr_ty[i])
		}
		i = i + 1
	}
	return ast.Ty.TFn(ptys, c_lookup_sig_ret(em, n))
}

# c_args renders the arguments of a call this emitter has no PARAMETER TABLE for: a call
# through a function value, an intrinsic, an error constructor. c_arg is the wrong tool —
# it reads the table by name and index, and there is no name to read.
#
# `ftys` is what the declared function type says the parameters are, and it is what makes
# each argument a COPY like every other call's: a callee owns what it is given and gives it
# back at its own scope end, so handing it the caller's own storage instead was a double
# drop. `this.action(ctx)` did exactly that — it was the one call in the whole stdlib that
# passed a struct without copying it, and the drop the callee now owes turned a
# long-standing value-semantics gap into a use-after-free.
#
# A call with no declared type to read — an intrinsic, an err constructor — passes an empty
# list and every argument goes through unchanged, which is what those want.
#
# WHETHER IT SEQUENCES is the caller's to say, and the two callers answer differently. A
# call through a function VALUE does — its arguments are a run like any other call's — and
# the intrinsics and the built-in error constructors do not. The Go seed draws the boundary
# in the same place, and it has to: the two compilers must agree about which operands are
# sequenced or `make oracle` becomes a tripwire waiting for a program that can tell, so
# moving the line is a change to both.
fn c_args_typed(mut &em: Emitter, ftys: list[ast.Ty], args: list[ast.Expr], sb: Subst, seq: bool) -> str {
	mut out := ""
	mut i := 0
	for i < args.len() {
		if i > 0 {
			out = out + ", "
		}
		mut val := ""
		if i < ftys.len() {
			val = c_fit_copied(em, f"argument {strconv.to_string(i + 1, 10)} of this call", ftys[i], args[i], sb)
		} else {
			val = c_expr(em, args[i], sb)
		}

		# the COPY is inside the temporary: hoisting the uncopied value would move the
		# retain out of the run and leave the copy where the argument list is.
		out = out + c_ordered(em, seq, val)
		i = i + 1
	}
	return out
}

# c_fnfield_call lowers `this.action(c)` — a call through a FIELD holding a function. The
# field's type is wanted twice, for the cast and for the parameter list, and c_field_ty is a
# scan of every field of every struct in the program; asking once is the whole reason this
# is a function and not an arm of the match that calls it.
fn c_fnfield_call(mut &em: Emitter, recv: str, meth: str, target: ast.Expr, args: list[ast.Expr], sb: Subst) -> str {
	fty := c_field_ty(em, recv, meth)
	tv := c_expr(em, target, sb)
	return f"({c_fnptr_cast(fty)}({tv}.zg_{meth}).fn)({tv}.zg_{meth}.env{c_args_after(em, fty, args, sb)})"
}

fn c_args(mut &em: Emitter, args: list[ast.Expr], sb: Subst) -> str {
	mut none: list[ast.Ty] = []
	return c_args_typed(em, none, args, sb, false)
}

# c_fn_params reads a function TYPE's parameter list, or an empty one from anything else.

# c_match lowers a match expression to a right-nested C ternary, the last arm as the
# final else (the subset requires an exhaustive catch-all last arm).
#
# The scrutinee is bound to a temp first unless it is already an lvalue. Every arm's
# condition and body has the scrutinee spliced into it, so pasting the expression itself
# would evaluate it once PER ARM — which for `match f(x)` is a call repeated and for
# `match <-ch` is a second value taken off the channel and thrown away. An lvalue is left
# alone: re-reading a name costs nothing and does nothing, and leaving it alone is what
# keeps the emitted C for everything that already worked exactly where it was.
#
# A scrutinee whose type inference could not name is also left alone: the temp needs a C
# type to be declared with, and guessing one would turn a typing gap into wrong C.
fn c_match(mut &em: Emitter, scrut: ast.Expr, arms: list[ast.Arm], sb: Subst) -> str {
	st := c_infer(em, scrut)
	c_check_arm_pats(em, arms, st)
	c_check_exhaustive(em, arms, st)
	s := c_expr(em, scrut, sb)
	return c_arms(em, arms, 0, s, st, sb) if c_is_lvalue(scrut) or c_is_unknown(st)

	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_ms" + tag
	return f"({{ {c_type(st)} {tmp} = {s}; {c_arms(em, arms, 0, tmp, st, sb)}; }})"
}

# c_check_arm_pats refuses a constructor pattern that names a variant the subject cannot be.
# The arm's test is `s.tag == <the variant's tag>`, and every carrier in this backend has a
# `tag` — so the test COMPILED against the wrong type and compared unrelated numbers. Over a
# `K?` it was worse than wrong: the optional's present-tag is 0 and the first variant's tag
# is 0, so `match K.of(1) { A => … }` took the `A` arm whenever the value was present at all,
# whichever variant it held. The tag lookup answering 0 for a name it does not know made an
# undeclared variant match the same way.
fn c_check_arm_pats(mut &em: Emitter, arms: list[ast.Arm], st: ast.Ty) {
	check.chk_arm_types(em, arms, st)

	# a subject inference could not name has nothing to check the pattern against; guessing
	# would turn a typing gap into a refusal of a working program
	return if c_is_unknown(st) or c_is_either(st)

	mut i := 0
	for i < arms.len() {
		a := arms[i]
		if a.pat == 3 {
			# ASKED OF THE SUBJECT'S ENUM, which is the only enum a constructor pattern can
			# name a variant of. It used to ask which enum owns the bare name program-wide and
			# then compare: `match s { Red => … }` on a `Signal` was answered `Colour`, so the
			# arm was refused as unable to match a subject it matches exactly.
			en := c_named_of(st)

			raise c_diag(em, rule.Rule.NoSuchVariantInPattern, f"no variant named `{a.ctor}` — a constructor pattern names a variant of the subject's enum") if not c_is_variant(em, a.ctor)
			raise c_diag(em, rule.Rule.VariantPatternWrongEnum, f"variant pattern `{a.ctor}` cannot match a subject of type {ast.ty_name(st)}") if not c_is_variant_in(em, en, a.ctor)

			# THE QUALIFICATION MUST BE TRUE (GRAMMAR#variant-pat), and until now it was not
			# asked at all. The two rules above look up the VARIANT and compare THAT to the
			# subject, so a qualifier naming a different enum was caught only because its
			# variant was elsewhere — and a qualifier naming NOTHING was ignored outright:
			# `match c { Nope.Red => … }` on a `Colour` built, ran, and took the arm, so
			# renaming an enum left every pattern of it still matching and said nothing.
			#
			# The enum written in a pattern is an ASSERTION and not a reference: the subject's
			# type is what decides which enum this is, and the name is here to be checked
			# against it. That is why it never names a module — a module qualifier would be
			# answering "which one", which the subject has already answered.
			raise c_diag(em, rule.Rule.VariantPatternWrongQualifier, f"variant pattern `{a.qual}.{a.ctor}` names the enum `{a.qual}`, and the subject is a {ast.ty_name(st)} — the enum written in a pattern is checked against the subject, so it must be the subject's") if a.qual != "" and a.qual != en

			# HERE and not in c_bind_env, which is a lowering helper: c_arms calls it from
			# both c_arm_cond and c_arm_body, so a check hung there fired twice for every
			# arm but the last — the count of a diagnostic depended on where the arm sat.
			check.chk_variant_arity(em, en, a.ctor, a.binds.len(), "pattern binds")
		}
		i = i + 1
	}
}

# c_check_exhaustive refuses a `match` that does not cover its scrutinee. The lowering below
# uses the LAST arm as the final `else` without testing its condition, so a match missing a
# case did not fail — it answered the last arm's body for every value nothing else matched.
# `match k { A => "a"; B => "b" }` over a three-variant enum returned "b" for `C`, and for a
# scrutinee with no enum behind it `match n { 1 => "a"; 2 => "b" }` returned "b" for 3. That
# is a wrong answer with no diagnostic anywhere, which is the one outcome the repo does not
# tolerate; the seed has refused both since it had enums, so this is the shipped compiler
# catching up to it, message included.
#
# A GUARDED arm does not count toward coverage (GRAMMAR#match-arm — the compiler cannot
# prove the guard holds), so `A if c => …` still leaves `A` uncovered.
fn c_check_exhaustive(mut &em: Emitter, arms: list[ast.Arm], st: ast.Ty) {
	# an unguarded catch-all covers whatever the arms above it did not
	ca := c_catchall_at(arms)
	if ca >= 0 {
		# every arm after it is dead code AND breaks the lowering, which would hand the
		# trailing arm the `else` the catch-all was written to take
		raise c_diag(em, rule.Rule.CatchAllNotLast, "this catch-all arm makes the following arms unreachable") if ca < arms.len() - 1
		return
	}

	# an Either has exactly two sides, and naming both is exhaustive
	if c_is_either(st) {
		raise c_arm_missing_side(em, "Left") if not c_arm_covers(arms, "Left")
		raise c_arm_missing_side(em, "Right") if not c_arm_covers(arms, "Right")

		return
	}

	# an enum is exhaustive when every variant is named
	en := c_named_of(st)
	if en != "" and c_is_enum_name(em, en) {
		mut i := 0
		for i < em.var_name.len() {
			raise c_diag(em, rule.Rule.MatchMissingVariant, f"non-exhaustive match: missing variant {en}.{em.var_name[i]}") if em.var_enum[i] == en and not c_arm_covers(arms, em.var_name[i])
			i = i + 1
		}
		return
	}

	# a bool has two values, and they are literal arms rather than constructors
	if c_is_bool_ty(st) {
		raise c_arm_missing_bool(em, "true") if not c_arm_covers_bool(arms, true)
		raise c_arm_missing_bool(em, "false") if not c_arm_covers_bool(arms, false)

		return
	}

	# anything else — an int, a str, a type inference could not name — has a domain no arm
	# list can cover, so it takes a catch-all
	raise c_diag(em, rule.Rule.MatchMissingCatchAll, "non-exhaustive match: missing a catch-all `_` arm")
}

# c_catchall_at is the index of the first UNGUARDED catch-all arm (`_` or a binding), or -1.
fn c_catchall_at(arms: list[ast.Arm]) -> int {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return i if (a.pat == 1 or a.pat == 2) and not a.has_guard
		i = i + 1
	}
	return 0 - 1
}

# c_arm_covers reports whether some UNGUARDED constructor arm names `ctor`.
fn c_arm_covers(arms: list[ast.Arm], ctor: str) -> bool {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return true if a.pat == 3 and not a.has_guard and a.ctor == ctor
		i = i + 1
	}
	return false
}

pub fn c_is_bool_ty(t: ast.Ty) -> bool {
	return match t {
		Ty.TBool => true
		_        => false
	}
}

# c_arm_covers_bool reports whether some UNGUARDED literal arm names the truth value `v`.
fn c_arm_covers_bool(arms: list[ast.Arm], v: bool) -> bool {
	mut i := 0
	for i < arms.len() {
		a := arms[i]
		return true if a.pat == 0 and not a.has_guard and c_is_bool_lit(a.lit, v)
		i = i + 1
	}
	return false
}

fn c_is_bool_lit(e: ast.Expr, v: bool) -> bool {
	return match e {
		Expr.EBool(b) => b == v
		_             => false
	}
}

fn c_arms(mut &em: Emitter, arms: list[ast.Arm], i: int, s: str, st: ast.Ty, sb: Subst) -> str {
	a := arms[i]
	return c_arm_body(em, a, s, st, sb) if i == arms.len() - 1

	cond := c_arm_cond(em, a, s, st, sb)
	body := c_arm_body(em, a, s, st, sb)
	rest := c_arms(em, arms, i + 1, s, st, sb)
	return f"({cond} ? {body} : {rest})"
}

# c_result_tag is which side of a Result a constructor pattern names. A Result is not a
# declared enum — it has no row in the variant table — so `Left` and `Right` are answered
# here rather than looked up, and anything else is a pattern the type does not have.
fn c_result_tag(mut &em: Emitter, ctor: str) -> int {
	return 0 if ctor == "Left"
	return 1 if ctor == "Right"

	raise c_diag(em, rule.Rule.NotYetResultPattern, f"NotImplemented: the pattern `{ctor}` on a Result[T] — it has Left and Right")
}

# c_arm_subst extends sb with an arm's bindings: a bind arm aliases the scrutinee; an enum
# constructor arm aliases each payload name to its `s.u.Var.fK` field access.
fn c_arm_subst(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> Subst {
	return c_extend(sb, a.bind, s) if a.pat == 1
	if a.pat == 3 and c_is_either(st) {
		# `Left(v)` reads the value, `Right(e)` the Err; neither is a tagged union of the
		# kind the variant table describes, so the field is named directly
		return sb if a.binds.len() == 0
		return c_extend(sb, a.binds[0], c_res_ok(s)) if c_result_tag(em, a.ctor) == 0

		return c_extend(sb, a.binds[0], c_res_err(s))
	}
	if a.pat == 3 {
		en := c_named_of(st)
		mut r := sb
		mut i := 0
		for i < a.binds.len() {
			mut acc := f"{s}.u.{a.ctor}.f{i}"
			if c_is_boxed(em, en, a.ctor, i) {
				# unbox a self-recursive payload back to the enum value
				acc = f"(*(zg_{en}*)zrt_ref_payload({acc}))"
			}
			r = c_extend(r, a.binds[i], acc)
			i = i + 1
		}
		return r
	}
	return sb
}

# c_arm_guard renders a match arm's `if …`. It is one function for the three places that
# render it because a guard is a CONDITION — it lands in a C `&&`, where C's truthiness
# rule would answer a question this language does not ask that way — and three renders
# meant three chances to forget that.
fn c_arm_guard(mut &em: Emitter, a: ast.Arm, sb: Subst) -> str {
	check.chk_condition(em, a.guard_expr, "a match arm's guard")
	return c_expr(em, a.guard_expr, sb)
}

fn c_arm_cond(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> str {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)
	out := c_arm_cond_in(em, a, s, st, sb)
	c_scope_close(em, outer)
	return out
}

fn c_arm_cond_in(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> str {
	if a.pat == 0 {
		return c_arm_range(em, a, s, st, sb) if c_is_range(a.lit)

		# a literal pattern is scrutinee-equals-literal, and that equality is SYNTHESISED here
		# as text rather than built as an EBinary — so it meets no operand rule on the way
		# through, and a pattern was a second spelling of `==` that nothing covered:
		# `match x { nil => … }` over an optional lowered to a comparison with 0, exactly as
		# `x == nil` used to in the file next door. One rule, two spellings.
		#
		# THAT ONE IS NOW REFUSED BY NAME instead. GRAMMAR#literal makes `nil` a literal and
		# GRAMMAR#literal-pat makes a literal a pattern, so `match o { nil => … }` is the
		# natural way to ask about absence, and answering it out of chk_binary with "an
		# optional is not an operand of `==`" describes an operator the program never wrote.
		# The condition alone would be easy — it is the presence test c_iflet already makes —
		# but the arm beside it is not: a binding pattern binds the scrutinee, and over an
		# optional that is the carrier rather than what it holds, so the arm answering `v`
		# would answer the box. Named rather than half-built.
		raise c_diag(em, rule.Rule.NotYetNilPattern, "NotImplemented: `nil` as a `match` pattern — GRAMMAR makes it a literal pattern, and this compiler would have to unwrap the carrier for the arm beside it as well. Ask with `if v := x { … } else { … }`, which binds what it holds, or with `??`") if c_is_nil_lit(a.lit) and c_is_carrier(st)

		# the PATTERN is handed as both operands: this comparison is a scrutinee against a
		# literal, and a literal pattern is always the one adopting the scrutinee's type, so
		# there is no mixed pair to find and no scrutinee Expr in scope to look for one with
		check.chk_binary(em, "==", st, c_infer(em, a.lit), a.lit, a.lit)

		# AND THE GUARD, which this arm alone did not add. Every other shape does — the
		# constructor pattern above, the range beside it, the wildcard below — so
		# `match 1 { 1 if false => 10  _ => 0 }` answered `10`: the arm matched on the literal
		# and the `if` was read, type-checked, and then dropped on the floor. A guard that
		# parses and does nothing is worse than one that is refused.
		eq := c_arm_eq(em, a, s, st, sb)
		return f"({eq} && {c_arm_guard(em, a, c_arm_subst(em, a, s, st, sb))})" if a.has_guard

		return eq
	}

	if a.pat == 3 {
		mut base := f"({s}.tag == {c_variant_tag_in(em, c_named_of(st), a.ctor)})"
		if c_is_either(st) {
			base = f"({c_res_tag(s)} == {c_result_tag(em, a.ctor)})"
		}
		return f"({base} && {c_arm_guard(em, a, c_arm_subst(em, a, s, st, sb))})" if a.has_guard
		return base
	}
	return c_arm_guard(em, a, c_arm_subst(em, a, s, st, sb)) if a.has_guard
	return "1"
}

# c_range_needs_hi refuses an OPEN-ENDED range where the lowering has no length to put in place
# of the missing bound. `c_range_hi` answers nil there and `c_expr(ENil)` is `"0"`, so the loop
# or the slice silently ran zero times — the shape the arm path now handles deliberately, and
# these two do not handle at all.
fn c_range_needs_hi(mut &em: Emitter, e: ast.Expr, what: str) {
	raise c_diag(em, rule.Rule.NotYetOpenRangeHere, "NotImplemented: an open-ended range has no upper bound here — " + what) if c_is_range(e) and c_is_nil_lit(c_range_hi(e))
}

# c_arm_eq is the scrutinee against a literal pattern. A `str` is not a native C operand, so the
# comparison is strcmp's — the same answer c_binexpr gives `a == b`, and for the same reason:
# C's `==` on two `const char *` compares the POINTERS.
#
# `match s { "y" => 1  _ => -1 }` answered `-1` for `s = "y"`. Two string literals that are equal
# may or may not share storage, so the arm did not merely fail — it failed unpredictably, which
# is the one kind of wrong answer a test can pass over.
fn c_arm_eq(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> str {
	return f"(strcmp({s}, {c_expr(em, a.lit, sb)}) == 0)" if c_is_str(st)

	return f"({s} == {c_expr(em, a.lit, sb)})"
}

# c_arm_range lowers a RANGE arm's test. GRAMMAR defines `200..300 =>` as match-only sugar for
# the guard `_ if _ in 200..300`, so it matches by CONTAINMENT rather than by `equal` — and it
# lowers to the same two comparisons a slice bound does, from the same three accessors.
#
# Reaching this at all used to be an emitter crash. `c_arm_cond` asked `c_expr` for the arm's
# "literal", a range has no value to be, and the answer was the `c_range_unsupported` raise —
# so a form GRAMMAR has had all along was refused with "a range used as a value".
#
# The scrutinee appears twice, which is what `c_match`'s temp is for: an expression scrutinee
# is materialised before the arms are laid out, so nothing is evaluated a second time here.
# Like `c_arm_eq` above, the comparisons are built as TEXT rather than as an EBinary, so no
# operand rule is met on the way through and `chk_binary` has to be asked for it here.
fn c_arm_range(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> str {
	check.chk_binary(em, ">=", st, c_infer(em, c_range_lo(a.lit)), a.lit, a.lit)
	lo := c_arm_bound(em, c_range_lo(a.lit), sb)
	mut base := f"({s} >= {lo})"
	if not c_is_nil_lit(c_range_hi(a.lit)) {
		hi := c_arm_bound(em, c_range_hi(a.lit), sb)
		mut cmp := " < "
		if c_range_incl(a.lit) {
			cmp = " <= "
		}
		base = f"(({s} >= {lo}) && ({s}{cmp}{hi}))"
	} else if c_range_incl(a.lit) {
		# `500..=` is not a range: GRAMMAR gives '..=' a mandatory bound, and the parser reads
		# the missing one as nil rather than saying so.
		#
		# IT WAS BRIEFLY AN ICE HERE, on the reasoning that `..=` now demands an expression
		# after it so the nil could not be built. What that missed is that `nil` IS an
		# expression: `parse_add` accepts the literal, so `1..=nil` parses to exactly the
		# shape the bare `1..=` used to make. The refusal is about the RANGE having no upper
		# bound, whatever the reader wrote to leave it without one.
		raise c_diag(em, rule.Rule.NotYetOpenRangeInclusive, "NotImplemented: `..=` with no upper bound is not a range — write `500..` for open-ended")
	}

	# a guard on a range arm is AND-ed on, the way a constructor pattern's is: the range says
	# which values reach the guard, and the guard has the last word
	return f"({base} && {c_arm_guard(em, a, sb)})" if a.has_guard
	return base
}

# c_arm_bound renders ONE bound of a range arm. `range-bound ::= '-'? literal | identifier`
# (GRAMMAR#range-bound), and the prose above `match-expr` calls both alternatives compile-time
# constants — so a literal is emitted as it stands and a NAME is FOLDED to the value it names,
# through the one fold this compiler has. `LO..HI`, `MID..=HI` and `250..=300` are then the
# same request written three ways, and `const MID := LO + (HI - LO) / 2` is as good a bound as
# a number, because the recursion behind chk_const_eval is the const-expr's own.
#
# THE RULE IS WRITTEN AT THE IDENTIFIER and nowhere wider, because that is the alternative
# GRAMMAR adds: every other head an arm may carry reaches here as a literal that c_expr has
# always rendered, and routing those through a fold that only knows integers would refuse a
# `1.5..2.5` this compiler accepts today.
#
# A name that does NOT fold is reported HERE, at the use site — the same choice the fill count
# and the enum discriminant make. The binding's own line is a perfectly good one with nothing
# wrong on it; the line the reader needs is the one that asked for a compile-time value. `0` is
# emitted in its place so that one bad bound is one finding rather than a broken expression the
# rest of the arm then trips over.
fn c_arm_bound(mut &em: Emitter, b: ast.Expr, sb: Subst) -> str {
	name := c_ident_name(b)
	return c_expr(em, b, sb) if name == ""

	f := check.chk_const_eval(em, b)
	if not f.ok {
		check.chk_at(em, rule.Rule.RangeArmBoundNotConstant, f"a range arm's bound is a compile-time constant, and `{name}` is not one — GRAMMAR#range-bound gives the position a literal or a constant name, which is the value of a `:=` or `const` binding the compiler can fold, and no runtime value")
		return "0"
	}
	return strconv.to_string(f.value, 10)
}

# An arm's bindings belong to the ARM. Nothing popped them, so `match b { A(x) => x … }`
# left `x` bound for the rest of the block — shadowing an outer `x` with a name that is a
# SUBSTITUTION into `v.u.A.f0` and never a C variable, so the outer one came back as
# `use of undeclared identifier 'zg_x__2'` from cc. The seed gets this right, which is how
# it was found.
fn c_arm_body(mut &em: Emitter, a: ast.Arm, s: str, st: ast.Ty, sb: Subst) -> str {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)

	# COPIED, because a match used as a value hands its answer to whoever asked. An arm's
	# payload binding is a SUBSTITUTION into the scrutinee's own field, so `mut ys := match
	# b { One(q) => q … }` handed back the enum's own list header and a write through `ys`
	# was read back through `b`. It is the carrier extraction's rule, one shape along.
	out := c_copied(em, c_infer(em, a.body), a.body, c_arm_subst(em, a, s, st, sb))
	c_scope_close(em, outer)
	return out
}

# --- type inference ------------------------------------------------------------

# c_infer_match types a match from its FIRST arm, with that arm's payload bound — which is
# what c_arm_body does before lowering one, and what this did not do before inferring one.
# `xs := match b { One(q) => q … }` answered TUnknown, so the binding it initialised was
# never declared and the error surfaced somewhere else; where the answer was merely WRONG
# rather than unknown, the argument and return checks went blind and cc reported it.
#
# The bindings are popped again: inference must not leave anything behind.
fn c_infer_match(mut &em: Emitter, scrut: ast.Expr, arms: list[ast.Arm]) -> ast.Ty {
	return ast.Ty.TUnknown if arms.len() == 0

	return c_infer_arm_body(em, arms[0], c_infer(em, scrut))
}

# c_infer_arm_body types ONE arm's body with that arm's payload bound, and pops it again.
pub fn c_infer_arm_body(mut &em: Emitter, a: ast.Arm, st: ast.Ty) -> ast.Ty {
	outer := c_scope_open(em)
	c_bind_env(em, a, st)
	t := c_infer(em, a.body)
	c_scope_close(em, outer)
	return t
}

# c_infer types an expression. Like c_expr it counts a level of the expression walk
# (c_deeper): the checker's recursion is this function, and a chain deep enough to
# overflow it is refused by the same rule at the same number.
pub fn c_infer(mut &em: Emitter, e: ast.Expr) -> ast.Ty {
	c_deeper(em)
	t := c_infer_node(em, c_ns_unqualify(em, e))
	c_shallower(em)
	return t
}

fn c_infer_node(mut &em: Emitter, e: ast.Expr) -> ast.Ty {
	return match e {
		Expr.EInt(_, _, _) => ast.Ty.TInt
		Expr.EFloat(_) => ast.Ty.TFloat
		Expr.EStr(_) => ast.Ty.TStr
		Expr.EBool(_) => ast.Ty.TBool
		Expr.ENil => ast.Ty.TNil
		Expr.EIdent(n) => c_infer_ident(em, n)
		Expr.EUnary(oper, x) => c_infer_unary(em, oper, x)
		Expr.EBinary(oper, a, b) => c_infer_binary(em, oper, a, b)
		Expr.ECall(name, args, ts) => c_infer_call_written(em, name, args, ts)
		Expr.EMethod(target, meth, args) => c_infer_methcall(em, target, meth, args)
		Expr.EField(target, fld) => c_field_ty_of(em, target, fld)
		Expr.EOptChain(target, fld) => c_optchain_ty(em, target, fld)
		Expr.ETry(x) => c_carrier_elem(c_infer(em, x))
		Expr.EIndex(target, idx) => c_elem_ty(em, target, idx)
		Expr.EListLit(elems) => c_infer_listlit(em, elems)

		Expr.EFill(v, _) => c_infer_fill(em, v)
		Expr.EConv(ty, x, nm) => ty
		Expr.EIf(cond, then_e, else_e) => c_infer(em, then_e)
		Expr.EMatch(scrut, arms) => c_infer_match(em, scrut, arms)
		Expr.ERange(lo, hi, inclusive) => ast.Ty.TUnknown
		Expr.ETuple(elems) => c_tuple_ty(em, elems)
		Expr.EMapLit(ks, vs) => c_map_lit_ty(em, ks, vs)
		Expr.EFn(ps, has_ret, ret, body) => c_lambda_ty(ps, has_ret, ret)
		Expr.EChanNew(t, cap) => ast.ty_chan(t, 0, "")
		Expr.ERecv(ch) => ast.Ty.TOpt(ast.ty_chan_elem(c_infer(em, ch)))
		Expr.EForce(x) => c_carrier_elem(c_infer(em, x))
		Expr.ECoalesce(a, b, jump) => c_infer_coalesce(em, a, b)
		Expr.EGuard(body) => ast.Ty.TEither(c_guard_elem(c_guard_val_ty(em, body)), ast.Ty.TErr)
		Expr.EBlock(body) => c_block_val_ty(em, body)
		Expr.EIs(x, name) => ast.Ty.TBool
		Expr.EIn(x, set) => ast.Ty.TBool
	}
}

# c_infer_methcall types a method call from the SAME decision c_method lowers it by, so
# the two cannot disagree about what a call is. Typing it off the receiver is what makes a
# CHAIN work — the target of `.b()` in `a.b().c()` is itself a method call, so this
# recurses and each link is typed from the one before it.
# c_infer_coalesce types `a ?? b`. The value is a's payload OR b, so when the fallback is
# itself an optional the whole expression still is one — which is what makes the chain
# `a ?? b ?? 7` right-associate into a value rather than into a type nothing can name.
fn c_infer_coalesce(mut &em: Emitter, a: ast.Expr, b: ast.Expr) -> ast.Ty {
	tb := c_infer(em, b)
	return tb if ast.ty_is_opt(tb)
	return c_carrier_elem(c_infer(em, a))
}

fn c_infer_methcall(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr]) -> ast.Ty {
	# `E.of(n)` is partial, so it answers `E?` — see c_enum_of
	en := c_ident_name(target)
	if en != "" and c_is_enum_name(em, en) {
		return ast.Ty.TOpt(ast.Ty.TNamed(en)) if meth == "of"

		# `Shape.Line(5)` is a value of `Shape`. It is total where `of` is partial: the
		# variant is named rather than looked up, so there is nothing to fail.
		return ast.Ty.TNamed(en) if c_is_variant_in(em, en, meth)
	}

	tty := c_infer(em, target)
	recv := c_named_of(tty)
	return match c_meth_kind(em, tty, meth) {
		MethKind.MList    => c_list_method_ret(em, meth)
		MethKind.MMap     => c_map_method_ret(meth)
		MethKind.MErr     => c_err_method_ret(em, meth)
		MethKind.MCarrier => c_carrier_method_ret(em, tty, meth)
		MethKind.MRecv    => c_lookup_sig_ret(em, c_sig_key(recv, meth))
		MethKind.MFnField => c_fn_ret(c_field_ty(em, recv, meth))

		# the `_` arm is the NAMESPACED call — a module's names are the one free-function
		# space — so it answers what a free call of that name answers, generics included
		_ => c_infer_call(em, meth, args)
	}
}

# c_elem_ty is what `x[i]` yields: a map indexes to its VALUE type, a list to its element.
fn c_elem_ty(mut &em: Emitter, target: ast.Expr, idx: ast.Expr) -> ast.Ty {
	t := c_infer(em, target)

	# a slice is the same kind of container as what it came from
	return t if c_is_range(idx)
	return c_map_val_ty(t) if c_is_map(t)

	return c_list_elem(t)
}

# c_list_method_rv is a list method on an RVALUE: bind it, then call the method on the
# binding, so the whole thing is still one expression.
fn c_list_method_rv(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], tty: ast.Ty, sb: Subst) -> str {
	ln := c_tmp(em, "zgt_t")
	src := c_expr(em, target, sb)
	inner := c_list_method_on(em, ln, meth, args, tty, sb)

	# and give it back: this list is an rvalue, so nothing else will ever name it. `print
	# Bag([4, 5, 6, 7]).xs.len()` built a list, counted it and dropped the buffer on the floor.
	# `len` is the only list method that answers a value, and it answers an int — so the
	# result is held across the drop, and everything else is a statement whose value is the
	# drop itself.
	return f"({{ zrt_list {ln} = {src}; {inner}; zrt_list_drop(&{ln}); }})" if meth != "len"

	rn := c_tmp(em, "zgt_t")
	return f"({{ zrt_list {ln} = {src}; int64_t {rn} = {inner}; zrt_list_drop(&{ln}); {rn}; }})"
}

fn c_map_method_ret(meth: str) -> ast.Ty {
	return ast.Ty.TInt if meth == "len"
	return ast.Ty.TBool if meth == "has"

	return ast.Ty.TNil
}

fn c_list_method_ret(mut &em: Emitter, meth: str) -> ast.Ty {
	return ast.Ty.TInt if meth == "len"
	raise c_list_method_unknown(em, meth) if meth != "append"

	return ast.Ty.TNil
}

fn c_infer_call(mut &em: Emitter, name: str, args: list[ast.Expr]) -> ast.Ty {
	# A GENERIC CALL answers the SPECIALIZATION's result, never the template's. The template
	# says `T`, which is not a type — so the answer used to fall through to the signature
	# table, find nothing, and come back unknown: `print id("hi")` then took the integer path
	# and showed a pointer. Instantiating is keyed by the mangled name and idempotent, so
	# asking here costs the first ask and nothing after it.
	return c_lookup_sig_ret(em, c_instantiate(em, name, args)) if c_is_generic(em, name)

	return c_intrinsic_ret(name) if c_is_intrinsic(em, name)
	return ast.Ty.TNamed(c_variant_enum(em, name)) if c_is_variant(em, name)

	# a BUILT-IN ERROR constructor answers an `Err`, not a type of its own name. It reads as
	# a constructor and it is PascalCase, so the ctor rule below would have typed
	# `e := ValueError("x")` as `zg_ValueError` — a C type nobody declares, which cc reported
	# against generated code the programmer cannot open. The whole taxonomy is one runtime
	# type with a kind tag, which is what makes `e is ValueError` a comparison rather than a
	# cast, and what lets a bound Err be re-raised or handed to `from`.
	return ast.Ty.TErr if c_err_kind(name) > 0
	return ast.Ty.TNamed(name) if token.name_is_type(name)

	# A BINDING HOLDING A FUNCTION answers the function type's result. `g := double; n :=
	# g(21)` typed the call from the SIGNATURE table, which has no `g` in it, so the answer
	# was unknown, `n` was never declared, and the error arrived at the next line as
	# `undefined name n`. A binding always wins over a declared name here, which is the
	# ordinary scoping rule and the one c_ident already follows.
	bt := c_lookup_var(em, name)
	return c_fn_ret(bt) if c_is_fn(bt)

	return c_lookup_sig_ret(em, name)
}

# c_is_intrinsic reports whether a name is lowered as a runtime primitive.
#
# THE PREFIX IS `__zrt_`, NOT TWO UNDERSCORES. GRAMMAR#identifier admits `_` anywhere in a name
# and reserves no prefix at all, so `fn __my_helper(x: int) -> int` is an ordinary declaration —
# and this claimed it, lowering the call to `my_helper(…)` for cc to report against generated C.
# Closing the primitive set turned that silent miscompile into a refusal of a legal program,
# which is worse: the seed builds it and prints 2. The family the standard library actually
# reaches through is `__zrt_`, and that is the whole of what this may take.
#
# A DECLARATION STILL WINS. A program that declares `__zrt_foo` and calls it means its own
# function, the same way `c_err_kind` and the conversions defer to a name a program shadows —
# so a primitive is what a program does NOT declare, which is also why one can never be a typo
# for something the program wrote.
fn c_is_intrinsic(mut &em: Emitter, name: str) -> bool {
	return false if not parser.strings_has_prefix(name, "__zrt_")

	return not c_is_free_fn(em, name)
}

# c_intrinsic maps a __zrt_ intrinsic to its runtime C symbol.
fn c_intrinsic(name: str) -> str {
	return "zrt_write_str" if name == "__zrt_write"
	return "zrt_read_fd" if name == "__zrt_read"

	b := bytearray(name)
	mut out: list[byte] = []
	mut i := 2
	for i < b.len() {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# c_intrinsic_ret is what a runtime leaf answers. An intrinsic carries NO SIGNATURE — it
# is a name the emitter lowers directly — so this table is the only place its result type
# is written down, and an entry missing here is a leaf this compiler believes answers
# nothing. That was harmless while nothing compared types and stopped being harmless the
# moment `chk_fits` did: `a: str = __zrt_arch()` became "cannot bind nil to a str binding",
# for a leaf that has returned a `const char *` since it was written.
#
# Every leaf whose result a program BINDS belongs here. The fallback stays `TNil` rather
# than TUnknown because that is what a leaf answering nothing really is, and the emitter
# reads it as such; a leaf that answers something and is missing is a bug in this table,
# which is now a bug that a binding will report.
fn c_intrinsic_ret(name: str) -> ast.Ty {
	# A NAME THE SET DOES NOT HOLD HAS NO RESULT TYPE, and TNil is not "no type" — it is a
	# type, and every rule downstream believed it. `print __zrt_trunk(1.5)` therefore earned
	# E3086 as well, a true sentence about a nil this compiler had invented for a name it had
	# just said it does not have. TUnknown is what inference answers when it does not know,
	# and the rules that matter already tolerate it, so the refusal by name stands alone.
	return ast.Ty.TUnknown if not check.chk_is_intrinsic(name)

	return ast.Ty.TList(ast.Ty.TByte) if name == "__zrt_read"
	return ast.Ty.TList(ast.Ty.TStr) if name == "__zrt_listdir"
	return ast.Ty.TInt if name == "__zrt_open" or name == "__zrt_exec" or name == "__zrt_proc_spawn" or name == "__zrt_proc_wait"
	return ast.Ty.TInt if name == "__zrt_open_write"
	return ast.Ty.TInt if name == "__zrt_time_unix" or name == "__zrt_time_mono"
	return ast.Ty.TInt if name == "__zrt_path_kind"
	return ast.Ty.TInt if name == "__zrt_trunc"
	return ast.Ty.TInt if name == "__zrt_atomic_load" or name == "__zrt_atomic_store" or name == "__zrt_atomic_swap" or name == "__zrt_atomic_add"
	return ast.Ty.TStr if name == "__zrt_getenv" or name == "__zrt_arch" or name == "__zrt_platform" or name == "__zrt_exe_path"
	return ast.Ty.TBool if name == "__zrt_has_env" or name == "__zrt_exists" or name == "__zrt_mkdir" or name == "__zrt_atomic_cas"
	return ast.Ty.TBool if name == "__zrt_isatty" or name == "__zrt_del_env"

	return ast.Ty.TNil
}

# c_infer_listlit types a list literal from its FIRST element. An empty one names no
# element type at all, so it stays unknown and takes the type of whatever it initializes.
fn c_infer_listlit(mut &em: Emitter, elems: list[ast.Expr]) -> ast.Ty {
	return ast.Ty.TUnknown if elems.len() == 0
	return ast.Ty.TList(c_infer(em, elems[0]))
}

# c_infer_fill types `[v; N]` from the FILL VALUE and never from the count: the form is a
# `list[T]` for the T of v whatever N turns out to be, including the N that does not fold.
# Asking c_fill_elems here would report a bad count a second time — inference walks the same
# expression the lowering does — and would answer TUnknown for `[v; 0]`, which is a list of a
# known element type that happens to be empty.
fn c_infer_fill(mut &em: Emitter, v: ast.Expr) -> ast.Ty {
	return ast.Ty.TList(c_infer(em, v))
}

fn c_infer_ident(mut &em: Emitter, n: str) -> ast.Ty {
	return ast.Ty.TNamed(c_variant_enum(em, n)) if c_is_variant(em, n)
	t := c_lookup_var(em, n)

	# nothing bound the name, but a function answers to it: the name IS that function
	return c_fn_ty_of(em, n) if c_is_unknown(t) and c_is_free_fn(em, n)
	return t
}

fn c_infer_unary(mut &em: Emitter, oper: str, x: ast.Expr) -> ast.Ty {
	return ast.Ty.TBool if oper == "not"
	return c_infer(em, x)
}

fn c_infer_binary(mut &em: Emitter, oper: str, a: ast.Expr, b: ast.Expr) -> ast.Ty {
	return ast.Ty.TBool if c_is_bool_op(oper)

	# `//` is the language's ONE integer division, spelled so the reader sees an integer
	# whatever the operands are (docs/core/types.md) — so it answers `int` before the
	# float and byte rules below get a say. That IS the operator.
	return ast.Ty.TInt if oper == "//"

	# BOTH OPERANDS ARE INFERRED ONCE, here, and every rule below reads the answer. c_infer
	# has no memo and its leaves scan the environment, so asking it again per rule made the
	# work EXPONENTIAL in the depth of an arithmetic chain — the left operand of `a * b * c`
	# is itself a binary node, so each extra rule multiplied the whole subtree again rather
	# than adding to it. Four asks about `a` on the `+` path meant 4^depth leaf inferences.
	ta := c_infer(em, a)
	tb := c_infer(em, b)

	return ast.Ty.TStr if oper == "+" and c_is_str(ta)

	# WHAT AN EXPRESSION'S TYPE IS, IS DECIDED BY ITS OPERANDS — docs/core/types.md, and the
	# rule is the one every typed position uses: the operands are already one type, or one of
	# them is a literal adopting the other's.
	#
	# What stood here instead was three rules, each written to keep a type's arithmetic inside
	# its own storage: float wins, byte stays byte, uint stays uint. Together they answered
	# `byte` for `b + i` where `i` is an `int` — so `b'A' + 200` is 265, which is not a byte,
	# and the ordinary sum of a byte and an int RAISED. The byte rule was right about the case
	# it was written for and wrong about the reason: what keeps `n = n + 1` in byte is the `1`
	# adopting byte, not the addition being special.
	return ta if ast.ty_eq(ta, tb) and not c_is_unknown(ta)

	# A LITERAL ADOPTS THE OTHER OPERAND, which is what makes the other operand a typed
	# position. It adopts on chk_lit_fits' terms and not merely by being a literal, so
	# `n * 300` for a byte `n` is out of range here exactly as `b: byte = 300` is.
	return ta if check.chk_lit_fits(em, ta, b)
	return tb if check.chk_lit_fits(em, tb, a)

	# TWO TYPES AND NO LITERAL — `int` beside `float`, `int` beside `uint`. chk_binary has
	# already refused it; these three keep the old answer so that the rest of the walk has a
	# type to carry, and so that a pair with an UNKNOWN in it answers as it always did. The
	# program does not reach C either way.
	return ast.Ty.TFloat if c_is_float(ta) or c_is_float(tb)
	return ast.Ty.TUint if c_is_uint(ta) or c_is_uint(tb)

	return ast.Ty.TInt
}

# --- statement emission --------------------------------------------------------

fn c_stmt(mut &em: Emitter, s: ast.Stmt, ind: str) -> str {
	return match s {
		Stmt.SLet(name, ty, has_type, is_mut, is_const, ival) => c_let(em, name, ty, has_type, is_mut, is_const, ival, ind)
		Stmt.SAssign(lhs, rhs) => c_assign(em, lhs, rhs, ind)
		Stmt.SPrint(e) => c_print(em, e, ind)
		Stmt.SReturn(has_val, e) => c_return(em, has_val, e, ind)
		Stmt.SReturnIf(val, cond) => c_return_if(em, val, cond, ind)
		Stmt.SExpr(e) => c_expr_stmt(em, e, ind)
		Stmt.SIf(cond, then_body, has_else, else_body) => c_if(em, cond, then_body, has_else, else_body, ind)
		Stmt.SIfLet(name, value, then_body, has_else, else_body) => c_iflet(em, name, value, then_body, has_else, else_body, ind)
		Stmt.SFor(has_cond, cond, body) => c_for(em, has_cond, cond, body, ind)
		Stmt.SForIn(var, iter, body) => c_forin(em, var, iter, body, ind)
		Stmt.SRaise(x, hc, c) => c_raise(em, x, hc, c, ind)
		Stmt.SAssert(body) => c_assert(em, body, ind)
		Stmt.SScope(body) => c_block(em, body, ind)
		Stmt.SDefer(x) => c_defer(em, x, ind)
		Stmt.SSpawn(x) => c_spawn(em, x, ind)
		Stmt.SSend(ch, v) => c_send(em, ch, v, ind)
		Stmt.SSelect(arms) => c_select(em, arms, ind, false)
		Stmt.SForSelect(arms) => c_for_select(em, arms, ind)
		Stmt.SDel(n) => c_del(em, n, ind)
		Stmt.SClose(ch, at_exit) => c_close(em, ch, at_exit, ind)
		Stmt.SBreak => c_jump(em, "break", ind)
		Stmt.SContinue => c_jump(em, "continue", ind)
		Stmt.SNop => ""

		# a marker, not a statement: it records where the next one starts and emits nothing
		Stmt.SAt(l, c) => c_at(em, l, c)
	}
}

# c_assert emits the statements `assert cond` IS — the operand temporaries and the guarded
# raise — into the ENCLOSING block rather than a scope of their own. The temporaries carry
# the line and column they came from in their names, so nothing can collide with them, and a
# scope here would be a `{ … }` the desugared source does not have: `zerg desugar`'s D104
# writes these same statements out flat, and the two have to be the same program.
fn c_assert(mut &em: Emitter, body: list[ast.Stmt], ind: str) -> str {
	mut out := ""
	for s in body {
		out = out + c_stmt(em, s, ind)
	}
	return out
}

# c_expr_stmt lowers a bare expression statement. A `guard` in statement position is a
# guard whose Result nobody reads — which is legal, and is what `guard { risky() }` means —
# but the C it lowers to is a statement expression, and one whose value is discarded draws
# a -Wunused-value. Writing the discard down as a cast says the same thing to the reader
# and keeps the build log free of nine warnings nobody should have to learn to ignore.
# c_at records the position the SAt marker carries, and hands cc the same answer as a
# `#line` directive.
#
# That directive is what makes the C a DETAIL rather than a place a programmer has to go.
# Everything downstream of this compiler — a cc diagnostic about generated C, a debugger
# stopping in it, a profiler naming a function — spoke in terms of a file under
# `.zerg-cache` that nobody wrote. With `#line` they all name the `.zg` the person is
# editing, for the cost of one directive per statement.
#
# It must start at column 0, and it is emitted with a newline on BOTH sides rather than
# only after: a `guard` lowers to a GNU statement-expression that puts its statements
# inline, so a directive with no leading break landed mid-line and cc read it as an
# expression. A statement whose C spans several lines has only its
# first line mapped exactly; the rest are attributed to the lines after it, which is the
# ordinary trade every transpiler that emits these makes.
#
# A source with no path gets no directive: pointing cc at "" would be worse than leaving it
# pointing at the C it can actually open.
# c_mark is the marker WITHOUT the directive, and it is a name of its own because two walks
# read the SAt markers and only one of them emits C. The pre-passes that refuse a `break`
# belonging to no loop and a jump leaving a `guard` walk the same statement list ahead of
# emission; before this they carried no position at all and their refusals pointed at the
# enclosing declaration. Setting `em.at_*` in each of them would have been a second place
# that knows how a statement's place is recorded.
fn c_mark(mut &em: Emitter, l: int, c: int) {
	em.at_line = l
	em.at_col = c
}

fn c_at(mut &em: Emitter, l: int, c: int) -> str {
	c_mark(em, l, c)
	return "" if em.at_path == ""
	ls := strconv.to_string(l, 10)
	return f"\n#line {ls} \"{em.at_path}\"\n"
}

fn c_expr_stmt(mut &em: Emitter, e: ast.Expr, ind: str) -> str {
	rendered := c_expr(em, e, c_nosub())
	return f"{ind}(void)({rendered});\n" if c_discards_a_value(e)
	return f"{ind}{rendered};\n"
}

# c_discards_a_value names the forms that ARE an expression, are legal as a statement, and
# lower to C whose own value nobody then reads: `guard { risky() }` written for its catching
# alone, a `{ … }` block standing as a statement of its own, and — GRAMMAR group 4's "a
# match run for effect" — a `match` whose arms are all effect. All three draw a
# `-Wunused-value`, so the discard is written down as a cast, which says the same thing to a
# reader and keeps cc's warning AND the generated C line it quotes off the user's stderr.
#
# A `match` reaches it by a different C shape from the other two — a ternary rather than a
# statement expression — which is why the name is about the DISCARD and no longer about the
# braces: the brace was the thing the first two happened to share, not the reason either one
# needed the cast. A match with a CALL in every arm never warned, so the gap looked like it
# was about matches with literal arms; it is about every arm being a value cc can see is
# unused.
fn c_discards_a_value(e: ast.Expr) -> bool {
	return match e {
		Expr.EGuard(_) => true
		Expr.EBlock(_) => true
		Expr.EMatch(_, _) => true
		_ => false
	}
}

# c_is_listlit is whether an expression BUILDS A LIST IN PLACE, from elements written at this
# expression rather than computed somewhere else. The fill form is one: `[7; 3]` is `[7, 7, 7]`
# with the repetition factored out, so a declaration of `list[byte]` must adopt its elements
# exactly as it adopts the spelled literal's. It is a node of its own only because its count is
# a const-expr — that is a fact about the COUNT, not about the value.
pub fn c_is_listlit(e: ast.Expr) -> bool {
	return match e {
		Expr.EListLit(_) => true
		Expr.EFill(_, _) => true
		_ => false
	}
}

# c_listlit_elems is a list literal's ELEMENTS, or an empty list from anything else. It is
# the one place `EListLit` is taken apart: the arm was written out at four sites across two
# files, and the day the node grows a payload — an inferred element type is the obvious
# candidate — four arms need editing and the one in check.zg is the one a reader of this file
# will not find. The fill form is expanded HERE for the same reason, so that every position
# that reads a literal's elements reads a fill's without knowing there are two nodes.
#
# Expanding more than once per expression is free: the walk revisits a literal to check it, to
# type it and to lower it, and a count that does not fold reports through chk_at_place, which
# drops an exact repeat.
pub fn c_listlit_elems(mut &em: Emitter, e: ast.Expr) -> list[ast.Expr] {
	return match e {
		Expr.EListLit(elems) => elems
		Expr.EFill(v, n) => c_fill_elems(em, v, n)
		_ => []
	}
}

# c_is_empty_listlit is `[]` and only `[]` — the literal that carries no element type and
# needs one from the declaration it initializes. A literal WITH elements carries both, and so
# does `[v; 0]`: an empty EXPANSION still names its element in `v`, which is why the fill form
# is not one of these however its count folds.
fn c_is_empty_listlit(e: ast.Expr) -> bool {
	return match e {
		Expr.EListLit(elems) => elems.len() == 0
		_ => false
	}
}

# c_fill_elems expands `[v; N]` into the N copies it means (GRAMMAR group 4's `list-lit`).
#
# The count is a CONST-EXPR, so it goes through chk_const_eval — the one fold in this compiler
# — rather than being read off a token: `[0; 256]`, `[0; 2 * 128]` and `[0; SIZE]` are the same
# request, and a position that accepted only the first was accepting a literal, not a constant.
#
# A count that does not fold is reported HERE, at the use site, which is what GRAMMAR asks for:
# the constant's declaration is a perfectly good line with nothing wrong on it, and the reader
# needs the line that wanted a compile-time value. An empty expansion is what the rest of the
# unit then sees, so one bad count is one finding rather than a cascade.
fn c_fill_elems(mut &em: Emitter, v: ast.Expr, n: ast.Expr) -> list[ast.Expr] {
	mut out: list[ast.Expr] = []
	f := check.chk_const_eval(em, n)
	if not f.ok {
		check.chk_at(em, rule.Rule.FillCountNotConstant, f"a fill count is a compile-time constant, and {ast.expr_kind(n)} is not one — GRAMMAR gives `[v; N]` a const-expr, which is literals, other compile-time constants and the operators over them, and no function calls")
		return out
	}

	# A COUNT IS A COUNT. The old parser could not reach this case — it read one integer token,
	# so `-1` was "not an integer literal" — and the fold can: a negative count silently built
	# the empty list, which is not what `[0; -1]` asks for and not something a reader would
	# look for.
	if f.value < 0 {
		check.chk_at(em, rule.Rule.FillCountNegative, f"a fill count is how many copies to make, and `{strconv.to_string(f.value, 10)}` is negative")
		return out
	}

	mut i := 0
	for i < f.value {
		out.append(v)
		i = i + 1
	}
	return out
}

# c_assign lowers `lhs = rhs`. Re-assigning a list literal to a name re-initialises the
# list (leak-style: the old buffer is abandoned); otherwise the lhs (a name, field, or
# index) is emitted as a C lvalue.
fn c_assign(mut &em: Emitter, lhs: ast.Expr, rhs: ast.Expr, ind: str) -> str {
	check.chk_assignable(em, lhs)

	# `m[k] = v` INSERTS, so it is a set rather than a store through the index
	if c_is_index(lhs) {
		tt := c_infer(em, c_index_target(lhs))
		if c_is_map(tt) {
			em.used_rt = true
			return c_map_set(em, c_index_target(lhs), c_index_key(lhs), rhs, tt, ind)
		}
	}
	lt := c_infer(em, lhs)
	check.chk_assigned(em, lhs, lt, rhs)
	lv := c_lvalue(em, lhs, c_nosub())

	# assigning INTO an optional takes the same wrap a declaration does: `x = nil` makes it
	# absent, `x = 5` present. Without it the C compiler saw an int where a carrier goes.
	#
	# It leaves early, so it needs its OWN materialise-then-drop — the one at the bottom of
	# this function is on a path a carrier never reaches. Two spellings of the same rule is
	# what c_assign_dropping exists to prevent; what is written twice is only the call.
	if c_is_carrier(lt) {
		cval := c_carrier_fit(em, check.chk_target_name(lhs), lt, rhs, c_nosub())
		return c_assign_dropping(em, lt, lv, cval, ind) if c_assign_drops(em, lt)

		return f"{ind}{lv} = {cval};\n"
	}

	# A LIST LITERAL IS BUILT BESIDE THE DESTINATION AND MOVED IN, which is the same
	# materialise-release-store `c_assign_dropping` writes for every other owning type, spelled
	# out here because a literal is built by STATEMENTS (`c_pushes`) rather than produced as an
	# expression this function could hand along.
	#
	# It used to re-init the destination and then push into it, and that lost twice. The old
	# buffer was ABANDONED — `cur = [7]` in a 1,000,000-round loop peaked at 78.4 MB against a
	# 1.4 MB floor, and `strings.split` resets its accumulator exactly that way once per
	# separator, which is what made every caller of it look like a leak of its own (#11). And
	# the elements were evaluated AFTER the destination had been emptied, so a literal that
	# reads what it replaces read the emptied list: `xs = [xs[0], xs[2]]` raised
	# _IndexError: index out of range_ on a program that is correct.
	#
	# The address is taken ONCE, for the reason c_assign_dropping takes it once: `lv` may be a
	# list index whose subscript arithmetic must not be computed twice around a release.
	if c_is_list(lt) and c_is_listlit(rhs) {
		em.used_rt = true

		et := c_type(c_list_elem(lt))
		ct := c_type(lt)
		lp := c_tmp(em, "zgt_lp")
		nv := c_tmp(em, "zgt_nl")
		mut out := ind + "{ " + ct + " *" + lp + " = &(" + lv + "); " + ct + " " + nv + "; "
		out = out + f"zrt_list_init(&{nv}, sizeof({et}), &{c_elem_vt(em, c_list_elem(lt))});\n"
		out = out + c_pushes(em, nv, et, rhs, ind)
		return out + ind + c_drop_stmt(em, lt, f"(*{lp})") + " *" + lp + " = " + nv + "; }\n"
	}

	# Every other assignment copies through the one rule — including a list, which used to
	# have its own branch here saying the same thing a second way. c_into, not c_copied: the
	# storage has a DECLARED type, which makes this a typed position, and `b = i` for a `byte`
	# binding truncated rather than raising.
	val := c_into(em, lt, rhs, c_nosub())
	return c_assign_dropping(em, lt, lv, val, ind) if c_assign_drops(em, lt)

	return f"{ind}{lv} = {val};\n"
}

# c_assign_drops is whether an assignment has to give the OLD value back before it writes
# the new one, and it is deliberately narrower than "the type owns something".
#
# A recursive enum has no choice: the binding's reference to the head cell is the only one
# there is, so an assignment that does not release it loses the whole chain — the leak this
# was written for cannot be closed at scope exit alone. A CARRIER is the same sentence one
# shape along, and it joins for the same reason rather than by inheriting: the carrier arm
# leaves c_assign early and never reaches the path the enum takes.
#
# AND NOW EVERY OTHER OWNING TYPE, which is what this used to say was a real gap: it reaches
# every `str`, `list`, `map`, tuple, struct and held-function assignment in the language, and
# `docs/core/memory.md` named it as the shape that leaks without bound in an ordinary loop.
#
# Measured, because the gap said it needed its own measurement. `cur = [7]` in a 1,000,000-round
# loop peaked at 78.4 MB against a 1.4 MB floor before this, and `strings.split` — whose inner
# loop does exactly that to reset its accumulator — leaked 16 bytes a call, which is what made
# every caller of it look like a leak of its own (issue #11 read one as a temporary that is never
# released; a nested temporary measures clean once `split` does).
#
# THE QUESTION IS NOW THE ONE `c_drop_fn` ANSWERS, and that is the point: a type that has a drop
# is a type whose old value is somebody's to end, so there is no second list of which types those
# are. The two shapes that used to be here — the carrier and the recursive enum — are two rows of
# that same answer rather than exceptions to it.
fn c_assign_drops(mut &em: Emitter, t: ast.Ty) -> bool {
	return c_drop_fn(em, t) != ""
}

# c_assign_dropping writes the assignment as materialise, release, store — IN THAT ORDER.
#
# `acc = L.Cons(i, acc)` builds the new value OUT OF the old one, so a release written first
# frees what the right-hand side is still reading. This is the rule `s = s + x` is under, and
# the shape the seed emits for the same statement.
#
# The destination's address is taken ONCE. `lv` may be a list index, which lowers to an
# expression with its own subscript arithmetic in it, and naming it twice would compute it
# twice — around a release, which is exactly where a second evaluation must not happen.
#
# THE TWO NAMES CARRY A TAG, like every other temporary this file mints (`zgt_ce{tag}`,
# `zgt_se{tag}`) and unlike the first version of this function, which spelled them
# `zgt_lp` and `zgt_nv` flat. Nothing nests an assignment inside another one TODAY, so
# the flat names were correct — and that is exactly the kind of correctness that is a
# property of today's lowerings rather than of this function. A future one that nests
# would shadow silently and free the wrong storage, with nothing to report it.
fn c_assign_dropping(mut &em: Emitter, t: ast.Ty, lv: str, val: str, ind: str) -> str {
	ct := c_type(t)
	lp := c_tmp(em, "zgt_lp")
	nv := c_tmp(em, "zgt_nv")
	mut out := ind + "{ " + ct + " *" + lp + " = &(" + lv + "); " + ct + " " + nv + " = " + val + "; "
	return out + c_drop_stmt(em, t, f"(*{lp})") + " *" + lp + " = " + nv + "; }\n"
}

# c_elem_exprs renders a list literal's elements AT the element type the declaration gives,
# and in the CURRENT scope — before a binding that would shadow one of the names they
# mention enters it.
# Rendering them at their own types put a bare int into a slot whose C type is an optional's
# carrier — `xs: list[int?] = [nil, 1]` — so the tag it was read back through was whatever
# the value's first bytes happened to be, when it compiled at all.
fn c_elem_exprs(mut &em: Emitter, lit: ast.Expr, elem: ast.Ty) -> list[str] {
	mut out: list[str] = []
	c_elem_exprs_into(em, c_listlit_elems(em, lit), elem, out)
	return out
}

fn c_elem_exprs_into(mut &em: Emitter, elems: list[ast.Expr], elem: ast.Ty, mut &out: list[str]) {
	# THE LABEL IS THE CHECKER'S, character for character. Both walks reach the same bad
	# element and both report at the statement's place, so an identical sentence is one
	# finding after chk_at_place's dedupe and two if the wording drifts by a word.
	mut i := 0
	for e in elems {
		i = i + 1
		out.append(c_fit_copied(em, check.chk_elem_says(i), elem, e, c_nosub()))
	}
}

fn c_skip() {
	nop
}

# c_pushes_strs assembles the pushes from already-rendered element expressions.
fn c_pushes_strs(target: str, et: str, vals: list[str], ind: str) -> str {
	mut out := ""
	for v in vals {
		out = out + ind + "{ " + et + " zgt_le = " + v + "; zrt_list_push(&" + target + ", &zgt_le); }\n"
	}
	return out
}

# c_fill_pushes writes a fill form's pushes: the value ONCE into a temp, then a push per copy
# — the first taking that value and every later one a copy, because a push owns what it is
# handed and N slots sharing one refcounted cell is a double free waiting for the second
# release.
#
# It exists because a list literal reaches C by THREE roads — a value (c_fill_lit), a push
# sequence (c_pushes), and a binding that renders at its DECLARED element type (c_let_list) —
# and the fill was expanded into N copies of the EXPRESSION for all three. `xs := [bump(c); 3]`
# called `bump` three times and held 1, 2, 3, from a form whose whole meaning is that the three
# are one value. Fixing a road at a time is how a form comes to mean one thing bound and
# another passed, so the rule is written once and the roads call it.
fn c_fill_pushes(mut &em: Emitter, target: str, et: str, vty: ast.Ty, rendered: str, cnt: int, ind: str) -> str {
	mut out := ind + "{ " + et + " zgt_fv = " + rendered + ";\n"
	mut i := 0
	for i < cnt {
		mut src := "zgt_fv"
		if i > 0 and c_needs_copy(em, vty) {
			src = c_copy_of(em, vty, "zgt_fv")
		}
		out = out + ind + "{ " + et + " zgt_le = " + src + "; zrt_list_push(&" + target + ", &zgt_le); }\n"
		i = i + 1
	}
	return out + ind + "}\n"
}

# c_pushes emits a zrt_list_push per element of a list literal.
fn c_pushes(mut &em: Emitter, target: str, et: str, lit: ast.Expr, ind: str) -> str {
	mut filled := ""
	match lit {
		Expr.EFill(v, n) => {
			cnt := c_fill_elems(em, v, n).len()
			if cnt > 1 {
				filled = c_fill_pushes(em, target, et, c_infer(em, v), c_expr(em, v, c_nosub()), cnt, ind)
			}
		}
		_ => {
			nop
		}
	}
	return filled if filled != ""

	return c_pushes_of(em, target, et, c_listlit_elems(em, lit), ind)
}

fn c_pushes_of(mut &em: Emitter, target: str, et: str, elems: list[ast.Expr], ind: str) -> str {
	mut out := ""
	mut i := 0
	for i < elems.len() {
		out = out + ind + "{ " + et + " zgt_le = " + c_expr(em, elems[i], c_nosub()) + "; zrt_list_push(&" + target + ", &zgt_le); }\n"
		i = i + 1
	}
	return out
}

# c_const_globals declares each module constant as a C global and records its type, so
# c_reset_env can put it in scope. The VALUE is not written here: a C global's initializer
# must be a constant expression and `const s = "a" + "b"` is not one, so the assignment
# goes into main alongside the init() calls — which is also what makes the order defined.
# A module constant is ONE object, not one per unit. Every unit used to emit `static` for
# every constant in the program, and the assignment was emitted only in the unit that has
# `main` and only for the constants that unit declares — so a constant declared in an
# imported module was never assigned ANYWHERE and every reader saw a zero. `lib.LIMIT` and
# the `pub fn limit()` written to work around it both answered 0, silently, and `--emit c`
# and `--emit bin` disagreed because the single-unit path has no other unit to be wrong in.
#
# The unit that DECLARES it defines it; every other unit declares it `extern`. `whole` is
# the single-unit build, where own IS the program and `static` is right.
# c_build_const_vals folds every module constant's initializer, once, into kv_names / kv_vals
# — the table chk_fold_name reads when a compile-time position names a constant (GRAMMAR
# group 7).
#
# IT RUNS FIRST, ahead of every other table, because the first pass that needs a compile-time
# value is c_build_enums: `enum E { A = BASE }` is a discriminant naming a constant, and the
# constants are not otherwise registered until the globals are rendered, most of a unit later.
# Splitting the value out from the type is what makes that possible — folding `2 + 3` asks
# nothing about types, while INFERRING the constant's type asks c_infer, which needs the enum
# and struct tables this pass runs before.
#
# In c_const_order, not source order, so `const A := B` folds after `B` however they are
# written — the same order c_const_globals assigns in, from the same function, because a
# constant that folds here and is assigned there in a different order is two answers to one
# question.
fn c_build_const_vals(mut &em: Emitter, f: ast.File) {
	for i in c_const_order(em, f) {
		c := f.consts[i]

		# THE FOLD RUNS BEFORE THE ROW IS APPENDED, so `const A := A` names whatever `A` meant
		# outside this declaration — nothing — rather than resolving to the row being built.
		# A `mut` module binding is refused at its declaration (chk_top_muts) and would be a
		# value that can change under a position that has already been given it, so it folds
		# to nothing here regardless of what its initializer says.
		mut v := check.Folded(false, 0)
		if not c.is_mut {
			v = check.chk_const_eval(em, c.value)
		}
		em.kv_names.append(c.name)
		em.kv_vals.append(v)
	}
}

fn c_const_globals(mut &em: Emitter, f: ast.File, own: ast.File, whole: bool) -> str {
	mut out := ""

	# This walk runs before any function body, so no SAt marker covers it — a finding
	# c_infer raises from inside an initializer would otherwise carry whatever the marker
	# last said, which at this point is nothing. The declaration's own place is the answer,
	# same as c_const_assigns.
	keep_path := em.at_path
	keep_line := em.at_line
	keep_col := em.at_col

	# IN DEPENDENCY ORDER, for the same reason the assignments are — and for a second one.
	# This walk INFERS each constant's type, and it infers it by asking c_infer, which reads
	# the environment; so `const A := B` registered `A` as TUnknown when `B` had no row yet,
	# and a TUnknown row is a name c_is_bound answers no about. The use then reported
	# "undefined name `A`" — naming the constant that IS declared, about a line that reads it,
	# while the emitted C was correct all along.
	#
	# `const A := B + 0` worked, which is the tell: c_infer_binary falls back to TInt when both
	# sides are unknown, so the arithmetic accidentally supplied what the bare name could not.
	#
	# Scope 0 is opened here because nothing has opened it yet: c_reset_env does it before each
	# function body, and this walk runs first. A row in env_names that no OPEN scope covers is
	# a row c_live_idx does not see, so seeding without this changed nothing at all.
	em.scope_cur = 0
	em.open_scopes = [0]
	for i in c_const_order(em, f) {
		c := f.consts[i]
		em.at_path = c.path
		em.at_line = c.line
		em.at_col = c.col

		# Every module flattens into ONE namespace, so two that declare the same constant
		# mangle to one symbol. The FUNCTION case has been refused by name since the tables
		# were written; this one linked — two definitions of `zg_N`, tolerated by a linker
		# that still allows a common symbol — and the reader got whichever the linker chose.
		# On a toolchain with `-fno-common` it is a duplicate symbol instead.
		#
		# A constant colliding with a FUNCTION or with a TYPE is the SAME rule and is not
		# asked here, though it was: checked against the signature table alone, its extent
		# was the half a constant walk could see, so `const f := 1` beside `fn f()` was
		# refused and `const A := 1` beside `struct A` reached cc. c_build_top_names asks it
		# of every top-level declaration at once now, and reports at this same place.
		#
		# WHICH of the two rules is the earlier declaration's FILE, exactly as it is for a
		# signature: one file declaring a constant twice is ill-formed for good, and two files
		# under one directory is the flat namespace this compiler still has.
		ki := c_k_idx(em, c.name)
		if ki >= 0 {
			# ONE FILE IS NOT THIS WALK'S TO ANSWER, for the reason c_mod_collide states: it
			# is recorded as E4073 there and rendered at the end, while this raises and would
			# be the only sentence the reader ever saw.
			raise c_mod_flat_collide(c.path, c.line, c.col, c.name, em.k_decls[ki].path) if em.k_decls[ki].path != c.path
		}

		# A WRITTEN annotation is honoured, exactly as c_let honours a local's: the check
		# is chk_binding's — the value must fit the declared type, literals adopting the
		# way they do at every typed position — and the global takes the DECLARED type.
		# Inferring from the value alone made `answer: bool = 42` an int named answer:
		# an annotation the compiler does not check is a comment, and this one was.
		# The mismatch is reported at the declaration (chk_at_place, since a module
		# constant is a statement of no function and no SAt marker knows it), and the
		# row KEEPS the inferred type there, so c_const_assigns still renders a value
		# that fits the global while the finding is what ends the build.
		mut ty := c_infer(em, c.value)
		if c.has_ty {
			if check.chk_fits_expr(em, c.ty, ty, c.value) {
				ty = c.ty
			} else {
				check.chk_bind_mismatch(em, c.path, c.line, c.col, ty, c.ty, c.name)
			}
		}

		# the DECLARATION as written, and beside it the one thing this walk worked out: the
		# type. `const`, `mut`, `pub` and the declaring module are all read back off the row
		# where they are needed — c_reset_env for the first two, chk_visible for the last
		# two, whose module is `c_mod_of` of the row's path.
		em.k_decls.append(c)
		em.k_tys.append(ty)

		# AND INTO SCOPE 0 AS IT IS REGISTERED, so the next constant in this same walk can
		# name it. c_reset_env seeds these rows before every function body, which is what
		# makes a constant visible to ordinary code — but that runs later, and this walk is
		# the one that needs the answer.
		c_const_bind(em, c, ty)

		# the global about to be rendered SPELLS `c_type(ty)`, and this walk runs in EVERY
		# unit — including the one that defines a constant whose value only the entry unit
		# lowers. `pub PAIR := (1, 2)` in a module reached cc as `unknown type name
		# 'zgt_tup_int64_t_int64_t'` on the module's own unit, because nothing there ever
		# built the value. The registered text lands in the on-demand sections, which the
		# globals follow; a scalar or a container answers "nothing to do" by itself.
		c_spelled_register(em, ty)
		if whole {
			out = out + f"static {c_type(ty)} zg_{c.name};\n"
		} else if c_const_in(own, c.name) {
			out = out + f"{c_type(ty)} zg_{c.name};\n"
		} else {
			out = out + f"extern {c_type(ty)} zg_{c.name};\n"
		}
	}
	em.at_path = keep_path
	em.at_line = keep_line
	em.at_col = keep_col
	return out
}

# c_const_bind puts one constant's row into scope 0, which is what c_reset_env does for all of
# them before every function body. It is spelled once and called from both, because a row
# written two ways is two rows the day one of them gains a field.
fn c_const_bind(mut &em: Emitter, c: ast.ConstDecl, ty: ast.Ty) {
	em.env_names.append(c.name)
	em.env_tys.append(ty)
	em.env_cnames.append("zg_" + c.name)
	em.env_dead.append(0)
	em.env_mut.append(c.is_mut)
	em.env_scope.append(0)
	em.env_const.append(c.is_const)

	# EMPTY, and deliberately: a module constant's folded value lives in kv_vals, which
	# c_build_const_vals filled before any of this ran. chk_fold_name routes a module-constant
	# row there rather than reading this column, so the constant has exactly one value and no
	# way for two copies of it to drift.
	em.env_cval.append(check.Folded(false, 0))
}

fn c_const_in(f: ast.File, name: str) -> bool {
	for c in f.consts {
		return true if c.name == name
	}
	return false
}

# c_const_assigns is the constants' values, assigned before any init() runs.
fn c_const_assigns(mut &em: Emitter, f: ast.File) -> str {
	# A module constant's initializer is emitted into the ENTRY's wrapper, so the statement
	# marker still names the entry file while the code belongs to whichever module declared
	# the constant. The marker is pointed at the DECLARATION instead — ConstDecl carries its
	# own path/line/col for exactly this — which answers two questions at once: a finding
	# raised while rendering the value reports the constant's own place rather than a stale
	# marker with no file (the `has_place` contract), and the visibility rule reads the
	# declaring module as the one doing the reading, so `m`'s constant calling `m`'s own
	# private function stays quiet. Clearing the path was the earlier answer to the second
	# question, and it silently gave the first one away.
	keep_path := em.at_path
	keep_line := em.at_line
	keep_col := em.at_col
	mut out := ""

	# IN DEPENDENCY ORDER, NOT SOURCE ORDER. These are assignments that RUN, so a constant
	# naming another has to be assigned after it — and they used to run top to bottom, so
	# `const A := B + 1` written above `const B := 5` read `B` as the zero its global was
	# still holding and answered `1`. Silent, and the reader has no reason to suspect the
	# order of two declarations that do not look ordered at all.
	#
	# GRAMMAR puts no ordering requirement on a declaration, and the rest of this compiler
	# does not either: a function may call one declared below it. A constant is the only
	# top-level form whose meaning depended on where it was written.
	for i in c_const_order(em, f) {
		c := f.consts[i]
		em.at_path = c.path
		em.at_line = c.line
		em.at_col = c.col

		# the value is rendered AGAINST the recorded type — row i of k_tys, appended by
		# c_const_globals from this same list — so an annotated declaration gets c_let's
		# own paths: a literal adopts the annotation (c_into) and a declared `T?` wraps a
		# bare value (c_carrier_fit). On a mismatch c_const_globals kept the INFERRED
		# type and reported, so what is rendered here still fits the global it fills.
		# BY NAME, not by position. `k_tys` is appended by c_const_globals in DEPENDENCY order
		# and `f.consts` is in source order, so the two indices stopped being the same one the
		# moment this walk was ordered — `const ALIAS := BASE` took the row of whichever
		# constant happened to be registered third and rendered an int through
		# `zrt_str_retain`. c_k_idx is the lookup that cannot drift, and it is the same one the
		# duplicate-name check already uses.
		ty := em.k_tys[c_k_idx(em, c.name)]
		mut val := c_into(em, ty, c.value, c_nosub())
		if c.has_ty and c_is_carrier(ty) {
			val = c_carrier_fit(em, check.chk_binding_says(c.name), ty, c.value, c_nosub())
		}
		out = out + f"    zg_{c.name} = {val};\n"
	}
	em.at_path = keep_path
	em.at_line = keep_line
	em.at_col = keep_col
	return out
}

# c_const_order is the constants' indices, each after every constant it names.
#
# It is a repeated sweep rather than a proper topological walk, which is the right trade at
# this size: the list is a program's whole constant table, the inner test is a name lookup, and
# the alternative needs an edge set built first. What matters is the TERMINATION — a sweep that
# places nothing has found a cycle, and a cycle is refused by name rather than left to whatever
# order the sweep happened to reach.
fn c_const_order(mut &em: Emitter, f: ast.File) -> list[int] {
	n := f.consts.len()
	mut done: list[bool] = []
	mut i := 0
	for i < n {
		done.append(false)
		i = i + 1
	}

	seq := c_const_seq(em, f)
	mut out: list[int] = []
	for out.len() < n {
		mut placed := 0
		for j in seq {
			if not done[j] and c_const_ready(f, f.consts[j].value, done) {
				done[j] = true
				out.append(j)
				placed = placed + 1
			}
		}
		raise c_const_cycle_says(f, done) if placed == 0
	}
	return out
}

# c_const_seq is the order the sweep VISITS the table in, and with it the whole of the
# tie-break rule: dependency order is decided by `c_const_ready`, and everything the graph
# leaves unordered is decided HERE.
#
# BY CANONICAL MODULE NAME, which is what `docs/runtime/package.md` says decides it. The
# sweep used to visit in table order, so the tie went to whichever module was loaded first
# — the order the IMPORTS WERE WRITTEN. That is stable for a given source, so it was never
# a reproducibility defect; it made a program's side-effect order depend on the arrangement
# of its import block, which is a thing a reader moves for readability (#70).
#
# The module NAME and not its path, and after `mod_id` that is no longer the same decision:
# an identity is `stdlib:io` or `project:util/text` — a root and a path under it — so the
# same program built from a relative and an absolute entry sorts one way. Within a module
# the table's own order stands, which is the source order the loader read the files in.
fn c_const_seq(em: Emitter, f: ast.File) -> list[int] {
	mut keys: list[str] = []
	for c in f.consts {
		keys.append(check.c_mod_of(em, c.path))
	}

	mut out: list[int] = []
	mut j := 0
	for j < keys.len() {
		# `<=` and not `<`: the first row of a STRICTLY greater key is where this one goes,
		# so equal keys keep the order they came in and the sort stays stable.
		mut at := 0
		for at < out.len() and keys[out[at]] <= keys[j] {
			at = at + 1
		}

		mut next: list[int] = []
		mut i := 0
		for i < out.len() {
			if i == at {
				next.append(j)
			}
			next.append(out[i])
			i = i + 1
		}
		if at >= out.len() {
			next.append(j)
		}
		out = next
		j = j + 1
	}
	return out
}

# c_const_ready is whether every constant this initializer names has been assigned already —
# NAMES DIRECTLY, or reaches through a call.
#
# It used to stop at the call: *a function call is ordinary code and runs when the assignment
# does*, which is true about WHEN it runs and false about WHAT it reads. `const EARLY :=
# pick()` beside a `pick` whose body returns `LATER` has a dependency on `LATER` that no bare
# name in the initializer spells, so the sweep placed `EARLY` first and it took the zero value
# — an empty string, silently, exit 0 (#14). In `src/stdlib/log.zg`, where three module
# constants are filled by functions that read a sentinel, the same hole was a SIGSEGV.
#
# So a call is followed into the callee's body, and the constants that body names are this
# initializer's too, transitively. `seen` is what stops a recursive or mutually recursive
# callee from being followed for ever; a function already being followed can add no name the
# walk does not already have.
#
# IT OVER-APPROXIMATES, in two ways that are worth naming because the refusal is what a reader
# meets. A constant read on a branch the call never takes is still a dependency here — a
# static walk cannot know the branch — and a METHOD is matched by NAME across every receiver,
# because the type that would pick one is inferred by a walk this ordering decides the order
# of. Both can only make a constant wait longer, and the one observable cost is a ConstCycle
# naming a path that is not truly circular. That is a loud, rare wrong answer in place of a
# silent, ordinary one.
fn c_const_ready(f: ast.File, e: ast.Expr, done: list[bool]) -> bool {
	mut seen: list[str] = []
	return c_const_ready_at(f, e, done, seen)
}

fn c_const_ready_at(f: ast.File, e: ast.Expr, done: list[bool], mut &seen: list[str]) -> bool {
	idx := c_const_idx(f, e)

	return done[idx] if idx >= 0

	return false if not c_const_ready_call(f, e, done, seen)

	for p in ast.expr_parts(e) {
		return false if not c_const_ready_at(f, p, done, seen)
	}
	return true
}

# c_const_ready_call is the half above that reaches through a call: the callee's body, walked
# for the constants it names. An expression that calls nothing answers yes and costs a string
# compare.
fn c_const_ready_call(f: ast.File, e: ast.Expr, done: list[bool], mut &seen: list[str]) -> bool {
	nm := c_callee_name(e)

	return true if nm == ""
	return true if c_seen_fn(seen, nm)

	seen.append(nm)

	# EVERY row of that name, not the first: a free function's name is unique in this
	# compiler's flat namespace, but a method's is not, and the receiver that would choose
	# between them is not known here.
	mut i := 0
	for i < f.fns.len() {
		if f.fns[i].name == nm {
			return false if not c_const_ready_stmts(f, f.fns[i].body, done, seen)
		}
		i = i + 1
	}
	return true
}

# c_const_ready_stmts walks a body the way stmt_exprs and stmt_kids divide it — what each
# statement mentions, then what it holds. Both are exhaustive over Stmt with no catch-all, so
# a form written inside a bare block or an `assert` is reached here rather than silently
# contributing no dependency.
fn c_const_ready_stmts(f: ast.File, body: list[ast.Stmt], done: list[bool], mut &seen: list[str]) -> bool {
	mut i := 0
	for i < body.len() {
		s := body[i]
		for e in ast.stmt_exprs(s) {
			return false if not c_const_ready_at(f, e, done, seen)
		}
		return false if not c_const_ready_stmts(f, ast.stmt_kids(s), done, seen)
		i = i + 1
	}
	return true
}

# c_callee_name is the function an expression CALLS, or "" for one that calls nothing. The
# catch-all is right here and wrong in expr_parts next door, and the difference is what is
# being asked: this is one question about one node, which a node that is not a call answers
# no to; expr_parts must know every node's contents, so a `_` there is a hole.
fn c_callee_name(e: ast.Expr) -> str {
	return match e {
		Expr.ECall(nm, _, _) => nm
		Expr.EMethod(_, nm, _) => nm
		_ => ""
	}
}

fn c_seen_fn(seen: list[str], nm: str) -> bool {
	for s in seen {
		return true if s == nm
	}
	return false
}

# c_const_idx is the row this expression names, or -1 when it names no constant. Only a bare
# identifier can: a qualified `m.K` is a field read to this parser, and a module's constants
# flatten into one namespace before they reach here.
fn c_const_idx(f: ast.File, e: ast.Expr) -> int {
	return match e {
		Expr.EIdent(nm) => c_const_row(f, nm)
		_ => 0 - 1
	}
}

fn c_const_row(f: ast.File, nm: str) -> int {
	mut i := 0
	for i < f.consts.len() {
		return i if f.consts[i].name == nm
		i = i + 1
	}
	return 0 - 1
}

# c_const_cycle_says names the constants still waiting, which is the cycle plus anything that
# depends on it. Naming the whole waiting set rather than trying to isolate the loop is the
# honest answer: every one of them is a constant this program cannot give a value to.
#
# IT POINTS AT THE FIRST OF THEM. This runs before any statement is emitted, so the marker
# c_diag reads still holds nothing and the refusal said `--> 0:0` — a place that is not one.
# A constant carries its own, and the first waiting declaration is as good an entry into the
# cycle as any: the sentence names them all.
fn c_const_cycle_says(f: ast.File, done: list[bool]) -> str {
	mut names := ""
	mut at := 0 - 1
	mut i := 0
	for i < f.consts.len() {
		if not done[i] {
			if names != "" {
				names = names + ", "
			} else {
				at = i
			}
			names = names + "`" + f.consts[i].name + "`"
		}
		i = i + 1
	}
	c := f.consts[at]
	return c_diag_at(c.path, c.line, c.col, rule.Rule.ConstCycle, f"these constants depend on each other and none can be given a value first: {names} — a constant's initializer may name a constant declared anywhere, but not one that names it back")
}

# c_main_entry writes the program's C entry: a WRAPPER carrying the top-level
# initialization and the call to `main`, and the runtime shim that runs it under a root
# abort handler.
#
# The defect it closes is that there was no root handler at all. The emitted `int main`
# called the body directly, so an uncaught abort reached `zrt_unwind_abort` with no handler
# installed, took its `exit(1)` last resort, and left the cleanup stack standing — every
# `defer` pending at the top level skipped, on the one path a reader most needs them. Every
# other exit ran them: a normal return, an early `return`, each round of a loop, and an
# abort a `guard` demoted, which is the case that made the gap look like coverage.
#
# THE WRAPPER IS WHAT PUTS THE INITIALIZATION INSIDE THE HANDLER. A module constant's
# initializer and every `init()` run before main's body and can abort like any other code;
# emitted straight into `int main` they sat outside whatever handler the body had. A
# concurrent program had exactly that shape and still does not: `zrt_sched_main_nil(zg_main)`
# guards the body and not the prologue. One wrapper fixes both, because both families of
# shim take the same nullary function.
#
# THE WRAPPER'S NAME IS OUT OF REACH. `__zerg_entry` and `__zerg_args` cannot be written by
# a Zerg program, because every Zerg name mangles through `zg_`: a program that declares
# `entry__` or a module constant named `args__` used to collide with them, and the
# collision surfaced as a `cc` error against generated C — for the constant, as a silently
# wrong answer, since the initializer assigned to the wrapper's PARAMETER instead. The seed
# already named its init aggregator `__zerg_init_main` for the same reason.
#
# The bracket itself is the RUNTIME's. `zrt_run` has spelled it since the `Result[nil]`
# entry existed and `coro_trampoline` spells it for every coroutine; a copy in emitted text
# would be the only one no compiler in this repository ever checks. What is decided here is
# which shim runs the wrapper — the scheduler's when the program is concurrent, entry.c's
# when it is not — and that is the only difference between the two paths left.
#
# A program that reaches the runtime NOWHERE keeps the plain entry it has always had. Its
# cleanup stack cannot be non-empty, because a `defer` needs the runtime and so does every
# raise, so the handler would guard an empty unwind — and buying it would cost every trivial
# program the whole runtime, which zergrt.h opens by recording that it does not pay.
#
# The `Result[nil]` arm maps the entry's Result to the exit docs/runtime/package.md
# specifies: a Left exits 0, and a Right REPORTS its Err on stderr and exits 1. The
# reporting is zrt_raise_err — the same funnel a forced Err already goes up, `Kind:
# message` and all — raised from the wrapper, so the message travels the root handler's
# own path and the exit status is the one every abort already has. Both used to be
# dropped: such a main fell to the nil shape, its `Right` was discarded and the program
# exited 0, which was this file's documented discarded-Result deviation. (The seed's
# zrt_run maps the tag to a status and prints nothing; the sentence the spec makes about
# stderr is `zerg`'s to keep.)
#
# Every OTHER declared result — a `str`, a struct, a `Result[int]` — is refused by name:
# each of those used to fall to the nil shape too, the value silently discarded, and a
# value computed for nobody is the same disease at a different type.
fn c_main_entry(mut &em: Emitter, own: ast.File, inits: str) -> str {
	c_main_params_check(em, own)

	has_args := c_main_has_args(own)
	ret := c_main_ret(own)
	ret_int := c_is_int(ret)
	ret_res := c_is_result_nil(ret)

	raise c_diag(em, rule.Rule.NotYetMainSignature, f"NotImplemented: `fn main() -> {ast.ty_name(ret)}` — the entry's shapes are `fn main()`, `-> int` (the exit status) and `-> Result[nil]` (docs/runtime/package.md); any other result would be computed and silently discarded") if not ret_int and not ret_res and not c_is_nil_ty(ret)

	if has_args and em.used_conc {
		# The scheduler's program-entry shims all take a NULLARY function pointer, so
		# running main(args) as coroutine 0 needs a scheduler shim that does not exist.
		# entry.c's zrt_run_args shows the SHAPE is fine; it is the scheduler's version
		# of it that is missing.
		raise c_diag(em, rule.Rule.NotYetMainArgsWithConcurrency, "NotImplemented: main(args) in a program that uses concurrency")
	}
	if ret_res {
		# The Result travels as an int64 exit code so the two shims `-> int` already has
		# carry it — args or not, concurrent or not — rather than a third family of
		# entry shims existing for one tag test. The raise lands on the root handler the
		# shim armed, which reports the message and answers 1.
		em.used_rt = true
		rcn := c_carrier_ty_cname(ret)
		mut callargs := ""
		if has_args {
			callargs = "__zerg_args"
		}
		mut body := f"    {rcn} zgt_r = zg_main({callargs});\n"
		body = body + "    if (" + c_res_is_right("zgt_r") + ") { zrt_raise_err(" + c_res_err("zgt_r") + "); }\n    return 0;\n"
		if has_args {
			wrap := "static int64_t __zerg_entry(zrt_list __zerg_args) {\n" + inits + body + "}\n\n"
			return wrap + "int main(int argc, char** argv) {\n    return zrt_main_run_args_int(__zerg_entry, zrt_os_args(argc, argv));\n}\n"
		}
		wrap := "static int64_t __zerg_entry(void) {\n" + inits + body + "}\n\n"
		shim := c_main_shim(em, "zrt_sched_main_int", "zrt_main_run_int")
		return wrap + "int main(void) {\n    return " + shim + "(__zerg_entry);\n}\n"
	}

	if not has_args and not c_needs_runtime(em) and not em.used_rt {
		return "int main(void) {\n" + inits + "    return (int)zg_main();\n}\n" if ret_int

		return "int main(void) {\n" + inits + "    zg_main();\n    return 0;\n}\n"
	}

	em.used_rt = true
	if has_args {
		# args in and an exit code out is its own shim. Both compilers used to drop that
		# code — `fn main(args) -> int` returning 2 exited 0 — because the entry called
		# main for effect and answered 0 itself.
		if ret_int {
			wrap := "static int64_t __zerg_entry(zrt_list __zerg_args) {\n" + inits + "    return zg_main(__zerg_args);\n}\n\n"
			return wrap + "int main(int argc, char** argv) {\n    return zrt_main_run_args_int(__zerg_entry, zrt_os_args(argc, argv));\n}\n"
		}
		wrap := "static void __zerg_entry(zrt_list __zerg_args) {\n" + inits + "    zg_main(__zerg_args);\n}\n\n"
		return wrap + "int main(int argc, char** argv) {\n    return zrt_main_run_args(__zerg_entry, zrt_os_args(argc, argv));\n}\n"
	}
	if ret_int {
		wrap := "static int64_t __zerg_entry(void) {\n" + inits + "    return zg_main();\n}\n\n"
		shim := c_main_shim(em, "zrt_sched_main_int", "zrt_main_run_int")
		return wrap + "int main(void) {\n    return " + shim + "(__zerg_entry);\n}\n"
	}
	wrap := "static void __zerg_entry(void) {\n" + inits + "    zg_main();\n}\n\n"
	shim := c_main_shim(em, "zrt_sched_main_nil", "zrt_main_run_nil")
	return wrap + "int main(void) {\n    return " + shim + "(__zerg_entry);\n}\n"
}

# c_main_shim is the one thing a concurrent program decides differently: it runs the entry
# as coroutine 0 and drains the run queue afterwards, so a fire-and-forget `spawn` still
# finishes. Both families arm the same root handler around the same wrapper.
fn c_main_shim(mut &em: Emitter, conc: str, plain: str) -> str {
	return conc if em.used_conc

	return plain
}

# c_init_calls is the `init()` invocations main opens with, in declaration order.
#
# THROUGH c_fn_cname_in, like every other call in this file. An `init()` is parsed as an
# ordinary function named `init__<n>`, where n is its position among the functions of ITS OWN
# FILE — so two modules whose init sits at the same position are two declarations of one name,
# and the collision rule in c_build_sigs already sees them: both are private, so both get a
# module tag and are DEFINED as `zg_m1_init__1` and `zg_m2_init__1`. This line spelled the
# untagged name by hand, so the calls main opened with named a symbol nothing defined:
#
#     error: call to undeclared function 'zg_init__1'
#
# — cc answering for generated C nobody wrote, which is the one outcome the standing rule
# forbids outright. It went unseen because it depends on the POSITION of each `init()` rather
# than on there being two: an entry file whose init is its first function and a module whose
# init is its second mangle to different names and linked by luck.
fn c_init_calls(mut &em: Emitter, f: ast.File) -> str {
	mut out := ""
	for fd in f.fns {
		if parser.is_init_name(fd.name) {
			out = out + "    " + c_fn_cname_in(em, check.c_mod_of(em, fd.path), "", fd.name) + "();\n"
		}
	}
	return out
}

# --- concurrency ----------------------------------------------------------------
#
# A channel is the runtime's zrt_chan by pointer, and the three operations map onto the
# runtime one for one. Both send and receive need the value's ADDRESS — the runtime
# copies elemsz bytes through it — so each goes through a temp: a literal has no
# address, and neither does a call result.
#
# A receive yields a real `Result[T]` on the carrier above, so every operator that reads
# a Result back — `!`, `??`, `if v := <-ch`, `match <-ch { Left … Right … }` — works on a
# receive with no channel-specific code behind it. It also means a close can say WHY:
# there is somewhere to put "no value, and here is the reason", which a bare `T` had not.
#
# WHAT A CHANNEL MAY CARRY is not asked here, and used to be. `chan[T?]` was refused by a
# call on this line — the constructor's lowering path — which is one position out of the
# several a type can be written in, so a `chan[int?]` was turned away where it was BUILT
# and accepted in silence as a parameter, a result, a field, a binding or a typedef. The
# rule is `ty_chan_elem_check` now, asked by `ty_chan` (ast.zg) wherever a channel type is
# CONSTRUCTED, and by the two readers of a constructor's element type — `parse_chan_elem` and
# `subst_chan_elem` — which is the one form that carries an element without ever building the
# type. So this path inherits the rule rather than holding a copy of its own.
fn c_chan_new(mut &em: Emitter, t: ast.Ty, cap: ast.Expr, sb: Subst) -> str {
	em.used_rt = true
	em.used_conc = true
	return f"zrt_chan_new(sizeof({c_type(t)}), (size_t)({c_expr(em, cap, sb)}))"
}

# --- channel direction ------------------------------------------------------------
#
# A direction is a purely COMPILE-TIME property: `chan[T]`, `chan[T]<-` and `<-chan[T]`
# are all one `zrt_chan*`, so nothing below decides a C type. What it decides is two
# things — which operations a name may perform, and which of the runtime's two reference
# counts a handle joins when it is handed over (c_spawn, c_del).

# c_chan_dir is a channel end's direction: 0 bidirectional, 1 send-only (`chan[T]<-`),
# 2 receive-only (`<-chan[T]`). Anything that is not a channel answers 0, so a caller may
# ask without testing first.
fn c_chan_dir(t: ast.Ty) -> int {
	return match t {
		Ty.TChan(_, d) => d
		_ => 0
	}
}

# c_chan_dir_ok reports whether an end of direction `have` may fill a slot declared
# `want`. Narrowing is the spec's one-way built-in upcast: a bidirectional end becomes
# either single direction, and a single direction never goes back and never crosses.
fn c_chan_dir_ok(have: int, want: int) -> bool {
	return true if want == have
	return true if have == 0

	return false
}

# c_chan_check is the narrowing check at every place a channel end fills a declared slot:
# a call argument, a `return`, a typed binding, a struct or variant field. It emits
# nothing — a direction costs no code — so this is the whole of it.
#
# The CODE and the PLACE were both missing, and they are missing together for one reason: a
# `raise` carries a code only when the string is written with one and a place only when the
# site appends the trailer (docs/conformance.md). So this said which two ends disagreed and
# not where, and no gate could pin the rule without pinning its prose. The seed has reported
# it with a place since it was written.
fn c_chan_check(mut &em: Emitter, have: ast.Ty, want: ast.Ty, site: str) {
	raise c_diag(em, rule.Rule.ChanDirectionNarrows, f"a channel direction only narrows: a {ast.ty_name(have)} cannot fill a {ast.ty_name(want)} ({site})") if ast.ty_is_chan(have) and ast.ty_is_chan(want) and not c_chan_dir_ok(c_chan_dir(have), c_chan_dir(want))
}

# c_chan_op_check is the OTHER half of a direction: not where a handle may go, but what a
# name may DO with one. `op` numbers the operation the way c_chan_dir numbers the ends —
# 0 receive, 1 send, 2 close — and each refusal is worded exactly once here, for the six
# lowering sites that ask: `<-ch`, `ch <- v`, `close(ch)`, both kinds of `select` arm, and
# `for v in ch`. A seventh gets the wording rather than a paraphrase of it.
#
# The FIRST question is whether there is a channel here at all, and it belongs to this
# function for the same reason the direction rules do. It used to live at exactly one of
# the six sites — `close(ch)`, worded there, with no code and no place — so the other five
# asked `ty_chan_elem` for an element type, were handed the `TUnknown` it answers for
# anything that is not a channel, and carried on. A receive then typed as `TOpt(TUnknown)`,
# an optional of nothing that `ty_name` spells `?`, and every later sentence was about that
# `?` rather than about the mistake: `` `??` on a ? ``, `E9053 … over a ?`. Where the walk
# never touched the broken type, the C came out with a carrier struct in a `zrt_chan *`
# slot and cc rejected generated code nobody wrote.
#
# The place used to arrive as an `at` PARAMETER, rendered by each of the six callers, because
# this function has the type and only the caller knows which statement wrote it. It reports
# through c_diag now, which reads the same marker those callers were rendering from — so the
# argument was one caller's chance to forget, and three of the four rules below had already
# dropped it once.
fn c_chan_op_check(mut &em: Emitter, t: ast.Ty, op: int) {
	raise c_diag(em, rule.Rule.NotAChannel, f"`{c_chan_op_name(op)}` needs a channel, and {ast.ty_name(t)} is not one" + c_chan_op_hint(t)) if not ast.ty_is_chan(t)

	dir := c_chan_dir(t)
	if op == 0 and dir == 1 {
		# the guarantee the send-only end exists for: it cannot receive (steal) values
		raise c_diag(em, rule.Rule.RecvOnSendOnly, f"cannot receive on a send-only {ast.ty_name(t)}")
	}

	raise c_diag(em, rule.Rule.SendOnRecvOnly, f"cannot send on a receive-only {ast.ty_name(t)}") if op == 1 and dir == 2
	raise c_diag(em, rule.Rule.CloseRecvOnly, f"cannot close a receive-only channel {ast.ty_name(t)}: a consumer may not end a stream on the producers' behalf") if op == 2 and dir == 2
}

# c_chan_op_hint is the one shape the rule above can say more about than "that is not a
# channel". A receive answers `T?` (GRAMMAR group 9), so in `<-(<-cc)` — the nesting the
# self-recursive GRAMMAR#recv-base derives on its own — the OUTER receive is handed a
# `chan[int]?`, and what is wrong with that has nothing to do with nesting: the carrier has
# to be opened in between. It is conditional because saying so to someone who wrote `<-3`
# would be advice about a program they did not write.
fn c_chan_op_hint(t: ast.Ty) -> str {
	return " — a receive answers `T?`, so a receive OF a receive opens the carrier in between: `<-((<-cc)!)`" if ast.ty_is_opt(t) and ast.ty_is_chan(c_carrier_elem(t))
	return ""
}

# c_chan_op_name spells the operation `op` numbers, the way the source writes it, so the
# rule above names what the programmer typed rather than an internal number. A `select`
# arm is the same two operations and gets the same two spellings; `for v in ch` is a
# receive, and its own E3075 has already said `in` by the time it reaches here.
fn c_chan_op_name(op: int) -> str {
	return "<-ch" if op == 0
	return "ch <- v" if op == 1

	return "close(ch)"
}

# --- what a direction does to the two reference counts -----------------------------
#
# The runtime keeps two counts on a channel (src/runtime/csrc/chan.c): `rc`, the holder
# count, whose last holder frees the object; and `senders`, the count of SEND-CAPABLE
# holders, whose reaching zero is what CLOSES the channel. There are two pairs of
# operations over them:
#
#     zrt_chan_copy(c)            rc++
#     zrt_chan_release(c)         rc--                       (frees at zero)
#     zrt_chan_sender_copy(c)     rc++, senders++
#     zrt_chan_sender_release(c)  senders--  (closes at zero), then rc--
#
# So per-direction counting is not a new mechanism — it is choosing which pair to call.
# A handle's direction says whether it is send-capable, and therefore whether it counts
# toward the close:
#
#   handle's direction        handed over (copy)     that handle dropped (release)
#   ------------------------  ---------------------  ------------------------------
#   bidirectional chan[T]     zrt_chan_sender_copy   zrt_chan_sender_release
#   send-only     chan[T]<-   zrt_chan_sender_copy   zrt_chan_sender_release
#   receive-only  <-chan[T]   zrt_chan_copy          zrt_chan_release
#
# Now the paths an end can travel, and what each does:
#
#   a BINDING            takes a reference of its OWN, by its own direction, and gives it
#                        back when its scope ends (c_let_chan registers it on the runtime's
#                        cleanup stack, and the block's unwind is what spends it). An
#                        initializer naming existing storage is copied; a freshly built
#                        handle already carries exactly one reference and is taken over.
#                        This is what makes "close early by narrowing the scope" work with
#                        no statement at all.
#   a `spawn` argument   a handle is duplicated, and its direction is the CALLEE
#                        PARAMETER's, not the caller variable's — that is the whole point:
#                        `spawn consumer(ch)` where consumer takes a `<-chan[T]` must not
#                        add a sender. Copy on capture, release in the spawn thunk's defer
#                        (which runs on the crash path too).
#   a plain call argument  no copy and no release. The callee borrows the caller's handle
#                        for the duration of a call the caller is blocked inside, so the
#                        counts cannot move under it and there is nothing to balance.
#   a parameter          same: it is the borrowed handle, dropped by doing nothing.
#   a return             the handle travels out, so it carries a reference of its own,
#                        taken by the RETURN TYPE's direction — and then this frame's own
#                        bindings are released, as on any other exit.
#   `del name`           nothing at all. It REVOKES the name and no count moves, because
#                        the binding it names is on the pending-release list and its scope
#                        will give the reference back whether or not it was revoked.
#
# The single rule underneath all of it: a count moves only where a HANDLE moves, and every
# handle has exactly one owner.

fn c_chan_copy_fn(dir: int) -> str {
	return "zrt_chan_copy" if dir == 2
	return "zrt_chan_sender_copy"
}

fn c_chan_release_fn(dir: int) -> str {
	return "zrt_chan_release" if dir == 2
	return "zrt_chan_sender_release"
}

# c_chan_defer_thunk is the same choice in the `void (*)(void *)` shape the cleanup stack
# takes. The two are one decision, so they are written next to each other.
fn c_chan_defer_thunk(dir: int) -> str {
	return "zrt_defer_chan_release" if dir == 2
	return "zrt_defer_chan_sender_release"
}

fn c_recv(mut &em: Emitter, ch: ast.Expr, sb: Subst) -> str {
	em.used_rt = true
	em.used_conc = true
	cty := c_infer(em, ch)

	c_chan_op_check(em, cty, 0)
	elem := ast.ty_chan_elem(cty)
	return f"{c_recv_helper(em, elem)}({c_expr(em, ch, sb)})"
}

# c_recv_helper registers one element type's receive helper and answers its name.
#
# There has to be a helper because the runtime reports closure through zrt_chan_recv's
# RETURN value while writing the element through a pointer, and a C expression can be one
# of those or the other, not both. The helper is where the two become one `Result[T]`.
#
# A CLEAN close is an ABSENCE and a CRASH close is a FAILURE, and the language already has
# a different answer for each: `T?` for the first, `raise` for the second. So the receive
# hands back `T?` — nil once the stream is over, and over for good — while a crash close
# raises the producer's own Err, message, cause and kind intact.
#
# That split is what makes the reason impossible to drop. A Result made the caller ask
# WHICH kind of Right it had before it could tell "the stream ended" from "the producer
# died"; anyone who forgot lost the death. Here the two cannot be confused, because they
# do not arrive by the same route.
fn c_recv_helper(mut &em: Emitter, elem: ast.Ty) -> str {
	cn := c_opt_name(em, elem)
	name := "zg_recv_" + c_ident_safe(c_type(elem))
	return name if c_name_in(em.rcv_names, name)
	em.rcv_names.append(name)
	mut d := "static " + cn + " " + name + "(zrt_chan *ch) {\n"
	d = d + "    " + cn + " r = {0};\n"
	d = d + "    " + c_res_tag("r") + " = (int32_t)zrt_chan_recv(ch, &" + c_res_ok("r") + ");\n"
	d = d + "    if (" + c_res_is_right("r") + ") {\n"
	d = d + "        zrt_err e = zrt_chan_close_err(ch);\n"
	d = d + "        if (e.kind != ZRT_ERR_STOP_ITERATION) { zrt_raise_err(e); }\n"
	d = d + "    }\n"
	d = d + "    return r;\n}\n"
	em.rcv_decls.append(d)
	return name
}

# c_send lowers `ch <- v`. The payload is SNAPSHOTTED at the send (docs/code/coroutine.md,
# the Send table), which for anything holding a list means a deep copy and not a C `=`:
# the runtime memcpy's the bytes it is handed, so handing it the sender's own list handle
# gave the receiver a second name for the sender's buffer. Writing through either was then
# visible through the other — across a coroutine boundary, which is the one place the whole
# memory model says cannot happen ("no shared mutable Zerg state").
#
# c_copied is the same rule every other copy site uses, and it costs nothing where nothing
# is shared: a scalar, or a freshly built value that is nobody else's yet, renders as
# itself.
fn c_send(mut &em: Emitter, ch: ast.Expr, v: ast.Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true
	cty := c_infer(em, ch)
	c_chan_op_check(em, cty, 1)

	elem := ast.ty_chan_elem(cty)
	ct := c_type(elem)

	# c_fit_copied wraps a carrier element itself — the `if ty_is_opt(elem)` that used to stand
	# here rendered the value a second time to reach the same answer, which is one temp and one
	# walk of the expression per send
	sv := c_fit_copied(em, "the value sent on this channel", elem, v, c_nosub())
	return ind + "{ " + ct + " zgt_sv = " + sv + "; zrt_chan_send(" + c_expr(em, ch, c_nosub()) + ", &zgt_sv); }\n"
}

# c_spawn lowers `spawn f(args)`. It is the same shape as a defer — a per-site env
# struct and a thunk that unpacks it — with two differences: the env outlives the
# statement, so it is heap-allocated and freed by the thunk, and the call runs on a
# coroutine of its own rather than at scope exit.
fn c_spawn(mut &em: Emitter, x: ast.Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true

	cal := c_callee_of(em, x, "spawn")
	args := cal.args
	idx := em.dfn_n
	em.dfn_n = idx + 1
	tag := strconv.to_string(idx, 10)
	if args.len() == 0 {
		em.dfn_decls.append("static void zg_spawn_" + tag + "(void *p) { (void)p; " + cal.cname + "(); }\n")
		return f"{ind}zrt_spawn(zg_spawn_{tag}, NULL, NULL);\n"
	}

	# ONE pass over the arguments for everything the env struct needs to know: each one's
	# type, its field, its place in the call, and — for a channel — the direction it is
	# captured and released at. Each answer is asked for once. Nothing here renders an
	# argument's VALUE: c_expr mutates the emitter, so a pass whose strings are discarded
	# still bumps the temp counter, registers carriers and can append a whole static
	# function nobody calls. The values are rendered exactly once, below.
	#
	# A channel argument is a HANDLE, not a value: the coroutine gets its own handle and
	# drops it when it returns. Without that the channel's counts never move and it can
	# never close — every `for select` waits forever.
	#
	# WHICH handle is decided by the CALLEE PARAMETER's direction, not by the caller's
	# variable. A consumer declared `<-chan[T]` takes a holder and not a sender, so it does
	# not hold the channel open; before this every spawned argument took a sender, and a
	# consumer you spawned counted as a producer that never finished. `dirs` carries that
	# direction per argument, or -1 for an argument that is not a channel at all.
	# TWO TEARDOWNS, because the two ways this environment can end are not the same list.
	#
	# `drops` is what the BODY owes: the channel handles, and nothing else. Every other
	# capture is handed over to the coroutine and given back by the body's own BY-VALUE
	# PARAMETER when it returns — that is what makes a capture the coroutine's rather than
	# the spawning scope's.
	#
	# `abandons` is what nobody owes when there is no body. A coroutine the scheduler never
	# reaches has no parameters to give anything back, so this list is the channels PLUS
	# every capture the by-value parameter would have released. It is the runtime's, handed
	# to `zrt_spawn`, and the scheduler drops its copy of the pointer the instant the
	# trampoline starts — so exactly one of the two runs, never both.
	mut fields := ""
	mut call := ""
	mut drops := ""
	mut abandons := ""
	mut dirs: list[int] = []
	mut i := 0
	for i < args.len() {
		fi := "f" + strconv.to_string(i, 10)
		at := c_captured_ty(em, cal.key, i, args[i])
		fields = fields + " " + c_type(at) + " " + fi + ";"
		if i > 0 {
			call = call + ", "
		}
		call = call + "e->" + fi
		mut dir := 0 - 1
		if ast.ty_is_chan(at) {
			dir = c_chan_dir(c_param_ty(em, cal.key, i))
			drops = drops + " " + c_chan_release_fn(dir) + "(e->" + fi + ");"
			abandons = abandons + " " + c_chan_release_fn(dir) + "(e->" + fi + ");"
		} else if c_needs_copy(em, at) {
			abandons = abandons + " " + c_drop_stmt(em, at, "e->" + fi)
		}
		dirs.append(dir)
		i = i + 1
	}
	em.dfn_decls.append("typedef struct {" + fields + " } zg_spawnenv_" + tag + ";\n")

	# The teardown is a DEFER, not a statement after the call, because a coroutine can
	# leave without returning. An unhandled abort longjmps straight past everything
	# following the call, and what got skipped was the sender release — so the channel
	# kept a sender that no longer existed, never reached zero, never closed, and every
	# receiver waiting on it blocked forever. A crash became a deadlock.
	#
	# A defer runs on both exits, which is exactly the difference: on the ordinary one it
	# is the coroutine giving up its handles, and on the crash one it is what lets the
	# close carry the crash Err a receiver is meant to see (Fork-C).
	dropfn := "zg_spawndrop_" + tag
	mut dd := "static void " + dropfn + "(void *p) { zg_spawnenv_" + tag + " *e = (zg_spawnenv_" + tag + "*)p; (void)e;"
	dd = dd + drops + " zrt_free(p); }\n"
	em.dfn_decls.append(dd)
	abandonfn := "zg_spawnabandon_" + tag
	mut ad := "static void " + abandonfn + "(void *p) { zg_spawnenv_" + tag + " *e = (zg_spawnenv_" + tag + "*)p; (void)e;"
	ad = ad + abandons + " zrt_free(p); }\n"
	em.dfn_decls.append(ad)
	mut th := "static void zg_spawn_" + tag + "(void *p) { zg_spawnenv_" + tag + " *e = (zg_spawnenv_" + tag + "*)p;"
	th = th + " zrt_defer(" + dropfn + ", p);"
	th = th + " " + cal.cname + "(" + call + "); }\n"
	em.dfn_decls.append(th)
	mut out := f"{ind}zg_spawnenv_{tag} *zgt_se{tag} = (zg_spawnenv_{tag}*)zrt_alloc(sizeof(zg_spawnenv_{tag}));\n"
	mut j := 0
	for j < args.len() {
		mut v := c_captured(em, cal.key, j, args[j])
		if dirs[j] >= 0 {
			v = f"{c_chan_copy_fn(dirs[j])}({v})"
		}
		out = out + ind + "zgt_se" + tag + "->f" + strconv.to_string(j, 10) + " = " + v + ";\n"
		j = j + 1
	}

	# THE ABANDON GOES WITH THE ENVIRONMENT, and it is the OTHER teardown: the thunk's own
	# `zrt_defer` of `drops` covers both of the ways a coroutine that RUNS can leave, and
	# this one covers the third, which is a coroutine that never runs at all — where there
	# are no by-value parameters to give the captures back. The scheduler drops its copy of
	# the pointer the moment the trampoline starts, so exactly one of the two runs.
	return f"{out}{ind}zrt_spawn(zg_spawn_{tag}, zgt_se{tag}, {abandonfn});\n"
}

# c_close lowers `close(ch)` — the one built-in a channel has. It marks the CHANNEL
# no-longer-sendable. That is a property of the channel and not of a holder, so it moves
# no count: `ch` keeps its reference and stays readable, a receive drains what is buffered
# and then answers the Right, and closing an already-closed channel changes nothing. One
# runtime call is the whole lowering.
#
# It does NOT replace auto-close, which stays the everyday shape — a producer closes by
# FINISHING. Two things depend on that and a flag cannot do either: a crashing producer
# never reaches a `close` call, and its unwind is what carries the crash Err to the
# receiver; and four producers fanning into one channel need no coordination because the
# last one to return closes it. A channel-level close called by one of them would end the
# stream for its siblings, which is the footgun this language was designed around. `close`
# is the conditional, early form: end this stream before my scope does.
#
# Two refusals, and both are bugs the type system can catch: a non-channel has no send end
# at all, and a receive-only end must not be able to end a stream on the producers' behalf.
#
# `at_exit` is `defer close(ch)`: the same close, at the enclosing block's exit. It goes
# through the ORDINARY defer machinery, because c_close_callee makes the close look like
# any other call — which is the whole reason `close` is a statement node rather than an
# intercepted ECall. As a call it had no symbol to put in a thunk's env, so `defer`,
# `spawn` and every other position a call can reach each needed a refusal of its own.
fn c_close(mut &em: Emitter, ch: ast.Expr, at_exit: bool, ind: str) -> str {
	cal := c_close_callee(em, ch)
	return c_defer_of(em, cal, ind) if at_exit
	return f"{ind}{cal.cname}({c_expr(em, ch, c_nosub())});\n"
}

# c_close_callee is `close(ch)` as a CALLEE — the runtime function and its one argument —
# after the checks a close owes. There is no user symbol behind it: `close` is a keyword,
# so it cannot be defined, shadowed or overloaded, and the file method `f.close()` is an
# EMethod that never comes near here.
#
# BOTH checks are c_chan_op_check's now. "close requires a channel" was written out here,
# which made this the one operation of the six that knew to ask — and it asked without a
# code and without a place, so even here the answer was less than the rule deserved.
fn c_close_callee(mut &em: Emitter, ch: ast.Expr) -> Callee {
	t := c_infer(em, ch)
	c_chan_op_check(em, t, 2)
	em.used_rt = true
	em.used_conc = true
	mut args: list[ast.Expr] = []
	args.append(ch)
	return Callee("zrt_chan_close", args, "")
}

# c_del lowers `del name`: it REVOKES the name, and nothing else. The revocation is the
# whole statement — c_live_del records it and c_live_use rejects a later read, which is
# what makes `del` mean one thing for every type.
#
# It emits no C. A channel handle is not released here because the binding already owes
# its reference to the pending-release list, and the scope that ends pays it — releasing
# again would be the double-release the list exists to rule out. Giving up the SEND end
# early is `close(ch)`, a statement of its own, and it keeps its holder on purpose.
fn c_del(mut &em: Emitter, name: str, ind: str) -> str {
	# `del ch` ON A CHANNEL. GRAMMAR#del-stmt gives it a second meaning there — "a Ref[T]/chan
	# drops a refcount instead: `del ch` closes a channel if you were its last sender" — and
	# revoking the name is not that. Revoking emits no C, so the program below built, said
	# nothing, and DEADLOCKED: the consumer waited on an end the writer believed it closed.
	#
	#     ch := chan[int](4);  spawn consume(ch);  ch <- 1;  del ch
	#
	# The header above is why the drop cannot simply be added here: the release is registered
	# on the runtime's cleanup stack at the declaration and every exit unwinds to a mark, so
	# there is no taking one entry out of the middle early.
	raise c_diag(em, rule.Rule.NotYetDelChannel, f"NotImplemented: `del {name}` on a CHANNEL — GRAMMAR makes this drop a sender reference and close the stream when it was the last one, and this compiler releases a channel where its binding's scope ends. Write `close({name})` to end it now") if ast.ty_is_chan(c_lookup_var(em, name))

	# THERE HAS TO BE SOMETHING TO REVOKE. `del` emits no C, so a name it could not find was
	# revoked in nobody's environment and the statement vanished without a word: `del
	# totally_undefined` compiled and ran, while the very same spelling in a `print` one line
	# down is E3069. The read path asked and this one did not, which is the whole of it.
	c_del_target(em, name)

	c_live_del(em, name)
	return f"{ind}/* del {name} */\n"
}

# c_del_target is the rule that `del`'s operand names a BINDING. GRAMMAR#del-stmt is `'del'
# identifier` and docs/core/memory.md says what the statement does with it — revokes THAT
# NAME's access to its storage — so a name with no storage behind it is not a `del` this
# language derives, whatever else the program may call it.
#
# Two findings rather than one, because they are two mistakes. A name nothing declares is a
# typo, and the reader wants to be told the name is unknown. A name that DOES resolve —
# a function, a struct, an enum, one of its variants — is a different confusion: the reader
# meant something by it, and what they need told is that the thing they named is not a
# binding and has no storage a name is an access to.
fn c_del_target(mut &em: Emitter, name: str) {
	return if c_live_idx(em, name) >= 0

	kind := c_del_kind(em, name)
	if kind == "" {
		check.chk_at(em, rule.Rule.DelUnknownName, f"`del {name}` names nothing this program declares — `del` revokes a BINDING's access to its storage (GRAMMAR#del-stmt), so there has to be a binding of `{name}` in scope for it to revoke")
		return
	}
	check.chk_at(em, rule.Rule.DelNotABinding, f"`del {name}` names a {kind}, and a {kind} is not a binding — it has no storage for a name to be an access to, so there is nothing here to revoke")
}

# c_del_kind names what a non-binding name resolves to, or "" when nothing does. The four
# it asks about are the four namespaces a bare identifier can land in beside the
# environment, and they are asked in the order c_ident_val resolves them so the two agree
# about what a name IS.
fn c_del_kind(mut &em: Emitter, name: str) -> str {
	return "variant" if c_is_variant(em, name)
	return "struct" if c_is_struct_name(em, name)
	return "enum" if c_is_enum_name(em, name)
	return "function" if c_is_free_fn(em, name)

	return ""
}

# c_select lowers `select { … }` onto zrt_select: an array of case descriptors, one call
# that picks a ready arm (or parks on all of them), and an if-chain on what it returned.
#
# A receive arm's value has to land somewhere the runtime can write BEFORE the call — it
# takes an address — so each recv arm declares a slot up front and hands over its address.
# The arm's BINDING is assembled from that slot later, inside the branch that won, because
# a `Result[T]` needs the `closed` flag the call has not set yet.
#
# `close` and `_` are not cases. They are flags on the call and constants in the answer,
# which is exactly how the runtime models them.
fn c_select(mut &em: Emitter, arms: list[ast.SelArm], ind: str, loop: bool) -> str {
	em.used_rt = true
	em.used_conc = true

	in2 := ind + "    "
	mut n := 0
	mut has_def := "false"

	# the LOOP is the only exit an exhausted select has: `for select` ends there, and a
	# one-shot select has nowhere to go, which is what DeadlockError says
	mut has_exit := "false"
	if loop {
		has_exit = "true"
	}
	for a in arms {
		if a.op == 0 or a.op == 1 {
			n = n + 1
		} else {
			has_def = "true"
		}
	}
	tag := strconv.to_string(em.dfn_n, 10)
	em.dfn_n = em.dfn_n + 1
	cs := "zgt_cs" + tag
	mut out := ind + "{\n" + in2 + "zrt_sel_case " + cs + "[" + strconv.to_string(n, 10) + "];\n"

	# the case array, and a slot for every receive arm's value. `elems` keeps each case's
	# element type as it is worked out, indexed the way the case array is, so the dispatch
	# below can build a recv arm's carrier without inferring the arm's channel a second
	# time — that expression may be a call, and c_infer walks its whole tree.
	mut elems: list[ast.Ty] = []
	mut idx := 0
	for a in arms {
		if a.op == 0 {
			cty := c_infer(em, a.ch)
			c_chan_op_check(em, cty, 0)
			elem := ast.ty_chan_elem(cty)
			elems.append(elem)
			nm := f"zgt_rv{tag}_{idx}"
			out = out + in2 + c_type(elem) + " " + nm + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].op = ZRT_SEL_RECV;\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].ch = " + c_expr(em, a.ch, c_nosub()) + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].val = &" + nm + ";\n"
			idx = idx + 1
		} else if a.op == 1 {
			cty := c_infer(em, a.ch)
			c_chan_op_check(em, cty, 1)
			elem := ast.ty_chan_elem(cty)
			elems.append(elem)
			nm := f"zgt_sv{tag}_{idx}"

			# COPIED, like `ch <- v` — the payload is snapshotted at the send. This arm
			# rendered the value with c_expr, so a `list` handed to a select send was the
			# sender's own buffer under the receiver's name, with no reference taken, on
			# two worker threads at once.
			sv := c_fit_copied(em, "the value sent on this channel", elem, a.val, c_nosub())
			out = f"{out}{in2}{c_type(elem)} {nm} = {sv};\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].op = ZRT_SEL_SEND;\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].ch = " + c_expr(em, a.ch, c_nosub()) + ";\n"
			out = out + in2 + cs + "[" + strconv.to_string(idx, 10) + "].val = &" + nm + ";\n"
			idx = idx + 1
		}
	}
	out = out + in2 + "int zg_pick" + tag + " = zrt_select(" + cs + ", " + strconv.to_string(n, 10) + ", " + has_def + ", " + has_exit + ");\n"

	# the dispatch. Each recv arm's binding is already in scope, so its body just runs.
	#
	# Exactly one arm runs, so for the liveness they are branches of one `if`: each body is
	# analysed from the SAME entry state and their ends are joined. Without the restore a
	# `del` in the first arm would be carried into the second, and a perfectly good read
	# there would be refused.
	entry := c_live_save(em)
	mut acc := entry
	mut acc_set := false
	mut first := true
	mut k := 0
	for a in arms {
		mut cond := ""
		if a.op == 0 or a.op == 1 {
			cond = f"zg_pick{tag} == {k}"
			k = k + 1
		} else {
			cond = f"zg_pick{tag} == ZRT_SEL_DEFAULT"
		}
		mut kw := "} else if ("
		if first {
			kw = "if ("
			first = false
			out = out + in2
		}
		out = out + kw + cond + ") {\n"

		# A receive arm binds the VALUE — a plain `T`, not a carrier. An arm that fires has
		# a value by construction: a cleanly closed channel is an absence, so the runtime
		# drops that arm rather than firing it, and a crash close is a failure, so it is
		# raised rather than handed over. Neither can reach a body, so nothing here has to
		# ask whether what it was handed is real.
		#
		# That is the whole of the fix for the chapter's one silent wrong answer, which used
		# to be a `closed` flag nobody read: an arm that fired on a closed channel ran over
		# the slot from the PREVIOUS receive and printed a value nobody sent. There is no
		# flag now because there is no such arm.
		# THE ARM OWNS ITS BINDING, which is the same statement `for x in …` and `if x := …`
		# make about theirs, and it is made the same way: a scope of its own around the row.
		# Appending the row into the ENCLOSING scope instead — the one thing this site did
		# that no other binding construct does — left `v` nameable in every LATER arm and
		# after the whole `select`, where its C slot is out of scope. The later arm was the
		# worse of the two: `w := <-b => print v` compiled, silently, reading the slot the
		# other arm's receive would have filled.
		arm_scope := c_scope_open(em)

		if a.op == 0 and a.bind != "" {
			elem := elems[k - 1]

			# bound right before the body, not up front: every recv arm may call its
			# variable `v`, and one environment entry per arm would leave each body
			# reading the last one's.
			#
			# THROUGH THE FUNNEL, with the C name given rather than minted — the value is
			# already in this arm's receive temp. Writing the columns out here instead is
			# what left `env_cval` one row short of the rest (c_add_var_named).
			c_add_var_named(em, a.bind, elem, f"zgt_rv{tag}_{k - 1}", false, false)
		}
		c_live_restore(em, entry)
		out = out + c_block(em, a.body, in2 + "    ")
		c_scope_close(em, arm_scope)
		if acc_set {
			c_live_merge(em, acc)
		}
		acc = c_live_save(em)
		acc_set = true
	}
	c_live_restore(em, acc)
	if not first {
		out = out + in2 + "}\n"
	}
	if loop {
		# an exhausted `for select` leaves the loop: every watched receive channel has ended
		out = out + in2 + f"if (zg_pick{tag} == ZRT_SEL_DONE) {{ break; }}\n"
	}
	return out + ind + "}\n"
}

# c_for_select lowers `for select { … }`: the same wait, one ready arm per round, wrapped in
# the loop whose end it owns. `break` and `continue` inside an arm are this loop's, which is
# what makes the C `for (;;)` the honest lowering rather than a flag.
fn c_for_select(mut &em: Emitter, arms: list[ast.SelArm], ind: str) -> str {
	# the same things c_loop_block does for an ordinary loop body, and for the same reasons:
	# a `break` or a `continue` in an arm must release what the BODY owns and no more —
	# without the mark it released the enclosing function's channels on its way round the
	# loop, which closed a channel the loop was still reading and deadlocked — and a loop may
	# run zero times, so the body's end state joins the entry state rather than replacing it.
	#
	# It said "the same two things" and did one of them. The mark half was never here: this
	# is the only loop body in the language that is not a `stmt-list`, so it does not go
	# through c_block, and the state a jump reads was left at whatever the ENCLOSING loop had
	# — nothing, in the ordinary case of a `for select` at the top of a function. A `break`
	# out of an arm holding a `defer` was therefore lowered to the bare keyword, and the
	# deferred call outlived the loop exactly as it did in every other loop.
	entry := c_live_save(em)

	mark := c_new_mark(em)
	saved := c_loop_enter(em, mark)

	body := c_select(em, arms, ind + "    ", true)

	# the mark is DECLARED only where a jump named it, which is the rule c_block follows for
	# a forced mark. Nothing else can reference it: an arm's own block unwinds what the arm
	# scheduled on its normal way out, and the loop's exhausted-`break` runs with the stack
	# already back where the iteration found it.
	needs := em.loop_mark_used

	c_loop_leave(em, saved)
	c_live_merge(em, entry)

	return ind + "for (;;) {\n" + body + ind + "}\n" if not needs

	em.used_rt = true
	in2 := ind + "    "
	head := ind + "for (;;) {\n" + in2 + f"size_t {mark} = zrt_scope_mark();\n"
	return head + body + in2 + f"zrt_unwind_to({mark});\n" + ind + "}\n"
}

# --- lambdas ----------------------------------------------------------------------
#
# A `fn(x: T) -> R { … }` in expression position is LIFTED to a top-level C function and
# the expression becomes a pointer to it. That works because this compiler already carries
# a held function as one type — `zg_fnptr`, cast back to its real signature at the call —
# so a lambda with nothing captured is indistinguishable from a named function used as a
# value, which already worked.
#
# CAPTURE is the line. A body naming anything that is not one of its parameters, a global,
# or another function would need an environment to carry it, and an environment is a
# different value shape than a bare pointer. That is refused by name rather than half-done.
fn c_lambda(mut &em: Emitter, ps: list[ast.Param], has_ret: bool, ret: ast.Ty, body: list[ast.Stmt]) -> str {
	# WHAT IT CAPTURES, and their types read from the enclosing function's environment —
	# which is still the current one, since a lambda is emitted in the middle of one of its
	# expressions. The captures become ordinary LEADING PARAMETERS of the lifted function, so
	# every rule about a by-value parameter already applies to them: the copy in, the drop
	# out, the shadowing. Nothing in the body has to know it is reading a capture.
	# A PARAMETER NOTHING COULD TYPE. Every typed position fills these in (c_fn_typed), so
	# reaching here with one still unknown means the closure met no position that could —
	# `f := fn (x) { … }`, or an argument slot with fewer parameters than the closure wrote.
	# That is the second half of carve-out (c) and the specification states it as an error,
	# so it is one here rather than a `TUnknown` carried into a C declaration.
	for pm in ps {
		if c_is_unknown(pm.ty) {
			check.chk_at(em, rule.Rule.ClosureParamNoType, f"the closure parameter `{pm.name}` has no type, and this position gives it none — a closure takes its parameter types from the function type it is checked against, so write `{pm.name}: T` or put the closure where one is declared")
		}
	}

	caps := c_lambda_free_all(em, ps, body)
	mut cps: list[ast.Param] = []
	for cn in caps {
		ct := c_lookup_var(em, cn)

		# A capture whose type is unknown cannot be given a field. It carries no CODE because
		# no program reaches it: a binding with no type of its own is refused at the binding
		# (E3034), long before a lambda can close over it. This is the guard that says so if
		# that ever stops being true, and a code exists when a gate pins it and not before.
		raise c_diag(em, rule.Rule.ClosureCaptureUnknown, f"a closure captures `{cn}`, and this compiler cannot work out what it holds") if c_is_unknown(ct)

		cps.append(ast.Param(cn, ct, false, false, ast.Expr.ENil))
	}

	# THE VALUES ARE READ HERE, while the ENCLOSING environment is still the current one. A
	# few lines down it is swapped for the lambda's own, and by then these names mean nothing
	# — which is the whole reason a capture is a copy taken at the point the lambda is
	# written rather than a reference to a binding that may already be gone.
	mut cvals: list[str] = []
	for cp in cps {
		cvals.append(c_copied(em, cp.ty, ast.Expr.EIdent(cp.name), c_nosub()))
	}

	mut allps := cps
	for pm in ps {
		allps.append(pm)
	}

	for pm in ps {
		if pm.is_ref {
			c_no_ref_param(em, f"the parameter `{pm.name}` of a closure")
		}
	}

	tag := strconv.to_string(em.lam_n, 10)
	em.lam_n = em.lam_n + 1
	name := "lambda__" + tag

	# the lambda's body is emitted with its OWN environment; the one belonging to the
	# function being emitted is put back afterwards, since the lambda is in the middle of
	# one of its expressions
	saved_env := c_env_save(em)
	saved_open := em.open_scopes
	saved_cur := em.scope_cur
	saved_rel_cnames := em.rel_cnames
	saved_rel_fns := em.rel_fns
	saved_refs := em.ref_names

	# and the freeze stack: c_reset_env clears it for the lambda's own body — a capture is
	# a copy, so no enclosing loop's collection is reachable from inside — and the loop the
	# lambda was written in gets its freeze back on the way out. The rows it holds belong to
	# the enclosing function's environment, which is saved and restored with it.
	saved_frz := em.frz_idxs
	saved_frz_paths := em.frz_paths

	# and the active substitution with them. It belongs to the block expression that opened
	# it, and inside a function lifted OUT of that block its names mean nothing — the values
	# they stood for reach the lambda through the capture list, which is rendered above with
	# the substitution still in force.
	saved_sub := em.sub
	em.sub = c_nosub()
	em.lam_defs.append(c_fn(em, ast.FnDecl(name, "", allps, has_ret, ret, body, false, em.at_path, em.at_line, em.at_col, [], [], em.in_unsafe_fn, false, false)))
	em.sub = saved_sub
	c_env_restore(em, saved_env)
	em.open_scopes = saved_open
	em.scope_cur = saved_cur
	em.rel_cnames = saved_rel_cnames
	em.rel_fns = saved_rel_fns
	em.ref_names = saved_refs
	em.frz_idxs = saved_frz
	em.frz_paths = saved_frz_paths
	em.used_fnptr = true

	# NOTHING CAPTURED is the case that already worked: the lifted function is an ordinary
	# one, and it reaches the fn-value shape the same way a named function does — through a
	# thunk that takes the environment and ignores it.
	return f"((zg_fnptr){{(void (*)(void))zg_{c_fnval_thunk(em, name, c_lambda_ty(ps, has_ret, ret))}, NULL}})" if caps.len() == 0

	return c_closure(em, name, cps, ps, has_ret, ret, cvals)
}

# c_closure builds the environment a capturing lambda carries, and the thunk that unpacks it.
#
# The shape is `spawn`'s, one construct over: a per-site struct of the captured values, a
# static function that reads them back out, and a heap block holding one. What differs is
# WHEN it runs — a coroutine's env is consumed once, a closure's every time it is called —
# and both consequences of that difference are written down here.
#
# THE ENVIRONMENT IS REFCOUNTED, not scope-owned. Every other value this emitter allocates
# is released at the scope that made it, and a closure's cannot be: the closure may outlive
# that scope, which is what closing over a value is for. So it is a zrt_ref_alloc cell whose
# own drop tears the captures down, the fn value counts as a holder, and the last one to go
# frees it. `env` keeps the PAYLOAD pointer so the call thunk and the signature cast are
# untouched by any of this.
#
# AND THE THUNK HANDS THE LIFTED FUNCTION COPIES. This is the half a spawn does not need.
# The lifted function's captured parameters are BY VALUE, so it releases each of them when
# it returns (c_fn) — and a spawn is fine with that, because its env is giving up its own
# reference and never runs again. A closure runs again: passing `e->f0` uncopied made the
# SECOND call read a string the first had freed. That is a use-after-free this compiler has
# had for as long as it has had closures, and no gate could see it because the corpus only
# ever called one once.
fn c_closure(mut &em: Emitter, name: str, cps: list[ast.Param], ps: list[ast.Param], has_ret: bool, ret: ast.Ty, vals: list[str]) -> str {
	tag := strconv.to_string(em.lam_n, 10)
	em.lam_n = em.lam_n + 1

	envty := f"zg_lamenv_{tag}"

	mut fields := ""
	mut unpack := ""
	mut teardown := ""
	mut i := 0
	for i < cps.len() {
		fi := f"f{strconv.to_string(i, 10)}"
		fields = fields + f" {c_type(cps[i].ty)} {fi};"
		if i > 0 {
			unpack = unpack + ", "
		}

		# a COPY per call, for the reason in the header: the callee gives every by-value
		# parameter back, and this environment is read again the next time it is called
		mut arg := f"e->{fi}"
		if c_needs_copy(em, cps[i].ty) {
			arg = c_copy_of(em, cps[i].ty, arg)
		}
		unpack = unpack + arg

		# and the teardown, in reverse declaration order, the order every aggregate drops in
		teardown = c_drop_stmt(em, cps[i].ty, f"e->{fi}") + " " + teardown
		i = i + 1
	}
	em.lam_defs.append(f"typedef struct {{{fields} }} {envty};\n")

	# the cell's own drop, which zrt_release runs at zero. It does NOT free the block —
	# zrt_release does that, and a zrt_free here would be the second one.
	dropfn := f"lamdrop_{tag}"
	em.lam_defs.append(f"static void zg_{dropfn}(void *zg_envp) {{ {envty} *e = ({envty} *)zg_envp; (void)e; {teardown}}}\n")

	mut sig := ""
	mut call := unpack
	mut j := 0
	for j < ps.len() {
		aj := f"a{strconv.to_string(j, 10)}"
		sig = sig + f", {c_type(ps[j].ty)} {aj}"
		call = call + ", " + aj
		j = j + 1
	}

	mut retkw := "return "
	if not has_ret {
		retkw = ""
	}
	thunk := f"lamcall_{tag}"
	em.lam_defs.append(f"static {c_ret_of(has_ret, ret)} zg_{thunk}(const void *zg_envp{sig}) {{ const {envty} *e = (const {envty} *)zg_envp; {retkw}zg_{name}({call}); }}\n")

	mut fill := ""
	mut k := 0
	for k < vals.len() {
		fill = fill + f" zgt_ce{tag}->f{strconv.to_string(k, 10)} = {vals[k]};"
		k = k + 1
	}
	em.used_rt = true
	return f"({{ {envty} *zgt_ce{tag} = ({envty}*)zrt_ref_payload(zrt_ref_alloc(sizeof({envty}), &zg_{dropfn}));{fill} (zg_fnptr){{(void (*)(void))zg_{thunk}, zgt_ce{tag}}}; }})"
}

fn c_ret_of(has_ret: bool, ret: ast.Ty) -> str {
	return "void" if not has_ret

	return c_type(ret)
}

# c_fn_typed fills a closure from the function type it is being checked against — the
# parameter types it omitted, and its return type if it omitted that too (GRAMMAR#fn-expr
# makes `ret-type?` optional for exactly this reason). Anything else passes through
# untouched, so every caller can hand it whatever it has.
#
# A written type WINS: `fn (x: str)` at a `fn (int) -> …` position keeps its `str` and is
# refused by the check that follows, naming the two types. Adopting the position's type
# instead would make the annotation a comment.
#
# Arity is not repaired. A closure with more parameters than the position has types leaves
# the extra ones TUnknown, and c_lambda refuses them by name — the position could not have
# supplied a type for a parameter it does not have.
pub fn c_is_fnlit(e: ast.Expr) -> bool {
	return match e {
		Expr.EFn(_, _, _, _) => true
		_ => false
	}
}

pub fn c_fn_typed(want: ast.Ty, e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EFn(ps, has_ret, ret, body) => c_fn_typed_at(want, ps, has_ret, ret, body)
		_ => e
	}
}

fn c_fn_typed_at(want: ast.Ty, ps: list[ast.Param], has_ret: bool, ret: ast.Ty, body: list[ast.Stmt]) -> ast.Expr {
	return ast.Expr.EFn(ps, has_ret, ret, body) if not c_is_fn(want)

	wps := c_fn_params(want)
	mut out: list[ast.Param] = []
	mut i := 0
	for i < ps.len() {
		pm := ps[i]
		if c_is_unknown(pm.ty) and i < wps.len() {
			out.append(ast.Param(pm.name, wps[i], pm.is_ref, pm.has_def, pm.def))
		} else {
			out.append(pm)
		}
		i = i + 1
	}

	# The RETURN comes with the parameters, from the same type — GRAMMAR#fn-expr makes
	# `ret-type?` optional so that `fn (x) { … }` is a whole closure and not half of one.
	wret := c_fn_ret(want)
	return ast.Expr.EFn(out, true, wret, body) if not has_ret and not c_is_nil_ty(wret)

	return ast.Expr.EFn(out, has_ret, ret, body)
}

fn c_lambda_ty(ps: list[ast.Param], has_ret: bool, ret: ast.Ty) -> ast.Ty {
	mut tys: list[ast.Ty] = []
	for pm in ps {
		tys.append(pm.ty)
	}
	mut r := ast.Ty.TVoid
	if has_ret {
		r = ret
	}
	return ast.Ty.TFn(tys, r)
}

# c_lambda_free_all is every name a lambda's body uses and does not bind — its CAPTURES.
# A parameter, a name bound inside, a module constant and a function are all answered
# elsewhere, so what is left is the enclosing function's bindings.
fn c_lambda_free_all(mut &em: Emitter, ps: list[ast.Param], body: list[ast.Stmt]) -> list[str] {
	mut ids: list[str] = []
	mut calls: list[str] = []
	mut ns: list[str] = []
	lint.walk_body(body, ids, calls, ns)
	mut bound: list[str] = []
	for pm in ps {
		bound.append(pm.name)
	}
	lint.collect_binds(body, bound)
	mut out: list[str] = []
	for id in ids {
		if not c_name_in(bound, id) and c_k_idx(em, id) < 0 and not c_name_in(em.sig_names, id) and not c_name_in(out, id) {
			out.append(id)
		}
	}
	return out
}

pub fn c_name_in(names: list[str], name: str) -> bool {
	for n in names {
		return true if n == name
	}
	return false
}

# A `mut &` PARAMETER CANNOT SURVIVE THE TRIP THROUGH A FUNCTION VALUE. A held function is
# one type here, `zg_fnptr`, cast back at the call from what the CALL SITE believes the
# signature is — and what it believes comes from the parameter table, keyed by the callee's
# NAME. A value has no name in that table, so `c_arg` found no row, skipped the borrow rules
# and passed the argument by value into a C parameter declared `T*`. Both spellings
# segfaulted: `f := fn(mut &a: int) { … }  f(x)` and `g := bump  g(x)`.
#
# It is not a lowering this compiler could quietly get right, either: `TFn` carries parameter
# TYPES and no `mut &` flag, which is the same reason GRAMMAR's `param-type ::= ( 'mut' '&' )?
# type` has no spelling here. So the function value is refused where it is MADE — at the
# lambda, and at the name — rather than at a call that no longer knows what it is calling.
fn c_no_ref_param(mut &em: Emitter, what: str) {
	raise c_diag(em, rule.Rule.NotYetFnValueMutRef, f"NotImplemented: {what} is a `mut &`, and a function VALUE cannot carry one — a held function is a bare pointer here and the call site reads its signature from the callee's name, which a value has not got. Call it by name, or pass the value it should answer with")
}

# c_no_ref_param_value asks the same of a NAMED function about to become one. A lambda has
# its parameters in hand; a name has only the table, so this is the same question as a scan
# of it — and it names the parameter's POSITION, which is what the table keeps.
fn c_no_ref_param_value(mut &em: Emitter, n: str) {
	mut i := 0
	for i < em.pr_fn.len() {
		if em.pr_fn[i] == n and em.pr_ref[i] {
			c_no_ref_param(em, f"parameter {strconv.to_string(em.pr_idx[i] + 1, 10)} of `{n}`")
		}
		i = i + 1
	}
}

# --- defer ----------------------------------------------------------------------
#
# GRAMMAR runs a defer at the enclosing BLOCK's exit, on every path out, last-scheduled-
# first — which is the runtime's cleanup stack exactly. A block holding one takes a mark
# on entry and unwinds to it on the way out; `return` unwinds the whole function's stack
# and `break`/`continue` the loop's.
#
# What may be deferred is a direct CALL, which is the same limit the seed sets. The call's
# arguments are captured BY VALUE into a per-site env struct at the point the defer runs,
# so a later reassignment of an argument does not change what the deferred call sees.
fn c_defer(mut &em: Emitter, x: ast.Expr, ind: str) -> str {
	return c_defer_of(em, c_callee_of(em, x, "defer"), ind)
}

# c_defer_of schedules an already-resolved CALLEE at the enclosing block's exit. `defer f(a)`
# reaches it through c_defer and `defer close(ch)` through c_close, and neither knows about
# the other: a deferred thing is a function and its arguments, whatever wrote it down.
fn c_defer_of(mut &em: Emitter, cal: Callee, ind: str) -> str {
	em.used_rt = true

	# A RECORD ON THE CLEANUP STACK, and every exit that unwinds has to be told. There are
	# two of them and they keep separate books: a `return` asks fn_mark_used, and a `break`
	# or a `continue` asks loop_defer. Only the first was set here, so a jump out of a loop
	# whose body held a defer emitted the bare keyword — the record stayed pending past the
	# loop and ran at the FUNCTION's exit, reading an env struct whose storage the block had
	# already given back. Both are set together because a defer is one fact, and answering
	# it for one exit and not the other is how the second one went missing.
	em.fn_mark_used = true
	em.loop_defer = true

	args := cal.args
	idx := em.dfn_n
	em.dfn_n = idx + 1
	tag := strconv.to_string(idx, 10)
	if args.len() == 0 {
		# a C brace in an f-string has to be doubled, and a line that is mostly braces reads
		# better as concatenation
		em.dfn_decls.append("static void zg_dfn_" + tag + "(void *p) { (void)p; " + cal.cname + "(); }\n")
		return f"{ind}zrt_defer(zg_dfn_{tag}, NULL);\n"
	}

	mut fields := ""
	mut vals := ""
	mut call := ""
	mut i := 0
	for i < args.len() {
		ft := c_type(c_captured_ty(em, cal.key, i, args[i]))
		fields = fields + " " + ft + " f" + strconv.to_string(i, 10) + ";"
		if i > 0 {
			vals = vals + ", "
			call = call + ", "
		}
		vals = vals + c_captured(em, cal.key, i, args[i])
		call = call + "e->f" + strconv.to_string(i, 10)
		i = i + 1
	}
	em.dfn_decls.append("typedef struct {" + fields + " } zg_denv_" + tag + ";\n")
	em.dfn_decls.append("static void zg_dfn_" + tag + "(void *p) { zg_denv_" + tag + " *e = (zg_denv_" + tag + "*)p; " + cal.cname + "(" + call + "); }\n")
	mut out := ind + "zg_denv_" + tag + " zgt_de" + tag + " = { " + vals + " };\n"
	return f"{out}{ind}zrt_defer(zg_dfn_{tag}, &zgt_de{tag});\n"
}

# Callee is the three things a `spawn` and a `defer` each need about what they are about
# to call: the C symbol, the arguments in the order that symbol takes them, and the key
# its row in the parameter table is under.
#
# Both statements build the same per-site env struct and the same thunk that unpacks it,
# so the question "what is being called" is asked in one place. Before this they each had
# their own copy of it, and each copy knew only about a direct call.
struct Callee {
	pub cname: str
	pub args: list[ast.Expr]
	pub key: str
}

# c_callee_of answers that question, or refuses by name. `what` is the statement asking,
# so the diagnostic says `spawn` or `defer` rather than describing both.
#
# The three shapes the spec gives are a plain function `f(a)`, a method `obj.run()`, and a
# namespaced function `mod.work()`. A closure literal is NOT among them and cannot be: a
# lambda here may capture nothing (c_lambda refuses it), so there would be no environment
# to hand a coroutine even if the shape were accepted.
fn c_callee_of(mut &em: Emitter, x: ast.Expr, what: str) -> Callee {
	raw := c_callee_raw(em, x, what)

	# The DEFAULTS a call left off are filled in HERE, before anything else sees the
	# argument list. An ordinary call backfills them in c_args_from; `spawn` and `defer`
	# render their arguments with a loop of their own, so neither did — `spawn work(5)` on
	# `fn work(a: int, b: int = 10)` reached cc as "too few arguments to function call"
	# against a thunk this compiler wrote, while the same call unspawned compiled and
	# printed 15.
	#
	# Filling them in at the callee, rather than in each of the two statements, is what
	# makes the divergence impossible rather than merely fixed: the env struct, the borrow
	# refusal and the argument check all read one list, and it is the whole list.
	#
	# The default's expression is captured at the `spawn` / `defer` statement like every
	# other argument, which is the semantics both forms already have — arguments are a
	# snapshot taken where the statement is written, not where the call runs.
	# checked BEFORE the backfill, against the arguments the programmer actually wrote. A
	# default is judged at the declaration, so re-judging it here said the same thing twice
	# — and the second copy named "argument 2" of a call whose source has one argument.
	check.chk_callsite(em, raw.key, raw.args, what)

	mut cal := raw
	cal.args = c_with_defaults(em, cal.key, cal.args)

	# `spawn` and `defer` resolve a callee and render its arguments with a loop of their
	# own, so neither has ever passed through c_args_from — the one place every other call
	# is measured against its signature. `spawn work(1)` on a two-parameter function
	# reached cc, which reported "too few arguments" about a thunk this compiler wrote.
	# They are also the two forms whose bad arguments are hardest to read back from
	# generated C, since the call the programmer wrote is not the call cc sees.
	return cal
}

# c_with_defaults answers `args` with the default expressions of every parameter the call
# left off the end appended. A key nothing registered has no parameters to ask about, so
# an intrinsic or a constructor comes back unchanged.
fn c_with_defaults(mut &em: Emitter, key: str, args: list[ast.Expr]) -> list[ast.Expr] {
	# a `list` parameter is by value in this compiler, so `out` is already this call's own
	mut out := args
	for d in c_defaults_from(em, key, out.len()) {
		out.append(d)
	}
	return out
}

# c_callee_gen is a Callee naming one SPECIALIZATION. The mangled key is both the C symbol
# (through c_fn_cname) and the signature key the argument rules read, which is what makes a
# deferred generic call checked exactly as a direct one is.
fn c_callee_gen(mut &em: Emitter, key: str, x: ast.Expr) -> Callee {
	return Callee(c_fn_cname_in(em, check.c_mod_of(em, em.at_path), "", key), c_callee_args_of(x), key)
}

# c_callee_args_of is the argument list of either call form, since c_callee_raw reaches this
# from both and they spell it differently.
fn c_callee_args_of(x: ast.Expr) -> list[ast.Expr] {
	return c_call_args_of(x) if c_call_name(x) != ""

	return c_meth_args_of(x)
}

# c_callee_free is a Callee for a FREE FUNCTION reached by a `spawn` or a `defer`, and it
# exists so both shapes that get there — the plain `f(…)` and the namespaced `mod.f(…)` —
# ask the rules an ordinary call asks about its callee (c_call).
#
# None of them did. `spawn` and `defer` resolve a callee down a path of their own, so a
# `defer mod.hidden()` reached a module-private function that the identical call written
# plainly is refused for (E3001), and `spawn poke()` reached an `unsafe { … }` group's
# function straight out of safe code (E3083). A rule enforced at one of a form's two
# resolvers is a rule one keyword away from meaning nothing — which is the same argument
# c_ns_kind was extracted for, one question further along.
#
# WHETHER THE NAME IS A FUNCTION AT ALL is asked one step earlier, by c_chk_callable, and
# only of the BARE spelling — see there.
fn c_callee_free(mut &em: Emitter, name: str, args: list[ast.Expr], what: str) -> Callee {
	sr := c_sig_row_of(em, name)
	c_chk_visible_fn(em, name, sr)
	c_chk_unsafe_fn(em, name, f"this `{what}` is in safe code", sr)

	return Callee(c_fn_cname_in(em, check.c_mod_of(em, em.at_path), "", name), args, name)
}

# c_chk_callable is "is this name a function", and it was the question a `spawn` and a
# `defer` never asked. Visibility and `unsafe` are both read off a signature ROW, and a row
# of -1 is deliberately quiet — so a name with no row asked two rules that had nothing to
# say and went straight on to spell `zg_<name>()` inside the thunk. `spawn nosuchfn()`,
# `defer nosuchfn()` and a `defer x()` on an int binding all reached cc, which reported an
# implicitly-declared function against a file under .zerg-cache. The ordinary call has
# answered all three by name for as long as those codes have existed.
#
# It is asked in the order c_call asks it: a BINDING first, because the innermost one wins
# and shadows the function of that name, and only then the function table.
#
# ONLY OF THE BARE SPELLING. `spawn mod.work()` names a module, and a module qualifier is
# not shadowed by anything a body binds — asking the binding question there would report
# `E3066` for a local `work := 3` that has nothing to do with the callee. The namespaced path
# asks its own half of this (`c_name_in(em.sig_names, m)`, then chk_no_member) before it
# reaches the free function, which is the same question with the qualifier already resolved.
#
# A BINDING HOLDING A FUNCTION IS THE ONE CASE THE ORDINARY CALL CAN DO AND THIS CANNOT.
# `f()` on a `f := fn () { … }` calls through the stored pointer; a `spawn` and a `defer`
# both lower to a C THUNK — `static void zg_spawn_1(void *p) { … }` — whose body names a C
# symbol, and a value has none. The environment a closure carries has nowhere to go either:
# the thunk's one `void *` is already the argument snapshot. So it is refused where it is
# ASKED FOR rather than emitted as a call to a symbol nobody declared, which is what
# `spawn work()` on a named closure did.
fn c_chk_callable(mut &em: Emitter, name: str, what: str) {
	bt := c_lookup_var(em, name)

	raise c_diag(em, rule.Rule.NotYetSpawnOfBinding, f"NotImplemented: a `{what}` of `{name}`, a binding that HOLDS a function — a `{what}` lowers to a C thunk that names a symbol, and a function value has none. Name the function itself, or call it inside a `{what}`ed one") if c_is_fn(bt)

	if not c_is_unknown(bt) {
		c_not_callable(em, name, bt)
		return
	}

	return if c_is_free_fn(em, name)

	c_undefined_fn(em, name)
}

fn c_callee_raw(mut &em: Emitter, x: ast.Expr, what: str) -> Callee {
	n := c_call_name(x)

	# A GENERIC CALLEE is instantiated here too. The thunk names a C symbol directly rather
	# than going through c_call, so a template's name reached cc as an undeclared function —
	# it has no symbol, having been taken out of the program. `chk_callsite` was looking up
	# the same absent key, so the arity and argument rules were skipped as well.
	return c_callee_gen(em, c_instantiate(em, n, c_call_args_of(x)), x) if n != "" and c_is_generic(em, n)
	if n != "" {
		c_chk_callable(em, n, what)

		return c_callee_free(em, n, c_call_args_of(x), what)
	}
	raise c_diag(em, rule.Rule.NotYetSpawnOfNonFunction, f"NotImplemented: {what} of anything but a function, a method, or a namespaced function") if not c_is_method_expr(x)

	tgt := c_meth_target_of(x)
	m := c_meth_name_of(x)
	margs := c_meth_args_of(x)
	recv := c_named_of(c_infer(em, tgt))

	if not c_has_method(em, recv, m) {
		# THE SAME QUESTION THE ORDINARY CALL ASKS (c_free_method), through the same
		# decision: `spawn mod.work(x)` is a namespaced callee exactly when `mod` is a
		# namespace binding. Reaching the free function without asking is what let a
		# `defer bogus.close()` spawn a call the program never named.
		ns := c_ns_kind(em, tgt)
		if ns == NsKind.NsUnknown {
			c_undefined_name(em, c_ns_root(tgt))
			return Callee("0", [], "")
		}
		if ns == NsKind.NsModule {
			# the same import question the ordinary call asks, at the same point in the path
			check.chk_ns_bound(em, c_ns_root(tgt))

			# a NAMESPACED generic, `spawn mod.work(x)` — the same flattening, so the same
			# instantiation the direct form gets
			return c_callee_gen(em, c_instantiate(em, m, margs), x) if c_is_generic(em, m)

			# `mod.work()` — a module namespace flattens into the one program-wide function
			# space, so a namespaced callee IS the free function of that name, exactly as an
			# ordinary `mod.work()` call is lowered
			if not c_name_in(em.sig_names, m) or not c_ns_owns_fn(em, c_ns_root(tgt), m) {
				check.chk_no_member(em, c_ns_root(tgt), m)
				return Callee("0", [], "")
			}
			return c_callee_free(em, m, margs, what)
		}

		raise c_diag(em, rule.Rule.NotYetSpawnOfUnknownName, f"NotImplemented: {what} of `{m}` — not a function, a method, or a namespaced function")
	}

	# a method's receiver is parameter 0 — the parser put `this` there when it flattened the
	# impl block — so it leads the argument list and the parameter table lines up with no
	# shift. It is captured BY VALUE, like every other argument.
	mut all: list[ast.Expr] = []
	all.append(tgt)
	for a in margs {
		all.append(a)
	}
	return Callee(c_fn_cname(recv, m), all, c_sig_key(recv, m))
}

fn c_is_method_expr(e: ast.Expr) -> bool {
	return match e {
		Expr.EMethod(_, _, _) => true
		_ => false
	}
}

fn c_meth_target_of(e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EMethod(t, _, _) => t
		_ => ast.Expr.ENil
	}
}

fn c_meth_name_of(e: ast.Expr) -> str {
	return match e {
		Expr.EMethod(_, m, _) => m
		_ => ""
	}
}

fn c_meth_args_of(e: ast.Expr) -> list[ast.Expr] {
	mut none: list[ast.Expr] = []
	return match e {
		Expr.EMethod(_, _, a) => a
		_ => none
	}
}

fn c_call_name(e: ast.Expr) -> str {
	return match e {
		Expr.ECall(n, _, _) => n
		_ => ""
	}
}

# c_call_args_of is the argument list of a call, whichever shape wrote it. `Either.Left(v)`
# is an EMethod and `Left(v)` an ECall, and the one caller that reads this — the Either
# injection — takes the same single argument out of both.
fn c_call_args_of(e: ast.Expr) -> list[ast.Expr] {
	mut none: list[ast.Expr] = []
	return match e {
		Expr.ECall(_, a, _) => a
		Expr.EMethod(_, _, a) => a
		_ => none
	}
}

fn c_has_defer(body: list[ast.Stmt]) -> bool {
	for st in body {
		return true if c_is_defer(st)
	}
	return false
}

# c_is_defer is asked of a statement, not of a keyword: `defer close(ch)` schedules work at
# the block's exit exactly as `defer f()` does, so a block holding one needs the same mark.
# Answering only for SDefer left the close on the cleanup stack with no unwind to run it.
fn c_is_defer(s: ast.Stmt) -> bool {
	return match s {
		Stmt.SDefer(_) => true
		Stmt.SClose(ch, at_exit) => at_exit
		_ => false
	}
}

# c_return_if is the postfix guard's return. It goes through c_return so the defers run on
# this path too — a guard is an exit like any other, and it is the path a `defer` most
# often exists for.
fn c_return_if(mut &em: Emitter, val: ast.Expr, cond: ast.Expr, ind: str) -> str {
	body := c_return(em, true, val, ind + "    ")
	return ind + "if " + c_cond(em, cond, "a conditional `return`") + " {\n" + body + ind + "}\n"
}

# c_jump is `break` / `continue` with the loop's defers run first and everything the loop
# BODY bound released after them — the same two halves, in the same order, as the `return`
# above. Emitting the keyword alone is what made `for { ch := chan[int](1); … break }`
# leave a sender behind: the channel never reached zero, never closed, and the deadlock
# that followed surfaced on main, nowhere near the `break`.
#
# The unwind goes to the LOOP BODY's mark rather than to zero: a binding made outside the
# loop is still in scope after the jump, and its own block gives it back.
fn c_jump(mut &em: Emitter, kw: str, ind: str) -> str {
	return f"{ind}{kw};\n" if em.loop_mark == "" or not c_needs_loop_unwind(em)

	# saying so is what lets the block declare the mark: a loop body is handed a name before
	# it is walked, and this is the only thing that can ever name it
	em.loop_mark_used = true
	return f"{ind}zrt_unwind_to({em.loop_mark});\n" + f"{ind}{kw};\n"
}

# c_needs_loop_unwind is c_needs_fn_unwind's question asked about the LOOP body: has this
# body put anything on the cleanup stack that a jump would otherwise leave pending? The two
# ways to do so are the two the function-level twin already lists — a binding registers a
# release, and a `defer` puts a record on the same stack without passing through the
# release list — and this asked only the first. So `for { defer f(); if c { break } }` was
# lowered to a bare `break`, the defer outlived the loop, and it ran on the function's way
# out with its captured arguments already dead.
#
# The depth is compared against the BODY's entry depth rather than against zero, because a
# jump gives back what the body owns and no more: a channel bound outside the loop is still
# in scope after the jump, and releasing it here would close a stream the loop's own reader
# is still on.
fn c_needs_loop_unwind(mut &em: Emitter) -> bool {
	return em.rel_cnames.len() > em.loop_keep or em.loop_defer
}

# --- maps -----------------------------------------------------------------------
#
# A map is the runtime's `zrt_map` by value, plus one static vtable per distinct shape
# saying how to hash and compare its key. The runtime provides the hash/eq leaves for the
# two key types the language builds in.
fn c_map_vt(mut &em: Emitter, kt: ast.Ty, vt: ast.Ty) -> str {
	name := f"zg_mapvt_{c_ident_safe(c_type(kt))}_{c_ident_safe(c_type(vt))}"
	for n in em.mvt_names {
		return name if n == name
	}

	# A KEY NEEDS `Hash`, and this compiler has two: int and str (GRAMMAR — a map key needs
	# both equality and a hash, and neither is automatic). A `byte` key took the INT hash
	# and eq, which read 8 bytes out of a 1-byte slot — so `{b'a': 1}` built, and the lookup
	# that followed raised `KeyError` for a key that was right there. The seed has refused
	# this all along; `zerg` reached it by inference the day a byte literal carried its type.
	# a key whose type inference could not name is left alone, as every other rule here
	# does: guessing turns a typing gap into a refusal of a working program
	raise c_diag(em, rule.Rule.NotYetMapKeyType, f"NotImplemented: a map key of type {ast.ty_name(kt)} — a key needs `Hash`, and this compiler has one for `int` and for `str`") if not c_is_int(kt) and not c_is_str(kt) and not c_is_unknown(kt)

	mut hash := "zrt_hash_int"
	mut eq := "zrt_eq_int"
	if c_is_str(kt) {
		hash = "zrt_hash_str"
		eq = "zrt_eq_str"
	}
	em.mvt_names.append(name)

	# NULL copy is the runtime's memcpy fast path, which is what a POD key or value wants.
	# A key or value that OWNS storage gets the same thunk a list element of that type
	# gets: without one, `zrt_map_copy` bit-copied a `list` value and both maps' entries
	# named one buffer. The DROPS are still NULL, which is the one container teardown that
	# has not been built: a map's own drop frees its tables, and its keys and values go
	# with it only once these are filled in.
	kc := c_elem_copy_fn(em, kt)
	vc := c_elem_copy_fn(em, vt)
	em.mvt_decls.append(f"static const zrt_map_vt {name} = {{ {hash}, {eq}, {kc}, NULL, {vc}, NULL }};\n")
	return name
}

fn c_map_lit_ty(mut &em: Emitter, ks: list[ast.Expr], vs: list[ast.Expr]) -> ast.Ty {
	return ast.Ty.TMap(ast.Ty.TUnknown, ast.Ty.TUnknown) if ks.len() == 0
	return ast.Ty.TMap(c_infer(em, ks[0]), c_infer(em, vs[0]))
}

pub fn c_is_maplit(e: ast.Expr) -> bool {
	return match e {
		Expr.EMapLit(_, _) => true
		_ => false
	}
}

# c_map_lit_as builds a map literal AT a declared type, so an empty one is still the map
# the declaration says it is.
fn c_map_lit_as(mut &em: Emitter, want: ast.Ty, lit: ast.Expr, sb: Subst) -> str {
	return match lit {
		Expr.EMapLit(ks, vs) => c_map_lit_at(em, c_map_key_ty(want), c_map_val_ty(want), ks, vs, sb)
		_ => ""
	}
}

fn c_map_lit(mut &em: Emitter, ks: list[ast.Expr], vs: list[ast.Expr], sb: Subst) -> str {
	kt := c_map_key_ty(c_map_lit_ty(em, ks, vs))
	vt := c_map_val_ty(c_map_lit_ty(em, ks, vs))
	return c_map_lit_at(em, kt, vt, ks, vs, sb)
}

# c_map_lit builds the map in a statement expression: init, then one set per entry, in
# the order they were written.
fn c_map_lit_at(mut &em: Emitter, kt: ast.Ty, vt: ast.Ty, ks: list[ast.Expr], vs: list[ast.Expr], sb: Subst) -> str {
	em.used_rt = true

	vtn := c_map_vt(em, kt, vt)
	kc := c_type(kt)
	vc := c_type(vt)
	mut out := f"({{ zrt_map zgt_mm; zrt_map_init(&zgt_mm, sizeof({kc}), sizeof({vc}), &{vtn});"
	mut i := 0
	for i < ks.len() {
		# The KEY does not lower through c_fit_copied — a key is HASHED rather than owned, so
		# it wants the conversion without the copy, and that is exactly the split c_into makes
		# available. It used to take chk_slot_fits and then `c_expr`, which checked the fit and
		# then did not perform it: `{u: 1}` for a `map[int, int]` and a `uint` `u` wrote
		# UINT64_MAX in as -1, while `x: int = u` one line down raised.
		check.chk_slot_fits(em, "a key of this map literal", kt, ks[i])
		mk := c_into(em, kt, ks[i], sb)
		mv := c_fit_copied(em, "a value of this map literal", vt, vs[i], sb)
		out = out + f" {{ {kc} zgt_mk = {mk}; {vc} zgt_mv = {mv}; zrt_map_set(&zgt_mm, &zgt_mk, &zgt_mv); }}"
		i = i + 1
	}
	return out + " zgt_mm; })"
}

# c_slice_bound is one end of a slice range. A `nil` bound is the open form, which
# c_range_needs_hi has already had its say about.
fn c_slice_bound(mut &em: Emitter, e: ast.Expr) {
	return if c_is_nil_lit(e)

	t := c_infer(em, e)
	return if c_is_unknown(t) or c_is_int(t)

	check.chk_at(em, rule.Rule.SliceBoundNotInt, f"a slice bound is an int, and this is {ast.ty_name(t)}")
}

# c_slice lowers `xs[a..b]` — GRAMMAR says a slice IS an index by a range, which is why it
# needs no node of its own.
#
# The elements are copied into a fresh list rather than shared with the source. A list is
# a value in this language, so a slice that aliased its source would be the odd one out —
# and the runtime has no slice primitive to alias with anyway. The source is materialised
# into a temp first, so a call result is indexed once rather than per element.
fn c_slice(mut &em: Emitter, target: ast.Expr, idx: ast.Expr, tty: ast.Ty, sb: Subst) -> str {
	c_range_needs_hi(em, idx, "a slice needs an upper bound — `xs[a..xs.len()]`")

	# A BOUND IS AN INT, and nothing said so: `xs["a"..1]` was accepted and the runtime walked
	# from a pointer read as a length. Silent, and on the one operation whose whole job is to
	# stay inside the buffer.
	c_slice_bound(em, c_range_lo(idx))
	c_slice_bound(em, c_range_hi(idx))

	src := c_expr(em, target, sb)
	lo := c_expr(em, c_range_lo(idx), sb)
	mut hi := c_expr(em, c_range_hi(idx), sb)
	if c_range_incl(idx) {
		hi = f"({hi}) + 1"
	}

	# the loop is the RUNTIME's: duplicating an element is `vt->copy` or a memcpy depending
	# on the element type, which is a rule list.c already states twice. Emitting the loop
	# here pushed raw slots — a memcpy whatever the type — so a slice of a `list[list[int]]`
	# named the parent's inner buffers and a write through it was read back through both.
	em.used_rt = true
	mut out := "({ zrt_list zgt_ss = " + src + "; zrt_list zgt_sl;"
	out = out + " zrt_list_slice(&zgt_sl, &zgt_ss, (size_t)(" + lo + "), (size_t)(" + hi + "));"
	return out + " zgt_sl; })"
}

# c_map_index lowers `m[k]`. The key is materialised into a temp because zrt_map_index
# takes its ADDRESS, and a literal or call result has none.
# c_list_index_int is the rule above, asked of one subscript. It is a checked report rather
# than a raise: the index is a value entering a slot, which is what every other position of that
# shape does, and emission carries on so the rest of the program is checked too.
fn c_list_index_int(mut &em: Emitter, idx: ast.Expr) {
	t := c_infer(em, idx)
	return if c_is_unknown(t) or c_is_int(t)

	check.chk_at(em, rule.Rule.IndexNotInt, f"a list index is an int, and this is {ast.ty_name(t)}")
}

fn c_map_index(mut &em: Emitter, target: ast.Expr, idx: ast.Expr, tty: ast.Ty, sb: Subst) -> str {
	kt := c_map_key_ty(tty)

	# THE KEY IS A TYPED POSITION, and it was the one container slot with no rule: the index
	# was rendered into a `{key-c-type} zgt_mk = …` declaration whatever it was, so `m[1]` on a
	# `map[str, int]` reached cc as "incompatible integer to pointer conversion initializing
	# 'const char *'" — against generated C, about a Zerg line that says `m[1]`. It is asked
	# here rather than in c_index because here is where the key type has been read out.
	check.chk_slot_fits(em, f"a key of this {ast.ty_name(tty)}", kt, idx)

	kc := c_type(kt)
	vc := c_type(c_map_val_ty(tty))
	tgt := c_expr(em, target, sb)

	# the map is BOUND when it is not a place, for the reason c_index binds a list: a map
	# index takes the map's ADDRESS, and `n["a"]["b"]` or `({"a": 9})["a"]` has none —
	# which reached cc as "cannot take the address of an rvalue of type 'zrt_map'".
	return f"({{ {kc} zgt_mk = {c_expr(em, idx, sb)}; (*({vc}*)zrt_map_index(&({tgt}), &zgt_mk)); }})" if c_is_place(em, target)

	return f"({{ zrt_map zgt_mx = {tgt}; {kc} zgt_mk = {c_expr(em, idx, sb)}; (*({vc}*)zrt_map_index(&zgt_mx, &zgt_mk)); }})"
}

# c_map_set lowers `m[k] = v`. Both sides go through temps for the same reason.
fn c_map_set(mut &em: Emitter, target: ast.Expr, idx: ast.Expr, rhs: ast.Expr, tty: ast.Ty, ind: str) -> str {
	kc := c_type(c_map_key_ty(tty))
	vc := c_type(c_map_val_ty(tty))

	# `m[k] = v` INSERTS, so the map is WRITTEN and its target is an assignment target like
	# any other: `h[0]["z"] = 3` edits a map header that lives inside `h`'s buffer, and
	# lowering `h[0]` as a read left that buffer shared with `g`.
	tgt := c_lvalue(em, target, c_nosub())
	k := c_expr(em, idx, c_nosub())
	v := c_fit_copied(em, "the value written into this map", c_map_val_ty(tty), rhs, c_nosub())
	return f"{ind}{{ {kc} zgt_mk = {k}; {vc} zgt_mv = {v}; zrt_map_set(&({tgt}), &zgt_mk, &zgt_mv); }}\n"
}

# c_map_method lowers `m.len()` and `m.has(k)`. Both take the map's ADDRESS, which is the
# one fact that shapes the rest.
#
# `has` NEVER WORKED. It rendered `zrt_map_has(&(m), &zgt_mk)` and nothing declared
# `zgt_mk` — the function was not given the arguments, so the key had nowhere to come from
# and cc answered "use of undeclared identifier 'zgt_mk'" for every map in every program.
# c_map_index binds its key to exactly that name; this read as if it were inside that
# expansion, and its key is materialised the same way for the same reason.
#
# And the map is BOUND when it is not a place, again as c_map_index binds one: an address
# needs storage, and `{"a": 1}.len()` or `mk().len()` has none. The index path learned this
# and the method path did not, which is the same rule written at one of its two slots.
fn c_map_method(mut &em: Emitter, target: ast.Expr, meth: str, args: list[ast.Expr], tty: ast.Ty, sb: Subst) -> str {
	em.used_rt = true

	tgt := c_expr(em, target, sb)
	place := c_is_place(em, target)

	mut recv := f"&({tgt})"
	mut bind := ""
	if not place {
		recv = "&zgt_mx"
		bind = f"zrt_map zgt_mx = {tgt}; "
	}

	if meth == "len" {
		raise c_diag(em, rule.Rule.LenTakesNoArgument, f"`len` takes no argument, and this gives {strconv.to_string(args.len(), 10)}") if args.len() != 0

		return f"((int64_t)zrt_map_len({recv}))" if place

		return f"({{ {bind}(int64_t)zrt_map_len({recv}); }})"
	}
	if meth == "has" {
		raise c_diag(em, rule.Rule.HasTakesOneKey, f"`has` asks about one key, and this gives {strconv.to_string(args.len(), 10)}") if args.len() != 1

		kt := c_map_key_ty(tty)
		check.chk_slot_fits(em, f"a key of this {ast.ty_name(tty)}", kt, args[0])
		k := c_expr(em, args[0], sb)
		return f"({{ {bind}{c_type(kt)} zgt_mk = {k}; zrt_map_has({recv}, &zgt_mk); }})"
	}

	raise c_diag(em, rule.Rule.NotYetMapMethod, f"NotImplemented: the map method `{meth}`")
}

fn c_index_target(e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EIndex(t, _) => t
		_ => ast.Expr.ENil
	}
}

fn c_index_key(e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EIndex(_, i) => i
		_ => ast.Expr.ENil
	}
}

pub fn c_is_index(e: ast.Expr) -> bool {
	return match e {
		Expr.EIndex(_, _) => true
		_ => false
	}
}

pub fn c_is_map(t: ast.Ty) -> bool {
	return match t {
		Ty.TMap(_, _) => true
		_             => false
	}
}

pub fn c_map_key_ty(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TMap(k, _) => k
		_             => ast.Ty.TUnknown
	}
}

pub fn c_map_val_ty(t: ast.Ty) -> ast.Ty {
	return match t {
		Ty.TMap(_, v) => v
		_             => ast.Ty.TUnknown
	}
}

# --- tuples ---------------------------------------------------------------------
#
# A tuple is a plain C struct, one carrier per distinct SHAPE. The name is built from the
# element types, so two tuples of the same shape share one carrier and two of different
# shapes cannot collide.
fn c_tuple_ty(mut &em: Emitter, elems: list[ast.Expr]) -> ast.Ty {
	mut tys: list[ast.Ty] = []
	for e in elems {
		tys.append(c_infer(em, e))
	}
	return ast.Ty.TTuple(tys)
}

# c_tuple_cname is the carrier's C name. It is a PURE function of the shape because c_type
# needs the same spelling and has no Emitter to ask — registering the typedef is
# c_tuple_name's job, and every tuple reaches it through its literal.
# c_tuple_helpers emits the tuple's copy and the drop that balances it. It is c_copy_helper
# and c_drop_helper's shape with `f0`-style fields instead of names, and the two are written
# in one function for the reason those two are written next to each other: a field the copy
# retains and the drop does not release is a leak, and the reverse is a use-after-free.
#
# The drop was missing entirely. The copy alone was the whole of a tuple's ownership, so
# `t := (i, s)` retained the str and nothing ever gave it back — one allocation a round,
# which scripts/mem-check.sh counts.
#
# THE FIELDS ARE RELEASED IN REVERSE, which is the order docs/core/memory.md pins inside an
# aggregate and the order c_enum_variant_drop already walks.
fn c_tuple_helpers(mut &em: Emitter, name: str, tys: list[ast.Ty]) -> str {
	mut out := f"static {name} {name}_copy({name} v) {{\n    {name} r = v;\n"
	mut i := 0
	for i < tys.len() {
		fi := f"f{strconv.to_string(i, 10)}"
		if c_needs_copy(em, tys[i]) {
			out = out + f"    r.{fi} = " + c_copy_of(em, tys[i], f"v.{fi}") + ";\n"
		}
		i = i + 1
	}
	out = out + "    return r;\n}\n"

	out = out + f"static void {name}_drop({name} *v) {{\n"
	mut j := tys.len() - 1
	for j >= 0 {
		fj := f"f{strconv.to_string(j, 10)}"
		if c_needs_copy(em, tys[j]) {
			out = out + "    " + c_drop_stmt(em, tys[j], f"v->{fj}") + "\n"
		}
		j = j - 1
	}
	return out + "}\n"
}

fn c_tuple_cname(tys: list[ast.Ty]) -> str {
	mut name := "zgt_tup"
	for t in tys {
		name = name + "_" + c_ident_safe(c_type(t))
	}
	return name
}

# c_tuple_name is c_tuple_cname plus the typedef it needs. A C identifier cannot hold `*`
# or a space, so each element type is flattened into one.
# c_tuple_decl registers a tuple shape and answers its DECLARATION TEXT — the typedef, plus
# the copy helper a tuple owes when it holds a list, a map or another such tuple (without
# it the tuple's field named the source's buffer). A shape already registered answers "".
#
# The ELEMENTS are registered first, depth first. `c_type` of a tuple element is a pure
# function of its shape and registers nothing, so `(1, (2, 3))` used to emit the outer
# typedef naming an inner one that no pass had written — cc reported `unknown type name`
# against generated C for a program with a tuple inside a tuple. A CARRIER element is the
# same hole from the other side: `(x, 1)` over an `x: int?` spelled `zg_opt_int64_t` into
# this typedef while the carrier's own text sat in a section emitted after it, so the
# elements go through c_spelled_pre, which covers both.
fn c_tuple_decl(mut &em: Emitter, tys: list[ast.Ty]) -> str {
	mut out := ""
	for t in tys {
		out = out + c_spelled_pre(em, t)
	}
	name := c_tuple_cname(tys)
	for n in em.tup_names {
		return out if n == name
	}
	mut decl := "typedef struct {"
	mut i := 0
	for i < tys.len() {
		decl = decl + f" {c_type(tys[i])} f{strconv.to_string(i, 10)};"
		i = i + 1
	}
	em.tup_names.append(name)
	out = out + decl + f" }} {name};\n"
	if c_needs_copy(em, ast.Ty.TTuple(tys)) {
		out = out + c_tuple_helpers(em, name, tys) + c_elem_vt_helper(em, ast.Ty.TTuple(tys))
	}
	return out
}

# c_tuple_name is c_tuple_decl for a tuple first met while a BODY is lowered: the text goes
# into the on-demand stream, which is emitted after the declarations. c_type_decls calls
# c_tuple_decl directly instead, so a tuple a DECLARATION names is placed among the other
# typedefs in dependency order.
#
# The stream is res_decls, SHARED with the carriers. It was a section of its own emitted
# ahead of theirs, and the fixed order was wrong whenever the carrier was met first:
# `x: int? = 5` registered the optional, `(x, 1)` then wrote a tuple typedef spelling
# `zg_opt_int64_t` into the earlier section, and cc reported it. One stream in met-order
# cannot be wrong, because each declaration inlines what it spells (c_spelled_pre).
fn c_tuple_name(mut &em: Emitter, tys: list[ast.Ty]) -> str {
	c_spelled_register(em, ast.Ty.TTuple(tys))
	return c_tuple_cname(tys)
}

fn c_ident_safe(s: str) -> str {
	mut out: list[byte] = []
	for c in bytearray(s) {
		if ascii.is_alpha(c) or ascii.is_digit(c) or c == b'_' {
			out.append(c)
		} else if c == b'*' {
			out.append(b'p')
		}
	}
	return str(out)
}

fn c_tuple_lit(mut &em: Emitter, elems: list[ast.Expr], sb: Subst) -> str {
	mut tys: list[ast.Ty] = []
	for e in elems {
		tys.append(c_infer(em, e))
	}

	name := c_tuple_name(em, tys)
	mut out := f"({name}){{"
	mut i := 0
	for i < elems.len() {
		if i > 0 {
			out = out + ", "
		}

		# each element is COPIED into the tuple, like a struct's constructor argument: the
		# tuple owns what it holds, and `(a, 0)` used to store `a`'s own list header, so a
		# write through `t.0` was read back through `a`
		out = out + c_copied(em, tys[i], elems[i], sb)
		i = i + 1
	}
	return out + "}"
}

# c_fieldref lowers `x.name`. A field whose name is a NUMBER is a tuple element — GRAMMAR
# reads a tuple back by static index, `t.0`, and the parser gives that the same EField node
# a struct field gets, so the number is what tells them apart.
fn c_field_ty_of(mut &em: Emitter, target: ast.Expr, fld: str) -> ast.Ty {
	# `Color.Red` is a value of `Color`, and it is answered here for the same reason
	# c_fieldref answers it: an enum name infers to nothing, so asking about the target
	# first would lose the shape.
	en := c_qualified_variant(em, target, fld)
	return ast.Ty.TNamed(en) if en != ""

	# `lib.LIMIT` — a module-qualified name is the name it ends with, and its TYPE is the
	# module row's (k_tys), not the environment's: a local shadowing the constant must not
	# answer for it here any more than in c_fieldref
	if c_ns_kind(em, target) == NsKind.NsModule {
		ki := c_k_idx(em, fld)
		return em.k_tys[ki] if ki >= 0
	}

	t := c_infer(em, target)
	if c_is_tuple(t) and c_all_digits(fld) {
		ts := c_tuple_tys(t)

		# `int(s)` is a CAST here, not a parse — the index has to come from strconv
		i := strconv.parse_int(fld, 10)
		return ts[i] if i >= 0 and i < ts.len()
		return ast.Ty.TUnknown
	}

	# An Err is a RUNTIME struct, not a declared one, so its two readable fields are
	# answered here. They are deliberately the whole set: a message to report and a kind
	# to compare, which is what `Right(e)` needs to be worth binding.
	if c_is_err_ty(t) {
		return ast.Ty.TStr if fld == "msg"
		return ast.Ty.TInt if fld == "kind"

		raise c_diag(em, rule.Rule.NotYetErrField, f"NotImplemented: the field `{fld}` on an Err — it has `msg` and `kind`")
	}
	return c_field_ty(em, c_named_of(t), fld)
}

fn c_fieldref(mut &em: Emitter, target: ast.Expr, fld: str, sb: Subst) -> str {
	# `Color.Red` — a variant NAMED BY ITS ENUM. The bare `Red` is what the grammar makes
	# normative (a bare name is a variant when it resolves to one, GRAMMAR#variant-pat), and it
	# stays; this is the same value said unambiguously, which is what a reader reaches for
	# when two enums are in scope and the bare names do not say which is meant. It is
	# answered before inference for the reason `E.of(n)` is: an enum name is not a binding,
	# so `c_infer` has nothing to say about it and the message was `undefined name `Color``.
	en := c_qualified_variant(em, target, fld)
	return "(zg_" + en + "){.tag = " + strconv.to_string(c_variant_tag_in(em, en, fld), 10) + "}" if en != ""

	# `lib.LIMIT` — a MODULE-QUALIFIED name. A module flattens into this unit, so the
	# qualifier says where the name came from and the last segment IS the name — which is
	# the rule the CALL path has followed since it was written (`ascii.is_digit`). The
	# field path did not, so it lowered `lib` as a value and reported `undefined name lib`:
	# about the qualifier, which is the one part of the expression that is not a name.

	# the enum is named and the field is not one of ITS variants. Falling through said
	# `undefined name `Color`` — about the one name in the expression that IS defined.
	#
	# THE TWO ARE ASKED IN ONE ORDER because they are one question read twice: `fld` is not a
	# variant of `tn` either way, and E4031 only adds where it IS one. It used to ask the second
	# of the FLAT table — "which enum owns this bare name" — so a `Red` that both enums declared
	# reported `Red` is a variant of `Colour`, not of `Signal`` about a `Signal` that has one.
	# A false sentence is worse than no sentence: it sends the reader to fix a program that is
	# right. The scoped lookup above answers that spelling now, and what is left here cannot be
	# false — E4031 speaks only of a name `tn` does not declare, and names an enum that does.
	#
	# REPORTED rather than raised, so both carry the place every checked rule does. They are
	# statements about a program the language rejects, not forms this compiler has not built;
	# the C built after a finding is thrown away, which is what lets the walk carry on.
	tn := c_ident_name(target)
	if tn != "" and c_is_enum_name(em, tn) {
		if c_is_variant(em, fld) {
			check.chk_at(em, rule.Rule.VariantOfOtherEnum, f"`{fld}` is a variant of `{c_variant_enum(em, fld)}`, not of `{tn}`")
		} else {
			check.chk_at(em, rule.Rule.NotAVariantOf, f"`{fld}` is not a variant of `{tn}`")
		}
		return "0"
	}

	ns := c_ident_name(target)
	if c_ns_kind(em, target) == NsKind.NsModule {
		# the same import question the two call paths ask — a member READ crosses the module
		# boundary exactly as a call does
		check.chk_ns_bound(em, c_ns_root(target))

		# `lib.LIMIT` — a module-qualified NAME. The qualifier is the binding an `import`
		# introduced (c_is_ns), and a module flattens into this unit, so the last segment
		# IS the name — which is the rule the CALL path has followed since it was written
		# (`ascii.is_digit`).
		#
		# It is answered from the MODULE-CONSTANT ROWS (c_const_globals') and never from
		# the environment. Resolving through c_var_cname read the innermost live binding,
		# so under a local `COUNT := 9` the qualified `lib.COUNT` printed 9 — the question
		# named `lib` and the answer came from the local. The global's C name is fixed
		# (`zg_<name>`, c_reset_env's own spelling), so the local's shadow row cannot
		# reach it. What this does NOT fix is WHICH module answers: `b.COUNT` still answers
		# a constant module `a` declared, because every module flattens into one namespace
		# — the documented deviation (docs/runtime/package.md). The qualifier itself is no
		# longer taken on faith: an invented one is not a namespace, so it never reaches
		# this branch and is lowered as the value it looks like, which reports it by name.
		#
		# Whether this module may read it is the same question a call asks
		# (c_chk_visible_fn), against the rows c_const_globals recorded.
		if c_k_idx(em, fld) >= 0 and c_ns_names_mod(em, ns, check.c_mod_of(em, em.k_decls[c_k_idx(em, fld)].path)) {
			c_chk_visible_const(em, fld)
			return "zg_" + fld
		}

		# a REAL module and a member no module declares. Falling through lowered `lib` as
		# a value and said `undefined name lib` — about the qualifier, which is the part
		# that is right. A LOCAL of the asked-for name must not soften this into an
		# answer: the question was the module's, and the module has no such member.
		#
		# UNLESS THE MODULE HAS IT AS A FUNCTION, and then the sentence above is FALSE:
		# `f := other.helper` is refused in a program where `other.helper(4)` runs and
		# `other.STEP` reads, so telling the reader the module has no `helper` sends them to
		# check a spelling that is correct. What it has no VALUE FORM for is the function
		# (docs/runtime/package.md marks the capability `[not yet]`), and that is what this
		# says instead.
		if c_ns_declares_fn(em, ns, fld) {
			check.chk_at(em, rule.Rule.NotYetCrossModuleFnValue, f"module `{ns}` declares the function `{fld}`, and a module's function is not a value here — call it (`{ns}.{fld}(…)`) or wrap it in one of this module's own functions. A first-class cross-module function is a form this compiler has not built (docs/runtime/package.md)")
			return "0"
		}

		check.chk_no_member(em, ns, fld)
		return "0"
	}

	tgt := c_expr(em, target, sb)
	tt := c_infer(em, target)

	if c_all_digits(fld) {
		# `.0` IS A TUPLE'S ACCESSOR AND NOTHING ELSE'S, and it was spelled `.f0` onto whatever
		# stood to its left: `n.0` on an int reached cc as "member reference base type
		# 'int64_t' is not a structure or union", and `t.5` on a 2-tuple as "no member named
		# 'f5'". A tuple is read by STATIC index precisely so the element's type is known —
		# which means the index is checkable here, and was not checked at all.
		c_tuple_index_ok(em, tt, fld)

		return f"{tgt}.f{fld}"
	}

	# an Err's fields are the runtime's own, so they carry no `zg_` mangling
	return f"{tgt}.{fld}" if c_is_err_ty(tt)

	# A FIELD THE TYPE DOES NOT HAVE was spelled `zg_<fld>` and handed to cc, which reported
	# "no member named 'zgt_z' in 'zg_P'" against generated code — the same class as an
	# undefined name, and answerable from the same tables. A target whose type inference
	# could not name is left alone: guessing there would refuse a working program.
	#
	# A STRUCT THAT LACKS THE FIELD and A TARGET WITH NO FIELDS AT ALL are one rule — this
	# said so in prose while reporting them as two, one raised without a place and one
	# collected with one — so they report through one channel, and the half that used to
	# raise says WHERE as well.
	nm := c_named_of(tt)
	if check.chk_is_scalar(tt) or (c_is_struct_name(em, nm) and c_is_unknown(c_field_ty(em, nm, fld))) {
		check.chk_at(em, rule.Rule.NoSuchField, f"no field `{fld}` on {ast.ty_name(tt)}")
	}

	# AND WHETHER THIS MODULE MAY READ IT. One place answers for the read and the write
	# alike: c_lvalue lowers its target through c_expr, so `s.hidden = 1` arrives here just
	# as `print s.hidden` does, and a rule written on the assignment path alone would have
	# covered the half nobody tries first.
	check.chk_fld_visible(em, nm, fld)

	return f"{tgt}.zg_{fld}"
}

# c_tuple_index_ok is the two halves of `t.N`: the target is a tuple, and N is one of its
# elements. An unknown target is left alone, as everywhere else.
fn c_tuple_index_ok(mut &em: Emitter, t: ast.Ty, fld: str) {
	return if c_is_unknown(t)

	if not c_is_tuple(t) {
		check.chk_at(em, rule.Rule.TupleAccessOnNonTuple, f"`.{fld}` reads a tuple element, and {ast.ty_name(t)} is not a tuple")
		return
	}

	n := c_tuple_tys(t).len()
	i := strconv.parse_int(fld, 10)
	return if i >= 0 and i < n

	check.chk_at(em, rule.Rule.TupleIndexOutOfRange, f"a tuple of {strconv.to_string(n, 10)} has no `.{fld}` — its elements are `.0` through `.{strconv.to_string(n - 1, 10)}`")
}

fn c_all_digits(s: str) -> bool {
	b := bytearray(s)
	return false if b.len() == 0
	for c in b {
		return false if not ascii.is_digit(c)
	}
	return true
}

fn c_is_tuple(t: ast.Ty) -> bool {
	return match t {
		Ty.TTuple(_) => true
		_            => false
	}
}

fn c_tuple_tys(t: ast.Ty) -> list[ast.Ty] {
	mut none: list[ast.Ty] = []
	return match t {
		Ty.TTuple(ts) => ts
		_             => none
	}
}

# A code and a place. `x..y` in a value position is a form GRAMMAR#range-expr derives
# anywhere an expression goes, and the sentence that turned it away carried neither — so a
# gate could not pin it and a reader was told what a range is NOT good for without being
# told where they had written one.
fn c_range_unsupported(mut &em: Emitter) -> str {
	raise c_diag(em, rule.Rule.NotYetRangeAsValue, "NotImplemented: a range used as a value — `x..y` is a `for … in` iterable and a membership test (`v in x..y`) so far, and there is no Range value to bind, pass or return")
}

fn c_is_range(e: ast.Expr) -> bool {
	return match e {
		Expr.ERange(_, _, _) => true
		_ => false
	}
}

# The range accessors. emit.zg's match is an EXPRESSION — every arm yields a value — so a
# node is taken apart one field at a time rather than in a block-bodied arm.
fn c_range_lo(e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.ERange(a, _, _) => a
		_ => ast.Expr.ENil
	}
}

fn c_range_hi(e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.ERange(_, b, _) => b
		_ => ast.Expr.ENil
	}
}

fn c_range_incl(e: ast.Expr) -> bool {
	return match e {
		Expr.ERange(_, _, incl) => incl
		_ => false
	}
}

# c_forrange lowers `for v in a..b` to a counted loop. The loop variable is an int and is
# in scope for the body, which is what makes the bound expressions ordinary ints too. Both
# bounds are read once into temps, so an expression bound is not re-evaluated on every
# iteration the way a C `for` header would.
fn c_forrange(mut &em: Emitter, var: str, iter: ast.Expr, body: list[ast.Stmt], ind: str) -> str {
	c_range_needs_hi(em, iter, "a `for … in` needs an upper bound")

	lo := c_expr(em, c_range_lo(iter), c_nosub())
	hi := c_expr(em, c_range_hi(iter), c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, ast.Ty.TInt, false, false)

	# the C name the binding actually took: a second loop over the same source name is a
	# SHADOWING binding, and c_add_var gives it `zg_v__1` rather than `zgt_v`
	cv := c_var_cname(em, var)
	in2 := ind + "    "

	# LOW FIRST. Only the high bound used to be materialised and the low one stayed in the
	# `for` initialiser, which C runs after the declaration above it — so `for i in a()..b()`
	# called `b` and then `a`, while the same two calls written `a() + b()` in the same
	# program ran left to right, as every other operand pair in the language does.
	mut out := ind + "{\n" + in2 + "int64_t zgt_lo = " + lo + ";\n" + in2 + "int64_t zgt_hi = " + hi + ";\n"

	# An INCLUSIVE range whose high end is the type's maximum has no value to step to after
	# it: `v++` there overflows, which is undefined in C and in practice loops forever. The
	# step is the condition instead — 1 while there is another value, 0 at the last one — so
	# the loop ends without ever computing a value outside the range.
	#
	# Testing `!=` rather than `<` is safe because the loop variable is IMMUTABLE — the
	# body cannot move it off the sequence, so the only way to reach `hi` is to step to it.
	if c_range_incl(iter) {
		head := f"for (int64_t {cv} = zgt_lo, zgt_more = ({cv} <= zgt_hi); zgt_more; "
		out = out + in2 + head + "zgt_more = (" + cv + " != zgt_hi), " + cv + " += zgt_more) {\n"
	} else {
		out = out + in2 + "for (int64_t " + cv + " = zgt_lo; " + cv + " < zgt_hi; " + cv + "++) {\n"
	}
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

# c_frz_push freezes the collection a `for … in` walks for the length of its body, and
# answers whether anything was pushed — which is what c_frz_pop needs, and the only reason
# it answers at all. An iterable with no BINDING to record freezes nothing: a field path, a
# slice or a call result has no environment row, and the [deviation] in
# docs/code/collections.md is exactly that set.
fn c_frz_push(mut &em: Emitter, iter: ast.Expr) -> bool {
	name := c_ident_name(iter)
	if name != "" {
		idx := c_live_idx(em, name)
		return false if idx < 0

		em.frz_idxs.append(idx)
		return true
	}

	# AND A PATH, which has no row to record. `for x in p.xs` is walking one collection just
	# as `for x in xs` is, and the local rule says so: the freeze holds the written path and
	# refuses a structural change spelled the same way. A slice or a call result is still
	# nothing — those name a value with no place behind it, so there is nothing to freeze.
	path := check.chk_path_text(iter)
	return false if path == ""

	em.frz_paths.append(path)
	return true
}

# c_frz_pop ends the freeze c_frz_push started, given what it answered. WHICH stack it pops
# is read from the iterable rather than remembered, for the reason c_frz_push answers a bool
# at all: the two are one decision and a second flag would be a second chance to get it wrong.
fn c_frz_pop(mut &em: Emitter, pushed: bool, iter: ast.Expr) {
	return if not pushed

	if c_ident_name(iter) != "" {
		c_ints_drop_last(em.frz_idxs)
		return
	}
	c_strs_drop_last(em.frz_paths)
}

# c_forin lowers `for v in xs { ... }` to an index loop over the runtime list.
# c_forchan lowers `for v in ch`. The channel IS the iterator: it yields values until its
# last sender leaves, and that close is the StopIteration which ends the loop. There is no
# generator type and no `yield` keyword in this language because this is where they would
# have gone — a producer coroutine sending to a channel is the generator, and the `send`
# is the yield.
#
# A closed channel still hands over what it is holding, so the loop drains the buffer
# before it ends; that is zrt_chan_recv's own rule, not something repeated here.
#
# The one thing a close does NOT say by itself is WHY. An ordinary close and a sender that
# crashed both end the receive, so the reason is read after the loop, and it is read as the
# whole Err: the StopIteration KIND is the ordinary end, and anything else is the Err of a
# sender that died while this loop was reading it — re-raised here, message, cause and kind
# intact. Ending quietly instead would turn a crash into a short answer, which is the
# failure this language is least willing to produce, and re-raising a stand-in string
# would keep the failure while losing the reason for it.
fn c_forchan(mut &em: Emitter, var: str, iter: ast.Expr, t: ast.Ty, body: list[ast.Stmt], ind: str) -> str {
	em.used_conc = true
	c_chan_op_check(em, t, 0)

	elem := ast.ty_chan_elem(t)
	et := c_type(elem)
	it := c_expr(em, iter, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, elem, false, false)
	cv := c_var_cname(em, var)

	# The loop's handle OWNS what it holds when the iterable was not already storage. `for v
	# in ch` borrows the binding `ch` and gives nothing back; `for v in source()` is handed a
	# freshly built handle carrying exactly one reference, and this loop is the only thing
	# that will ever be in a position to return it. It is the same rule c_let_chan states for
	# a binding — a name takes a reference and gives it back — reaching the one holder that
	# is not a name.
	#
	# The handle is NUMBERED when it owns, because the release then joins the pending list
	# and a `return` inside the body renders every pending name at the return site: two
	# nested loops both spelling their handle `zgt_cit` would release the inner one twice and
	# the outer one never. The number is the pending list's own height, which is unique among
	# the entries that can be live together and moves only when the program does. A borrowed
	# handle registers nothing, so it keeps the plain name and its C is unchanged.
	keep := em.rel_cnames.len()
	owns := c_owns_value(iter)
	mut cit := "zgt_cit"
	if owns {
		cit = f"zgt_cit_{keep}"
	}

	# a block, so the handle and the loop variable are scoped to the loop and sequential
	# or nested `for … in ch` loops cannot collide on the name
	in2 := ind + "    "
	mut mark := ""
	if owns {
		mark = c_new_mark(em)
	}
	mut out := ind + "{\n"
	if owns {
		out = out + in2 + f"size_t {mark} = zrt_scope_mark();\n"
	}
	out = out + in2 + "zrt_chan *" + cit + " = " + it + ";\n"
	if owns {
		out = out + c_pend_release(em, cit, c_chan_defer_thunk(c_chan_dir(t)), in2)
	}
	out = out + in2 + et + " " + cv + ";\n"
	out = out + in2 + "while (zrt_chan_recv(" + cit + ", &" + cv + ") == 0) {\n"
	out = out + c_loop_block(em, body, in2 + "    ")
	out = out + in2 + "}\n"

	# The close reason is read BEFORE the handle is given back, and the release sits between
	# the read and the raise: zrt_chan_close_err answers by value, so the Err outlives the
	# handle, and putting the release here is what keeps the crash path from being the one
	# path that leaks.
	out = out + in2 + "{ zrt_err zgt_ce = zrt_chan_close_err(" + cit + ");\n"
	c_scope_forget(em, keep)
	if owns {
		out = out + in2 + f"  zrt_unwind_to({mark});\n"
	}
	out = out + in2 + "  if (zgt_ce.kind != ZRT_ERR_STOP_ITERATION) { zrt_raise_err(zgt_ce); } }\n"
	c_scope_close(em, outer_scope)
	return out + ind + "}\n"
}

fn c_forin(mut &em: Emitter, var: str, iter: ast.Expr, body: list[ast.Stmt], ind: str) -> str {
	# A RANGE is not a container, so it never touches the list runtime: `for i in a..b` is
	# the counted C loop it already means.
	return c_forrange(em, var, iter, body, ind) if c_is_range(iter)
	em.used_rt = true

	# A CHANNEL is the other thing that is iterated without being a container: the loop
	# is the receive, and the close is what ends it.
	ct := c_infer(em, iter)
	return c_forchan(em, var, iter, ct, body, ind) if ast.ty_is_chan(ct)

	# A MAP binds the KEY, walked in insertion order (docs/code/collections.md) — the value
	# is reached with `m[k]`. It used to fall through to the list path below, which handed
	# cc a `zrt_map` where a `zrt_list` was declared.
	return c_formap(em, var, iter, ct, body, ind) if c_is_map(ct)

	# `for c in s` walks a str's CODE POINTS (docs/core/types.md: a str "iterates as `rune`
	# and is not indexable"), so it is the rune bridge and then the ordinary list walk. It
	# is written as that rewrite rather than as a loop of its own because the two ARE the
	# same loop — the only question a str raises is what its elements are, and the answer is
	# a `list[rune]`, which every rule below already knows how to walk.
	return c_forin(em, var, ast.Expr.EConv(ast.Ty.TList(ast.Ty.TRune), iter, "list"), body, ind) if c_is_str(ct)

	# WHAT IS LEFT MUST BE A LIST. Everything else fell through to the list walk, which reads
	# an element type a non-container does not have — so `for x in n` on an int bound `x` to
	# TUnknown, and the first USE of `x` reported "undefined name `x`". The loop variable was
	# blamed for the thing being walked: a sentence about the consequence, naming the one part
	# of the line that is fine.
	if not c_is_list(ct) and not c_is_unknown(ct) {
		check.chk_at(em, rule.Rule.NotIterable, f"`for … in` walks a list, a map, a str, a range or a channel, and {ast.ty_name(ct)} is not iterable")
	}

	elem := c_list_elem(ct)
	et := c_type(elem)
	outer_scope := c_scope_open(em)
	c_add_var(em, var, elem, false, false)
	cv := c_var_cname(em, var)

	# wrap in a block and COPY the iterable into a local. It used to be a header bit-copy —
	# addressable, and enough for a call-result rvalue — which meant the loop held a
	# pointer into a buffer it had taken no reference to: `for v in xs { xs.append(v) }`
	# grew `xs` past its capacity, `zrt_list_grow` freed the buffer, and the loop read on
	# from the free'd one. ASan called it a heap-use-after-free; without it the loop simply
	# read rubbish. A copy is what the language says a loop iterates anyway — the sequence
	# as it was when the loop started — and under copy-on-write it costs an increment.
	# The iterable is COPIED into a local when it names storage, and TAKEN OVER when it does
	# not — `for v in xs` must iterate the sequence as it was when the loop started, and
	# `for c in s` builds its list of code points here and owns the only reference to it.
	# Copying that one as well left the fresh list at two references and dropped neither, so
	# every execution of the loop leaked its whole buffer.
	in2 := ind + "    "
	keep := em.rel_cnames.len()
	mark := c_new_mark(em)
	mut out := ind + "{\n" + in2 + f"size_t {mark} = zrt_scope_mark();\n"
	out = out + in2 + "zrt_list zgt_it = " + c_copied(em, c_infer(em, iter), iter, c_nosub()) + ";\n"
	out = out + c_pend_drop(em, ast.Ty.TList(elem), "zgt_it", in2)
	out = out + in2 + "for (size_t zgt_i = 0; zgt_i < zrt_list_len(&zgt_it); zgt_i++) {\n"
	out = out + in2 + "    " + et + " " + cv + " = (*(" + et + "*)zrt_list_at_ref(&zgt_it, zgt_i));\n"

	# the walked collection is FROZEN for the body's extent (docs/code/collections.md): its
	# BINDING is pushed here and popped after, so every rule that consults the stack sees
	# exactly the loops the statement is inside — and sees the loop's own binding rather
	# than everything the body spells with the same name
	frz := c_frz_push(em, iter)
	out = out + c_loop_block(em, body, in2 + "    ")
	c_frz_pop(em, frz, iter)
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	c_scope_forget(em, keep)
	return out + in2 + f"zrt_unwind_to({mark});\n" + ind + "}\n"
}

# c_formap is the list loop over a map's KEYS, on the runtime's insertion-ordered accessor.
# The map is materialised into a local for the same reason the list is: a call result has no
# address, and two sequential loops must not clash on the temp name.
fn c_formap(mut &em: Emitter, var: str, iter: ast.Expr, ct: ast.Ty, body: list[ast.Stmt], ind: str) -> str {
	kt := c_map_key_ty(ct)
	kc := c_type(kt)
	it := c_expr(em, iter, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, var, kt, false, false)

	cv := c_var_cname(em, var)

	in2 := ind + "    "
	keep := em.rel_cnames.len()
	mark := c_new_mark(em)

	# COPIED, for the reason c_forin gives: a bare header meant the loop pointed into a
	# buffer it had taken no reference to, so an insert in the body reallocated `entries`
	# and the loop read on from the free'd block
	#
	# AND THE COPY IS GIVEN BACK, which is the half this had not got. `c_forin` marks the
	# scope, registers the pending drop and unwinds to the mark — so its copy is released on
	# every way out, `break` and abort included — while this one made a copy per execution
	# and dropped none of them: `for k in m { … }` inside a 1,000,000-round loop peaked at
	# 108.8 MB against a 1.4 MB floor. Two loops, one rule; the map's is spelled the same way
	# the list's is rather than a second way.
	mut out := ind + "{\n" + in2 + f"size_t {mark} = zrt_scope_mark();\n"
	out = out + in2 + "zrt_map zgt_mit = " + c_copy_of(em, c_infer(em, iter), it) + ";\n"
	out = out + c_pend_drop(em, c_infer(em, iter), "zgt_mit", in2)
	out = out + in2 + "for (size_t zgt_i = 0; zgt_i < zrt_map_len(&zgt_mit); zgt_i++) {\n"
	out = out + in2 + "    " + kc + " " + cv + " = (*(" + kc + "*)zrt_map_key_at(&zgt_mit, zgt_i));\n"

	# frozen for the body's extent, exactly as c_forin does for a list — a map's structural
	# change has one more spelling (`m[k] = v` may INSERT), and chk_assignable reads this
	# same stack to refuse it
	frz := c_frz_push(em, iter)
	out = out + c_loop_block(em, body, in2 + "    ")
	c_frz_pop(em, frz, iter)
	out = out + in2 + "}\n"
	c_scope_close(em, outer_scope)
	c_scope_forget(em, keep)
	return out + in2 + f"zrt_unwind_to({mark});\n" + ind + "}\n"
}

fn c_let(mut &em: Emitter, name: str, ty: ast.Ty, has_type: bool, is_mut: bool, is_const: bool, ival: ast.Expr, ind: str) -> str {
	# RE-DECLARATION IS LEGAL, same block included (docs/core/memory.md): the initializer
	# below is rendered before c_add_var appends the new row, so the RHS reads the OLD
	# binding, the name then rebinds afresh, and the old row's storage pays at scope exit
	# exactly as an explicit `del`'s does. The only name a binding may not take is a
	# visible `const`'s (chk_const_rebind, in c_add_var).

	# direction two of shadow-proofing is asked HERE and not in c_add_var, because only
	# a `binding` can mint a `const` — a loop variable or a match-arm bind never can
	if is_const {
		check.chk_const_mint(em, name)
	}

	mut eff := ty
	if has_type {
		check.chk_binding(em, name, ty, ival)
		if ast.ty_is_chan(ty) {
			c_chan_check(em, c_infer(em, ival), ty, check.chk_binding_says(name))
		}
	} else {
		# THE TWO HALVES OF "THIS BINDING HAS NO TYPE TO TAKE". chk_needs_type is about the
		# FORM — `[]`, `{:}`, a written `nil`, which carry none — and chk_no_nil_value is about
		# what the expression ANSWERS, which is where `f()` with no `-> type` and `{ nop }` come
		# in. The second is asked only when the first said nothing, because `x := nil` is a
		# mistake both would name and one mistake earns one message.
		reported := check.chk_needs_type(em, name, ival)
		eff = c_infer(em, ival)
		if not reported {
			check.chk_no_nil_value(em, eff, check.chk_binding_says(name))
		}
	}

	# A MAP LITERAL takes its shape from the declaration. `c_map_lit_ty` reads the entries,
	# so an EMPTY `{:}` sized its value slot as int64_t: `mut m: map[str, P] = {:}` then
	# `m["a"] = P(3,4)` silently read back a TRUNCATED value, and a carrier value was a cc
	# error instead. The declared type is what the map is built with when one is written.
	if has_type and c_is_map(eff) and c_is_maplit(ival) {
		# the literal is rendered BEFORE the binding enters scope, like every other
		# initializer here: an entry naming `name` means the OLD binding — a shadowed
		# outer one, or the one this declaration re-declares — never the new variable
		mval := c_map_lit_as(em, eff, ival, c_nosub())
		c_add_var(em, name, eff, is_mut, is_const)
		return f"{ind}zrt_map {c_var_cname(em, name)} = {mval};\n"
	}

	return c_let_list(em, name, eff, is_mut, is_const, ival, ind) if c_is_list(eff)
	return c_let_chan(em, name, eff, is_mut, is_const, ival, ind) if ast.ty_is_chan(eff)
	return c_let_str(em, name, eff, is_mut, is_const, ival, ind) if c_is_str(eff)

	# an optional does not fit a declaration that promised a value: there is no implicit
	# unwrap in the language, and letting one through emitted a carrier where a scalar went
	raise c_diag(em, rule.Rule.OptionalNotUnwrapped, f"`{name}` is declared {ast.ty_name(eff)} and the value is {ast.ty_name(c_infer(em, ival))}: unwrap it with `?? …`, `!` or `if {name} := …`") if has_type and not ast.ty_is_opt(eff) and ast.ty_is_opt(c_infer(em, ival))

	# a declared `T?` takes the value the declaration promises, wrapping a bare one; the
	# value is rendered BEFORE the binding enters scope, so an initializer naming `name`
	# reads the old binding rather than the uninitialized new one
	#
	# The c_carrier_fit call is what WRAPS a bare value — `x: int? = 5` — and the path below
	# would not: it ends at c_into, which converts and copies but never puts a value into a
	# carrier. So this arm stays, and what it gains is the registration it never had, which
	# is the same c_pend_drop the bottom of this function reaches.
	if has_type and c_is_carrier(eff) {
		cval := c_carrier_fit(em, check.chk_binding_says(name), eff, ival, c_nosub())
		c_add_var(em, name, eff, is_mut, is_const)
		ccn := c_var_cname(em, name)
		cgive := c_pend_drop(em, eff, ccn, ind)
		return f"{ind}{c_type(eff)} {ccn} = {cval};\n" + cgive
	}

	# The initializer is rendered BEFORE the binding enters scope: in `mut n := n` the
	# right-hand side names the OUTER n, and resolving it after would make the new
	# variable initialize itself.
	#
	# c_into, not c_copied: a DECLARED binding is a typed position, and this is the one place
	# a declaration meets a value that does not lower through c_fit_copied — `c: byte = big`
	# stored 44 instead of raising, which is the truncation `byte(300)` was written to refuse.
	# `eff` is the INFERRED type when nothing was declared, and c_into is a no-op there
	# because the value already has it.
	val := c_into(em, eff, ival, c_nosub())

	# WHAT THIS BINDING IS WORTH AT COMPILE TIME, folded before the row exists so that
	# `n := n + 1` reads the OUTER n exactly as the emitted C does, and recorded after, on the
	# row c_add_var has just appended. This is the LOCAL half of GRAMMAR group 7 — `n := 4`
	# followed by `[0; n]` — and the three earlier returns above never reach it because a list,
	# a map, a channel, a string and a carrier are none of them a compile-time integer.
	#
	# A `mut` binding folds to nothing however constant its initializer looks: the position
	# that asks is asking for a value fixed for the whole program, and a name that may be
	# assigned tomorrow is not one.
	cval := c_fold_initializer(em, is_mut, ival)
	c_add_var(em, name, eff, is_mut, is_const)
	em.env_cval[em.env_cval.len() - 1] = cval
	cn := c_var_cname(em, name)

	# A STRUCT holding a list, a map or a str owns those, and this is where it says so. The
	# three that have their own c_let_ above say it there because they have more to say; a
	# struct, a map and a tuple all arrive here, and c_pend_drop knows which of them owes
	# anything. A CARRIER — `T?`, `Result[T]` — arrives here too and is registered like the
	# rest: c_carrier_decl generates its drop beside its copy, so a `T?` binding gives its
	# payload back at scope exit rather than leaking it. The typed arm above registers the
	# one it wraps for the same reason.
	give := c_pend_drop(em, eff, cn, ind)
	return f"{ind}{c_type(eff)} {cn} = {val};\n" + give
}

# c_let_chan declares a CHANNEL binding, which owns what it holds. Two halves:
#
# It TAKES a reference. An initializer that names existing storage — another binding, a
# parameter — is somebody else's handle, so this binding takes one of its own, by ITS OWN
# direction: `tx: chan[int]<- = ch` counts as a sender, `rx: <-chan[int] = ch` counts only
# as a holder. A freshly built handle (`chan[T](n)`, a call's result) already carries
# exactly one reference and this binding takes it over, so copying there would leak one.
#
# And it GIVES IT BACK at scope exit (c_pend_release). That is the half this emitter did
# not have, and its absence is why a narrowed binding used to be a bare alias and why the
# spec's "close early by narrowing the scope" could not work: nothing ever gave the origin
# handle up, so `senders` never reached zero on its own and every stream needed a statement
# to end it. With both halves the counts move only where a handle moves, and every handle
# has exactly one owner.
fn c_let_chan(mut &em: Emitter, name: str, eff: ast.Ty, is_mut: bool, is_const: bool, ival: ast.Expr, ind: str) -> str {
	em.used_rt = true
	em.used_conc = true
	dir := c_chan_dir(eff)
	mut val := c_expr(em, ival, c_nosub())
	if c_is_lvalue(ival) {
		val = f"{c_chan_copy_fn(dir)}({val})"
	}
	c_add_var(em, name, eff, is_mut, is_const)
	cn := c_var_cname(em, name)
	give := c_pend_release(em, cn, c_chan_defer_thunk(dir), ind)
	return f"{ind}zrt_chan *{cn} = {val};\n" + give
}

# c_pend_drop registers a BINDING of an owning type, so that what it holds is given back
# when its scope ends. It is c_drop_fn asked at the one place that acts on the answer, and
# it is what a struct binding and a by-value parameter both go through — "does this type own
# anything" is answered once, in c_drop_fn, rather than once per kind of binding. It is also
# the parameter side of the rule c_needs_copy states for the call side, and the two have to
# agree: a parameter is released here exactly when the call copied it there, or the callee
# gives back a reference the caller never handed over.
#
# A CHANNEL is deliberately not one of these. Passing a handle moves no count
# (docs/code/coroutine.md, pinned by conc_chan_dir), so a channel parameter is a borrow —
# which is why c_arg does not copy one either — and a channel BINDING has a release with a
# direction in it, which c_let_chan registers itself. The temporary a borrow leaves behind
# is the caller's problem, and is where c_owned_args comes in.
fn c_pend_drop(mut &em: Emitter, t: ast.Ty, cname: str, ind: str) -> str {
	th := c_drop_thunk(em, t)
	return "" if th == ""

	return c_pend_release(em, cname, th, ind)
}

# c_pend_release records that `cname` owns something `relfn` gives back, until its scope
# ends. It is the ONE way onto the pending-release list, so a type that starts owning its
# storage joins by calling this and needs no exit path of its own.
fn c_pend_release(mut &em: Emitter, local: str, thunk: str, ind: str) -> str {
	em.used_rt = true
	em.rel_cnames.append(local)
	em.rel_fns.append(thunk)
	return f"{ind}zrt_defer({thunk}, &{local});\n"
}

# c_drop_thunk is the `void (*)(void *)` a value of this type is given back through — the
# shape zrt_defer takes, which no release has: some take an address and some the value.
#
# Every one of them already exists, because a list ELEMENT vtable needs exactly this
# signature: `zg_elemdrop_<kind>` is emitted in the prelude for list, map and str, and
# beside the generated drop for a struct. So this is not a fourth dispatch — it is
# c_elem_kind, the one that exists so the decision is not written out twice, plus a prefix.
# It was a longhand copy, and the copy is how a kind gets added to one and not the other.
#
# A TUPLE used to be the exception — an element vtable under a naming scheme of its own and
# no drop thunk in it — so this had to name the exception too. It has the same trio under
# the same names as every other kind now, and the exception is gone from all three.
fn c_drop_thunk(mut &em: Emitter, t: ast.Ty) -> str {
	k := c_elem_kind(em, t)

	return "" if k == ""

	return "zg_elemdrop_" + k
}

# c_scope_forget drops the pending-release ENTRIES for a scope that has ended. Nothing is
# rendered here, and that is the whole of this design: a release is registered on the
# runtime's cleanup stack where it is declared (c_pend_release), and every exit gives it
# back by unwinding to a mark rather than by naming it again.
#
# Releases used to be EMITTED at each exit instead, with the argument that deferring one
# would hand the runtime the address of a C local whose block may end before the cleanup
# stack is unwound. That is not what happens: zrt_unwind_abort runs zrt_unwind_to(h->mark)
# BEFORE the longjmp, so the frames are still live, and a block that registers anything
# takes a mark and unwinds at its own end — so a cleanup can never outlive the storage it
# names. What the emitted form cost was every release on a frame that ABORTS, which is the
# path `guard` catches and carries on from.
#
# The list is still kept, for one reason: it is how a block knows whether it registered
# anything at all, which is what decides whether it needs a mark.
fn c_scope_forget(mut &em: Emitter, keep: int) {
	em.rel_cnames = c_strs_take(em.rel_cnames, keep)
	em.rel_fns = c_strs_take(em.rel_fns, keep)
}

# c_ints_drop_last removes the last element IN PLACE. Taking the list by value and
# answering a fresh one would copy the stack twice to lose one element, on every block.
fn c_strs_drop_last(mut &xs: list[str]) {
	mut out: list[str] = []
	mut i := 0
	for i < xs.len() - 1 {
		out.append(xs[i])
		i = i + 1
	}
	xs = out
}

fn c_ints_drop_last(mut &xs: list[int]) {
	mut out: list[int] = []
	mut i := 0
	for i < xs.len() - 1 {
		out.append(xs[i])
		i = i + 1
	}
	xs = out
}

fn c_strs_take(xs: list[str], n: int) -> list[str] {
	mut out: list[str] = []
	mut i := 0
	for i < n {
		out.append(xs[i])
		i = i + 1
	}
	return out
}

# c_let_str declares a STR binding, which owns a reference to its cell and gives it back at
# scope exit — the two halves c_let_chan states for a handle and c_let_list for a buffer. An
# initializer that NAMES storage is somebody else's cell, so this binding takes a reference
# of its own (c_copied, which for a str is zrt_str_retain); a freshly produced one — a
# concat, an f-string, a `str(bytes)`, a call's result — already carries exactly one and
# this binding takes it over. A literal's cell is immortal, so both halves are no-ops on it.
fn c_let_str(mut &em: Emitter, name: str, eff: ast.Ty, is_mut: bool, is_const: bool, ival: ast.Expr, ind: str) -> str {
	em.used_rt = true
	val := c_copied(em, eff, ival, c_nosub())
	c_add_var(em, name, eff, is_mut, is_const)
	cn := c_var_cname(em, name)
	give := c_pend_drop(em, eff, cn, ind)
	return f"{ind}const char* {cn} = {val};\n" + give
}

# c_let_list declares a LIST binding: a list-literal initializer becomes an init plus a push
# per element, and any other initializer — a call, another list — is a plain copy. Either way
# it owns its buffer and gives it back at scope exit, exactly as a channel binding gives back
# its handle.
#
# A list is REFCOUNTED underneath (copy-on-write), which is what makes the drop safe at every
# site a list leaves this scope by: `return xs` copies, and so does pushing one into a
# channel, a struct field or a `spawn` capture. Each of those retains, so the holder dropped
# here is never the last one when somebody else is still reading.
fn c_let_list(mut &em: Emitter, name: str, eff: ast.Ty, is_mut: bool, is_const: bool, ival: ast.Expr, ind: str) -> str {
	em.used_rt = true

	# as in c_let: the initializer names what was in scope BEFORE this binding
	if c_is_listlit(ival) {
		et := c_type(c_list_elem(eff))
		vals := c_elem_exprs(em, ival, c_list_elem(eff))
		c_add_var(em, name, eff, is_mut, is_const)
		cname := c_var_cname(em, name)
		mut out := f"{ind}zrt_list {cname}; zrt_list_init(&{cname}, sizeof({et}), &{c_elem_vt(em, c_list_elem(eff))});\n"
		out = out + c_pend_drop(em, eff, cname, ind)

		# a FILL evaluates its value once (c_fill_pushes); `vals` above already holds the N
		# rendered copies for every other literal, and this is the one road where the count
		# and the value have to be taken apart again
		mut filled := ""
		match ival {
			Expr.EFill(v, _) => {
				if vals.len() > 1 {
					filled = c_fill_pushes(em, cname, et, c_list_elem(eff), vals[0], vals.len(), ind)
				}
			}
			_ => {
				nop
			}
		}
		return out + filled if filled != ""

		return out + c_pushes_strs(cname, et, vals, ind)
	}

	# Anything else — another list, a call's result — binds through the one copy rule, the
	# same one every other site uses.
	val := c_copied(em, eff, ival, c_nosub())
	c_add_var(em, name, eff, is_mut, is_const)
	cn := c_var_cname(em, name)
	give := c_pend_drop(em, eff, cn, ind)
	return f"{ind}zrt_list {cn} = {val};\n" + give
}

fn c_print(mut &em: Emitter, e: ast.Expr, ind: str) -> str {
	ty := c_infer(em, e)

	# An optional has no display of its own: it is a value that may not be there, and what
	# to show for the absent side is the program's decision. `print x ?? "…"` or `print x!`
	# says which one was meant; printing the carrier itself used to reach cc as an integer
	# cast of a struct.
	raise c_diag(em, rule.Rule.PrintOfOptional, f"`print` needs a value, and {ast.ty_name(ty)} may not have one — say which with `?? …` or `!`") if ast.ty_is_opt(ty)

	# A USER OVERRIDE WINS: a type that declares `display()` (or `debug`, its default —
	# docs/runtime/format.md) prints through it. The call answers a fresh owned cell, so
	# it is shown and released in one statement, the shape the owned-str arm below uses.
	# A mis-shaped override (the "" state) already earned its finding at the declaration;
	# an inert placeholder lets that finding print instead of a raise about a missing
	# rendering.
	if meth := c_render_override(em, ty) {
		return f"{ind}/* mis-shaped render override */\n" if meth == ""

		em.used_rt = true
		call := c_expr(em, ast.Expr.EMethod(e, meth, []), c_nosub())
		return f"{ind}{{ const char* zgt_ps = {call}; printf(\"%s\\n\", zgt_ps); zrt_str_release(zgt_ps); }}\n"
	}

	# A COMPOSITE has no rendering: the structural one is `Display`'s job and this compiler
	# generates none, so the arm below cast a struct, a list or a tuple to `long long` and
	# cc reported it against C nobody wrote. `print(a, b)` is the way into this that a
	# reader does not see coming — there is no two-argument `print`, so it builds a TUPLE
	# and prints that. c_display_check is the same refusal `str(…)` already makes.
	c_display_check(em, ty, "`print`")
	ex := c_expr(em, e, c_nosub())

	# A FRESH string is nobody's: `print f"{x}"` builds a cell, shows it, and had nothing
	# left anywhere to give it back. Printing is one statement, so the release goes straight
	# after the printf. A str that NAMES storage is somebody else's and is only borrowed
	# here, which is why this asks the expression and not the type.
	if c_is_str(ty) and c_owns_value(e) {
		em.used_rt = true
		return f"{ind}{{ const char* zgt_ps = {ex}; printf(\"%s\\n\", zgt_ps); zrt_str_release(zgt_ps); }}\n"
	}
	return match ty {
		Ty.TStr => f"{ind}printf(\"%s\\n\", {ex});\n"

		# an Err shows as what went wrong; the kind is there to be compared, not read out
		Ty.TErr   => f"{ind}printf(\"%s\\n\", ({ex}).msg);\n"
		Ty.TFloat => f"{ind}printf(\"%g\\n\", {ex});\n"
		Ty.TBool  => f"{ind}printf(\"%s\\n\", ({ex}) ? \"true\" : \"false\");\n"
		_         => f"{ind}{c_print_number(ty, ex)}\n"
	}
}

# c_print_number renders a NUMBER, and asks the scalar table which one it is rather than
# carrying a list of the types that are signed.
#
# The arm above was a `_` catch-all that cast everything left to `long long`, so a `uint`
# printed as a negative number while `str(u)` and `f"{u}"` — which both go through c_display,
# and c_display HAS a TUint arm — printed the value. Three spellings of "show me this", one
# disagreeing. A type with no scalar class at all still lands here, and the signed form is
# what the C cast reports against, rather than this pass guessing.
fn c_print_number(t: ast.Ty, ex: str) -> str {
	return f"printf(\"%llu\\n\", (unsigned long long)({ex}));" if c_scalar_class(t) == SC_UNSIGNED

	return f"printf(\"%lld\\n\", (long long)({ex}));"
}

fn c_return(mut &em: Emitter, has_val: bool, e: ast.Expr, ind: str) -> str {
	# the value is computed BEFORE the defers run, which is what makes `defer` unable to
	# change what is returned
	mut pre := ""

	# the value is computed BEFORE this, which is what makes `defer` unable to change what is
	# returned; c_needs_fn_unwind is what keeps a function that owns nothing from paying for
	# the machinery at all.
	if c_needs_fn_unwind(em) {
		em.fn_mark_used = true
		pre = f"{ind}zrt_unwind_to({em.fn_mark});\n"
	}

	# `return nil` is a RETURN WITH NO VALUE everywhere except where the declared result is
	# a carrier: `-> Result[nil]` wants a Left holding nil, and `-> int?` an absent one, so
	# the nil is a value there and has to travel the value path below.
	if has_val and c_is_nil_lit(e) and c_is_carrier(em.fn_ret) {
		nv := c_carrier_fit(em, CHK_ANSWER, em.fn_ret, e, c_nosub())
		return f"{pre}{ind}return {nv};\n"
	}
	if has_val and not c_is_nil_lit(e) {
		# the returned expression's type is wanted twice — once to check it against the
		# signature, and again on the two conditions that rarely coincide, a channel return
		# type and a defer to unwind past. chk_returned answers with what it inferred, so
		# the walk happens once rather than once per asker.
		et := check.chk_returned(em, e)
		ret_chan := ast.ty_is_chan(em.fn_ret)
		if ret_chan {
			c_chan_check(em, et, em.fn_ret, CHK_ANSWER)
		}

		# a carrier result FITS the value rather than rendering it: `Left(v)` and `Right(e)`
		# have no type of their own to render as, so the declared result is what decides what
		# they mean — and asking c_expr first would refuse them before that happened
		# c_fit_copied, not c_expr: the caller OWNS what it is handed. c_arg copies into a
		# call so that returning a by-value local needn't copy again — but a borrowed one is
		# not a local, and `fn leak(mut &xs: list[int]) -> list[int] { return xs }` handed
		# back a second name for the caller's own buffer. It is also the site that gives a
		# bare `return []` the declared element type; without it the list had elemsz 0 and
		# every later append memcpy'd nothing.
		mut v := ""
		if ret_chan {
			v = c_expr(em, e, c_nosub())
		} else {
			v = c_fit_copied(em, CHK_ANSWER, em.fn_ret, e, c_nosub())
		}

		# A channel travelling OUT is a handle the caller will own, so it carries a reference
		# of its own — taken by the RETURN TYPE's direction, which is what makes
		# `fn source() -> <-chan[int] { ch := chan[int](); spawn p(ch); return ch }` work:
		# the caller gets a receive-only holder, `ch`'s own send end goes with this scope, and
		# the producer is left as the last sender. Without the copy the release below would
		# take the count the caller is about to rely on.
		if ret_chan and c_is_lvalue(e) {
			em.used_conc = true
			v = f"{c_chan_copy_fn(c_chan_dir(em.fn_ret))}({v})"
		}
		return f"{ind}return {v};\n" if pre == ""

		# the temporary takes the DECLARED result type, not the expression's: a bare value
		# returned from `-> int?` is FITTED into the carrier by c_fit_copied above, so typing
		# the temporary from what was written declares an int64_t and assigns a carrier to it
		rt := c_type(em.fn_ret)
		return ind + "{ " + rt + " zgt_rv = " + v + ";\n" + pre + ind + "return zgt_rv; }\n"
	}

	# A VALUELESS RETURN FROM A FUNCTION THAT DECLARES A RESULT. `c_ret_type` gives such a
	# function a non-void C signature, so `return;` here emitted C that cc rejected — an
	# escape to the C compiler, which reports against generated source and a mangled name
	# (`non-void function 'zg_f' should return a value`) rather than against the program.
	#
	# It completes a rule that already existed one level up: c_fn refuses a body that FALLS
	# OFF THE END of a declared result, and an explicit `return` with nothing after it is
	# the same missing value written down — including `return if c`, GRAMMAR's bare early
	# exit, which is only ever legal where a bare `return` is. What is refused is exactly
	# what would have reached cc, because `c_is_nil_ty` is the predicate c_ret_type asks.
	raise c_diag(em, rule.Rule.ReturnWithoutValue, f"a `return` with no value, in a function declared to answer {ast.ty_name(em.fn_ret)} — every `return` in it has to carry one") if not c_is_nil_ty(em.fn_ret)

	return f"{pre}{ind}return;\n"
}

# Each branch is analysed from the SAME entry liveness and the two ends are joined, so a
# `del` on one arm leaves the name inconsistent rather than dead — and a use after the `if`
# gets the message that says so. With no `else`, the fall-through path is the entry state.
fn c_if(mut &em: Emitter, cond: ast.Expr, then_body: list[ast.Stmt], has_else: bool, else_body: list[ast.Stmt], ind: str) -> str {
	mut out := ind + "if " + c_cond(em, cond, "an `if`") + " {\n"
	entry := c_live_save(em)
	out = out + c_block(em, then_body, ind + "    ")
	then_end := c_live_save(em)
	c_live_restore(em, entry)
	out = out + ind + "}"
	if has_else {
		out = out + " else {\n" + c_block(em, else_body, ind + "    ") + ind + "}"
	}
	c_live_merge(em, then_end)
	return out + "\n"
}

# c_iflet lowers `if v := e { … } else { … }`: run the block only on a Left, with `v`
# holding what it carried. The whole thing is wrapped in a C block so the carrier temp is
# scoped to it and two of these in a row cannot collide.
#
# The binding's C name comes from c_add_var rather than being written down here, because
# an outer `v` may already be in scope and C has no shadowing inside a function.
fn c_iflet(mut &em: Emitter, name: str, value: ast.Expr, then_body: list[ast.Stmt], has_else: bool, else_body: list[ast.Stmt], ind: str) -> str {
	t := c_infer(em, value)
	raise c_diag(em, rule.Rule.NotYetIfBindOver, f"NotImplemented: `if {name} := …` over a {ast.ty_name(t)} — it binds the Left of a Result[T] or a T?") if not c_is_carrier(t)

	elem := c_carrier_elem(t)
	cn := c_carrier_of(em, t)
	tag := strconv.to_string(em.op_n, 10)
	em.op_n = em.op_n + 1
	tmp := "zgt_il" + tag

	# the initializer is rendered BEFORE the binding enters scope, as in c_let
	val := c_expr(em, value, c_nosub())
	outer_scope := c_scope_open(em)
	c_add_var(em, name, elem, false, false)

	cv := c_var_cname(em, name)
	in2 := ind + "    "
	in3 := in2 + "    "
	mut out := f"{ind}{{\n{in2}{cn} {tmp} = {val};\n"
	out = out + in2 + "if (" + c_res_is_left(tmp) + ") {\n"

	# THE BINDING OWNS WHAT c_res_taken COPIED OUT, and nothing gave it back. That is a
	# second leak on this statement, beside the carrier one: the payload is retained into
	# `cv` — which is what makes `if v := c { … }` safe to hold the value in — and the branch
	# then ended without a release, so a `chan[str]` leaked one reference per value bound
	# this way whether or not the carrier itself was named.
	#
	# It is safe ONLY because c_res_taken copies. An optimisation that dropped that retain
	# would turn this release into a use-after-free.
	#
	# The mark is taken here rather than left to c_block: `cv` is declared OUTSIDE the body,
	# so the body's own mark — which c_block places after this point — would not unwind it.
	keep := em.rel_cnames.len()
	give := c_pend_drop(em, elem, cv, in3)
	mut mark := ""
	if give != "" {
		mark = c_new_mark(em)
		em.used_rt = true
		out = out + in3 + f"size_t {mark} = zrt_scope_mark();\n"
	}
	out = out + in3 + c_type(elem) + " " + cv + " = " + c_res_taken(em, tmp, elem) + ";\n" + give

	# the payload has been copied out, so the carrier this statement materialised has nothing
	# left to say. Only one that names no storage is this statement's to give back, and only
	# the Left side has a payload — which is why the drop sits inside this branch.
	df := c_carrier_temp_drop(em, t, value)
	if df != "" {
		out = out + in3 + df + "(&" + tmp + ");\n"
	}
	entry := c_live_save(em)
	out = out + c_block(em, then_body, in3)
	then_end := c_live_save(em)
	c_live_restore(em, entry)
	if mark != "" {
		out = out + in3 + f"zrt_unwind_to({mark});\n"
	}
	c_scope_forget(em, keep)
	out = out + in2 + "}"

	# THE BINDING GOES OUT OF SCOPE HERE, BEFORE THE `else` — not after it. The scope is what
	# docs/code/control-flow.md means by "`x` is not in scope in the `else`, nor after the
	# `if`", and both halves of that sentence are the same removal: c_scope_close is what
	# takes the row out of c_in_scope's reach. Closing it after the else branch had been
	# rendered enforced only the second half — an `else` naming the binding resolved to the
	# then-branch's C local, which is declared inside the `if` body and does not exist there,
	# so the program escaped to cc as `use of undeclared identifier 'zg_x'` against generated
	# source nobody wrote (the outcome docs/conformance.md rules out outright), wearing the
	# `.zg` filename the `#line` directives put on it. With the close moved up, the `else` is
	# checked in the enclosing environment and an out-of-scope name reports E3069 with a place,
	# like any other undefined name — and an `else if` chain, which is an if-statement in the
	# else BODY, gets the same answer in its head and in every branch below it for free.
	c_scope_close(em, outer_scope)

	if has_else {
		out = out + " else {\n" + c_block(em, else_body, in2 + "    ") + in2 + "}"
	}
	c_live_merge(em, then_end)
	return out + "\n" + ind + "}\n"
}

fn c_for(mut &em: Emitter, has_cond: bool, cond: ast.Expr, body: list[ast.Stmt], ind: str) -> str {
	mut head := ind + "for (;;) {\n"
	if has_cond {
		head = ind + "while " + c_cond(em, cond, "a `for`") + " {\n"
	}
	return head + c_loop_block(em, body, ind + "    ") + ind + "}\n"
}

# LoopFrame is what a loop BODY owns of the emitter's cleanup state: the mark its jumps
# unwind to, the pending-release depth it started at, whether a jump actually named the
# mark, and whether the body scheduled a `defer`. A nested loop saves all four on the way in
# and puts them back on the way out, because each is an answer about ONE body.
#
# It is a struct rather than four locals per site because there are two sites, and two
# copies of an N-field save is the defect this very state was fixed for: c_loop_block saved
# three of these for as long as there were three, c_for_select saved none, and a jump out of
# a `for select` therefore read whatever the ENCLOSING loop had left. A fifth field is one
# edit here instead of a fresh chance for a site to remember four.
struct LoopFrame {
	pub mark: str
	pub keep: int
	pub used: bool
	pub deferred: bool
}

# c_loop_enter takes the mark the body's jumps will unwind to and answers what was there
# before. `keep` is read from the CURRENT release depth, which is this body's entry depth by
# definition, and the other two start clean because they are answers about this body: a
# defer in the enclosing function is that function's to unwind, and an inner loop must not
# go on making the outer loop's jumps pay for a record it already gave back.
fn c_loop_enter(mut &em: Emitter, mark: str) -> LoopFrame {
	saved := LoopFrame(em.loop_mark, em.loop_keep, em.loop_mark_used, em.loop_defer)
	em.loop_mark = mark
	em.loop_keep = em.rel_cnames.len()
	em.loop_mark_used = false
	em.loop_defer = false
	return saved
}

fn c_loop_leave(mut &em: Emitter, saved: LoopFrame) {
	em.loop_mark = saved.mark
	em.loop_keep = saved.keep
	em.loop_mark_used = saved.used
	em.loop_defer = saved.deferred
}

# c_loop_block emits a loop BODY. It exists for two things the C does not say: a loop may
# run zero times, so the body's end state joins with the entry state instead of replacing
# it — a name revoked inside a loop is INCONSISTENT after it, not dead — and this is where
# a `break` or a `continue` inside the body learns how much of the pending-release list is
# the body's own.
fn c_loop_block(mut &em: Emitter, body: list[ast.Stmt], ind: str) -> str {
	entry := c_live_save(em)

	# The loop BODY always takes a mark, unlike every other block, because a `break` or a
	# `continue` unwinds to it — and whether the body registers anything is not known when
	# the jump inside it is rendered. It is also the mark that keeps a loop from growing the
	# cleanup stack: an iteration gives back what it took before the next one starts.
	mark := c_new_mark(em)
	saved := c_loop_enter(em, mark)
	em.force_mark = mark
	out := c_block(em, body, ind)
	c_loop_leave(em, saved)
	c_live_merge(em, entry)
	return out
}

# c_raise lowers `raise e` to the runtime's abort path: it unwinds to the innermost
# handler, which is an enclosing `guard`'s catching frame when there is one and the
# program's reporting root when there is not. Before this existed, `raise` parsed as
# nothing at all: the error path fell off the end of the function and the caller carried
# on with whatever was in the return register.
# c_cond renders a condition for `if` / `while`. Most expressions already come back fully
# parenthesized, and wrapping those again produces `if ((a == b))` — which the C compiler
# warns about, 112 times in one build of this compiler. That noise is not free: it is what
# a real warning has to be spotted among, and one nearly was not.
#
# A GNU statement expression is the one rendering whose own parentheses do NOT satisfy
# `if`: `(({ … }))` is what compiles — the inner pair belongs to the statement expression,
# the outer to the `if` — and c_is_wrapped owns that fact, answering false for `({ … })`
# so this site (and any future borrower) wraps it without asking a second question. That
# one dropped pair is how every bool-valued form that lowers to a statement expression —
# `in` over a list or a map, `??` as a whole condition — escaped to cc from `if`, `for`,
# and the postfix conditionals, while the same forms compiled anywhere else an expression
# goes.
fn c_cond(mut &em: Emitter, x: ast.Expr, site: str) -> str {
	check.chk_condition(em, x, site)
	rendered := c_expr(em, x, c_nosub())
	return rendered if c_is_wrapped(rendered)
	return f"({rendered})"
}

# c_ternary lowers `a if c else b`. It is its own function only so the condition can be
# checked before it is rendered — a match arm has nowhere to put a statement.
fn c_ternary(mut &em: Emitter, cond: ast.Expr, then_e: ast.Expr, else_e: ast.Expr, sb: Subst) -> str {
	check.chk_condition(em, cond, "an `if` expression")
	check.chk_branch_types(em, then_e, else_e)
	return f"({c_expr(em, cond, sb)} ? {c_expr(em, then_e, sb)} : {c_expr(em, else_e, sb)})"
}

# c_is_stmt_expr reports whether rendered C opens as a GNU statement expression `({ … }`.
# The leading two characters are the whole test: every statement expression this emitter
# writes begins with the literal pair `({`, and no ordinary parenthesized rendering does —
# a `(` there is always followed by a value, a cast, or another `(`.
fn c_is_stmt_expr(s: str) -> bool {
	b := bytearray(s)
	return false if b.len() < 2
	return b[0] == b'(' and b[1] == b'{'
}

# c_is_wrapped reports whether s is enclosed by ONE pair of parentheses a caller may
# BORROW — its first character opening the pair its last character closes, rather than
# two adjacent groups like `(a) + (b)`.
#
# A GNU statement expression answers false even though its own pair encloses it: that
# pair belongs to the `({ … })` form itself — reusing it as, say, the parens an `if`
# requires spells `if ({ … })`, and a C parser reading if's condition meets `{` where an
# expression must start. Answering false HERE is what makes the next borrower safe by
# construction, instead of every caller asking a second question beside this one.
fn c_is_wrapped(s: str) -> bool {
	return false if c_is_stmt_expr(s)
	b := bytearray(s)
	return false if b.len() < 2 or b[0] != b'(' or b[b.len() - 1] != b')'
	mut depth := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'(' {
			depth = depth + 1
		}
		if b[i] == b')' {
			depth = depth - 1
			return false if depth == 0 and i < b.len() - 1
		}
		i = i + 1
	}
	return true
}

fn c_raise(mut &em: Emitter, x: ast.Expr, has_cause: bool, cause: ast.Expr, ind: str) -> str {
	em.used_rt = true

	# `raise ValueError("…")` already names an Err, and so does an Err VALUE — the `e` a
	# `Right(e)` handed over. Only a bare message needs one built around it; wrapping
	# either of the others would make an Err whose payload is an Err, and re-raising a
	# caught one is the whole point of being able to bind it.
	err := c_err_value(em, x)

	# `from cause` chains: the new Err records the cause as its `unwrap()`, so a `guard`
	# reads back the whole chain rather than only its last link. The runtime builds it from
	# a MESSAGE and a cause, so an Err-valued operand hands over its message.
	return f"{ind}zrt_raise_err(zrt_err_chain({err}, {c_err_cause(em, cause)}));\n" if has_cause
	return f"{ind}zrt_raise_err({err});\n"
}

# c_err_value renders an expression AS an Err: one that already is an Err passes through,
# and anything else — a bare message — has one built around it.
fn c_err_value(mut &em: Emitter, x: ast.Expr) -> str {
	return c_expr(em, x, c_nosub()) if c_is_err_ctor(em, x) or c_is_err_ty(c_infer(em, x))

	# AND OTHERWISE A MESSAGE, which the fallback below assumed rather than checked: it wraps
	# the operand in `zrt_err_new`, whose parameter is a `const char *`, so `raise 5` reached cc
	# as an incompatible-type argument and `raise P(1)` as a struct passed where a pointer goes.
	# The `from` side of the same statement has had this rule all along (c_err_cause) — one
	# statement, two operands, and only one of them was asked.
	t := c_infer(em, x)
	if not c_is_str(t) and not c_is_unknown(t) {
		# REPORTED rather than raised, so it carries the place: `raise` is a statement, so a
		# marker is set, and this is a statement about a program the language rejects rather
		# than a form the compiler has not built. Emission carries on and the C is discarded.
		check.chk_at(em, rule.Rule.RaiseCarriesErr, f"raise carries an `Err`, or a message to build one from — {ast.ty_name(t)} is neither; write `ValueError(…)`, or a `str`")
	}

	return f"zrt_err_new({c_expr(em, x, c_nosub())})"
}

# c_err_cause renders the `from` operand. A cause is an Err — that is what a cause chain is
# made of — and anything else is refused by name here rather than handed to the runtime as
# whatever C type it happened to be.
fn c_err_cause(mut &em: Emitter, cause: ast.Expr) -> str {
	raise c_diag(em, rule.Rule.FromCauseNotErr, f"a `from` cause is an `Err`, and {ast.ty_name(c_infer(em, cause))} is not one — bind the Err a `guard` gave back (`Right(e) => raise … from e`)") if not c_is_err_ctor(em, cause) and not c_is_err_ty(c_infer(em, cause))
	return c_expr(em, cause, c_nosub())
}

fn c_is_err_ctor(mut &em: Emitter, x: ast.Expr) -> bool {
	return match x {
		Expr.ECall(nm, _, _) => c_err_kind(nm) > 0
		_ => false
	}
}

# c_err_kind maps a built-in error name to the kind tag the runtime carries, or 0 for a
# name that is not one. The numbers are MIRRORED from the runtime's ZRT_ERR_* enum and
# from the seed's own table, so a `raise ValueError(…)` and a runtime abort that says
# "ValueError" reify to the same kind whichever compiler built the program.
# c_err_kinds is THE table of nameable error kinds, in kind order: the i-th name has kind
# i + 1, and kind 0 is the untyped Err a bare `raise` carries. Those numbers are the
# runtime's ABI (zergrt.h's zrt_err_kind), so the ORDER here is not free.
#
# One direction only: a NAME to its number, which is what a `raise ValueError(…)` needs.
# The way back — a number to the `Kind: ` prefix an abort line reports under — belongs to
# the runtime, which renders it in zrt_err_kindname; this file used to emit a second copy
# of the numbering into every program to do it, and a second copy is how a tenth kind
# arrives with half a mapping and loses its prefix silently.
#
# DeadlockError and SendOnClosedError are raised by the runtime, and StopIteration is the
# sentinel a clean channel close carries — a kind rather than a message, which is what lets a
# receiver tell an ordinary ending from a crash without matching on text.
#
# AssertionError is the last, and it is here for that same reason one step up: `zerg test`
# has to tell a claim that did not hold from a program that fell over, and a runner reading
# prose to do it would be reading a message as a protocol. `assert` (GRAMMAR#assert-stmt)
# raises this one and nothing else does.
fn c_err_kinds() -> list[str] {
	return [
		"ValueError",
		"OverflowError",
		"IOError",
		"EncodingError",
		"IndexError",
		"KeyError",
		"DeadlockError",
		"SendOnClosedError",
		"StopIteration",
		"DivideByZeroError",
		"AssertionError"
	]
}

fn c_err_kind(name: str) -> int {
	kinds := c_err_kinds()
	mut i := 0
	for i < kinds.len() {
		return i + 1 if kinds[i] == name
		i = i + 1
	}
	return 0
}

# c_err_constructible splits the table in the one place it is not symmetric: every kind can
# be NAMED on the right of `is`, but StopIteration cannot be CALLED. It is the sentinel a
# clean close carries, so a program able to build one could hand a consumer a crash wearing
# the marker for an ordinary ending — and `err is StopIteration` would answer yes. Testing
# by kind is only worth more than comparing the message because this asymmetry holds.
fn c_err_constructible(name: str) -> bool {
	return name != "StopIteration"
}

# c_scope_open starts a scope and answers the one to go back to. Every construct that
# BINDS A NAME opens one, not only `c_block`: a loop variable, an `if let` binding and a
# match arm's binds all belong to their own construct, and leaving them in the enclosing
# block made them outlive it — the same defect c_in_scope exists to fix, one construct
# over — and made a later `i := …` collide with a `for i in …` that had already ended.
fn c_scope_open(mut &em: Emitter) -> int {
	outer := em.scope_cur
	em.scope_n = em.scope_n + 1
	em.scope_cur = em.scope_n
	em.open_scopes.append(em.scope_cur)
	return outer
}

# c_scope_close ends the scope c_scope_open started, given what it answered.
fn c_scope_close(mut &em: Emitter, outer: int) {
	em.scope_cur = outer
	c_ints_drop_last(em.open_scopes)
}

# c_block renders a block, and gives back whatever the block took on: a mark on entry and
# an unwind at the end, which is the ONE exit every other one goes through as well — the
# runtime unwinds past this mark on an abort, a `return` unwinds past it to the function's,
# and a jump unwinds to the loop body's.
#
# The mark is emitted only where it is needed, and whether it is needed cannot be known
# until the body has been walked — a binding registers itself as it is declared. So the
# NAME is handed out first, the body is rendered into a string, and the declaration is
# prepended afterwards. A `defer` statement counts as needing one for the same reason a
# binding does: it puts a record on the same stack.
fn c_block(mut &em: Emitter, body: list[ast.Stmt], ind: str) -> str {
	keep := em.rel_cnames.len()

	# a fresh id, so a name bound here is a REDECLARATION only against the other bindings
	# of this same block — not against an outer one it shadows, and not against a sibling
	# block that happens to use the same name
	outer_scope := c_scope_open(em)

	forced := em.force_mark
	em.force_mark = ""

	mut out := ""
	mut i := 0
	for i < body.len() {
		out = out + c_stmt(em, body[i], ind)
		i = i + 1
	}

	c_scope_close(em, outer_scope)
	needs := c_has_defer(body) or em.rel_cnames.len() > keep or (forced != "" and em.loop_mark_used)
	c_scope_forget(em, keep)
	return out if not needs

	# the name is minted HERE and not before the walk, because most blocks never need one:
	# the counter bump and the concatenation were paid per block in the program to be thrown
	# away. A forced block was handed its name already — that one a jump inside it may name.
	mut mark := forced
	if mark == "" {
		mark = c_new_mark(em)
	}
	em.used_rt = true
	return f"{ind}size_t {mark} = zrt_scope_mark();\n" + out + f"{ind}zrt_unwind_to({mark});\n"
}

# --- declaration emission ------------------------------------------------------

fn c_ret_type(fn_d: ast.FnDecl) -> str {
	return c_type(fn_d.ret) if fn_d.has_ret and not c_is_nil_ty(fn_d.ret)
	return "void"
}

pub fn c_is_nil_ty(t: ast.Ty) -> bool {
	return match t {
		Ty.TNil  => true
		Ty.TVoid => true
		_        => false
	}
}

# c_holds_nil is whether nil sits ANYWHERE in a type, and it recurses because a container
# gives its elements storage exactly as a binding does: `list[nil]` is a C `void` element
# and `(nil, int)` a `void` field, both of which cc reported against a typedef nobody wrote.
# `xs := [f()]` and `t := (f(), 1)` are the two that get there.
#
# `T?` is NOT one of them, and that is the whole reason this is a recursion over containers
# rather than a walk over every variant: an optional is the type whose job is holding an
# absence, so `list[int?]` holds nil legitimately and `xs: list[int?] = [nil, 7]` is a
# program. A map is included for its VALUES and its keys alike, both being storage it spells.
pub fn c_holds_nil(t: ast.Ty) -> bool {
	return true if c_is_nil_ty(t)

	return match t {
		Ty.TList(e)   => c_holds_nil(e)
		Ty.TTuple(es) => c_holds_nil_any(es)
		Ty.TMap(k, v) => c_holds_nil(k) or c_holds_nil(v)
		_             => false
	}
}

fn c_holds_nil_any(ts: list[ast.Ty]) -> bool {
	for t in ts {
		return true if c_holds_nil(t)
	}
	return false
}

fn c_param_types(fn_d: ast.FnDecl) -> str {
	return "void" if fn_d.params.len() == 0
	mut out := ""
	mut i := 0
	for i < fn_d.params.len() {
		if i > 0 {
			out = out + ", "
		}
		pm := fn_d.params[i]
		mut ct := c_type(pm.ty)
		if pm.is_ref {
			ct = ct + "*"
		}
		out = out + ct
		i = i + 1
	}
	return out
}

fn c_proto(mut &em: Emitter, fn_d: ast.FnDecl) -> str {
	return f"{c_ret_type(fn_d)} {c_fn_cname_in(em, check.c_mod_of(em, fn_d.path), fn_d.recv, fn_d.name)}({c_param_types(fn_d)});\n"
}

# c_check_loop_jump refuses a `break` or a `continue` that belongs to no loop. Without it
# the jump lowered to a bare C `break;` and the first complaint came from cc, about a file
# under .zerg-cache the programmer never wrote — `'break' statement not in loop or switch
# statement`, at a line number in generated C. The seed has always named it at the source.
#
# A `select` arm is NOT a loop: it lowers to if/else, so an arm INHERITS whatever loop it
# is written in. That is what keeps the shape the concurrency chapter is written in legal —
# `for select { … <-quit => break }` — while the same arm outside a loop is refused.
#
# IT READS THE SAt MARKERS AS IT GOES, which is what lets the refusal point at the `break`
# rather than at the function holding it. This walk runs BEFORE the body is emitted, so
# `em.at_*` still holds whatever the previous declaration left there; marking here costs a
# match arm and the emission walk re-marks every statement it lowers anyway.
fn c_check_loop_jump(mut &em: Emitter, body: list[ast.Stmt], in_loop: bool) {
	for s in body {
		match s {
			Stmt.SAt(l, c) => c_mark(em, l, c)
			Stmt.SBreak => c_loop_jump_err(em, "break", in_loop)
			Stmt.SContinue => c_loop_jump_err(em, "continue", in_loop)
			Stmt.SIf(cond, then_b, has_else, else_b) => c_check_loop_jump_two(em, then_b, else_b, in_loop)
			Stmt.SIfLet(nm, v, then_b, has_else, else_b) => c_check_loop_jump_two(em, then_b, else_b, in_loop)
			Stmt.SFor(is_cond, cond, body_b) => c_check_loop_jump(em, body_b, true)
			Stmt.SForIn(nm, it, body_b) => c_check_loop_jump(em, body_b, true)
			Stmt.SSelect(arms) => c_check_loop_jump_sel(em, arms, in_loop)

			# A BARE BLOCK DOES NOT MAKE A LOOP, and without this arm the walk never looked
			# inside one — so `{ break }` written outside any `for` was emitted, and the
			# refusal a reader got was cc's: _'break' statement not in loop or switch
			# statement_, against generated code, about a rule this compiler has and did not
			# apply. `break` on its own at the same place has always been E4001.
			Stmt.SScope(body_b) => c_check_loop_jump(em, body_b, in_loop)
			_ => c_skip()
		}
	}
}

fn c_check_loop_jump_two(mut &em: Emitter, a: list[ast.Stmt], b: list[ast.Stmt], in_loop: bool) {
	c_check_loop_jump(em, a, in_loop)
	c_check_loop_jump(em, b, in_loop)
}

fn c_check_loop_jump_sel(mut &em: Emitter, arms: list[ast.SelArm], in_loop: bool) {
	for a in arms {
		c_check_loop_jump(em, a.body, in_loop)
	}
}

fn c_loop_jump_err(mut &em: Emitter, kw: str, in_loop: bool) {
	return if in_loop
	raise c_diag(em, rule.Rule.LoopKeywordOutsideLoop, f"`{kw}` outside of a loop: it belongs to a `for`, and a `select` arm is not one — it inherits the loop it is written in")
}

fn c_fn(mut &em: Emitter, fn_d: ast.FnDecl) -> str {
	# the whole declaration's place, not just its path: a finding about a PARAMETER — a
	# `const`'s name taken by one, say — is made before any statement of the body is
	# emitted, so the SAt markers have said nothing yet and `em.at_*` still holds the
	# previous function's last statement
	em.at_path = fn_d.path
	em.at_line = fn_d.line
	em.at_col = fn_d.col

	# THE ENCLOSING FUNCTION'S BOOKS, saved BEFORE the reset wipes them. A lambda re-enters
	# c_fn in the middle of the function being emitted — after its `return` has already
	# rendered `zrt_unwind_to(fn_mark)` and set fn_mark_used — and c_reset_env clears that
	# flag, so reading it after the reset saved `false` whatever it was. The function then
	# never declared the mark its own return names, and cc reported the undeclared
	# identifier. The loop fields are the same books kept for a jump: a lambda written
	# between a binding and a `break` cleared loop_mark, and the break silently skipped the
	# unwind it owed.
	outer_fn_mark := em.fn_mark
	outer_used := em.fn_mark_used
	outer_loop_mark := em.loop_mark
	outer_loop_keep := em.loop_keep
	outer_loop_used := em.loop_mark_used
	outer_loop_defer := em.loop_defer
	c_reset_env(em)

	# and PUT THE DECLARATION'S PLACE BACK, because the pre-pass moves the marker: it walks
	# the body's SAt markers so its own refusal points at the `break` rather than at the
	# function, and what the paragraph above wants at this point is the declaration.
	c_check_loop_jump(em, fn_d.body, false)
	c_mark(em, fn_d.line, fn_d.col)

	# a lambda is emitted through here in the middle of an enclosing function's expression,
	# so the enclosing return type is put back on the way out
	saved_ret := em.fn_ret
	em.fn_ret = fn_d.ret

	# and so is the trust context, for the same reason and with the same care: a lambda
	# written inside an unsafe fn is unsafe code too, so it inherits the flag rather than
	# resetting it, and the enclosing function gets its own back below.
	saved_unsafe := em.in_unsafe_fn
	em.in_unsafe_fn = fn_d.in_unsafe

	# the parameters bind in a scope between the module and the body, so a parameter may
	# shadow a PLAIN module binding and the body may shadow a parameter — `mut n := n`.
	# A keyword `const` is the exception: it is shadow-proof everywhere, and c_add_var
	# refuses a parameter that takes its name like any other binding.
	c_scope_open(em)

	# The FUNCTION's own mark, and the parameters registered against it. A parameter lives
	# for the whole call, so it belongs above the body block's mark rather than in it — and a
	# `return` from anywhere inside unwinds to this one, which gives back everything the body
	# took as well. The name is handed out before the body is walked because c_return needs
	# it; whether it is DECLARED is answered after, by whether anything used it.
	fmark := c_new_mark(em)
	em.fn_mark = fmark
	em.fn_mark_used = false
	mut pdefer := ""

	mut sig := f"{c_ret_type(fn_d)} {c_fn_cname_in(em, check.c_mod_of(em, fn_d.path), fn_d.recv, fn_d.name)}("
	if fn_d.params.len() == 0 {
		sig = sig + "void"
	} else {
		mut i := 0
		for i < fn_d.params.len() {
			if i > 0 {
				sig = sig + ", "
			}
			pm := fn_d.params[i]
			c_add_var(em, pm.name, pm.ty, pm.is_ref, false)

			# A BY-VALUE PARAMETER IS THIS FUNCTION'S OWN. Every call site copies what it
			# hands over (c_arg, through c_copied) — for a str that copy is a retain, for a
			# list or a map a copy-on-write handle — so the callee holds a reference of its
			# own and owes it back, exactly as a binding made in the body does. A `mut &`
			# parameter is the CALLER's storage handed over to be written, and owns nothing.
			#
			# A `spawn`/`defer` env is the same rule read from the other side: the env field
			# is handed over WITHOUT a further copy, because the env is giving up its own
			# reference — so the callee dropping it is what frees the capture, and the two
			# together are why a captured list is not leaked by either.
			if not pm.is_ref {
				pdefer = pdefer + c_pend_drop(em, pm.ty, "zg_" + pm.name, "    ")
			}
			if pm.is_ref {
				em.ref_names.append(pm.name)
				sig = sig + c_type(pm.ty) + "* zg_" + pm.name
			} else {
				sig = sig + c_type(pm.ty) + " zg_" + pm.name
			}
			i = i + 1
		}
	}
	sig = sig + ") {\n"

	# A BLOCK'S VALUE IS ITS LAST STATEMENT'S (GRAMMAR#block), and a function
	# body is a block. Written without a `return`, the value used to be computed and thrown
	# away: `fn(a: int) -> int { a + 5 }` emitted `(zgt_a + 5);` and then fell off the end of
	# a non-void C function, so the call answered whatever was in the return register.
	#
	# Only a trailing EXPRESSION statement is a value. A body ending in anything else while
	# declaring a result is a missing return, and is refused below rather than given one.
	mut body := fn_d.body
	if fn_d.has_ret {
		last := body.len() - 1
		if body.len() == 0 or not c_stmt_diverges(body[last]) {
			raise c_diag(em, rule.Rule.FallsOffTheEnd, f"`{fn_d.name}` is declared to answer {ast.ty_name(fn_d.ret)}, and its body falls off the end — a block's value is its last statement's, so end it with a `return` or with the expression it answers") if body.len() == 0 or not c_is_expr_stmt(body[last])

			body[last] = ast.Stmt.SReturn(true, c_expr_stmt_of(body[last]))
		}
	}

	rendered := c_block(em, body, "    ")

	# Falling off the end is the one exit that renders nothing of its own, so it is the one
	# that needs the unwind written out — but only when a parameter put something on the
	# stack, since the body block has already unwound its own.
	mut tail := ""
	if pdefer != "" and not c_body_diverges(body) {
		tail = f"    zrt_unwind_to({fmark});\n"
	}
	mut head := ""
	if pdefer != "" or em.fn_mark_used {
		em.used_rt = true
		head = f"    size_t {fmark} = zrt_scope_mark();\n"
	}
	c_scope_forget(em, 0)
	em.fn_mark = outer_fn_mark
	em.fn_mark_used = outer_used
	em.loop_mark = outer_loop_mark
	em.loop_keep = outer_loop_keep
	em.loop_mark_used = outer_loop_used
	em.loop_defer = outer_loop_defer
	out := sig + head + pdefer + rendered + tail + "}\n\n"
	em.fn_ret = saved_ret
	em.in_unsafe_fn = saved_unsafe
	return out
}

# c_body_diverges reports whether a body's last statement leaves the function — a `return`
# (unconditional), a `raise`, or an `if` whose branches all do. It is what decides whether a
# declared result still needs one.
fn c_body_diverges(body: list[ast.Stmt]) -> bool {
	return false if body.len() == 0
	return c_stmt_diverges(body[body.len() - 1])
}

fn c_stmt_diverges(s: ast.Stmt) -> bool {
	return match s {
		Stmt.SReturn(_, _)          => true
		Stmt.SRaise(_, _, _)        => true
		Stmt.SIf(_, t, has_else, e) => has_else and c_body_diverges(t) and c_body_diverges(e)

		# a bare block diverges when its body does, and nothing else about it matters here.
		# Without this arm `fn f() -> int { { return 3 } }` was _E4023 its body falls off the
		# end_ — a function whose only exit is a `return`, told it has none.
		Stmt.SScope(b) => c_body_diverges(b)
		_ => false
	}
}

# The entry point is the FREE function `main`; a method named `main` is an ordinary method
# of its type and must not be mistaken for it, which is what the receiver test rules out.
# c_has_main reports whether a File declares the program entry. It is `pub` because the
# DRIVER asks the same question to choose what to build — a source is a module until
# something asks it to be a program — and two answers to "is this a program" would let the
# driver emit a library while the emitter writes a main wrapper.
pub fn c_has_main(f: ast.File) -> bool {
	mut i := 0
	for i < f.fns.len() {
		return true if f.fns[i].name == "main" and f.fns[i].recv == ""
		i = i + 1
	}
	return false
}

# c_main_ret is the entry point's declared result type — TNil both when it declares none
# and when it spells `-> nil`, because the two mean the same entry shape. c_main_entry
# reads every entry-shape question off this one answer: `int` (the exit status) as
# `c_is_int`, `Result[nil]` as `c_is_result_nil`.
fn c_main_ret(f: ast.File) -> ast.Ty {
	mut i := 0
	for i < f.fns.len() {
		fn_i := f.fns[i]
		if fn_i.name == "main" and fn_i.recv == "" {
			return fn_i.ret if fn_i.has_ret
			return ast.Ty.TNil
		}
		i = i + 1
	}
	return ast.Ty.TNil
}

# c_is_result_nil is the `Result[nil]` entry shape — a Result whose element is nil, which
# is what parse_type builds for the spelling. It asks c_is_result rather than respelling
# its conjunction, so "an Either whose Right is `Err`" stays one fact in one place.
fn c_is_result_nil(t: ast.Ty) -> bool {
	return c_is_result(t) and c_is_nil_ty(c_result_elem(t))
}

# c_main_params_check is the ENTRY'S INPUT SHAPE, and it is the other half of the result
# check in c_main_entry.
#
# `main`'s parameter is the command-line arguments and there is nothing else it could be
# (docs/runtime/package.md): the runtime builds a `list[str]` and hands it over. Nothing
# asked what the DECLARATION wanted — `c_main_has_args` answers a count, not a shape — so
# four bad shapes were emitted anyway and the C compiler reported the mismatch against
# generated code nobody wrote: an `int` parameter, a `str` one, a second parameter, and a
# `mut &`.
#
# THE FIFTH WAS WORSE. `fn main(args: list[int])` matched by shape at the C level, compiled,
# ran, and read the argv pointers back as integers — a program printing `4308198304` for its
# first argument. A cc error is a bad diagnostic; that one is a wrong answer with nothing
# said, which is the thing this compiler's contract has no room for at all.
#
# It is a REJECTION and not a `NotImplemented`: the language has one entry input, so a
# different one is not a form waiting to be built. The rule never retires.
fn c_main_params_check(mut &em: Emitter, f: ast.File) {
	mut i := 0
	for i < f.fns.len() {
		if f.fns[i].name == "main" and f.fns[i].recv == "" {
			c_main_params_says(em, f.fns[i])
			return
		}
		i = i + 1
	}
}

# c_main_params_says is the finding, worded for the shape that reached it. THREE SENTENCES
# AND ONE RAISE: what differs is which half of the declaration is wrong, and
# `error-codes-check` holds a code to a single reporting site — a rule with two `raise`s is
# two rules wearing one identity.
fn c_main_params_says(mut &em: Emitter, fn_d: ast.FnDecl) {
	return if fn_d.params.len() == 0

	shape := "the entry takes either nothing or the command-line arguments, `fn main(args: list[str])` (docs/runtime/package.md)"
	mut why := ""
	if fn_d.params.len() > 1 {
		why = f"`fn main` takes {strconv.to_string(fn_d.params.len(), 10)} parameters, and {shape}"
	} else if fn_d.params[0].is_ref {
		why = f"`fn main` borrows `{fn_d.params[0].name}` with `mut &`, and the argument list is the runtime's, handed over by value — {shape}"
	} else if not c_is_list(fn_d.params[0].ty) or not c_is_str(c_list_elem(fn_d.params[0].ty)) {
		why = f"`fn main` takes `{fn_d.params[0].name}: {ast.ty_name(fn_d.params[0].ty)}`, and {shape}"
	}
	return if why == ""

	raise c_diag_at(fn_d.path, fn_d.line, fn_d.col, rule.Rule.MainParamNotArgs, why)
}

fn c_main_has_args(f: ast.File) -> bool {
	mut i := 0
	for i < f.fns.len() {
		return true if f.fns[i].name == "main" and f.fns[i].recv == "" and f.fns[i].params.len() > 0
		i = i + 1
	}
	return false
}

# merge_files parses several sources (a flattened module and its imported modules) and
# returns them as one File, declarations in source order. The whole-program view every
# pass wants: the emitter lowers it, the linter walks it.
pub fn merge_files(srcs: list[str]) -> ast.File {
	mut none: list[str] = []
	return merge_files_at(srcs, none)
}

# merge_files_at is merge_files with each source's PATH beside it, so every function it
# declares remembers the file it was written in. A whole program is one File by the time
# anything is emitted, and a diagnostic that cannot name the file is half an address; a
# short `paths` list simply leaves the rest unnamed rather than being an error.
pub fn merge_files_at(srcs: list[str], paths: list[str]) -> ast.File {
	mut fs: list[ast.File] = []
	mut i := 0
	for i < srcs.len() {
		mut path := ""
		if i < paths.len() {
			path = paths[i]
		}
		fs.append(parser.parse_at(srcs[i], path))
		i = i + 1
	}
	return merge_asts(fs)
}

# emit_files_diag is emit_files_at that also reports what it found.
pub fn emit_files_diag(srcs: list[str], paths: list[str], ms: Mods, mut &diags: list[ast.Diag]) -> str {
	return c_emit_file_at(merge_files_at(srcs, paths), ms, diags)
}

# check_files_diag answers "is this a program" WITHOUT answering "what C does it become".
#
# It is the same walk emit_files_diag runs, with the one difference the name says: the C
# each step produced is dropped instead of accumulated (c_lowered, and c_emit_unit's
# `check` parameter). Every rule still runs, in the same order, over the same tables, so
# the findings are the same findings — which is the property that matters here, because a
# second checker that missed one would paint a clean buffer for a file that will not build.
# scripts/check-equal.sh is what holds the two to each other.
#
# WHY IT IS WORTH HAVING is measurement, not tidiness. On this compiler's own 27k lines the
# emit path peaks at 2.8 GB and the check path at 0.22 GB, because `defs = defs + c_fn(…)`
# over ~1500 functions allocates a fresh copy of everything emitted so far on each step —
# the finished C is 3.6 MB and the walk that builds it touches a thousand times that. The
# language server asks this question on every keystroke-batch, and it was being SIGKILLed
# for asking it three times.
pub fn check_files_diag(srcs: list[str], paths: list[str], ms: Mods, mut &diags: list[ast.Diag]) {
	mut lints: list[ast.Diag] = []
	f := merge_files_at(srcs, paths)
	c_emit_unit(f, f, ms, true, false, true, diags, lints)
}

# emit_unit_at is emit_unit that also reports what it found. A build refuses to hand the
# C to cc when this list comes back non-empty.
pub fn emit_unit_at(prog: ast.File, own: ast.File, ms: Mods, mut &diags: list[ast.Diag]) -> str {
	mut lints: list[ast.Diag] = []
	return c_emit_unit(prog, own, ms, false, false, false, diags, lints)
}

# lint_conversions is the L5xx family, and it is the one lint that cannot be answered from
# the parsed tree: a conversion is a fact about TYPES. So the linter asks the lowering walk,
# which has them — and what is kept is what the walk noticed on the way past. A program that
# does not compile answers nothing, which is right: there is no point advising about the
# types of a program whose types are wrong.
#
# It walks in CHECK mode. The C was always thrown away here — that is what this comment used
# to say — and building it first cost the caller a gigabyte for a string nobody read.
pub fn lint_conversions(srcs: list[str], paths: list[str], ms: Mods) -> list[ast.Diag] {
	mut diags: list[ast.Diag] = []
	mut lints: list[ast.Diag] = []

	# MERGED ONCE and handed over twice. emit_unit's own comment records that re-parsing the
	# whole program per unit "is where its time went", and two calls in one argument list is
	# that mistake at its smallest.
	f := merge_files_at(srcs, paths)
	c_emit_unit(f, f, ms, true, true, true, diags, lints)

	return [] if diags.len() > 0

	return lints
}

# merge_asts joins already-parsed files into the whole-program view, in order.
pub fn merge_asts(fs: list[ast.File]) -> ast.File {
	mut imports: list[ast.ImportDecl] = []
	mut structs: list[ast.StructDecl] = []
	mut enums: list[ast.EnumDecl] = []
	mut specs: list[ast.SpecDecl] = []
	mut impls: list[ast.ImplDecl] = []
	mut fns: list[ast.FnDecl] = []
	mut consts: list[ast.ConstDecl] = []
	mut types: list[ast.TypeDecl] = []
	mut derive_on: list[str] = []
	mut derive_spec: list[str] = []
	mut stmts: list[ast.TopStmt] = []
	mut ty_quals: list[ast.TyQual] = []
	for f in fs {
		for q in f.ty_quals {
			ty_quals.append(q)
		}
		for c in f.consts {
			consts.append(c)
		}
		for s in f.stmts {
			stmts.append(s)
		}
		for im in f.imports {
			imports.append(im)
		}
		for s in f.structs {
			structs.append(s)
		}
		for e in f.enums {
			enums.append(e)
		}
		for sp in f.specs {
			specs.append(sp)
		}
		for ip in f.impls {
			impls.append(ip)
		}
		for fnd in f.fns {
			fns.append(fnd)
		}
		for td in f.types {
			types.append(td)
		}

		# the two derive lists are PARALLEL, so they are appended together — walking one and
		# indexing the other would be a second place their lengths have to agree
		mut i := 0
		for i < f.derive_on.len() {
			derive_on.append(f.derive_on[i])
			derive_spec.append(f.derive_spec[i])
			i = i + 1
		}
	}
	return ast.File(imports, structs, enums, specs, impls, fns, types, consts, derive_on, derive_spec, stmts, ty_quals)
}

fn c_emit_file_at(f: ast.File, ms: Mods, mut &diags: list[ast.Diag]) -> str {
	mut lints: list[ast.Diag] = []
	return c_emit_unit(f, f, ms, true, false, false, diags, lints)
}

# c_emit_unit lowers ONE compilation unit. `prog` is the whole program — every type and
# every signature, so a body can be typed and every call has a prototype — while `own` is
# the module whose function bodies this unit actually defines. Passing the same File as
# both is the whole-program build; passing a module as `own` is separate compilation, and
# the difference is the only thing that keeps two objects from defining the same symbol.
# c_emit_unit lowers a unit and REPORTS what it found: `diags` collects every ill-formed
# program finding, so a caller can refuse the whole build rather than hand cc a C file
# built out of a program that does not typecheck. It is an out-parameter rather than a
# second return value because the C is what every caller wants and the findings are what
# only the driver does.
# ZG_BUILTIN_SPECS are the specs the LANGUAGE declares, as source. `Into` is one: every
# program may write `impl Into[T] for S`, and none of them should have to copy the
# declaration in first.
#
# It is a SOURCE STRING that gets parsed rather than a SpecDecl built by hand, and that is the
# point of doing it this way — a hand-built one is a second spelling of what the parser
# produces, and the two drift the day a spec grows a field. Three lines through the real
# parser cannot disagree with the real parser.
const ZG_BUILTIN_SPECS := "spec Into[T] {\n\tfn into() -> T\n}\n\nspec Eq {\n\tfn eq(o: This) -> bool\n\tfn ne(o: This) -> bool\n}\n"

# c_with_builtin_specs adds them to a program that does not declare them itself. A program IS
# allowed to declare its own `Into` or `Eq` — the check is by name, so a spec by that name
# wins and nothing is injected on top of it.
pub fn c_with_builtin_specs(prog: ast.File) -> ast.File {
	# the parse is BOUND before it is walked: `for s in parse_at(…).specs` takes the address of
	# an rvalue, which the seed lowers to C that cc refuses
	bi := parser.parse_at(ZG_BUILTIN_SPECS, "<builtin>")

	mut out := prog
	for s in bi.specs {
		if not c_declares_spec(prog, s.name) {
			out.specs.append(s)
		}
	}
	return out
}

# c_declares_spec is whether the program already has a spec by this name. It is asked PER
# BUILTIN rather than once for the whole set: a program declaring its own `Into` used to
# suppress `Eq` as well, which is a rule about one name reaching a name it never mentioned.
fn c_declares_spec(prog: ast.File, name: str) -> bool {
	for s in prog.specs {
		return true if s.name == name
	}
	return false
}

# --- structural derive (docs/core/derive.md) ----------------------------------------------
#
# `#[derive(X)]` asks the COMPILER to write the canonical `(T, X)` impl by reading T's
# structure. It is a compiler privilege and not sugar for an empty impl: a spec is
# field-blind, so no spec could write this body.
#
# It is generated AS SOURCE and handed to the real parser, for the same reason the builtin
# specs are: an impl built out of AST nodes here would be a second spelling of what
# `impl Eq for P { … }` already parses to, and the two drift the day either side grows a
# field. What comes back is an ordinary ImplDecl, so it registers in the method namespace,
# meets the duplicate-impl check, and emits — with nothing downstream knowing it was derived.

# c_with_derived expands every `#[derive(…)]` into the impl it stands for.
pub fn c_with_derived(prog: ast.File) -> ast.File {
	mut out := prog
	mut i := 0
	for i < prog.derive_on.len() {
		src := c_derive_src(prog, prog.derive_on[i], prog.derive_spec[i])
		gen := parser.parse_at(src, "<derive>")
		for ip in gen.impls {
			out.impls.append(ip)
		}
		for fnd in gen.fns {
			out.fns.append(fnd)
		}

		# AND THE TYPES IT DECLARES. A derived impl declares none, so this list was the two
		# above for as long as `derive` was the only decorator — and `#[obj]`'s expansion is
		# a STRUCT and a function, so the struct went missing and its own wrap function came
		# back with a return type nothing declared.
		for sd in gen.structs {
			out.structs.append(sd)
		}
		i = i + 1
	}
	return out
}

# c_derive_src writes the impl for one `(type, spec)` pair. Only the BLESSED set may be
# named — the derivable set is compiler-owned and a user spec in a `#[derive(…)]` is an
# error, because generating an impl from structure needs code that reads structure, and
# nothing user-authored may.
fn c_derive_src(prog: ast.File, target: str, nm: str) -> str {
	return c_obj_src(prog, target) if nm == "#obj"

	raise c_derive_diag(prog, target, rule.Rule.NotYetDerive, f"NotImplemented: `#[derive({nm})]` — this compiler derives `Eq`; `Ord`, `Hash`, `Encode` and `Decode` are specified and unbuilt") if nm == "Ord" or nm == "Hash" or nm == "Encode" or nm == "Decode"
	return c_derive_eq(prog, target) if nm == "Eq"

	# A `spec` YOU WROTE, on an ENUM. The two halves of `derive` answer to different rules
	# and the difference is where the generated code comes from: on a struct it is read out
	# of the type's STRUCTURE, which only compiler-owned code may do, so that half stays a
	# closed set. On an enum it is DELEGATION — each arm hands the call to the payload,
	# which already implements the spec — and that rewrite is mechanical for any spec at all.
	#
	# It is also the rewrite a person would otherwise write by hand and have to extend every
	# time a variant is added. Deriving it means a new variant regenerates the delegation.
	return c_derive_delegate(prog, target, nm) if c_derive_enum_at(prog, target) >= 0 and c_derive_spec_at(prog, nm) >= 0

	raise c_derive_diag(prog, target, rule.Rule.DeriveNotCompilerOwned, f"cannot derive `{nm}`: on a struct the derivable specs are compiler-owned, and a `spec` you write is never one of them; on an enum a spec is derived by DELEGATION, and either `{target}` is not an enum or `{nm}` is not a spec this program declares — write `impl {nm} for {target}` instead")
}

# c_obj_src writes what `#[obj]` on a spec stands for: a companion STRUCT OF FUNCTION
# VALUES, one field per method, and a generic function that wraps any implementer into one.
#
#     #[obj]
#     spec Draw { fn draw() -> str }
#
#     struct DrawObj { draw: fn () -> str }
#     fn draw_obj[T: Draw](v: T) -> DrawObj {
#         return DrawObj(fn () -> str { return v.draw() })
#     }
#
# THE OPENNESS COMES FROM THE WRAP POINT, not from anything at run time: `draw_obj` is
# monomorphized per implementer, and what comes back has one type. A `list[DrawObj]` is
# therefore a heterogeneous collection with no vtable, no header on any value and no
# downcast — which is the trade the whole design is: you may call what the spec declares,
# and you may not ask what is inside.
#
# It could not be written before closures captured, because every field is a closure over
# the wrapped value. That is also why the refusals below are what they are.
fn c_obj_src(prog: ast.File, target: str) -> str {
	at := c_derive_spec_at(prog, target)
	raise c_derive_diag(prog, target, rule.Rule.ObjNotOnSpec, f"`#[obj]` goes on a `spec`, and `{target}` is not one — an object is a spec's methods held as values, so there has to be a spec saying which") if at < 0

	sp := prog.specs[at]
	obj := f"{target}Obj"

	mut fields := ""
	mut inits := ""
	for req in sp.reqs {
		# a `mut fn` is the receiver taken by reference, which the parser records as the
		# `this` parameter's own marker
		raise c_derive_diag(prog, target, rule.Rule.ObjWithMutFn, f"cannot make an object of `{target}`: `{req.name}` is a `mut fn`, and a wrapped value is a COPY — writing through it would change something nobody can reach. An object is immutable here") if c_obj_recv_mut(req)

		mut ps := ""
		mut args := ""
		mut tys := ""
		for pm in req.params {
			continue if pm.name == "this"

			raise c_derive_diag(prog, target, rule.Rule.ObjWithThisParam, f"cannot make an object of `{target}`: `{req.name}` takes a `This`, and an object has forgotten which type it holds — that shape is what `#[derive({target})]` on an enum is for") if ast.ty_name(pm.ty) == "This"

			if ps != "" {
				ps = ps + ", "
				args = args + ", "
				tys = tys + ", "
			}
			ps = ps + f"{pm.name}: {ast.ty_name(pm.ty)}"
			args = args + pm.name
			tys = tys + ast.ty_name(pm.ty)
		}

		mut ret := ""
		if req.has_ret {
			ret = f" -> {ast.ty_name(req.ret)}"
		}

		# `pub`, because an object's method slots are the whole of what it is FOR: the
		# wrapper is generated from the spec and used wherever the spec is, so a
		# module-private slot would be a field nobody outside could reach — and a private
		# field must carry a default, which a function value has none of.
		fields = fields + f"\tpub {req.name}: fn ({tys}){ret}\n"
		if inits != "" {
			inits = inits + ", "
		}
		inits = inits + f"fn ({ps}){ret} {{\n\t\treturn v.{req.name}({args})\n\t}}"
	}

	wrap := c_obj_wrap_name(target)
	return f"struct {obj} {{\n{fields}}}\n\nfn {wrap}[T: {target}](v: T) -> {obj} {{\n\treturn {obj}({inits})\n}}\n"
}

fn c_obj_recv_mut(req: ast.FnDecl) -> bool {
	for pm in req.params {
		return pm.is_ref if pm.name == "this"
	}
	return false
}

# c_obj_wrap_name is the spec's name in the case a FUNCTION is written in — `Draw` makes
# `draw_obj`. A type is PascalCase here and a function snake_case, and a generated name that
# ignored that would be the one name in a program a reader has to be told about.
fn c_obj_wrap_name(target: str) -> str {
	b := list[byte](target)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() {
		c := b[i]
		if c >= b'A' and c <= b'Z' {
			if i > 0 {
				out.append(b'_')
			}
			out.append(c + byte(32))
		} else {
			out.append(c)
		}
		i = i + 1
	}
	return str(out) + "_obj"
}

# c_derive_diag is the derive pass's way onto the channel, and it exists because this pass
# has no Emitter: `#[derive(…)]` and `#[obj]` are expanded to SOURCE and re-parsed before an
# Emitter is built, so there is no marker to read and c_diag has nothing to stand on.
#
# What it answers from instead is the DECLARATION the decorator is attached to, which is the
# line a reader has to go and change either way — the decorator sits on top of it. The
# decorator's own line would be one better and it is not recorded on the File: `derive_on`
# and `derive_spec` are two parallel lists of names, and giving them a place is an ast.zg
# change rather than an emitter one.
#
# A target NO declaration carries is answered pathless, which place_line already has a form
# for. It is reachable — `#[obj]` names whatever follows it, and E4048 is what refuses a
# decorator followed by something that is not a declaration at all.
fn c_derive_diag(prog: ast.File, target: str, code: rule.Rule, msg: str) -> str {
	for sd in prog.structs {
		return c_diag_at(sd.path, sd.line, sd.col, code, msg) if sd.name == target
	}
	for ed in prog.enums {
		return c_diag_at(ed.path, ed.line, ed.col, code, msg) if ed.name == target
	}
	for sp in prog.specs {
		return c_diag_at(sp.path, sp.line, sp.col, code, msg) if sp.name == target
	}
	return c_diag_at("", 0, 0, code, msg)
}

fn c_derive_enum_at(prog: ast.File, target: str) -> int {
	mut i := 0
	for i < prog.enums.len() {
		return i if prog.enums[i].name == target
		i = i + 1
	}
	return -1
}

fn c_derive_spec_at(prog: ast.File, nm: str) -> int {
	mut i := 0
	for i < prog.specs.len() {
		return i if prog.specs[i].name == nm
		i = i + 1
	}
	return -1
}

# c_derive_delegate writes `impl S for E`, one method per required signature, each a `match`
# that hands the call to the variant's payload.
#
#     impl Show for Shape {
#         fn show() -> str {
#             return match this {
#                 Shape.Circle(v) => v.show()
#                 Shape.Square(v) => v.show()
#             }
#         }
#     }
#
# Two shapes are refused rather than guessed at, and both for the same reason — the rewrite
# does not exist. A method taking `This` would need the OTHER argument matched too, and
# nothing says the two arms agree; a variant with no payload has nothing to delegate to.
fn c_derive_delegate(prog: ast.File, target: str, nm: str) -> str {
	ed := prog.enums[c_derive_enum_at(prog, target)]
	sp := prog.specs[c_derive_spec_at(prog, nm)]

	mut out := f"impl {nm} for {target} {{\n"
	for req in sp.reqs {
		out = out + c_derive_method(ed, target, nm, req)
	}
	return out + "}\n"
}

fn c_derive_method(ed: ast.EnumDecl, target: str, nm: str, req: ast.FnDecl) -> str {
	mut ps := ""
	mut args := ""
	for pm in req.params {
		# the RECEIVER rides as parameter zero (the parser adds it), and it is the one `This`
		# that is not a problem: it is what the match is over.
		continue if pm.name == "this"

		raise c_diag_at(ed.path, ed.line, ed.col, rule.Rule.DeriveSpecEnumThisParam, f"cannot derive `{nm}` for `{target}`: `{req.name}` takes a `This`, and delegating it would have to match the other argument too — nothing says the two are the same variant. Write the impl") if ast.ty_name(pm.ty) == target or ast.ty_name(pm.ty) == "This"

		if ps != "" {
			ps = ps + ", "
			args = args + ", "
		}
		ps = ps + f"{pm.name}: {ast.ty_name(pm.ty)}"
		args = args + pm.name
	}

	mut arms := ""
	for v in ed.variants {
		raise c_diag_at(ed.path, ed.line, ed.col, rule.Rule.DeriveSpecEnumVariantNoValue, f"cannot derive `{nm}` for `{target}`: the variant `{v.name}` carries no value, so there is nothing for `{req.name}` to delegate to. Write the impl") if v.fields.len() != 1

		arms = arms + f"\t\t\t{target}.{v.name}(v) => v.{req.name}({args})\n"
	}

	mut ret := ""
	if req.has_ret {
		ret = f" -> {ast.ty_name(req.ret)}"
	}
	return f"\tfn {req.name}({ps}){ret} {{\n\t\treturn match this {{\n{arms}\t\t}}\n\t}}\n"
}

# c_derive_eq is Eq's structural rule: a product compares FIELD BY FIELD, a sum by its
# variant. `ne` is written over `eq` rather than beside it — one negation cannot disagree
# with itself, and two generated bodies could.
fn c_derive_eq(prog: ast.File, target: str) -> str {
	body := c_derive_eq_body(prog, target)
	return f"impl Eq for {target} {{\n\tfn eq(o: {target}) -> bool {{\n\t\treturn {body}\n\t}}\n\n\tfn ne(o: {target}) -> bool {{\n\t\treturn not this.eq(o)\n\t}}\n}}\n"
}

fn c_derive_eq_body(prog: ast.File, target: str) -> str {
	for sd in prog.structs {
		return c_derive_fields(sd.fields) if sd.name == target
	}
	for ed in prog.enums {
		return c_derive_variants(ed, target) if ed.name == target
	}

	raise c_derive_diag(prog, target, rule.Rule.DeriveOnStructureless, f"cannot derive `Eq` for `{target}` — a derive reads a type's STRUCTURE, and no struct or enum by that name is declared here (a `spec` has no structure to read: `#[obj]` is what goes on one)")
}

# c_derive_fields is the conjunction of the fields' own equalities, recursing into each
# field's `Eq` by simply writing `==` and letting the same rule apply one level down. A
# FIELDLESS struct is equal to itself: there is nothing that could differ.
fn c_derive_fields(fields: list[ast.FieldDef]) -> str {
	return "true" if fields.len() == 0

	mut out := f"this.{fields[0].name} == o.{fields[0].name}"
	mut i := 1
	for i < fields.len() {
		out = out + f" and this.{fields[i].name} == o.{fields[i].name}"
		i = i + 1
	}
	return out
}

# c_derive_variants is the sum's rule. A FIELDLESS enum has a native integer repr, so its
# variants differ exactly as their discriminants do and `int(v)` — the reading the language
# already gives — is the whole comparison.
#
# A PAYLOAD enum needs the tag AND the payload, matched on both sides at once, and that is
# named rather than written: comparing tags alone is the wrong answer this derive exists to
# replace, and half of it is worse than none.
fn c_derive_variants(ed: ast.EnumDecl, target: str) -> str {
	for v in ed.variants {
		raise c_diag_at(ed.path, ed.line, ed.col, rule.Rule.NotYetDeriveEq, f"NotImplemented: `#[derive(Eq)]` on `{target}` — it carries a payload (`{v.name}`), and this compiler derives equality for a fieldless enum, whose variants differ exactly as their discriminants do; write `impl Eq for {target}` with a `match`") if v.fields.len() > 0
	}
	return "int(this) == int(o)"
}

# c_build_intos records every `impl Into[T] for S`. It is a pass of its own rather than a scan
# at each use, for the reason every other table here exists: a typed position asks this
# question once per value, and answering it by walking the program's impls would make the cost
# of a conversion the size of the program.
# c_build_impls records every `impl <Spec> for <Type>`. It is the same shape as the Into
# registry and for the same reason: `==` asks this question at every use and a generic asks
# it at every instantiation, and answering either by walking the program's impls would make
# the cost the size of the program.
fn c_build_impls(mut &em: Emitter, f: ast.File) {
	for ip in f.impls {
		# THE KEY IS THE SPEC AND ITS ARGUMENTS, which is what docs/core/specs.md says a
		# parameterized spec's identity is. Recording the name alone made `impl Into[Meters]`
		# and `impl Into[Feet]` the same entry, so a bound asking for one was satisfied by the
		# other — and the bound could not ask for either, having dropped its own arguments too.
		em.impl_on.append(ast.spec_key(ip.on, ip.args))
		em.impl_target.append(ip.target)
	}
}

# c_impls reports whether a named type implements a named spec.
fn c_impls(mut &em: Emitter, target: str, spec_nm: str) -> bool {
	mut i := 0
	for i < em.impl_on.len() {
		return true if em.impl_on[i] == spec_nm and em.impl_target[i] == target
		i = i + 1
	}
	return false
}

# c_has_eq is whether the type carries an Eq impl. It reads through a `type X = Y` the way
# every other question about a named type does — the typedef takes on Y's impls.
fn c_has_eq(mut &em: Emitter, t: ast.Ty) -> bool {
	nm := c_named_of(t)
	return false if nm == ""

	return c_impls(em, nm, "Eq")
}

fn c_build_intos(mut &em: Emitter, f: ast.File) {
	for ip in f.impls {
		if ip.on == "Into" and ip.args.len() == 1 {
			# ONE `Into` PER TYPE, and it is a limit of this compiler rather than of the
			# language: `into` is one method name, and every method on a type shares one
			# namespace, so a second `impl Into[…] for X` collides with the first. The spec
			# means for there to be several — the built-in matrix has four out of `int` alone
			# — and reaching that needs a spec method to be keyed by (spec, arguments) rather
			# than by name, which is also what would let `x.into()` written by hand say which
			# one is meant. Named here, where the pair is in hand, rather than reported later
			# as two methods with one name.
			raise c_diag_at(ip.path, ip.line, ip.col, rule.Rule.NotYetSecondIntoImpl, f"NotImplemented: a second `impl Into[…] for {ip.target}` — this compiler keys a method by its NAME, so one type carries one `into`; the language allows several, and reaching that needs the method keyed by the spec and its arguments") if c_into_user_from(em, ip.target)
			em.into_src.append(ip.target)
		}
	}
}

# c_into_user_from is whether the type already has an `Into` recorded, whatever its target.
fn c_into_user_from(mut &em: Emitter, src: str) -> bool {
	for n in em.into_src {
		return true if n == src
	}
	return false
}

# c_lowered is the C a step produced — or NOTHING, when this walk is checking rather than
# emitting. It is the whole of what `check` mode is, and the shape is the point: the step is
# still CALLED, because the argument is evaluated before this function is, so every rule the
# lowering runs still runs and reports through the same channel. What is dropped is only the
# text, at the moment it would have been appended to a section.
#
# One walk with the text suppressed, rather than a checker beside the emitter, because two
# walks are two sets of rules and the second one drifts. There is nothing here to keep in
# step: a rule added anywhere in the lowering is in both modes the day it is written, and a
# rule that somehow were not would have to be one that fires on the CONTENTS of a string no
# caller reads.
#
# Why dropping the text is worth a function at all: the accumulations it feeds are quadratic
# — `defs = defs + c_fn(…)` copies everything emitted so far on every one of ~1500 steps —
# so the C is 3.6 MB and the walk that builds it peaks at 2.8 GB. Suppressing the append
# leaves the accumulators empty and each step O(1), which is 0.22 GB for the same findings.
fn c_lowered(checking: bool, s: str) -> str {
	return "" if checking
	return s
}

# c_join is every part of a section, in order, as one string — written into one growing
# buffer rather than into a fresh one per part.
#
# WHY IT IS NOT `strings.join`, which is this function. Importing `strings` here puts its
# `pub has_suffix` into the one program-wide namespace beside `cmd/layout.zg`'s own, and the
# build stops at _E9081 two modules both define `has_suffix`_ — a name collision in a file
# neither the emitter nor the standard library was changing. The compiler's `zerg` module
# reaches for a stdlib module only where the name space allows it (`ascii`, `strconv`).
#
# THE APPEND IS WHAT MATTERS, not the loop: a `list[byte]` grows amortized, so the bytes of
# the finished section are written ONCE. `defs = defs + part` wrote them again per part —
# quadratic in the total, which is #10's measurement.
# C_EMIT_MAX is the default ceiling on the C ONE UNIT may emit, in bytes — 64 MiB.
#
# WHY A CEILING AT ALL. A program large enough to exhaust the machine was SIGKILLed: no code,
# no place, nothing to read, which is the one failure shape the standing contract exists to
# prevent — *implemented or refused by name*. There was no size at which the compiler said so;
# it simply died. #10.
#
# WHY THIS NUMBER. `src/compiler/zergc.zg` — the largest program this compiler is known to
# build — emits 4.65 MB as one unit, so 64 MiB is fourteen times the biggest real input. A
# build of the self-hosting compiler that this refusal can reach would mean the number is
# wrong, and `mem-peak` is the gate that keeps it out of reach rather than asserting it is.
const C_EMIT_MAX := 67108864

# c_emit_max is that ceiling, or what `$ZERG_EMIT_MAX` says instead.
#
# IT IS OVERRIDABLE ON PURPOSE. A budget nobody can raise is a ceiling on the LANGUAGE rather
# than a guard on the compiler, so the knob sits beside `ZERG_CSTD` and `ZERG_CACHE` in
# `zerg --help`. `0` turns it off entirely, which is the honest escape for somebody who would
# rather meet the OOM killer than be turned away.
#
# A VALUE THAT IS NOT A NUMBER IS THE DEFAULT, not a refusal: this is a knob on the compiler's
# own appetite, and failing a build over the spelling of an environment variable would be a
# second, worse failure than the one it guards.
fn c_emit_max() -> int {
	return C_EMIT_MAX if not __zrt_has_env("ZERG_EMIT_MAX")

	mut n := C_EMIT_MAX
	guard {
		n = strconv.parse_int(__zrt_getenv("ZERG_EMIT_MAX"), 10)
	}
	return 0 if n < 0

	return n
}

# c_section is c_join that also COUNTS, and refuses the moment the running total passes the
# ceiling. The two are one function because the count is free exactly here: this loop already
# walks every byte, so `out.len()` is the answer with nothing added.
#
# ASKING IN THE EMIT LOOP INSTEAD would stop earlier and was measured: `bytearray(part).len()`
# per function COPIES the part to count it, and the self-build's user time went from 2.96 s to
# 5.56 s for a number this loop was about to have anyway. There is no `len` on a `str` to ask
# instead, and adding one is a change to the language rather than to the emitter.
#
# STOPPING HERE IS ENOUGH, now that #10's first half has landed: the parts hold one copy of the
# section and the join was the second, so the peak this guards is about twice the ceiling
# rather than the unbounded growth it was written against.
#
# THE PLACE IS THE UNIT, not the function the loop happened to be on. What is too large is the
# unit — `own`, every function of one module — and pointing at whichever body crossed the line
# would read as a claim about that body.
#
# `check` NEVER REACHES IT. `c_lowered` answers `""` in that mode, so a checking walk emits no
# bytes and has no budget to cross — which is right: the ceiling is on the C, and a check
# produces none.
# c_unit_path is the file a UNIT is named by, for a finding that is about the unit rather than
# about anything written in it. The first function's path, because a unit is a module and every
# declaration of one module was read from the same directory; `em.at_path` is the fallback for
# a unit that declares no function at all.
fn c_unit_path(own: ast.File, em: Emitter) -> str {
	for fd in own.fns {
		return fd.path
	}
	return em.at_path
}

fn c_section(parts: list[str], budget: int, at: str, mut &sofar: int) -> str {
	mut out: list[byte] = []
	for p in parts {
		for c in bytearray(p) {
			out.append(c)
		}

		# ASKED ONCE PER PART, not per byte. The overshoot is one function's C — bounded, and
		# small beside a ceiling measured in tens of megabytes — while per byte is a
		# comparison on every one of the 4.65 million this compiler emits for itself.
		raise c_diag_at(at, 1, 1, rule.Rule.EmitTooLarge, f"this unit emits more than {budget} bytes of C, and that is the ceiling this compiler will assemble in memory — raise it with $ZERG_EMIT_MAX (0 turns it off), or split the program into modules so each is built as a unit of its own") if budget > 0 and sofar + out.len() > budget
	}
	sofar = sofar + out.len()
	return str(out)
}

# `check` is the walk that answers whether this is a program without answering what C it
# becomes: every pass and every rule below runs unchanged, and only the TEXT is dropped
# (c_lowered). The returned C is empty, which is what a caller in this mode asked for.
fn c_emit_unit(prog0: ast.File, own0: ast.File, ms: Mods, whole: bool, want_lints: bool, checking: bool, mut &diags: list[ast.Diag], mut &lints: list[ast.Diag]) -> str {
	# the derive expansion runs over the program the builtin specs are already in, because
	# what it writes is `impl Eq for …` and the spec that names has to be there to meet it.
	#
	# BOTH VIEWS ARE EXPANDED. `f` is the whole program, which is what declares the method and
	# proves the call; `own` is this unit, which is what WRITES THE BODY. Expanding only the
	# first left `zg_ArgKind_eq` declared, called, and defined nowhere — a link error against
	# a function the program never spells. Each expands from its own derive list, so the unit
	# gets exactly the impls whose decorators are in it.
	f0 := c_with_derived(c_with_builtin_specs(prog0))

	# THE FINDINGS SO FAR TRAVEL IN, in the `diags` slot. `chk_at_place` drops an exact repeat —
	# same file, same line, same column, same sentence — so that one mistake earns one message;
	# but each unit used to start from an empty list, so the rule could not see across a unit
	# boundary and a declaration every unit checks was reported once per unit. Seeding the list
	# is what makes that invariant hold for a multi-unit program, at the place it already lives,
	# and it is what lets the declaration passes below go back to reading the WHOLE program.
	seen := diags.len()
	mut em := Emitter([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], false, false, false, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], 0, [], 0, [], [], false, "", "", [], [], ast.Ty.TVoid, 0, "", 0, 0, diags, 0, 0, [], [], [], [], [], false, 0, false, "", 0, false, false, [], want_lints, [], [], [], [], [], [], [], [], [], [], [], false, 0, [], [], "", c_nosub(), [], [], [], [], [], [], [], [], [])

	# ASSIGNED, NOT PASSED. Every argument above is a zero value, and `layering` asserts that
	# — it lines the call up with the fields by KIND, which only works while nothing in it
	# carries a value. Two more that did would have widened the exception list instead of the
	# table; the table is not constructor state, it is the first thing put INTO the Emitter.
	em.unit_paths = ms.paths
	em.unit_mods = ms.names
	em.imp_at = ms.imp_at
	em.imp_path = ms.imp_path
	em.imp_mod = ms.imp_mod

	# THE TEMPLATES ARE RECORDED AND THEN REMOVED, before any other pass sees the program.
	# A template is not a function, and this is the honest way to say so: from here down —
	# in these passes and in any added later — `f.fns` holds functions only.
	c_build_generics(em, f0)
	f := c_without_templates(f0)
	own := c_without_templates(c_with_derived(own0))

	# OVER `f0`, THE PROGRAM WITH ITS TEMPLATES STILL IN IT. A template is not a function
	# to lower, which is what the removal above says, but it IS a name at the top level:
	# `fn Foo[T](x: T)` beside `struct Foo` is the same collision as the non-generic pair,
	# and `Foo(3)` quietly meant the constructor. This is the one pass that asks about the
	# name rather than about the body, so it is the one pass that reads the whole list.
	c_build_top_names(em, f0)

	# THE COMPILE-TIME VALUES, before the table that first asks for one: c_build_enums folds a
	# discriminant, and a discriminant may name a module constant.
	c_build_const_vals(em, f)

	# AHEAD of c_build_sigs, which raises on two methods of one name: a second `impl Into[…]`
	# is exactly that collision, and the sentence about method namespaces is true and about
	# the wrong thing. The pass that knows what the pair was gets to say it first.
	c_build_intos(em, f)
	c_build_impls(em, f)
	c_build_sigs(em, f)
	c_build_typedefs(em, f)
	c_build_structs(em, f)
	c_build_enums(em, f)
	c_build_specs(em, f)

	# THE DECLARATION SITES, once. Three passes below ask the same question of them — what
	# types a declaration spells — and the list answers all three (c_decl_sites says why it
	# is one list). Building it here rather than inside each is what makes that literal: a
	# site added to it is added for all three, and none of them re-walks the program.
	sites := c_decl_sites(f)

	# OVER THE WHOLE PROGRAM, like everything else here that reads a declaration.
	#
	# It was narrowed to `own` for a while, to stop an eight-module build reporting one
	# declaration's mistake eight times — and that was the wrong lever. The reasoning was
	# "every module of a build is emitted in the same run, so the module with the mistake
	# still reaches its own unit", which is true of `--emit bin` and FALSE of `--emit lib`:
	# that path emits a single unit (zergc.zg's `emit_unit_at(merge_asts(trees), trees[last])`),
	# so every imported module's declarations went unchecked and a `pub fn make() -> Nonexistent`
	# in a dependency reached cc as `unknown type name 'zg_Nonexistent'`. The duplication is a
	# reporting problem and belongs to the reporting channel, which now dedupes across units
	# (see the `seen` seeding above) — so the check can read what it has always needed to read.
	c_check_named_types(em, f, sites)
	c_scan_fnptr(em, sites)
	c_build_namespaces(em, f)

	# and what those bindings COLLIDE with, asked of the same whole-program view that built
	# them: an import binds into the one value namespace, so a name it takes has to be free
	check.chk_import_names(em, f, own)

	# AFTER the bindings exist, which is the whole of why this is here and not beside the
	# other declaration passes above: it asks whether each qualifier names a namespace the
	# writing module bound, and asked earlier it would read an empty table and refuse every
	# qualified type in the program. The module qualifiers a TYPE position wrote are carried
	# on the side (File.ty_quals) because parse_base_type resolves `lib.Counter` to `Counter`
	# and no Site keeps the `lib.`.
	check.chk_ty_quals(em, f)

	# AFTER the tables, not inside the walk that fills them. A default is an expression, so
	# judging it asks c_infer, and c_infer asks the signature, struct and enum tables — from
	# inside c_build_sigs it would see only the declarations that happen to come EARLIER in
	# the file. `b: str = later()` was refused or accepted depending on whether `later` was
	# written above or below, which is the order-dependence the rule exists to remove.
	check.c_check_defaults(em, f)

	# and the specs, which need the same whole-program view for the same reason: an `impl`
	# in one file names a spec declared in another, and the driver has already merged them
	check.chk_spec_impls(em, f)

	# and the rendering overrides: c_render_override dispatches through a `display` /
	# `debug` method only when its shape is the contract's, so the mis-shaped one must be
	# a finding at its declaration rather than a silent fall-through to the built-in
	check.chk_render_overrides(em, f)

	mut types := ""

	# the tuples and carriers a DECLARATION names, ahead of what names them, in one walk
	# over the declaration sites (c_decl_types says why it is one). Both go through the
	# same dependency sweep as the enums and structs: a struct field of tuple type reaches
	# no tuple literal, and a tuple holding a declared type has to come out after it.
	mut tuples: list[ast.Ty] = []
	mut carriers: list[ast.Ty] = []
	c_decl_types(sites, tuples, carriers)

	types = types + c_lowered(checking, c_type_decls(em, f, carriers, tuples))
	mut i := 0
	for i < f.enums.len() {
		types = types + c_lowered(checking, c_refbox_helpers(f.enums[i]))
		i = i + 1
	}

	# after the typedefs, because a helper names the struct it copies, and before the
	# prototypes and bodies, which are what call them
	types = types + c_lowered(checking, c_copy_helpers(em, f))

	# the top level is immutable: a `mut` module binding is refused at its own declaration
	# (over `own`, so a multi-unit build reports it once), before c_const_globals walks
	# the values — a rule about the declaration should not wait on its initializer
	check.chk_top_muts(em, own)

	# and the top level runs nothing: a statement written there is refused at the line it was
	# written on, over `own` for the same once-per-unit reason
	check.chk_top_stmts(em, own)

	# the constants are declared before the prototypes, so a body may name one
	globals := c_lowered(checking, c_const_globals(em, f, own, whole))

	# COLLECTED AND JOINED ONCE, not rebound per function. `defs = defs + c_fn(…)` over ~1500
	# functions allocates a fresh buffer holding everything emitted so far on every step: the
	# copying is quadratic in total output size, and the finished C is 4.65 MB against a peak
	# of 0.36 GB. `c_join` appends into one growing `list[byte]`, so the bytes are
	# written once. #10.
	#
	# The parts are still `c_lowered`, which answers `""` under `check` — so a checking walk
	# collects 1500 empty strings and joins them, which is the cheap end of cheap.
	mut proto_parts: list[str] = []
	i = 0
	for i < f.fns.len() {
		proto_parts.append(c_lowered(checking, c_proto(em, f.fns[i])))
		i = i + 1
	}
	mut def_parts: list[str] = []
	i = 0
	for i < own.fns.len() {
		def_parts.append(c_lowered(checking, c_fn(em, own.fns[i])))
		i = i + 1
	}

	# THE SPECIALIZATIONS, which only exist because a body above asked for one. The list
	# grows while it is being walked — a specialized body may call another template, or the
	# same one at a different type — so this is a watermark loop and not a `for`: a `for`
	# takes the length once, and the arrivals after that would be declared and never defined.
	#
	# `proto_parts` is still OPEN here, so a prototype appended now still lands ABOVE every
	# body in the finished file — the two lists are joined below, after this loop. That is
	# what lets a specialization discovered while lowering `main` be called from `main`.
	mut done := 0
	for done < em.inst_fns.len() {
		# A SPECIALIZATION IS `static`, so each unit that needs one carries its own. The
		# alternative is a rule about which unit owns it, and there is no such rule to have:
		# the unit that DECLARES the template never learns which instantiations exist —
		# only the units that call it do — while emitting it at every call site gave two
		# units one symbol, and C has no COMDAT to fold them. The LINKER said so both ways,
		# with no file and no line.
		#
		# The cost is a copy per unit, which is what a C header carrying an inline function
		# costs, and it is paid only by the units that actually use one.
		inst := em.inst_fns[done]
		proto_parts.append(c_lowered(checking, "static " + c_proto(em, inst)))
		def_parts.append(c_lowered(checking, "static " + c_fn(em, inst)))
		done = done + 1
	}

	# THE BUDGET IS ON THE UNIT, so one running total crosses both sections.
	budget := c_emit_max()
	unit_at := c_unit_path(own, em)
	mut nbytes := 0
	protos := c_section(proto_parts, budget, unit_at, nbytes)
	defs := c_section(def_parts, budget, unit_at, nbytes)

	# every `init()` runs before main, in the order it was declared — GRAMMAR's FIFO,
	# each once
	#
	# THE WHOLE PROGRAM'S, not this unit's. `own` is the entry file, so under separate
	# compilation an imported module's `init()` was emitted, prototyped in every unit,
	# and called by none: `import "m"` where m declares `init()` simply did not run it,
	# and the program printed the rest of its output as if it had. The constants beside
	# it were already taken from `f` for exactly this reason. It went unseen because the
	# one example that owns this behaviour was built by the seed, whose single
	# translation unit makes `own` and `f` the same file.
	#
	# OUTSIDE THE `c_has_main` GUARD, and the text is what the guard decides — not whether
	# the walk happens. This lowering is the ONLY place a module-level initializer is
	# resolved: c_const_globals runs in every unit and infers each row's type, but inference
	# is silent about a callee nothing declares — c_undefined_fn is reached from c_call and
	# not from c_infer_call, because a type is all inference was asked for. So while this
	# sat inside the guard, a unit that declares no `main` — which is `zerg build`'s
	# documented behaviour for a module, `--emit lib` — had NOTHING at module level
	# resolved: `a := nope().run()` alone in a file built, linked, and exited 0, with no
	# diagnostic and no `nope` anywhere in the program. The identical call one scope down
	# was refused, because a function body is lowered whether or not the unit has an entry.
	#
	# Running the walk and discarding what it produced is the same shape `c_lowered` already
	# gives the `check` stage: the findings are the point, the text is the by-product.
	inits := c_const_assigns(em, f) + c_init_calls(em, f)

	mut mainw := ""
	if c_has_main(own) {
		mainw = c_lowered(checking, c_main_entry(em, own, inits))
	}

	# A separately-compiled unit declares the WHOLE program's prototypes, and any of them
	# may name a runtime type, so it needs the runtime header even when its own bodies
	# touch nothing from it. A whole-program build still decides from use, which keeps a
	# value-only program's C free of the include.
	# A HELD FUNCTION NEEDS THE RUNTIME, because holding one is now a refcount operation:
	# zg_copy_fnptr and zg_drop_fnptr are zrt_retain and zrt_release over the environment's
	# cell. A program whose fn values are all named functions pays nothing at run time — the
	# environment is NULL and both no-op — but it still has to see the declarations.
	rt := c_needs_runtime(em) or em.used_rt or em.used_fnptr or not whole
	mut hdr := "// Generated by zergc (self-host). Do not edit.\n"
	hdr = hdr + "#include <stdio.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <string.h>\n"
	if em.used_fnptr {
		hdr = hdr + c_fnptr_typedef()
	}
	if rt {
		hdr = hdr + "#include \"zergrt.h\"\n"
	}
	hdr = hdr + "\n"

	# after the include, because the pair is zrt_retain and zrt_release — the typedef above
	# goes before it so that a prototype naming `zg_fnptr` has a type to name
	if em.used_fnptr {
		hdr = hdr + c_fnptr_helpers()
	}
	if em.used_rt {
		hdr = hdr + "static const zrt_elem_vt zg_listvt = {NULL, NULL};\n"
		hdr = hdr + "static void zg_elemcopy_list(void *dst, const void *src) { zrt_list_copy((zrt_list*)dst, (const zrt_list*)src); }\n"
		hdr = hdr + "static void zg_elemdrop_list(void *elem) { zrt_list_drop((zrt_list*)elem); }\n"
		hdr = hdr + "static const zrt_elem_vt zg_listvt_list = {zg_elemcopy_list, zg_elemdrop_list};\n"
		hdr = hdr + "static void zg_elemcopy_map(void *dst, const void *src) { zrt_map_copy((zrt_map*)dst, (const zrt_map*)src); }\n"
		hdr = hdr + "static void zg_elemdrop_map(void *elem) { zrt_map_drop((zrt_map*)elem); }\n"
		hdr = hdr + "static const zrt_elem_vt zg_listvt_map = {zg_elemcopy_map, zg_elemdrop_map};\n"
		hdr = hdr + "static void zg_elemcopy_str(void *dst, const void *src) { *(const char**)dst = zrt_str_retain(*(const char* const*)src); }\n"
		hdr = hdr + "static void zg_elemdrop_str(void *elem) { zrt_str_release(*(const char**)elem); }\n"
		hdr = hdr + "static const zrt_elem_vt zg_listvt_str = {zg_elemcopy_str, zg_elemdrop_str};\n"
		hdr = hdr + "static zrt_list zg_empty_list(size_t esz, const zrt_elem_vt *vt) { zrt_list l; zrt_list_init(&l, esz, vt); return l; }\n\n"
	}

	# the tuples and carriers found while the bodies were lowered, ONE stream in the order
	# they were met — a tuple spelling a carrier and a carrier spelling a tuple both come
	# out inner-first, because each declaration inlined what it spells (c_spelled_pre) at
	# the moment it was written. The ones a DECLARATION names went through the type sweep
	# instead, in dependency order among the enums and structs; the shape registries are
	# shared, so a shape is emitted exactly once whichever path first met it.
	mut ress := ""
	for d in em.res_decls {
		ress = ress + c_lowered(checking, d)
	}

	# the map vtables AFTER the typedef stream: a vtable's initializer names the copy thunk
	# a tuple's declaration text defines, so it has to follow whichever section that text
	# landed in
	mut mvts := ""
	for d in em.mvt_decls {
		mvts = mvts + c_lowered(checking, d)
	}

	# the defer thunks go AFTER the prototypes — each one calls a program function — and
	# before the bodies that schedule them
	mut dfns := ""
	for d in em.rcv_decls {
		dfns = dfns + c_lowered(checking, d)
	}
	for d in em.dfn_decls {
		dfns = dfns + c_lowered(checking, d)
	}

	# a lifted lambda is a whole function, emitted BEFORE the bodies that name it: the
	# prototypes above cover the program's own functions, not one this pass invented, so
	# the definition has to be what the use sees
	mut lams := ""
	for d in em.lam_defs {
		lams = lams + c_lowered(checking, d)
	}

	# ONLY WHAT THIS UNIT ADDED. The list went in already holding the earlier units' findings,
	# so appending all of it would give each of them back once more per unit — the duplication
	# the seeding above exists to remove, reintroduced on the way out.
	mut di := seen
	for di < em.diags.len() {
		diags.append(em.diags[di])
		di = di + 1
	}
	for d in em.lints {
		lints.append(d)
	}

	# and the header, which is the one section built from literals rather than from a
	# lowering step, so it is the one c_lowered never sees. A check-only walk returns
	# the empty string, not a file with nothing but includes in it.
	return "" if checking
	return f"{hdr}{types}{ress}{mvts}{globals}{protos}\n{dfns}{lams}{defs}{mainw}"
}
