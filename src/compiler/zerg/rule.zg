	ConstRebound = 356
	ConstShadows = 357
	TopLevelMutOutsideUnsafe = 358
	DisplayTakesNoArgs = 359
	DisplayNotMutFn = 360
	DisplayAnswersStr = 361
	DeclaredTwiceOneGeneric = 362
	GenericAndPlainFn = 363
	ThisOutsideImpl = 364
	ParamNameTwice = 365
	ConvOneValue = 366
	ConvNotFromStr = 367
	NotCallable = 369
	FieldMissingInLiteral = 370
	ThisWithoutReceiver = 371
	UndefinedName = 372
	SliceBoundNotInt = 374
	IndexNotInt = 375
	NoSuchField = 376
	TupleAccessOnNonTuple = 377
	TupleIndexOutOfRange = 378
	NotIterable = 379
	RaiseCarriesErr = 380
	DeclaredTwiceDifferentKind = 381
	DeclaredTwiceSameKind = 382
	VariantNamedBare = 383
	EitherSideNamedBare = 384
	ClosureParamNoType = 385
	FnValueArgCount = 386
	UnsafeNameInSafeCode = 387
	ModuleNoSuchName = 388
	ImportNameTaken = 389
	NilWhereValueNeeded = 390
	TopLevelStatement = 391
	CollectionNotMut = 392
	CollectionFrozenInLoop = 393
	IntConvOnFloat = 394
	ConvTwoSteps = 395
	PrimitiveUnknown = 396
	PrimitiveArgCount = 397
