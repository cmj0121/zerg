}

# rule_code is the text a rule is reported under — the `E204` a gate pins and a reader looks
# up. It is built from the discriminant rather than stored beside it so the number lives in
# exactly one place, which is what makes renumbering an edit to this file alone.
pub fn rule_code(r: Rule) -> str {
	return f"E{int(r)}"
}

# rule_msg opens a message with its code, for the two refusals that raise a string rather
# than going through a reporting channel. A channel does this itself.
pub fn rule_msg(r: Rule, msg: str) -> str {
	return f"{rule_code(r)} {msg}"
}
