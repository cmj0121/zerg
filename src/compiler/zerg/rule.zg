# rule — the identity of every diagnostic this compiler reports.
#
# A diagnostic names a RULE, and the code in front of its sentence is that rule's stable
# identity: prose gets better and a gate that pinned the sentence would turn red every time
# it did. The catalogue a reader looks the code up in is docs/tooling/diagnostics.md — it is
# the authority on what the scheme IS — and `make error-codes-check` holds it to this file.
#
# It is an enum and not a string at the site for three reasons, each of which was a way the
# scheme had already drifted:
#
#   A CODE IS DECLARED ONCE. Every reporting channel takes a `Rule`, so a hand-spelled
#   `"E2004"` is a type error rather than a finding some gate has to go looking for. A rule
#   with no identity cannot be written at all.
#
#   TWO CHANGES COLLIDE IN GIT. Three collisions happened in one week, because parallel work
#   could only grep the catalogue and never see a sibling's choice. Every new code is a line
#   in THIS file, appended to its stage, so a second one lands on the same lines and the
#   merge says so — before CI is asked.
#
#   THE NUMBER IS NOT THE IDENTITY. A variant names the rule and the discriminant carries
#   the number, so renumbering the whole scheme is an edit to this file and to nothing else.
#   That is not hypothetical: it is how the four-digit numbering below was arrived at, in one
#   commit that touched no reporting site.
#
# ONE NUMBER IS NEVER REUSED. A retired code leaves this file for the catalogue's retired
# table: an old build's message must go on meaning what it meant, and reissuing a number
# silently reassigns every report, log and bug filed under it.

pub enum Rule {
	# lexical — text that is not Zerg tokens — the scanner's refusals, reported before there is
	# a form to name
	StrUnterminated = 1001
	RuneEmpty = 1002
	RuneTooLong = 1003
	CharNotAToken = 1004
	TripleStrUnterminated = 1005
	RawStrUnterminated = 1006
	CommandUnterminated = 1007
	BasedNumberNoDigit = 1008
	EscapeInvalid = 1009
	StrHoldsNul = 1010
	SourceNotUtf8 = 1011
	FStrUnterminated = 1012
	FStrBareBrace = 1013

	# parser — tokens that are not a Zerg form
	SelectArmClose = 2001
	SelectNoArms = 2002
	SelectArmHead = 2003
	ExpectedFound = 2004
	ExpectedStatementEnd = 2005
	EitherSameType = 2006
	DeriveNoDeclaration = 2007
	AssocValueNotSpecMember = 2008
	DiscriminantOnPayloadEnum = 2010
	AssocTypeNotSpecMember = 2011
	NestingTooDeep = 2012
	ReservedWordAsName = 2013
	TupleTypeOneElement = 2014
	PubImport = 2015
	PubOnInit = 2016
	PubOnImpl = 2017
	PubInsideDecorator = 2018
	FreeFnMut = 2019
	PubOnUnsafeGroup = 2020
	UnsafeGroupNested = 2021
	UnsafeGroupHoldsDeclarations = 2022
	PubOnStatement = 2023
	UnsafeGroupUnterminated = 2024
	ReservedWordAsBinding = 2025
	ScalarConvNoValue = 2026
	ScalarConvManyValues = 2027
	ListConvNoValue = 2028
	ListConvManyValues = 2029
	MatchGuardPlacement = 2030
	ParamMutRefOrNothing = 2031
	ImportPathNotString = 2032
	ArrayConvNoValue = 2033
	ArrayConvManyValues = 2034
	TypeArgsAsIndex = 2035
	SpecMemberNeitherSigNorBody = 2036
	CoalesceDivergeGuard = 2044
	TupleLitOneElement = 2045
	TrailingComma = 2046
	BraceOpeningHead = 2047
	ReservedWordAsField = 2048
	FieldNameExpected = 2049
	NameExpected = 2054
	ChanDirectionPrefix = 2055
	MutBeforeNonFn = 2056
	IsWantsTypeName = 2057
	FStringTextMalformed = 2058
	FStringHoleManyExprs = 2059
	TypeNameNotUpper = 2060
	PreludeNameAsName = 2061
	DecoratorOnStatement = 2062
	SecondDecorator = 2063
	AllowNamesNoCodes = 2064
	MapEntryNoColon = 2065
	DecoratorOnNonType = 2066
	ImplSpecNotBare = 2067
	DecoratorEmpty = 2068
	DeriveNamesNoSpec = 2069
	ChanDirectionForm = 2070

	# checking — a form whose meaning does not hold together — reported against the tree, all at once
	NotPublicMember = 3001
	AssignTargetNotAPlace = 3002
	AssignToConst = 3003
	AssignToModuleBinding = 3004
	AssignToThis = 3005
	AssignToImmutable = 3006
	AssignThroughImmutable = 3007
	MutRefParamDefault = 3008
	ParamDefaultType = 3009
	CtorArgCount = 3010
	MutRefArgEscapes = 3011
	StoreThroughValue = 3012
	SpecUnknown = 3013
	ImplTypeArgCount = 3014
	SpecExtendsUnknown = 3015
	SpecMethodMismatch = 3016
	SpecRequirementUnmet = 3017
	IntLiteralOverflow = 3018
	StrNotIndexable = 3019
	IfBranchTypes = 3020
	MatchArmTypes = 3021
	BorrowOfValue = 3022
	WriteBackToThis = 3023
	WriteBackToImmutable = 3024
	MutRefAliasInCall = 3025
	CallArgCount = 3026
	CallMissingArgs = 3027
	ListElementType = 3028
	ValueOutOfType = 3029
	DivideByZero = 3030
	IntRangeOverflow = 3031
	ReturnType = 3032
	BindingTypeMismatch = 3033
	BindingHasNoType = 3034
	TypedefNamesNoType = 3035
	FieldOrPayloadType = 3036
	AssignType = 3037
	ArgumentType = 3038
	OptionalOperand = 3039
	OpNoMeaning = 3040
	OpWantsBool = 3041
	OpWantsInt = 3042
	OpWantsNumeric = 3043
	OpWantsOrdered = 3044
	CompareVariantWithNumber = 3045
	CompareDifferentKinds = 3046
	NotWantsBool = 3048
	NegWantsNumeric = 3049
	BitNotWantsInt = 3050
	OpOperandsDiffer = 3051
	ConditionOptional = 3052
	ConditionNotBool = 3053
	ConstRebound = 3054
	ConstShadows = 3055
	TopLevelMutOutsideUnsafe = 3056
	DisplayTakesNoArgs = 3057
	DisplayNotMutFn = 3058
	DisplayAnswersStr = 3059
	DeclaredTwiceOneGeneric = 3060
	GenericAndPlainFn = 3061
	ThisOutsideImpl = 3062
	ParamNameTwice = 3063
	ConvOneValue = 3064
	ConvNotFromStr = 3065
	NotCallable = 3066
	FieldMissingInLiteral = 3067
	ThisWithoutReceiver = 3068
	UndefinedName = 3069
	SliceBoundNotInt = 3070
	IndexNotInt = 3071
	NoSuchField = 3072
	TupleAccessOnNonTuple = 3073
	TupleIndexOutOfRange = 3074
	NotIterable = 3075
	RaiseCarriesErr = 3076
	DeclaredTwiceDifferentKind = 3077
	DeclaredTwiceSameKind = 3078
	VariantNamedBare = 3079
	EitherSideNamedBare = 3080
	ClosureParamNoType = 3081
	FnValueArgCount = 3082
	UnsafeNameInSafeCode = 3083
	ModuleNoSuchName = 3084
	ImportNameTaken = 3085
	NilWhereValueNeeded = 3086
	TopLevelStatement = 3087
	CollectionNotMut = 3088
	CollectionFrozenInLoop = 3089
	IntConvOnFloat = 3090
	ConvTwoSteps = 3091
	PrimitiveUnknown = 3092
	PrimitiveArgCount = 3093
	PrimitiveOperandType = 3094
	EnumDiscriminantRepeated = 3095
	ImplOrphan = 3096
	DeriveSpecEnumThisParam = 3097
	DeriveSpecEnumVariantNoValue = 3098
	ObjNotOnSpec = 3099
	ObjWithMutFn = 3100
	ObjWithThisParam = 3101
	DeriveOnStructureless = 3102
	DelUnknownName = 3103
	DelNotABinding = 3104
	UseAfterDel = 3105
	UseAfterDelOnSomePaths = 3106
	ChanOfOptional = 3107
	PubMutGlobal = 3108
	RecvOnSendOnly = 3109
	SendOnRecvOnly = 3110
	CloseRecvOnly = 3111
	ChanDirectionNarrows = 3112

	# emitting — a form this compiler will not lower
	LoopKeywordOutsideLoop = 4001
	FromCauseNotErr = 4002
	EitherSideOneValue = 4004
	OptionalChainOnNonOptional = 4005
	IntOnPayloadEnum = 4006
	TryCarrierMismatch = 4007
	GenericInstantiationDepth = 4008
	TypeParamUndecided = 4009
	TypeParamBoundUnmet = 4010
	StrOfListElement = 4011
	ConvOfOptional = 4012
	EnumConvOnlyInt = 4013
	OfOnPayloadEnum = 4014
	IndexOfOptional = 4015
	UndefinedFunction = 4016
	StructLiteralFieldCount = 4017
	VariantPatternWrongEnum = 4018
	MatchMissingVariant = 4019
	EqRequired = 4020
	OptionalNotUnwrapped = 4021
	PrintOfOptional = 4022
	FallsOffTheEnd = 4023
	DeriveNotCompilerOwned = 4024
	MethodDeclaredTwice = 4025
	ByValueCycle = 4026
	MemberDeclaredTwice = 4027
	ChainTooDeep = 4028
	ScalarConvOfNonScalar = 4029
	NotAVariantOf = 4030
	VariantOfOtherEnum = 4031
	CatchAllNotLast = 4032
	EitherSideUndeclared = 4033
	IdentityHasNoEquality = 4034
	IntoNotBuiltIn = 4035
	MatchMissingCatchAll = 4036
	ReturnWithoutValue = 4037
	OptionalCompare = 4038
	DiscriminantNotConstant = 4039
	FillCountNotConstant = 4040
	FillCountNegative = 4041
	RangeArmBoundNotConstant = 4042
	NotAChannel = 4043
	PrivateFieldNeedsDefault = 4045
	EitherBareValue = 4053
	NoSuchFieldInChain = 4054
	TryRightUnanswered = 4055
	NoSuchType = 4056
	IsWantsErr = 4057
	InWantsErr = 4058
	ListConvOfNonStr = 4059
	ListConvElementType = 4060
	IndexOfNonContainer = 4061
	OfTakesOneInt = 4062
	TestableNotConstructible = 4063
	NoSuchTypeToConstruct = 4064
	NoSuchVariantInPattern = 4065
	MatchMissingEitherSide = 4066
	MatchMissingBoolCase = 4067
	ConstCycle = 4068
	ClosureCaptureUnknown = 4069
	LenTakesNoArgument = 4070
	HasTakesOneKey = 4071
	TypeParamCount = 4072
	DeclaredTwiceInFile = 4073

	# building — the program as a set of files, which no single file's text answers: imports resolved
	# before anything is lexed, and `fn main` looked for after everything is emitted
	EntryHasNoMain = 5001
	ImportUnresolved = 5002
	ModuleNotImported = 5007
	NotPublicType = 5008
	PrivateTypeOnPubDecl = 5009
	NotPublicField = 5010
	TestFileImported = 5011

	# An import path is a PREFIX and a PACKAGE PATH, and this is the one code for a string that
	# is neither. Every shape it turns away fails the same test — a segment that is not a
	# `[a-z][a-z0-9_]*` package name — so they are one rule wearing several sentences: `..` and a
	# leading `/` (which reach outside the project), a `//` or a trailing `/` (which are a second
	# spelling of one path, and normalising them would put module identity back to being computed),
	# a `.zg` suffix (an import names a module, not a file), and a last segment that is a reserved
	# word (it is bound as an identifier, and `match` cannot be one).
	ImportPathIllFormed = 5012

	# The path is well formed and the DISK is ambiguous: `x/` and `x.zg` both there. Refused
	# rather than ranked, because any silent precedence is a question a reader eventually has to
	# ask, and there should be nothing to ask.
	ImportLayoutAmbiguous = 5013
	ImportCycle = 5014

	# An import that resolves to the module the importing FILE is already part of. It is NOT a
	# cycle and was reported as one: a cycle is two modules with no order between them, and this
	# has a perfectly good order — it is meaningless rather than unorderable, because a module's
	# files share one namespace and the names are already in scope. Two different mistakes, and
	# the advice for a cycle ("put the mutually recursive declarations in ONE module") is exactly
	# what the author of this one already did.
	ImportOfOwnModule = 5015

	# The C one unit would emit is larger than the budget, which is a REFUSAL rather than a
	# crash: a program big enough to exhaust the machine was SIGKILLed — no code, no place,
	# nothing to read — and that is the failure the standing contract exists to prevent.
	#
	# The budget is on EMITTED BYTES and not on RSS. A byte count is a number the compiler
	# already owns, it is the same on every host and allocator, and a gate can reproduce it;
	# RSS needs an OS call the runtime has not got and a number that moves under you.
	EmitTooLarge = 5016

	# unbuilt — NOT a stage — a form the language HAS and this compiler has not built. It is its own
	# range because it is its own class: each of these retires when the form is built, and
	# keeping that churn out of the five stage ranges is what keeps them dense
	NotYetParameterizedSpec = 9001
	NotYetSpecMemberBody = 9002
	NotYetGenericEnum = 9003
	NotYetGenericStruct = 9004
	NotYetDecorator = 9005
	NotYetImplAssocValue = 9006
	NotYetImplItem = 9007
	NotYetStructPattern = 9008
	NotYetCallee = 9009
	NotYetNamedArgument = 9010
	NotYetUnsafeExpr = 9011
	NotYetFStringFormatSpec = 9012
	NotYetFStringConversion = 9013
	NotYetFStringSelfDoc = 9014
	NotYetImplAssocType = 9015
	NotYetTuplePattern = 9016
	NotYetArrayType = 9017
	NotYetAsPattern = 9018
	NotYetCommandInterpolating = 9019
	NotYetCommandLiteral = 9020
	NotYetDestructuringBinding = 9021
	NotYetRangeNoLower = 9022
	NotYetListPattern = 9023
	NotYetOrPattern = 9024
	NotYetForMutBinding = 9025
	NotYetStructPatternInMatch = 9026
	NotYetUnsafeFn = 9027
	NotYetAssocTypeProjection = 9028
	NotYetValueGenericParam = 9029
	NotYetTypeArgsNoCall = 9030
	NotYetIfExprManyStatements = 9031
	NotYetIfExprBindingHead = 9032
	NotYetAsm = 9033
	NotYetClosureParamDefault = 9034
	NotYetFnTypeMutRefParam = 9035
	NotYetUnsafeSpecSignature = 9036
	NotYetImplTypeParams = 9037
	NotYetImplTypeArgument = 9038
	NotYetStatementAsExpr = 9039
	NotYetExprForm = 9040
	NotYetMatchArmStatement = 9041
	NotYetTypedefNonScalar = 9042
	NotYetJumpOutOfGuard = 9043
	NotYetGenericMethod = 9044
	NotYetRawPointerBuiltin = 9045
	NotYetCompileTimeBuiltin = 9046
	NotYetImplOnBuiltin = 9047
	NotYetSpecAsType = 9048
	NotYetMutateListRvalue = 9049
	NotYetOpenRangeHere = 9050
	NotYetAssociatedFn = 9051
	NotYetMapKeyType = 9052
	NotYetIfBindOver = 9053
	NotYetDerive = 9054
	NotYetDeriveEq = 9055
	NotYetListMethod = 9056
	NotYetContainerEquality = 9057
	NotYetRefBox = 9058
	NotYetRenderAsText = 9059
	NotYetSecondIntoImpl = 9060
	NotYetInOverNoEq = 9061
	NotYetInOverType = 9062
	NotYetFixedWidthLadder = 9063
	NotYetSetBuiltin = 9064
	NotYetFnValueMutRef = 9065
	NotYetDelChannel = 9066
	NotYetGenericConstructor = 9067
	NotYetNilPattern = 9068
	NotYetValueUnnameableType = 9069
	NotYetRebindMatchBinding = 9070
	NotYetDefaultReadsField = 9071
	NotYetDestructuringAssign = 9072
	NotYetUnsafeFnType = 9073
	NotYetImplDottedTarget = 9074
	NotYetGenericTypedef = 9075
	NotYetSubPatternInPayload = 9076
	NotYetRangeAsValue = 9077
	NotYetIsErrorKind = 9078
	NotYetSealed = 9079
	NotYetTryOnType = 9080
	NotYetTwoModulesDefine = 9081
	NotYetNamespaceCollision = 9082
	NotYetForceOnType = 9083
	NotYetCoalesceOnType = 9084
	NotYetRenderEnumAsText = 9085
	NotYetErrMethodArgs = 9086
	NotYetErrMethod = 9087
	NotYetOkOrNoArg = 9088
	NotYetOkOrManyArgs = 9089
	NotYetOkOrNotErr = 9090
	NotYetOkTakesNoArg = 9091
	NotYetCarrierMethod = 9092
	NotYetEnumTypeMethod = 9093
	NotYetMethodOnType = 9094
	NotYetResultPattern = 9095
	NotYetMainSignature = 9096
	NotYetMainArgsWithConcurrency = 9097
	NotYetSpawnOfNonFunction = 9098
	NotYetSpawnOfUnknownName = 9099
	NotYetMapMethod = 9100
	NotYetErrField = 9101
	NotYetOpenRangeInclusive = 9102
	NotYetSpawnOfBinding = 9103
	NotYetAtomicImport = 9104

	# A REMOTE package — a path whose first segment is a host, which a package name can never be
	# because it may not hold a dot. The syntax is reserved so nothing else takes the shape; what
	# resolves it is a package layer this compiler has not built. The sentence says that and
	# nothing else: how a remote package is fetched, named or versioned is undecided, and a
	# promise in a diagnostic is still a promise.
	NotYetRemoteImport = 9105
	NotYetCrossModuleFnValue = 9106
}

# rule_code is the text a rule is reported under — the `E2004` a gate pins and a reader looks
# up. It is built from the discriminant rather than stored beside it so the number lives in
# exactly one place, which is what makes renumbering an edit to this file alone.
pub fn rule_code(r: Rule) -> str {
	return f"E{int(r)}"
}

# rule_msg opens a message with its code, for the refusals that raise a string rather than
# going through a reporting channel. A channel does this itself.
pub fn rule_msg(r: Rule, msg: str) -> str {
	return f"{rule_code(r)} {msg}"
}
