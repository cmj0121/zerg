# A module constant is ONE object, read the same wherever it is read.
#   zerg build examples/1g/modconst/main.zg
# Expected output:
#   5
#   7
import "unit"

fn main() {
	print unit.SEED     # 5 — read across the module boundary
	print unit.seeded() # 7 — and from inside the unit that declares it
}
