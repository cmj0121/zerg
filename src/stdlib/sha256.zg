# sha256 — SHA-256 as specified by FIPS 180-4 (pure-Zerg stdlib).
#
# Bundled into a program that writes `import "sha256"`; members are reached through the
# namespace, as `sha256.hex(bytearray(s))`.
#
# PURE ZERG, like every other module here — no libcrypto, no OpenSSL, no runtime leaf. The
# algorithm needs 32-bit unsigned arithmetic and five bitwise operators, and `uint` with
# `& | ^ ~ << >>` is all of it: a `>>` on `uint` is LOGICAL (docs/core/types.md), which is
# what a rotation needs and what the same operator on a signed `int` would not give.
#
# Every intermediate is masked back to 32 bits after it is formed. A `uint` is 64 bits
# wide, so nothing here can overflow on its own — the mask is not overflow protection, it
# is the WORD SIZE, and dropping one is how a hash quietly stops being SHA-256 while still
# looking like a hash.
#
# It is not constant-time and makes no claim to be. The use this exists for is a build
# cache key (`zerg build`), where the property wanted is "two different inputs do not
# collide" and not "an attacker learns nothing from the timing". Do not reach for this to
# check a password.

# MASK32 is the word. Every add, rotate and shift below is masked back through it, because
# a 32-bit algorithm written in 64-bit registers is only 32-bit where it says so.
const MASK32 := uint(0xffffffff)

# The round constants: the first 32 bits of the fractional parts of the cube roots of the
# first sixty-four primes (FIPS 180-4 §4.2.2). They are written out rather than derived —
# a derivation needs a cube root, and a table copied from the standard is checkable against
# it by eye, which a floating-point derivation of the same numbers is not.
fn k_table() -> list[uint] {
	# The numbers keep their OWN default type and the word type is named ONCE, at the loop.
	# Written straight into a `list[uint]`, each of the sixty-four is a literal adopting a
	# type it does not show — sixty-four `uint(…)` wrappers (L502) around a table whose whole
	# value is that it can be checked against the standard by eye.
	src: list[int] = [
		0x428a2f98,
		0x71374491,
		0xb5c0fbcf,
		0xe9b5dba5,
		0x3956c25b,
		0x59f111f1,
		0x923f82a4,
		0xab1c5ed5,
		0xd807aa98,
		0x12835b01,
		0x243185be,
		0x550c7dc3,
		0x72be5d74,
		0x80deb1fe,
		0x9bdc06a7,
		0xc19bf174,
		0xe49b69c1,
		0xefbe4786,
		0x0fc19dc6,
		0x240ca1cc,
		0x2de92c6f,
		0x4a7484aa,
		0x5cb0a9dc,
		0x76f988da,
		0x983e5152,
		0xa831c66d,
		0xb00327c8,
		0xbf597fc7,
		0xc6e00bf3,
		0xd5a79147,
		0x06ca6351,
		0x14292967,
		0x27b70a85,
		0x2e1b2138,
		0x4d2c6dfc,
		0x53380d13,
		0x650a7354,
		0x766a0abb,
		0x81c2c92e,
		0x92722c85,
		0xa2bfe8a1,
		0xa81a664b,
		0xc24b8b70,
		0xc76c51a3,
		0xd192e819,
		0xd6990624,
		0xf40e3585,
		0x106aa070,
		0x19a4c116,
		0x1e376c08,
		0x2748774c,
		0x34b0bcb5,
		0x391c0cb3,
		0x4ed8aa4a,
		0x5b9cca4f,
		0x682e6ff3,
		0x748f82ee,
		0x78a5636f,
		0x84c87814,
		0x8cc70208,
		0x90befffa,
		0xa4506ceb,
		0xbef9a3f7,
		0xc67178f2
	]

	mut out: list[uint] = []
	for v in src {
		out.append(uint(v))
	}
	return out
}

# rotr rotates a 32-bit word right. The left half is masked before the or because a `uint`
# holds the bits a 32-bit register would have dropped, and they would otherwise reappear
# above bit 31 and stay there for the rest of the block.
#
# The DISTANCE is a `uint` and every caller writes `uint(n)`, which is noise a count should
# not need — a shift distance is not a word, it is how far. It is spelled this way because
# the two compilers disagree: `zerg` takes `uint >> int` and the seed refuses it ("operator
# `>>` requires int operands"), and the specification says nothing about the distance's type
# at all. `uint` is what both accept.
fn rotr(x: uint, n: uint) -> uint {
	return ((x >> n) | (x << (uint(32) - n))) & MASK32
}

fn ch(x: uint, y: uint, z: uint) -> uint {
	return ((x & y) ^ ((~x) & z)) & MASK32
}

fn maj(x: uint, y: uint, z: uint) -> uint {
	return (x & y) ^ (x & z) ^ (y & z)
}

fn big_s0(x: uint) -> uint {
	return rotr(x, uint(2)) ^ rotr(x, uint(13)) ^ rotr(x, uint(22))
}

fn big_s1(x: uint) -> uint {
	return rotr(x, uint(6)) ^ rotr(x, uint(11)) ^ rotr(x, uint(25))
}

fn small_s0(x: uint) -> uint {
	return rotr(x, uint(7)) ^ rotr(x, uint(18)) ^ (x >> uint(3))
}

fn small_s1(x: uint) -> uint {
	return rotr(x, uint(17)) ^ rotr(x, uint(19)) ^ (x >> uint(10))
}

# pad_tail is the LAST block or two: whatever is left after the full blocks, then FIPS
# 180-4 §5.1.1's padding — a single 1 bit, as many 0 bits as it takes to leave 64 bits short
# of a block, and the ORIGINAL LENGTH IN BITS as a 64-bit big-endian count. The length is
# what makes the padding unambiguous: without it a message ending in the pad bytes would
# hash as its own shorter prefix.
#
# The tail is built and the rest of the message is read WHERE IT LIES. Padding a copy of the
# whole input is the obvious way to write this and it doubles the memory a digest costs —
# for the caller this exists for, a build cache key over a unit's emitted C, that copy is
# megabytes to add nine bytes at the end of them.
fn pad_tail(data: list[byte], at: int) -> list[byte] {
	bits := uint(data.len()) * uint(8)

	mut out: list[byte] = []
	mut i := at
	for i < data.len() {
		out.append(data[i])
		i = i + 1
	}

	out.append(byte(0x80))
	for out.len() % 64 != 56 {
		out.append(byte(0))
	}

	mut j := 0
	for j < 8 {
		shift := uint(56 - j * 8)
		out.append(byte((bits >> shift) & 0xff))
		j = j + 1
	}
	return out
}

# schedule is a block's message schedule: its sixteen big-endian words, then forty-eight
# more derived from them (FIPS 180-4 §6.2.2).
fn schedule(blk: list[byte], base: int) -> list[uint] {
	mut w: list[uint] = []
	mut t := 0
	for t < 16 {
		o := base + t * 4
		word := (uint(blk[o]) << 24) | (uint(blk[o + 1]) << 16) | (uint(blk[o + 2]) << 8) | uint(blk[o + 3])
		w.append(word)
		t = t + 1
	}
	for t < 64 {
		w.append((small_s1(w[t - 2]) + w[t - 7] + small_s0(w[t - 15]) + w[t - 16]) & MASK32)
		t = t + 1
	}
	return w
}

# compress is the sixty-four rounds over one block, answering the new hash value. It takes
# the OLD one and returns the new rather than writing through a reference: eight words is a
# copy nobody can measure, and a compression function that returns its answer is the shape
# the standard states it in.
fn compress(h: list[uint], w: list[uint], k: list[uint]) -> list[uint] {
	mut a := h[0]
	mut b := h[1]
	mut c := h[2]
	mut d := h[3]
	mut e := h[4]
	mut f := h[5]
	mut g := h[6]
	mut hh := h[7]

	mut t := 0
	for t < 64 {
		t1 := (hh + big_s1(e) + ch(e, f, g) + k[t] + w[t]) & MASK32
		t2 := (big_s0(a) + maj(a, b, c)) & MASK32
		hh = g
		g = f
		f = e
		e = (d + t1) & MASK32
		d = c
		c = b
		b = a
		a = (t1 + t2) & MASK32
		t = t + 1
	}

	return [
		(h[0] + a) & MASK32,
		(h[1] + b) & MASK32,
		(h[2] + c) & MASK32,
		(h[3] + d) & MASK32,
		(h[4] + e) & MASK32,
		(h[5] + f) & MASK32,
		(h[6] + g) & MASK32,
		(h[7] + hh) & MASK32
	]
}

# sum answers the 32-byte digest of `data`.
pub fn sum(data: list[byte]) -> list[byte] {
	k := k_table()

	# the initial hash value: the first 32 bits of the fractional parts of the square roots
	# of the first eight primes (FIPS 180-4 §5.3.3)
	mut h: list[uint] = []
	for v in [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] {
		h.append(uint(v))
	}

	full := data.len() - data.len() % 64
	mut base := 0
	for base < full {
		h = compress(h, schedule(data, base), k)
		base = base + 64
	}

	tail := pad_tail(data, full)
	base = 0
	for base < tail.len() {
		h = compress(h, schedule(tail, base), k)
		base = base + 64
	}

	mut out: list[byte] = []
	for word in h {
		mut i := 0
		for i < 4 {
			shift := uint(24 - i * 8)
			out.append(byte((word >> shift) & 0xff))
			i = i + 1
		}
	}
	return out
}

# hex answers the digest of `data` as 64 lowercase hex characters — the spelling every
# other tool prints, so an answer from here can be compared with one from anywhere else.
pub fn hex(data: list[byte]) -> str {
	digits := "0123456789abcdef"
	dg := bytearray(digits)
	mut out: list[byte] = []
	for b in sum(data) {
		v := int(b)
		out.append(dg[v / 16])
		out.append(dg[v % 16])
	}
	return str(out)
}
