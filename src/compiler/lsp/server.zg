# lsp — the compiler answering an editor's questions instead of a shell's.
#
# The claim LSP.md makes, and the reason this file is short: the language server is NOT a
# new program. It is the compiler that already exists, asked "what is wrong with this
# buffer" instead of "lower this to C". The first question `check_files_diag` has always
# answered; everything here is the plumbing that carries the answer to where a person is
# looking.
#
# EVERY OPEN BUFFER IS THE PROGRAM. What the entry point is handed is the whole document
# store — a path and a text per open buffer — and not the one file that was typed in, because
# an unsaved change in `a.zg` is part of the program an open `b.zg` is checked against. One
# check answers for every open buffer the program it loaded contains, and a buffer whose own
# program contains the file that changed is checked in its turn.
#
# It is a MODULE of its own rather than more files in `src/compiler/zerg/`, because a
# directory is the privacy unit: inside that module this would reach every private
# declaration and grow entangled with the emitter the way everything else that could has.
# Forcing it through `pub` costs a little and is the only thing that ever earns the option
# of splitting it out.
#
# What it does NOT do is resolve `import`. The driver already knows where a module lives —
# an environment variable, then an installation root, then the checkout — and that logic is
# 60 lines of `zergc.zg` this module has no business owning a second copy of. So the entry
# point takes a FUNCTION: hand it a path and the buffers the editor holds, and it hands back
# the whole program that path belongs to, with those texts standing in for what is on disk.
# The module owns the protocol; the driver owns the filesystem.
#
# Scope is LSP.md's Phase 1 and half of Phase 2: diagnostics on open/change/save, and
# formatting. What is missing and why is in docs/tooling/lsp.md.
import (
	"io"
	"json"
	"os"

	"/zerg"
)

# Program is the whole program a buffer belongs to: every source in dependency order, and
# the path each came from. It is a struct rather than two lists because a function returns
# one value, and the two are only ever right together.
pub struct Program {
	pub paths: list[str]
	pub srcs: list[str]

	# mods is the MODULE each of `paths` belongs to, in the same order — the identity table
	# `zerg.Mods` carries into every rule that asks which module a declaration is in.
	#
	# IT IS FILLED BY THE CALLER and never computed here, which is the whole of why this
	# server can hold it at all: resolving a module is `cmd`'s work, this file imports only
	# `io`, `json`, `strconv` and `./zerg`, and the loader arrives as the function value
	# `serve` is handed. So the answer rides in with the sources rather than being derived
	# from them a second time, in a layer that has no business deriving it.
	pub mods: list[str]

	# and what each IMPORT of that program resolved to, which arrives the same way and for the
	# same reason: which module a path names is `cmd`'s answer, not this file's.
	pub imp_at: list[str]
	pub imp_path: list[str]
	pub imp_mod: list[str]
}

# program is the constructor the DRIVER calls. A struct declared here can be read anywhere,
# but the driver is the one that builds it, so the way in is a function of this module's.
pub fn program(paths: list[str], srcs: list[str], mods: list[str], imp_at: list[str], imp_path: list[str], imp_mod: list[str]) -> Program {
	return Program(paths, srcs, mods, imp_at, imp_path, imp_mod)
}

# Doc is an open buffer. The server holds the text because the disk has not seen it: that is
# the whole reason a language server exists, and it is why every compiler entry point this
# file calls takes SOURCE rather than a path.
struct Doc {
	pub uri: str
	pub text: str

	# fixes is every finding in this buffer that carries a fix, as the most recent check that
	# spoke for it found them — what `textDocument/codeAction` answers from, so a quick fix costs
	# a lookup and not a second walk of the program (#204).
	#
	# THEY BELONG TO `text` BY CONSTRUCTION: a new text is stored with none, and every handler
	# that stores one checks it before it reads the next frame, so no request is ever answered
	# from the findings of a text the buffer no longer holds. A buffer whose text did not change
	# keeps them until a check speaks for it again — which is every check whose program contains
	# a file that did change (ls_publish_dependants), and so exactly when they could differ.
	pub fixes: list[zerg.Diag]
}

struct Server {
	pub docs: list[Doc]
	pub buf: list[byte]
	pub stop: bool
	pub down: bool

	# nx is THE NAME INDEX of the last check that reached its end — the one table
	# `definition` and `references` answer from, replaced whole by every check and DROPPED
	# (has_nx false) by one that aborted, so a question after a refusal answers null rather
	# than from a program the compiler no longer agrees is this one. Its places are already
	# LSP's: a 0-based line and UTF-16 columns, converted once when stored (ls_nx_utf16).
	pub nx: zerg.NameIndex
	pub has_nx: bool
}

# Report is what ONE check answers: the open buffers it speaks for, and each one's diagnostics
# in the same row. It is a list and not a single buffer's because a walk of the program found
# what it found about every file of it at once, and the buffers the editor has open are a
# partition of that, not a filter down to one.
struct Report {
	pub uris: list[str]
	pub diags: list[list[json.Val]]
}

# Change is what a `didChange` carried: the new text, and whether there WAS one. The flag is
# not redundant with an empty string — a client that clears a file to nothing sends `""`,
# and a client that sends no change at all must leave the buffer alone.
struct Change {
	pub ok: bool
	pub text: str
}

# serve reads frames until standard input ends or `exit` arrives.
#
# One request at a time, in the order they arrive, with no cancellation — Phase 1's whole
# concurrency design. It is written down rather than assumed: the scheduler is cooperative
# and non-preemptive, so a long check occupies its worker until it finishes, and pretending
# otherwise would mean a queue that silently reorders replies.
pub fn serve(load: fn (str, list[str], list[str]) -> Program) -> int {
	mut docs: list[Doc] = []
	mut buf: list[byte] = []
	mut s := Server(docs, buf, false, false, zerg.no_index(), false)
	for {
		body := ls_read_frame(s)
		break if s.stop
		ls_handle(s, body, load)
	}

	# THE EXIT STATUS IS PART OF THE PROTOCOL. `exit` after `shutdown` is an orderly close
	# and exits 0; `exit` without one — or a standard input that simply ended — is the client
	# having gone away, and exits 1. A server that always exits 0 tells its client that every
	# crash was a clean shutdown.
	return 0 if s.down
	return 1
}

# --- the wire ------------------------------------------------------------------------------
#
# LSP frames a message with a `Content-Length` header and a blank line. The read is over
# `__zrt_read`, which is the runtime's BOUNDED read — up to 4096 bytes, returning what it
# got — and that matters because `io.read_stdin()` reads to end of input, which for a
# session that never ends is a hang on the first request. The leaf was always bounded; only
# the stdlib's loop around it was not.

fn ls_read_frame(mut &s: Server) -> str {
	# the header, which ends at the first blank line
	mut hdr := ls_find_blank(s.buf)
	for hdr < 0 {
		if not ls_fill(s) {
			s.stop = true
			return ""
		}
		hdr = ls_find_blank(s.buf)
	}

	n := ls_content_length(s.buf, hdr)
	if n < 0 {
		# A frame with no length is one that cannot be skipped either — there is no way to
		# know where it ends. Dropping the header and resynchronising is the best that can
		# be done, and it is loud.
		ls_log(f"lsp: a frame arrived with no Content-Length; {hdr + 4} bytes dropped")
		s.buf = ls_drop_front(s.buf, hdr + 4)
		return ls_read_frame(s)
	}

	for s.buf.len() < hdr + 4 + n {
		if not ls_fill(s) {
			ls_log("lsp: standard input ended in the middle of a message")
			s.stop = true
			return ""
		}
	}

	body := ls_slice_str(s.buf, hdr + 4, hdr + 4 + n)
	s.buf = ls_drop_front(s.buf, hdr + 4 + n)
	return body
}

# ls_fill reads one chunk, answering false at end of input. It is the only place this server
# blocks, which is what makes the loop above readable as a loop.
fn ls_fill(mut &s: Server) -> bool {
	chunk := __zrt_read(0)
	return false if chunk.len() == 0
	for c in chunk {
		s.buf.append(c)
	}
	return true
}

# ls_find_blank is the index of the `\r\n\r\n` that ends the header block, or -1.
fn ls_find_blank(buf: list[byte]) -> int {
	mut i := 0
	for i + 3 < buf.len() {
		return i if buf[i] == b'\r' and buf[i + 1] == b'\n' and buf[i + 2] == b'\r' and buf[i + 3] == b'\n'
		i = i + 1
	}
	return -1
}

# ls_content_length reads the one header this server needs. Header names are
# case-insensitive, and a client that writes `content-length` is within the protocol.
fn ls_content_length(buf: list[byte], hdr: int) -> int {
	head := ls_slice_str(buf, 0, hdr)
	for line in ls_split_lines(head) {
		k := ls_lower(ls_before_colon(line))
		continue if k != "content-length"
		return ls_int_of(ls_trim(ls_after_colon(line)))
	}
	return -1
}

# ls_send writes one frame. The length is in BYTES, which is what `list[byte]` counts and what
# a `str`'s length would not: a message carrying a diagnostic with an em-dash in it is
# longer on the wire than it is on the page.
fn ls_send(v: json.Val) {
	body := json.encode(v)
	n := bytearray(body).len()
	io.write(f"Content-Length: {n}\r\n\r\n{body}")
}

fn ls_log(msg: str) {
	io.ewrite(msg + "\n")
}

# --- dispatch ---------------------------------------------------------------------------

fn ls_handle(mut &s: Server, body: str, load: fn (str, list[str], list[str]) -> Program) {
	# A frame that is not JSON has no id to answer with, so there is nobody to tell. It is
	# logged and the session goes on, which is the only thing that leaves the editor usable.
	msg := match guard {
		json.decode(body)
	} {
		Either.Left(v)  => v
		Either.Right(e) => json.null()
	}
	if json.is_null(msg) {
		ls_log("lsp: a frame that is not JSON was dropped")
		return
	}

	method := json.as_str(json.get(msg, "method"))
	id := json.get(msg, "id")
	has_id := not json.is_null(id)

	# After `shutdown` the session accepts nothing but `exit`. A request that arrives anyway
	# is answered — with InvalidRequest, which is what the protocol says and, more to the
	# point, is an answer: a client left waiting for a reply it will never get is one that
	# stops sending the next one. A notification after shutdown is dropped, which is also
	# what the protocol says.
	if s.down and method != "exit" {
		if has_id {
			ls_error_reply(id, -32600, "zerg lsp has shut down and answers nothing but `exit`")
		}
		return
	}

	if method == "initialize" {
		ls_reply(id, ls_initialize_result())
	} else if method == "shutdown" {
		s.down = true
		ls_reply(id, json.null())
	} else if method == "exit" {
		s.stop = true
	} else if method == "textDocument/didOpen" {
		uri := json.as_str(json.walk3(msg, "params", "textDocument", "uri"))
		ls_put_doc(s, uri, json.as_str(json.walk3(msg, "params", "textDocument", "text")))
		ls_publish(s, uri, load)
	} else if method == "textDocument/didChange" {
		uri := json.as_str(json.walk3(msg, "params", "textDocument", "uri"))
		ch := ls_full_text(json.get(json.get(msg, "params"), "contentChanges"))
		if ch.ok {
			ls_put_doc(s, uri, ch.text)
			ls_publish(s, uri, load)
		}
	} else if method == "textDocument/didSave" {
		uri := json.as_str(json.walk3(msg, "params", "textDocument", "uri"))

		# `text` rides along only when the client was asked for it, and this server does not
		# ask: the buffer it already holds is the one the editor just wrote.
		ls_publish(s, uri, load)
	} else if method == "textDocument/didClose" {
		uri := json.as_str(json.walk3(msg, "params", "textDocument", "uri"))
		ls_drop_doc(s, uri)
		ls_send(ls_notification("textDocument/publishDiagnostics", ls_diagnostics_params(uri, [])))

		# AND THE BUFFERS THAT WERE READING IT. A closed file is the disk again, so a buffer
		# whose program contains it was answered against a text that no longer stands in for
		# anything — which is the same staleness a change causes, arriving the other way round.
		ls_publish_dependants(s, ls_uri_path(uri), [], load)
	} else if method == "textDocument/formatting" {
		ls_reply(id, ls_formatting_result(s, json.as_str(json.walk3(msg, "params", "textDocument", "uri"))))
	} else if method == "textDocument/codeAction" {
		params := json.get(msg, "params")
		uri := json.as_str(json.walk3(msg, "params", "textDocument", "uri"))
		ls_reply(id, ls_code_action_result(s, uri, ls_req_span(params)))
	} else if method == "textDocument/documentSymbol" {
		ls_document_symbol_reply(s, id, json.as_str(json.walk3(msg, "params", "textDocument", "uri")))
	} else if method == "textDocument/definition" {
		ls_reply(id, ls_definition_result(s, json.get(msg, "params")))
	} else if method == "textDocument/references" {
		ls_reply(id, ls_references_result(s, json.get(msg, "params")))
	} else if method == "textDocument/hover" {
		ls_reply(id, ls_hover_result(s, json.get(msg, "params"), load))
	} else if has_id {
		# EVERY request gets an answer. A client that is left waiting for one it will never
		# get is a client that stops sending the next one, and the editor goes quiet with
		# nothing said — which is the failure a language server is least able to explain.
		ls_error_reply(id, -32601, f"zerg lsp does not implement `{method}`")
	}
}

fn ls_reply(id: json.Val, result: json.Val) {
	mut fs: list[json.Field] = []
	json.put_str(fs, "jsonrpc", "2.0")
	json.put(fs, "id", id)
	json.put(fs, "result", result)
	ls_send(json.of_obj(fs))
}

fn ls_error_reply(id: json.Val, code: int, msg: str) {
	mut ef: list[json.Field] = []
	json.put_int(ef, "code", code)
	json.put_str(ef, "message", msg)

	mut fs: list[json.Field] = []
	json.put_str(fs, "jsonrpc", "2.0")
	json.put(fs, "id", id)
	json.put(fs, "error", json.of_obj(ef))
	ls_send(json.of_obj(fs))
}

fn ls_notification(method: str, params: json.Val) -> json.Val {
	mut fs: list[json.Field] = []
	json.put_str(fs, "jsonrpc", "2.0")
	json.put_str(fs, "method", method)
	json.put(fs, "params", params)
	return json.of_obj(fs)
}

# ls_initialize_result declares exactly what is built and nothing that is not. A capability
# claimed and unimplemented is worse than one absent: the client stops offering the user an
# alternative and waits for a server that will not answer.
#
# `textDocumentSync: 1` is FULL — the whole buffer arrives on every change. Phase 1 re-checks
# it from scratch anyway, so incremental sync would be bookkeeping in service of nothing.
fn ls_initialize_result() -> json.Val {
	mut caps: list[json.Field] = []
	json.put_int(caps, "textDocumentSync", 1)
	json.put_bool(caps, "documentFormattingProvider", true)

	# The code actions this server offers are all QUICK FIXES, and saying so is not decoration:
	# an editor uses the kind to decide what a keystroke reaches and what only a menu does, and
	# a client that asks `only: ["quickfix"]` gets nothing from a server that declares no kinds.
	mut ca: list[json.Field] = []
	json.put(ca, "codeActionKinds", json.of_list([json.of_str("quickfix")]))
	json.put(caps, "codeActionProvider", json.of_obj(ca))

	# The outline. It is the one answer that needs NO name resolution — a declaration knows
	# what it is called and where it was written.
	json.put_bool(caps, "documentSymbolProvider", true)

	# A name's declaration and its uses — both answered from the one index the check builds
	# (#24), which is the compiler's resolution recorded as it happened.
	json.put_bool(caps, "definitionProvider", true)
	json.put_bool(caps, "referencesProvider", true)

	# And that declaration's DOCUMENT (#192) — the comment `zerg doc` prints for it, extracted
	# by `zerg doc`'s own reader rather than by a second one living here.
	json.put_bool(caps, "hoverProvider", true)

	mut info: list[json.Field] = []
	json.put_str(info, "name", "zerg")
	json.put_str(info, "version", zerg.zerg_version())

	mut fs: list[json.Field] = []
	json.put(fs, "capabilities", json.of_obj(caps))
	json.put(fs, "serverInfo", json.of_obj(info))
	return json.of_obj(fs)
}

# ls_full_text takes the text of the final content change. Under full sync there is exactly
# one and it carries the whole document; taking the last rather than the first keeps that
# true if a client ever batches.
#
# It answers whether there was a change at all, and REFUSES one that is not a full document.
# Both halves were defects. An empty `contentChanges` array replaced the buffer with the
# empty string, so a change notification carrying nothing wiped the file the editor was
# showing and every diagnostic with it. And a change carrying a `range` is an INCREMENTAL
# edit — which this server never asked for, having declared full sync — so applying its
# `text` would replace the whole document with a fragment of itself.
fn ls_full_text(changes: json.Val) -> Change {
	mut out := Change(false, "")
	for c in json.as_list(changes) {
		if json.has(c, "range") {
			ls_log("lsp: an incremental change arrived for a server that declared full sync; the buffer is left as it was")
			return Change(false, "")
		}
		out = Change(true, json.as_str(json.get(c, "text")))
	}
	return out
}

# --- the document store ---------------------------------------------------------------

fn ls_put_doc(mut &s: Server, uri: str, text: str) {
	mut i := 0
	for i < s.docs.len() {
		if s.docs[i].uri == uri {
			s.docs[i] = Doc(uri, text, [])
			return
		}
		i = i + 1
	}
	s.docs.append(Doc(uri, text, []))
}

# ls_keep_fixes records what a check found fixable in `uri`'s buffer, as the answer every code
# action on it gives until a check speaks for it again.
fn ls_keep_fixes(mut &s: Server, uri: str, fixes: list[zerg.Diag]) {
	mut i := 0
	for i < s.docs.len() {
		if s.docs[i].uri == uri {
			s.docs[i].fixes = fixes
			return
		}
		i = i + 1
	}
}

fn ls_drop_doc(mut &s: Server, uri: str) {
	mut out: list[Doc] = []
	for d in s.docs {
		if d.uri != uri {
			out.append(d)
		}
	}
	s.docs = out
}

fn ls_doc_text(s: Server, uri: str) -> str {
	for d in s.docs {
		return d.text if d.uri == uri
	}
	return ""
}

fn ls_has_doc(s: Server, uri: str) -> bool {
	for d in s.docs {
		return true if d.uri == uri
	}
	return false
}

fn ls_doc_uris(s: Server) -> list[str] {
	mut out: list[str] = []
	for d in s.docs {
		out.append(d.uri)
	}
	return out
}

# ls_doc_paths and ls_doc_texts are the document store as the LOADER takes it: every open
# buffer's file, and the text the editor is holding for it. They are what stands in for the
# disk, so they travel together and in the same order.
fn ls_doc_paths(s: Server) -> list[str] {
	mut out: list[str] = []
	for d in s.docs {
		out.append(ls_uri_path(d.uri))
	}
	return out
}

fn ls_doc_texts(s: Server) -> list[str] {
	mut out: list[str] = []
	for d in s.docs {
		out.append(d.text)
	}
	return out
}

fn ls_has_str(xs: list[str], x: str) -> bool {
	for v in xs {
		return true if v == x
	}
	return false
}

# --- diagnostics ---------------------------------------------------------------------------

# ls_publish answers a change to one buffer, for every buffer that change reaches.
#
# ONE CHECK PER PROGRAM, not one per buffer. The buffer that changed is checked, and that one
# walk already carries a finding for every file of its program — so the open buffers that
# program contains are published out of it by PARTITIONING what it said by path, which costs
# nothing beyond the check that was happening anyway.
#
# WHAT THAT PROGRAM DOES NOT CONTAIN IS ASKED SEPARATELY, and that is not a patch over a
# corner of the loader. `load_buffer` answers a question with ONE answer — what is THE program
# of this buffer, the first candidate entry that reaches it — while "which open buffers are
# stale now that this file changed" has as many answers as there are programs containing it.
# Two entries importing one module is the general shape; `lib.zg` and the `main.zg` beside it
# that imports it, where `lib.zg`'s own program is `lib.zg` alone, is the smallest one. Such a
# buffer is stale exactly when ITS program contains the file that changed, which is what the
# loader's import graph says and nothing about a name or a directory does.
#
# So a keystroke costs one check while the open buffers share a program, and one load and one
# check per program that genuinely contains the file after that. It also means every check in
# a round covers the buffer that changed, which is what keeps the name index (`s.nx`) an index
# of a program this buffer is in however many of them ran.
fn ls_publish(mut &s: Server, uri: str, load: fn (str, list[str], list[str]) -> Program) {
	rep := ls_check(s, uri, load, [], true)
	ls_publish_dependants(s, ls_uri_path(uri), ls_publish_report(rep), load)
}

# ls_publish_dependants publishes every open buffer whose program contains `path` and that
# `done` does not already speak for, one check per program.
#
# THE PROGRAM THE QUESTION WAS ANSWERED WITH IS THE ONE CHECKED. Asking whether a buffer is
# stale means loading its program, and loading is the import walk plus a parse of every file in
# it — so the answer is carried into the check rather than thrown away and re-walked, which is
# what asking a loader a yes-or-no question would otherwise cost twice.
#
# AND IT IS ASKED PER PROGRAM, NOT PER BUFFER. One load answers for every open buffer that
# program contains: they are in it, so it is their program too, and asking each of them
# separately is the same walk again per buffer. Four buffers of one other program used to cost
# four full loads on every keystroke.
fn ls_publish_dependants(mut &s: Server, path: str, done: list[str], load: fn (str, list[str], list[str]) -> Program) {
	mut said := done

	# `asked` is every buffer this round has an answer for — published, or found not to be in
	# a program containing `path`. `said` is the published half alone, because that is what
	# decides who a later check may speak for and this is what decides who is still to ask.
	mut asked := done

	# a SNAPSHOT, because the loop body hands `s` on by reference — iterating the store while
	# something else may reach it is the aliasing this copy exists to prevent
	uris := ls_doc_uris(s)
	for u in uris {
		continue if ls_has_str(asked, u)

		prog := ls_load(s, ls_uri_path(u), load)
		if not ls_has_str(prog.paths, path) {
			for v in uris {
				if ls_has_str(prog.paths, ls_uri_path(v)) {
					asked.append(v)
				}
			}
			asked.append(u)
			continue
		}

		for p in ls_publish_report(ls_check_program(s, u, prog, said, false)) {
			said.append(p)
			asked.append(p)
		}
		asked.append(u)
	}
}

# ls_publish_report sends one check's answer — a frame per open buffer it spoke for — and
# answers with those buffers' uris, which is what says who is already spoken for.
fn ls_publish_report(rep: Report) -> list[str] {
	mut i := 0
	for i < rep.uris.len() {
		ls_send(ls_notification("textDocument/publishDiagnostics", ls_diagnostics_params(rep.uris[i], rep.diags[i])))
		i = i + 1
	}
	return rep.uris
}

# ls_load is the program `path` belongs to as the EDITOR holds it, or an EMPTY one where the
# loader raised. It is for the answers that are a view rather than a verdict — which files a
# program contains, a hover: a refusal inside `load` is a finding `ls_check`
# publishes with the sentence it raised, and a caller that repeated it would say the same thing
# twice in two places. What they do instead is answer with less.
fn ls_load(s: Server, path: str, load: fn (str, list[str], list[str]) -> Program) -> Program {
	res := guard {
		load(path, ls_doc_paths(s), ls_doc_texts(s))
	}
	return match res {
		Either.Left(p)  => p
		Either.Right(_) => program([], [], [], [], [], [])
	}
}

fn ls_diagnostics_params(uri: str, ds: list[json.Val]) -> json.Val {
	mut fs: list[json.Field] = []
	json.put_str(fs, "uri", uri)
	json.put(fs, "diagnostics", json.of_list(ds))
	return json.of_obj(fs)
}

# ls_check asks the compiler the three questions it can already answer about a buffer, in the
# order the compiler itself asks them.
#
# LEXICAL FIRST, and alone. A source that does not lex is not a program, and the driver
# stops there for the same reason: a parser handed unreadable text can only say something
# untrue about it. Reporting a parse error beside `E1001 a string literal is not closed`
# would be exactly that untrue thing.
#
# EVERY CHECK REPLACES THE SESSION'S NAME INDEX: dropped first, and stored again only by a walk
# that reached its end — so a buffer that stops lexing, loading or lowering answers `definition`
# with null until one that does, rather than with the positions of a program it no longer is.
#
# IT ANSWERS FOR EVERY OPEN BUFFER THE PROGRAM CONTAINS, not for `uri` alone — minus the ones
# `said` names, which an earlier check of this round already published. The walk found what it
# found about every file at once; publishing only this one and reading the rest from disk on
# their own next keystroke is what left an open `b.zg` showing findings about an `a.zg` nobody
# has any more.
#
# A failure BEFORE the walk speaks for ONE buffer: the one whose text failed. A buffer that
# will not lex is its own finding, and so is the file an aborting load names — which is why
# that is published in the buffer the place belongs to rather than in this one. The others are
# left exactly as they were: a program with a file missing from it can only say things about
# the rest that are not true.
#
# `subject` is whether this is the check the round is FOR. Only that one touches the session's
# name index, so a dependant checked afterwards cannot answer `definition` from a program the
# cursor is not in.
fn ls_check(mut &s: Server, uri: str, load: fn (str, list[str], list[str]) -> Program, said: list[str], subject: bool) -> Report {
	path := ls_uri_path(uri)
	text := ls_doc_text(s, uri)
	mut out: list[json.Val] = []
	if subject {
		s.nx = zerg.no_index()
		s.has_nx = false
	}

	# ONCE, for every finding this check will publish — see `the buffer, split once`
	lines := ls_lines(text)
	lex := zerg.lex_diags(text, path)
	if lex.len() > 0 {
		for d in lex {
			out.append(ls_diagnostic(lines, d, 1))
		}
		return Report([uri], [out])
	}

	# LOADING can abort too, and that was this server's first real bug: a refusal the
	# PARSER raises — `#[dyn]` is one — happened inside `load`, the empty program that came
	# back was read as "nothing to check", and the editor showed a clean buffer for a file
	# the compiler will not build. An abort here is a finding, not an absence.
	res := guard {
		load(path, ls_doc_paths(s), ls_doc_texts(s))
	}
	lerr := match res {
		Either.Left(_)  => ""
		Either.Right(e) => e.message()
	}
	return ls_aborted(s, uri, lerr, "") if lerr != ""

	prog := match res {
		Either.Left(p)  => p
		Either.Right(_) => program([], [], [], [], [], [])
	}
	return ls_check_program(s, uri, prog, said, subject)
}

# ls_abort_report is an abort published in the buffer it is ABOUT. The sentence names a place,
# and where that place is a file the editor has open, that buffer is the one the finding
# belongs in — a lex error in `lib.zg` is `lib.zg`'s to show, whichever buffer was being typed
# in when the load went looking for it. Where it names no open buffer it lands at the top of
# the buffer that asked, with its `-->` line intact, which is then the only thing saying where
# to look.
#
# Nothing else is published: the buffers of a program that would not load are left as they
# were rather than re-checked against a program missing a file.
#
# `of` is the declaration an abort raised inside an expansion was expanded for (ls_abort_for),
# and empty for every other abort.
fn ls_abort_report(s: Server, uri: str, msg: str, of: str) -> Report {
	owner := ls_abort_owner(s, uri, msg)
	one := [ls_abort_diag(ls_uri_path(owner), ls_doc_text(s, owner), msg, of)]
	return Report([owner], [one])
}

# ls_aborted is that report, and what it says about the quick fixes: none, in the buffer that
# was checked and in the one the abort is published in. A program that aborted has no notes —
# the walk that writes them did not finish — and a walk of it for a code action would abort the
# same way and offer nothing either.
fn ls_aborted(mut &s: Server, uri: str, msg: str, of: str) -> Report {
	rep := ls_abort_report(s, uri, msg, of)
	ls_keep_fixes(s, uri, [])
	ls_keep_fixes(s, rep.uris[0], [])
	return rep
}

# ls_abort_owner is the open buffer the abort's place names, and `uri` when it names none. A
# place in an expansion names the file the decorator is written in, for the reason a finding's
# does (ls_check_program).
fn ls_abort_owner(s: Server, uri: str, msg: str) -> str {
	at := ls_abort_place(msg)
	return uri if not at.ok

	file := zerg.derive_origin(at.path)
	for d in s.docs {
		return d.uri if ls_uri_path(d.uri) == file
	}
	return uri
}

# ls_abort_for is the declaration the walk's abort was expanded for, read off the findings it
# left: the compiler leaves an abort raised inside an expansion on that list too, with no code
# and the abort's whole text as its sentence (emit.c_fn_told), because the text cannot say it.
fn ls_abort_for(ds: list[zerg.Diag], msg: str) -> str {
	for d in ds {
		return d.derived_for if d.code == "" and d.msg == msg
	}
	return ""
}

# ls_check_program is that check from the program onwards, and it is a function of its own
# because the answer to "is this buffer stale" IS a loaded program: a dependant is found by
# loading it, and walking it again to check it would be paying the loader twice for one
# question.
fn ls_check_program(mut &s: Server, uri: str, prog: Program, said: list[str], subject: bool) -> Report {
	none: list[json.Val] = []
	return Report([uri], [none]) if prog.srcs.len() == 0

	# THE WHOLE PROGRAM, not the buffer alone. A file that imports another module is checked
	# against that module or every name it borrowed reads as undefined — which is a server
	# that underlines correct code, the one failure that makes a person turn it off.
	#
	# AND NOT `emit_files_diag`. The two run the same walk and report the same findings —
	# scripts/check-equal.sh is what says so — but only one of them also builds the C, and
	# building it is what was killing this process: 2.8 GB per check against 0.22 GB, on a
	# program the size of the compiler's own source, for a string this function never had a
	# use for. A long session was SIGKILLed on the third or fourth keystroke batch.
	#
	# AND ONE WALK FOR BOTH HALVES: `check_and_lint` asks `check_files_diag`'s question and
	# `lint_program`'s of a single lowering walk (lint.zg says why). The errors land in `ds`
	# and the lint findings come back.
	#
	# The block ends in `ds.len()` because a `guard` carries a value and this call answers
	# through its out-parameters. The count is not read; what is read is whether the walk
	# reached the end of it at all.
	#
	# AND THE NAME INDEX FROM THE SAME WALK (`check_lint_index`), which costs recording and not a
	# second walk. It is written only if the walk returns.
	#
	# AND THE QUICK FIXES FROM IT TOO: `notes` is the walk's L5xx notes with their `fix`, kept per
	# buffer below so a code action is answered without walking again (#204).
	mut ds: list[zerg.Diag] = []
	mut lints: list[zerg.Finding] = []
	mut nx := zerg.no_index()
	mut notes: list[zerg.Diag] = []
	err := match guard {
		lints = zerg.check_lint_index(prog.srcs, prog.paths, zerg.mods_of(prog.paths, prog.mods, prog.imp_at, prog.imp_path, prog.imp_mod), ds, nx, notes)
		ds.len()
	} {
		Either.Left(_)  => ""
		Either.Right(e) => e.message()
	}

	# An ABORT is a refusal or a parse error, raised as a sentence naming a place, and it is
	# published in the buffer that place belongs to — ls_abort_report says which.
	return ls_aborted(s, uri, err, ls_abort_for(ds, err)) if err != ""

	if subject {
		ls_nx_utf16(nx, prog.paths, prog.srcs)
		s.nx = nx
		s.has_nx = true
	}

	# AND THE FINDINGS PARTITIONED BY FILE. Each open buffer of this program gets the findings
	# that name it: the errors this walk raised about that file, and after them its lint
	# findings. The file a finding names is read through `derive_origin`, because a tree a
	# decorator expanded is walked at `<derive:FILE>` and its findings are FILE's to show —
	# compared against the buffer's own path they matched nothing and were dropped, which is an
	# editor silent about a finding `zerg build` prints.
	#
	# EVERY LINT FINDING, AS `zerg lint` REPORTS IT. It used to be `lint_conversions` — the
	# L5xx family alone — which meant the server had a private answer to "what does the
	# linter say about this file": every rule `lint_merged` runs over the tree was missing,
	# and so was `#[allow(…)]`, which lives in the linter and would otherwise have had to be
	# applied a second time here. `check_and_lint` answers with the rules `lint_program` runs,
	# and guards the tree rules itself, so a raise among them costs the lint half and not the
	# check.
	#
	# The pass is per BUFFER over the findings rather than per finding into buckets, because
	# the buffers are the few — an editor holds a handful open — and a list read twice is
	# cheaper than a table of lists written once.
	mut uris: list[str] = []
	mut each: list[list[json.Val]] = []
	for u in ls_answered_for(s, prog.paths, uri, said) {
		p := ls_uri_path(u)
		text := ls_doc_text(s, u)
		lines := ls_lines(text)
		mut one: list[json.Val] = []
		for d in ds {
			if zerg.derive_origin(d.path) == p {
				one.append(ls_finding(d.path, ls_extent_span(lines, d.line, d.col, d.end_line, d.end_col), text, d.derived_for, d.code, d.msg, 1))
			}
		}
		for f in lints {
			if zerg.derive_origin(f.path) == p {
				one.append(ls_finding(f.path, ls_word_span(lines, f.line, f.col), text, "", f.code, f.msg, ls_severity(f.sev)))
			}
		}
		ls_keep_fixes(s, u, ls_fixes_in(notes, p))
		uris.append(u)
		each.append(one)
	}
	return Report(uris, each)
}

# ls_finding is one finding as a diagnostic, and the one thing it decides is WHERE.
#
# A finding the walk raised in a file carries that file's line and column, and it is drawn
# there. A finding raised in a tree the compiler WROTE — `<derive:FILE>` — carries a place in
# that tree, which is a line of text nobody has: drawn in FILE's buffer it would underline
# whatever happens to sit at that line. So it is drawn at the DECORATOR that wrote the tree,
# the line in `text` a reader has to go and change. Which decorator is the declaration the
# finding was expanded for (ast.Diag.derived_for), because every expansion of one file shares
# the one path. A finding that names none lands at the top of the file with its whole
# sentence, for the reason an abort with no place in this buffer does.
fn ls_finding(path: str, at: Span, text: str, of: str, code: str, msg: str, severity: int) -> json.Val {
	return ls_diagnostic_over(at, code, msg, severity) if zerg.derive_origin(path) == path

	return ls_diagnostic_over(ls_decorator_span(text, of), code, msg, severity)
}

# ls_decorator_span is where the decorator on the declaration `of` is written in `text`, and
# the top of the file where there is none to find. The buffer is re-read for it here and only
# here, because a finding in an expansion is the rare one and every other costs nothing more.
fn ls_decorator_span(text: str, of: str) -> Span {
	return Span(0, 0, 0, 0) if of == ""

	at := zerg.decorator_at(text, of)
	return Span(0, 0, 0, 0) if at.line == 0

	return ls_span_at(ls_lines(text), at.line, at.col, at.end_line, at.end_col)
}

# ls_answered_for is the open buffers one check speaks for: the one that was checked, first,
# and then every other the program CONTAINS and this round has not already published. Which
# those are is the loader's answer — the paths it walked to — and not a guess from a name or a
# directory.
#
# A BUFFER IS PUBLISHED ONCE PER ROUND, and which check speaks for it is decided by the round's
# subject: a buffer in the subject's program is answered from that program, and any other from
# its own. Both programs are a real answer for a file that belongs to both, and the difference
# is visible — one holds the buffer being typed in and the other does not — so letting the last
# check of the round overwrite the first made a file's diagnostics depend on which sibling the
# cursor happened to be in.
fn ls_answered_for(s: Server, paths: list[str], uri: str, said: list[str]) -> list[str] {
	mut out: list[str] = [uri]
	for d in s.docs {
		continue if d.uri == uri
		continue if ls_has_str(said, d.uri)

		if ls_has_str(paths, ls_uri_path(d.uri)) {
			out.append(d.uri)
		}
	}
	return out
}

# ls_severity maps the linter's severity onto LSP's. A lint finding is never an ERROR:
# severity 1 is what `zerg build` refuses over, and every one of these is a legal program
# that builds — a server that paints a working program red teaches its user to ignore red.
# So the linter's three levels land on the three that remain, IN ORDER, because they are
# ordered: a finding fails `zerg lint`, a warning is printed and exits 0, an info never
# gates anything (docs/tooling/lint.md, "A finding carries a severity").
fn ls_severity(sev: str) -> int {
	return 3 if sev == "warning"

	return 4 if sev == "info"

	return 2
}

# ls_abort_diag publishes an abort AT THE PLACE ITS SENTENCE NAMES, when it names one in this
# buffer. A raise carries no `Diag`, only a string, so the place is read back out of the one
# layout the compiler writes it in: a last line that is exactly `ast.place_line`'s
# `  --> file:line:col`, which is what `zerg build` prints under the sentence. Nothing looser
# is read — a pathless `  --> line:col` knows no file, and a number that is not all digits is
# not a place — because an underline in the wrong place is worse than one at the top: it
# accuses a line that is not the problem.
#
# A place in ANOTHER file of the program is not this buffer's to underline, so that finding
# stays at the top with its trailer intact: the sentence is then the only thing that says
# where to look. In this buffer the trailer is dropped, because the range now says it.
#
# A place in an EXPANSION of this buffer's file is drawn where a finding there is — at the
# decorator on `of` (ls_decorator_span) — and, with no `of` to find one by, it stays at the top
# with its trailer, the one thing then saying which tree it is in.
fn ls_abort_diag(path: str, text: str, msg: str, of: str) -> json.Val {
	at := ls_abort_place(msg)

	return ls_whole_file_diag(msg) if not at.ok or zerg.derive_origin(at.path) != path
	return ls_whole_file_diag(msg) if at.path != path and of == ""

	sentence := ls_slice_str(bytearray(msg), 0, at.cut)
	code := zerg.rule_msg_code(sentence)
	says := zerg.rule_msg_says(sentence)
	return ls_diagnostic_over(ls_decorator_span(text, of), code, says, 1) if at.path != path

	return ls_diagnostic_at(ls_lines(text), at.line, at.col, code, says, 1)
}

# Place is the trailer read back out of an abort: the file, the line and the column it names,
# and where the sentence ends — `ok` false when the last line is not exactly that layout.
struct Place {
	pub ok: bool
	pub path: str
	pub line: int
	pub col: int
	pub cut: int
}

# ls_abort_place is the ONE reader of that layout. Two questions are asked of it — which buffer
# the finding belongs in, and where in that buffer to draw it — and a second copy of the parse
# is how the two would come to disagree about the same sentence.
fn ls_abort_place(msg: str) -> Place {
	none := Place(false, "", 0, 0, 0)
	b := bytearray(msg)
	nl := ls_last_byte(b, b'\n', b.len() - 1)
	return none if nl < 0 or not ls_starts_with(ls_slice_str(b, nl + 1, b.len()), "  --> ")

	# the path starts past `\n  --> `, and runs to the second-last colon: a path may hold one
	at := nl + 7
	c2 := ls_last_byte(b, b':', b.len() - 1)
	c1 := ls_last_byte(b, b':', c2 - 1)
	return none if c1 <= at

	line := ls_digits(ls_slice_str(b, c1 + 1, c2))
	col := ls_digits(ls_slice_str(b, c2 + 1, b.len()))
	return none if line < 1 or col < 1

	return Place(true, ls_slice_str(b, at, c1), line, col, nl)
}

# ls_last_byte is the index of the last `c` at or before `upto`, and -1 when there is none.
fn ls_last_byte(b: list[byte], c: byte, upto: int) -> int {
	mut i := upto
	for i >= 0 and b[i] != c {
		i = i - 1
	}
	return i
}

# ls_digits is a run of decimal digits as a number, and -1 for anything else — an empty run
# included, and a run with anything after it, whose front ls_int_of would read.
fn ls_digits(s: str) -> int {
	b := bytearray(s)
	return -1 if b.len() == 0
	for c in b {
		return -1 if c < b'0' or c > b'9'
	}
	return ls_int_of(s)
}

# ls_whole_file_diag is the abort's sentence, with a range of NOTHING at the top of the
# file. A zero-width range and not the word there: an underline drawn under `fn` says the
# `fn` is wrong, and the one thing known about this finding is that it has no place in this buffer.
fn ls_whole_file_diag(msg: str) -> json.Val {
	return ls_diagnostic_over(Span(0, 0, 0, 0), zerg.rule_msg_code(msg), zerg.rule_msg_says(msg), 1)
}

# A finding that carries an EXTENT is published over it — the statement the compiler named —
# and one that carries only a place still gets the word standing there. The two are told apart
# and not blended: a `Diag` whose end is 0 came through a channel with no extent (ast.zg,
# `Diag.end_line`), and publishing the start twice would be a point wearing the name of a span.
fn ls_diagnostic(lines: list[list[byte]], d: zerg.Diag, severity: int) -> json.Val {
	return ls_diagnostic_over(ls_extent_span(lines, d.line, d.col, d.end_line, d.end_col), d.code, d.msg, severity)
}

# `code` is LSP's `Diagnostic.code`, and it is sent because the compiler has it as data
# (`Diag.code`). A finding without one omits the field rather than sending an empty string,
# which an editor would show as a rule named "".
fn ls_diagnostic_at(lines: list[list[byte]], line: int, col: int, code: str, msg: str, severity: int) -> json.Val {
	return ls_diagnostic_over(ls_word_span(lines, line, col), code, msg, severity)
}

# ls_extent_span is THE rule about an end, in one place: where the compiler gave one it is the
# range, and where it did not the range is the word at the place. It was written twice — once
# for a finding and once for an outline entry — which is one rule with two homes and a change
# to it that lands in one of them.
fn ls_extent_span(lines: list[list[byte]], line: int, col: int, el: int, ec: int) -> Span {
	return ls_word_span(lines, line, col) if el < line

	return ls_span_at(lines, line, col, el, ec)
}

fn ls_diagnostic_over(sp: Span, code: str, msg: str, severity: int) -> json.Val {
	mut fs: list[json.Field] = []
	json.put(fs, "range", ls_span_range(sp))
	json.put_int(fs, "severity", severity)
	json.put_str(fs, "source", "zerg")
	if code != "" {
		json.put_str(fs, "code", code)
	}
	json.put_str(fs, "message", msg)
	return json.of_obj(fs)
}

# --- names -------------------------------------------------------------------------------
#
# `definition` and `references` are two views of ONE index (zerg.NameIndex): the use under the
# cursor names a declaration, and a declaration's references are every use naming it — its own
# name included, since a declaration is recorded as its own use. Neither resolves anything: an
# answer the index does not hold is null, which is what a name the compiler resolved to nothing
# (a built-in, an intrinsic, a template nobody instantiated) honestly has.

# ls_nx_utf16 is the index with its places in LSP's units — a 0-based line and a UTF-16 column
# and length — converted ONCE, as it is stored, so no request reads a source again and none has
# to be kept for it.
#
# Each file is read as bytes once, with where every line starts, and every column is counted by
# the one rule the diagnostics use (ls_utf16_from).
fn ls_nx_utf16(mut &nx: zerg.NameIndex, paths: list[str], srcs: list[str]) {
	mut text: list[list[byte]] = []
	mut starts: list[list[int]] = []
	for p in nx.files {
		b := bytearray(ls_src_of(paths, srcs, p))
		text.append(b)
		starts.append(ls_line_starts(b))
	}
	mut i := 0
	for i < nx.u_file.len() {
		f := nx.u_file[i]
		at := ls_start_of(starts[f], nx.u_line[i] - 1)
		c0 := ls_utf16_from(text[f], at, nx.u_col[i] - 1)
		nx.u_len[i] = ls_utf16_from(text[f], at, nx.u_col[i] - 1 + nx.u_len[i]) - c0
		nx.u_col[i] = c0
		nx.u_line[i] = nx.u_line[i] - 1
		i = i + 1
	}
	i = 0
	for i < nx.d_file.len() {
		f := nx.d_file[i]
		at := ls_start_of(starts[f], nx.d_line[i] - 1)
		c0 := ls_utf16_from(text[f], at, nx.d_col[i] - 1)
		nx.d_len[i] = ls_utf16_from(text[f], at, nx.d_col[i] - 1 + nx.d_len[i]) - c0
		nx.d_col[i] = c0
		nx.d_line[i] = nx.d_line[i] - 1
		i = i + 1
	}
}

fn ls_line_starts(b: list[byte]) -> list[int] {
	mut st: list[int] = [0]
	mut i := 0
	for i < b.len() {
		if b[i] == b'\n' {
			st.append(i + 1)
		}
		i = i + 1
	}
	return st
}

fn ls_start_of(st: list[int], ln: int) -> int {
	return st[ln] if ln >= 0 and ln < st.len()
	return 0
}

fn ls_src_of(paths: list[str], srcs: list[str], path: str) -> str {
	mut i := 0
	for i < paths.len() {
		return srcs[i] if paths[i] == path
		i = i + 1
	}
	return ""
}

# ls_use_under is the use at a request's position, or -1. A cursor just past a name's last
# character is on it too, which is where a click after a word lands.
fn ls_use_under(s: Server, params: json.Val) -> int {
	return -1 if not s.has_nx

	path := ls_uri_path(json.as_str(json.walk(params, "textDocument", "uri")))
	line := json.as_int(json.walk(params, "position", "line"))
	ch := json.as_int(json.walk(params, "position", "character"))
	mut u := zerg.nx_use_at(s.nx, path, line, ch)
	if u < 0 and ch > 0 {
		u = zerg.nx_use_at(s.nx, path, line, ch - 1)
	}
	return u
}

# A SHARED use — a generic body's `x.n` at two types — has more than one declaration, and answers
# with all of them: LSP's `definition` may be a list, which is what an editor offers to choose from.
fn ls_definition_result(s: Server, params: json.Val) -> json.Val {
	u := ls_use_under(s, params)
	return json.null() if u < 0

	nx := s.nx
	ds := zerg.nx_decls_of(nx, u)
	return ls_decl_location(nx, ds[0]) if ds.len() == 1

	mut out: list[json.Val] = []
	for d in ds {
		out.append(ls_decl_location(nx, d))
	}
	return json.of_list(out)
}

fn ls_decl_location(nx: zerg.NameIndex, d: int) -> json.Val {
	return ls_location(nx.files[nx.d_file[d]], nx.d_line[d], nx.d_col[d], nx.d_len[d])
}

# The references of the name at the cursor are every use of any declaration it resolves to — a
# shared use among them, since it may be one. `context.includeDeclaration` false leaves out the
# uses that ARE a declaration's own name.
fn ls_references_result(s: Server, params: json.Val) -> json.Val {
	u := ls_use_under(s, params)
	return json.null() if u < 0

	nx := s.nx
	ds := zerg.nx_decls_of(nx, u)
	skip_decl := json.encode(json.walk(params, "context", "includeDeclaration")) == "false"
	mut out: list[json.Val] = []
	mut i := 0
	for i < nx.u_decl.len() {
		mut hit := false
		mut own := false
		for d in ds {
			if zerg.nx_is_use_of(nx, i, d) {
				hit = true
				own = own or (nx.u_file[i] == nx.d_file[d] and nx.u_line[i] == nx.d_line[d] and nx.u_col[i] == nx.d_col[d])
			}
		}
		if hit and not (skip_decl and own) {
			out.append(ls_location(nx.files[nx.u_file[i]], nx.u_line[i], nx.u_col[i], nx.u_len[i]))
		}
		i = i + 1
	}
	return json.of_list(out)
}

# --- hover -------------------------------------------------------------------------------

# ls_hover_result is the DOCUMENT of the name at the cursor (#192). The index finds the
# declaration — `definition`'s own answer, so a hover can never name a place a jump would not
# — and `zerg doc`'s extraction prints it. There is ONE reader of comments in this tree, and a
# hover that grew a second one would show a document the terminal does not have.
#
# THE INDEX DOES NOT CARRY THE TEXT. A comment kept per declaration would be a string per row
# held for a whole session, paid on every check whether or not anybody hovers, and it is the
# accumulation #23 measures. What is stored is what `definition` already needed — a place —
# and the document is extracted from the source when the question is asked: one parse of the
# ONE file the declaration is in.
#
# The SOURCE comes from the loader, not from the disk and not from a cache. The declaration is
# routinely in another file of the program — a stdlib function, a sibling of the module — and
# `load` is what turns this buffer into the whole program it belongs to, with the unsaved text
# standing in for what was written. A load that raises leaves no source, which answers with
# what the index knows and nothing more, rather than with a sentence about a file.
#
# It answers only for a buffer the client has OPEN, because that buffer is the text the
# document is read from. A position in a file this session never saw is a question about a
# program it cannot see.
fn ls_hover_result(s: Server, params: json.Val, load: fn (str, list[str], list[str]) -> Program) -> json.Val {
	u := ls_use_under(s, params)
	return json.null() if u < 0

	uri := json.as_str(json.walk(params, "textDocument", "uri"))
	return json.null() if not ls_has_doc(s, uri)

	nx := s.nx
	ds := zerg.nx_decls_of(nx, u)
	return json.null() if ds.len() == 0

	# THE SOURCE IS FETCHED ONLY WHEN IT IS SOMEWHERE ELSE. What the extraction needs is the
	# text of the file the declaration is in; for the file under the cursor the client already
	# sent it, and it is the same text the loader would substitute. So the whole program is
	# loaded only when a declaration lives in another file AND is of a kind a document can hold
	# at all — `doc_covers` is the extraction's own answer to the second half, asked before
	# paying for a source rather than after reading nothing out of it. A hover on a local
	# binding or a parameter, which is most of the identifiers in a body, now loads nothing.
	path := ls_uri_path(uri)
	text := ls_doc_text(s, uri)
	mut fetch := false
	for d in ds {
		fetch = fetch or (zerg.doc_covers(nx.d_kind[d]) and nx.files[nx.d_file[d]] != path)
	}
	mut prog := program([], [], [], [], [], [])
	if fetch {
		prog = ls_load(s, path, load)
	}

	# A SHARED use — a generic body's `x.n` at two types — may be any of several declarations,
	# and `definition` answers with all of them. A hover that picked one would be the editor
	# saying something the jump does not, so it shows each, in the same order, under a rule.
	mut body := ""
	for d in ds {
		if body != "" {
			body = body + "\n\n---\n\n"
		}
		body = body + ls_hover_md(nx, d, ls_hover_src(nx, d, path, text, prog))
	}

	mut cs: list[json.Field] = []
	json.put_str(cs, "kind", "markdown")
	json.put_str(cs, "value", body)

	mut fs: list[json.Field] = []
	json.put(fs, "contents", json.of_obj(cs))
	json.put(fs, "range", ls_range_of(nx.u_line[u], nx.u_col[u], nx.u_line[u], nx.u_col[u] + nx.u_len[u]))
	return json.of_obj(fs)
}

# ls_hover_md is one declaration as MARKDOWN — the kind LSP's `MarkupContent` carries, and the
# right one here: a doc comment in this tree is already prose with ` ```zerg ` fences in it, so
# it is passed through as written and an editor renders the examples as examples. Plain text
# would show the fences as three backticks.
#
# The SIGNATURE goes in a fence of its own, above the prose, because that is the line a reader
# is looking for and the compiler's own type printer spelled it.
#
# A DECLARATION THE DOCUMENT DOES NOT COVER — a local binding, a parameter, a type parameter,
# the namespace an import bound — is its kind and its name, and NOT `(undocumented)`: nobody
# could have written a comment for it, so the mark would be a complaint about the author.
#
# WHETHER AN ABSENT COMMENT IS MARKED IS THE DOCUMENT'S ANSWER, not this function's: a page
# marks a declaration nobody wrote about and prints a member with nothing above it bare, and
# `DocAt.mark` is that answer carried here. Deciding it again would be the editor and the
# terminal disagreeing about the same line.
fn ls_hover_md(nx: zerg.NameIndex, d: int, src: str) -> str {
	name := zerg.nx_name(nx, d)

	# the index's line is LSP's by now (0-based); the extraction counts a source's lines as the
	# compiler does
	at := zerg.doc_decl_at(src, nx.files[nx.d_file[d]], nx.d_line[d] + 1, name)
	return ls_hover_fence(f"{zerg.nk_word(nx.d_kind[d])} {name}") if not at.ok

	head := ls_hover_fence(at.sig)
	if at.doc.len() == 0 {
		return f"{head}\n\n{zerg.doc_undocumented()}" if at.mark

		return head
	}

	mut out := head + "\n"
	for line in at.doc {
		out = out + "\n" + line
	}
	return out
}

# ls_hover_src is the text of the file declaration `d` is in: the buffer's own, which the
# client sent, or the program's copy of another file. A source that is neither — a kind no
# document covers, or a load that raised — is the empty string, and the extraction answers
# about it the way it answers about a name no document holds.
fn ls_hover_src(nx: zerg.NameIndex, d: int, path: str, text: str, prog: Program) -> str {
	p := nx.files[nx.d_file[d]]
	return text if p == path

	return ls_src_of(prog.paths, prog.srcs, p)
}

fn ls_hover_fence(sig: str) -> str {
	return f"```zerg\n{sig}\n```"
}

fn ls_location(path: str, line: int, col: int, len: int) -> json.Val {
	mut fs: list[json.Field] = []
	json.put_str(fs, "uri", ls_path_uri(path))
	json.put(fs, "range", ls_range_of(line, col, line, col + len))
	return json.of_obj(fs)
}

# ls_path_uri is ls_uri_path's inverse: a `file://` URI, with every byte a URI reserves escaped.
#
# A RELATIVE path is made absolute first, against the directory the server was started in. The
# loader answers one for the standard library when the compiler runs from outside its own tree,
# and `file://src/stdlib/x.zg` is not a relative URI but a file on a host called `src`.
fn ls_path_uri(path: str) -> str {
	mut abs := path
	if not ls_starts_with(path, "/") {
		abs = (os.env("PWD") ?? ".") + "/" + path
	}
	hex := bytearray("0123456789ABCDEF")
	mut out := bytearray("file://")
	for c in bytearray(abs) {
		if (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'/' or c == b'.' or c == b'_' or c == b'-' or c == b'~' {
			out.append(c)
		} else {
			out.append(b'%')
			out.append(hex[int(c) / 16])
			out.append(hex[int(c) % 16])
		}
	}
	return str(out)
}

# --- positions -------------------------------------------------------------------------
#
# The compiler answers with a 1-based LINE and a 1-based BYTE column, marking where the
# thing starts. LSP wants a 0-based line, a 0-based character in UTF-16 CODE UNITS, and a
# RANGE. Both halves of that conversion are here, and neither is optional:
#
# The unit, because a byte column and a UTF-16 column agree only while a line is ASCII, and
# this tree's own sources are full of em-dashes. Every diagnostic after one on the same line
# would land one column early per byte of it.
#
# The range, because a place is not one. WHERE THE COMPILER HAS AN END it is used and nothing
# is derived: a checked finding reports at the SAt marker, the marker carries the statement's
# extent, and the underline is that statement. Where it has none — a rule that knows a place
# of its own, a lint note about one literal, an abort whose place was read back out of its own
# sentence — the range is the word at the position, an identifier if there is one there and
# one character otherwise. That is a guess, it is made HERE rather than written into `Diag` as
# though the compiler had said it, and it is the reason the two are told apart at all.

fn ls_span_range(sp: Span) -> json.Val {
	return ls_range_of(sp.sl, sp.sc, sp.el, sp.ec)
}

# --- the buffer, split once -----------------------------------------------------------------
#
# EVERY POSITION QUESTION HERE IS ASKED OF A LINE, so the buffer is split into its lines ONCE
# per request and the lines are what travel. What stood here instead was `ls_line_at`, which
# walked the WHOLE buffer to find one line and allocated every line on the way past — and the
# answers ask for a lot of lines: three per outline entry, three per child, one per finding.
#
# That made an outline quadratic in the file. `documentSymbol` on this compiler's largest
# source took 103 SECONDS, against 8.7 for the check of the same buffer, and a client polling
# the outline on change would have wedged the session for minutes. Splitting once is the whole
# fix; nothing below it changed.
fn ls_lines(text: str) -> list[list[byte]] {
	mut out: list[list[byte]] = []
	mut cur: list[byte] = []
	for c in bytearray(text) {
		if c == b'\n' {
			out.append(cur)
			cur = []
		} else if c != b'\r' {
			cur.append(c)
		}
	}
	out.append(cur)
	return out
}

# ls_line is one of them, and the empty line for an index the buffer does not have — which a
# place past the end of a buffer mid-edit is.
fn ls_line(lines: list[list[byte]], idx: int) -> list[byte] {
	return lines[idx] if idx >= 0 and idx < lines.len()

	mut none: list[byte] = []
	return none
}

# ls_span_at is a span the COMPILER gave — two 1-based byte places — in LSP's units. Each end
# is counted against ITS OWN line, because a column is bytes into one line and the two ends of
# a declaration are rarely on the same one.
fn ls_span_at(lines: list[list[byte]], line: int, col: int, el: int, ec: int) -> Span {
	return Span(line - 1, ls_utf16_col(ls_line(lines, line - 1), col - 1), el - 1, ls_utf16_col(ls_line(lines, el - 1), ec - 1))
}

# Span is a range as four numbers rather than as JSON. A code action needs to COMPARE one
# against the range the client asked about, and comparing two `json.Val`s means reading back out of
# the thing just built — so the numbers exist before the object does, and both the diagnostic
# and the action are rendered from them.
struct Span {
	pub sl: int
	pub sc: int
	pub el: int
	pub ec: int
}

fn ls_word_span(lines: list[list[byte]], line: int, col: int) -> Span {
	b := ls_line(lines, line - 1)
	mut lo := col - 1
	if lo < 0 {
		lo = 0
	}
	if lo > b.len() {
		lo = b.len()
	}
	mut hi := lo
	for hi < b.len() and ls_is_word(b[hi]) {
		hi = hi + 1
	}
	if hi == lo and lo < b.len() {
		hi = lo + 1
	}
	return Span(line - 1, ls_utf16_col(b, lo), line - 1, ls_utf16_col(b, hi))
}

# ls_span_touches is whether a finding is one the client is asking about. It is an OVERLAP and
# not containment: an editor sends the cursor as an empty range, and a cursor sitting anywhere
# in `100` — including at either end of it — is a person asking about that literal.
fn ls_span_touches(sp: Span, req: Span) -> bool {
	return false if ls_pos_lt(sp.el, sp.ec, req.sl, req.sc)
	return false if ls_pos_lt(req.el, req.ec, sp.sl, sp.sc)

	return true
}

fn ls_pos_lt(al: int, ac: int, bl: int, bc: int) -> bool {
	return true if al < bl
	return false if al > bl

	return ac < bc
}

fn ls_range_of(sl: int, sc: int, el: int, ec: int) -> json.Val {
	mut fs: list[json.Field] = []
	json.put(fs, "start", ls_position(sl, sc))
	json.put(fs, "end", ls_position(el, ec))
	return json.of_obj(fs)
}

fn ls_position(line: int, ch: int) -> json.Val {
	mut fs: list[json.Field] = []
	json.put_int(fs, "line", line)
	json.put_int(fs, "character", ch)
	return json.of_obj(fs)
}

# ls_utf16_col is how many UTF-16 code units the first `upto` BYTES of a line come to. A
# continuation byte adds nothing, a code point outside the basic plane adds two, and
# everything else adds one.
fn ls_utf16_col(b: list[byte], upto: int) -> int {
	return ls_utf16_from(b, 0, upto)
}

# ls_utf16_from is the same count for the `upto` bytes that start at `at` — a line inside a whole
# file's bytes — stopping at the line's end.
fn ls_utf16_from(b: list[byte], at: int, upto: int) -> int {
	mut n := 0
	mut i := at
	for i < at + upto and i < b.len() and b[i] != b'\n' {
		c := int(b[i])
		if c < 128 or c >= 192 {
			n = n + 1
			if c >= 240 {
				n = n + 1
			}
		}
		i = i + 1
	}
	return n
}

fn ls_is_word(c: byte) -> bool {
	return c == b'_' or (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9')
}

# --- formatting ------------------------------------------------------------------------

# ls_code_action_result answers `textDocument/codeAction`: the quick fixes for the findings the
# client's range touches.
#
# THE FIX IS THE COMPILER'S, not the server's. A finding that has a mechanical answer carries it
# in `Diag.fix`, and all this does is put it where the editor expects — a title, a kind, and one
# edit over the finding's own range. The alternative, reading the replacement back out of the
# message text, is the second copy of a language fact this file is written to avoid: today the
# sentence says "write `1.0`", and the day it says something else the copy would rewrite source
# into whatever it managed to parse.
#
# IT ANSWERS FROM THE CHECK, not from a walk of its own (#204). The check that published this
# buffer's findings lowered the program to find them, and the notes that carry a fix came out of
# that same walk — lowering the program again for them cost half a check per request, for a menu
# that usually offers nothing. So the check keeps them per buffer (Doc.fixes, which says why
# they cannot be a stale answer), and the menu follows what the buffer shows: a buffer another
# program's check spoke for offers the fixes that check found.
fn ls_code_action_result(s: Server, uri: str, req: Span) -> json.Val {
	mut out: list[json.Val] = []
	return json.of_list(out) if not ls_has_doc(s, uri)

	text := ls_doc_text(s, uri)
	lines := ls_lines(text)
	for d in ls_doc_fixes(s, uri) {
		sp := ls_word_span(lines, d.line, d.col)
		if ls_span_touches(sp, req) {
			out.append(ls_quick_fix(uri, sp, d))
		}
	}
	return json.of_list(out)
}

fn ls_doc_fixes(s: Server, uri: str) -> list[zerg.Diag] {
	for d in s.docs {
		return d.fixes if d.uri == uri
	}
	return []
}

# ls_fixes_in is the notes on THIS file that carry a fix. A finding without one is not an action:
# an editor that offers "quick fix" and then does nothing is worse than an editor that offers
# nothing, because the user learns the menu lies.
fn ls_fixes_in(notes: list[zerg.Diag], path: str) -> list[zerg.Diag] {
	mut out: list[zerg.Diag] = []
	for d in notes {
		if d.path == path and d.fix != "" {
			out.append(d)
		}
	}
	return out
}

# ls_quick_fix is one action. The DIAGNOSTIC rides along so the editor can attach the action to
# the underline the user is looking at rather than to the line in general.
fn ls_quick_fix(uri: str, sp: Span, d: zerg.Diag) -> json.Val {
	mut ed: list[json.Field] = []
	json.put(ed, "range", ls_span_range(sp))
	json.put_str(ed, "newText", d.fix)

	mut changes: list[json.Field] = []
	json.put(changes, uri, json.of_list([json.of_obj(ed)]))

	mut wsp: list[json.Field] = []
	json.put(wsp, "changes", json.of_obj(changes))

	mut fs: list[json.Field] = []
	json.put_str(fs, "title", f"Write `{d.fix}`")
	json.put_str(fs, "kind", "quickfix")
	json.put(fs, "diagnostics", json.of_list([ls_diagnostic_over(sp, d.code, d.msg, 3)]))
	json.put(fs, "edit", json.of_obj(wsp))
	return json.of_obj(fs)
}

# ls_document_symbol_reply answers `textDocument/documentSymbol`: the outline of one buffer.
#
# It SENDS the answer rather than returning one, which every other handler here does, because
# the two answers it has are of different kinds: an outline, and the request failing. Only the
# caller of ls_error_reply can say the second.
#
# The compiler decides WHAT a symbol is — `zerg.file_symbols` walks the parsed file and answers
# with a name, a kind and a place — and this decides how it travels. That split is the same one
# the quick fix is built on, and it is what keeps the rule this file exists for: the server may
# not know a language fact the compiler could tell it.
#
# THE BUFFER ALONE, not the whole program. Every other answer here is computed against the
# modules the file imports, because a name borrowed from one of them is undefined without it.
# An outline is the opposite question — what is IN this file — and pulling in the imports would
# fill it with declarations the reader cannot see on screen.
#
# A PARSE THAT ABORTS IS SAID, not answered around. It used to come back as an empty list,
# which is the outline of a file that declares nothing — so an editor showing a buffer whose
# last keystroke broke the parse emptied its outline pane and said why nowhere, and a server
# that had crashed on the request looked exactly the same.
#
# What it answers instead is the request FAILING, with the compiler's own sentence as the
# message: RequestFailed (-32803) is the protocol's way of saying a well-formed request cannot
# be answered right now, and it is the one answer that leaves a client free to keep showing the
# outline it already has. The check that runs on the same keystroke publishes the sentence as a
# diagnostic too — this is not a second finding, it is the outline declining rather than lying.
fn ls_document_symbol_reply(s: Server, id: json.Val, uri: str) {
	mut out: list[json.Val] = []
	if not ls_has_doc(s, uri) {
		ls_reply(id, json.of_list(out))
		return
	}

	text := ls_doc_text(s, uri)
	path := ls_uri_path(uri)
	mut syms: list[zerg.Symbol] = []
	err := match guard {
		syms = zerg.file_symbols(zerg.parse_at(text, path))
		syms.len()
	} {
		Either.Left(_)  => ""
		Either.Right(e) => e.message()
	}
	if err != "" {
		ls_error_reply(id, -32803, err)
		return
	}

	lines := ls_lines(text)
	for sym in syms {
		out.append(ls_document_symbol(lines, sym))
	}
	ls_reply(id, json.of_list(out))
}

# ls_document_symbol is one entry, as LSP's `DocumentSymbol`.
#
# `range` and `selectionRange` ARE TWO DIFFERENT RANGES, which is what the protocol asks for:
# the first spans the whole declaration and the second the name it is selected by. They used
# to be one range — the word at the declaration's first column — because the compiler had no
# end to give and a point wearing two names was the honest answer to that. It has one now
# (ast.zg, `decl-extent`), so the outer range is the construct and a client can say which
# declaration a cursor is inside; the inner one is the name token, so a jump still lands where
# a reader of an outline wants to be.
#
# `children` are the declarations written INSIDE this one — a struct's fields, an enum's
# variants — nested rather than listed beside their parent, which is the difference between an
# outline and a list of names.
#
# `detail` is what the outline shows beside the name: the receiver of a method, the underlying
# type of a `type`, the module path of an import. `pub` rides in front of it, because the one
# thing a reader scanning a module's outline is looking for is what other modules can reach.
fn ls_document_symbol(lines: list[list[byte]], sym: zerg.Symbol) -> json.Val {
	mut detail := sym.detail
	if sym.is_pub {
		if detail == "" {
			detail = "pub"
		} else {
			detail = "pub " + detail
		}
	}

	mut fs: list[json.Field] = []
	json.put_str(fs, "name", sym.name)
	json.put_int(fs, "kind", ls_symbol_kind(sym.kind))
	if detail != "" {
		json.put_str(fs, "detail", detail)
	}
	json.put(fs, "range", ls_span_range(ls_decl_span(lines, sym)))
	json.put(fs, "selectionRange", ls_span_range(ls_name_span(lines, sym)))
	if sym.kids.len() > 0 {
		mut kids: list[json.Val] = []
		for k in sym.kids {
			kids.append(ls_document_symbol(lines, k))
		}
		json.put(fs, "children", json.of_list(kids))
	}
	return json.of_obj(fs)
}

# ls_decl_span is the whole construct, and ls_name_span the name token inside it.
#
# EACH FALLS BACK TO THE WORD at the place it has, and neither invents one. A declaration
# whose end the parser did not record — and a name the parser never wrote down, which is the
# `init` the language declares rather than the author — is a place and nothing more, so it
# answers what a place alone can: the word standing there. A selection outside its range is
# the one thing the protocol forbids, and a word at the declaration's own first column is
# inside it either way.
fn ls_decl_span(lines: list[list[byte]], sym: zerg.Symbol) -> Span {
	return ls_extent_span(lines, sym.line, sym.col, sym.end_line, sym.end_col)
}

fn ls_name_span(lines: list[list[byte]], sym: zerg.Symbol) -> Span {
	return ls_word_span(lines, sym.line, sym.col) if sym.name_line < 1
	return ls_word_span(lines, sym.name_line, sym.name_col)
}

# ls_symbol_kind maps the compiler's WORD onto LSP's number (SymbolKind, §Document Symbols).
#
# The mapping lives here because the number is protocol and the protocol is this module's. The
# compiler says "enum" and would go on saying it if LSP renumbered tomorrow.
#
# An unknown word answers 13 — `Variable` — rather than aborting: a kind this file has not
# learned yet is a new declaration form, and an outline missing one entry's icon is a better
# answer than an outline that is not sent.
fn ls_symbol_kind(kind: str) -> int {
	return 2 if kind == "import"   # Module
	return 23 if kind == "struct"  # Struct
	return 10 if kind == "enum"    # Enum
	return 11 if kind == "spec"    # Interface
	return 5 if kind == "impl"     # Class
	return 26 if kind == "type"    # TypeParameter
	return 14 if kind == "const"   # Constant
	return 12 if kind == "fn"      # Function
	return 6 if kind == "method"   # Method
	return 8 if kind == "field"    # Field
	return 22 if kind == "variant" # EnumMember
	return 13
}

# ls_req_span reads the range a codeAction request asks about.
fn ls_req_span(params: json.Val) -> Span {
	r := json.get(params, "range")
	st := json.get(r, "start")
	en := json.get(r, "end")
	return Span(json.as_int(json.get(st, "line")), json.as_int(json.get(st, "character")), json.as_int(json.get(en, "line")), json.as_int(json.get(en, "character")))
}

fn ls_formatting_result(s: Server, uri: str) -> json.Val {
	mut edits: list[json.Val] = []
	return json.of_list(edits) if not ls_has_doc(s, uri)
	text := ls_doc_text(s, uri)

	# The SAME gate the command line applies, and for the same reason: fmt reads tokens, so
	# it will reformat anything that lexes — including a half-typed buffer, whose spacing it
	# would decide from a shape that means nothing. An editor formats on save, which is
	# exactly when a buffer is most likely to be mid-edit.
	return json.of_list(edits) if not zerg.fmt_balanced(text)

	out := match guard {
		zerg.fmt_src_off(text, [])
	} {
		Either.Left(t)  => t
		Either.Right(_) => text
	}
	return json.of_list(edits) if out == text

	mut fs: list[json.Field] = []
	json.put(fs, "range", ls_whole_range(ls_lines(text)))
	json.put_str(fs, "newText", out)
	edits.append(json.of_obj(fs))
	return json.of_list(edits)
}

# ls_whole_range covers the document. The end is the real last position rather than a large
# number a client is expected to clamp: a client that does not clamp appends instead of
# replacing, and the file doubles.
fn ls_whole_range(lines: list[list[byte]]) -> json.Val {
	n := lines.len()
	return ls_range_of(0, 0, 0, 0) if n == 0

	last := ls_line(lines, n - 1)
	return ls_range_of(0, 0, n - 1, ls_utf16_col(last, last.len()))
}

# --- URIs ---------------------------------------------------------------------------------

# ls_uri_path turns `file:///a/b%20c.zg` into `/a/b c.zg`. Anything that is not a `file:` URI
# comes back as it is: the compiler will fail to read it and say so, which is a better
# answer than this function guessing.
fn ls_uri_path(uri: str) -> str {
	rest := uri
	return ls_percent_decode(ls_drop_prefix(rest, 7)) if ls_starts_with(rest, "file://")
	return rest
}

fn ls_percent_decode(s: str) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() {
		if b[i] == b'%' and i + 2 < b.len() {
			out.append(byte(ls_hex2(b[i + 1], b[i + 2])))
			i = i + 3
		} else {
			out.append(b[i])
			i = i + 1
		}
	}
	return str(out)
}

fn ls_hex2(a: byte, b: byte) -> int {
	return ls_hex_of(a) * 16 + ls_hex_of(b)
}

fn ls_hex_of(c: byte) -> int {
	return int(c) - 48 if c >= b'0' and c <= b'9'
	return int(c) - 87 if c >= b'a' and c <= b'f'
	return int(c) - 55 if c >= b'A' and c <= b'F'

	return 0
}

# --- text helpers ---------------------------------------------------------------------

# ls_split_lines is ls_lines as TEXT, for the one reader that wants strings: the frame header,
# which is a handful of short lines. It is a wrapper and not a second loop, because the two
# rules in it — where a line ends, and that a `\r` is not part of one — are one rule.
fn ls_split_lines(s: str) -> list[str] {
	mut out: list[str] = []
	for ln in ls_lines(s) {
		out.append(str(ln))
	}
	return out
}

fn ls_slice_str(buf: list[byte], lo: int, hi: int) -> str {
	mut out: list[byte] = []
	mut i := lo
	for i < hi and i < buf.len() {
		out.append(buf[i])
		i = i + 1
	}
	return str(out)
}

fn ls_drop_front(buf: list[byte], n: int) -> list[byte] {
	mut out: list[byte] = []
	mut i := n
	for i < buf.len() {
		out.append(buf[i])
		i = i + 1
	}
	return out
}

fn ls_starts_with(s: str, p: str) -> bool {
	a := bytearray(s)
	b := bytearray(p)
	return false if a.len() < b.len()
	mut i := 0
	for i < b.len() {
		return false if a[i] != b[i]
		i = i + 1
	}
	return true
}

fn ls_drop_prefix(s: str, n: int) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	mut i := n
	for i < b.len() {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn ls_before_colon(s: str) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	for c in b {
		break if c == b':'
		out.append(c)
	}
	return str(out)
}

fn ls_after_colon(s: str) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	mut seen := false
	for c in b {
		if seen {
			out.append(c)
		}
		if c == b':' {
			seen = true
		}
	}
	return str(out)
}

fn ls_trim(s: str) -> str {
	b := bytearray(s)
	mut lo := 0
	for lo < b.len() and (b[lo] == b' ' or b[lo] == b'\t' or b[lo] == b'\r') {
		lo = lo + 1
	}
	mut hi := b.len()
	for hi > lo and (b[hi - 1] == b' ' or b[hi - 1] == b'\t' or b[hi - 1] == b'\r') {
		hi = hi - 1
	}
	return ls_slice_str(b, lo, hi)
}

fn ls_lower(s: str) -> str {
	mut out: list[byte] = []
	for c in bytearray(s) {
		if c >= b'A' and c <= b'Z' {
			out.append(c + byte(32))
		} else {
			out.append(c)
		}
	}
	return str(out)
}

fn ls_int_of(s: str) -> int {
	b := bytearray(s)
	mut n := 0
	mut any := false
	for c in b {
		break if c < b'0' or c > b'9'
		n = n * 10 + (int(c) - 48)
		any = true
	}
	return -1 if not any
	return n
}
