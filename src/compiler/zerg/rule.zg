	# building — the program as a set of files, which no single file's text answers: imports resolved before
	# anything is lexed, and `fn main` looked for after everything is emitted
	EntryHasNoMain = 501
	ImportUnresolved = 502
	RecvOnSendOnly = 503
	SendOnRecvOnly = 504
	CloseRecvOnly = 505
	ChanDirectionNarrows = 506
	ModuleNotImported = 507
	NotPublicType = 508
	PrivateTypeOnPubDecl = 509
	NotPublicField = 510
	NotYetAtomicImport = 511
