# The linter reports what the compiler already knows but has no reason to say: code that
# is written, compiled, and never reached. Every check here is answered from the parsed
# File alone — no types, no flow analysis — which keeps it honest about what it can claim.
#
# Every finding carries a CODE, so it can be named — in a diagnostic, in a review, in a
# suppression. The prefix groups them the way the formatter's does (see fmt.zg): `L1xx` is
# dead code, things written that nothing reaches.
#
#   L101  an unused import — the module is read, parsed, and merged into the program for
#         nothing, and it lies to the next reader about what this file depends on
#   L102  an unused private function — a public one is a module's interface and may have
#         no caller in this program, but a private one with no caller is simply dead
#   L103  a binding that is never read — the value was computed for nobody
#   L104  `_ := expr` — a discard binder over an expression that is ALREADY a statement, so
#         the binder is the one part of the line nothing reaches
#
# `L2xx` is NULL SAFETY: an optional handled in a way that works but says the wrong thing.
# Nothing here is a compile error — each of these programs runs — which is exactly why a
# linter is where they belong.
#
#   L201  `?? nil` — a fallback that is itself the absent value, so the `??` changes
#         nothing: the result is optional either way
#   L202  `x!` inside a function whose result is a `T?` — the absence can be HANDED BACK
#         with `?` instead of turned into an abort, and `!` is the easier key to reach
#
# `L4xx` is RESOLUTION: a name that answers to more than one thing.
#
#   L402  a `mut fn` that never writes through `this` — it makes every call site hold the
#         instance in a `mut` binding and gives nothing back
#   L401  a variant name TWO enums declare — a bare use of it resolves to whichever was
#         declared first, so moving an `enum` changes what the program means. The
#         qualified `Enum.Variant` says which one is meant.
#
# `L3xx` is CAPTURE: what a coroutine or a deferred call actually took.
#
#   L301  a `mut` binding captured by `spawn` / `defer` and WRITTEN after the capture —
#         the arguments are a snapshot taken where the statement is written, so the later
#         value is not the one the call sees. A channel is reported too, and only for a
#         REBINDING: a send is not a write, and after `ch = <another>` the coroutine holds
#         the old channel.
#
# `L5xx` is CONVERSION: a value that changed type, or a literal that took one, without the
# source saying so. docs/core/types.md asks for it over `Into` — "every implicit conversion is
# a lint finding, literals included" — and the reason is a reading one: `1` and `1.0` should
# mean different types on the page, so `1.5 + 1` is reported and `1.5 + 1.0` is not.
#
#   L501  a VALUE converted — `f: float = i` for an `int` binding. It is legal, it is one
#         step, and it is invisible; `float(i)` says the same thing out loud
#   L502  a LITERAL took a type that is not its own — `b: byte = 5`, or the `1` in `1.5 + 1`
#
# THESE TWO ARE NOT ANSWERED HERE, and they are the only ones that are not. Everything above
# comes from the parsed File; a conversion is a fact about TYPES, so the LOWERING WALK records
# it and lint_conversions (emit.zg) hands it back. The driver asks both and prints both.
#
# Findings come back as plain strings in source order. The driver prints them and exits
# nonzero, so `zerg lint` is usable as a gate rather than as decoration.

# lint_files reports every finding across a loaded program (the entry file plus the
# modules it imports, as the driver resolved them).
pub fn lint_files(srcs: list[str]) -> list[str] {
	# THE BUILT-IN SPECS TOO, and through the same function the lowering walk uses: `Into` is
	# declared by the language, so a program that implements it declares no spec by that name
	# — and L102 read the resulting `into` as a private function nobody calls.
	f := c_with_builtin_specs(merge_files(srcs))
	mut out: list[str] = []

	# Names used ANYWHERE in the program: a private function called from another module
	# of the same program is used, so the whole merged File is the unit of judgement.
	mut ids: list[str] = []
	mut calls: list[str] = []
	mut ns: list[str] = []
	for fd in f.fns {
		walk_body(fd.body, ids, calls, ns)
	}
	lint_imports(f, ns, ids, out)
	lint_dead_fns(f, calls, ids, out)
	lint_unread_bindings(f, out)
	lint_captures(f, out)
	lint_optionals(f, out)
	lint_ambiguous_variants(f, out)
	lint_idle_mut_fn(f, out)
	return out
}

# lint_idle_mut_fn reports a `mut fn` whose body never writes through `this`.
#
# `mut fn` is not a hint: it makes the receiver a `mut &`, so EVERY call site has to hold
# the instance in a `mut` binding (GRAMMAR#fn-decl). A method that only reads charges its
# callers that and gives nothing back — and the caller cannot see why, because the
# signature is the whole contract and `mut fn` is all it says.
#
# The test is a WRITE to `this`, not a mention of it: a `mut fn` that reads `this` is the
# ordinary case, and one that passes it to a `mut &` parameter is writing through it.
fn lint_idle_mut_fn(f: File, mut &out: list[str]) {
	refs := lint_ref_params(f)
	for fd in f.fns {
		if fd.recv != "" and lint_recv_is_mut(fd) and not writes_this(fd.body, refs) {
			out.append(f"L402 `{fd.recv}.{fd.name}` is a `mut fn` and never writes through `this` — every call site has to hold the instance in a `mut` binding for nothing; make it a plain `fn`")
		}
	}
}

fn lint_recv_is_mut(fd: FnDecl) -> bool {
	return false if fd.params.len() == 0
	return fd.params[0].is_ref
}

# writes_this is assigns_to over a whole body, including the blocks a statement carries.
fn writes_this(body: list[Stmt], refs: list[str]) -> bool {
	mut i := 0
	for i < body.len() {
		return true if assigns_to(body[i], "this", refs) or writes_this_in(body[i], refs)
		i = i + 1
	}
	return false
}

fn writes_this_in(s: Stmt, refs: list[str]) -> bool {
	return match s {
		SIf(c, tb, he, eb) => writes_this(tb, refs) or writes_this(eb, refs)
		SIfLet(nm, v, tb, he, eb) => writes_this(tb, refs) or writes_this(eb, refs)
		SFor(hc, c, b) => writes_this(b, refs)
		SForIn(nm, it, b) => writes_this(b, refs)
		SSelect(arms) => writes_this_arms(arms, refs)
		SForSelect(arms) => writes_this_arms(arms, refs)
		_ => false
	}
}

fn writes_this_arms(arms: list[SelArm], refs: list[str]) -> bool {
	for a in arms {
		return true if writes_this(a.body, refs)
	}
	return false
}

# --- L4xx: a name that resolves to more than one thing ------------------------------

# lint_ambiguous_variants reports a variant name that TWO enums declare.
#
# A bare name is a variant when it resolves to one (GRAMMAR#variant-pat), and resolution takes the
# FIRST declaration — silently. Two enums that both have a `Red` make `c := Red` a coin
# toss decided by declaration order, and moving an `enum` in the file changes what the
# program means with nothing said.
#
# It is a lint and not an error because the program is well formed and the answer is
# defined; what it is not is READABLE. The qualified form says which — `Color.Red` — and
# the rule exists to point at it.
fn lint_ambiguous_variants(f: File, mut &out: list[str]) {
	for e in f.enums {
		for v in e.variants {
			owner := lint_first_enum_of(f, v.name)
			if owner != e.name {
				out.append(f"L401 `{v.name}` is a variant of both `{owner}` and `{e.name}`, so a bare `{v.name}` resolves to `{owner}` by declaration order alone — name it `{e.name}.{v.name}` where you mean this one")
			}
		}
	}
}

# lint_first_enum_of is the enum a bare name resolves to: the first that declares it.
fn lint_first_enum_of(f: File, name: str) -> str {
	for e in f.enums {
		for v in e.variants {
			return e.name if v.name == name
		}
	}
	return ""
}

# --- L2xx: null safety -------------------------------------------------------------------
#
# Both checks are answered from the parsed File alone, like every other rule here. That is
# what keeps them honest: `?? nil` is a SHAPE, and so is a `!` inside a function whose
# declared result is a `T?`. Neither needs to know a type that was not written down.
fn lint_optionals(f: File, mut &out: list[str]) {
	for fd in f.fns {
		lint_opt_body(fd.body, fd.name, c_ret_is_opt(fd), out)
	}
}

fn c_ret_is_opt(fd: FnDecl) -> bool {
	return false if not fd.has_ret
	return match fd.ret {
		TOpt(_) => true
		_       => false
	}
}

fn lint_opt_body(body: list[Stmt], fname: str, ret_opt: bool, mut &out: list[str]) {
	for s in body {
		match s {
			SLet(nm, ty, ht, im, ic, v) => lint_opt_expr(v, fname, ret_opt, out)
			SAssign(lhs, rhs) => lint_opt_expr(rhs, fname, ret_opt, out)
			SPrint(v) => lint_opt_expr(v, fname, ret_opt, out)
			SReturn(hv, v) => lint_opt_expr(v, fname, ret_opt, out)
			SExpr(v) => lint_opt_expr(v, fname, ret_opt, out)
			SIf(c, tb, he, eb) => lint_opt_two(tb, eb, fname, ret_opt, out)
			SIfLet(nm, v, tb, he, eb) => lint_opt_two(tb, eb, fname, ret_opt, out)
			SFor(hc, c, b) => lint_opt_body(b, fname, ret_opt, out)
			SForIn(nm, it, b) => lint_opt_body(b, fname, ret_opt, out)
			SSelect(arms) => lint_opt_arms(arms, fname, ret_opt, out)
			SForSelect(arms) => lint_opt_arms(arms, fname, ret_opt, out)
			_ => lint_skip()
		}
	}
}

fn lint_opt_two(a: list[Stmt], b: list[Stmt], fname: str, ret_opt: bool, mut &out: list[str]) {
	lint_opt_body(a, fname, ret_opt, out)
	lint_opt_body(b, fname, ret_opt, out)
}

fn lint_opt_arms(arms: list[SelArm], fname: str, ret_opt: bool, mut &out: list[str]) {
	for a in arms {
		lint_opt_body(a.body, fname, ret_opt, out)
	}
}

fn lint_opt_expr(e: Expr, fname: str, ret_opt: bool, mut &out: list[str]) {
	match e {
		ECoalesce(a, b, jump) => lint_opt_coalesce(a, b, fname, ret_opt, out)
		EForce(x) => lint_opt_force(x, fname, ret_opt, out)
		EBinary(op, a, b) => lint_opt_pair(a, b, fname, ret_opt, out)
		EUnary(op, x) => lint_opt_expr(x, fname, ret_opt, out)
		EField(t, nm) => lint_opt_expr(t, fname, ret_opt, out)
		EOptChain(t, nm) => lint_opt_expr(t, fname, ret_opt, out)
		ETry(x) => lint_opt_expr(x, fname, ret_opt, out)
		ECall(nm, args, _) => lint_opt_args(args, fname, ret_opt, out)
		EMethod(t, nm, args) => lint_opt_args(args, fname, ret_opt, out)
		_ => lint_skip()
	}
}

fn lint_opt_pair(a: Expr, b: Expr, fname: str, ret_opt: bool, mut &out: list[str]) {
	lint_opt_expr(a, fname, ret_opt, out)
	lint_opt_expr(b, fname, ret_opt, out)
}

fn lint_opt_args(args: list[Expr], fname: str, ret_opt: bool, mut &out: list[str]) {
	for a in args {
		lint_opt_expr(a, fname, ret_opt, out)
	}
}

fn lint_opt_coalesce(a: Expr, b: Expr, fname: str, ret_opt: bool, mut &out: list[str]) {
	if is_nil_expr(b) {
		out.append(f"L201 `?? nil` in `{fname}` changes nothing — the result is optional either way")
	}
	lint_opt_expr(a, fname, ret_opt, out)
	lint_opt_expr(b, fname, ret_opt, out)
}

fn lint_opt_force(x: Expr, fname: str, ret_opt: bool, mut &out: list[str]) {
	if ret_opt {
		out.append(f"L202 `!` in `{fname}`, which answers a `T?` — `?` hands the absence back instead of aborting")
	}
	lint_opt_expr(x, fname, ret_opt, out)
}

fn is_nil_expr(e: Expr) -> bool {
	return match e {
		ENil => true
		_    => false
	}
}

fn lint_skip() {
	return
}

# --- L3xx: what a coroutine and a deferred call actually captured ------------------
#
# `spawn f(k)` and `defer f(k)` take their arguments as a SNAPSHOT, at the line they are
# written on. A write to `k` afterwards is not seen by the call — the coroutine may not
# even have started, and the deferred call has not run. That is the right semantics and it
# is the single most misreadable thing in this language: an experienced reader has to ask.
#
# So the tool answers instead of waiting to be asked. It is a lint and not an error because
# the program is correct and the snapshot is often exactly what was wanted.
#
# It looks WITHIN ONE BLOCK, at the statements after the capture. A write from a nested
# block, or from a later call, is not reported: this reports the shape that misleads,
# rather than every shape that could.
fn lint_captures(f: File, mut &out: list[str]) {
	refs := lint_ref_params(f)
	for fd in f.fns {
		mut muts: list[str] = []
		lint_captures_body(fd.body, fd.name, refs, muts, out)
	}
}

# lint_ref_params is `name#idx` for every `mut &` parameter in the program. A call is a
# WRITE to the variable it passes only in those slots, and the declaration is the only
# place that says which — without it, `show(k)` (a read) was reported as a write.
fn lint_ref_params(f: File) -> list[str] {
	mut refs: list[str] = []
	for fd in f.fns {
		mut j := 0
		for j < fd.params.len() {
			if fd.params[j].is_ref {
				refs.append(f"{fd.name}#{strconv.to_string(j, 10)}")
			}
			j = j + 1
		}
	}
	return refs
}

# `muts` is INHERITED by a nested block rather than reset in it. Resetting made the rule
# block-scoped by DECLARATION when the documented rule is block-scoped by STATEMENT: a
# `mut k` declared in a function and captured-then-written inside an `if` was silent, even
# though the capture and the write sat next to each other.
fn lint_captures_body(body: list[Stmt], fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	mut i := 0
	for i < body.len() {
		match body[i] {
			SLet(nm, ty, has_ty, is_mut, is_const, v) => lint_captures_let(nm, is_mut, v, fname, refs, muts, out)
			SExpr(e) => lint_captures_expr(e, fname, refs, muts, out)
			SSpawn(x) => lint_capture_at(body, i, x, "spawn", fname, refs, muts, out)
			SDefer(x) => lint_capture_at(body, i, x, "defer", fname, refs, muts, out)
			SIf(c, tb, he, eb) => lint_captures_two(tb, eb, fname, refs, muts, out)
			SIfLet(nm, v, tb, he, eb) => lint_captures_two(tb, eb, fname, refs, muts, out)
			SFor(hc, c, b) => lint_captures_body(b, fname, refs, muts, out)
			SForIn(nm, it, b) => lint_captures_body(b, fname, refs, muts, out)

			# a select arm's body is a block like any other, and it is where coroutines
			# actually live — the other two walks in this file grew an `_arms` helper for
			# the same reason, and this one was written without it
			SSelect(arms) => lint_captures_arms(arms, fname, refs, muts, out)
			SForSelect(arms) => lint_captures_arms(arms, fname, refs, muts, out)
			_ => lint_skip()
		}
		i = i + 1
	}
}

fn lint_captures_two(a: list[Stmt], b: list[Stmt], fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	lint_captures_body(a, fname, refs, muts, out)
	lint_captures_body(b, fname, refs, muts, out)
}

fn lint_captures_arms(arms: list[SelArm], fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	for a in arms {
		lint_captures_body(a.body, fname, refs, muts, out)
	}
}

fn lint_captures_let(nm: str, is_mut: bool, v: Expr, fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	lint_note_mut(nm, is_mut, muts)
	lint_captures_expr(v, fname, refs, muts, out)
}

# A closure's body and a `guard`'s are blocks no STATEMENT holds — they hang off an
# expression, so a walk that dispatches on statements alone never reaches them and this rule
# was silent inside every closure. `collect_binds_expr` grew the same descent for the same
# reason. A closure is reached through a call's arguments too, since `run(fn() { … })` is
# the shape they are actually written in.
fn lint_captures_expr(e: Expr, fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	match e {
		EGuard(b) => lint_captures_body(b, fname, refs, muts, out)
		EFn(ps, has_ret, ret, b) => lint_captures_body(b, fname, refs, muts, out)
		ECall(nm, args, _) => lint_captures_each(args, fname, refs, muts, out)
		EMethod(t, m, args) => lint_captures_each(args, fname, refs, muts, out)
		_ => lint_skip()
	}
}

fn lint_captures_each(args: list[Expr], fname: str, refs: list[str], mut &muts: list[str], mut &out: list[str]) {
	for a in args {
		lint_captures_expr(a, fname, refs, muts, out)
	}
}

# lint_note_mut records a `mut` binding.
#
# A channel binding used to be EXEMPT, on the reasoning that a handle is shared and a later
# send is seen. The reasoning is right and the exemption was still wrong: a send is `ch <-
# v`, which is not an assignment and was never reported. The only thing that reaches this
# rule is `ch = <another channel>` — a REBINDING, after which the coroutine holds the old
# channel and everything sent on the new one goes nowhere near it. So the exemption
# suppressed nothing but correct reports.
fn lint_note_mut(nm: str, is_mut: bool, mut &muts: list[str]) {
	return if not is_mut
	muts.append(nm)
}

# lint_capture_at reports every `mut` name this statement captured that a LATER statement
# in the same block writes to.
fn lint_capture_at(body: list[Stmt], at: int, x: Expr, kw: str, fname: str, refs: list[str], muts: list[str], mut &out: list[str]) {
	# `spawn f(k, k)` and `f(k + k)` reach walk_expr as two occurrences of one name, and the
	# finding is about the NAME — reporting it twice would say the same thing twice
	mut said: list[str] = []
	for n in expr_idents(x) {
		if has_str(muts, n) and not has_str(said, n) and assigned_after(body, at, n, refs) {
			said.append(n)
			out.append(f"L301 `{n}` is captured by the `{kw}` in `{fname}` as it is HERE, and written after it — the call sees the value at the capture, not the later one")
		}
	}
}

# expr_idents is the names an expression reads. walk_expr collects three kinds at once
# because its other callers want all three; this one wants the first.
fn expr_idents(x: Expr) -> list[str] {
	mut names: list[str] = []
	mut calls: list[str] = []
	mut ns: list[str] = []
	walk_expr(x, names, calls, ns)
	return names
}

# assigned_after is whether any statement after `at` assigns to `n`, in this block.
fn assigned_after(body: list[Stmt], at: int, n: str, refs: list[str]) -> bool {
	mut i := at + 1
	for i < body.len() {
		return true if assigns_to(body[i], n, refs)
		i = i + 1
	}
	return false
}

# assigns_to is whether a statement WRITES `n` — which is not only an assignment. A
# captured `list` is snapshotted by deep copy, so `xs.append(2)` after the capture is
# exactly the misreading this rule exists for, and it is a method call rather than an
# `SAssign`. `chk_root_name` is the checker's walk of an assignment target; this file had a
# verbatim copy of it, which meant the set of shapes that count as a target was written
# down twice.
fn assigns_to(s: Stmt, n: str, refs: list[str]) -> bool {
	return match s {
		SAssign(lhs, rhs) => chk_root_name(lhs) == n
		SExpr(e) => mutates_expr(e, n, refs)
		_ => false
	}
}

# mutates_expr is whether a bare expression statement writes `n`: a method that writes
# through its receiver, or a call passing it to a `mut &` parameter. Neither is an
# assignment and both are writes — but neither is EVERY call, which is what the first
# version of this said. `show(k)` is a read, and it was reported.
#
# `c_meth_mutates` is the emitter's one statement of which methods write through their
# receiver, and `refs` is read off the declarations. Both facts are asked of their owner
# rather than guessed at here, so a method or a signature added later is seen for free.
fn mutates_expr(e: Expr, n: str, refs: list[str]) -> bool {
	return match e {
		EMethod(t, m, args) => c_meth_mutates(m) and chk_root_name(t) == n
		ECall(nm, args, _) => ref_arg(nm, args, n, refs)
		_ => false
	}
}

# ref_arg is whether `nm` takes `n` in a `mut &` slot.
fn ref_arg(nm: str, args: list[Expr], n: str, refs: list[str]) -> bool {
	mut i := 0
	for i < args.len() {
		return true if chk_root_name(args[i]) == n and has_str(refs, f"{nm}#{strconv.to_string(i, 10)}")
		i = i + 1
	}
	return false
}

# lint_imports reports an import whose namespace nothing reaches through.
fn lint_imports(f: File, ns: list[str], ids: list[str], mut &out: list[str]) {
	for im in f.imports {
		name := last_segment(im)
		if not has_str(ns, name) and not has_str(ids, name) {
			out.append(f"L101 unused import \"{im}\"")
		}
	}
}

# lint_dead_fns reports a private function nothing calls. `main` is the program's entry —
# the runtime calls it, so it is never "unused" no matter what the source says.
fn lint_dead_fns(f: File, calls: list[str], ids: list[str], mut &out: list[str]) {
	reqs := spec_required_names(f)
	for fd in f.fns {
		# `init` is called by the generated main, the same way the runtime calls `main`
		if fd.is_pub or fd.name == "main" or is_init_name(fd.name) {
			continue_marker()
		} else if has_str(reqs, fd.name) {
			# A METHOD THAT SATISFIES A SPEC IS AN INTERFACE, the way a `pub` function is: what
			# calls it may be another program, or — for `Into` — the compiler, at a typed
			# position where nothing in the source spells the call at all. `impl Into[int] for
			# Celsius` reported its own `into` as dead code in a program that converted four
			# times.
			continue_marker()
		} else if not has_str(calls, fd.name) and not has_str(ids, fd.name) {
			out.append(f"L102 private function `{fd.name}` is never called")
		}
	}
}

# spec_required_names is every method name some spec in the program declares. It is asked of
# the SPECS rather than of the impls, and deliberately: a name is checked here, not a (type,
# name) pair, and matching more loosely errs toward saying nothing — which is the right
# direction for a rule whose finding is "delete this".
fn spec_required_names(f: File) -> list[str] {
	mut out: list[str] = []
	for sp in f.specs {
		for r in sp.reqs {
			out.append(r.name)
		}
	}
	return out
}

# lint_unread_bindings reports a binding whose name is never mentioned again inside the
# function that declared it. It is deliberately per-function and name-based: the subset
# has no shadowing rules to model, and a name that reappears anywhere in the body is
# enough to call the binding read.
#
# `_` is answered here too, as L104, and not by a walk of its own: this loop is already handed
# every name a function binds, `_` among them. An unread `_` is what `_` MEANS, so "never read"
# is the one thing there is no point saying about it — what is worth saying is that the BINDER
# has no reader, and that is the same fact this walk already has in hand.
fn lint_unread_bindings(f: File, mut &out: list[str]) {
	for fd in f.fns {
		mut names: list[str] = []
		collect_binds(fd.body, names)

		# THE BODY IS WALKED ONCE PER FUNCTION, not once per binding. The walk does not depend
		# on `n`, and it sat inside the loop — so a function with forty bindings walked its own
		# body forty times, and the rule cost the square of what it needed to.
		mut ids: list[str] = []
		mut calls: list[str] = []
		mut ns: list[str] = []
		walk_body(fd.body, ids, calls, ns)

		for n in names {
			if n == "_" {
				out.append(f"L104 `_ :=` in `{fd.name}` — the expression is already a statement, so the binder says nothing")
				continue
			}

			if not has_str(ids, n) {
				out.append(f"L103 binding `{n}` in `{fd.name}` is never read")
			}
		}
	}
}

# --- collection ------------------------------------------------------------------------

# collect_binds gathers the names a block binds, descending into nested blocks.
fn collect_binds(body: list[Stmt], mut &names: list[str]) {
	for s in body {
		match s {
			SLet(name, ty, has_ty, is_mut, is_const, value) => collect_binds_let(name, value, names)
			SIf(cond, then_b, has_else, else_b) => collect_binds_if(then_b, else_b, names)
			SFor(is_cond, cond, body_b) => collect_binds(body_b, names)
			SForIn(name, iter, body_b) => collect_binds(body_b, names)
			SIfLet(name, value, then_b, has_else, else_b) => collect_binds_iflet(name, then_b, else_b, names)
			SExpr(x) => collect_binds_expr(x, names)
			SSelect(arms) => collect_binds_arms(arms, names)
			SForSelect(arms) => collect_binds_arms(arms, names)
			_ => skip()
		}
	}
}

# collect_binds_arms reaches the bindings inside a select's arm bodies. Without it a binding
# made in an arm was invisible to L103 and L104 both — an arm body is a block like any other.
fn collect_binds_arms(arms: list[SelArm], mut &names: list[str]) {
	for a in arms {
		collect_binds(a.body, names)
	}
}

fn collect_binds_let(name: str, value: Expr, mut &names: list[str]) {
	names.append(name)
	collect_binds_expr(value, names)
}

# collect_binds_expr descends into the one EXPRESSION that carries a block of its own.
# `guard` is an expression (GRAMMAR#guard-expr), so a binding made inside one is reached from the
# statement that holds the guard rather than from a statement of its own.
fn collect_binds_expr(e: Expr, mut &names: list[str]) {
	match e {
		EGuard(body_b) => collect_binds(body_b, names)

		# a closure's body is a block too, and `walk_body` already counts the reads inside one
		# — so without this the bindings in a closure were collected by nobody and answered to
		# neither rule
		EFn(ps, has_ret, ret, body_b) => collect_binds(body_b, names)
		_ => skip()
	}
}

fn collect_binds_if(then_b: list[Stmt], else_b: list[Stmt], mut &names: list[str]) {
	collect_binds(then_b, names)
	collect_binds(else_b, names)
}

# collect_binds_iflet records the name `if v := e` binds as well as the blocks', since
# the binding is the whole reason the form exists and an unread one is still dead.
fn collect_binds_iflet(name: str, then_b: list[Stmt], else_b: list[Stmt], mut &names: list[str]) {
	names.append(name)
	collect_binds(then_b, names)
	collect_binds(else_b, names)
}

# walk_body records every identifier read, every called function name, and every namespace
# a method call goes through, for a whole block.
fn walk_body(body: list[Stmt], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	for s in body {
		match s {
			SLet(name, ty, has_ty, is_mut, is_const, value) => walk_expr(value, ids, calls, ns)
			SAssign(target, value) => walk_pair(target, value, ids, calls, ns)
			SPrint(x) => walk_expr(x, ids, calls, ns)
			SReturn(has_value, value) => walk_expr(value, ids, calls, ns)
			SReturnIf(value, cond) => walk_pair(value, cond, ids, calls, ns)
			SExpr(x) => walk_expr(x, ids, calls, ns)
			SIf(cond, then_b, has_else, else_b) => walk_if(cond, then_b, else_b, ids, calls, ns)
			SIfLet(name, value, then_b, has_else, else_b) => walk_if(value, then_b, else_b, ids, calls, ns)
			SFor(is_cond, cond, body_b) => walk_loop(cond, body_b, ids, calls, ns)
			SForIn(name, iter, body_b) => walk_loop(iter, body_b, ids, calls, ns)
			SRaise(x, hc, c) => walk_raise(x, hc, c, ids, calls, ns)
			SDefer(x) => walk_expr(x, ids, calls, ns)
			SSpawn(x) => walk_expr(x, ids, calls, ns)
			SSend(ch, v) => walk_pair(ch, v, ids, calls, ns)
			SSelect(arms) => walk_sel(arms, ids, calls, ns)
			SForSelect(arms) => walk_sel(arms, ids, calls, ns)
			SDel(n) => ids.append(n)
			SClose(ch, at_exit) => walk_expr(ch, ids, calls, ns)
			_ => skip()
		}
	}
}

fn walk_pair(a: Expr, b: Expr, mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(a, ids, calls, ns)
	walk_expr(b, ids, calls, ns)
}

fn walk_if(cond: Expr, then_b: list[Stmt], else_b: list[Stmt], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(cond, ids, calls, ns)
	walk_body(then_b, ids, calls, ns)
	walk_body(else_b, ids, calls, ns)
}

fn walk_loop(head: Expr, body_b: list[Stmt], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(head, ids, calls, ns)
	walk_body(body_b, ids, calls, ns)
}

# walk_expr records the names an expression reaches for.
fn walk_sel(arms: list[SelArm], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	for a in arms {
		walk_expr(a.ch, ids, calls, ns)
		walk_expr(a.val, ids, calls, ns)
		walk_body(a.body, ids, calls, ns)
	}
}

fn walk_two_lists(a: list[Expr], b: list[Expr], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_all(a, ids, calls, ns)
	walk_all(b, ids, calls, ns)
}

# walk_raise visits a raise's Err and, when it has one, its `from` cause — both are
# ordinary expressions, and a name used only as a cause is still a name used.
fn walk_raise(x: Expr, has_cause: bool, cause: Expr, mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(x, ids, calls, ns)
	if has_cause {
		walk_expr(cause, ids, calls, ns)
	}
}

fn walk_expr(e: Expr, mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	match e {
		EIdent(name) => ids.append(name)
		EUnary(oper, x) => walk_expr(x, ids, calls, ns)
		EBinary(oper, a, b) => walk_pair(a, b, ids, calls, ns)
		ECall(name, args, _) => walk_call(name, args, ids, calls, ns)
		EField(target, name) => walk_expr(target, ids, calls, ns)
		EOptChain(target, name) => walk_expr(target, ids, calls, ns)
		ETry(x) => walk_expr(x, ids, calls, ns)
		EIndex(target, idx) => walk_pair(target, idx, ids, calls, ns)
		EMethod(target, meth, args) => walk_method(target, meth, args, ids, calls, ns)
		EListLit(elems) => walk_all(elems, ids, calls, ns)
		EConv(ty, x, nm) => walk_expr(x, ids, calls, ns)
		EIf(cond, then_e, else_e) => walk_three(cond, then_e, else_e, ids, calls, ns)
		EMatch(scrut, arms) => walk_match(scrut, arms, ids, calls, ns)
		ERange(lo, hi, inclusive) => walk_pair(lo, hi, ids, calls, ns)
		ETuple(elems) => walk_all(elems, ids, calls, ns)
		EMapLit(ks, vs) => walk_two_lists(ks, vs, ids, calls, ns)
		EFn(ps, has_ret, ret, body) => walk_body(body, ids, calls, ns)
		EChanNew(t, cap) => walk_expr(cap, ids, calls, ns)
		ERecv(ch) => walk_expr(ch, ids, calls, ns)
		EForce(x) => walk_expr(x, ids, calls, ns)
		ECoalesce(a, b, jump) => walk_coalesce(a, b, jump, ids, calls, ns)
		EGuard(body) => walk_body(body, ids, calls, ns)

		# only the SUBJECT is a name the program bound — the right side of `is` is an error
		# kind, so counting it as a use would keep an unused import alive.
		EIs(x, name) => walk_expr(x, ids, calls, ns)
		EIn(x, set)  => walk_pair(x, set, ids, calls, ns)
		_            => skip()
	}
}

# walk_coalesce reaches both halves of `a ?? b`: the fallback is either an expression or
# a divergent statement, and only one of the two is ever populated.
fn walk_coalesce(a: Expr, b: Expr, jump: list[Stmt], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(a, ids, calls, ns)
	walk_expr(b, ids, calls, ns)
	walk_body(jump, ids, calls, ns)
}

fn walk_call(name: str, args: list[Expr], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	calls.append(name)
	walk_all(args, ids, calls, ns)
}

# walk_method records the receiver of `x.m(...)`. When the receiver is a bare name it may
# be a MODULE namespace (`io.write(…)`) rather than a value, which is exactly what tells
# an import apart from a dead one — so it is recorded as both.
# walk_method records what a `target.meth(args)` reaches. The method NAME is a call: it
# may be a method on a value, and a private one of those has no other spelling that would
# mark it used — without this every private method reads as dead code. When the target is
# a bare identifier it is also recorded as a namespace, because the same syntax is how a
# module's function is reached, and that is what tells an import from an unused one.
fn walk_method(target: Expr, meth: str, args: list[Expr], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	match target {
		EIdent(name) => ns.append(name)
		_            => skip()
	}
	calls.append(meth)
	walk_expr(target, ids, calls, ns)
	walk_all(args, ids, calls, ns)
}

fn walk_three(a: Expr, b: Expr, c: Expr, mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(a, ids, calls, ns)
	walk_expr(b, ids, calls, ns)
	walk_expr(c, ids, calls, ns)
}

fn walk_all(es: list[Expr], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	for x in es {
		walk_expr(x, ids, calls, ns)
	}
}

fn walk_match(scrut: Expr, arms: list[Arm], mut &ids: list[str], mut &calls: list[str], mut &ns: list[str]) {
	walk_expr(scrut, ids, calls, ns)
	for a in arms {
		walk_expr(a.body, ids, calls, ns)
		if a.has_guard {
			walk_expr(a.guard_expr, ids, calls, ns)
		}
	}
}

# --- helpers -----------------------------------------------------------------------------

# last_segment is the namespace an import is reached through: `import "a/b"` binds `b`.
fn last_segment(path: str) -> str {
	b := list[byte](path)
	mut cut := 0
	mut seen := false
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
			seen = true
		}
		i = i + 1
	}
	return path if not seen
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

fn has_str(xs: list[str], want: str) -> bool {
	for x in xs {
		return true if x == want
	}
	return false
}

# skip is the no-op a match arm needs: an arm is an EXPRESSION, so a case with nothing to
# do still has to call something.
fn skip() {
	nop
}

# continue_marker stands in for a `continue` the subset's match-arm form cannot host.
fn continue_marker() {
	nop
}
