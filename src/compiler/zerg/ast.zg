# ast — the syntax tree of the self-hosting Zerg compiler (M2).
#
# The node set covers the Zerg-boot subset the compiler is written in and the examples
# corpus targets: function declarations, the statement forms (bindings, assignment,
# print, return / return-if, if / else, for, break / continue, nop, bare expression),
# and the expression forms (literals, identifiers, unary / binary operators, calls,
# and match). Expr and Stmt are recursive enums (auto-boxed by the runtime); the parser
# builds them and the emitter walks them to C.
#
# Literal nodes keep the surface lexeme (EInt / EFloat) so numbers emit verbatim, per the
# language's literal-surface invariant; EStr keeps the decoded value and the emitter
# re-escapes it into a C string literal. The value-type node is named Ty, not Type, which
# the bootstrap reserves.

# Ty is the small set of value types the subset needs, plus TVoid for a function with no
# return and TUnknown as the inference bottom.
#
# TFn is a function's type — its parameters and its result, and only that, which is what
# the language says a function type is. It exists so a function can be held: bound to a
# name, stored in a field, passed as an argument. Only a NAMED top-level function can be
# held that way here; a closure literal captures, and capture is not in the subset.
pub enum Ty {
	TInt
	TFloat
	TStr
	TBool
	TNil
	TVoid
	TUnknown
	TByte

	# TUint is `uint`, the unsigned 64-bit integer. It is a type of its OWN and not a mode of
	# TInt: docs/core/types.md makes `int + uint` a compile error, and `>>` arithmetic on the
	# signed one and logical on the unsigned — neither of which can be said if the two share a
	# variant. It used to, and both rules were unsayable.
	TUint

	# TRune is `rune`, a single Unicode CODE POINT — docs/core/types.md's third named integer
	# beside `int` and `uint`. It is what a `str` iterates as, which is the whole reason it is
	# a type and not a spelling of `int`: a str is UTF-8, so the thing a loop hands you is a
	# code point and not a byte, and a language that called both `int` could not say which.
	TRune
	TNamed(str)
	TList(Ty)
	TFn(list[Ty], Ty)
	TTuple(list[Ty])
	TMap(Ty, Ty)

	# TChan carries its element type and its DIRECTION — 0 bidirectional, 1 send-only
	# (`chan[T]<-`), 2 receive-only (`<-chan[T]`). A direction is a purely compile-time
	# property: all three are the same `zrt_chan*` at runtime, so it rides as a field
	# rather than as three variants that would triple every match over Ty.
	TChan(Ty, int)

	# TEither is `Either[X, Y]`, the one sum type of the value tier: a Left that is the
	# value, or a Right that is what gets propagated instead. `Result[T]` is the case whose
	# Right is `Err`, and it is spelled that way rather than held as a variant of its own —
	# two representations of one type is how an operator comes to handle a Result and miss
	# the Either it is.
	#
	# TErr is `Err` itself, the Right payload of a Result. It is the runtime's zrt_err by
	# value.
	TEither(Ty, Ty)

	# TOpt is `T?`, the optional. GRAMMAR group 8 defines it as `Either[T, nil]` — the same
	# shape as a Result with `nil` where the Err would be — so it lowers to a carrier with
	# the same tag/value layout and shares every accessor. What it does NOT share is why a
	# force fails: a Result's Right carries an Err to re-raise, and an optional's carries
	# nothing, so forcing an absent one raises a message of its own.
	TOpt(Ty)
	TErr
}

# Expr is an expression node.
pub enum Expr {
	EInt(str, int, int)
	EFloat(str)
	EStr(str)
	EBool(bool)
	ENil
	EIdent(str)
	EUnary(str, Expr)
	EBinary(str, Expr, Expr)

	# ECall's third field is the type arguments a call WROTE — `id[int](7)`. It is empty for
	# the ordinary call, whose type arguments are solved from the argument types instead;
	# what it carries is the case where the program said them, which inference must then
	# not overrule.
	#
	# It holds AT MOST ONE today. The parser recovers a written argument from an `EIndex`,
	# whose subscript is a single expression, so `id[int, str](…)` has no path in — the list
	# is the shape the field will need, not the shape it can currently be given.
	ECall(str, list[Expr], list[Ty])
	EField(Expr, str)

	# EOptChain is `a?.b` (GRAMMAR group 8): read `.b` when `a` is present, else nil IN
	# PLACE — the result is itself an optional, which is what lets a chain keep going
	# without a test at every link.
	EOptChain(Expr, str)

	# ETry is `x?` (GRAMMAR group 8): unwrap the payload, or early-return the absent side
	# from the ENCLOSING function. It is the one operator that is a control transfer wearing
	# an expression's clothes, which is why the function's own result type decides whether
	# it can be written at all.
	ETry(Expr)
	EIndex(Expr, Expr)
	EMethod(Expr, str, list[Expr])
	EListLit(list[Expr])

	# EFill is the fill form `[v; N]` — N copies of v (GRAMMAR group 4's `list-lit`). It is a
	# node of its own rather than N copies written out by the parser because N is a CONST-EXPR
	# and not a literal: it may name a module constant declared in another file, so the count
	# is not known until the whole program is in front of the emitter. The parser used to
	# expand it and could therefore only ever accept an integer literal there.
	EFill(Expr, Expr)

	# EConv carries the NAME TO REPORT THIS NODE AS, beside the target type — a diagnostic
	# that reads the type back names a form in the compiler's spelling rather than the
	# programmer's, and the two are not always the same word.
	#
	# "to report as" rather than "as written": two construction sites synthesize it, `b'J'`
	# as "byte" and an f-string hole as "str", because neither was spelled by the reader
	# and those are the nearest true names for what the node does.
	EConv(Ty, Expr, str)
	EIf(Expr, Expr, Expr)
	EMatch(Expr, list[Arm])

	# ERange is `a..b` / `a..=b`. GRAMMAR puts it between comparison and addition, so
	# `v in 0..10` reads `v in (0..10)`. `inclusive` is the `..=` form.
	ERange(Expr, Expr, bool)

	# ETuple is `(a, b)`. A tuple is read back by STATIC index — `t.0` — which parses as
	# an EField whose name is a number, so no separate access node is needed.
	ETuple(list[Expr])

	# EMapLit is `{k: v, …}` and the empty `{:}`. The keys and values are held as two
	# parallel lists, in the order they were written — a map keeps insertion order.
	EMapLit(list[Expr], list[Expr])

	# EFn is `fn(p: T) -> R { … }` in expression position. It carries what a FnDecl does
	# minus the name, because that is what it is: a function with nowhere to put its name.
	EFn(list[Param], bool, Ty, list[Stmt])

	# EChanNew is `chan[T](cap)`, and ERecv is the prefix `<-ch`. A send is a STATEMENT
	# (GRAMMAR: it yields no value), so it is in Stmt rather than here.
	EChanNew(Ty, Expr)
	ERecv(Expr)

	# EForce is `e!` — read the Left out of a Result, or re-raise the Right as an abort
	# here. It is the operator that turns "this might have ended" back into a plain value
	# for code that has nothing better to do about it than stop.
	EForce(Expr)

	# ECoalesce is `a ?? b` — the Left of `a`, or `b` when `a` is a Right. The third field
	# is the DIVERGENT form, `a ?? break` / `?? continue` / `?? return …` / `?? raise …`:
	# the spec writes `for { v := <-ch ?? break }` as the way to drain a channel, and a
	# jump is a statement, so it cannot be carried in the second field. When the third is
	# non-empty the second is ignored.
	ECoalesce(Expr, Expr, list[Stmt])

	# EGuard is `guard { … }`, and it is an EXPRESSION (GRAMMAR#guard-expr) yielding `Result[T]`
	# where T is the block's value: an abort inside the block becomes Right(err) instead of
	# ending the program, a normal completion becomes Left(v). It is the sole way back from
	# the abort tier, which is why it carries a whole block rather than an expression — the
	# thing being guarded is usually several statements.
	EGuard(list[Stmt])

	# EBlock is a `{ … }` standing where an EXPRESSION is wanted (GRAMMAR, group 2: a block
	# is a primary, group 4). Its value is its LAST statement's value — an expr-stmt yields
	# its expr, and any other statement, or an empty block, yields `nil`. The `;` the lexer
	# inserts only SEPARATES statements; it does not discard the value the way a trailing
	# `;` does in some languages.
	#
	# It carries a whole `list[Stmt]` for the same reason EGuard above does, and it is the
	# same node one brace along: `guard { … }` is a block expression under a catching
	# handler, so the two share their value rule, their scope cleanup, and — in emit.zg —
	# the statement-expression they lower to. What EBlock does not have is the abort-to-
	# value demotion, which is the whole of the difference.
	#
	# The SAME braces at a statement's start are a block STATEMENT (Stmt.SScope) whose value
	# is discarded. Position decides which, not shape, which is why the parser reads this one
	# only from parse_primary.
	EBlock(list[Stmt])

	# EIs is the type test `x is Name` (GRAMMAR#cmp-expr, at the comparison level and equally
	# non-associative). The right side is held as a NAME rather than a parsed Ty because
	# the grammar spells it `type-name` and nothing resolves it here — the emitter decides
	# what a name means. This phase answers only the built-in error kinds, which are the
	# one taxonomy carrying a runtime tag to compare.
	EIs(Expr, str)

	# EIn is the membership test `x in s` (GRAMMAR#cmp-expr, beside `is` and equally
	# non-associative). The right side is a SET, and what a set is depends on what is named:
	# an error KIND names itself and everything below it in the taxonomy, a container names its
	# elements, a range names its members. One rule — "is this a member of that" — which is
	# what keeps `in` one operator rather than two sharing a spelling.
	EIn(Expr, Expr)
}

# Arm is one match arm. `pat` selects the pattern shape: 0 = literal (match `lit` by
# equality), 1 = binding (bind the scrutinee to `bind`), 2 = wildcard `_`, 3 = enum
# constructor (`ctor` names the variant; `binds` names its payload fields). An arm may
# carry an `if` guard.
pub struct Arm {
	pub pat: int
	pub lit: Expr
	pub bind: str
	pub ctor: str
	pub binds: list[str]
	pub has_guard: bool
	pub guard_expr: Expr
	pub body: Expr
}

# Stmt is a statement node. Blocks are plain list[Stmt]; the `has_*` flags stand in for
# the optional parts the subset's flat enums cannot express as optionals.
pub enum Stmt {
	# SLet is a binding: the name, its declared type, whether one was WRITTEN, whether it
	# is `mut`, whether it is `const`, and the initializer. The three bools are in that
	# order — has_type, then is_mut, then is_const — which is worth saying because they
	# are the same type and a swap type-checks.
	#
	# is_const is carried rather than folded away because `const` means more than "not
	# mut": GRAMMAR group 4 makes a `const` binding SHADOW-PROOF — a name collision with
	# one, in either direction, is an error — and the emitter cannot enforce a property
	# the tree no longer records.
	SLet(str, Ty, bool, bool, bool, Expr)
	SAssign(Expr, Expr)
	SPrint(Expr)
	SReturn(bool, Expr)
	SReturnIf(Expr, Expr)
	SExpr(Expr)
	SIf(Expr, list[Stmt], bool, list[Stmt])
	SFor(bool, Expr, list[Stmt])
	SForIn(str, Expr, list[Stmt])

	# `for select { … }` — the multi-way wait as a LOOP: one ready arm per round, and the
	# loop ends when every watched receive channel has. It is its own node rather than an
	# SFor around an SSelect because the ending is the loop's, not the select's.
	SForSelect(list[SelArm])

	# SRaise is `raise e (from cause)?` (GRAMMAR group 8). The cause rides as a flag plus an
	# expression, the way every other optional part of a statement does here — the subset's
	# flat enums cannot hold an optional.
	SRaise(Expr, bool, Expr)
	SBreak
	SContinue
	SNop

	# SScope is a bare `{ … }` block used as a STATEMENT (GRAMMAR#compound-stmt). It opens a
	# scope and nothing else: the bindings made in it end at its `}`, which is the whole
	# reason to write one — and the whole of what `with` expands to.
	SScope(list[Stmt])

	# SDefer is `defer f(a)`. GRAMMAR runs it at the enclosing BLOCK's exit, on every path
	# out, last-scheduled-first.
	SDefer(Expr)

	# SSpawn is `spawn f(a)` — fire-and-forget. SSend is `ch <- v`.
	SSpawn(Expr)
	SSend(Expr, Expr)

	# SSelect is `select { … }`. Its arms are a struct rather than four Stmt variants
	# because every arm carries the same four things in different combinations.
	SSelect(list[SelArm])

	# SDel is `del name` — it REVOKES the name, for every type alike. It used to mean
	# something else for a channel, giving up a send end while leaving the name readable;
	# that is `close(ch)` now, and a channel binding gives up what it holds when its scope
	# ends, so `del` no longer has to be pressed into either job.
	SDel(str)

	# SClose is `close(ch)` — end this stream before my scope does. It is a STATEMENT and
	# not a call: `close` is a keyword, there is no symbol to take the address of, and it
	# yields no value, so it is shaped like SDel rather than pretending to be an ECall the
	# emitter has to intercept before every dispatch.
	#
	# The bool is `defer close(ch)`: the same close, run at the enclosing block's exit on
	# every path out. It rides here rather than inside SDefer because SDefer carries an
	# EXPRESSION and this is not one — and the two lower through one callee anyway.
	SClose(Expr, bool)

	# SIfLet is `if v := e { … } else { … }` — run the block only when `e` is a Left, with
	# `v` bound to what it held. It is a statement of its own rather than an SIf over some
	# condition expression because the binding only exists inside the then-branch, which no
	# condition can express.
	SIfLet(str, Expr, list[Stmt], bool, list[Stmt])

	# SAt is a POSITION MARKER, not a statement anybody wrote: the parser puts one before
	# each statement of a block, carrying that statement's line and column. It emits
	# nothing.
	#
	# It exists because a diagnostic without a line number is half a diagnostic, and the
	# alternative — a span field on all 21 Stmt variants and all 28 Expr ones — is 239
	# match arms across this compiler for one answer. A marker travels WITH the statement
	# through every list that holds one, which a parallel table indexed by source order
	# could not: a lambda's body is emitted at a different time from where it was written,
	# and a match arm's statements are visited more than once.
	#
	# It goes BEFORE its statement, never after, so the last element of a block is still
	# the statement whose value the block answers.
	SAt(int, int)
}

# SelArm is one select arm. `op` is 0 recv, 1 send, 3 default — the same order
# the runtime's ZRT_SEL_* constants use for the first two, so the emitter maps rather
# than translates. `bind` is the receive arm's optional name ("" when absent or `_`).
pub struct SelArm {
	pub op: int
	pub bind: str
	pub ch: Expr
	pub val: Expr
	pub body: list[Stmt]
}

# Param is one function parameter: its name, declared type, whether it is a mutable
# reference (`mut &name: T`), which lowers to a C pointer, and an optional DEFAULT — the
# expression a call uses when it omits the argument.
#
# A default is what makes an input optional; the language has no overloading, so this is
# where the flexibility comes from. Only a self-contained constant is carried, which is
# also all the seed lowers correctly (docs/code/functions.md) — a default built from an
# operator or a call is specified to be evaluated per call and is not honoured here.
pub struct Param {
	pub name: str
	pub ty: Ty
	pub is_ref: bool
	pub has_def: bool
	pub def: Expr
}

# FnDecl is a function declaration: name, the type it is a METHOD of ("" for a free
# function), parameters, an optional return type (has_ret false means it returns nothing),
# the body block, and whether it was declared `pub`. Visibility does not change the
# emitted C — but the linter needs it: an unused PRIVATE function is dead code, while an
# unused public one is simply part of a module's interface.
#
# A method is a plain FnDecl with `recv` set. The parser flattens an `impl T { … }` block
# into these, prepending a `this: T` parameter, so the receiver is an ordinary first
# argument from here down and nothing else in the compiler has to know about impls. Only
# the C NAME differs: a free function is one flat `zg_<name>`, a method is
# `zg_<T>_<name>`, which is also what keeps a method off the flat name space a program
# shares with every module it imports.
pub struct FnDecl {
	pub name: str
	pub recv: str
	pub params: list[Param]
	pub has_ret: bool
	pub ret: Ty
	pub body: list[Stmt]
	pub is_pub: bool

	# path is the file this function was READ FROM. A diagnostic needs it, and a whole
	# program is merged into one File before emission, so by then nothing else remembers
	# which module a statement came from. It rides here rather than on the SAt marker
	# because a function comes wholly from one file — one field instead of one per
	# statement — and rides on a STRUCT rather than an enum, so it costs its construction
	# sites and no match arm anywhere.
	pub path: str

	# line / col are where the declaration begins. A diagnostic about the SIGNATURE — a
	# default that cannot fit its parameter, a `mut &` given one — is made before any
	# statement is emitted, so the SAt markers have not said anything yet and there is no
	# other position to report.
	pub line: int
	pub col: int

	# tparams / tbounds are `fn f[T, U: Eq](…)` — the type parameter NAMES and, in the same
	# order, the bound each carries or "" for none. A bound is a CONJUNCTION — `T: Eq + Show`
	# asks for both — and its specs are carried joined by `+` in the one string, because a
	# bound is read in one place (the parser) and checked in one place (the instantiation),
	# so the shape that matters is the shape there. `join_bounds` writes it and
	# `c_split_bounds` reads it back; a `+` cannot appear in a spec name.
	pub tparams: list[str]
	pub tbounds: list[str]

	# in_unsafe is whether this function was declared inside a module-level `unsafe { … }`
	# group, which GRAMMAR group 12 makes an unsafe fn: "unsafe throughout its body, callable
	# only from unsafe". It rides on the declaration for the same reason `path` does — the
	# whole program is merged into one File before emission, and by then nothing else
	# remembers which group a function was written in.
	#
	# A method, a lambda and a monomorphized specialization each take the flag from whatever
	# they were written in or made for, so the context is not lost by being copied.
	pub in_unsafe: bool

	# is_test is whether this function was declared under `#[test]` — the decorator that marks
	# a function `zerg test` runs (docs/core/decorators.md). It rides on the declaration and
	# not on a list beside it, the way a derive does, because a derive is read BEFORE the
	# declaration it names exists while this one is taken by the `fn` arm that just built the
	# declaration, and because the one thing that reads it — the test runner's discovery —
	# walks the functions.
	#
	# The flag changes nothing about a normal build: the function is type-checked and emitted
	# like any other, and nothing calls it. What calls it is the driver `zerg test` generates.
	pub is_test: bool
}

# Diag is one finding about an ill-formed program: what is wrong, and where. It is a
# VALUE rather than an abort because a compiler that dies on the first mistake makes a
# person find the second one by fixing the first — and because a renderer cannot draw a
# source line under a message that has already killed the process.
#
# `line` and `col` are 1-based and are where the STATEMENT starts; `path` is "" for a
# source parsed without one, and the renderer then says the line and column alone.
pub struct Diag {
	pub path: str
	pub line: int
	pub col: int

	# `code` is the rule's IDENTITY — `E307`, `L502` — and it is a field rather than the first
	# word of `msg` because everything that reads a diagnostic wants it separately: the
	# renderer puts it in front of the sentence, a gate pins it instead of the prose, and an
	# editor filters and groups by it. A code spelled only inside the text is one every reader
	# has to parse back out, which is the second copy of a language fact this struct's `fix`
	# field already exists to forbid. It is empty for a finding that has no code yet.
	pub code: str
	pub msg: str

	# `fix` is the SOURCE THAT REPLACES what stands at the place — empty when the finding has
	# no mechanical answer, which is nearly all of them. It exists so that an editor's quick
	# fix and the sentence a person reads come from ONE decision: the alternative is a server
	# that reads the replacement back out of its own message text, which is the second copy of
	# a language fact docs/tooling/lsp.md exists to forbid. A finding carrying one owes an
	# exact place too, since something is going to be overwritten there.
	pub fix: str
}

# diag_at builds one Diag. The DRIVER needs one for the finding only it can make — a
# program build whose entry declares no `fn main` — and the seed does not read a
# module-qualified struct constructor (`zerg.Diag(…)` emits a type name in call position),
# so the constructor lives here, beside the struct, as an ordinary function a caller in
# another module can reach.
pub fn diag_at(path: str, line: int, col: int, code: str, msg: str) -> Diag {
	return Diag(path, line, col, code, msg, "")
}

# place_line is the `  --> file:line:col` trailer every diagnostic of this compiler carries
# beneath its first line. It lives here for the same reason diag_at does: it is ONE fact
# about the output — the fact scripts/lib/diag.sh tells a diagnostic of ours from one of
# cc's by, and the one `has_place` and `place_is` both read — and it was spelled out three
# times, in the parser's refusals (p_place), in the emitter's depth limit and in the
# driver's renderer. Three copies of a layout that a shell gate treats as one.
#
# The pathless form is not a fallback but a real case: a parse with no file behind it —
# an f-string hole re-lexed on its own, a driver stage handed text — knows the position and
# not the file, and naming a file it does not have would be worse than saying less.
pub fn place_line(path: str, line: int, col: int) -> str {
	l := strconv.to_string(line, 10)
	c := strconv.to_string(col, 10)
	return f"  --> {l}:{c}" if path == ""
	return f"  --> {path}:{l}:{c}"
}

# FieldDef is one struct field: its name, its declared type, and the two things GRAMMAR's
# FIELD VISIBILITY & DEFAULTS note gives it a tail for.
#
# is_pub is `pub`, which marks the field for external INSTANCE ACCESS. It does not reach the
# emitted C — one flat struct either way — and it used to be read and dropped for exactly
# that reason. What it is kept for is the rule it is half of: a NON-pub field is
# module-private and must carry a default, so external code can construct the type without
# naming a value it may not read.
#
# has_def / def are the field's DEFAULT, and they are `Param`'s pair under another name.
# A default lets the field's constructor argument be omitted, and it is backfilled at each
# CONSTRUCTION — so an expression in it is evaluated per construction, as a parameter
# default is evaluated per call.
pub struct FieldDef {
	pub name: str
	pub ty: Ty
	pub is_pub: bool
	pub has_def: bool
	pub def: Expr

	# line / col are where the field was written. The rule about a field is a rule about a
	# DECLARATION, made before any statement is emitted, so there is no SAt marker to read
	# and the field carries its own place — per field, not per struct, because a struct with
	# twenty fields owes the reader the one that is wrong.
	pub line: int
	pub col: int
}

# StructDecl is a struct type declaration: its name and fields in source order.
pub struct StructDecl {
	pub name: str
	pub fields: list[FieldDef]

	# `pub` on the declaration (GRAMMAR#struct-decl). It was read and DROPPED for as long as
	# type visibility went unenforced, and a flag nothing reads is worse than no flag — so
	# the marker existed in the grammar, was accepted by the parser, and meant nothing. It
	# means what it says now: a type not marked here is module-private, and chk_ty_visible
	# refuses naming it from another module.
	pub is_pub: bool

	# the file it was declared in, so the module it belongs to can be asked. A type belongs
	# to whoever declared it, which is half of the orphan rule (docs/core/specs.md).
	pub path: str

	# where the `struct` keyword is. Every other declaration in this file carried a place and
	# this one carried only its file, because nothing had needed to point AT a struct — the
	# diagnostics about one point at a field, which has its own. An outline does need it: a
	# symbol a reader cannot jump to is a name in a list.
	pub line: int
	pub col: int
}

# TypeDecl is `type X = Y` — a NEW, DISTINCT type, not a transparent alias
# (docs/core/types.md). X takes on Y's representation, so a monomorphic one costs nothing at
# runtime; what it does not take on is Y's identity. There is no cast between them, and a
# value crosses by re-construction — `X(y)` and `Y(x)` — like any other conversion.
#
# It carries its position because the checks about it are the ordinary declaration ones: a
# name declared twice, a name that is also a struct, an underlying type nothing declares.
pub struct TypeDecl {
	pub name: str
	pub under: Ty
	pub is_pub: bool
	pub path: str
	pub line: int
	pub col: int
}

# VariantDef is one enum variant: its name, its payload field types (empty for a tag-only
# variant), and its DISCRIMINANT — the value the variant is, which defaults to the previous
# one plus one (from 0) and so is its position until a declaration says otherwise.
#
# It is carried at all because GRAMMAR#variant lets a fieldless enum spell its own values
# (`A = 3`), and those values are OBSERVABLE: `int(v)` reads one back and `E.of(n)` reverses
# it. A payload enum keeps its tag opaque and may not spell one.
#
# THE DISCRIMINANT IS THE EXPRESSION AS WRITTEN, not a number. GRAMMAR#variant gives the
# position a const-expr, and a const-expr may name a module constant — a name no parser can
# resolve, since the constant may be declared in another file of the same program and nothing
# has merged them yet. So the fold happens in c_build_enums, over the whole program, and what
# survives the parse is the tree; `has_discr` is what tells `A = 0` from an `A` that merely
# sits at position 0, a distinction E214 rests on. `line` / `col` are the variant's own name
# token, so a discriminant that does not fold is reported at the variant and not at the enum.
pub struct VariantDef {
	pub name: str
	pub fields: list[Ty]
	pub has_discr: bool
	pub discr: Expr
	pub line: int
	pub col: int
}

# EnumDecl is an enum type declaration: its name and variants in source (tag) order.
pub struct EnumDecl {
	pub name: str
	pub variants: list[VariantDef]

	# `pub` on the declaration — see StructDecl.is_pub
	pub is_pub: bool

	# the file it was declared in — see StructDecl.path
	pub path: str

	# where the `enum` keyword is — see StructDecl.line
	pub line: int
	pub col: int
}

# File is a whole parsed source file: its import paths, and its struct, enum, and
# function declarations in source order. Imports are kept (rather than skipped with the
# rest of the out-of-subset surface) because the driver resolves them into the source
# list it compiles, and the linter reports the ones nothing uses.
# SpecDecl is a `spec` declaration: the name, its own type parameters, the specs it
# extends, and the members it requires — as FULL SIGNATURES, parsed by the same code that
# parses an `impl`'s.
#
# It used to be a comma-joined string of member NAMES, produced by a token scanner that
# read the body as soup: the super-spec after `:` was swallowed whole, and a required
# member was satisfied by anything sharing its name, so `fn tag() -> str` satisfied
# `fn tag(n: int) -> int`. A signature is what a spec promises, so a signature is what it
# has to carry.
#
# `reqs` are FnDecls with an empty body, because that is exactly what a `fn-sig` is.
pub struct SpecDecl {
	pub name: str
	pub params: list[str]
	pub supers: list[str]

	# super_args are the TYPE ARGUMENTS each super was written with, row for row beside
	# `supers` — `spec Ord: Same[int]` keeps the `[int]`. They are a parallel list rather than
	# a field on a pair type because a super is a NAME everywhere else in this file, and the
	# arguments are read at exactly one place: the recursion that checks what the super
	# requires, which has to substitute them into the named spec's own parameters first.
	#
	# Dropping them is what made a parameterized super refusable-only: the parameter stayed
	# unsubstituted, so every correct `impl Ord` was turned away with "parameter `o` is int, and
	# the spec declares T".
	pub super_args: list[list[Ty]]
	pub reqs: list[FnDecl]

	# `pub` on the declaration — see StructDecl.is_pub. A spec is a type name like any other
	# in the registry, so it answers the visibility question the same way.
	pub is_pub: bool

	pub path: str
	pub line: int
	pub col: int
}

# spec_key is how a spec-with-arguments is named in ONE string — `Into[Meters]`, or just `Eq`
# where there are none. Both the parser (a type parameter's bound) and the emitter (the impl
# registry) build it from the same function, which is what makes a bound and an impl comparable
# without either side knowing how the other rendered its types.
#
# A `+` never appears in it, which is what keeps join_bounds' separator unambiguous.
pub fn spec_key(name: str, args: list[Ty]) -> str {
	return name if args.len() == 0

	mut out := name + "["
	mut i := 0
	for i < args.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + ty_name(args[i])
		i = i + 1
	}
	return out + "]"
}

# ImplDecl is an `impl Spec[args] for Target` head. The ARGS are kept: a parameterized
# spec counts its parameters into the (spec, type) pair (docs/core/specs.md), so they are
# both what the coherence key needs and what says which type the spec's `K` stands for
# when a required signature is compared against what the impl supplies.
pub struct ImplDecl {
	# `spec` is a keyword, so the field cannot be called that
	pub on: str
	pub args: list[Ty]
	pub target: str

	pub path: str
	pub line: int
	pub col: int
}

# ConstDecl is one module-level binding — `const K := 1`, `pub COUNT := 3`, or a plain
# `COUNT := 3` — the module's immutable top-level state (docs/runtime/package.md), with
# `pub` as its visibility. It mirrors SLet's fields and adds the three a DECLARATION owes
# a diagnostic — the file and the position it starts at — because a module constant is a
# statement of no function: by emission the whole program is one merged File, and there is
# no FnDecl and no SAt marker left to remember where it was written.
#
# `is_mut` is carried, and legal only with `in_unsafe`: the top level is immutable
# outside a module-level `unsafe { … }` group (docs/runtime/package.md), and PARSING the
# offending binding is what lets the refusal name its own declaration instead of
# answering `undefined name` at every use site. `in_unsafe` records that the binding was
# declared inside such a group — where a `mut` binding IS the language's mutable global
# (docs/runtime/ffi.md, GRAMMAR group 12) — so chk_top_muts can tell the legal home of a
# mutable global from the safe code it is banned in.
# `is_pub` is the visibility chk_visible enforces: c_const_globals keeps the whole
# declaration in the emitter's k_decls rows, and chk_visible reads this flag and the
# declaring module off the row, so a cross-module read of a non-`pub` constant is refused
# the way a private function's call is.
pub struct ConstDecl {
	pub name: str
	pub ty: Ty
	pub has_ty: bool
	pub is_mut: bool
	pub is_const: bool
	pub is_pub: bool
	pub in_unsafe: bool
	pub value: Expr

	pub path: str
	pub line: int
	pub col: int
}

# ImportDecl is one import SPEC — `pub? "path" (as name)?` (GRAMMAR#import-spec). It is a
# declaration and not a string because an import BINDS A NAMESPACE (GRAMMAR#import-stmt), and
# a binding is a name: the path says which module is compiled into the build, and `name` says
# what the program writes to reach it — the `as` alias when there is one, the path's last
# segment otherwise. Keeping only the path is what made the prefix decoration: every
# qualified name flattened to its last identifier, so an invented `bogus.f()` and a real
# `text.f()` were the same expression by the time anything looked.
#
# `at` / `line` / `col` are the three a DECLARATION owes a diagnostic, for ConstDecl's
# reason: by emission the whole program is one merged File, and an import belongs to no
# function, so nothing else would remember which file wrote it or where. The place is also
# an import's IDENTITY once the files are merged — two files importing one module under one
# name are otherwise indistinguishable rows.
pub struct ImportDecl {
	# the module path as written, without its quotes — `util/text`
	pub path: str

	# the name this import binds — the `as` alias, else the path's last segment
	pub name: str

	# `renamed` is whether an `as` was written. The name alone cannot say so, since
	# `import "a/text" as text` binds exactly what the plain form does.
	pub renamed: bool

	pub at: str
	pub line: int
	pub col: int
}

pub struct File {
	pub imports: list[ImportDecl]
	pub structs: list[StructDecl]
	pub enums: list[EnumDecl]
	pub specs: list[SpecDecl]
	pub impls: list[ImplDecl]
	pub fns: list[FnDecl]

	# types are the `type X = Y` declarations — strong typedefs, kept apart from structs
	# because they have no fields and from enums because they have no variants; what they
	# have is one underlying type and an identity of their own.
	pub types: list[TypeDecl]

	# consts are the module-level bindings — the module's immutable state, `const`-marked
	# or not, plus the `mut` ones kept so their refusal has a declaration to point at.
	# They are not statements of any function: they become C globals, assigned once
	# before anything runs.
	pub consts: list[ConstDecl]

	# derive_on / derive_spec are the `#[derive(X)]` decorators, as a pair of lists: the type
	# the decorator sat above and the spec it named. They are kept as PAIRS rather than on the
	# declaration because a decorator is its own top-level item here — it is read before the
	# declaration it applies to exists — and because what consumes them is one pass that wants
	# them all, not a walk over two kinds of declaration.
	pub derive_on: list[str]
	pub derive_spec: list[str]

	# stmts are the statements written at the TOP LEVEL. GRAMMAR#program derives them —
	# `program ::= stmt-list`, which is what SCRIPT mode makes the top level — so they are
	# grammatical and the parser reads each one whole; a COMPILE-mode build has nowhere to run
	# one, and refusing it is the emitter's (chk_top_stmts), for the reason a program with no
	# `fn main` is refused by the build and not by the parse (docs/conformance.md).
	#
	# What is kept is the PLACE and the word the statement starts with, not the tree: no pass
	# will ever walk one, and carrying a Stmt that nothing lowers is an invitation to lower it.
	pub stmts: list[TopStmt]

	# ty_quals are the MODULE QUALIFIERS this file wrote in a TYPE position — the `lib` of
	# `c: lib.Counter`, one entry per occurrence, with the place it was written.
	#
	# They are a list beside the declarations rather than part of the type, because
	# parse_base_type resolves `lib.Counter` to `Counter` and always has: every module of a
	# program flattens into one scope, so the qualifier says where the type came from and the
	# LAST SEGMENT is the name. That is the right reading for resolution and it throws away
	# the one thing the no-transitivity rule needs to see, so the fact is recorded on the side
	# instead of changing what a `Ty` is.
	#
	# It stays inside the parser's contract: what is written down is that a qualifier was
	# TYPED, which is a fact about the text. Whether the name it wrote is a namespace this
	# module may write is the checker's question, asked later, over the whole program.
	pub ty_quals: list[TyQual]
}

# TyQual is one such occurrence: the qualifier as written, and where.
pub struct TyQual {
	pub ns: str
	pub path: str
	pub line: int
	pub col: int
}

# TopStmt is one top-level statement, as much of it as a refusal needs: where it was written
# and what it starts with, so the sentence can name the form the reader typed.
pub struct TopStmt {
	pub word: str
	pub path: str
	pub line: int
	pub col: int
}

# last_segment is the name a module path ends with — `util/text` ends with `text`. It is
# what an import with no `as` binds (GRAMMAR#import-spec) and what a diagnostic calls a
# module, and it lives HERE, beside the declaration that needs it, because it used to live
# in two: one copy in the emitter and one in the linter, spelled differently and answering
# the same question. Two copies of a naming rule is one rule that can disagree with itself.
pub fn last_segment(path: str) -> str {
	b := bytearray(path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# --- the outline --------------------------------------------------------------------------

# Symbol is one declaration as an OUTLINE reads it: what it is called, what kind of thing it
# is, and where to jump to. It exists so the language server can answer
# `textDocument/documentSymbol` without holding an AST.
#
# A purpose-built type rather than making `FnDecl` and its siblings `pub`. The server imports
# this module across the `pub` boundary like any other consumer, and widening that boundary to
# the whole AST — every field of every declaration, for one list of names — would give it
# reach over the parser's shape and a reason to grow analysis of its own. What it needs is a
# name, a kind and a place, so that is what crosses.
#
# `kind` is a WORD and not an LSP number. The number is protocol, the server owns protocol,
# and a compiler that spelled `12` here would be a compiler that had to be edited when the
# protocol changed.
pub struct Symbol {
	pub name: str
	pub kind: str
	pub detail: str
	pub is_pub: bool
	pub line: int
	pub col: int
}

# file_symbols is every top-level declaration of one parsed file, in SOURCE order.
#
# Source order is not the order `File` holds them in: a file is parsed into one list per kind,
# so reading them out gives every struct, then every enum, then every function — an outline in
# which nothing is where the reader left it. They are collected and then sorted by position,
# which is a handful of items per file and an insertion sort.
#
# Only declarations. A top-level statement is in `f.stmts` and is not a declaration of
# anything, so it is not a symbol; an import IS one, because a reader looking for where a
# borrowed name comes from is asking exactly the question an outline answers.
pub fn file_symbols(f: File) -> list[Symbol] {
	mut out: list[Symbol] = []
	for im in f.imports {
		# the BINDING is the symbol, since that is the name written in the code below it; the
		# path it resolves to is the detail
		out.append(Symbol(im.name, "import", im.path, false, im.line, im.col))
	}
	for s in f.structs {
		out.append(Symbol(s.name, "struct", "", false, s.line, s.col))
	}
	for e in f.enums {
		out.append(Symbol(e.name, "enum", "", false, e.line, e.col))
	}
	for sp in f.specs {
		out.append(Symbol(sp.name, "spec", "", false, sp.line, sp.col))
	}
	for ip in f.impls {
		# an impl has no name of its own — it is a PAIRING, and the pairing is what a reader
		# scans an outline for. An inherent `impl T { … }` is not here at all: the parser
		# flattens it into ordinary functions carrying a receiver, and each of those is a
		# symbol below.
		out.append(Symbol(f"{ip.on} for {ip.target}", "impl", "", false, ip.line, ip.col))
	}
	for t in f.types {
		out.append(Symbol(t.name, "type", ty_name(t.under), t.is_pub, t.line, t.col))
	}
	for c in f.consts {
		mut detail := ""
		if c.has_ty {
			detail = ty_name(c.ty)
		}
		out.append(Symbol(c.name, "const", detail, c.is_pub, c.line, c.col))
	}
	for fd in f.fns {
		# a method and a free function are different things to a reader scanning a list of
		# them, and the receiver is the difference
		mut kind := "fn"
		if fd.recv != "" {
			kind = "method"
		}
		out.append(Symbol(fd.name, kind, fd.recv, fd.is_pub, fd.line, fd.col))
	}
	return sym_sorted(out)
}

# sym_sorted puts the symbols in source order.
#
# Insertion sort by adjacent swaps: a file's top level is tens of declarations, not thousands,
# and what matters about the algorithm is that it is STABLE — two declarations reported at
# the same position keep the order they were collected in rather than trading places between
# runs, which an outline would show as a list that reshuffles itself.
fn sym_sorted(syms: list[Symbol]) -> list[Symbol] {
	mut out: list[Symbol] = []
	for s in syms {
		out.append(s)
		mut j := out.len() - 1
		for j > 0 {
			break if not sym_before(out[j], out[j - 1])
			tmp := out[j - 1]
			out[j - 1] = out[j]
			out[j] = tmp
			j = j - 1
		}
	}
	return out
}

fn sym_before(a: Symbol, b: Symbol) -> bool {
	return a.line < b.line or (a.line == b.line and a.col < b.col)
}

# --- rendering ---------------------------------------------------------------------------

# dump_ast renders a parsed file as an indented tree — the `--emit ast` view. It is a
# debugging aid, so it shows SHAPE rather than every payload: each declaration, and each
# statement by kind with the expression kinds under it. That is what answers "did the
# parser see what I wrote", which is the only question this view exists for.
pub fn dump_ast(f: File) -> str {
	mut out := "file\n"
	for im in f.imports {
		# the binding is shown whenever it was renamed, because that is the half of an
		# import this view exists to answer: which name the program reaches the module by
		if im.renamed {
			out = out + "\timport \"" + im.path + "\" as " + im.name + "\n"
		} else {
			out = out + "\timport \"" + im.path + "\"\n"
		}
	}
	for s in f.structs {
		out = out + "\tstruct " + s.name + "\n"
		for fd in s.fields {
			out = out + "\t\tfield " + fd.name + ": " + ty_name(fd.ty) + "\n"
		}
	}
	for e in f.enums {
		out = out + "\tenum " + e.name + "\n"
		for v in e.variants {
			out = out + "\t\tvariant " + v.name + "\n"
		}
	}
	for fn_d in f.fns {
		out = out + "\t" + fn_kind(fn_d) + " " + qual_name(fn_d) + "(" + params_of(fn_d) + ")"
		if fn_d.has_ret {
			out = out + " -> " + ty_name(fn_d.ret)
		}
		out = out + "\n"
		out = out + dump_block(fn_d.body, "\t\t")
	}
	return out
}

fn fn_kind(f: FnDecl) -> str {
	return "pub fn" if f.is_pub
	return "fn"
}

# qual_name shows a method as `Type.name`, so the `--emit ast` view says which impl a
# function came from — the tree is otherwise flat and two types may name a method alike.
fn qual_name(f: FnDecl) -> str {
	return f"{f.recv}.{f.name}" if f.recv != ""
	return f.name
}

fn params_of(f: FnDecl) -> str {
	mut out := ""
	mut i := 0
	for i < f.params.len() {
		if i > 0 {
			out = out + ", "
		}
		p := f.params[i]
		if p.is_ref {
			out = out + "mut &"
		}
		out = out + p.name + ": " + ty_name(p.ty)
		i = i + 1
	}
	return out
}

fn dump_block(body: list[Stmt], ind: str) -> str {
	mut out := ""
	for s in body {
		out = out + dump_stmt(s, ind)
	}
	return out
}

fn dump_stmt(s: Stmt, ind: str) -> str {
	return match s {
		Stmt.SLet(name, ty, has_ty, is_mut, is_const, value) => f"{ind}let {name} = {expr_kind(value)}\n"
		Stmt.SAssign(target, value) => f"{ind}assign {expr_kind(target)} = {expr_kind(value)}\n"
		Stmt.SPrint(x) => f"{ind}print {expr_kind(x)}\n"
		Stmt.SReturn(has_value, value) => f"{ind}return {expr_kind(value)}\n"
		Stmt.SReturnIf(value, cond) => f"{ind}return-if {expr_kind(cond)}\n"
		Stmt.SExpr(x) => f"{ind}expr {expr_kind(x)}\n"
		Stmt.SIf(cond, then_b, has_else, else_b) => dump_if(cond, then_b, else_b, ind)
		Stmt.SIfLet(name, value, then_b, has_else, else_b) => ind + "if-let " + name + "\n" + dump_block(then_b, ind + "\t") + dump_block(else_b, ind + "\t")
		Stmt.SScope(body_b) => ind + "scope\n" + dump_block(body_b, ind + "\t")
		Stmt.SFor(is_cond, cond, body_b) => ind + "for " + expr_kind(cond) + "\n" + dump_block(body_b, ind + "\t")
		Stmt.SForIn(name, iter, body_b) => ind + "for " + name + " in " + expr_kind(iter) + "\n" + dump_block(body_b, ind + "\t")
		Stmt.SForSelect(arms) => ind + "for-select\n"
		Stmt.SRaise(x, _, _) => f"{ind}raise {expr_kind(x)}\n"
		Stmt.SBreak => ind + "break\n"
		Stmt.SContinue => ind + "continue\n"
		_ => ind + "nop\n"
	}
}

fn dump_if(cond: Expr, then_b: list[Stmt], else_b: list[Stmt], ind: str) -> str {
	mut out := ind + "if " + expr_kind(cond) + "\n" + dump_block(then_b, ind + "\t")
	if else_b.len() > 0 {
		out = out + ind + "else\n" + dump_block(else_b, ind + "\t")
	}
	return out
}

# expr_kind names an expression's shape, with the leaf's own text where it has one.
pub fn expr_kind(e: Expr) -> str {
	return match e {
		Expr.EInt(lex, _, _) => "int " + lex
		Expr.EFloat(lex) => "float " + lex
		Expr.EStr(v) => "str"
		Expr.EBool(v) => "bool"
		Expr.ENil => "nil"
		Expr.EIdent(n) => "ident " + n
		Expr.EUnary(oper, x) => "unary " + oper
		Expr.EBinary(oper, a, b) => "binary " + oper
		Expr.ECall(name, args, _) => "call " + name
		Expr.EField(target, name) => "field ." + name
		Expr.EOptChain(target, name) => "optional chain ?." + name
		Expr.ETry(x) => "try `?`"
		Expr.EIndex(target, idx) => "index"
		Expr.EMethod(target, meth, args) => "method ." + meth
		Expr.EListLit(elems) => "list-literal"
		Expr.EFill(v, n) => "fill"
		Expr.EConv(ty, x, nm) => "convert " + nm
		Expr.EIf(cond, then_e, else_e) => "if-expr"
		Expr.EMatch(scrut, arms) => "match"
		Expr.ERange(lo, hi, inclusive) => "range"
		Expr.ETuple(elems) => "tuple"
		Expr.EMapLit(ks, vs) => "map-literal"
		Expr.EFn(ps, has_ret, ret, body) => "fn-expr"
		Expr.EChanNew(t, cap) => "chan-new"
		Expr.ERecv(ch) => "recv"
		Expr.EForce(x) => "force"
		Expr.ECoalesce(a, b, jump) => "coalesce"
		Expr.EGuard(body) => "guard"
		Expr.EBlock(body) => "block-expr"
		Expr.EIs(x, name) => "is " + name
		Expr.EIn(x, set) => "in"
		_ => "?"
	}
}

# expr_parts is an expression's SUB-EXPRESSIONS, in written order — the one place this
# compiler says what "nested inside" means for an Expr. It is what lets the nesting bound
# be a property of the TREE rather than of a walk: the parser measures the tree through
# this list once, where it is built, and every later walk — the emitter's, the checker's,
# monomorphization's, and any added tomorrow — inherits the bound without a counter of its
# own. A third counter was the alternative, and a fourth would have followed it.
#
# Every variant is named, leaves included, and there is deliberately NO catch-all: a `_`
# here answers "no parts" for a node that has them, which is a hole in the bound that
# nothing reports. A new Expr variant must say what it contains.
#
# A BLOCK is not a part. `{ … }` as an expression, `guard { … }`, a closure body and
# `?? break` all carry STATEMENTS,
# and a statement's expressions are each measured on their own where that statement is
# read (parser.zg's p_expr_root) — descending here would need a second walk over Stmt to
# reach the same answer.
fn expr_parts(e: Expr) -> list[Expr] {
	return match e {
		Expr.EInt(_, _, _) => expr_parts_none()
		Expr.EFloat(_) => expr_parts_none()
		Expr.EStr(_) => expr_parts_none()
		Expr.EBool(_) => expr_parts_none()
		Expr.ENil => expr_parts_none()
		Expr.EIdent(_) => expr_parts_none()
		Expr.EUnary(_, x) => [x]
		Expr.EBinary(_, a, b) => [a, b]
		Expr.ECall(_, args, _) => args
		Expr.EField(x, _) => [x]
		Expr.EOptChain(x, _) => [x]
		Expr.ETry(x) => [x]
		Expr.EIndex(x, i) => [x, i]
		Expr.EMethod(x, _, args) => expr_parts_cons(x, args)
		Expr.EListLit(elems) => elems
		Expr.EFill(v, n) => [v, n]
		Expr.EConv(_, x, _) => [x]
		Expr.EIf(c, a, b) => [c, a, b]
		Expr.EMatch(scrut, arms) => expr_parts_arms(scrut, arms)
		Expr.ERange(lo, hi, _) => [lo, hi]
		Expr.ETuple(elems) => elems
		Expr.EMapLit(ks, vs) => expr_parts_cat(ks, vs)
		Expr.EFn(ps, _, _, _) => expr_parts_defs(ps)
		Expr.EChanNew(_, cap) => [cap]
		Expr.ERecv(ch) => [ch]
		Expr.EForce(x) => [x]
		Expr.ECoalesce(a, b, _) => [a, b]
		Expr.EGuard(_) => expr_parts_none()
		Expr.EBlock(_) => expr_parts_none()
		Expr.EIs(x, _) => [x]
		Expr.EIn(x, set) => [x, set]
	}
}

# expr_parts_none is "this node contains no expression". It is a function rather than a
# bare `[]` because the seed that compiles this compiler cannot infer an empty list
# literal's element type inside a match arm, and a leaf is where that literal would be.
fn expr_parts_none() -> list[Expr] {
	mut out: list[Expr] = []
	return out
}

# expr_parts_cons puts a node's target in front of its argument list, which is the order a
# method call is written in and the order a reader looking for the deep one expects.
fn expr_parts_cons(x: Expr, xs: list[Expr]) -> list[Expr] {
	mut out: list[Expr] = [x]
	for k in xs {
		out.append(k)
	}
	return out
}

fn expr_parts_cat(xs: list[Expr], ys: list[Expr]) -> list[Expr] {
	mut out: list[Expr] = []
	for k in xs {
		out.append(k)
	}
	for k in ys {
		out.append(k)
	}
	return out
}

# an arm's literal, its guard and its body are all expressions of the match that holds
# them — the body especially, since `match … { _ => <deep> }` is one expression tree
fn expr_parts_arms(scrut: Expr, arms: list[Arm]) -> list[Expr] {
	mut out: list[Expr] = [scrut]
	for a in arms {
		out.append(a.lit)
		out.append(a.guard_expr)
		out.append(a.body)
	}
	return out
}

# a closure literal's parameter DEFAULTS are expressions written inside the enclosing one,
# so they are parts of it; the body is a block and is measured statement by statement
fn expr_parts_defs(ps: list[Param]) -> list[Expr] {
	mut out: list[Expr] = []
	for pm in ps {
		if pm.has_def {
			out.append(pm.def)
		}
	}
	return out
}

# ty_name spells a type the way the source does.
# either_name spells an Either the way it is written: the one whose Right is `Err` is
# `Result[T]`, which is the name the language gives that case.
fn either_name(l: Ty, r: Ty) -> str {
	return f"Result[{ty_name(l)}]" if is_err_ty(r)
	return f"Either[{ty_name(l)}, {ty_name(r)}]"
}

fn is_err_ty(t: Ty) -> bool {
	return match t {
		Ty.TErr => true
		_       => false
	}
}

# ty_eq is whether two types are THE SAME type. It exists because `ty_name` was being used
# for the job, and `ty_name` is the DIAGNOSTIC SPELLING of a type: it collapsed TUnknown,
# TTuple and TMap all onto `"?"`, so `ty_name(a) == ty_name(b)` answered yes for a tuple
# and a map, and for two tuples of different shapes. The two composites are spelled out
# now, but the objection was never about those two — it is about the one below.
#
# TUnknown equals NOTHING, including itself. A type the compiler could not work out is not
# evidence that two things are the same; a caller that wants to let an unknown through says
# so itself, which is what makes this answer mean one thing.
fn ty_eq(a: Ty, b: Ty) -> bool {
	return match a {
		Ty.TNamed(an)      => ty_eq_named(an, b)
		Ty.TList(ae)       => ty_eq_list(ae, b)
		Ty.TOpt(ae)        => ty_eq_opt(ae, b)
		Ty.TMap(ak, av)    => ty_eq_map(ak, av, b)
		Ty.TChan(ae, ad)   => ty_eq_chan(ae, ad, b)
		Ty.TEither(al, ar) => ty_eq_either(al, ar, b)
		Ty.TFn(aps, ar)    => ty_eq_fn(aps, ar, b)
		Ty.TTuple(aes)     => ty_eq_tuple(aes, b)
		Ty.TUnknown        => false

		# every remaining variant is a scalar with a spelling of its own, so the name IS
		# the identity there — the one place the shortcut this function replaces was right
		_ => ty_name(a) == ty_name(b)
	}
}

fn ty_eq_named(an: str, b: Ty) -> bool {
	return match b {
		Ty.TNamed(bn) => an == bn
		_             => false
	}
}

fn ty_eq_list(ae: Ty, b: Ty) -> bool {
	return match b {
		Ty.TList(be) => ty_eq(ae, be)
		_            => false
	}
}

fn ty_eq_opt(ae: Ty, b: Ty) -> bool {
	return match b {
		Ty.TOpt(be) => ty_eq(ae, be)
		_           => false
	}
}

fn ty_eq_map(ak: Ty, av: Ty, b: Ty) -> bool {
	return match b {
		Ty.TMap(bk, bv) => ty_eq(ak, bk) and ty_eq(av, bv)
		_ => false
	}
}

# A DIRECTION is part of a channel's type: `chan[int]<-` and `<-chan[int]` are not
# interchangeable, and the emitter has its own direction check that says so more precisely.
fn ty_eq_chan(ae: Ty, ad: int, b: Ty) -> bool {
	return match b {
		Ty.TChan(be, bd) => ad == bd and ty_eq(ae, be)
		_ => false
	}
}

fn ty_eq_either(al: Ty, ar: Ty, b: Ty) -> bool {
	return match b {
		Ty.TEither(bl, br) => ty_eq(al, bl) and ty_eq(ar, br)
		_ => false
	}
}

fn ty_eq_fn(aps: list[Ty], ar: Ty, b: Ty) -> bool {
	return match b {
		Ty.TFn(bps, br) => ty_eq(ar, br) and ty_eq_all(aps, bps)
		_ => false
	}
}

fn ty_eq_tuple(aes: list[Ty], b: Ty) -> bool {
	return match b {
		Ty.TTuple(bes) => ty_eq_all(aes, bes)
		_ => false
	}
}

# ty_eq_all compares two type lists element-wise. A length mismatch is answered first, so
# the loop never indexes past either one.
fn ty_eq_all(xs: list[Ty], ys: list[Ty]) -> bool {
	return false if xs.len() != ys.len()
	mut i := 0
	for i < xs.len() {
		return false if not ty_eq(xs[i], ys[i])
		i = i + 1
	}
	return true
}

fn ty_name(t: Ty) -> str {
	return match t {
		Ty.TInt          => "int"
		Ty.TFloat        => "float"
		Ty.TStr          => "str"
		Ty.TBool         => "bool"
		Ty.TNil          => "nil"
		Ty.TVoid         => "void"
		Ty.TByte         => "byte"
		Ty.TUint         => "uint"
		Ty.TRune         => "rune"
		Ty.TNamed(n)     => n
		Ty.TList(e)      => f"list[{ty_name(e)}]"
		Ty.TFn(ps, r)    => f"fn({ty_names(ps)}) -> {ty_name(r)}"
		Ty.TChan(e, dir) => chan_ty_name(e, dir)
		Ty.TEither(l, r) => either_name(l, r)
		Ty.TOpt(e)       => f"{ty_name(e)}?"
		Ty.TErr          => "Err"
		Ty.TMap(k, v)    => f"map[{ty_name(k)}, {ty_name(v)}]"

		# spelled, because a diagnostic that says "a ?" tells the reader nothing — and
		# `print(a, b)` reaches one, since there is no two-argument `print` and the pair
		# builds a tuple. Only TUnknown is left as `?`, which is the honest spelling of a
		# type this compiler could not work out.
		Ty.TTuple(es) => f"({ty_names(es)})"
		_             => "?"
	}
}

# ty_is_chan / ty_chan_elem are the two shape questions asked about a channel type, and
# they live here — beside the spelling — because both the parser and the emitter ask them.
# The parser needs them to read the directional forms and the emitter needs them on nearly
# every lowering path; a type is a type, and one pair is what keeps the two from drifting.
# ty_tuple_elems is a tuple's element types, or an empty list for anything else.
fn ty_tuple_elems(t: Ty) -> list[Ty] {
	return match t {
		Ty.TTuple(es) => es
		_             => []
	}
}

fn ty_is_chan(t: Ty) -> bool {
	return match t {
		Ty.TChan(_, _) => true
		_ => false
	}
}

# ty_chan_dir reads back the direction ty_chan wrote: 0 bidirectional, 1 send-only,
# 2 receive-only. A type that is not a channel has no direction, and answers the
# bidirectional 0 rather than a value a caller would have to test for separately.
fn ty_chan_dir(t: Ty) -> int {
	return match t {
		Ty.TChan(_, d) => d
		_ => 0
	}
}

fn ty_chan_elem(t: Ty) -> Ty {
	return match t {
		Ty.TChan(e, _) => e
		_ => Ty.TUnknown
	}
}

# ty_chan_elem_check is the ONE rule about what a channel may carry: not an optional.
#
# It is here, beside the shape questions above, because it is a fact about the TYPE rather
# than about any position that spells one — and that is the whole point. It was once a
# check inside the emitter's constructor path, so `chan[int?](1)` was refused and every
# other position carrying the same type was accepted in silence: a parameter, a result, a
# struct field, a typed binding, a typedef, a `chan` nested inside another type. Written
# here and called where a channel's element type is READ, every position inherits it.
#
# WHY the rule exists, since it is a restriction and not an omission: a receive answers
# `T?` (GRAMMAR group 9), and `T?` does not nest. So on a channel of optionals a `nil` back
# from `<-ch` would mean two different facts — the value that was sent is absent, and the
# stream is over — with no operator able to tell them apart. One loud rule is worth more
# than that ambiguity; a value that may be absent travels in a struct, or as a sentinel the
# receiver agrees on.
#
# `at` is a place trailer (p_place), from a caller that knows where the type was written.
# It is "" for the one caller that cannot know: a `chan[T]` whose element arrives by
# SUBSTITUTION is written nowhere in the source, so there is no position to point at.
fn ty_chan_elem_check(elem: Ty, at: str) {
	raise f"E404 `chan[{ty_name(elem)}]` is refused — a channel of optionals: a receive answers `T?`, so `nil` would mean both the value that was sent and the end of the stream, and no operator can tell those apart. Wrap it in a struct, or agree on a sentinel" + at if ty_is_opt(elem)
}

# ty_chan is the ONE WAY to build a channel type, and it exists so the rule above cannot be
# walked around. Calling the rule "where an element type is READ" was still a list of doors,
# and a list of doors grows: the parser had two and the substituter one, and a fourth was
# added later in `chk_spec_subst` — a spec's `chan[K]` under `impl S[int?]` rebuilt the type
# by hand and asked nothing, so that one position accepted what the other three refuse.
#
# CONSTRUCTION is the door that cannot grow, because a `Ty.TChan` value cannot come into
# existence any other way. It is the same place the Go seed hangs its rule (typeref.go's
# `chanType`), which is why the seed never had a hole of this shape.
#
# `at` is a place trailer (p_place) when the caller knows where the type was written, and ""
# when there is nothing to point at — a channel type reached by SUBSTITUTION is spelled
# nowhere in the source.
fn ty_chan(elem: Ty, dir: int, at: str) -> Ty {
	ty_chan_elem_check(elem, at)
	return Ty.TChan(elem, dir)
}

# ty_is_opt is the shape question the rule above asks, and it is spelled here because this
# is the file every stage may read: the parser asks it and may not call into the emitter
# (scripts/layering-check.sh), so an emitter-side copy could only ever be a second one.
#
# It was. `c_is_opt` sat in emit.zg, character for character the same match, answering the
# same question at some thirty call sites — the shape a fact about types takes when the
# stage that needed it first could not reach the stage that already had it. The emitter
# reads this file directly (ty_is_chan, ty_chan_elem), so the copy had nothing left to be
# for and is gone.
fn ty_is_opt(t: Ty) -> bool {
	return match t {
		Ty.TOpt(_) => true
		_          => false
	}
}

# chan_ty_name spells a channel end the way the source does, direction and all, so a
# diagnostic about one can say which end it is talking about.
fn chan_ty_name(elem: Ty, dir: int) -> str {
	return f"chan[{ty_name(elem)}]<-" if dir == 1
	return f"<-chan[{ty_name(elem)}]" if dir == 2

	return f"chan[{ty_name(elem)}]"
}

fn ty_names(ts: list[Ty]) -> str {
	mut out := ""
	mut i := 0
	for i < ts.len() {
		if i > 0 {
			out = out + ", "
		}
		out = out + ty_name(ts[i])
		i = i + 1
	}
	return out
}
