# zerg — the self-hosting Zerg compiler.
#
# Six commands — build, test, fmt, lint, desugar, lsp — and the flags every tool owes its
# user: --help, --version, and --emit to stop after a stage. There are six because there
# are six JOBS: compiling is one of them however far along the pipeline you stop it, so the
# token stream, the tree, and the C are `--emit` values rather than commands of their own.
#
# `lsp` is the same compiler answering an editor rather than a shell. One binary and not
# two: a sub-command makes version skew between the compiler and the server physically
# impossible, and an editor needs nothing on PATH that is not there.
#
# `test` is a command rather than a flag on `build` because it compiles what `build` is
# defined by LEAVING OUT. A `*_test.zg` reaches no normal build (docs/runtime/package.md),
# and that exclusion is what keeps a test out of the shipped artifact; `zerg build --test`
# would put the two meanings on one command, and then a release step could ask for the
# wrong one. `build` compiles what ships, and what ships never contains a test.
#
# `desugar` is a command rather than a mode of `fmt` because it is the OTHER answer to the
# same question. `zerg fmt` writes the canonical form and canonical means sugared — it
# picks `return x if c` over the block. `zerg desugar` writes the core form the sugar is
# defined as, which is a source nobody commits: it exists so the two spellings can be
# built and compared. A flag would have made one command mean both.
#
# The command line is DECLARED with the stdlib `cli` module — each command with its own
# arguments and the function it runs — so the help text is generated from the same
# declarations the parser used and cannot drift from them.
# `build` is self-sufficient — it emits C beside the output, then invokes cc through the
# runtime's process-spawn leaf — and the compiler resolves `import` itself, so it works
# from any directory.
import (
	"cli"
	"io"
	"lsp"
	"sha256"
	"strconv"

	"zerg"
)

# banner is the one line `--version` prints. It cannot be called `version`: a program and
# the modules it imports flatten into one scope, and `cli.version` is a name in it.
#
# The NUMBER in it is not written here. It comes from `zerg.zerg_version()`, which is a
# generated file carrying whatever the root VERSION says — because a version literal in the
# driver is one that gets bumped for a release on the days somebody remembers, and every
# other day the compiler introduces itself as the release before last.
fn banner() -> str {
	return f"zerg {zerg.zerg_version()} (self-hosted)"
}

fn main(args: list[str]) {
	__zrt_exit(root().exec(args))
}

# root declares the whole command line once. Every sub-command names the function it runs,
# so dispatch is the declaration rather than a chain of string comparisons beside it.
fn root() -> cli.Command {
	# a multi-line chain is wrapped in parentheses: a line break after ')' would otherwise
	# end the statement
	return (
		cli.command("zerg", "the self-hosting Zerg compiler")
		.version(banner())
		.epilog(env_help())
		.sub(build_cmd())
		.sub(test_cmd())
		.sub(fmt_cmd())
		.sub(lint_cmd())
		.sub(desugar_cmd())
		.sub(lsp_cmd())
	)
}

# build is the only command that compiles; how FAR it goes is `--emit`, not a command of
# its own. The token stream, the tree, and the C are stages of one pipeline, so naming
# them as sub-commands said twice what `--emit` already says — and left a reader to
# discover that `zerg c f.zg` and `zerg build --emit c f.zg` were the same thing.
fn build_cmd() -> cli.Command {
	return (
		cli.command("build", "compile a program (see --emit)")
		.opt("e", "emit", "stop after a stage: tokens, ast, c, lib, bin — bin when the entry declares `main`, else lib", "")
		.opt("o", "output", "where to write the result (default: stdout for tokens/ast/c, the source name for lib/bin)")
		.opt("j", "jobs", "how many units to compile at once", "4")
		.add(cli.positional("file.zg", "the source to compile").required().repeated())
		.run(do_build)
	)
}

# test is `build` pointed at the files a build leaves out. A `*_test.zg` is compiled by no
# normal build (docs/runtime/package.md) — the exclusion is what keeps a test out of the
# shipped artifact — so the INCLUSION has to live somewhere, and it lives here rather than as
# a `--test` flag on `build`. `zerg build` keeps one meaning: it compiles what ships, and what
# ships never contains a test. A flag would have made the same command mean both, and the day
# somebody scripts `zerg build --test` into a release step there is nothing left to say no.
fn test_cmd() -> cli.Command {
	return (
		cli.command("test", "build and run the `#[test]` functions in every `*_test.zg` under a path")
		.add(cli.positional("path", "the directory to search (default: the current one)"))
		.run(do_test)
	)
}

fn fmt_cmd() -> cli.Command {
	return (
		cli.command("fmt", "rewrite sources in the canonical style")
		.flag("c", "check", "report what is not canonical and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. F401; repeatable").repeated())
		.add(cli.positional("file.zg", "the sources to rewrite").required().repeated())
		.run(do_fmt)
	)
}

fn lint_cmd() -> cli.Command {
	return (
		cli.command("lint", "report unused imports and dead private code")
		.flag("s", "strict", "fail on a warning too, not only on a finding")
		.add(cli.positional("file.zg", "the sources to check").required().repeated())
		.run(do_lint)
	)
}

# desugar takes the same two flags `fmt` does, and they mean the same things: `--check`
# asks the question without touching anything, and `--off` names a rule to leave alone.
fn desugar_cmd() -> cli.Command {
	return (
		cli.command("desugar", "rewrite sources into the core forms their sugar is defined as")
		.flag("c", "check", "report what is not already core and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. D103; repeatable").repeated())
		.add(cli.positional("file.zg", "the sources to rewrite").required().repeated())
		.run(do_desugar)
	)
}

# lsp takes no arguments and no flags. The protocol is the interface: an editor starts the
# process, speaks JSON-RPC over its standard input and output, and stops it by closing them.
fn lsp_cmd() -> cli.Command {
	return (
		cli.command("lsp", "run the language server over stdio (JSON-RPC)")
		.run(do_lsp)
	)
}

# env_help is the part of the help no declaration can produce: where the compiler looks
# for the things it is not carrying.
fn env_help() -> str {
	return "Stages (--emit):\n" +
		"  tokens             the token stream, on stdout\n" +
		"  ast                the parsed tree, on stdout\n" +
		"  c                  the emitted C, on stdout\n" +
		"  lib                compile the C to an object file (default)\n" +
		"  bin                link an executable\n" +
		"\nEnvironment:\n" +
		"  ZERG_ROOT          installation root (default: the current directory)\n" +
		"  ZERG_RUNTIME       runtime C sources (default: $ZERG_ROOT/src/runtime/csrc)\n" +
		"  ZERG_STDLIB        standard library sources (default: $ZERG_ROOT/src/stdlib)\n" +
		"  ZERG_CSTD          the C dialect cc compiles the emitted code with (default: c17)\n"
}

# --- what each sub-command does -------------------------------------------------------------
#
# Each is handed the parsed command line and returns the process's exit status. There is no
# argument checking here: a missing file or an unreadable flag was refused before the
# function was ever called, which is the point of declaring the command line rather than
# unpicking it.

fn do_build(c: cli.Ctx) -> int {
	build_stage(c.args(), default_stage(c.get("emit"), c.args()), c.get("output"), job_count(c.get("jobs")))
	return 0
}

fn do_test(c: cli.Ctx) -> int {
	args := c.args()
	return run_tests(args[0]) if args.len() > 0

	return run_tests(".")
}

fn do_fmt(c: cli.Ctx) -> int {
	return run_fmt_check(c.args(), c.all("off")) if c.has("check")
	run_fmt(c.args(), c.all("off"))
	return 0
}

# do_lsp hands the server the one thing it cannot do for itself: turn a path and an unsaved
# buffer into the whole program that buffer belongs to. Resolving an import is 60 lines of
# environment variables, an installation root and a checkout layout, all of it here already,
# and none of it the protocol's business.
fn do_lsp(c: cli.Ctx) -> int {
	return lsp.serve(lsp_program)
}

fn lsp_program(path: str, text: str) -> lsp.Program {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	mut paths: list[str] = []
	mut root: list[str] = []
	load_with(path, dir_of(path), seen, root, srcs, paths, Buffer(path, text))
	return lsp.program(paths, srcs)
}

fn do_desugar(c: cli.Ctx) -> int {
	return run_desugar_check(c.args(), c.all("off")) if c.has("check")
	run_desugar(c.args(), c.all("off"))
	return 0
}

fn do_lint(c: cli.Ctx) -> int {
	return run_lint(c.args(), c.has("strict"))
}

# job_count reads -j, falling back to one job rather than none when it is not a number —
# a bad value should slow the build down, not stop it.
fn job_count(v: str) -> int {
	mut n := 0
	guard {
		n = strconv.parse_int(v, 10)
	}
	return 1 if n < 1
	return n
}

# default_stage resolves an unset `--emit` to what the entry file IS, so build_stage takes
# a stage it can trust rather than a sentinel it has to decode.
fn default_stage(emit: str, files: list[str]) -> str {
	return emit if emit != ""
	return "bin" if declares_main(files)

	return "lib"
}

# declares_main reports whether the ENTRY declares the program entry — the one thing that
# makes a source a program rather than a module.
#
# It asks the EMITTER's own predicate, because that is the module that acts on the answer:
# two definitions of "is this a program" would let this pick a library while the emitter
# writes a main wrapper into it.
#
# The entry only, not its imports: a module that happens to carry a `main` is not what the
# user pointed at. A file that cannot be read or parsed answers false and the ordinary
# pipeline reports why — this must not be the thing that says a source is broken.
#
# It reads and parses the file itself because its ONE caller runs before any pipeline has:
# default_stage decides which pipeline to run, so nothing has been loaded yet and there is
# no parse in hand to read this off. The rule inside `--emit bin` asks the same question of
# sources already loaded, and asks it with entry_has_main instead — a second read of a file
# the build has in memory is not a cheaper way to learn the same thing.
fn declares_main(files: list[str]) -> bool {
	return false if files.len() == 0

	mut found := false
	guard {
		src := read_source(files[0])
		found = zerg.c_has_main(zerg.parse_at(src, files[0]))
	}
	return found
}

# build_stage runs the pipeline as far as `emit` asks and no further.
#
# `-o` IS THE PATH WRITTEN, at every stage, which is the one sentence `--help` has always
# made ("where to write the result") and which was true of one stage in five. `--emit c`,
# `--emit tokens` and `--emit ast` ignored it entirely and wrote stdout — so `zerg build
# --emit c f.zg -o f.c` put the C on the terminal, created no `f.c`, and exited 0, which is
# the silent wrong answer this project forbids everywhere else. `--emit lib` read it and
# then appended `.o` to it unconditionally, so `-o out.o` wrote `out.o.o` beside an
# `out.o.o.c`.
#
# The DEFAULT is per stage and unchanged, because that is where the stages genuinely
# differ: the three reading stages are something a person is looking at, so with no `-o`
# they go to stdout and stay pipeable; the two that produce an artefact name it after the
# entry file, `.o` included, since a default has to be a whole path and only `--emit lib`
# knows the suffix its product wears. What no default may do is override what was asked
# for — a suffix appended to an explicit `-o` is the driver overruling the user.
#
# The default stage is the ENTRY FILE'S ANSWER, not a fixed one. A source is a module until
# something asks it to be a program, and what asks is `fn main` — so a file that declares
# one is built to a binary and a file that does not is built to an object, which is what
# each of them is for.
#
# It used to default to `lib` unconditionally, and every caller inside this repo passes
# `--emit bin` explicitly, so nothing here ever met the default. A first-time reader did:
# `zerg build main.zg -o app` wrote `app.o`, said nothing, and exited 0 — a program that
# silently is not one.
fn build_stage(files: list[str], emit: str, out: str, jobs: int) {
	# NO `guard` ON THE TWO STAGES BELOW. One used to wrap each of them whole, so a file that
	# could not be read, lexed or PARSED printed nothing and exited 0: `--emit ast` on a
	# program carrying an unbuilt form reported success and produced no tree. It is the
	# silent success load_unit had, and worse here — these are the two stages a person
	# reaches for when they want to know WHY a file will not build.
	if emit == "tokens" {
		write_result(zerg.dump_tokens(read_source(files[0])), out)
		return
	}
	if emit == "ast" {
		write_result(zerg.dump_ast(zerg.merge_files(load_sources(files))), out)
		return
	}
	if emit == "lib" {
		# separate compilation: the unit DECLARES the whole program but DEFINES only this
		# module, so its object can be linked beside the objects of the modules it imports.
		units := load_units(files[0])
		mut lex: list[zerg.Diag] = []
		lex_diags_of(unit_srcs(units), unit_paths(units), lex)
		report_diags(lex, unit_srcs(units), unit_paths(units))
		mut trees: list[zerg.File] = []
		for u in units {
			trees.append(zerg.merge_files_at(u.srcs, u.paths))
		}
		mut diags: list[zerg.Diag] = []
		obj_code := zerg.emit_unit_at(zerg.merge_asts(trees), trees[trees.len() - 1], diags)
		report_diags(diags, unit_srcs(units), unit_paths(units))
		compile_to(obj_code, out_or(out, drop_ext(files[0]) + ".o"), true)
		return
	}

	# `bin` DOES NOT COME THROUGH HERE. A whole-program emit answers the `c` stage's
	# question — one C file for the merged program — and a link does not want that file:
	# link_program compiles unit by unit so a rebuild that changes one module recompiles
	# one module, and it loads, parses and emits everything itself. Running both meant
	# every source was read twice, parsed twice and lowered twice, and the whole-program
	# C was written into a `str` and dropped. Cutting it is a THIRD of a cold `--emit bin`
	# self-build, and the diagnostics do not move: every rule that spoke here is a rule
	# c_emit_unit runs, and it runs it with the same whole-program view (merge_asts) over
	# every unit rather than once over the merge.
	if emit == "bin" {
		link_program(files[0], out_or(out, drop_ext(files[0])), jobs)
		return
	}
	if emit == "c" {
		mut paths: list[str] = []
		srcs := load_sources_at(files, paths)
		mut diags: list[zerg.Diag] = []
		lex_diags_of(srcs, paths, diags)
		report_diags(diags, srcs, paths)
		code := zerg.emit_files_diag(srcs, paths, diags)
		report_diags(diags, srcs, paths)
		guard {
			write_result(code, out)
		}
		return
	}
	io.ewrite(f"zerg: unknown stage {emit} (want tokens, ast, c, lib, or bin)\n")
	__zrt_exit(2)
}

# lex_check ends the run when a source has a token the lexer could not read. It is called
# the moment a file is READ — before its imports are scanned, since scanning them parses,
# and a parser handed unreadable text can only say something untrue about it. That is what
# the old answer was: "`b'b` is not an expression this compiler reads", naming the wrong
# layer, the wrong problem, and a fragment of what the person wrote.
fn lex_check(src: str, path: str) {
	mut one_src: list[str] = []
	mut one_path: list[str] = []
	one_src.append(src)
	one_path.append(path)
	report_diags(zerg.lex_diags(src, path), one_src, one_path)
}

# lex_diags_of collects the LEXICAL errors of every source, which are reported before
# anything is parsed: a token the lexer could not read is an error about text, and no later
# pass can say anything true about it — the one that used to try answered "not an
# expression", about the wrong layer and a fragment of what was written.
fn lex_diags_of(srcs: list[str], paths: list[str], mut &diags: list[zerg.Diag]) {
	mut i := 0
	for i < srcs.len() {
		mut path := ""
		if i < paths.len() {
			path = paths[i]
		}
		for d in zerg.lex_diags(srcs[i], path) {
			diags.append(d)
		}
		i = i + 1
	}
}

# unit_srcs / unit_paths flatten a build's units back into the two parallel lists the
# renderer looks a source up in. A unit knows its own files; a finding knows one path.
fn unit_srcs(units: list[Unit]) -> list[str] {
	mut out: list[str] = []
	for u in units {
		for s in u.srcs {
			out.append(s)
		}
	}
	return out
}

fn unit_paths(units: list[Unit]) -> list[str] {
	mut out: list[str] = []
	for u in units {
		for p in u.paths {
			out.append(p)
		}
	}
	return out
}

# report_diags ends the run when the program is ill-formed, having said EVERYTHING that is
# wrong with it. Nothing reaches cc after this: the C was built out of a program that does
# not typecheck, so any complaint cc had about it would be a second-hand account of a
# mistake already reported here, against a file the programmer cannot open.
#
# It exits rather than returning a status because it is called from the middle of a build,
# where the alternative is threading "did it work" back through every stage for a question
# with one answer.
fn report_diags(diags: list[zerg.Diag], srcs: list[str], paths: list[str]) {
	return if diags.len() == 0
	for d in diags {
		io.ewrite(render_diag(d, diag_source(d.path, srcs, paths)))
	}
	n := strconv.to_string(diags.len(), 10)
	if diags.len() > 1 {
		io.ewrite(f"zerg: {n} error(s)\n")
	}
	__zrt_exit(1)
}

# diag_code_prefix puts the rule's identity in FRONT of the sentence, and answers nothing at
# all for a finding that has no code yet. It is a function rather than a branch at each of its
# two call sites — `zerg build`'s renderer and `zerg lint`'s — because it is the layout
# scripts/lib/diag.sh asserts: the code opens the line, after `error: ` where there is one.
fn diag_code_prefix(d: zerg.Diag) -> str {
	return "" if d.code == ""

	return f"{d.code} "
}

# render_diag draws one finding the way a person reads it: what is wrong first, then where,
# then the line itself with a caret under the thing it is about.
#
#     error: cannot assign to `x`: it is immutable — declare it `mut x := …`
#      --> examples/foo.zg:3:2
#       |
#     3 |     x = 2
#       |     ^
#
# The source line is omitted when the file cannot be found — a diagnostic is still a
# diagnostic without it, and guessing at a line nobody read would be worse than saying
# less.
fn render_diag(d: zerg.Diag, src: str) -> str {
	mut out := f"error: {diag_code_prefix(d)}{d.msg}\n"
	line_s := strconv.to_string(d.line, 10)
	if d.line > 0 {
		out = out + zerg.place_line(d.path, d.line, d.col) + "\n"
	}

	text := source_line(src, d.line)
	return out if text == "" or d.line == 0

	gutter := blanks(bytearray(line_s).len())
	out = out + f" {gutter} |\n"
	out = out + f" {line_s} | {text}\n"

	# the caret marks the TOKEN when the message names one in backticks and it is on this
	# line at or after the statement's column; otherwise it marks where the statement
	# starts, which is all the position this compiler records. A quoted name that is a type
	# rather than a token — or one that appears twice — falls back rather than mislead.
	col := caret_col(text, d)
	return out + f" {gutter} | {caret_pad(text, col)}^\n"
}

# caret_pad is the run of whitespace that puts the caret under column `col` of `text`. It
# COPIES the source's own indentation rather than emitting spaces: a line indented with
# tabs renders one tab as many columns, so a caret padded with spaces lands short of the
# thing it points at by however much the terminal decided a tab was worth.
fn caret_pad(text: str, col: int) -> str {
	b := bytearray(text)
	mut out: list[byte] = []
	mut i := 0
	for i < col - 1 {
		if i < b.len() and b[i] == b'\t' {
			out.append(b'\t')
		} else {
			out.append(b' ')
		}
		i = i + 1
	}
	return str(out)
}

# caret_col is the 1-based column the caret goes under.
fn caret_col(text: str, d: zerg.Diag) -> int {
	q := first_quoted(d.msg)
	return d.col if q == ""
	at := index_from(text, q, d.col - 1)
	return d.col if at < 0
	return at + 1
}

# first_quoted is the first `…` run in a message, which is how every rule in this compiler
# names the thing it is talking about.
fn first_quoted(msg: str) -> str {
	b := bytearray(msg)
	mut i := 0
	for i < b.len() {
		if b[i] == b'`' {
			mut j := i + 1
			for j < b.len() and b[j] != b'`' {
				j = j + 1
			}
			return "" if j >= b.len()
			mut out: list[byte] = []
			mut k := i + 1
			for k < j {
				out.append(b[k])
				k = k + 1
			}
			return str(out)
		}
		i = i + 1
	}
	return ""
}

# index_from is where `needle` first occurs in `hay` at or after `from`, or -1.
fn index_from(hay: str, needle: str, start: int) -> int {
	h := bytearray(hay)
	n := bytearray(needle)
	return -1 if n.len() == 0 or n.len() > h.len()
	mut i := start
	if i < 0 {
		i = 0
	}
	for i <= h.len() - n.len() {
		mut j := 0
		for j < n.len() and h[i + j] == n[j] {
			j = j + 1
		}
		return i if j == n.len()
		i = i + 1
	}
	return -1
}

# source_line is the 1-based `n`th line of `src`, or "" when there is no such line.
fn source_line(src: str, n: int) -> str {
	return "" if n < 1

	b := bytearray(src)
	mut at := 1
	mut start := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'\n' {
			return line_slice(b, start, i) if at == n
			at = at + 1
			start = i + 1
		}
		i = i + 1
	}
	return line_slice(b, start, b.len()) if at == n
	return ""
}

fn line_slice(b: list[byte], at: int, to: int) -> str {
	mut out: list[byte] = []
	mut i := at
	for i < to {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn blanks(n: int) -> str {
	mut out := ""
	mut i := 0
	for i < n {
		out = out + " "
		i = i + 1
	}
	return out
}

# diag_source is the text of the file a finding is about, found by its path among the
# sources already loaded — the compiler does not read it again.
fn diag_source(path: str, srcs: list[str], paths: list[str]) -> str {
	mut i := 0
	for i < paths.len() and i < srcs.len() {
		return srcs[i] if paths[i] == path
		i = i + 1
	}
	return ""
}

# link_program builds a program the way a project is built: every unit compiled to its
# own object, then one link. A unit whose object is already in the cache is not compiled
# again — which is the whole point of splitting the build up, since most rebuilds change
# one module and leave the rest exactly as they were.
fn link_program(entry: str, output: str, jobs: int) {
	link_units(load_units(entry), entry, output, jobs)
}

# link_units is link_program with the units already in hand, and it is split out for the ONE
# caller that does not get them from an entry file: a test build's entry unit is a directory's
# files plus a generated driver, which no import path names. Everything after the load is the
# same work on the same values, so it is the same function rather than a second copy of the
# emit-cache-link sequence that would drift the moment one of them changed.
#
# `entry` is still passed, because the no-`fn main` finding below is about a FILE and has to
# name one.
fn link_units(units: list[Unit], entry: str, output: str, jobs: int) {
	# BEFORE anything is parsed: a token the lexer could not read is an error about text,
	# and a parser handed the wreckage can only say something untrue about it
	mut lex: list[zerg.Diag] = []
	lex_diags_of(unit_srcs(units), unit_paths(units), lex)
	report_diags(lex, unit_srcs(units), unit_paths(units))

	# Parse each unit ONCE, then build the whole-program view from those trees: emitting N
	# units used to re-parse the whole program N times, which cost more than the C
	# compiler did.
	mut trees: list[zerg.File] = []
	for u in units {
		trees.append(zerg.merge_files_at(u.srcs, u.paths))
	}

	prog := zerg.merge_asts(trees)
	mut diags: list[zerg.Diag] = []
	mut objs: list[str] = []
	mut todo_c: list[str] = []
	mut todo_o: list[str] = []
	mut ui := 0
	for ui < units.len() {
		code := zerg.emit_unit_at(prog, trees[ui], diags)
		obj := cache_path(unit_key(code))
		objs.append(obj)
		if not __zrt_exists(obj) {
			cpath := obj + ".c"
			guard {
				io.write_file(cpath, bytearray(code))
			}
			todo_c.append(cpath)
			todo_o.append(obj)
		}
		ui = ui + 1
	}

	# every unit is emitted before anything is reported, so one run answers for the whole
	# program rather than for its first bad module
	report_diags(diags, unit_srcs(units), unit_paths(units))

	# A program is a build rooted at an entry file that DEFINES `fn main`
	# (docs/runtime/package.md; GRAMMAR group 10) — grammatically a main-less source is
	# still Zerg, so no earlier stage objects to it, and nothing used to enforce the build
	# rule: the emitter wrote no wrapper and the first complaint was the linker's
	# `undefined symbol _main`, against generated code nobody wrote. The finding is about
	# the FILE, not a line in it, so it points at 1:1 — where a `fn main` would begin.
	# `--emit lib` stays main-less on purpose: an object file is what a module is for.
	#
	# It is asked HERE because here is where the answer already is: `trees` holds every
	# unit parsed once, and the entry is the LAST of them — load_unit appends a unit after
	# the ones it imports, which is the same fact `--emit lib` reads it by. Asked in the
	# driver it cost a second read of the entry off disk and a second parse of it.
	if not zerg.c_has_main(trees[trees.len() - 1]) {
		mut nomain: list[zerg.Diag] = []
		nomain.append(zerg.diag_at(entry, 1, 1, "E501", "this entry file declares no `fn main` — a program is a build rooted at an entry that defines one (docs/runtime/package.md); a module without an entry point builds with `--emit lib`"))
		report_diags(nomain, unit_srcs(units), unit_paths(units))
	}

	# The runtime is compiled the same way, and cached the same way. It changes far less
	# often than the program does, so recompiling its ten translation units on every link
	# was the largest thing a rebuild was paying for.
	for rc in rt_sources() {
		obj := cache_path(file_key(rc))
		objs.append(obj)
		if not __zrt_exists(obj) {
			todo_c.append(rc)
			todo_o.append(obj)
		}
	}
	compile_batch(todo_c, todo_o, jobs)
	if __zrt_exec(link_objs_argv(objs, output)) != 0 {
		io.ewrite("zerg: link failed\n")
		__zrt_exit(1)
	}
}

# rt_sources are the runtime translation units, as paths.
fn rt_sources() -> list[str] {
	rt := rt_dir()
	mut out: list[str] = []
	for u in rt_units() {
		out.append(f"{rt}/{u}")
	}
	return out
}

# file_key hashes a file the cache is keyed on. The runtime header goes into the key
# beside the source, because every runtime unit includes it and a change there changes
# what the object means.
fn file_key(path: str) -> str {
	mut body := ""
	guard {
		body = str(io.read_file(path)) + str(io.read_file(rt_dir() + "/zergrt.h"))
	}
	return unit_key(body)
}

# link_objs_argv links objects only — everything was compiled beforehand.
fn link_objs_argv(objs: list[str], output: str) -> list[str] {
	mut argv: list[str] = []
	argv.append(cc_bin())
	argv.append(cc_std())

	# LINK ONLY — no source is read here, so the dialect flags below belong to the two
	# invocations that compile, not to this one.
	argv.append("-o")
	argv.append(output)
	for o in objs {
		argv.append(o)
	}
	return argv
}

# compile_batch runs the cc invocations, `jobs` of them at a time. Each unit is
# independent — separate compilation is what made that true — so the only ordering that
# matters is that they all finish before the link.
#
# It fills a batch, waits for the batch, then starts the next. A sliding window would keep
# every core busy at the edges; batching keeps the bookkeeping to two lists, and with a
# handful of units per build the difference is not what anyone is waiting on.
fn compile_batch(cpaths: list[str], opaths: list[str], jobs: int) {
	mut running: list[int] = []
	mut i := 0
	for i < cpaths.len() {
		pid := __zrt_proc_spawn(cc_object_argv(cpaths[i], opaths[i]))
		if pid < 0 {
			io.ewrite("zerg: cannot start cc\n")
			__zrt_exit(1)
		}
		running.append(pid)
		i = i + 1
		if running.len() >= jobs {
			reap(running)
			running = []
		}
	}
	reap(running)
}

# reap waits for every child in the batch and fails the build if any cc did.
fn reap(pids: list[int]) {
	mut bad := false
	for p in pids {
		if __zrt_proc_wait(p) != 0 {
			bad = true
		}
	}
	if bad {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# --- the build cache -----------------------------------------------------------------------
#
# The cache is keyed on CONTENT, not on timestamps: the same emitted C always compiles to
# the same object, which is a property the self-host fixpoint already proves. So a unit's
# key is a hash of the C it emitted — which folds in its own source, everything it can see,
# and the compiler that produced it, since a change to any of those changes the C.
#
# And of the two inputs to `cc` that are not downstream of the C, so are the two things the
# C cannot stand in for. The DIALECT: without it, building the same program under c99 after
# building it under c17 is a cache hit that hands back the c17 objects and reports success —
# a dialect gate that never compiled anything in the dialect it names. The COMPILER itself:
# `cc` is a name, and the file it resolves to changes when $CC changes, when $PATH changes,
# and when a toolchain is installed beside the old one — without it, switching compilers
# reads back the objects the other one built.
#
# What goes in is the RESOLVED PATH (cc_bin), not the compiler's version string: a version
# needs the child's stdout, and this runtime spawns a child without reading one back. So an
# upgrade IN PLACE — same path, new build — is the case this key still cannot see.

# cache_dir is $ZERG_CACHE, else <root>/.zerg-cache, created on demand. A cache that
# cannot be created is not fatal: the build carries on without one.
fn cache_dir() -> str {
	dir := env_or("ZERG_CACHE", join_path(zerg_root(), ".zerg-cache"))
	__zrt_mkdir(dir)
	return dir
}

fn cache_path(key: str) -> str {
	return join_path(cache_dir(), key + ".o")
}

# unit_key names a unit's cached object by the SHA-256 of everything that decides what
# that object is: the C, and the compiler and dialect it will be compiled by.
#
# It was FNV-1a over the same bytes, with the LENGTH glued on beside it — a 32-bit hash is
# a cheap guard and not a proof, and the length was there to make the guard less bad. Two
# units colliding link the WRONG OBJECT, which is a build that succeeds and a program that
# is not the program: the failure a cache key exists to make impossible, answered with
# "far less likely". A digest is the answer, and the standard library has one now
# (`sha256`, pure Zerg, checked against FIPS 180-4's vectors and against the system tool).
fn unit_key(code: str) -> str {
	return sha256.hex(bytearray(f"{cc_bin()}\n{cc_std()}\n{code}"))
}

# compile_to writes the emitted C beside its product and hands it to cc — compiled only
# (`-c`, an object) or compiled and linked against the runtime (an executable).
fn compile_to(code: str, output: str, object_only: bool) {
	cpath := output + ".c"
	guard {
		io.write_file(cpath, bytearray(code))
	}
	mut argv: list[str] = []
	if object_only {
		argv = cc_object_argv(cpath, output)
	} else {
		argv = cc_argv(cpath, output)
	}
	if __zrt_exec(argv) != 0 {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# out_or is the `-o` path, or the stage's own default when none was given. It exists so the
# defaults are written where they belong — at the stage that knows what its product is
# called — rather than as one shared `output` computed ahead of the dispatch, which is how
# `--emit lib` came to append `.o` to a path the user had spelled in full.
fn out_or(out: str, dflt: str) -> str {
	return dflt if out == ""

	return out
}

# write_result writes a stage a person READS: to `-o` when there is one, and to stdout when
# there is not, so the pipe that has always worked goes on working. The three stages that
# use it took no path at all before, which made `-o` a flag the compiler accepted and
# discarded.
fn write_result(text: str, out: str) {
	if out == "" {
		io.write(text)
		return
	}
	guard {
		io.write_file(out, bytearray(text))
	}
}

# drop_ext removes a trailing ".zg" so `zerg build hello.zg` writes `hello`.
fn drop_ext(path: str) -> str {
	return path if not has_suffix(path, ".zg")

	b := bytearray(path)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() - 3 {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# --- compilation units --------------------------------------------------------------------
#
# A UNIT is what gets compiled to one object: a module. A file module is one unit of one
# file; a directory module is one unit of several, because its files share a scope and
# cannot be split. Separate compilation is unit-by-unit, which is what makes a build
# cacheable (a unit's object survives a change elsewhere) and parallelizable (units with
# no dependency between them can compile at once).

# Unit is one module: the name it is known by (its import path, or the entry file's path)
# and the sources that make it up.
struct Unit {
	pub name: str
	pub srcs: list[str]

	# paths is where each of `srcs` was read from, in the same order. A unit is what a
	# build compiles, so this is the only place the file a statement came from is still
	# known — by the time the trees are merged into a whole-program view, nothing else
	# remembers.
	pub paths: list[str]
}

# load_units returns every unit of the program, dependencies before dependents, the entry
# last. A unit is loaded once however many modules import it.
fn load_units(entry: str) -> list[Unit] {
	mut one: list[str] = []
	one.append(entry)
	return load_units_of(one, entry, dir_of(entry))
}

# load_units_of is load_units for an entry unit whose FILES are named directly rather than
# resolved from one path. A test build is the only caller: its entry unit is a directory's
# sources — the `*_test.zg` included, which is the whole of what a test build is — plus the
# driver `zerg test` generated, and no import path names that set.
fn load_units_of(files: list[str], name: str, from_dir: str) -> list[Unit] {
	mut seen: list[str] = []
	mut units: list[Unit] = []
	mut root: list[str] = []
	load_unit(files, name, from_dir, seen, root, units)
	return units
}

# `stack` is the path DOWN to this unit, and it is a separate list from `seen` because the two
# answer different questions — see chk_import_cycle. It arrives BY VALUE, which is what saves
# a pop: each frame appends its own name to its own copy, so unwinding is the return.
fn load_unit(files: list[str], name: str, from_dir: str, mut &seen: list[str], stack: list[str], mut &units: list[Unit]) {
	mut here := stack
	here.append(name)

	for s in seen {
		return if s == name
	}
	seen.append(name)
	mut srcs: list[str] = []
	mut paths: list[str] = []

	# NO `guard` HERE. It used to wrap this, so a file that could not be READ or could not
	# be LEXED was silently dropped from the unit — and a unit whose only source was dropped
	# is an empty program, which emits nothing and succeeds. `zerg build -o app prog.zg` on a
	# file with a bad f-string exited 0, wrote no binary, and said not one word; a Makefile or
	# a CI step reads that as a build.
	#
	# Both failures already carry their own sentence — io.read_file names the path, lex_check
	# names the lexical rule and where — so letting them out is what puts the real reason in
	# front of the reader. `load_with`, the loader beside this one, has read them so all along.
	for f in files {
		src := read_source(f)
		lex_check(src, f)
		srcs.append(src)
		paths.append(f)
	}

	# indexed, because the import scan is a full parse and so the FIRST one a source
	# meets: a refusal raised in it must already carry the file the place names, and
	# `paths` rides beside `srcs` row for row
	mut si := 0
	for si < srcs.len() {
		for imd in zerg.import_decls_at(srcs[si], paths[si]) {
			im := imd.path
			chk_test_import(imd)
			chk_unbuilt_module(imd)
			chk_import_cycle(here, im)
			load_unit(module_files(imd, dir_of(paths[si]), from_dir), im, from_dir, seen, here, units)
		}
		si = si + 1
	}
	units.append(Unit(name, srcs, paths))
}

# --- the test runner ------------------------------------------------------------------------
#
# A TEST BUILD IS A BUILD OF MORE FILES, not of a relaxed language. A `*_test.zg` sits in the
# module it tests and shares its namespace, so compiling it beside that module's other sources
# is the whole of what the white-box position means (docs/runtime/package.md): nothing about
# visibility moves, and there is no test-only way into a private name.
#
# So the unit of work is a DIRECTORY. A module is a directory whose files share a scope, and a
# directory holding a `*_test.zg` becomes one test binary — its own sources, its test files,
# and one generated driver that calls the `#[test]` functions by name.
#
# ONE PROCESS PER TEST, always. A test that overflows its stack or calls `os.exit` ends the
# process it is running in, and with every test in one process that would end all the tests
# after it too: the first crash would decide what the rest of the run reports. So the driver
# RE-EXECUTES ITSELF once per test — `__zrt_exe_path` names the running binary and `os.run`
# starts it — and the child runs exactly one test and stops. It is the slow arrangement and it
# is the correct one; a faster one is worth building on the day there is a measurement asking
# for it, and not before.
#
# A CHILD ANSWERS IN A FILE, not in its exit status. A status is one small integer: it cannot
# carry which assertion failed or what the values were, and — the part that decides the shape —
# `os.exit(0)` inside a test produces exactly the status a passing test does. So the child
# writes its verdict AFTER the body has returned, and a MISSING file is the fact that the body
# never did. Finishing is observed, never inferred from a number that cannot tell the two
# apart.

# run_tests is the whole command: find the packages, run each one's tests, and say what
# happened. It answers 0 only when nothing failed.
#
# A RUN THAT FOUND NOTHING SAYS SO. Discovering no test and printing nothing is
# indistinguishable from a run where everything passed, which is the one failure a test runner
# must not have — every gate in this repository is written against it.
fn run_tests(root: str) -> int {
	# A PATH THAT IS NOT THERE IS NOT AN EMPTY TREE. The walk below reads a missing directory as
	# a directory with nothing in it — that is what the runtime's listing answers, deliberately,
	# because its other caller is probing a search path — so `zerg test tset/` would report "no
	# tests", exit 0, and leave a typo looking exactly like a package nobody has written tests
	# for. The two are told apart HERE, where the path is the one the user typed.
	if not __zrt_exists(root) {
		io.ewrite(f"zerg: no such path `{root}`\n")
		return 2
	}

	mut pkgs: list[str] = []
	test_pkgs(root, pkgs)

	mut passed := 0
	mut failed := 0
	for d in pkgs {
		run_pkg(d, passed, failed)
	}

	if passed + failed == 0 {
		io.println(f"no tests: nothing under `{root}` declares a `#[test]` in a `*_test.zg`")
		return 0
	}
	io.println("")
	io.println(f"{passed} passed, {failed} failed")
	return 1 if failed > 0

	return 0
}

# test_pkgs collects the directories under `root` holding at least one `*_test.zg`, outermost
# first, in the sorted order the runtime's directory read guarantees — so two runs of the same
# tree report in the same order.
#
# A DOT-NAME IS NOT DESCENDED INTO. `.git` alone is more files than the tree it sits in, and
# `.zerg-cache` is where this command writes; a walk that read either would spend the run
# looking at things nobody wrote. A `.zg` name is not descended into either, which costs one
# `opendir` per source file otherwise.
fn test_pkgs(root: str, mut &out: list[str]) {
	names := __zrt_listdir(root)
	mut has := false
	for name in names {
		if zerg.is_test_file(name) {
			has = true
		}
	}
	if has {
		out.append(root)
	}
	for name in names {
		if not is_hidden(name) and not has_suffix(name, ".zg") {
			test_pkgs(join_path(root, name), out)
		}
	}
}

fn is_hidden(name: str) -> bool {
	b := bytearray(name)
	return false if b.len() == 0

	return b[0] == b'.'
}

# pkg_sources is every `.zg` file in a directory, the `*_test.zg` files INCLUDED — and that
# inclusion is the one line where a test build differs from every other one. `module_at` filters
# them out where a module's directory is read; this is the reading that does not.
#
# A LEFTOVER DRIVER IS NOT A SOURCE. The name is this command's own, and one is there only when
# a previous run was interrupted between writing it and taking it away; reading it back would
# compile the last run's driver beside this one's — two `fn main`, and a list of tests from
# whatever the file declared then.
fn pkg_sources(dir: str) -> list[str] {
	mut out: list[str] = []
	for name in __zrt_listdir(dir) {
		if has_suffix(name, ".zg") and name != DRIVER_NAME {
			out.append(join_path(dir, name))
		}
	}
	return out
}

# DRIVER_NAME is what the generated driver is called, and it ends in `_test.zg` for the reason
# that is the whole of why it may sit in a source directory at all: a `*_test.zg` is compiled by
# no normal build, in either compiler, so a driver left behind by an interrupted run is a file
# `zerg build` does not read. The next `zerg test` on that package overwrites it before it is
# used and removes it after, so a leftover heals itself rather than accumulating.
#
# It is one name per package rather than one per run, and a fixed name is what makes that
# healing possible: a run interrupted twice leaves one file, not two.
const DRIVER_NAME := "zerg_test_driver_test.zg"

# pkg_tests collects a package's tests as two parallel lists: each `#[test]` function's name,
# and the file it was written in, in the order they will run.
#
# ONLY A `*_test.zg` IS READ FOR ONE. A `#[test]` elsewhere in the package is compiled like any
# other function and nothing calls it — the file's NAME is what makes a source a test file
# (docs/runtime/package.md), and a second answer here would mean a function that runs under
# `zerg test` from a file `zerg build` also ships.
fn pkg_tests(files: list[str], mut &names: list[str], mut &at: list[str]) {
	for f in files {
		if zerg.is_test_file(path_tail(f)) {
			tree := zerg.parse_at(read_source(f), f)
			for fd in tree.fns {
				if fd.is_test {
					names.append(fd.name)
					at.append(f)
				}
			}
		}
	}
}

# run_pkg builds one package's test binary and runs it, adding its counts to the run's.
#
# The driver is the LAST file of the entry unit, so the whole package is one scope and a test
# function needs no `pub` to be reachable from it. That is the same arrangement a white-box test
# already has with the module it tests, applied one file further.
fn run_pkg(dir: str, mut &passed: int, mut &failed: int) {
	srcs := pkg_sources(dir)
	mut names: list[str] = []
	mut at: list[str] = []
	pkg_tests(srcs, names, at)
	return if names.len() == 0

	# THE DRIVER IS A FILE OF THE PACKAGE, written into the package's own directory, because a
	# module is a directory and that is the only thing that puts its declarations in the same
	# scope. A driver in a temp directory is a module of its own, and every test function it
	# calls is then `E301 … is not a public member of module lib` — which would make a `pub` on
	# each test the price of running it, i.e. exactly the test-only backdoor into visibility
	# that docs/runtime/package.md says there is not.
	#
	# Only the BINARY and the report go under the build cache, which is where a build already
	# puts what it made.
	key := sha256.hex(bytearray(dir))
	drv := join_path(dir, DRIVER_NAME)
	bin := join_path(test_dir(), key + ".bin")
	sum := join_path(test_dir(), key + ".sum")

	guard {
		io.write_file(drv, bytearray(gen_driver(names, at)))
	}
	mut files := srcs
	files.append(drv)
	link_units(load_units_of(files, dir, dir), drv, bin, TEST_JOBS)

	rm_file(sum)
	mut argv: list[str] = []
	argv.append(bin)
	argv.append(sum)
	code := __zrt_exec(argv)
	take_summary(sum, code, passed, failed)

	# the driver and its binary belong to THIS run: the next one writes them again from whatever
	# the test files then declare, and a stale one left behind is a test binary that answers for
	# a program nobody has any more
	rm_file(sum)
	rm_file(drv)
	rm_file(bin)
}

# TEST_JOBS is how many units a test build compiles at once. It is `build`'s own default rather
# than a flag: `zerg test --jobs` is a knob for the part of the command nobody is waiting on.
const TEST_JOBS := 4

# test_dir is where a test binary and its report are written: a `test` directory under the build
# cache, which is already the place a build puts what it made and which `make clean` already
# takes away. The driver source is the one thing that cannot live here — see run_pkg.
fn test_dir() -> str {
	dir := join_path(cache_dir(), "test")
	__zrt_mkdir(dir)
	return dir
}

# take_summary adds one driver's counts to the run's. The driver writes them as two lines
# AFTER its last child has answered, so a summary that is not there is the driver itself not
# having finished — which is a failure of the package, not a package with nothing in it. A gate
# that reads an absent report as "nothing to report" is the gate that measures nothing.
fn take_summary(path: str, code: int, mut &passed: int, mut &failed: int) {
	text := read_or_empty(path)
	mut p := 0
	mut f := 0
	mut ok := false
	guard {
		p = strconv.parse_int(source_line(text, 1), 10)
		f = strconv.parse_int(source_line(text, 2), 10)
		ok = true
	}
	if not ok {
		io.println(f"  ERROR the test driver ended without a report (status {code})")
		failed = failed + 1
		return
	}
	passed = passed + p
	failed = failed + f
}

fn read_or_empty(path: str) -> str {
	mut out := ""
	guard {
		out = str(io.read_file(path))
	}
	return out
}

# rm_file removes a path this command made, and says nothing when it was not there — every
# caller wants "make sure this is gone" rather than "delete exactly this".
fn rm_file(path: str) {
	guard {
		__zrt_remove(path)
	}
}

# gen_driver writes the driver source for one package: the two lists the parent walks, the
# dispatch that turns a name back into a call, and the parent/child halves of the process
# arrangement above.
#
# It is GENERATED rather than fixed because the only part that varies is the list of names, and
# a fixed driver reading them from somewhere would need the names to exist as data at runtime —
# which means a table the compiler emits, which is this file written by another route. Written
# out, the calls are ordinary calls in the package's own scope and the compiler checks every one
# of them: a `#[test]` with a parameter is a compile error naming the function, not a runner
# that skips it.
fn gen_driver(names: list[str], at: list[str]) -> str {
	mut out := "# Generated by `zerg test` for one run, and removed when that run ends. Not a source to\n"
	out = out + "# edit: the next run writes it again from whatever the test files then declare.\n"
	out = out + "import (\n\t\"fs\"\n\t\"io\"\n\t\"os\"\n)\n\n"

	out = out + "fn zt_names() -> list[str] {\n\tmut out: list[str] = []\n"
	for n in names {
		out = out + "\tout.append(\"" + n + "\")\n"
	}
	out = out + "\treturn out\n}\n\n"

	out = out + "fn zt_files() -> list[str] {\n\tmut out: list[str] = []\n"
	for f in at {
		out = out + "\tout.append(\"" + f + "\")\n"
	}
	out = out + "\treturn out\n}\n\n"

	out = out + "fn zt_call(name: str) -> int {\n\tmut found := false\n"
	for n in names {
		out = out + "\tif name == \"" + n + "\" {\n\t\t" + n + "()\n\t\tfound = true\n\t}\n"
	}
	out = out + "\traise \"zerg test: this driver has no such test\" if not found\n\treturn 0\n}\n\n"

	return out + driver_body()
}

# driver_body is the half of the driver that does not vary. It is a text constant and not a
# module of the standard library, because a test driver is not something a program imports: it
# exists for the length of one run, in the package's own scope, and the only reader it ever has
# is the compiler that was handed it a moment earlier.
fn driver_body() -> str {
	return "fn zt_child(name: str, out: str) -> int {\n" +
		"\tr := guard {\n\t\tzt_call(name)\n\t}\n" +
		"\tok := match r {\n\t\tEither.Left(_)  => true\n\t\tEither.Right(_) => false\n\t}\n" +
		"\tif ok {\n\t\tzt_put(out, \"ok\\n\")\n\t\treturn 0\n\t}\n" +
		"\tmsg := match r {\n\t\tEither.Left(_)  => \"\"\n\t\tEither.Right(e) => e.message()\n\t}\n" +
		"\tzt_put(out, \"fail\\n\" + msg + \"\\n\")\n\treturn 1\n}\n\n" +
		"fn zt_put(path: str, text: str) {\n\tguard {\n\t\tio.write_file(path, bytearray(text))\n\t}\n}\n\n" +
		"fn zt_get(path: str) -> str {\n\tmut out := \"\"\n\tguard {\n\t\tout = str(io.read_file(path))\n\t}\n\treturn out\n}\n\n" +
		"fn zt_rm(path: str) {\n\tguard {\n\t\tfs.remove(path)\n\t}\n}\n\n" +
		"fn zt_head(text: str) -> str {\n\tb := bytearray(text)\n\tmut out: list[byte] = []\n\tmut i := 0\n" +
		"\tfor i < b.len() {\n\t\tbreak if b[i] == b'\\n'\n\t\tout.append(b[i])\n\t\ti = i + 1\n\t}\n\treturn str(out)\n}\n\n" +
		"fn zt_tail(text: str) -> str {\n\tb := bytearray(text)\n\tmut i := 0\n" +
		"\tfor i < b.len() and b[i] != b'\\n' {\n\t\ti = i + 1\n\t}\n" +
		"\tmut out: list[byte] = []\n\tmut j := i + 1\n" +
		"\tfor j < b.len() {\n\t\tbreak if b[j] == b'\\n'\n\t\tout.append(b[j])\n\t\tj = j + 1\n\t}\n\treturn str(out)\n}\n\n" +
		"fn zt_parent(summary: str) -> int {\n" +
		"\texe := __zrt_exe_path()\n\tnames := zt_names()\n\tfiles := zt_files()\n" +
		"\tmut passed := 0\n\tmut failed := 0\n\tmut seen := \"\"\n\tmut i := 0\n" +
		"\tfor i < names.len() {\n" +
		"\t\tif files[i] != seen {\n\t\t\tseen = files[i]\n\t\t\tio.println(seen)\n\t\t}\n" +
		"\t\trp := summary + \".\" + str(i)\n\t\tzt_rm(rp)\n" +
		"\t\tmut argv: list[str] = []\n\t\targv.append(exe)\n\t\targv.append(\"-t\")\n" +
		"\t\targv.append(names[i])\n\t\targv.append(rp)\n\t\tcode := os.run(argv)\n" +
		"\t\tres := zt_get(rp)\n\t\tzt_rm(rp)\n\t\thead := zt_head(res)\n" +
		"\t\tif head == \"ok\" {\n\t\t\tio.println(\"  ok    \" + names[i])\n\t\t\tpassed = passed + 1\n" +
		"\t\t} else if head == \"fail\" {\n\t\t\tio.println(\"  FAIL  \" + names[i])\n" +
		"\t\t\tio.println(\"        \" + zt_tail(res))\n\t\t\tfailed = failed + 1\n" +
		"\t\t} else if code == 0 {\n\t\t\tio.println(\"  FAIL  \" + names[i])\n" +
		"\t\t\tio.println(\"        the test exited before it finished — `os.exit` ends the process, and a test that did not return did not pass\")\n" +
		"\t\t\tfailed = failed + 1\n" +
		"\t\t} else {\n\t\t\tio.println(\"  CRASH \" + names[i])\n" +
		"\t\t\tio.println(\"        the test process died with status \" + str(code))\n" +
		"\t\t\tfailed = failed + 1\n\t\t}\n" +
		"\t\ti = i + 1\n\t}\n" +
		"\tzt_put(summary, str(passed) + \"\\n\" + str(failed) + \"\\n\")\n" +
		"\treturn 1 if failed > 0\n\n\treturn 0\n}\n\n" +
		"fn zt_main(args: list[str]) -> int {\n" +
		"\treturn zt_child(args[1], args[2]) if args.len() == 3 and args[0] == \"-t\"\n" +
		"\treturn zt_parent(args[0]) if args.len() == 1\n\n" +
		"\tio.eprintln(\"this is a `zerg test` driver: it is run by `zerg test`, which hands it a report path\")\n" +
		"\treturn 2\n}\n\n" +
		"fn main(args: list[str]) {\n\tos.exit(zt_main(args))\n}\n"
}

# --- import cycles ---------------------------------------------------------------------
#
# "Import cycles between modules are rejected" (docs/runtime/package.md), and nothing
# detected one, at either layer: `ca` importing `cb` importing `ca` compiled and ran.
#
# A cycle that BUILDS is worse than a cycle that is refused, which is why this is enforced
# rather than documented away. Two mutually importing modules each have to be initialized
# before the other — their `init()` blocks and their module constants both — and there is no
# order that satisfies both, so whatever the build settles on is an order no chapter defines
# and nothing can be written against.
#
# THE QUESTION IS ASKED OF THE PATH DOWN, not of what has been loaded. A module that two
# others import is the ordinary case — a diamond — and `seen` is what answers that one, by
# loading it once. What has no order is a module that comes up again while it is still ON the
# way down, and only a stack can tell the two apart. The self-import is the one-node case of
# exactly the same test, which is why it needs no branch of its own.
#
# The chain is reported from the first appearance, so what the reader is shown is the LOOP
# and not the walk that reached it.
fn chk_import_cycle(stack: list[str], im: str) {
	mut at := -1
	mut i := 0
	for i < stack.len() {
		if at < 0 and stack[i] == im {
			at = i
		}
		i = i + 1
	}
	return if at < 0

	mut chain := ""
	mut j := at
	for j < stack.len() {
		chain = chain + path_tail(stack[j]) + " -> "
		j = j + 1
	}
	raise f"E485 import cycle: {chain}{path_tail(im)} — modules form a DAG (docs/runtime/package.md), and a cycle has no order for its `init()` blocks and module constants to be readied in. Mutually recursive declarations belong in ONE module, which costs nothing: a module is a directory whose files share a namespace and import each other not at all"
}

# chk_unbuilt_module turns away an import of a module that SHIPS AND CANNOT BE COMPILED, at
# the line that asked for it.
#
# `atomic` is the whole list, and it earns the entry the hard way: the module is written, it
# is formatted and checked with the rest of the stdlib, and it declares `Atomic[T]`, a generic
# struct — a form this compiler refuses. So `import "atomic"` used to fail with `E215
# NotImplemented: a generic struct` pointing INTO `src/stdlib/atomic.zg`, a file the reader
# did not write and cannot fix. That is the same shape as a cc error against generated C, and
# it is the shape this repo's gates exist to turn away.
#
# THE MODULE STAYS SHIPPED rather than being taken out of the stdlib directory. Unshipping it
# means moving the source out of `src/stdlib/`, because this compiler resolves the stdlib by
# LISTING that directory — and the moment it leaves, `zerg fmt --check` and the rest of
# SELF_SRCS stop reading it, so a hundred lines of Zerg rot quietly until generics land. What
# is left behind would be `E502 cannot resolve import`, which is a sentence about a module
# that is right there. Between a listing that needs a marker and a diagnostic that is false,
# the marker is the honest one, and docs/runtime/stdlib.md carries it.
#
# This function deletes itself the day a generic struct is built.
# chk_test_import turns away an import that NAMES a test file. `import "lib/lib_test"` reaches
# module_at's single-file arm, which the directory arm's filter does not cover, and dropping it
# there instead would resolve the import to an empty module and move the complaint to whatever
# name the program went on to write.
#
# A test file is not importable from anywhere, including a sibling test file: the convention
# says which builds compile one, and `zerg test` is what will compile them together.
fn chk_test_import(im: zerg.ImportDecl) {
	return if not zerg.is_test_file(path_tail(im.path) + ".zg")

	place := zerg.place_line(im.at, im.line, im.col)
	raise f"E512 `{im.path}` names a test file, and a normal build compiles none — a `*_test.zg` is included only in a test build (docs/runtime/package.md), so nothing it declares is on any module's surface\n{place}"
}

fn chk_unbuilt_module(im: zerg.ImportDecl) {
	return if path_tail(im.path) != "atomic"

	place := zerg.place_line(im.at, im.line, im.col)
	raise f"E511 the module `atomic` ships and cannot be imported — it declares `Atomic[T]`, and a generic struct is a form this compiler has not built (docs/runtime/stdlib.md). Share state across coroutines with a channel until it has\n{place}"
}

# load_sources loads every named entry with its imports, keeping one copy of a module
# that several entries share.
fn load_sources(files: list[str]) -> list[str] {
	mut paths: list[str] = []
	return load_sources_at(files, paths)
}

# load_sources_at is load_sources with the PATH of each source collected beside it, in the
# same order. A diagnostic names the file it is about, and by the time anything is emitted
# the whole program is one merged tree — so the path has to travel with the source from
# here, or nothing downstream can say where a statement came from.
fn load_sources_at(files: list[str], mut &paths: list[str]) -> list[str] {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	for f in files {
		load_into(f, dir_of(f), seen, srcs, paths)
	}
	return srcs
}

# --- installation layout -------------------------------------------------------------
#
# The compiler has to work from any directory, so nothing below is a relative path the
# process happens to be standing next to. Each location is answered by an environment
# variable first, then by a root that is itself answered the same way, and the in-repo
# layout is only the last resort — which is what makes a checkout work with no setup.

# env_or reads an environment variable, or gives fallback when it is unset.
fn env_or(key: str, fallback: str) -> str {
	return __zrt_getenv(key) if __zrt_has_env(key)
	return fallback
}

# cc_bin is the C compiler this build invokes: $CC when set, else `cc`, RESOLVED against
# $PATH so that what comes back names a FILE rather than a word. The resolution is what the
# cache key needs — `cc` is one name for whatever is first on a path that changes between
# machines, between shells, and between one toolchain install and the next, and an object
# built by one of them is not an object built by another.
#
# A name that already carries a '/' is a path the caller chose and is returned as it stands.
# A name that resolves to nothing is returned as it stands too: the spawn then fails and says
# so, which is a better report than a key that lies about having looked.
#
# The scan is written out rather than reaching for `strings.split`, because this compiler
# flattens every module into one namespace and importing one more would collide.
fn cc_bin() -> str {
	name := env_or("CC", "cc")
	b := bytearray(name)
	mut i := 0
	for i < b.len() {
		return name if b[i] == b'/'
		i = i + 1
	}

	path := bytearray(env_or("PATH", ""))
	mut seg: list[byte] = []
	mut j := 0
	for j <= path.len() {
		if j == path.len() or path[j] == b':' {
			if seg.len() > 0 {
				cand := join_path(str(seg), name)
				return cand if __zrt_exists(cand)
			}
			seg = []
		} else {
			seg.append(path[j])
		}
		j = j + 1
	}
	return name
}

# cc_std is the C dialect the emitted code is compiled with. C17 is the default because
# that is the dialect the specification names, and the number in a flag nobody reads is
# exactly the kind of claim that drifts: this said `c11` while the front page said C17,
# and no gate compared the two.
#
# $ZERG_CSTD picks another one. The specification's "C99 as a fallback" means an automatic
# retreat when a `cc` cannot do C17, and probing for that is not built — so what exists is
# the ability to ASK for a dialect, which is what lets CI compile the same emitted C under
# both and find out whether the fallback is real before a user does.
fn cc_std() -> str {
	if __zrt_has_env("ZERG_CSTD") {
		std := __zrt_getenv("ZERG_CSTD")
		return "-std=" + std
	}
	return "-std=c17"
}

# zerg_root is the installation root: $ZERG_ROOT, else the current directory (the repo
# checkout, where src/runtime and src/stdlib sit).
fn zerg_root() -> str {
	return __zrt_getenv("ZERG_ROOT") if __zrt_has_env("ZERG_ROOT")

	# WHERE THIS BINARY LIVES, not where the user happens to be standing. The root used to
	# default to `.`, so `zerg build main.zg` outside the source tree failed with
	# `'zergrt.h' file not found` — cc reporting, about a file the user never wrote, for a
	# compiler that simply did not know where it was installed.
	#
	# Two layouts are recognised, and they are the two that exist: the SOURCE TREE, where
	# the binary is `<root>/bin/zerg` beside `src/runtime/csrc`, and an INSTALL, where it is
	# `<prefix>/bin/zerg` beside `<prefix>/lib/zerg/csrc`. Both are "the parent of the
	# directory holding the binary", which is why one answer serves both — what differs is
	# where rt_dir and stdlib_dir look under it.
	# PROBED, not assumed. A binary is not always installed beside its trees: `make fixpoint`
	# builds a stage into a temp directory and runs it there, and the answer for that one is
	# the current directory — which is what the default was before this and still is when
	# the executable's neighbourhood holds nothing.
	exe := __zrt_exe_path()
	if exe != "" {
		up := dir_of(dir_of(exe))
		return up if up != "" and root_layout(up) != ""
	}
	return "."
}

# root_layout answers which tree `root` is — "src" when the compiler is running from its own
# source tree, "install" when it was installed, and "" when it is neither. The runtime
# sources are the tell, because they are what a build needs and they sit in a different
# place in each; "" is what makes this both the layout question and the "is this a root at
# all" question, which were two probes of the same directory.
fn root_layout(root: str) -> str {
	return "src" if __zrt_exists(join_path(root, "src/runtime/csrc"))
	return "install" if __zrt_exists(join_path(root, "lib/zerg/csrc"))

	return ""
}

# rt_dir returns the runtime source tree — $ZERG_RUNTIME, else <root>/src/runtime/csrc.
# It is probed rather than assumed, so a wrong root fails as a missing-runtime message
# instead of a wall of cc errors about a header that was never there.
fn rt_dir() -> str {
	return __zrt_getenv("ZERG_RUNTIME") if __zrt_has_env("ZERG_RUNTIME")

	root := zerg_root()
	return join_path(root, "lib/zerg/csrc") if root_layout(root) == "install"

	return join_path(root, "src/runtime/csrc")
}

# stdlib_dir returns the standard library sources — $ZERG_STDLIB, else <root>/src/stdlib.
fn stdlib_dir() -> str {
	return __zrt_getenv("ZERG_STDLIB") if __zrt_has_env("ZERG_STDLIB")

	root := zerg_root()
	return join_path(root, "lib/zerg/stdlib") if root_layout(root) == "install"

	return join_path(root, "src/stdlib")
}

# --- paths -----------------------------------------------------------------------------

# join_path joins a directory and a name, treating "" and "." as "here".
fn join_path(dir: str, name: str) -> str {
	return name if dir == "" or dir == "."
	return f"{dir}/{name}"
}

# dir_of returns the directory part of a path, or "." when it names a bare file.
fn dir_of(path: str) -> str {
	b := bytearray(path)
	mut cut := 0
	mut seen := false
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i
			seen = true
		}
		i = i + 1
	}
	return "." if not seen
	mut out: list[byte] = []
	mut j := 0
	for j < cut {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# has_suffix reports whether s ends with suffix.
fn has_suffix(s: str, suffix: str) -> bool {
	b := bytearray(s)
	x := bytearray(suffix)
	return false if x.len() > b.len()
	mut i := 0
	for i < x.len() {
		return false if b[b.len() - x.len() + i] != x[i]
		i = i + 1
	}
	return true
}

# --- module resolution ------------------------------------------------------------------

# module_files resolves one import path to the source files that make up that module,
# searched BESIDE THE IMPORTER first — the directory of the file that wrote the import —
# then in the entry program's own directory, then the standard library. A module is either
# a single `<path>.zg` file or a DIRECTORY
# of them — the compiler's own `zerg` module is the second kind, and its files are read in
# the sorted order the runtime guarantees so the emitted C never depends on the
# filesystem.
#
# AN IMPORT THAT RESOLVES TO NOTHING IS REFUSED HERE, and it used to yield an empty list that
# both loaders skipped: each read the files the import resolved to, found none, and moved on.
# `import "nope"` compiled and ran, and the first USE of the module reported "the method
# `thing` on a ?", naming neither the module nor the import. A dependency that is not there is
# the one thing a loader cannot work around, and the seed has said so since 1g; the two
# compilers now agree, in the same words.
#
# The refusal is the RESOLVER's rather than each caller's, because both callers want the same
# answer and a third would have to remember to ask for it.
# `near` is the directory of the FILE that wrote this import, and it is searched first.
# Every recursion used to hand the ENTRY program's directory down unchanged, so a module's
# own imports were resolved against a directory that module knows nothing about: `api/api.zg`
# importing `"util/text"` was refused with E502 while `api/util/text/` sat right beside it,
# and the same import resolved once the directory was moved next to the entry file instead.
# E502's own sentence — "a module is a directory of `.zg` files beside the importer" — was
# describing the layout it turned away.
#
# The entry directory STAYS as the second root rather than being replaced: a nested module
# reaching a module beside the program resolved before this and still does. So the change
# only ever adds a place to look.
#
# IT TAKES THE DECLARATION AND NOT THE PATH, so the refusal can say WHERE. E502 was the last
# import rule with no place: the two beside it (E511, E512) are handed the `ImportDecl` and
# spell `place_line` from it, and this one was handed the path alone — a string that knows
# what was written and not which line wrote it. A reader told an import resolves nowhere and
# not which import is left grepping their own program for the quoted path.
fn module_files(im: zerg.ImportDecl, near: str, from_dir: str) -> list[str] {
	path := im.path
	mut roots: list[str] = []
	roots.append(near)

	# a plain `if` and not a trailing one: this file is compiled BY THE SEED, which does not
	# read a postfix `if` on a call statement
	if from_dir != near {
		roots.append(from_dir)
	}
	roots.append(stdlib_dir())
	for root in roots {
		found := module_at(root, path)
		return found if found.len() > 0
	}

	# The LAST-SEGMENT alias. A module is named by the last segment of its path — `import
	# "std/time"` and `import "time"` are the same module (docs/tooling/fmt.md) — and the
	# stdlib is one flat directory, so a path that resolves nowhere is retried at its last
	# segment. The seed has done this since 1g; without it here the two compilers disagree
	# about what a program imports, and the disagreement is SILENT until use: the namespace
	# is bound from the path either way, so `import "std/time"` loaded no files at all and
	# `time.now()` read as a method on nothing.
	seg := path_tail(path)
	if seg != path {
		for root in roots {
			found := module_at(root, seg)
			return found if found.len() > 0
		}
	}

	place := zerg.place_line(im.at, im.line, im.col)
	raise f"E502 cannot resolve import `{path}` under any source root — a module is a directory of `.zg` files beside the importer or in the standard library, named by the last segment of its path\n{place}"
}

# WHICH SOURCES ARE TEST FILES is `zerg.is_test_file`. The convention used to be written
# here, and moved into the module when the linter grew a rule about it (L601): two tools ask
# the question now, and a naming convention answered in two places is one that drifts.

# module_at resolves one import path under one root: a single `<path>.zg` file, or a
# DIRECTORY of them read in sorted order so the emitted C never depends on the filesystem.
#
# A `*_test.zg` IS NOT IN EITHER ANSWER. A normal build compiled them like every other file,
# so a test's declarations reached the shipped artifact and its `pub` ones joined the module's
# surface — `lib.only_in_test()` resolved and ran from a program that never asked for a test.
# The directory case drops them; the single-file case refuses, because `import "lib/lib_test"`
# names one deliberately and dropping it would leave the module empty and the complaint about
# some name much later.
fn module_at(root: str, path: str) -> list[str] {
	file := join_path(root, path + ".zg")
	if __zrt_exists(file) {
		mut one: list[str] = []
		one.append(file)
		return one
	}
	dir := join_path(root, path)
	if __zrt_exists(dir) {
		mut many: list[str] = []
		for name in __zrt_listdir(dir) {
			if has_suffix(name, ".zg") and not zerg.is_test_file(name) {
				many.append(join_path(dir, name))
			}
		}
		return many
	}
	mut none: list[str] = []
	return none
}

# path_tail is the last '/'-separated segment of an import path, which is the module's
# name.
fn path_tail(path: str) -> str {
	b := bytearray(path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

fn load_into(file: str, from_dir: str, mut &seen: list[str], mut &srcs: list[str], mut &paths: list[str]) {
	mut root: list[str] = []
	load_with(file, from_dir, seen, root, srcs, paths, Buffer("", ""))
}

# Buffer is the one source the loader must NOT read from disk: the file a language server
# holds unsaved. An empty path means there is none, which is every build.
struct Buffer {
	pub path: str
	pub text: str
}

# load_with is load_into with that substitution, and it is the same function because the
# alternative is a second copy of the resolution rules — the part that actually decides what
# a program is — kept in step by hand.
#
# The buffer also decides whether a LEXICAL error is fatal. On a command line it is: nothing
# downstream can say anything true about text that does not tokenize, so `lex_check` reports
# and exits. In a server there is no exiting — the session is the process — so the unreadable
# source is skipped and `lex_diags` reports it to the editor instead.
# `stack` is the chain of MODULES on the way down to this file, and the cycle rule is asked of
# it for the reason load_unit's is: this loader recurses per FILE and dedupes per file, so a
# module reached a second time is skipped and the loop never runs — which terminates the walk
# without noticing what it walked. The two loaders ask ONE function, so the rule and its
# sentence are in one place and cannot drift apart the way the walks themselves have to.
fn load_with(file: str, from_dir: str, mut &seen: list[str], stack: list[str], mut &srcs: list[str], mut &paths: list[str], buf: Buffer) {
	for s in seen {
		return if s == file
	}
	seen.append(file)
	src := buffer_src(file, buf)
	if buf.path == "" {
		lex_check(src, file)
	} else if zerg.lex_diags(src, file).len() > 0 {
		return
	}

	# the pathed scan, so a refusal this parse raises names `file` rather than a line of
	# no file — the loader is the first parse a source meets
	for imd in zerg.import_decls_at(src, file) {
		im := imd.path
		chk_test_import(imd)
		chk_unbuilt_module(imd)
		chk_import_cycle(stack, im)
		mut here := stack
		here.append(im)
		for dep in module_files(imd, dir_of(file), from_dir) {
			load_with(dep, from_dir, seen, here, srcs, paths, buf)
		}
	}
	srcs.append(src)

	# appended HERE, not beside `seen`: a module's imports are loaded first, so `seen` is
	# in discovery order and `srcs` in dependency order, and only the second is the one a
	# path has to line up with
	paths.append(file)
}

# read_source is the ONE place a file on disk becomes source text, and it exists because
# that step could KILL the compiler. `str(bytes)` checks the str invariant and aborts on a
# violation — `EncodingError: bytes are not valid UTF-8 for a str`, from the runtime, with no
# code, no place and no file named — so a single stray byte in any file the toolchain was
# pointed at ended the process before the lexer had read a character. `zerg build`, `zerg
# fmt`, `zerg desugar` and the language server all went the same way.
#
# GRAMMAR#letter says the source is UTF-8, so a file that is not is not a Zerg source file, and
# saying which file is the whole of the answer. That is why this carries no `-->` trailer:
# there is no line to name yet, the thing that would read one being what refused.
#
# THE READ IS OUTSIDE THE GUARD ON PURPOSE. A file that cannot be opened is a DIFFERENT
# failure and raises its own `IOError`, and a `guard` around both would report it as an
# encoding complaint about a file nobody could read — the swallowing `load_unit` above has a
# paragraph about. The guard covers the conversion alone, which is the only thing in here
# that can abort. (That `IOError` says `cannot open file` and does not yet name the path it
# failed on, which is a gap in `io` rather than one here.)
fn read_source(path: str) -> str {
	b := io.read_file(path)

	mut src := ""
	mut ok := false
	guard {
		src = str(b)
		ok = true
	}
	raise f"E111 `{path}` is not UTF-8 text, and a Zerg source file is UTF-8 text" if not ok

	return src
}

# buffer_src is the text of `file`: what the server is holding for it, or what the disk has.
fn buffer_src(file: str, buf: Buffer) -> str {
	return buf.text if file == buf.path
	return read_source(file)
}

# cc_argv builds the cc command line: compile cpath into output over the always-linked,
# non-concurrent runtime units, found under rt_dir().
# rt_units are the runtime translation units every linked program needs.
fn rt_units() -> list[str] {
	mut units: list[str] = []
	units.append("alloc.c")
	units.append("conv.c")
	units.append("entry.c")
	units.append("fmt.c")
	units.append("list.c")
	units.append("map.c")
	units.append("ref.c")
	units.append("str.c")
	units.append("sys.c")
	units.append("unwind.c")

	# The concurrency floor. It is linked unconditionally rather than by inspecting the
	# program because the driver decides the link line before it knows whether emit
	# reached a channel — and an unused unit costs a few KB, while a missing one is a
	# link error a user cannot act on. The context switch and the thread backend are
	# chosen by target, exactly as the runtime's own selection does.
	units.append("sched.c")
	units.append("chan.c")
	units.append(ctx_unit())
	units.append(thread_unit())
	return units
}

# ctx_unit is the context switch for this target: a hand-written one where there is
# one, else the portable ucontext floor.
fn ctx_unit() -> str {
	a: str = __zrt_arch()

	return "ctx_arm64.S" if a == "arm64"
	return "ctx_x86_64.S" if a == "x86_64"

	return "ctx_ucontext.c"
}

# thread_unit is the zrt_thread backend. A platform this does not know gets the
# no-thread floor, which runs every coroutine on one thread — correct, just not
# parallel.
fn thread_unit() -> str {
	p: str = __zrt_platform()

	return "thread_win32.c" if p == "windows"
	return "thread_pthread.c" if p == "linux" or p == "darwin" or p == "freebsd" or p == "openbsd" or p == "netbsd"

	return "thread_none.c"
}

# cc_dialect narrows what the emitted C is allowed to be, and every flag here exists because
# something got through without it.
#
# `-fno-dollars-in-identifiers` is the mangling invariant, made unforgeable. A specialization's
# key carries `$`, which no Zerg identifier may hold — that is what makes it unforgeable at the
# Zerg level — and `$` is not a C identifier character either. Both clang and gcc take it as an
# EXTENSION and say nothing, so a `$` that reached the emitted C compiled on this machine and
# on Linux CI, and would have failed on the first compiler that did not offer the extension.
# It reached C once already, and no gate saw it: the flag is what makes the next one a build
# error here rather than a bug report from somewhere else.
#
# It goes on the two invocations that COMPILE. The link-only one reads no source.
fn cc_dialect(mut &argv: list[str]) {
	argv.append("-fno-dollars-in-identifiers")
}

# cc_object_argv compiles the emitted C to an object without linking: a module is not a
# program, so it has no entry to link against and no runtime to pull in yet.
fn cc_object_argv(cpath: str, output: str) -> list[str] {
	mut argv: list[str] = []
	argv.append(cc_bin())
	argv.append(cc_std())
	cc_dialect(argv)
	argv.append("-I")
	argv.append(rt_dir())
	argv.append("-c")
	argv.append("-o")
	argv.append(output)
	argv.append(cpath)
	return argv
}

fn cc_argv(cpath: str, output: str) -> list[str] {
	rt := rt_dir()
	mut argv: list[str] = []
	argv.append(cc_bin())
	argv.append(cc_std())
	cc_dialect(argv)
	argv.append("-I")
	argv.append(rt)
	argv.append("-o")
	argv.append(output)
	argv.append(cpath)
	for u in rt_units() {
		argv.append(f"{rt}/{u}")
	}
	return argv
}

# --- fmt / lint ------------------------------------------------------------------------

# run_fmt rewrites each named file in place. Reading and writing the same path means a
# formatted file is byte-identical to what it was, so running fmt twice is a no-op.
fn run_fmt(files: list[str], off: list[str]) {
	for f in files {
		src := read_source(f)

		# fmt works on the TOKEN STREAM, not the tree, so it will reformat anything that
		# lexes — including a file with a syntax error, silently, exit 0. `fn main( {` came
		# back as `fn main({` and `print("hi")` as `print ("hi")`: the tokens survive, but
		# the spacing rules are applied to a shape they cannot mean anything about, so the
		# user's broken file comes back broken AND misformatted, with nothing said.
		#
		# The gate is NOT `parse`. A formatter has to work on source the compiler cannot
		# COMPILE — that is exactly when a person reaches for one — and this parser refuses
		# 26 forms the language has and this compiler has not built, `src/stdlib/testing.zg`
		# among them. Balance is what fmt's own rules actually depend on; see fmt_balanced.
		raise f"`{f}` has unbalanced brackets, so it cannot be formatted — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.fmt_src_off(src, off)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# run_fmt_check answers the question a CI job asks — is this tree already canonical — and
# answers it without touching anything. Before it existed `make fmt-corpus` did the same
# thing by copying each case to a temp file, formatting the copy and running `cmp`: the
# tool knew the answer and had no way to say it, so the Makefile reimplemented it in
# shell. A formatter that cannot be asked is a formatter every CI reinvents.
fn run_fmt_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := read_source(f)
		if not zerg.fmt_balanced(src) {
			io.ewrite(f"{f}: unbalanced brackets, so it cannot be formatted\n")
			bad = bad + 1
		} else if zerg.fmt_src_off(src, off) != src {
			io.ewrite(f"{f}: not in canonical form (run `zerg fmt`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}

# run_desugar rewrites each source into the core forms its sugar is defined as. It is
# `run_fmt` with the other pass, down to the bracket gate: desugar reads the same token
# stream from the same lexer, so a file whose brackets do not close is one it would rewrite
# from a shape that means nothing.
#
# It writes IN PLACE, like `zerg fmt`, because the thing that runs it is a gate over a
# whole tree rather than a person over one file — `make desugar` copies the corpus and
# desugars the copy. Undoing the sugar in a source somebody is keeping is not what this is
# for, and the docs say so.
fn run_desugar(files: list[str], off: list[str]) {
	for f in files {
		src := read_source(f)
		raise f"`{f}` has unbalanced brackets, so it cannot be desugared — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.desugar_src_off(src, off)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# run_desugar_check is the question `make desugar`'s fixpoint gate asks: is there any sugar
# left in this file. A desugared source that desugars again to something else would mean
# one of these rules produces what another one rewrites, which is the one way a pass like
# this can be wrong without any program behaving differently.
fn run_desugar_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := read_source(f)
		if not zerg.fmt_balanced(src) {
			io.ewrite(f"{f}: unbalanced brackets, so it cannot be desugared\n")
			bad = bad + 1
		} else if zerg.desugar_src_off(src, off) != src {
			io.ewrite(f"{f}: still holds sugar (run `zerg desugar`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}

# run_lint reports every finding in the loaded program and RETURNS a nonzero status when
# there is one, so `zerg lint` can gate a build rather than merely inform. It returns the
# status rather than exiting on it because a sub-command's function is what decides the
# process's exit, and it is the only thing that knows what the finding meant.
#
# THE SEVERITIES DECIDE THE STATUS, and there are two answers rather than one. A FINDING
# fails, always: a rule fired on the program. A WARNING prints and does not, because what it
# reports is legal — a `#[test]` that ships is a decision somebody may have made on purpose —
# and `strict` is what turns those into failures for a caller that has decided otherwise.
# `make lint`, over this project's own source, is that caller. INFO never fails anything.
fn run_lint(files: list[str], strict: bool) -> int {
	mut paths: list[str] = []
	srcs := load_sources_at(files, paths)

	mut bad := 0
	mut warned := 0
	for f in zerg.lint_program(srcs, paths) {
		io.write(f"{f.path}:{f.line}:{f.col}: {lint_sev(f)}{f.code} {f.msg}\n")
		if f.sev == "" {
			bad = bad + 1
		} else if f.sev == "warning" {
			warned = warned + 1
		}
	}

	return 1 if bad > 0
	return 1 if strict and warned > 0

	return 0
}

# lint_sev is the adjective a finding's line opens with, and the empty string for the default
# — see lint.zg's header for why only two of the three are named out loud.
fn lint_sev(f: zerg.Finding) -> str {
	return "" if f.sev == ""

	return f"{f.sev}: "
}
