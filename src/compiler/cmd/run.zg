# What each sub-command DOES — one file per command, and the machinery more than one of
# them needs beside it. `zergc.zg` declares the command line; nothing in it says what a
# command does, and nothing here says what the command line accepts.
#
# A command is TWO declarations that belong together: the `cli.Command` naming its flags,
# and the function that is handed the parsed line. So each `*_cmd()` is `pub` — it is what
# `root()` reaches for — and everything else in this module is private to it.
#
# Each of those functions is handed the parsed command line and returns the process's exit
# status. There is no argument checking in one: a missing file or an unreadable flag was
# refused before the function was ever called, which is the point of declaring the command
# line rather than unpicking it.

import (
	"cli"
	"io"
	"lsp"
	"sha256"
	"strconv"

	"zerg"
)

# build is the only command that compiles; how FAR it goes is `--emit`, not a command of
# its own. The token stream, the tree, and the C are stages of one pipeline, so naming
# them as sub-commands said twice what `--emit` already says — and left a reader to
# discover that `zerg c f.zg` and `zerg build --emit c f.zg` were the same thing.
pub fn build_cmd() -> cli.Command {
	return (
		cli.command("build", "compile a program (see --emit)")
		.opt("e", "emit", "stop after a stage: tokens, ast, c, lib, bin — bin when the entry declares `main`, else lib", "")
		.opt("o", "output", "where to write the result (default: stdout for tokens/ast/c, the source name for lib/bin)")
		.opt("j", "jobs", "how many units to compile at once", "4")
		.add(cli.positional("file.zg", "the source to compile").required().repeated())
		.run(do_build)
	)
}

# test is `build` pointed at the files a build leaves out. A `*_test.zg` is compiled by no
# normal build (docs/runtime/package.md) — the exclusion is what keeps a test out of the
# shipped artifact — so the INCLUSION has to live somewhere, and it lives here rather than as
# a `--test` flag on `build`. `zerg build` keeps one meaning: it compiles what ships, and what
# ships never contains a test. A flag would have made the same command mean both, and the day
# somebody scripts `zerg build --test` into a release step there is nothing left to say no.
pub fn test_cmd() -> cli.Command {
	return (
		cli.command("test", "build and run the `#[test]` functions under a path, wherever they are written")
		.opt("k", "only", "run only the tests whose name begins with this", "")
		.opt("t", "timeout", "seconds one test may take before it is reported STUCK", "60")
		.add(cli.positional("path", "the directory to search, or one `.zg` file — its package runs (default: the current directory)"))
		.run(do_test)
	)
}

pub fn fmt_cmd() -> cli.Command {
	return (
		cli.command("fmt", "rewrite sources in the canonical style")
		.flag("c", "check", "report what is not canonical and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. F401; repeatable").repeated())
		.add(cli.positional("file.zg", "the sources to rewrite").required().repeated())
		.run(do_fmt)
	)
}

pub fn lint_cmd() -> cli.Command {
	return (
		cli.command("lint", "report unused imports and dead private code")
		.flag("s", "strict", "fail on a warning too, not only on a finding")
		.add(cli.positional("file.zg", "the sources to check").required().repeated())
		.run(do_lint)
	)
}

# desugar takes the same two flags `fmt` does, and they mean the same things: `--check`
# asks the question without touching anything, and `--off` names a rule to leave alone.
pub fn desugar_cmd() -> cli.Command {
	return (
		cli.command("desugar", "rewrite sources into the core forms their sugar is defined as")
		.flag("c", "check", "report what is not already core and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. D103; repeatable").repeated())
		.add(cli.positional("file.zg", "the sources to rewrite").required().repeated())
		.run(do_desugar)
	)
}

# lsp takes no arguments and no flags. The protocol is the interface: an editor starts the
# process, speaks JSON-RPC over its standard input and output, and stops it by closing them.
pub fn lsp_cmd() -> cli.Command {
	return (
		cli.command("lsp", "run the language server over stdio (JSON-RPC)")
		.run(do_lsp)
	)
}

# --- what each sub-command does -------------------------------------------------------------
#
# Each is handed the parsed command line and returns the process's exit status. There is no
# argument checking here: a missing file or an unreadable flag was refused before the
# function was ever called, which is the point of declaring the command line rather than
# unpicking it.

fn do_build(c: cli.Ctx) -> int {
	build_stage(c.args(), default_stage(c.get("emit"), c.args()), c.get("output"), job_count(c.get("jobs")))
	return 0
}

fn do_test(c: cli.Ctx) -> int {
	args := c.args()
	only := c.get("only")
	secs := c.int_of("timeout", TEST_TIMEOUT)
	return run_tests(args[0], only, secs) if args.len() > 0

	return run_tests(".", only, secs)
}

fn do_fmt(c: cli.Ctx) -> int {
	return run_fmt_check(c.args(), c.all("off")) if c.has("check")
	run_fmt(c.args(), c.all("off"))
	return 0
}

# do_lsp hands the server the one thing it cannot do for itself: turn a path and an unsaved
# buffer into the whole program that buffer belongs to. Resolving an import is 60 lines of
# environment variables, an installation root and a checkout layout, all of it here already,
# and none of it the protocol's business.
fn do_lsp(c: cli.Ctx) -> int {
	return lsp.serve(lsp_program)
}

fn lsp_program(path: str, text: str) -> lsp.Program {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	mut paths: list[str] = []
	mut root: list[str] = []
	load_with(path, dir_of(path), seen, root, srcs, paths, Buffer(path, text))
	return lsp.program(paths, srcs)
}

fn do_desugar(c: cli.Ctx) -> int {
	return run_desugar_check(c.args(), c.all("off")) if c.has("check")
	run_desugar(c.args(), c.all("off"))
	return 0
}

fn do_lint(c: cli.Ctx) -> int {
	return run_lint(c.args(), c.has("strict"))
}

# job_count reads -j, falling back to one job rather than none when it is not a number —
# a bad value should slow the build down, not stop it.
fn job_count(v: str) -> int {
	mut n := 0
	guard {
		n = strconv.parse_int(v, 10)
	}
	return 1 if n < 1
	return n
}

# default_stage resolves an unset `--emit` to what the entry file IS, so build_stage takes
# a stage it can trust rather than a sentinel it has to decode.
fn default_stage(emit: str, files: list[str]) -> str {
	return emit if emit != ""
	return "bin" if declares_main(files)

	return "lib"
}

# declares_main reports whether the ENTRY declares the program entry — the one thing that
# makes a source a program rather than a module.
#
# It asks the EMITTER's own predicate, because that is the module that acts on the answer:
# two definitions of "is this a program" would let this pick a library while the emitter
# writes a main wrapper into it.
#
# The entry only, not its imports: a module that happens to carry a `main` is not what the
# user pointed at. A file that cannot be read or parsed answers false and the ordinary
# pipeline reports why — this must not be the thing that says a source is broken.
#
# It reads and parses the file itself because its ONE caller runs before any pipeline has:
# default_stage decides which pipeline to run, so nothing has been loaded yet and there is
# no parse in hand to read this off. The rule inside `--emit bin` asks the same question of
# sources already loaded, and asks it with entry_has_main instead — a second read of a file
# the build has in memory is not a cheaper way to learn the same thing.
fn declares_main(files: list[str]) -> bool {
	return false if files.len() == 0

	mut found := false
	guard {
		src := read_source(files[0])
		found = zerg.c_has_main(zerg.parse_at(src, files[0]))
	}
	return found
}

# build_stage runs the pipeline as far as `emit` asks and no further.
#
# `-o` IS THE PATH WRITTEN, at every stage, which is the one sentence `--help` has always
# made ("where to write the result") and which was true of one stage in five. `--emit c`,
# `--emit tokens` and `--emit ast` ignored it entirely and wrote stdout — so `zerg build
# --emit c f.zg -o f.c` put the C on the terminal, created no `f.c`, and exited 0, which is
# the silent wrong answer this project forbids everywhere else. `--emit lib` read it and
# then appended `.o` to it unconditionally, so `-o out.o` wrote `out.o.o` beside an
# `out.o.o.c`.
#
# The DEFAULT is per stage and unchanged, because that is where the stages genuinely
# differ: the three reading stages are something a person is looking at, so with no `-o`
# they go to stdout and stay pipeable; the two that produce an artefact name it after the
# entry file, `.o` included, since a default has to be a whole path and only `--emit lib`
# knows the suffix its product wears. What no default may do is override what was asked
# for — a suffix appended to an explicit `-o` is the driver overruling the user.
#
# The default stage is the ENTRY FILE'S ANSWER, not a fixed one. A source is a module until
# something asks it to be a program, and what asks is `fn main` — so a file that declares
# one is built to a binary and a file that does not is built to an object, which is what
# each of them is for.
#
# It used to default to `lib` unconditionally, and every caller inside this repo passes
# `--emit bin` explicitly, so nothing here ever met the default. A first-time reader did:
# `zerg build main.zg -o app` wrote `app.o`, said nothing, and exited 0 — a program that
# silently is not one.
fn build_stage(files: list[str], emit: str, out: str, jobs: int) {
	# NO `guard` ON THE TWO STAGES BELOW. One used to wrap each of them whole, so a file that
	# could not be read, lexed or PARSED printed nothing and exited 0: `--emit ast` on a
	# program carrying an unbuilt form reported success and produced no tree. It is the
	# silent success load_unit had, and worse here — these are the two stages a person
	# reaches for when they want to know WHY a file will not build.
	if emit == "tokens" {
		write_result(zerg.dump_tokens(read_source(files[0])), out)
		return
	}
	if emit == "ast" {
		write_result(zerg.dump_ast(zerg.merge_files(load_sources(files))), out)
		return
	}
	if emit == "lib" {
		# separate compilation: the unit DECLARES the whole program but DEFINES only this
		# module, so its object can be linked beside the objects of the modules it imports.
		units := load_units(files[0])
		mut lex: list[zerg.Diag] = []
		lex_diags_of(unit_srcs(units), unit_paths(units), lex)
		report_diags(lex, unit_srcs(units), unit_paths(units))
		mut trees: list[zerg.File] = []
		for u in units {
			trees.append(zerg.merge_files_at(u.srcs, u.paths))
		}
		mut diags: list[zerg.Diag] = []
		obj_code := zerg.emit_unit_at(zerg.merge_asts(trees), trees[trees.len() - 1], diags)
		report_diags(diags, unit_srcs(units), unit_paths(units))
		compile_to(obj_code, out_or(out, drop_ext(files[0]) + ".o"), true)
		return
	}

	# `bin` DOES NOT COME THROUGH HERE. A whole-program emit answers the `c` stage's
	# question — one C file for the merged program — and a link does not want that file:
	# link_program compiles unit by unit so a rebuild that changes one module recompiles
	# one module, and it loads, parses and emits everything itself. Running both meant
	# every source was read twice, parsed twice and lowered twice, and the whole-program
	# C was written into a `str` and dropped. Cutting it is a THIRD of a cold `--emit bin`
	# self-build, and the diagnostics do not move: every rule that spoke here is a rule
	# c_emit_unit runs, and it runs it with the same whole-program view (merge_asts) over
	# every unit rather than once over the merge.
	if emit == "bin" {
		link_program(files[0], out_or(out, drop_ext(files[0])), jobs)
		return
	}
	if emit == "c" {
		mut paths: list[str] = []
		srcs := load_sources_at(files, paths)
		mut diags: list[zerg.Diag] = []
		lex_diags_of(srcs, paths, diags)
		report_diags(diags, srcs, paths)
		code := zerg.emit_files_diag(srcs, paths, diags)
		report_diags(diags, srcs, paths)
		guard {
			write_result(code, out)
		}
		return
	}
	io.ewrite(f"zerg: unknown stage {emit} (want tokens, ast, c, lib, or bin)\n")
	__zrt_exit(2)
}

# compile_to writes the emitted C beside its product and hands it to cc — compiled only
# (`-c`, an object) or compiled and linked against the runtime (an executable).
fn compile_to(code: str, output: str, object_only: bool) {
	cpath := output + ".c"
	guard {
		io.write_file(cpath, bytearray(code))
	}
	mut argv: list[str] = []
	if object_only {
		argv = cc_object_argv(cpath, output)
	} else {
		argv = cc_argv(cpath, output)
	}
	if __zrt_exec(argv) != 0 {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# out_or is the `-o` path, or the stage's own default when none was given. It exists so the
# defaults are written where they belong — at the stage that knows what its product is
# called — rather than as one shared `output` computed ahead of the dispatch, which is how
# `--emit lib` came to append `.o` to a path the user had spelled in full.
fn out_or(out: str, dflt: str) -> str {
	return dflt if out == ""

	return out
}

# write_result writes a stage a person READS: to `-o` when there is one, and to stdout when
# there is not, so the pipe that has always worked goes on working. The three stages that
# use it took no path at all before, which made `-o` a flag the compiler accepted and
# discarded.
fn write_result(text: str, out: str) {
	if out == "" {
		io.write(text)
		return
	}
	guard {
		io.write_file(out, bytearray(text))
	}
}

# drop_ext removes a trailing ".zg" so `zerg build hello.zg` writes `hello`.
fn drop_ext(path: str) -> str {
	return path if not has_suffix(path, ".zg")

	b := bytearray(path)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() - 3 {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# --- the test runner ------------------------------------------------------------------------
#
# A TEST BUILD IS A BUILD OF MORE FILES, not of a relaxed language. A `*_test.zg` sits in the
# module it tests and shares its namespace, so compiling it beside that module's other sources
# is the whole of what the white-box position means (docs/runtime/package.md): nothing about
# visibility moves, and there is no test-only way into a private name.
#
# So the unit of work is a DIRECTORY. A module is a directory whose files share a scope, and a
# directory holding a `*_test.zg` becomes one test binary — its own sources, its test files,
# and one generated driver that calls the `#[test]` functions by name.
#
# ONE COROUTINE PER TEST, and one PROCESS per test when that is not enough. A test runs in a
# `spawn`ed coroutine, inside a `guard`, and the two together contain everything a test can do
# to itself that is containable — measured on this branch:
#
#   an assertion that does not hold    the `guard` catches it; it is a value the runner reads
#   an uncaught abort (`IndexError`)   the `guard` catches that too; and with no guard at all
#                                      the coroutine dies alone and the process runs on
#   a stack overflow                   THE PROCESS DIES — exit 1, and nothing after it runs
#   `os.exit(0)`                       THE PROCESS DIES — with the status a passing run has
#
# The last two are the un-catchable class, and they are why the one-process-per-test
# arrangement is still here as the FALLBACK rather than deleted. The driver re-runs one named
# test when it is asked to, in a process of its own, which is how a run that died gets each
# survivor attributed to the test that caused it.
#
# A TEST ANSWERS IN A FILE, not in an exit status. A status is one small integer: it cannot
# carry which assertion failed or what the values were, and — the part that decides the shape —
# `os.exit(0)` inside a test produces exactly the status a passing test does. So a record is
# written AFTER the body is out of the driver's hands, and a MISSING record is the fact that it
# never came back. Finishing is observed, never inferred from a number that cannot tell the two
# apart, and THAT is what makes the fallback exact: the records present after a run that died
# are a prefix, so the tests with no record are precisely the ones left to run.
#
# THE RECORD FILE is line-oriented, one record per test, written by the driver and read by
# `take_records` below — the only two readers there are, and they sit in this file together:
#
#   T <name>        this record is about test <name>
#   V <verdict>     `ok`, `fail`, `skip` or `crash`
#   M <line>        one line of what goes under it — a skip's reason, a failure's notes
#
# A message is many `M` lines rather than one escaped field, so nothing has to encode a
# newline: a test's notes are lines already.

# run_tests is the whole command: find the packages, run each one's tests, and say what
# happened. It answers 0 only when nothing failed.
#
# A RUN THAT FOUND NOTHING SAYS SO, on stderr and in the STATUS. Discovering no test and
# printing nothing is indistinguishable from a run where everything passed, which is the one
# failure a test runner must not have — every gate in this repository is written against it —
# and a sentence alone is not enough, because the reader of a CI line is a shell.

# NOTHING_FOUND is what `zerg test` answers when the search succeeded and turned up no test,
# and it is a status of its own because that is a DIFFERENT ANSWER from the three already
# spoken here. Rename a directory, move a suite, edit a glob or mistype a path into a CI line,
# and a runner that answers 0 leaves the board green forever while running nothing — the shape
# this repository has already been bitten by and written down: a gate measuring nothing looks
# like a gate finding nothing. pytest reserves a status for exactly this.
#
# The ladder `zerg test` now answers on, and why this is 3 rather than 2:
#
#   0  every test that ran passed, or skipped
#   1  a test failed, or timed out — the tests said no
#   2  the COMMAND was wrong: no such path, a `--only` that matched nothing, a fixture
#      parameter that resolves to nothing. Nothing ran, and nothing was going to
#   3  the command was right, the search ran, and there was no test in what it searched
#
# 2 was already taken and taking it again would be the same erasure one level up: the reader's
# next move differs, and that is the whole test of whether two answers are one. A 2 is fixed by
# editing the command line; a 3 is fixed by looking at the tree. pytest's own number for this
# is 5, which is an artifact of its history (2 interrupted, 3 internal error, 4 usage) and not
# a thing to copy — this ladder is dense, and 3 is the next rung.
const NOTHING_FOUND := 3

fn run_tests(root: str, only: str, secs: int) -> int {
	# A PATH THAT IS NOT THERE IS NOT AN EMPTY TREE. The walk below reads a missing directory as
	# a directory with nothing in it — that is what the runtime's listing answers, deliberately,
	# because its other caller is probing a search path — so `zerg test tset/` would report "no
	# tests", exit 0, and leave a typo looking exactly like a package nobody has written tests
	# for. The two are told apart HERE, where the path is the one the user typed.
	if not __zrt_exists(root) {
		io.ewrite(f"zerg: no such path `{root}`\n")
		return 2
	}

	# A FILE PATH NAMES THE PACKAGE IT IS IN. Iterating on one file is the commonest thing
	# anybody does with a test runner, and a walk that only knows directories answered it with
	# "no tests" — a wrong answer delivered calmly, which is the one thing this project's
	# standing rule forbids of any form. There is nothing to invent for it: the package model
	# already answers "which build is this file compiled in" (docs/runtime/package.md), so a
	# file is resolved to its package and that package is what runs.
	#
	# THE PACKAGE, NOT THE FILE'S TESTS. `strings_test.zg` names the package `strings.zg` +
	# `strings_test.zg`, and running that pair is what a white-box test of `strings` IS — a run
	# of the test file alone is not a build of anything. `--only` is the tool for one test.
	#
	# A `.zg` NAME IS WHAT MARKS A FILE, which is the convention this walk already uses one
	# function down: `test_pkgs` does not descend into a `.zg` name either. There is no `isdir`
	# under this runtime, and inventing one for this would put a second answer to "is this a
	# source file" in the tree.
	base := search_root(root)
	mut pkgs: list[Pkg] = []
	if base == root {
		test_pkgs(root, pkgs)
	} else {
		file_pkgs(root, pkgs)
	}

	# EVERY PACKAGE IS RESOLVED BEFORE ANY PACKAGE RUNS. A parameter naming no fixture, a
	# parameter whose type is not what the fixture produces, and a circle among fixtures are
	# all facts about the SOURCE, and a runner that discovered one of them halfway through a
	# run would have already reported verdicts for tests whose neighbours never got to run —
	# a report whose green half means nothing. So they are asked for the whole tree first,
	# reported together the way a compiler reports diagnostics, and nothing is executed.
	mut errs: list[str] = []
	mut chosen := 0
	for p in pkgs {
		mut fixts: list[Fixt] = []
		mut tests: list[Tst] = []
		plan_pkg(base, p, only, fixts, tests, errs)
		chosen = chosen + tests.len()
	}
	if errs.len() > 0 {
		for e in errs {
			io.ewrite(e + "\n")
		}
		return 2
	}

	# A FILTER THAT SELECTED NOTHING IS A TYPO, not a green run. `--only` is asked for while
	# somebody is iterating on one test, which is exactly when a misspelling would be read as
	# "it passes now" — so it is refused with the same status an unresolvable parameter gets,
	# and the tree it looked in is named because the walk may simply not have reached it.
	if only != "" and chosen == 0 {
		io.ewrite(f"zerg: no `#[test]` under `{root}` has a name beginning with `{only}`\n")
		return 2
	}

	mut passed := 0
	mut failed := 0
	mut skipped := 0
	mut stuck := 0
	for p in pkgs {
		run_pkg(base, p, only, secs, passed, failed, skipped, stuck)
	}

	if passed + failed + skipped + stuck == 0 {
		io.ewrite(f"zerg: no tests: nothing under `{root}` declares a `#[test]`\n")
		return NOTHING_FOUND
	}
	io.println("")

	# A SKIP IS COUNTED APART FROM BOTH. It is not a pass — nothing was checked — and it is
	# not a failure — nothing was claimed. Folding it into either makes the number that
	# matters the one nobody can read: a suite whose skips are counted as passes goes green
	# on a platform where none of it ran.
	# A TIMEOUT IS COUNTED APART TOO, for the same reason a skip is: it is not a failed
	# assertion — nothing was decided — and folding it into the failures would make a hung test
	# and a broken one the same number.
	io.println(f"{passed} passed, {failed} failed, {skipped} skipped, {stuck} timed out")
	return 1 if failed > 0 or stuck > 0

	return 0
}

# --- what a package is ------------------------------------------------------------------
#
# Pkg is one test binary: the directory it is built in, and — when the package is a ONE-FILE
# module rather than the directory itself — the name of that module. `mod` is `""` for the
# directory.
#
# THERE ARE TWO SHAPES BECAUSE THE LANGUAGE HAS TWO. `module_at` resolves an import to a
# single `<name>.zg` file BEFORE it resolves one to a directory, so a `.zg` file beside its
# neighbours is a module in its own right — which is what `src/stdlib` is: sixteen
# independent one-file modules in one flat directory, not one module of sixteen files.
#
# A test build used to know only the second shape, and that made a white-box test of a
# stdlib module IMPOSSIBLE: a `strings_test.zg` dropped beside `strings.zg` made every other
# file in the directory a source of the same unit, which stopped at `atomic.zg` (`E215`, a
# generic struct) and then at the `pub` names two modules share (`E705 is_digit`, in `ascii`
# and `strconv`) — pointing at files the author did not write, before one test had run.
#
# So a test file is now resolved the way an import is, MOST SPECIFIC FIRST: `strings_test.zg`
# belongs to `strings.zg` if that file is beside it, and to the directory otherwise.
#
# WHAT IT COSTS: in a directory that IS one module, a `*_test.zg` whose name matches one of
# the module's files takes that file alone — so `a_test.zg` in a directory of `a.zg` and
# `b.zg` no longer sees `b.zg`. That is a loud failure (an undeclared name at the line that
# used it) and never a silent one, and the way out is to name the file for the module rather
# than for one of its parts. In exchange the rule is MONOTONE: adding a test file never
# changes what another package is built from.
struct Pkg {
	pub dir: str
	pub mod: str
}

# test_pkgs collects the packages under `root`, outermost first, in the sorted order the
# runtime's directory read guarantees — so two runs of the same tree report in the same order.
# One directory may hold several: one per one-file module that has a test file, and one for
# the directory itself when a test file names no module.
#
# A DOT-NAME IS NOT DESCENDED INTO. `.git` alone is more files than the tree it sits in, and
# `.zerg-cache` is where this command writes; a walk that read either would spend the run
# looking at things nobody wrote. A `.zg` name is not descended into either, which costs one
# `opendir` per source file otherwise.
fn test_pkgs(root: str, mut &out: list[Pkg]) {
	dir_pkgs(root, out)
	for name in __zrt_listdir(root) {
		if not is_hidden(name) and not has_suffix(name, ".zg") {
			test_pkgs(join_path(root, name), out)
		}
	}
}

# dir_pkgs is the packages of ONE directory, and it is separate from the walk above because
# the walk is not the only caller: a run pointed at a file asks the same question of that
# file's directory alone.
#
# A `#[test]` OUTSIDE A `*_test.zg` STILL FORMS A PACKAGE. The decorator may be written
# anywhere — that is the language's answer and both compilers read it there — so discovery
# finds one wherever it is, and L601 goes on warning that a `#[test]` in an ordinary file
# SHIPS. Both, not one: the linter's job is to say where a test ought to live and the runner's
# is to run what is written, and a runner that quietly skipped a `#[test]` because of its
# file's NAME was reporting a green run of a suite it had not run.
#
# IT INTRODUCES NO PACKAGE SHAPE. The package a stray `#[test]` belongs to is the one that
# ALREADY compiles the file it is written in: a file claimed by a one-file module is in that
# module's package, which the test file above already made, and an unclaimed file is among the
# directory package's sources. So all this adds is the directory package APPEARING where no
# `*_test.zg` would have made one — `pkg_sources` is untouched, and the monotone property
# docs/runtime/package.md states holds for the same reason it did before: which files a
# package is built from is decided by the `*_test.zg` names alone.
fn dir_pkgs(dir: str, mut &out: list[Pkg]) {
	names := __zrt_listdir(dir)
	mut whole := false
	for name in names {
		if zerg.is_test_file(name) and not is_own_file(name) {
			m := test_module(dir, name)
			if m == "" {
				whole = true
			} else {
				out.append(Pkg(dir, m))
			}
		}
	}

	# ASKED ONLY WHILE THE ANSWER IS STILL OPEN. A directory a test file already made a package
	# of needs no second reason to be one, and this is the expensive question of the two — so
	# the cost stays off every directory that has a test file at all.
	if not whole {
		whole = a_source_declares_a_test(dir)
	}
	if whole {
		out.append(Pkg(dir, ""))
	}
}

# a_source_declares_a_test is whether any file the DIRECTORY's own package would be compiled
# from holds a `#[test]`.
#
# IT ASKS pkg_sources, which is the list that package is built from, rather than re-deriving
# which of a directory's names belong to it. The two questions are one — "is this file in the
# directory package" — and the paragraph above claims this adds no package SHAPE, which is a
# claim about those two agreeing; written out twice, nothing would hold them to it.
#
# It stops at the first, because one is the whole answer and each of these is a parse.
fn a_source_declares_a_test(dir: str) -> bool {
	for f in pkg_sources(Pkg(dir, "")) {
		return true if file_declares_a_test(f)
	}
	return false
}

# file_declares_a_test parses one source and answers whether it declares a `#[test]`.
#
# IT PARSES, because the decorator is a declaration's and a grep for the text would be a
# second answer to what a `#[test]` is — one that a comment or a string literal satisfies. The
# parse is one this run was going to do anyway for a directory that turns out to be a package.
#
# A FILE THAT DOES NOT PARSE IS NOT A TEST PACKAGE, and the guard is what says so rather than
# ending the run: discovery walks files nobody named, and a broken source somewhere under the
# path is the BUILD's finding, reported with a place by whichever package compiles it.
fn file_declares_a_test(path: str) -> bool {
	mut found := false
	guard {
		found = has_a_test(zerg.parse_at(read_source(path), path))
	}
	return found
}

# has_a_test is whether a parsed file declares a `#[test]` at all. It is its own function
# because the walk above runs inside a `guard`, and a `guard` block cannot carry the early
# return that stops this one at the first hit.
fn has_a_test(tree: zerg.File) -> bool {
	for fd in tree.fns {
		return true if fd.is_test
	}
	return false
}

# search_root is the directory a run searches from: the path itself, or its directory when the
# path names a `.zg` file. Ancestors — the `fixtures_test.zg` of each level — are counted from
# it, which keeps the rule the one docs/runtime/package.md already states: they are counted
# from the path `zerg test` was GIVEN, and the directory a named file sits in is that path.
fn search_root(path: str) -> str {
	return dir_of(path) if has_suffix(path, ".zg")

	return path
}

# file_pkgs is the packages that COMPILE `path`. It is the package model's own answer read
# backwards — `pkg_sources` says which files a package is built from, and this asks which
# package a file is in — so the two can never disagree about a file.
#
# The directory is `search_root`'s answer and is derived here rather than passed: two arguments
# that have to agree are one argument, and the caller had nothing else to give.
#
# There may be no package, which is a run that found nothing and is reported as one: a `.zg`
# file with no `#[test]` in it and no test file naming it is in none.
fn file_pkgs(path: str, mut &out: list[Pkg]) {
	mut all: list[Pkg] = []
	dir_pkgs(search_root(path), all)
	for p in all {
		if has_str(pkg_sources(p), path) {
			out.append(p)
		}
	}
}

# test_module is the one-file module a test file names, or `""` when it names none.
#
# `fixtures_test.zg` names none WHATEVER is beside it: it is the file a directory contributes
# to the directories below (FIXTURES_NAME), so it belongs to the directory and to every
# package in it, and a `fixtures.zg` that happened to sit there would otherwise carry it off
# into a package of its own.
fn test_module(dir: str, name: str) -> str {
	return "" if name == FIXTURES_NAME

	base := drop_suffix(name, "_test.zg")

	return "" if base == ""

	return base if __zrt_exists(join_path(dir, base + ".zg"))

	return ""
}

# claimed says whether a file belongs to a one-file module of this directory rather than to
# the directory itself — `strings.zg` and `strings_test.zg` both do, once `strings_test.zg`
# is there to claim them, and neither is then compiled into the directory's own package.
fn claimed(dir: str, name: str) -> bool {
	return true if test_module(dir, name) != ""

	base := drop_suffix(name, ".zg")
	return false if base == ""

	t := base + "_test.zg"
	return false if not __zrt_exists(join_path(dir, t))

	return test_module(dir, t) != ""
}

# drop_suffix is `s` without `suffix`, or `""` when `s` does not end in one — and `""` also
# when the two are equal, since a file named `_test.zg` names no module either.
fn drop_suffix(s: str, suffix: str) -> str {
	return "" if not has_suffix(s, suffix)

	b := bytearray(s)
	n := b.len() - bytearray(suffix).len()
	mut out: list[byte] = []
	mut i := 0
	for i < n {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# is_own_file says whether a name is one THIS COMMAND writes — a generated driver or the copy
# of an inherited fixture file. Neither is a source, and neither makes a directory a package:
# a leftover from an interrupted run would otherwise be discovered as a test file of its own.
fn is_own_file(name: str) -> bool {
	return has_prefix(name, DRIVER_PREFIX) or has_prefix(name, INHERITED_PREFIX)
}

fn is_hidden(name: str) -> bool {
	b := bytearray(name)
	return false if b.len() == 0

	return b[0] == b'.'
}

# pkg_sources is every file one package is compiled from, the `*_test.zg` files INCLUDED — and
# that inclusion is the one line where a test build differs from every other one. `module_at`
# filters them out where a module's directory is read; this is the reading that does not.
#
# A ONE-FILE MODULE takes three names and no listing: the file, the directory's own
# `fixtures_test.zg` if there is one — a fixture serves every package of its directory, not
# only the directory's own — and the test file that named it.
#
# A LEFTOVER DRIVER IS NOT A SOURCE. The name is this command's own, and one is there only when
# a previous run was interrupted between writing it and taking it away; reading it back would
# compile the last run's driver beside this one's — two `fn main`, and a list of tests from
# whatever the file declared then.
fn pkg_sources(p: Pkg) -> list[str] {
	mut out: list[str] = []
	if p.mod == "" {
		for name in __zrt_listdir(p.dir) {
			if has_suffix(name, ".zg") and not is_own_file(name) and not claimed(p.dir, name) {
				out.append(join_path(p.dir, name))
			}
		}
		return out
	}
	out.append(join_path(p.dir, p.mod + ".zg"))
	fx := join_path(p.dir, FIXTURES_NAME)
	if __zrt_exists(fx) {
		out.append(fx)
	}
	out.append(join_path(p.dir, p.mod + "_test.zg"))
	return out
}

# DRIVER_PREFIX opens what a generated driver is called, and the name ends in `_test.zg` for
# the reason that is the whole of why it may sit in a source directory at all: a `*_test.zg` is
# compiled by no normal build, in either compiler, so a driver left behind by an interrupted
# run is a file `zerg build` does not read. The next `zerg test` on that package overwrites it
# before it is used and removes it after, so a leftover heals itself rather than accumulating.
#
# It is one name per PACKAGE rather than one per run, and a fixed name is what makes that
# healing possible: a run interrupted twice leaves one file, not two. The module's name is in
# it because one directory may hold several packages, and two drivers of one name in one
# directory would be one driver.
const DRIVER_PREFIX := "zerg_test_driver_"

fn driver_name(p: Pkg) -> str {
	return DRIVER_PREFIX + "test.zg" if p.mod == ""

	return f"{DRIVER_PREFIX}{p.mod}_test.zg"
}

# pkg_key is what a package's binary and report are filed under, and it names BOTH halves of
# the package: two packages of one directory would otherwise share a binary.
fn pkg_key(p: Pkg) -> str {
	return sha256.hex(bytearray(f"{p.dir}|{p.mod}"))
}

# INHERITED_PREFIX names the copy of an ancestor's fixture file that a package's driver is
# built with.
#
# A COPY, BECAUSE A MODULE IS A DIRECTORY. The file is read from an ancestor, and a
# declaration read from another directory belongs to another module however the build was
# told to compile it — so every type and function an inherited fixture file declares would be
# `E508` / `E301` to the tests that asked for it. Writing it into the package is what the
# driver already does for exactly this reason, and it is the only thing that puts the two in
# one scope.
#
# The copy is byte for byte, so a diagnostic inside one points at the right LINE of the file
# the author wrote; only the name in front of it is this run's. It ends in `_test.zg` like
# everything else here, so no shipping build reads one, and it is taken away with the driver.
const INHERITED_PREFIX := "zerg_test_inherited_"

# --- fixtures --------------------------------------------------------------------------
#
# A TEST DECLARES WHAT IT NEEDS AND THE FRAMEWORK BUILDS IT. A `#[fixture]` is a function
# that takes its tests as a CONTINUATION:
#
#   #[fixture]
#   fn db(use: fn (Conn)) {
#       c := connect("postgres://tmp/test")
#       defer c.close()
#       use(c)
#   }
#
# `use: fn (T)` is identified by TYPE, and it is two things at once: the continuation the
# tests run inside, and the declaration of what this fixture PRODUCES. Every OTHER parameter
# is a DEPENDENCY, matched by NAME against another fixture — which is one rule for
# test-to-fixture and fixture-to-fixture both.
#
# THE CONTINUATION IS WHY THERE ARE NO GENERICS HERE. The shape this replaced had the
# fixture hand its value over with `ctx.ready(v)` and block; `ready` would have had to be
# generic over the value's type, and `impl Context { fn ready[T] }` is `E409` in this
# compiler. `use(c)` is an ordinary call of an ordinary function value, so the whole
# mechanism is one the language already had — and the value's type is checked by the
# compiler at the call, not by anything written here.
#
# TEARDOWN IS `defer`, the language's own idiom, and it needs nothing from this runner: the
# fixture's body is a body, so its `defer` fires when the body ends, which is after `use`
# returns. Dependency order and teardown order therefore BOTH fall out of the nesting the
# driver writes — an inner `defer` fires first — and there is no topological sort to run at
# runtime and no teardown registry to keep.
#
# WHERE A FIXTURE LIVES, and what inherits it: a fixture is declared in a `*_test.zg`, so it
# reaches no shipping build, and it serves the tests of its own DIRECTORY. A fixture that is
# to serve the directories BELOW as well goes in `fixtures_test.zg`, which is the one file an
# ancestor directory contributes downward — see FIXTURES_NAME.
#
# WHAT A PACKAGE IS STAYS WHAT IT WAS: one directory, one driver, one process. So `pkg/sub`
# and `pkg/sub2` each build their OWN instance of an inherited fixture, because they are
# separate processes — pytest's `scope="package"`, not `scope="session"`. Session scope is
# not wanted and is anyway unreachable: `E705` refuses two modules both defining a `pub`
# name, so one driver over a whole tree cannot be built, and a live value does not cross a
# process boundary.

# FIXTURES_NAME is the file an ancestor directory contributes to every directory below it.
#
# IT IS ONE FIXED NAME AND NOT ANY `*_test.zg`, and the reason is what a test file IS: a
# `*_test.zg` is a file OF its module, written in that module's scope, and it reads the
# module's private names — that is the white-box position docs/runtime/package.md describes.
# Compiling `pkg/lib/lib_test.zg` into the driver for `pkg/lib/sub` would carry it into a
# scope where `pkg/lib`'s own sources are not, so every private name it touched would be
# undeclared. A file that is to be read from BELOW has to be written for that, and a name is
# how a reader and this runner both know which files those are.
#
# The second half of the same reason is what would otherwise happen to the TESTS in it: an
# ancestor's `*_test.zg` compiled into every descendant would run its `#[test]` functions
# once per descendant directory. So only the FIXTURES of an inherited file are taken; a
# `#[test]` written in a `fixtures_test.zg` runs in its own directory, once, like any other.
#
# It ends in `_test.zg` because everything here does: that suffix is what keeps a file out of
# a shipping build (`zerg.is_test_file`), and a fixture must never reach one.
#
# ANCESTORS ARE COUNTED FROM THE PATH `zerg test` WAS GIVEN, not from the filesystem root —
# `zerg test .` at the top of a project reads every level, and `zerg test pkg/sub` reads from
# `pkg/sub` down. That is pytest's rootdir model, and the alternative is a walk with no upper
# bound that would read files outside anything the caller named.
const FIXTURES_NAME := "fixtures_test.zg"

# Fixt is one `#[fixture]`: its name, the type its `use: fn (T)` continuation takes — which is
# what it produces — the names and declared types of its dependencies in order, and where it
# was written.
struct Fixt {
	pub name: str
	pub produces: str
	pub deps: list[str]
	pub deptys: list[str]
	pub path: str
	pub line: int
	pub col: int
}

# Tst is one `#[test]`: its name and place, its parameters, which of them is the
# `testing.Context`, and — filled in by resolution — the fixtures that have to be standing
# before it can run, dependencies first.
struct Tst {
	pub name: str
	pub path: str
	pub line: int
	pub col: int
	pub pnames: list[str]
	pub ptys: list[str]
	pub isctx: list[bool]
	pub need: list[str]
}

# plan_pkg reads one package's declarations and resolves them, appending a sentence to `errs`
# for every parameter that names no fixture, every parameter whose type is not what its
# fixture produces, and every circle. It is called twice per run — once for the whole tree
# before anything executes, and once by run_pkg with the answers it needs — because a plan is
# cheap and a second copy of the resolution would be a second place the rule is written down.
fn plan_pkg(root: str, p: Pkg, only: str, mut &fixts: list[Fixt], mut &tests: list[Tst], mut &errs: list[str]) {
	mut own: list[bool] = []
	files := pkg_files(root, p, own)
	pkg_decls(files, own, fixts, tests, errs)
	keep_only(only, tests)

	mut order: list[str] = []
	fix_order(fixts, order, errs)

	mut i := 0
	for i < tests.len() {
		resolve_test(fixts, order, tests, i, errs)
		i = i + 1
	}
}

# pkg_files is every source one test binary is built from: the `fixtures_test.zg` of each
# directory between the path `zerg test` was given and this one, then the package's own
# sources. `own` says, for each, whether its `#[test]` functions belong to this package —
# an inherited file contributes its fixtures and nothing else.
fn pkg_files(root: str, p: Pkg, mut &own: list[bool]) -> list[str] {
	mut out: list[str] = []
	for a in ancestors_of(root, p.dir) {
		f := join_path(a, FIXTURES_NAME)
		if __zrt_exists(f) {
			out.append(f)
			own.append(false)
		}
	}
	for f in pkg_sources(p) {
		out.append(f)
		own.append(true)
	}
	return out
}

# keep_only drops the tests `--only` did not name, and it is done HERE — before resolution,
# before the driver is written, before anything is compiled — which is what makes the claim
# about fixtures exact rather than approximate: the nesting is generated from the tests that
# REMAIN, so a level nobody left needs is never written, and a fixture only a filtered-out
# test asked for is never built. A filter applied at run time would have stood every one of
# them up and then skipped past the tests.
#
# THE MATCH IS A PREFIX, which is one rule and not two: a whole name selects one test, and the
# stem a suite shares selects the suite. A filter that selected nothing is refused by
# run_tests rather than passed over in silence.
fn keep_only(only: str, mut &tests: list[Tst]) {
	return if only == ""

	mut kept: list[Tst] = []
	for t in tests {
		if has_prefix(t.name, only) {
			kept.append(t)
		}
	}
	tests = kept
}

# ancestors_of is the directories strictly between `root` and `dir`, `root` included and `dir`
# excluded, outermost first. A package's own `fixtures_test.zg` is already among its sources,
# which is why the directory itself is left out.
fn ancestors_of(root: str, dir: str) -> list[str] {
	mut out: list[str] = []
	return out if dir == root

	mut rev: list[str] = []
	mut at := dir_of(dir)
	mut more := true
	for more {
		rev.append(at)

		# `root` is a prefix of every package directory — `test_pkgs` builds each one by
		# joining onto it — so the climb ends there. The other two are the floor `dir_of`
		# answers with, and they are here so a path this walk did not build cannot loop.
		if at == root or at == "." or at == "/" {
			more = false
		} else {
			at = dir_of(at)
		}
	}
	mut i := rev.len() - 1
	for i >= 0 {
		out.append(rev[i])
		i = i - 1
	}
	return out
}

# pkg_decls collects the `#[test]` and `#[fixture]` declarations of a package's sources.
#
# EVERY FILE OF THE PACKAGE IS READ FOR ONE, and not only its `*_test.zg`. A decorator may be
# written anywhere — the language says so and both compilers read it there — so a `#[test]` in
# an ordinary module file is a test this runner runs, and `zerg lint` goes on warning (L601)
# that such a test SHIPS. Skipping it here meant a suite could be green having never run a
# function its author wrote as a test, which is the linter's finding turned into a silence.
#
# WHAT DOES NOT CHANGE is which files a package is compiled from: the file was already among
# this package's sources, so it was already compiled. What moved is which functions the
# generated driver CALLS.
#
# AN INHERITED FILE CONTRIBUTES FIXTURES AND NOTHING ELSE, which is `own` and is the one rule
# here that reads the list: an ancestor's `fixtures_test.zg` is copied into every package below
# it, and its `#[test]` functions would otherwise run once per descendant directory instead of
# once, in the directory that wrote them.
fn pkg_decls(files: list[str], own: list[bool], mut &fixts: list[Fixt], mut &tests: list[Tst], mut &errs: list[str]) {
	mut i := 0
	for i < files.len() {
		f := files[i]
		tree := zerg.parse_at(read_source(f), f)
		for fd in tree.fns {
			if fd.is_fixture {
				fixts.append(mk_fixture(fd, errs))
			} else if fd.is_test and own[i] {
				tests.append(mk_test(fd, errs))
			}
		}
		i = i + 1
	}
}

# mk_fixture reads one `#[fixture]` declaration: the continuation parameter says what it
# produces, and every other parameter is a dependency named after the fixture that builds it.
fn mk_fixture(fd: zerg.FnDecl, mut &errs: list[str]) -> Fixt {
	mut produces := ""
	mut uses := 0
	mut deps: list[str] = []
	mut deptys: list[str] = []
	mut i := 0
	for i < fd.params.len() {
		p := fd.params[i]
		a := zerg.ty_fn1_arg(p.ty)
		if a == "" {
			deps.append(p.name)
			deptys.append(zerg.ty_name(p.ty))
		} else {
			uses = uses + 1
			produces = a
		}
		i = i + 1
	}

	at := f"{fd.path}:{fd.line}:{fd.col}"
	if uses == 0 {
		errs.append(f"{at}: the fixture `{fd.name}` declares no `use: fn (T)` parameter — a fixture hands its value to the tests by CALLING one, and the type that continuation takes is what the fixture produces, so a fixture without one produces nothing anything could ask for")
	} else if uses > 1 {
		errs.append(f"{at}: the fixture `{fd.name}` declares {uses} parameters of the shape `fn (T)` — one of them is the continuation the tests run inside and there is no way to tell which, so a fixture takes exactly one")
	}
	return Fixt(fd.name, produces, deps, deptys, fd.path, fd.line, fd.col)
}

# mk_test reads one `#[test]` declaration's parameter list.
#
# THE CONTEXT IS IDENTIFIED BY TYPE and a fixture by NAME, which is the whole of the rule. A
# runner that looked for a parameter called `ctx` would be reading a name the author chose,
# so `fn t(t: testing.Context)` would get the wrong argument and `fn t(ctx: int)` the right
# one. The qualifier is resolved away at the parse — `testing.Context` and a local `Context`
# are one name by then — which is the same ambiguity this compiler already has everywhere
# else.
#
# A `#[test]` DECLARES NO RETURN TYPE, and that is REFUSED here rather than warned about.
# `#[test] fn t() -> bool { return false }` was reported `ok`: the driver writes the call as a
# statement, so the value went nowhere, and the one reader who could have been told — a person
# who believes the value is the verdict — was told the opposite. Go refuses the same shape
# outright (`wrong signature for TestX`).
#
# WHY A REFUSAL AND NOT A LINT. A lint is advice and exits 0, so `zerg test` would go on
# printing `ok` for that function while a second command elsewhere disagreed — which is this
# whole class of defect, one tool answering calmly and wrongly about what another can see. It
# is refused where the decorator MEANS something, beside the fixture rules and through the same
# channel: reported with a place, for the whole tree, before anything is compiled or run.
#
# IT IS ABOUT `#[test]` AND NOT ABOUT `#[fixture]`. A fixture hands its value over by CALLING
# its `use: fn (T)` continuation, so what it produces is already declared and a return type
# there is a separate question.
fn mk_test(fd: zerg.FnDecl, mut &errs: list[str]) -> Tst {
	at := f"{fd.path}:{fd.line}:{fd.col}"
	if fd.has_ret {
		errs.append(f"{at}: the test `{fd.name}` declares `-> {zerg.ty_name(fd.ret)}` and nothing reads it — a `#[test]` answers with an `assert`, and the driver calls it as a statement, so the value would be dropped; drop the return type, or `assert` what you were going to return")
	}

	mut pnames: list[str] = []
	mut ptys: list[str] = []
	mut isctx: list[bool] = []
	mut i := 0
	for i < fd.params.len() {
		p := fd.params[i]
		tn := zerg.ty_name(p.ty)
		pnames.append(p.name)
		ptys.append(tn)
		isctx.append(tn == "Context")
		i = i + 1
	}
	mut need: list[str] = []
	return Tst(fd.name, fd.path, fd.line, fd.col, pnames, ptys, isctx, need)
}

# fix_index is where a fixture of this name is, or -1.
fn fix_index(fixts: list[Fixt], name: str) -> int {
	mut i := 0
	for i < fixts.len() {
		return i if fixts[i].name == name
		i = i + 1
	}
	return -1
}

fn has_str(xs: list[str], s: str) -> bool {
	for x in xs {
		return true if x == s
	}
	return false
}

# fix_order puts the fixtures in an order where a dependency comes before what depends on it,
# and reports the two things that walk finds: a dependency naming no fixture, and a circle.
#
# THE ORDER IS WHAT MAKES THE NESTING POSSIBLE. A test's chain is its required fixtures listed
# in this order, so every fixture in a chain has its own dependencies already standing above
# it — which is why the driver can write the nesting straight out and never has to sort
# anything at runtime.
fn fix_order(fixts: list[Fixt], mut &order: list[str], mut &errs: list[str]) {
	mut color: list[int] = []
	for f in fixts {
		color.append(0)
	}
	mut i := 0
	for i < fixts.len() {
		mut stack: list[str] = []
		fix_visit(fixts, i, color, order, errs, stack)
		i = i + 1
	}
}

# fix_visit is the depth-first walk: white is unvisited, GREY IS ON THE STACK — which is what
# a circle is — and black is finished.
fn fix_visit(fixts: list[Fixt], i: int, mut &color: list[int], mut &order: list[str], mut &errs: list[str], mut &stack: list[str]) {
	return if color[i] == 2

	if color[i] == 1 {
		errs.append(cycle_says(fixts, i, stack))

		# EVERY FIXTURE IN THE CIRCLE IS ANSWERED FOR by that one sentence, so they are all
		# finished here. Left grey, the outer loop would enter the same circle at each of its
		# members in turn and report one rotation of it per member.
		mut k := stack_index(stack, fixts[i].name)
		for k < stack.len() {
			j := fix_index(fixts, stack[k])
			if j >= 0 {
				color[j] = 2
			}
			k = k + 1
		}
		return
	}

	color[i] = 1
	stack.append(fixts[i].name)
	mut d := 0
	for d < fixts[i].deps.len() {
		j := fix_index(fixts, fixts[i].deps[d])
		if j < 0 {
			errs.append(f"{fixts[i].path}:{fixts[i].line}:{fixts[i].col}: the fixture `{fixts[i].name}` asks for `{fixts[i].deps[d]}` and no `#[fixture]` of that name is in scope — every parameter of a fixture but its `use: fn (T)` names another fixture")
		} else {
			if fixts[j].produces != fixts[i].deptys[d] {
				errs.append(f"{fixts[i].path}:{fixts[i].line}:{fixts[i].col}: the fixture `{fixts[i].name}` declares `{fixts[i].deps[d]}: {fixts[i].deptys[d]}` and the fixture `{fixts[j].name}` produces `{fixts[j].produces}` — a fixture's `use: fn (T)` is what it produces, and the parameter that receives it is declared T")
			}
			fix_visit(fixts, j, color, order, errs, stack)
		}
		d = d + 1
	}
	stack = drop_last(stack)
	color[i] = 2
	order.append(fixts[i].name)
}

# cycle_says names the circle the way it was walked — `a` -> `b` -> `a` — starting and ending
# at the fixture that closed it, so a reader can follow it back through their own source.
fn cycle_says(fixts: list[Fixt], i: int, stack: list[str]) -> str {
	name := fixts[i].name
	mut chain := ""
	mut k := stack_index(stack, name)
	for k < stack.len() {
		chain = chain + f"`{stack[k]}` -> "
		k = k + 1
	}
	chain = chain + f"`{name}`"
	return f"{fixts[i].path}:{fixts[i].line}:{fixts[i].col}: the fixtures {chain} depend on each other in a circle — a fixture is built inside the fixtures it names, so a circle has no place to start"
}

fn stack_index(stack: list[str], name: str) -> int {
	mut i := 0
	for i < stack.len() {
		return i if stack[i] == name
		i = i + 1
	}
	return 0
}

fn drop_last(xs: list[str]) -> list[str] {
	mut out: list[str] = []
	mut i := 0
	for i < xs.len() - 1 {
		out.append(xs[i])
		i = i + 1
	}
	return out
}

# resolve_test checks one test's parameters and works out the chain it needs.
#
# A PARAMETER NAMING NO FIXTURE IS AN ERROR, reported here and before anything runs, and that
# is what keeps name-matching from being quietly fragile: a renamed fixture, or a misspelled
# parameter, is a sentence with a place rather than a test that silently never ran.
fn resolve_test(fixts: list[Fixt], order: list[str], mut &tests: list[Tst], i: int, mut &errs: list[str]) {
	t := tests[i]
	mut want: list[str] = []
	mut k := 0
	for k < t.pnames.len() {
		if not t.isctx[k] {
			j := fix_index(fixts, t.pnames[k])
			if j < 0 {
				errs.append(f"{t.path}:{t.line}:{t.col}: the test `{t.name}` asks for `{t.pnames[k]}` and no `#[fixture]` of that name is in scope — a test's parameter names a fixture, or is a `testing.Context`")
			} else {
				if fixts[j].produces != t.ptys[k] {
					errs.append(f"{t.path}:{t.line}:{t.col}: the test `{t.name}` declares `{t.pnames[k]}: {t.ptys[k]}` and the fixture `{t.pnames[k]}` produces `{fixts[j].produces}` — a fixture's `use: fn (T)` is what it produces, and the parameter that receives it is declared T")
				}
				add_closure(fixts, j, want)
			}
		}
		k = k + 1
	}

	mut need: list[str] = []
	for nm in order {
		if has_str(want, nm) {
			need.append(nm)
		}
	}
	tests[i] = Tst(t.name, t.path, t.line, t.col, t.pnames, t.ptys, t.isctx, need)
}

# add_closure adds a fixture and everything it is built from. The membership test is also what
# ends it: a circle is reported by fix_order, and this walk must not hang on one before the
# report is printed.
fn add_closure(fixts: list[Fixt], j: int, mut &want: list[str]) {
	return if has_str(want, fixts[j].name)

	want.append(fixts[j].name)
	mut d := 0
	for d < fixts[j].deps.len() {
		k := fix_index(fixts, fixts[j].deps[d])
		if k >= 0 {
			add_closure(fixts, k, want)
		}
		d = d + 1
	}
}

# run_pkg builds one package's test binary and runs it, adding its counts to the run's.
#
# The driver is the LAST file of the entry unit, so the whole package is one scope and a test
# function needs no `pub` to be reachable from it. That is the same arrangement a white-box test
# already has with the module it tests, applied one file further.
fn run_pkg(root: str, p: Pkg, only: str, secs: int, mut &passed: int, mut &failed: int, mut &skipped: int, mut &stuck: int) {
	# `errs` is EMPTY BY THE TIME THIS RUNS and is taken only because plan_pkg has to put its
	# findings somewhere: run_tests planned every package before it ran any of them, and a run
	# holding one unresolved parameter never reaches here at all.
	mut fixts: list[Fixt] = []
	mut tests: list[Tst] = []
	mut errs: list[str] = []
	plan_pkg(root, p, only, fixts, tests, errs)
	return if tests.len() == 0

	mut names: list[str] = []
	mut at: list[str] = []
	for t in tests {
		names.append(t.name)
		at.append(t.path)
	}

	mut own: list[bool] = []
	srcs := pkg_files(root, p, own)

	# THE DRIVER IS A FILE OF THE PACKAGE, written into the package's own directory, because a
	# module is a directory and that is the only thing that puts its declarations in the same
	# scope. A driver in a temp directory is a module of its own, and every test function it
	# calls is then `E301 … is not a public member of module lib` — which would make a `pub` on
	# each test the price of running it, i.e. exactly the test-only backdoor into visibility
	# that docs/runtime/package.md says there is not.
	#
	# Only the BINARY and the report go under the build cache, which is where a build already
	# puts what it made.
	key := pkg_key(p)
	drv := join_path(p.dir, driver_name(p))
	bin := join_path(test_dir(), key + ".bin")
	rep := join_path(test_dir(), key + ".rep")
	sel := join_path(test_dir(), key + ".sel")

	# THE TWO PATHS ARE BAKED INTO THE DRIVER rather than handed to it on the command line,
	# and that is not a preference: `E734 NotImplemented: main(args) in a program that uses
	# concurrency` — a `fn main(args)` and a `spawn` cannot be in one program in this
	# compiler, and the driver now has both. A generated file has no need of an argument
	# anyway: whatever a run would have passed, the run also wrote the file.
	guard {
		io.write_file(drv, bytearray(gen_driver(fixts, tests, rep, sel, secs)))
	}

	mut files: list[str] = []
	mut copies: list[str] = []
	mut k := 0
	for k < srcs.len() {
		if own[k] {
			files.append(srcs[k])
		} else {
			c := join_path(p.dir, f"{INHERITED_PREFIX}{copies.len()}_test.zg")
			guard {
				io.write_file(c, bytearray(read_source(srcs[k])))
			}
			copies.append(c)
			files.append(c)
		}
		k = k + 1
	}
	files.append(drv)

	# THE FILES THIS COMMAND WROTE COME OFF DISK THE MOMENT THEY HAVE BEEN READ, and that one
	# line is what makes the cleanup total rather than best-effort. `load_units_of` reads every
	# source into a `Unit`; everything after it — emit, cc, link, and every diagnostic any of
	# them reports — works from those values and never opens a source again. So the window in
	# which a driver exists on disk is exactly this call, and the only way out of it that is
	# not a return is a raise, which the guard has.
	#
	# It used to be the last thing run_pkg did, which meant every path that did NOT reach the
	# end left the driver behind: `zerg test src/stdlib` stopped at an `E215` inside
	# `atomic.zg` and left a `zerg_test_driver_test.zg` full of absolute cache paths in the
	# standard library — a directory the compiler resolves imports by LISTING.
	res := guard {
		load_units_of(files, p.dir, p.dir)
	}
	rm_file(drv)
	for c in copies {
		rm_file(c)
	}

	lerr := match res {
		Either.Left(_)  => ""
		Either.Right(e) => e.message()
	}
	if lerr != "" {
		io.ewrite(lerr + "\n")
		__zrt_exit(1)
	}
	units := match res {
		Either.Left(u)  => u
		Either.Right(_) => []
	}
	link_units(units, drv, bin, TEST_JOBS)

	mut verdict: list[str] = []
	mut text: list[str] = []
	for n in names {
		verdict.append("")
		text.append("")
	}

	# `broke` is what the driver said about a FIXTURE rather than about a test — the one thing
	# in a run no test's slot can hold. A fixture whose tests all answered for themselves and
	# which then raised on its way out has failed, and it is attributable to nothing else.
	mut broke: list[str] = []

	rm_file(rep)
	rm_file(sel)
	mut argv: list[str] = []
	argv.append(bin)
	__zrt_exec(argv)
	take_records(rep, names, verdict, text, broke)

	# THE FALLBACK. Every test with no record is one the in-process run never got back from,
	# and each is re-run in a process of its own — which is what turns "the run died" into
	# "this test died". `fell` is the first of them, and it is what the report says the
	# strategy changed at: a run that quietly ran half of itself another way is a run whose
	# result nobody can interpret.
	mut fell := -1
	mut i := 0
	for i < names.len() {
		if verdict[i] == "" {
			if fell < 0 {
				fell = i
			}
			run_one(bin, sel, rep, names, i, verdict, text, broke)
		}
		i = i + 1
	}

	report_pkg(names, at, verdict, text, broke, fell, passed, failed, skipped, stuck)

	# the binary and the report belong to THIS run: the next one writes them again from whatever
	# the test files then declare, and a stale one left behind is a test binary that answers for
	# a program nobody has any more. The driver and the inherited copies went above, as soon as
	# they had been read.
	rm_file(rep)
	rm_file(sel)
	rm_file(bin)
}

# run_one runs a single named test in a process of its own — the isolated path, which is the
# only thing that survives a test taking the process with it.
#
# THE NAME TRAVELS IN A FILE for the reason the driver's paths do: the driver cannot read a
# command line (E734), so the one thing that varies between these runs is written where the
# driver looks for it.
fn run_one(bin: str, sel: str, rep: str, names: list[str], i: int, mut &verdict: list[str], mut &text: list[str], mut &broke: list[str]) {
	rm_file(rep)
	guard {
		io.write_file(sel, bytearray(names[i]))
	}
	mut argv: list[str] = []
	argv.append(bin)
	code := __zrt_exec(argv)
	take_records(rep, names, verdict, text, broke)
	return if verdict[i] != ""

	# STILL NO RECORD, so this test is the one that ends processes. The status tells the two
	# un-catchable ways apart, and `os.exit(0)` is the one that needs saying out loud: it
	# leaves exactly the status a passing test does, and only the missing record says it
	# never finished.
	if code == 0 {
		verdict[i] = "fail"
		text[i] = "the test exited before it finished — `os.exit` ends the process, and a test that did not return did not pass\n"
	} else {
		verdict[i] = "crash"
		text[i] = f"the test process died with status {code}\n"
	}
}

# TEST_JOBS is how many units a test build compiles at once. It is `build`'s own default rather
# than a flag: `zerg test --jobs` is a knob for the part of the command nobody is waiting on.
const TEST_JOBS := 4

# TEST_TIMEOUT is how many seconds one test may take before the run stops waiting on it, and
# it is a DEFAULT rather than a constant: `--timeout` moves it, and a suite whose slowest test
# is genuinely slower than this says so on its own command line.
#
# A HUNG TEST AND A SLOW TEST LOOK IDENTICAL until something decides which is which, and with
# nothing deciding, the one that hangs takes the whole run with it — until CI's own timeout
# kills the job, at which point the log says the job was killed and nothing says which test
# did it. Sixty seconds is far above anything a unit test should take and far below any CI
# job limit, which is the whole of what a default here has to be.
const TEST_TIMEOUT := 60

# test_dir is where a test binary and its report are written: a `test` directory under the build
# cache, which is already the place a build puts what it made and which `make clean` already
# takes away. The driver source is the one thing that cannot live here — see run_pkg.
fn test_dir() -> str {
	dir := join_path(cache_dir(), "test")
	__zrt_mkdir(dir)
	return dir
}

# take_records reads whatever the driver managed to write and fills in the tests it named. It
# is called after the in-process run and again after every fallback process, and it only ever
# WRITES a slot it found a record for — so a partial file adds what it has and leaves the rest
# empty, which is the whole signal the fallback runs on.
#
# A NAME IT DOES NOT KNOW IS IGNORED rather than reported, which costs nothing: the driver is
# generated from this same list, so the only way to reach that is a stale file, and a stale
# file is exactly what `rm_file` before each run is for.
fn take_records(path: str, names: list[str], mut &verdict: list[str], mut &text: list[str], mut &broke: list[str]) {
	mut at := -1
	for ln in lines_of(read_or_empty(path)) {
		if has_prefix(ln, "T ") {
			at = name_index(names, drop_tag(ln))
		} else if has_prefix(ln, "F ") {
			# an `F` is about a fixture, so it ends whatever test the lines above were about:
			# nothing that follows belongs to one
			at = -1
			f := drop_tag(ln)
			if not has_str(broke, f) {
				broke.append(f)
			}
		} else if at >= 0 and has_prefix(ln, "V ") {
			verdict[at] = drop_tag(ln)
		} else if at >= 0 and has_prefix(ln, "M ") {
			text[at] = f"{text[at]}{drop_tag(ln)}\n"
		}
	}
}

fn name_index(names: list[str], name: str) -> int {
	mut i := 0
	for i < names.len() {
		return i if names[i] == name
		i = i + 1
	}
	return -1
}

# drop_tag takes the two-character tag off a record line. Everything after it is the payload
# verbatim, spaces and all — a test's message is prose and nothing may trim it.
fn drop_tag(ln: str) -> str {
	b := bytearray(ln)
	mut out: list[byte] = []
	mut i := 2
	for i < b.len() {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn has_prefix(s: str, prefix: str) -> bool {
	b := bytearray(s)
	x := bytearray(prefix)
	return false if x.len() > b.len()

	mut i := 0
	for i < x.len() {
		return false if b[i] != x[i]
		i = i + 1
	}
	return true
}

# lines_of splits text on newlines and drops the empty tail a trailing newline leaves. A
# record file always ends in one, and an empty file is no lines rather than one empty one.
fn lines_of(text: str) -> list[str] {
	b := bytearray(text)
	mut out: list[str] = []
	mut cur: list[byte] = []
	mut i := 0
	for i < b.len() {
		if b[i] == b'\n' {
			out.append(str(cur))
			cur = []
		} else {
			cur.append(b[i])
		}
		i = i + 1
	}
	if cur.len() > 0 {
		out.append(str(cur))
	}
	return out
}

# report_pkg prints one package's results and adds them to the run's counts.
#
# THE REPORT IS PRINTED HERE AND NOT BY THE DRIVER, which is what lets one format serve both
# paths: the in-process run and the fallback processes write the same records, and a reader
# cannot tell from a line which way it was produced — except where it is told, which is the
# one line that says the strategy changed.
fn report_pkg(names: list[str], at: list[str], verdict: list[str], text: list[str], broke: list[str], fell: int, mut &passed: int, mut &failed: int, mut &skipped: int, mut &stuck: int) {
	mut seen := ""
	mut i := 0
	for i < names.len() {
		if at[i] != seen {
			seen = at[i]
			io.println(seen)
		}
		if i == fell {
			io.println("  NOTE  the in-process run ended here — the tests below ran one process each")
		}
		v := verdict[i]
		if v == "ok" {
			io.println("  ok    " + names[i])
			passed = passed + 1
		} else if v == "skip" {
			# a skip's reason goes ON the line: it is one short phrase, and a reader
			# scanning for what did not run wants it beside the name rather than under it
			io.println(f"  SKIP  {pad_name(names[i])}{first_line(text[i])}")
			skipped = skipped + 1
		} else {
			io.println(f"  {verdict_word(v)} {names[i]}")
			for ln in lines_of(text[i]) {
				io.println("        " + ln)
			}

			# A TIMEOUT IS ITS OWN VERDICT and is counted apart, because it is not a failed
			# assertion: nothing was checked and nothing was claimed, the test simply never
			# came back. A runner that reported it FAIL would send the reader looking for an
			# assertion that does not exist.
			if v == "timeout" {
				stuck = stuck + 1
			} else {
				failed = failed + 1
			}
		}
		i = i + 1
	}

	# A FIXTURE THAT FAILED WITH NOTHING LEFT TO BLAME IT ON is still a failure, and it is
	# printed last because that is when it happened: the tests under it had each already
	# answered for themselves, and what broke was the teardown on the way out.
	for b in broke {
		io.println(f"  FAIL  {b}")
		failed = failed + 1
	}
}

# verdict_word is the six-character column every verdict is printed in, so the names line up
# whatever happened to the test above.
fn verdict_word(v: str) -> str {
	return "CRASH" if v == "crash"
	return "STUCK" if v == "timeout"

	return "FAIL "
}

# pad_name puts a skip's reason in a column, and keeps two spaces between the two whatever the
# name's length — a name longer than the column would otherwise run straight into its reason
# and make one word out of two.
fn pad_name(name: str) -> str {
	mut out := name + "  "
	for bytearray(out).len() < NAME_COLUMN {
		out = out + " "
	}
	return out
}

const NAME_COLUMN := 23

fn first_line(text: str) -> str {
	for ln in lines_of(text) {
		return ln
	}
	return ""
}

fn read_or_empty(path: str) -> str {
	mut out := ""
	guard {
		out = str(io.read_file(path))
	}
	return out
}

# rm_file removes a path this command made, and says nothing when it was not there — every
# caller wants "make sure this is gone" rather than "delete exactly this".
fn rm_file(path: str) {
	guard {
		__zrt_remove(path)
	}
}

# gen_driver writes the driver source for one package: the fixed half below, one trio of
# functions per test, and the NESTING that stands the fixtures up around them.
#
# It is GENERATED rather than fixed because the only part that varies is the tests and what
# they asked for, and a fixed driver reading them from somewhere would need the names to exist
# as data at runtime — which means a table the compiler emits, which is this file written by
# another route. Written out, the calls are ordinary calls in the package's own scope and the
# compiler checks every one of them: a `#[test]` with a parameter this runner does not know is
# a compile error naming the function, not a runner that skips it.
#
# THE NESTING IS THE WHOLE MECHANISM. A test's chain — its fixtures, dependencies first — is a
# path, and the paths of a package's tests form a tree. The tree is written out as nested
# calls, so:
#
#   a fixture is built ONCE for every test under it, because the call is written once
#   a dependency is standing before its dependent, because it is written outside it
#   teardown runs in reverse, because an inner `defer` fires first
#   a level nobody needs is NEVER WRITTEN, because no test's path went through it
#
# and none of those four is a rule this file enforces at runtime — each is a consequence of
# where the text was put. There is no topological sort in the driver and no teardown registry.
#
# THE CLOSURE BODIES ARE ONE CALL EACH, and that is not a style: `E735 a closure captures
# `io`, and this compiler cannot work out what it holds` — a lambda may not reach a module
# namespace, so anything a level does that touches `io` or `testing` has to be in a top-level
# function. Each level is one, and the closure passed to a fixture only ever calls it.
fn gen_driver(fixts: list[Fixt], tests: list[Tst], report: str, chosen: str, secs: int) -> str {
	mut out := "# Generated by `zerg test` for one run, and removed when that run ends. Not a source to\n"
	out = out + "# edit: the next run writes it again from whatever the test files then declare.\n"
	out = out + "import (\n\t\"io\"\n\t\"testing\"\n)\n\n"

	out = out + "const ZT_REPORT := \"" + report + "\"\n"
	out = out + "const ZT_SELECT := \"" + chosen + "\"\n"
	out = out + "const ZT_TIMEOUT := " + f"{secs}" + " * 1000000000\n"
	out = out + "const ZT_STUCK := \"the test did not finish within " + f"{secs}" + "s — nothing was decided, so this is not a failed assertion; raise the limit with `zerg test --timeout`\"\n\n"

	out = out + driver_body()

	mut i := 0
	for i < tests.len() {
		out = out + gen_test(tests[i], i)
		i = i + 1
	}

	mut idxs: list[int] = []
	mut k := 0
	for k < tests.len() {
		idxs.append(k)
		k = k + 1
	}

	mut defs := ""
	mut seq := 0
	mut path: list[str] = []
	body := gen_level(fixts, tests, idxs, path, defs, seq)

	return out + defs + "fn main() {\n" + body + "}\n"
}

# gen_test writes the three functions one test needs: the body the coroutine runs, the start
# that spawns it and hands back the receiving end, and the run that decides whether this
# process is the one to run it.
#
# THE CALL IS WRITTEN TO THE SIGNATURE, in the order the test declared its parameters: the
# `testing.Context` goes where its type stands and each fixture value where its name does. So
# `fn t()`, `fn t(ctx: testing.Context)` and `fn t(db: Conn, ctx: testing.Context)` are all
# ordinary declarations and the generated call is whichever one of them was written.
fn gen_test(t: Tst, i: int) -> str {
	n := f"{i}"
	ps := test_params(t)
	ar := test_args(t)
	mut psc := ps
	mut arc := ar
	if ps != "" {
		psc = ps + ", "
		arc = ar + ", "
	}

	mut out := "fn zt_body" + n + "(" + psc + "zt_ch: chan[testing.Event]) {\n"
	out = out + "\tzt_ctx := testing.context(\"" + t.name + "\", zt_ch)\n"
	out = out + "\tzt_r := guard {\n\t\t" + test_call(t) + "\n\t}\n"
	out = out + "\tzt_ok := match zt_r {\n\t\tEither.Left(_)  => true\n\t\tEither.Right(_) => false\n\t}\n"
	out = out + "\tzt_why := match zt_r {\n\t\tEither.Left(_)  => \"\"\n\t\tEither.Right(e) => e.message()\n\t}\n"

	# WHETHER THE BODY ENDED ON A CLAIM OR ON A CRASH, asked HERE because here is where the
	# Err still exists. `assert` raises AssertionError and nothing else does, so `is` answers
	# it exactly; one line further on there is only a message, and a runner that told a
	# failed test from a fallen-over one by matching text would be reading prose as a
	# protocol — which is the whole reason the kind was added.
	out = out + "\tzt_claim := match zt_r {\n\t\tEither.Left(_)  => false\n\t\tEither.Right(e) => e is AssertionError\n\t}\n"
	out = out + "\ttesting.finished(zt_ctx, zt_ok, zt_why, zt_claim)\n}\n\n"

	out = out + "fn zt_start" + n + "(" + ps + ") -> <-chan[testing.Event] {\n"
	out = out + "\tzt_ch := chan[testing.Event]()\n\tspawn zt_body" + n + "(" + arc + "zt_ch)\n\n\treturn zt_ch\n}\n\n"

	out = out + "fn zt_run" + n + "(" + ps + ") {\n"
	out = out + "\treturn if not zt_want(\"" + t.name + "\")\n\n"
	out = out + "\tzt_emit(\"" + t.name + "\", zt_await(zt_start" + n + "(" + ar + ")))\n}\n\n"
	return out
}

# test_params / test_args are the fixture values one test takes, as a parameter list and as
# the arguments that fill it. The context is not among them: it is made inside the body, one
# per test, which is what makes `ctx.name()` answer this test's own name.
fn test_params(t: Tst) -> str {
	mut out := ""
	mut m := 0
	mut k := 0
	for k < t.pnames.len() {
		if not t.isctx[k] {
			if out != "" {
				out = out + ", "
			}
			out = out + f"zt_p{m}: {t.ptys[k]}"
			m = m + 1
		}
		k = k + 1
	}
	return out
}

fn test_args(t: Tst) -> str {
	mut out := ""
	mut m := 0
	mut k := 0
	for k < t.pnames.len() {
		if not t.isctx[k] {
			if out != "" {
				out = out + ", "
			}
			out = out + f"zt_p{m}"
			m = m + 1
		}
		k = k + 1
	}
	return out
}

fn test_call(t: Tst) -> str {
	mut args := ""
	mut m := 0
	mut k := 0
	for k < t.pnames.len() {
		if args != "" {
			args = args + ", "
		}
		if t.isctx[k] {
			args = args + "zt_ctx"
		} else {
			args = args + f"zt_p{m}"
			m = m + 1
		}
		k = k + 1
	}
	return f"{t.name}({args})"
}

# gen_level writes the body of one level of the nesting: the tests whose chain ends here, and
# a block for each fixture the tests below it go through.
#
# The order is FIRST APPEARANCE, so a package's tests are stood up in the order they were
# written as far as the tree allows. Which order they RUN in does not decide the order they
# are REPORTED in — the report walks the declarations and looks each verdict up by name — so
# the nesting is free to group them.
fn gen_level(fixts: list[Fixt], tests: list[Tst], idxs: list[int], path: list[str], mut &defs: str, mut &seq: int) -> str {
	mut body := ""
	mut done: list[str] = []
	mut a := 0
	for a < idxs.len() {
		ti := idxs[a]
		if tests[ti].need.len() == path.len() {
			body = body + run_call(tests[ti], ti, path)
		} else {
			f := tests[ti].need[path.len()]
			if not has_str(done, f) {
				done.append(f)
				mut sub: list[int] = []
				mut b := 0
				for b < idxs.len() {
					tj := idxs[b]
					if tests[tj].need.len() > path.len() and tests[tj].need[path.len()] == f {
						sub.append(tj)
					}
					b = b + 1
				}
				body = body + gen_fixture(fixts, tests, sub, path, f, defs, seq)
			}
		}
		a = a + 1
	}
	return body
}

# gen_fixture writes one level: the guarded call that builds the fixture, the closure that is
# everything below it, and the two functions that decide whether to enter it and what to say
# when it does not hold.
#
# THE CALL IS GUARDED, and what the guard is for is the owner's decision that a fixture which
# cannot be built makes every test needing it FAIL. A test that could not run must never look
# like one that passed, so the failure is written into each of their slots by name — see
# gen_blame.
fn gen_fixture(fixts: list[Fixt], tests: list[Tst], sub: list[int], path: list[str], name: str, mut &defs: str, mut &seq: int) -> str {
	seq = seq + 1

	id := f"{seq}"
	fi := fix_index(fixts, name)
	depth := path.len()

	mut npath := path
	npath.append(name)

	inner := gen_level(fixts, tests, sub, npath, defs, seq)

	defs = defs + "fn zt_lv" + id + "(" + level_params(fixts, npath) + ") {\n" + inner + "}\n\n"
	defs = defs + gen_need(id, tests, sub)
	defs = defs + gen_blame(id, name, tests, sub)

	call := name + "(" + dep_args(fixts, fi, path) + "fn (zt_v: " + fixts[fi].produces + ") { zt_lv" + id + "(" + level_call_args(depth) + ") })"

	mut out := "\tif zt_need" + id + "() {\n"
	out = out + "\t\tzt_r" + id + " := guard {\n\t\t\t" + call + "\n\t\t}\n"
	out = out + "\t\tzt_bad" + id + " := match zt_r" + id + " {\n\t\t\tEither.Left(_)  => false\n\t\t\tEither.Right(_) => true\n\t\t}\n"
	out = out + "\t\tzt_why" + id + " := match zt_r" + id + " {\n\t\t\tEither.Left(_)  => \"\"\n\t\t\tEither.Right(e) => e.message()\n\t\t}\n"
	out = out + "\t\tzt_blame" + id + "(zt_bad" + id + ", zt_why" + id + ")\n"
	out = out + "\t}\n"
	return out
}

# run_call is a test's call at the level its chain ends on. Its arguments are the fixture
# values its own parameters NAME — which is a subset of the chain, since a chain also holds
# what those fixtures were built from.
fn run_call(t: Tst, i: int, path: list[str]) -> str {
	mut args := ""
	mut k := 0
	for k < t.pnames.len() {
		if not t.isctx[k] {
			if args != "" {
				args = args + ", "
			}
			args = args + f"zt_f{path_index(path, t.pnames[k])}"
		}
		k = k + 1
	}
	return f"\tzt_run{i}({args})\n"
}

# level_params is the parameter list of a level function: every fixture value standing at that
# point, in the order they were built. level_call_args is how the closure calls it — the outer
# values by their slot, and the one this level just made under the name the closure bound.
fn level_params(fixts: list[Fixt], path: list[str]) -> str {
	mut out := ""
	mut i := 0
	for i < path.len() {
		if out != "" {
			out = out + ", "
		}
		out = out + f"zt_f{i}: {fixts[fix_index(fixts, path[i])].produces}"
		i = i + 1
	}
	return out
}

fn level_call_args(depth: int) -> str {
	mut out := ""
	mut i := 0
	for i < depth {
		out = out + f"zt_f{i}, "
		i = i + 1
	}
	return out + "zt_v"
}

# dep_args fills a fixture's own parameters from the values already standing. Every dependency
# is on the path and was built earlier — that is what fix_order's ordering guarantees — so
# each one is a slot number. The trailing separator is here because a closure always follows.
fn dep_args(fixts: list[Fixt], fi: int, path: list[str]) -> str {
	mut out := ""
	mut d := 0
	for d < fixts[fi].deps.len() {
		out = out + f"zt_f{path_index(path, fixts[fi].deps[d])}, "
		d = d + 1
	}
	return out
}

fn path_index(path: list[str], name: str) -> int {
	mut i := 0
	for i < path.len() {
		return i if path[i] == name
		i = i + 1
	}
	return 0
}

# gen_need is what makes "only when needed" true of the FALLBACK too. The in-process run wants
# every test, so every level is entered; a fallback process wants exactly one, and a level is
# entered only when that one is somewhere below it. So a re-run rebuilds the fixtures the test
# it is re-running needs, and builds no others.
fn gen_need(id: str, tests: list[Tst], sub: list[int]) -> str {
	mut out := "fn zt_need" + id + "() -> bool {\n\tzt_one := zt_get(ZT_SELECT)\n\treturn true if zt_one == \"\"\n\n"
	for j in sub {
		out = out + "\treturn true if zt_one == \"" + tests[j].name + "\"\n"
	}
	return out + "\n\treturn false\n}\n\n"
}

# gen_blame is what a fixture's failure costs. Every test under it that was WANTED and has no
# record yet is failed by name, carrying the reason — a test that could not run must never
# look like one that passed, and it must not look like one nobody asked for either.
#
# "HAS NO RECORD YET" IS ALSO WHAT TELLS SETUP FROM TEARDOWN. The tests run INSIDE the call
# this guard is around, so a raise reaching it may have come from before `use` or from after
# it. If every test under it already answered for itself, the failure is the teardown's, and
# it is recorded against the fixture rather than against anybody's test.
fn gen_blame(id: str, name: str, tests: list[Tst], sub: list[int]) -> str {
	mut out := "fn zt_blame" + id + "(zt_bad: bool, zt_why: str) {\n\treturn if not zt_bad\n\n\tmut zt_any := false\n"
	for j in sub {
		nm := tests[j].name
		out = out + "\tif zt_want(\"" + nm + "\") and not zt_has(\"" + nm + "\") {\n"
		out = out + "\t\tzt_fail(\"" + nm + "\", \"fixture `" + name + "` could not be built: \" + zt_why)\n"
		out = out + "\t\tzt_any = true\n\t}\n"
	}
	return out + "\tif not zt_any {\n\t\tzt_broke(\"" + name + "\", zt_why)\n\t}\n}\n\n"
}

# driver_body is the half of the driver that does not vary. It is a text constant and not a
# module of the standard library, because a test driver is not something a program imports: it
# exists for the length of one run, in the package's own scope, and the only reader it ever has
# is the compiler that was handed it a moment earlier. What IS in the standard library is
# everything a test can see — `testing.Context` and the events it sends — because that half is
# something a person writes against.
#
# THE REPORT IS APPENDED TO, NOT ACCUMULATED, and that is the fixtures' doing: an accumulator
# would have to be a variable the nesting carried down through its closures, and a closure
# captures by value. So each record is a read of the file and a write of it with one record
# more — which keeps the property the fallback runs on, that a run cut short leaves exactly
# the records of the tests that finished.
#
# THE DEADLINE IS A TIMER AND A `select`, which is the whole of the mechanism: a test runs in
# a coroutine already, so waiting for it with a limit is one more receive arm. `testing.collect`
# is the function that drains a test's channel, and it is moved onto a coroutine of its own so
# that the arm can race it — rather than a second copy of the event folding written here with a
# deadline in it, which would be the same rule in two places.
#
# THE TIMER IS WRITTEN HERE AND NOT IMPORTED from `time`, even though `time.after` is exactly
# this. A driver's imports land in the package's namespace, and `E705` refuses two modules
# defining one `pub` name — so importing `time` would make a package that declares its own
# `after`, `now` or `ticker` stop compiling the moment it grew a test. Everything the driver
# declares is `zt_`-prefixed for that reason, and the timer is four lines over the same runtime
# leaf `time.after` is written over.
#
# THE COST IS A COROUTINE PER TEST, and it outlives the test: nothing cancels a sleep, so a
# timer for a test that finished at once still holds its stack until its deadline passes. That
# is the same cost `time.after` carries and the reason it is one timer per test rather than one
# per assertion.
fn driver_body() -> str {
	return "fn zt_timer(zt_out: chan[int]<-, zt_d: int) {\n\t__zrt_sleep_ns(zt_d)\n\tzt_out <- 1\n}\n\n" +
		"fn zt_after(zt_d: int) -> <-chan[int] {\n\tzt_ch := chan[int](1)\n\tspawn zt_timer(zt_ch, zt_d)\n\n\treturn zt_ch\n}\n\n" +
		"fn zt_collect(zt_rx: <-chan[testing.Event], zt_out: chan[testing.Outcome]<-) {\n\tzt_out <- testing.collect(zt_rx)\n}\n\n" +
		"fn zt_await(zt_rx: <-chan[testing.Event]) -> testing.Outcome {\n\tzt_oc := chan[testing.Outcome](1)\n\tspawn zt_collect(zt_rx, zt_oc)\n\n" +
		"\tfor select {\n\t\tzt_v := <-zt_oc => return zt_v\n\n\t\t<-zt_after(ZT_TIMEOUT) => return testing.Outcome(\"timeout\", ZT_STUCK)\n\t}\n\n" +
		"\treturn testing.Outcome(\"timeout\", ZT_STUCK)\n}\n\n" +
		"fn zt_get(path: str) -> str {\n\tmut out := \"\"\n\tguard {\n\t\tout = str(io.read_file(path))\n\t}\n\treturn out\n}\n\n" +
		"fn zt_put(path: str, text: str) {\n\tguard {\n\t\tio.write_file(path, bytearray(text))\n\t}\n}\n\n" +
		"fn zt_append(rec: str) {\n\tzt_put(ZT_REPORT, zt_get(ZT_REPORT) + rec)\n}\n\n" +
		"fn zt_want(name: str) -> bool {\n\tone := zt_get(ZT_SELECT)\n\treturn true if one == \"\"\n\n\treturn one == name\n}\n\n" +
		"fn zt_has(name: str) -> bool {\n\ttag := \"T \" + name\n\tb := bytearray(zt_get(ZT_REPORT))\n" +
		"\tmut cur: list[byte] = []\n\tmut i := 0\n\tfor i < b.len() {\n" +
		"\t\tif b[i] == b'\\n' {\n\t\t\treturn true if str(cur) == tag\n\t\t\tcur = []\n" +
		"\t\t} else {\n\t\t\tcur.append(b[i])\n\t\t}\n\t\ti = i + 1\n\t}\n\treturn false\n}\n\n" +
		"fn zt_msg(text: str) -> str {\n\tb := bytearray(text)\n\tmut out := \"\"\n\tmut cur: list[byte] = []\n\tmut i := 0\n" +
		"\tfor i < b.len() {\n\t\tif b[i] == b'\\n' {\n\t\t\tout = out + \"M \" + str(cur) + \"\\n\"\n\t\t\tcur = []\n" +
		"\t\t} else {\n\t\t\tcur.append(b[i])\n\t\t}\n\t\ti = i + 1\n\t}\n" +
		"\tif cur.len() > 0 {\n\t\tout = out + \"M \" + str(cur) + \"\\n\"\n\t}\n\treturn out\n}\n\n" +
		"fn zt_flat(text: str) -> str {\n\tb := bytearray(text)\n\tmut out: list[byte] = []\n\tmut i := 0\n" +
		"\tfor i < b.len() {\n\t\tif b[i] == b'\\n' {\n\t\t\tout.append(b' ')\n\t\t} else {\n\t\t\tout.append(b[i])\n\t\t}\n\t\ti = i + 1\n\t}\n\treturn str(out)\n}\n\n" +
		"fn zt_emit(name: str, oc: testing.Outcome) {\n\tzt_append(\"T \" + name + \"\\nV \" + oc.verdict + \"\\n\" + zt_msg(oc.text))\n}\n\n" +
		"fn zt_fail(name: str, why: str) {\n\tzt_append(\"T \" + name + \"\\nV fail\\n\" + zt_msg(why))\n}\n\n" +
		"fn zt_broke(name: str, why: str) {\n\tzt_append(\"F fixture `\" + name + \"` raised with every test under it already answered for — a teardown that fails is still a failure: \" + zt_flat(why) + \"\\n\")\n}\n\n"
}

# --- fmt / lint ------------------------------------------------------------------------

# run_fmt rewrites each named file in place. Reading and writing the same path means a
# formatted file is byte-identical to what it was, so running fmt twice is a no-op.
fn run_fmt(files: list[str], off: list[str]) {
	for f in files {
		src := read_source(f)

		# fmt works on the TOKEN STREAM, not the tree, so it will reformat anything that
		# lexes — including a file with a syntax error, silently, exit 0. `fn main( {` came
		# back as `fn main({` and `print("hi")` as `print ("hi")`: the tokens survive, but
		# the spacing rules are applied to a shape they cannot mean anything about, so the
		# user's broken file comes back broken AND misformatted, with nothing said.
		#
		# The gate is NOT `parse`. A formatter has to work on source the compiler cannot
		# COMPILE — that is exactly when a person reaches for one — and this parser refuses
		# 26 forms the language has and this compiler has not built, `src/stdlib/testing.zg`
		# among them. Balance is what fmt's own rules actually depend on; see fmt_balanced.
		raise f"`{f}` has unbalanced brackets, so it cannot be formatted — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.fmt_src_off(src, off)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# run_fmt_check answers the question a CI job asks — is this tree already canonical — and
# answers it without touching anything. Before it existed `make fmt-corpus` did the same
# thing by copying each case to a temp file, formatting the copy and running `cmp`: the
# tool knew the answer and had no way to say it, so the Makefile reimplemented it in
# shell. A formatter that cannot be asked is a formatter every CI reinvents.
fn run_fmt_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := read_source(f)
		if not zerg.fmt_balanced(src) {
			io.ewrite(f"{f}: unbalanced brackets, so it cannot be formatted\n")
			bad = bad + 1
		} else if zerg.fmt_src_off(src, off) != src {
			io.ewrite(f"{f}: not in canonical form (run `zerg fmt`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}

# run_desugar rewrites each source into the core forms its sugar is defined as. It is
# `run_fmt` with the other pass, down to the bracket gate: desugar reads the same token
# stream from the same lexer, so a file whose brackets do not close is one it would rewrite
# from a shape that means nothing.
#
# It writes IN PLACE, like `zerg fmt`, because the thing that runs it is a gate over a
# whole tree rather than a person over one file — `make desugar` copies the corpus and
# desugars the copy. Undoing the sugar in a source somebody is keeping is not what this is
# for, and the docs say so.
fn run_desugar(files: list[str], off: list[str]) {
	for f in files {
		src := read_source(f)
		raise f"`{f}` has unbalanced brackets, so it cannot be desugared — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.desugar_src_off(src, off, f)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# run_desugar_check is the question `make desugar`'s fixpoint gate asks: is there any sugar
# left in this file. A desugared source that desugars again to something else would mean
# one of these rules produces what another one rewrites, which is the one way a pass like
# this can be wrong without any program behaving differently.
fn run_desugar_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := read_source(f)
		if not zerg.fmt_balanced(src) {
			io.ewrite(f"{f}: unbalanced brackets, so it cannot be desugared\n")
			bad = bad + 1
		} else if zerg.desugar_src_off(src, off, f) != src {
			io.ewrite(f"{f}: still holds sugar (run `zerg desugar`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}

# run_lint reports every finding in the loaded program and RETURNS a nonzero status when
# there is one, so `zerg lint` can gate a build rather than merely inform. It returns the
# status rather than exiting on it because a sub-command's function is what decides the
# process's exit, and it is the only thing that knows what the finding meant.
#
# THE SEVERITIES DECIDE THE STATUS, and there are two answers rather than one. A FINDING
# fails, always: a rule fired on the program. A WARNING prints and does not, because what it
# reports is legal — a `#[test]` that ships is a decision somebody may have made on purpose —
# and `strict` is what turns those into failures for a caller that has decided otherwise.
# `make lint`, over this project's own source, is that caller. INFO never fails anything.
fn run_lint(files: list[str], strict: bool) -> int {
	mut paths: list[str] = []
	srcs := load_sources_at(files, paths)

	mut bad := 0
	mut warned := 0
	for f in zerg.lint_program(srcs, paths) {
		io.write(f"{f.path}:{f.line}:{f.col}: {lint_sev(f)}{f.code} {f.msg}\n")
		if f.sev == "" {
			bad = bad + 1
		} else if f.sev == "warning" {
			warned = warned + 1
		}
	}

	return 1 if bad > 0
	return 1 if strict and warned > 0

	return 0
}

# lint_sev is the adjective a finding's line opens with, and the empty string for the default
# — see lint.zg's header for why only two of the three are named out loud.
fn lint_sev(f: zerg.Finding) -> str {
	return "" if f.sev == ""

	return f"{f.sev}: "
}
