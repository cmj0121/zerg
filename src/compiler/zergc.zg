# zergc — the self-hosting Zerg compiler driver.
#
# Wires the `zerg` compiler library to the command line. `zergc tokens <file>` prints the
# token stream (M1, diff-tested against `zerg build --emit tokens`); `zergc c <file>...`
# (or just `zergc <file>...`) prints the emitted C for one or more sources merged into one
# translation unit (a flattened module and its imported modules), validated by cc + run
# against the bootstrap build.
import "zerg"
import "io"

fn main(args: list[str]) {
	if args.len() < 1 {
		print "usage: zergc [tokens|c] <file.zg> [more.zg ...]"
		return
	}
	mut mode := "c"
	mut start := 0
	if args[0] == "tokens" or args[0] == "c" {
		mode = args[0]
		start = 1
	}
	mut srcs: list[str] = []
	mut i := start
	for i < args.len() {
		srcs.append(str(io.read_file(args[i])))
		i = i + 1
	}
	guard {
		if mode == "tokens" {
			io.write(zerg.dump_tokens(srcs[0]))
		} else {
			io.write(zerg.emit_files(srcs))
		}
	}
}
