	NotYetListMethod = 444
	NotYetContainerEquality = 445
	NotYetRefBox = 446
	NotYetRenderAsText = 449
	MethodDeclaredTwice = 451
	ByValueCycle = 452
	MemberDeclaredTwice = 453
	ChainTooDeep = 454
	ScalarConvOfNonScalar = 455
	NotAVariantOf = 456
	VariantOfOtherEnum = 457
	CatchAllNotLast = 458
	EitherSideUndeclared = 459
	IdentityHasNoEquality = 460
	NotYetSecondIntoImpl = 461
	NotYetInOverNoEq = 462
	NotYetInOverType = 463
	IntoNotBuiltIn = 464
	NotYetFixedWidthLadder = 465
	NotYetSetBuiltin = 466
	MatchMissingCatchAll = 467
	ReturnWithoutValue = 468
	NotYetFnValueMutRef = 469
	NotYetDelChannel = 470
	NotYetGenericConstructor = 471
	NotYetNilPattern = 472
	OptionalCompare = 473
	DiscriminantNotConstant = 474
	FillCountNotConstant = 475
	FillCountNegative = 476
	RangeArmBoundNotConstant = 477
	NotAChannel = 478
	MapEntryNoColon = 479
	NotYetValueUnnameableType = 480
	NotYetRebindMatchBinding = 481
	PrivateFieldNeedsDefault = 482
	NotYetDefaultReadsField = 483
	PubMutGlobal = 484
	ImportCycle = 485
	NotYetDestructuringAssign = 486
	DecoratorOnNonType = 487
	NotYetUnsafeFnType = 488
	NotYetImplDottedTarget = 489
	ImplSpecNotBare = 490
	NotYetGenericTypedef = 491
	NotYetSubPatternInPayload = 492
	NotYetRangeAsValue = 493
	NotYetIsErrorKind = 494
	DecoratorEmpty = 495
	NotYetSealed = 496
	DeriveNamesNoSpec = 497
	ChanDirectionForm = 498
	EitherBareValue = 701
	NoSuchFieldInChain = 702
	NotYetTryOnType = 703
	TryRightUnanswered = 704
	NotYetTwoModulesDefine = 705
	NotYetNamespaceCollision = 706
	NoSuchType = 707
	NotYetForceOnType = 708
	NotYetCoalesceOnType = 709
	IsWantsErr = 710
	InWantsErr = 711
	ListConvOfNonStr = 712
	ListConvElementType = 713
	NotYetRenderEnumAsText = 714
	IndexOfNonContainer = 715
	NotYetErrMethodArgs = 716
	NotYetErrMethod = 717
	NotYetOkOrNoArg = 718
	NotYetOkOrManyArgs = 719
	NotYetOkOrNotErr = 720
	NotYetOkTakesNoArg = 721
	NotYetCarrierMethod = 722
	NotYetEnumTypeMethod = 723
