# generic — monomorphization (docs/core/specs.md, GRAMMAR group 6).
#
# A generic function is a TEMPLATE, not a function. Nothing is emitted for the declaration
# itself; what reaches C is one specialization per distinct set of type arguments some call
# site asks for. C has no generics, and erasing to a common representation would need a
# uniform boxed value — which this language does not have, because a `list[int]` is int64s
# and not pointers.
#
# The whole pass is an AST-to-AST substitution: `subst_fn` copies the template with each
# type parameter replaced, and what comes back is an ORDINARY FnDecl. Everything downstream
# — the checker, the emitter, the name mangler, the copy and drop rules — handles it with no
# knowledge that a generic was ever involved. That is the point of doing it here and not
# later: a type parameter that survives into lowering is a type the C backend has no width
# for, and every pass would need an opinion about it.
#
# The type ARGUMENTS are not written at the call site. They are solved from the argument
# types by matching the template's declared parameter types against them, which is what
# makes `assert_eq(1, 1)` legal without spelling `assert_eq[int]`.

# gen_ty_key is a type as a name fragment, and it has to tell ANY two distinct types apart —
# a key that collides hands the second call the first's specialization, which is the wrong
# function body with no diagnostic anywhere.
#
# So the encoding is INJECTIVE, and getting there took two tries. Dropping what cannot be
# spelled maps `list[int]` and a type named `listint` together; replacing each such byte with
# `_` maps `Foo?` and a type named `Foo_` together. What works is escaping: `_` doubles, and
# every other byte becomes `_<hex>_`, so the escape character can never be confused with
# itself and two distinct `ty_name`s can never meet.

import (
	"strconv"

	"./ast"
	"./emit"
	"./lexer"
)
fn gen_ty_key(t: ast.Ty) -> str {
	mut out := ""
	for b in bytearray(ast.ty_name(t)) {
		out = out + gen_key_byte(b)
	}
	return out
}

fn gen_key_byte(b: byte) -> str {
	return "__" if b == b'_'
	return f"_{strconv.to_string(int(b), 16)}_" if not lexer.is_ident(b)

	mut one: list[byte] = []
	one.append(b)
	return str(one)
}

# gen_mangle is the C-visible name of one specialization. The type arguments go into the
# name because they are what distinguishes it: two instantiations of one template are two
# functions, and a name that dropped them would collide the moment a program used both.
#
# `$` is not legal in a Zerg identifier, so a mangled name cannot collide with one a
# program declares. It is mapped to `_` on the way into C, which does not accept it either.
pub fn gen_mangle(name: str, args: list[ast.Ty]) -> str {
	mut out := name
	for a in args {
		out = out + "$" + gen_ty_key(a)
	}
	return out
}

# gen_solve works out what each type parameter must be, from the types the call actually
# passes. It matches each declared parameter type against the argument's type STRUCTURALLY,
# so a `list[T]` parameter given a `list[int]` solves T, not only a bare `T`.
#
# An unsolved parameter answers TUnknown, and the caller reports it: a type argument that
# cannot be worked out is a call that has not said what it means, and guessing `int` would
# make the program compile as something nobody wrote.
pub fn gen_solve(tparams: list[str], decls: list[ast.Ty], actuals: list[ast.Ty]) -> list[ast.Ty] {
	mut sol: list[ast.Ty] = []
	for n in tparams {
		sol.append(ast.Ty.TUnknown)
	}
	mut i := 0
	for i < decls.len() and i < actuals.len() {
		gen_match(tparams, sol, decls[i], actuals[i])
		i = i + 1
	}
	return sol
}

# gen_match walks a declared type and an actual one together, recording a binding wherever
# the declared side is a type parameter. The FIRST binding wins: `f(a: T, b: T)` given an
# int and a str takes int, and the mismatch is then reported by the ordinary argument rule
# against the specialization's own signature — which says `b: int` and means it.
fn gen_match(tparams: list[str], mut &sol: list[ast.Ty], decl: ast.Ty, actual: ast.Ty) {
	nm := emit.c_named_of(decl)
	if nm != "" and emit.c_name_in(tparams, nm) {
		mut i := 0
		for i < tparams.len() {
			if tparams[i] == nm and emit.c_is_unknown(sol[i]) {
				sol[i] = actual
				return
			}
			i = i + 1
		}
		return
	}
	gen_match_inner(tparams, sol, decl, actual)
}

# gen_match_inner is the structural half: a container's element, a carrier's payload, a
# map's two sides, a function type's parameters and its result. Both types are taken APART
# the same way and their parts matched by POSITION.
#
# ASKING ONE READER TWICE is what keeps this small. It was a dispatch on the declaration's
# shape with a second, nested match on the actual inside a helper per shape — two idioms for
# one question, and the second is what dragged in a `gen_match_two`, a `gen_match_fnparts`
# and a nop of its own. Eleven functions did what four do.
#
# A shape that does not line up simply binds nothing, because two part lists of different
# lengths stop at the shorter — which is what the argument rule downstream is there to
# report, against a signature that by then has real types in it.
fn gen_match_inner(tparams: list[str], mut &sol: list[ast.Ty], decl: ast.Ty, actual: ast.Ty) {
	gen_match_all(tparams, sol, gen_parts(decl), gen_parts(actual))
}

# gen_parts is a type's SUB-TYPES, in written order — the one place this file knows how a
# type is built out of others. A scalar has none, and so does a name: a `TNamed` reaching
# here is a struct or an enum, whose fields are not the type's arguments.
#
# FOUR SHAPES WERE MISSING, and every one of them was added to `Ty` after this was written:
# the array, the `mut &`, the raw pointer and the `unsafe` marker. What falls out of that is a
# refusal whose sentence is FALSE — `fn first[T](xs: [T; 2])` was told *the type parameter `T`
# is not decided by this call: no argument's type mentions it*, about an argument whose type
# says `T` in plain sight. A catch-all is what let each of them arrive silently; the arms are
# written out for the reason `expr_parts` writes its out.
#
# AN ARRAY'S LENGTH IS NOT A PART. It is part of the type and not a type, so it takes no arm
# here — two arrays of different lengths bind their element the same way, and the mismatch is
# reported by the ordinary argument rule against the specialization's own signature.
fn gen_parts(t: ast.Ty) -> list[ast.Ty] {
	return match t {
		Ty.TList(e) => [e]
		Ty.TOpt(e) => [e]
		Ty.TChan(e, d) => [e]
		Ty.TMap(k, v) => [k, v]
		Ty.TTuple(es) => es
		Ty.TEither(x, y) => [x, y]
		Ty.TArr(e, n) => [e]
		Ty.TRef(e) => [e]
		Ty.TPtr(e) => [e]
		Ty.TUnsafe(e) => [e]
		Ty.TFn(ps, r) => gen_fn_parts(ps, r)
		_ => []
	}
}

# a function type's parts are its parameters and then its result, which is the order they
# are written in and the order two of them have to be compared in
fn gen_fn_parts(ps: list[ast.Ty], r: ast.Ty) -> list[ast.Ty] {
	mut out := ps
	out.append(r)
	return out
}

fn gen_match_all(tparams: list[str], mut &sol: list[ast.Ty], ds: list[ast.Ty], as_: list[ast.Ty]) {
	mut i := 0
	for i < ds.len() and i < as_.len() {
		gen_match(tparams, sol, ds[i], as_[i])
		i = i + 1
	}
}

# --- substitution -------------------------------------------------------------------
#
# One template plus one set of type arguments makes one ordinary function. Every node that
# can carry a type is rebuilt; every node that cannot is rebuilt too, because a walk that
# returned the original for "nothing to do here" would have to know which subtrees contain
# a type, and that is the same question one level up.

# subst_fn specializes a template. The result has NO type parameters — that is what makes
# it an ordinary function, and what stops it being instantiated again.
# TySubst is one instantiation: the template's type parameters, the arguments standing in
# for them, and THE PLACE THAT ASKED. The first two were passed as a pair through every
# function below; the third is why they are a record now.
#
# `at` is a place trailer (p_place), and it is the answer to a question this pass could not
# answer before: a `chan[T]` specialized at `T = int?` is a `chan[int?]`, which is refused —
# and the type is written NOWHERE in the source, so there is no position on it to point at.
# The honest place is not the type, it is the CALL that chose the argument: not *this type is
# a `chan[int?]`* but *this call makes `chan[T]` a `chan[int?]`*, which is a line the reader
# wrote (#55).
pub struct TySubst {
	pub names: list[str]
	pub args: list[ast.Ty]

	# keys/vals are the OTHER substitution this walk performs: an array length that names a
	# constant, replaced by its number (GRAMMAR#array-type derives a const-expr there). It rides
	# on the same struct because it is the same traversal — every place a type is written — and
	# a second walk over the same tree is the shape this file exists to avoid.
	pub keys: list[str]
	pub vals: list[str]
	pub at: str
}

# --- array lengths, resolved over the whole program ------------------------------------------
#
# GRAMMAR#array-type derives a CONST-EXPR for a length, so `[byte; WIDTH]` is a form — and the
# length is part of the TYPE, which means `[byte; WIDTH]` and `[byte; 4]` have to be ONE type
# everywhere two types meet. The parser cannot do that: it reads one file top to bottom, the
# constant may be declared below the use or in another module, and a parser that consults a
# table it has built is a parser with a symbol table (`layering` says so, and refused the first
# attempt at this for exactly that).
#
# SO THE PARSER CARRIES THE NAME AND THIS RESOLVES IT, once, over the merged program — before
# any type is compared, which is what makes the key safe to carry that far and no further.
#
# THE TABLE IS A FIXPOINT AND NOT A SCAN IN ORDER. `const B = A * 2` may be written above
# `const A = 2`, and a single pass would answer for one order and not the other — which would
# make where a constant sits decide whether a type resolves.
pub fn gen_resolve_lens(f: ast.File) -> ast.File {
	mut keys: list[str] = []
	mut vals: list[str] = []
	gen_len_table(f, keys, vals)
	su := TySubst([], [], keys, vals, "")

	mut structs: list[ast.StructDecl] = []
	for sd in f.structs {
		structs.append(ast.StructDecl(sd.name, subst_fields(su, sd.fields), sd.is_pub, sd.path, sd.line, sd.col, sd.tparams))
	}
	mut enums: list[ast.EnumDecl] = []
	for ed in f.enums {
		enums.append(ast.EnumDecl(ed.name, gen_len_variants(su, ed.variants), ed.is_pub, ed.path, ed.line, ed.col))
	}
	mut types: list[ast.TypeDecl] = []
	for td in f.types {
		types.append(ast.TypeDecl(td.name, subst_ty(su, td.under), td.is_pub, td.path, td.line, td.col))
	}
	mut consts: list[ast.ConstDecl] = []
	for cd in f.consts {
		consts.append(ast.ConstDecl(cd.name, cd.recv, subst_ty(su, cd.ty), cd.has_ty, cd.is_mut, cd.is_const, cd.is_pub, cd.in_unsafe, subst_expr(su, cd.value), cd.path, cd.line, cd.col))
	}
	mut fns: list[ast.FnDecl] = []
	for fd in f.fns {
		fns.append(gen_len_fn(su, fd))
	}
	mut specs: list[ast.SpecDecl] = []
	for sp in f.specs {
		specs.append(ast.SpecDecl(sp.name, sp.params, sp.supers, sp.super_args, gen_len_fns(su, sp.reqs), sp.is_pub, sp.path, sp.line, sp.col))
	}
	return ast.File(f.imports, structs, enums, specs, f.impls, fns, types, consts, f.derive_on, f.derive_spec, f.stmts, f.ty_quals, f.ty_apps)
}

# gen_len_table folds every module-level constant an array length may name. A `mut` binding is
# not one however it was initialised — GRAMMAR#array-type wants a const-expr, and a name that
# can be assigned to is not a compile-time value.
fn gen_len_table(f: ast.File, mut &keys: list[str], mut &vals: list[str]) {
	mut again := true
	for again {
		again = false
		for cd in f.consts {
			continue if cd.is_mut or cd.recv != "" or gen_len_known(keys, cd.name)

			v := gen_len_fold(keys, vals, cd.value)
			continue if v < 0

			keys.append(cd.name)
			vals.append(strconv.to_string(v, 10))
			again = true
		}
	}
}

fn gen_len_known(keys: list[str], name: str) -> bool {
	for k in keys {
		return true if k == name
	}
	return false
}

# gen_len_fold is the const-expr arithmetic a length may be written with — a literal, a name the
# table already holds, and the four operators over them. Anything else answers -1, which is the
# table declining to hold it rather than a finding: what a length may be is decided where the
# length is read.
fn gen_len_fold(keys: list[str], vals: list[str], e: ast.Expr) -> int {
	return match e {
		Expr.EInt(lex, _, _) => gen_len_int(lex)
		Expr.EIdent(n) => gen_len_named(keys, vals, n)
		Expr.EBinary(o, a, b) => gen_len_binary(keys, vals, o, a, b)
		_ => 0 - 1
	}
}

fn gen_len_int(lex: str) -> int {
	return 0 - 1 if not lexer.int_fits(lex)

	v := lexer.int_value(lex)
	return 0 - 1 if v < 0

	return v
}

fn gen_len_named(keys: list[str], vals: list[str], n: str) -> int {
	mut i := 0
	for i < keys.len() {
		return strconv.parse_int(vals[i], 10) if keys[i] == n and i < vals.len()

		i = i + 1
	}
	return 0 - 1
}

fn gen_len_binary(keys: list[str], vals: list[str], o: str, a: ast.Expr, b: ast.Expr) -> int {
	x := gen_len_fold(keys, vals, a)
	y := gen_len_fold(keys, vals, b)

	return 0 - 1 if x < 0 or y < 0

	return x + y if o == "+"
	return x - y if o == "-" and x >= y
	return x * y if o == "*"
	return x / y if o == "/" and y != 0

	return 0 - 1
}

# subst_fields is a field list with a substitution applied — general, despite where its first
# caller was: the length pass reaches it with a table of array-length keys and a generic type's
# instantiation reaches it with a table of type parameters, and it is the SAME walk either way.
# `subst_ty` is what decides which, from what the table holds.
pub fn subst_fields(su: TySubst, fs: list[ast.FieldDef]) -> list[ast.FieldDef] {
	mut out: list[ast.FieldDef] = []
	for fd in fs {
		out.append(ast.FieldDef(fd.name, subst_ty(su, fd.ty), fd.is_pub, fd.has_def, subst_expr(su, fd.def), fd.line, fd.col))
	}
	return out
}

fn gen_len_variants(su: TySubst, vs: list[ast.VariantDef]) -> list[ast.VariantDef] {
	mut out: list[ast.VariantDef] = []
	for v in vs {
		out.append(ast.VariantDef(v.name, subst_tys(su, v.fields), v.has_discr, v.discr, v.line, v.col))
	}
	return out
}

fn gen_len_fns(su: TySubst, fs: list[ast.FnDecl]) -> list[ast.FnDecl] {
	mut out: list[ast.FnDecl] = []
	for fd in fs {
		out.append(gen_len_fn(su, fd))
	}
	return out
}

# gen_len_fn is subst_fn without the mangling: the same walk over a declaration, for a
# substitution that renames nothing.
fn gen_len_fn(su: TySubst, fd: ast.FnDecl) -> ast.FnDecl {
	return ast.FnDecl(fd.name, fd.recv, subst_params(su, fd.params), fd.has_ret, subst_ty(su, fd.ret), subst_block(su, fd.body), fd.is_pub, fd.path, fd.line, fd.col, fd.tparams, fd.tbounds, fd.in_unsafe, fd.is_test, fd.is_fixture, fd.has_body, fd.is_assoc, fd.spec_of)
}

pub fn subst_fn(tpl: ast.FnDecl, args: list[ast.Ty], at: str) -> ast.FnDecl {
	su := TySubst(tpl.tparams, args, [], [], at)
	return ast.FnDecl(gen_mangle(tpl.name, args), tpl.recv, subst_params(su, tpl.params), tpl.has_ret, subst_ty(su, tpl.ret), subst_block(su, tpl.body), tpl.is_pub, tpl.path, tpl.line, tpl.col, [], [], tpl.in_unsafe, tpl.is_test, tpl.is_fixture, tpl.has_body, false, tpl.spec_of)
}

# subst_ty replaces a type parameter wherever a type is written, at any depth.
fn subst_ty(su: TySubst, t: ast.Ty) -> ast.Ty {
	nm := emit.c_named_of(t)
	if nm != "" {
		mut i := 0
		for i < su.names.len() {
			return su.args[i] if su.names[i] == nm and i < su.args.len()
			i = i + 1
		}
		return t
	}

	# EVERY SHAPE `gen_parts` TAKES APART, THIS ONE PUTS BACK. The two are one question asked in
	# two directions — what a type is built out of, and how to rebuild it with a parameter
	# replaced — so a shape either walk does not name is a specialization that keeps a type
	# PARAMETER in the signature it just decided. `fn(T) -> T` was the last of them: the solver
	# read `T` out of it and this left it there, so `apply(twice, 21)` was told _argument 1 is
	# fn(T) -> T, and this gives fn(int) -> int_ — a sentence naming the type parameter it had
	# already solved.
	return match t {
		Ty.TList(e) => ast.Ty.TList(subst_ty(su, e))
		Ty.TOpt(e) => ast.Ty.TOpt(subst_ty(su, e))
		Ty.TChan(e, d) => ast.ty_chan(subst_ty(su, e), d, su.at)
		Ty.TMap(k, v) => ast.Ty.TMap(subst_ty(su, k), subst_ty(su, v))
		Ty.TTuple(es) => ast.Ty.TTuple(subst_tys(su, es))
		Ty.TEither(x, y) => ast.Ty.TEither(subst_ty(su, x), subst_ty(su, y))
		Ty.TArr(e, n) => ast.Ty.TArr(subst_ty(su, e), subst_key(su, n))
		Ty.TRef(e) => ast.Ty.TRef(subst_ty(su, e))
		Ty.TPtr(e) => ast.Ty.TPtr(subst_ty(su, e))
		Ty.TUnsafe(e) => ast.Ty.TUnsafe(subst_ty(su, e))
		Ty.TFn(ps, r) => ast.Ty.TFn(subst_tys(su, ps), subst_ty(su, r))
		_ => t
	}
}

# subst_chan_elem is a channel CONSTRUCTOR's element type after substitution, and it is the
# door the parser cannot cover: a template writes `chan[T](1)`, which is well-formed, and
# specializing it for `T = int?` builds a `chan[int?]`, which is not. Nothing in the source
# spells that type — so the place reported is the INSTANTIATION (`su.at`) rather than the
# type, which is the one difference from the written form; the rule itself is the same
# function, because it is the same rule.
#
# The channel TYPE needs nothing here: `subst_ty` builds its result through `ty_chan`
# (ast.zg), which asks the rule at construction. A constructor's node carries the ELEMENT
# rather than the channel type, so it never reaches that constructor — which is exactly why
# this one stays, and why covering only the `Ty.TChan` arm once left `chan[T](1)` unchecked.
fn subst_chan_elem(su: TySubst, e: ast.Ty) -> ast.Ty {
	el := subst_ty(su, e)
	ast.ty_chan_elem_check(el, su.at)
	return el
}

# subst_key resolves an array length that names a constant. A key that is already digits — or
# a name the table has not got — comes back unchanged, and what refuses the second kind is the
# rule that owns the question, once, where the whole program is in hand.
fn subst_key(su: TySubst, k: str) -> str {
	mut i := 0
	for i < su.keys.len() {
		return su.vals[i] if su.keys[i] == k and i < su.vals.len()

		i = i + 1
	}
	return k
}

fn subst_tys(su: TySubst, ts: list[ast.Ty]) -> list[ast.Ty] {
	mut out: list[ast.Ty] = []
	for t in ts {
		out.append(subst_ty(su, t))
	}
	return out
}

fn subst_block(su: TySubst, b: list[ast.Stmt]) -> list[ast.Stmt] {
	mut out: list[ast.Stmt] = []
	for s in b {
		out.append(subst_stmt(su, s))
	}
	return out
}

fn subst_stmt(su: TySubst, s: ast.Stmt) -> ast.Stmt {
	return match s {
		Stmt.SLet(nm, ty, ht, im, ic, v) => ast.Stmt.SLet(nm, subst_ty(su, ty), ht, im, ic, subst_expr(su, v))
		Stmt.SDestructure(t, v, ib, im, ic) => ast.Stmt.SDestructure(subst_target(su, t), subst_expr(su, v), ib, im, ic)
		Stmt.SAssign(l, r) => ast.Stmt.SAssign(subst_expr(su, l), subst_expr(su, r))
		Stmt.SPrint(v) => ast.Stmt.SPrint(subst_expr(su, v))
		Stmt.SReturn(hv, v) => ast.Stmt.SReturn(hv, subst_expr(su, v))
		Stmt.SReturnIf(v, c) => ast.Stmt.SReturnIf(subst_expr(su, v), subst_expr(su, c))
		Stmt.SExpr(v) => ast.Stmt.SExpr(subst_expr(su, v))
		Stmt.SIf(c, tb, he, eb) => ast.Stmt.SIf(subst_expr(su, c), subst_block(su, tb), he, subst_block(su, eb))
		Stmt.SFor(hc, c, b) => ast.Stmt.SFor(hc, subst_expr(su, c), subst_block(su, b))
		Stmt.SForIn(nm, it, b) => ast.Stmt.SForIn(nm, subst_expr(su, it), subst_block(su, b))
		Stmt.SForSelect(arms) => ast.Stmt.SForSelect(subst_sel_arms(su, arms))
		Stmt.SRaise(e, hf, cause) => ast.Stmt.SRaise(subst_expr(su, e), hf, subst_expr(su, cause))
		Stmt.SDefer(v) => ast.Stmt.SDefer(subst_expr(su, v))
		Stmt.SSpawn(v) => ast.Stmt.SSpawn(subst_expr(su, v))
		Stmt.SSend(ch, v) => ast.Stmt.SSend(subst_expr(su, ch), subst_expr(su, v))
		Stmt.SSelect(arms) => ast.Stmt.SSelect(subst_sel_arms(su, arms))
		Stmt.SClose(ch, tw) => ast.Stmt.SClose(subst_expr(su, ch), tw)
		Stmt.SIfLet(nm, v, tb, he, eb) => ast.Stmt.SIfLet(nm, subst_expr(su, v), subst_block(su, tb), he, subst_block(su, eb))

		# an `assert` holds the author's own condition, desugared, so a `T` written in it — in a
		# closure's parameter, say — is a `T` this pass owes an argument like any other. The
		# fallback below left it, quietly: nothing downstream looks at those statements again,
		# so the specialization carried a `fn(T) -> bool` into a position wanting `fn(int)`.
		Stmt.SAssert(b) => ast.Stmt.SAssert(subst_block(su, b))

		# A BARE BLOCK IS A BLOCK, and it was the fallback's second victim. `{ x: T = v }`
		# inside a template kept its `T` and the specialization was refused with
		# _E4056 no type named `T`_ — a legal program, turned away with a reason that is not
		# true, which sends the reader looking for a declaration they wrote in the signature.
		Stmt.SScope(b, u) => ast.Stmt.SScope(subst_block(su, b), u)

		# AND THE CATCH-ALL IS GONE. Twice now a form that carries something has been left
		# unsubstituted by `_ => s` — the `assert` above and the block above that — and each
		# time the arm was added and the fallback kept, so the next one was already waiting.
		# Naming every variant is what makes the next Stmt a type error here instead.
		#
		# These five carry nothing a type argument could reach: two jumps, a nop, a `del` of
		# a name, and a position marker.
		Stmt.SBreak    => s
		Stmt.SContinue => s
		Stmt.SNop      => s
		Stmt.SDel(_)   => s
		Stmt.SAt(_, _) => s
	}
}

fn subst_sel_arms(su: TySubst, arms: list[ast.SelArm]) -> list[ast.SelArm] {
	mut out: list[ast.SelArm] = []
	for a in arms {
		out.append(ast.SelArm(a.op, a.bind, subst_expr(su, a.ch), subst_expr(su, a.val), subst_block(su, a.body)))
	}
	return out
}

fn subst_expr(su: TySubst, e: ast.Expr) -> ast.Expr {
	return match e {
		Expr.EUnary(o, x) => ast.Expr.EUnary(o, subst_expr(su, x))
		Expr.EBinary(o, a, b) => ast.Expr.EBinary(o, subst_expr(su, a), subst_expr(su, b))
		Expr.ECall(nm, xs, ts) => ast.Expr.ECall(nm, subst_exprs(su, xs), subst_tys(su, ts))
		Expr.EField(x, f) => ast.Expr.EField(subst_expr(su, x), f)
		Expr.EOptChain(x, f) => ast.Expr.EOptChain(subst_expr(su, x), f)
		Expr.ETry(x) => ast.Expr.ETry(subst_expr(su, x))
		Expr.EIndex(x, i) => ast.Expr.EIndex(subst_expr(su, x), subst_expr(su, i))
		Expr.EMethod(x, m, xs) => ast.Expr.EMethod(subst_expr(su, x), m, subst_exprs(su, xs))
		Expr.EListLit(xs) => ast.Expr.EListLit(subst_exprs(su, xs))
		Expr.EConv(ty, x, as_) => ast.Expr.EConv(subst_ty(su, ty), subst_expr(su, x), as_)
		Expr.EFmt(x, cv, sp) => ast.Expr.EFmt(subst_expr(su, x), cv, sp)
		Expr.EIf(c, a, b) => ast.Expr.EIf(subst_expr(su, c), subst_expr(su, a), subst_expr(su, b))
		Expr.EMatch(x, arms) => ast.Expr.EMatch(subst_expr(su, x), subst_arms(su, arms))
		Expr.ERange(a, b, inc) => ast.Expr.ERange(subst_expr(su, a), subst_expr(su, b), inc)
		Expr.ETuple(xs) => ast.Expr.ETuple(subst_exprs(su, xs))
		Expr.EMapLit(ks, vs) => ast.Expr.EMapLit(subst_exprs(su, ks), subst_exprs(su, vs))
		Expr.EFn(ps, hr, r, b) => ast.Expr.EFn(subst_params(su, ps), hr, subst_ty(su, r), subst_block(su, b))
		Expr.EChanNew(ty, cap) => ast.Expr.EChanNew(subst_chan_elem(su, ty), subst_expr(su, cap))
		Expr.ERecv(x) => ast.Expr.ERecv(subst_expr(su, x))
		Expr.EForce(x) => ast.Expr.EForce(subst_expr(su, x))
		Expr.ECoalesce(a, b, jump) => ast.Expr.ECoalesce(subst_expr(su, a), subst_expr(su, b), subst_block(su, jump))
		Expr.EGuard(b) => ast.Expr.EGuard(subst_block(su, b))
		Expr.EBlock(b) => ast.Expr.EBlock(subst_block(su, b))
		Expr.EUnsafe(b) => ast.Expr.EUnsafe(subst_block(su, b))
		Expr.EAsm(tpl, ops) => ast.Expr.EAsm(tpl, subst_asm_ops(su, ops))
		Expr.EIs(x, nm) => ast.Expr.EIs(subst_expr(su, x), gen_is_name(su, nm))
		Expr.EIn(x, s) => ast.Expr.EIn(subst_expr(su, x), subst_expr(su, s))

		# THE FILL FORM CARRIES TWO EXPRESSIONS and the fallback left both. `[T(0); 3]` in a
		# template kept its `T` and the specialization was refused with _E4064 no type named
		# `T` to construct_ — the same shape as the bare block next door in subst_stmt, one
		# node type along, and found the same way: by asking which variants this match does
		# not name.
		Expr.EFill(v, n) => ast.Expr.EFill(subst_expr(su, v), subst_expr(su, n))

		# and no catch-all, for subst_stmt's reason. What is left is the literals and a bare
		# name, which hold no type for an argument to reach.
		Expr.EInt(_, _, _) => e
		Expr.EFloat(_)     => e
		Expr.EStr(_)       => e
		Expr.EBool(_)      => e
		Expr.ENil          => e
		Expr.EIdent(_)     => e
	}
}

# gen_is_name carries a specialization through the RIGHT side of an `is` test. That side is a
# type written as a bare name, so it is a type a type parameter can be — and it was the one
# type in an expression this walk copied through unchanged, because it is a `str` and not a
# `Ty`. Nothing could see it while every non-error `is` was refused; the moment `is T` folds,
# a template testing `x is T` would have compared against a type literally named `T`.
#
# It goes through `subst_ty` rather than a second lookup in the same table, so a name that is
# not a parameter comes back as itself, and one bound to a type with no bare spelling comes
# back as that spelling — which the `is` test then refuses, as a `type-name` it does not name.
fn gen_is_name(su: TySubst, nm: str) -> str {
	return ast.ty_name(subst_ty(su, ast.Ty.TNamed(nm)))
}

# subst_asm_ops carries a specialization through an `asm(…)`: the template and the constraints
# are text, and only an operand's EXPRESSION can mention a type parameter.
fn subst_asm_ops(su: TySubst, ops: list[ast.AsmOp]) -> list[ast.AsmOp] {
	mut out: list[ast.AsmOp] = []
	for o in ops {
		out.append(ast.AsmOp(o.kind, o.cons, subst_expr(su, o.expr), o.line, o.col))
	}
	return out
}

# subst_params is a parameter list, and it is a function of its own because BOTH a template
# and a closure inside one have one. The rebuild was written twice, so a Param that grew a
# field would have been substituted in one and copied unchanged in the other.
# subst_target carries a specialization through a destructuring target: only an ASSIGNMENT's
# leaves are expressions that can mention a type parameter, and the shape itself holds none.
fn subst_target(su: TySubst, t: ast.Target) -> ast.Target {
	return match t {
		Target.TgtWild => t
		Target.TgtPlace(e) => ast.Target.TgtPlace(subst_expr(su, e))
		Target.TgtTuple(ts) => ast.Target.TgtTuple(subst_targets(su, ts))
		Target.TgtStruct(n, fs, ts, r) => ast.Target.TgtStruct(n, fs, subst_targets(su, ts), r)
	}
}

fn subst_targets(su: TySubst, ts: list[ast.Target]) -> list[ast.Target] {
	mut out: list[ast.Target] = []
	for t in ts {
		out.append(subst_target(su, t))
	}
	return out
}

fn subst_params(su: TySubst, ps: list[ast.Param]) -> list[ast.Param] {
	mut out: list[ast.Param] = []
	for pm in ps {
		out.append(ast.Param(pm.name, subst_ty(su, pm.ty), pm.is_ref, pm.has_def, subst_expr(su, pm.def)))
	}
	return out
}

fn subst_exprs(su: TySubst, xs: list[ast.Expr]) -> list[ast.Expr] {
	mut out: list[ast.Expr] = []
	for x in xs {
		out.append(subst_expr(su, x))
	}
	return out
}

# subst_pat walks a pattern for the one thing a type substitution can reach: the EXPRESSION a
# literal pattern compares against. Every other part of a pattern is a name or a shape, and a
# type argument changes neither — but the walk is still total, because a literal can be nested
# inside any of them and a case that forgot one would substitute in some arms and not others.
fn subst_pat(su: TySubst, pt: ast.Pat) -> ast.Pat {
	return match pt {
		Pat.PLit(e) => ast.Pat.PLit(subst_expr(su, e))
		Pat.PVariant(q, c, ps) => ast.Pat.PVariant(q, c, subst_pats(su, ps))
		Pat.PStruct(n, fs, ps, open) => ast.Pat.PStruct(n, fs, subst_pats(su, ps), open)
		Pat.PList(ps, rest, rname) => ast.Pat.PList(subst_pats(su, ps), rest, rname)
		Pat.PTuple(ps) => ast.Pat.PTuple(subst_pats(su, ps))
		Pat.POr(ps) => ast.Pat.POr(subst_pats(su, ps))
		Pat.PAs(inner, n) => ast.Pat.PAs(subst_pat(su, inner), n)
		_ => pt
	}
}

fn subst_pats(su: TySubst, ps: list[ast.Pat]) -> list[ast.Pat] {
	mut out: list[ast.Pat] = []
	for pt in ps {
		out.append(subst_pat(su, pt))
	}
	return out
}

fn subst_arms(su: TySubst, arms: list[ast.Arm]) -> list[ast.Arm] {
	mut out: list[ast.Arm] = []
	for a in arms {
		out.append(ast.Arm(subst_pat(su, a.pat), a.has_guard, subst_expr(su, a.guard_expr), subst_expr(su, a.body), a.line, a.col))
	}
	return out
}
