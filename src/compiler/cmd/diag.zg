# The lexical gate and the diagnostic renderer: what a source has to survive before
# anything downstream reads it, and what a `zerg.Diag` looks like on a terminal — the code,
# the sentence, the place, the line, and the caret under it.
#
# `build`, `test` and `lint` all report diagnostics, so this belongs to none of them. A
# compiler that printed a finding one way and its linter another would be two tools wearing
# one name.

import (
	"io"
	"strconv"

	"zerg"
)

# lex_check ends the run when a source has a token the lexer could not read. It is called
# the moment a file is READ — before its imports are scanned, since scanning them parses,
# and a parser handed unreadable text can only say something untrue about it. That is what
# the old answer was: "`b'b` is not an expression this compiler reads", naming the wrong
# layer, the wrong problem, and a fragment of what the person wrote.
fn lex_check(src: str, path: str) {
	mut one_src: list[str] = []
	mut one_path: list[str] = []
	one_src.append(src)
	one_path.append(path)
	report_diags(zerg.lex_diags(src, path), one_src, one_path)
}

# lex_diags_of collects the LEXICAL errors of every source, which are reported before
# anything is parsed: a token the lexer could not read is an error about text, and no later
# pass can say anything true about it — the one that used to try answered "not an
# expression", about the wrong layer and a fragment of what was written.
fn lex_diags_of(srcs: list[str], paths: list[str], mut &diags: list[zerg.Diag]) {
	mut i := 0
	for i < srcs.len() {
		mut path := ""
		if i < paths.len() {
			path = paths[i]
		}
		for d in zerg.lex_diags(srcs[i], path) {
			diags.append(d)
		}
		i = i + 1
	}
}

# report_diags ends the run when the program is ill-formed, having said EVERYTHING that is
# wrong with it. Nothing reaches cc after this: the C was built out of a program that does
# not typecheck, so any complaint cc had about it would be a second-hand account of a
# mistake already reported here, against a file the programmer cannot open.
#
# It exits rather than returning a status because it is called from the middle of a build,
# where the alternative is threading "did it work" back through every stage for a question
# with one answer.
fn report_diags(diags: list[zerg.Diag], srcs: list[str], paths: list[str]) {
	return if diags.len() == 0
	for d in diags {
		io.ewrite(render_diag(d, diag_source(d.path, srcs, paths)))
	}
	n := strconv.to_string(diags.len(), 10)
	if diags.len() > 1 {
		io.ewrite(f"zerg: {n} error(s)\n")
	}
	__zrt_exit(1)
}

# diag_code_prefix puts the rule's identity in FRONT of the sentence, and answers nothing at
# all for a finding that has no code yet. It is a function rather than a branch at each of its
# two call sites — `zerg build`'s renderer and `zerg lint`'s — because it is the layout
# scripts/lib/diag.sh asserts: the code opens the line, after `error: ` where there is one.
fn diag_code_prefix(d: zerg.Diag) -> str {
	return "" if d.code == ""

	return f"{d.code} "
}

# render_diag draws one finding the way a person reads it: what is wrong first, then where,
# then the line itself with a caret under the thing it is about.
#
#     error: cannot assign to `x`: it is immutable — declare it `mut x := …`
#      --> examples/foo.zg:3:2
#       |
#     3 |     x = 2
#       |     ^
#
# The source line is omitted when the file cannot be found — a diagnostic is still a
# diagnostic without it, and guessing at a line nobody read would be worse than saying
# less.
fn render_diag(d: zerg.Diag, src: str) -> str {
	mut out := f"error: {diag_code_prefix(d)}{d.msg}\n"
	line_s := strconv.to_string(d.line, 10)
	if d.line > 0 {
		out = out + zerg.place_line(d.path, d.line, d.col) + "\n"
	}

	text := source_line(src, d.line)
	return out if text == "" or d.line == 0

	gutter := blanks(bytearray(line_s).len())
	out = out + f" {gutter} |\n"
	out = out + f" {line_s} | {text}\n"

	# the caret marks the TOKEN when the message names one in backticks and it is on this
	# line at or after the statement's column; otherwise it marks where the statement
	# starts, which is all the position this compiler records. A quoted name that is a type
	# rather than a token — or one that appears twice — falls back rather than mislead.
	col := caret_col(text, d)
	return out + f" {gutter} | {caret_pad(text, col)}^\n"
}

# caret_pad is the run of whitespace that puts the caret under column `col` of `text`. It
# COPIES the source's own indentation rather than emitting spaces: a line indented with
# tabs renders one tab as many columns, so a caret padded with spaces lands short of the
# thing it points at by however much the terminal decided a tab was worth.
fn caret_pad(text: str, col: int) -> str {
	b := bytearray(text)
	mut out: list[byte] = []
	mut i := 0
	for i < col - 1 {
		if i < b.len() and b[i] == b'\t' {
			out.append(b'\t')
		} else {
			out.append(b' ')
		}
		i = i + 1
	}
	return str(out)
}

# caret_col is the 1-based column the caret goes under.
fn caret_col(text: str, d: zerg.Diag) -> int {
	q := first_quoted(d.msg)
	return d.col if q == ""
	at := index_from(text, q, d.col - 1)
	return d.col if at < 0
	return at + 1
}

# first_quoted is the first `…` run in a message, which is how every rule in this compiler
# names the thing it is talking about.
fn first_quoted(msg: str) -> str {
	b := bytearray(msg)
	mut i := 0
	for i < b.len() {
		if b[i] == b'`' {
			mut j := i + 1
			for j < b.len() and b[j] != b'`' {
				j = j + 1
			}
			return "" if j >= b.len()
			mut out: list[byte] = []
			mut k := i + 1
			for k < j {
				out.append(b[k])
				k = k + 1
			}
			return str(out)
		}
		i = i + 1
	}
	return ""
}

# index_from is where `needle` first occurs in `hay` at or after `from`, or -1.
fn index_from(hay: str, needle: str, start: int) -> int {
	h := bytearray(hay)
	n := bytearray(needle)
	return -1 if n.len() == 0 or n.len() > h.len()
	mut i := start
	if i < 0 {
		i = 0
	}
	for i <= h.len() - n.len() {
		mut j := 0
		for j < n.len() and h[i + j] == n[j] {
			j = j + 1
		}
		return i if j == n.len()
		i = i + 1
	}
	return -1
}

# source_line is the 1-based `n`th line of `src`, or "" when there is no such line.
fn source_line(src: str, n: int) -> str {
	return "" if n < 1

	b := bytearray(src)
	mut at := 1
	mut start := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'\n' {
			return line_slice(b, start, i) if at == n
			at = at + 1
			start = i + 1
		}
		i = i + 1
	}
	return line_slice(b, start, b.len()) if at == n
	return ""
}

fn line_slice(b: list[byte], at: int, to: int) -> str {
	mut out: list[byte] = []
	mut i := at
	for i < to {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

fn blanks(n: int) -> str {
	mut out := ""
	mut i := 0
	for i < n {
		out = out + " "
		i = i + 1
	}
	return out
}

# diag_source is the text of the file a finding is about, found by its path among the
# sources already loaded — the compiler does not read it again.
fn diag_source(path: str, srcs: list[str], paths: list[str]) -> str {
	mut i := 0
	for i < paths.len() and i < srcs.len() {
		return srcs[i] if paths[i] == path
		i = i + 1
	}
	return ""
}
