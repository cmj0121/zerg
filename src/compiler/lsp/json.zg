# json — the encoder and decoder JSON-RPC needs, and nothing more.
#
# It lives in the `lsp` module rather than in the standard library because the language
# server is its only caller and a stdlib module is a promise about a surface. Moving it
# later is a file rename; promising it now is a thing to keep.
#
# A value is one enum and an object is a LIST OF FIELDS rather than a `map[str, JVal]`.
# Two reasons, and the second is the one that decided it: an LSP object is a handful of
# keys, so a linear lookup is not worth a hash; and a list keeps the order the fields were
# written in, which means the bytes this module produces are a function of the value alone.
# A protocol that is debugged by reading a transcript wants that.
import "strconv"

enum JVal {
	JNull
	JBool(bool)
	JInt(int)
	JStr(str)
	JArr(list[JVal])
	JObj(list[JField])
}

struct JField {
	key: str
	val: JVal
}

# --- reading a value --------------------------------------------------------------------
#
# The accessors are TOTAL: asking a number for its string gives "", and asking a value that
# is not an object for a key gives `JNull`. That is deliberate for a server whose input
# comes from another program: a client that sends a field of the wrong shape should get a
# default and a reply, not an abort that takes the session with it. Where a missing field
# is genuinely fatal, the caller asks `jhas` and says so itself.

# jget is the value at `key`, or `JNull`.
pub fn jget(v: JVal, key: str) -> JVal {
	return match v {
		JObj(fs) => jfield(fs, key)
		_        => JNull
	}
}

fn jfield(fs: list[JField], key: str) -> JVal {
	for f in fs {
		return f.val if f.key == key
	}
	return JNull
}

# jat walks a path of keys — `jat(msg, "params", "textDocument", "uri")` — which is what
# every LSP request needs and what three nested `jget`s per handler would otherwise be.
pub fn jat(v: JVal, a: str, b: str) -> JVal {
	return jget(jget(v, a), b)
}

pub fn jat3(v: JVal, a: str, b: str, c: str) -> JVal {
	return jget(jat(v, a, b), c)
}

pub fn jhas(v: JVal, key: str) -> bool {
	return match jget(v, key) {
		JNull => false
		_     => true
	}
}

pub fn jstr(v: JVal) -> str {
	return match v {
		JStr(s) => s
		_       => ""
	}
}

pub fn jint(v: JVal) -> int {
	return match v {
		JInt(n) => n
		_       => 0
	}
}

pub fn jarr(v: JVal) -> list[JVal] {
	return match v {
		JArr(xs) => xs
		_        => []
	}
}

pub fn jis_null(v: JVal) -> bool {
	return match v {
		JNull => true
		_     => false
	}
}

# --- building a value -------------------------------------------------------------------
#
# The constructors exist because an enum's VARIANTS cannot be constructed from outside the
# module that declares them — a bootstrap limitation this compiler still carries — so a
# consumer of this module can hold a `JVal` and has no way to make one. These are that way
# in. They are also what keeps the server's reply-building readable: `jo_str(fs, "id", x)`
# beside `fs.append(JField("id", JStr(x)))`.

pub fn jnull() -> JVal {
	return JNull
}

pub fn jbool_of(b: bool) -> JVal {
	return JBool(b)
}

pub fn jint_of(n: int) -> JVal {
	return JInt(n)
}

pub fn jstr_of(s: str) -> JVal {
	return JStr(s)
}

pub fn jarr_of(xs: list[JVal]) -> JVal {
	return JArr(xs)
}

pub fn jobj_of(fs: list[JField]) -> JVal {
	return JObj(fs)
}

pub fn jfields() -> list[JField] {
	mut fs: list[JField] = []
	return fs
}

pub fn jput(mut &fs: list[JField], key: str, v: JVal) {
	fs.append(JField(key, v))
}

pub fn jput_str(mut &fs: list[JField], key: str, s: str) {
	fs.append(JField(key, JStr(s)))
}

pub fn jput_int(mut &fs: list[JField], key: str, n: int) {
	fs.append(JField(key, JInt(n)))
}

pub fn jput_bool(mut &fs: list[JField], key: str, b: bool) {
	fs.append(JField(key, JBool(b)))
}

# --- writing ------------------------------------------------------------------------------

pub fn json_write(v: JVal) -> str {
	mut out: list[byte] = []
	jw(v, out)
	return str(out)
}

fn jw(v: JVal, mut &out: list[byte]) {
	match v {
		JNull    => jw_text(out, "null")
		JBool(b) => jw_bool(out, b)
		JInt(n)  => jw_text(out, strconv.to_string(n, 10))
		JStr(s)  => jw_str(out, s)
		JArr(xs) => jw_arr(xs, out)
		JObj(fs) => jw_obj(fs, out)
	}
}

fn jw_bool(mut &out: list[byte], b: bool) {
	if b {
		jw_text(out, "true")
	} else {
		jw_text(out, "false")
	}
}

fn jw_text(mut &out: list[byte], s: str) {
	for c in list[byte](s) {
		out.append(c)
	}
}

fn jw_arr(xs: list[JVal], mut &out: list[byte]) {
	out.append(b'[')
	mut first := true
	for x in xs {
		if not first {
			out.append(b',')
		}
		first = false
		jw(x, out)
	}
	out.append(b']')
}

fn jw_obj(fs: list[JField], mut &out: list[byte]) {
	out.append(b'{')
	mut first := true
	for f in fs {
		if not first {
			out.append(b',')
		}
		first = false
		jw_str(out, f.key)
		out.append(b':')
		jw(f.val, out)
	}
	out.append(b'}')
}

# jw_str escapes what JSON says must be escaped and NOTHING ELSE. That matters here more
# than it usually does: the strings this server sends are a person's source code and a
# compiler's diagnostics, so a quote, a backslash and a newline all arrive routinely, and a
# tab in a Zerg file is every indent in it.
#
# A byte below 0x20 with no short escape goes out as `\u00XX`. Everything at 0x20 and above
# passes through as it is, which is what carries UTF-8 unchanged: JSON's escapes are about
# ASCII control characters and the two delimiters, and a multi-byte code point is already
# legal text.
fn jw_str(mut &out: list[byte], s: str) {
	out.append(b'"')
	for c in list[byte](s) {
		if c == b'"' or c == b'\\' {
			out.append(b'\\')
			out.append(c)
		} else if c == b'\n' {
			jw_text(out, "\\n")
		} else if c == b'\r' {
			jw_text(out, "\\r")
		} else if c == b'\t' {
			jw_text(out, "\\t")
		} else if c == byte(8) {
			jw_text(out, "\\b")
		} else if c == byte(12) {
			jw_text(out, "\\f")
		} else if int(c) < 32 {
			jw_text(out, "\\u00")
			out.append(jw_hex(int(c) / 16))
			out.append(jw_hex(int(c) % 16))
		} else {
			out.append(c)
		}
	}
	out.append(b'"')
}

fn jw_hex(n: int) -> byte {
	return byte(48 + n) if n < 10
	return byte(97 + n - 10)
}

# --- reading ------------------------------------------------------------------------------
#
# A recursive-descent reader over the bytes, with the cursor carried in a one-element list
# because this subset has no `mut &` on a scalar. It is the same trick the position is
# threaded with everywhere below.
#
# It RAISES on malformed input rather than returning a partial value. A JSON-RPC frame that
# does not parse is not a request that can be answered — there is no id to answer it with —
# so the server catches the abort, logs it, and reads the next frame.

pub fn json_parse(s: str) -> JVal {
	b := list[byte](s)
	mut at: list[int] = []
	at.append(0)
	v := jp_value(b, at)
	return v
}

fn jp_value(b: list[byte], mut &at: list[int]) -> JVal {
	jp_space(b, at)
	raise "json: input ended where a value was expected" if at[0] >= b.len()

	c := b[at[0]]

	return jp_obj(b, at) if c == b'{'
	return jp_arr(b, at) if c == b'['
	return jp_str_val(b, at) if c == b'"'
	return jp_lit(b, at, "true", JBool(true)) if c == b't'
	return jp_lit(b, at, "false", JBool(false)) if c == b'f'
	return jp_lit(b, at, "null", JNull) if c == b'n'
	return jp_num(b, at) if c == b'-' or jp_isdigit(c)

	raise f"json: byte {int(c)} begins no value"
}

fn jp_space(b: list[byte], mut &at: list[int]) {
	for at[0] < b.len() {
		c := b[at[0]]
		break if not (c == b' ' or c == b'\t' or c == b'\n' or c == b'\r')
		at[0] = at[0] + 1
	}
}

fn jp_lit(b: list[byte], mut &at: list[int], word: str, v: JVal) -> JVal {
	w := list[byte](word)
	mut i := 0
	for i < w.len() {
		raise f"json: expected `{word}`" if at[0] + i >= b.len() or b[at[0] + i] != w[i]
		i = i + 1
	}
	at[0] = at[0] + w.len()
	return v
}

fn jp_obj(b: list[byte], mut &at: list[int]) -> JVal {
	at[0] = at[0] + 1 # '{'
	mut fs: list[JField] = []
	jp_space(b, at)
	if at[0] < b.len() and b[at[0]] == b'}' {
		at[0] = at[0] + 1
		return JObj(fs)
	}
	for {
		jp_space(b, at)
		raise "json: a key must be a string" if at[0] >= b.len() or b[at[0]] != b'"'
		key := jp_string(b, at)
		jp_space(b, at)
		raise "json: expected `:` after a key" if at[0] >= b.len() or b[at[0]] != b':'
		at[0] = at[0] + 1
		fs.append(JField(key, jp_value(b, at)))
		jp_space(b, at)
		raise "json: an object is not closed" if at[0] >= b.len()
		if b[at[0]] == b',' {
			at[0] = at[0] + 1
			continue
		}
		raise "json: expected `,` or `}` in an object" if b[at[0]] != b'}'
		at[0] = at[0] + 1
		break
	}
	return JObj(fs)
}

fn jp_arr(b: list[byte], mut &at: list[int]) -> JVal {
	at[0] = at[0] + 1 # '['
	mut xs: list[JVal] = []
	jp_space(b, at)
	if at[0] < b.len() and b[at[0]] == b']' {
		at[0] = at[0] + 1
		return JArr(xs)
	}
	for {
		xs.append(jp_value(b, at))
		jp_space(b, at)
		raise "json: an array is not closed" if at[0] >= b.len()
		if b[at[0]] == b',' {
			at[0] = at[0] + 1
			continue
		}
		raise "json: expected `,` or `]` in an array" if b[at[0]] != b']'
		at[0] = at[0] + 1
		break
	}
	return JArr(xs)
}

fn jp_str_val(b: list[byte], mut &at: list[int]) -> JVal {
	return JStr(jp_string(b, at))
}

fn jp_string(b: list[byte], mut &at: list[int]) -> str {
	at[0] = at[0] + 1 # '"'
	mut out: list[byte] = []
	for {
		raise "json: a string is not closed" if at[0] >= b.len()
		c := b[at[0]]
		at[0] = at[0] + 1
		break if c == b'"'
		if c != b'\\' {
			out.append(c)
			continue
		}
		raise "json: a string ends in an escape" if at[0] >= b.len()
		e := b[at[0]]
		at[0] = at[0] + 1
		if e == b'u' {
			jp_uescape(b, at, out)
			continue
		}
		out.append(jp_escape(e))
	}
	return str(out)
}

fn jp_escape(e: byte) -> byte {
	return b'\n' if e == b'n'
	return b'\r' if e == b'r'
	return b'\t' if e == b't'
	return byte(8) if e == b'b'
	return byte(12) if e == b'f'

	# `"`, `\` and `/` stand for themselves, and anything else is malformed JSON that this
	# reader passes through rather than refusing: a client is not going to send one, and a
	# session dropped over a stray escape is worse than a byte read literally.
	return e
}

# jp_uescape decodes `\uXXXX` and writes it as UTF-8. A SURROGATE PAIR is decoded as a pair
# — the high half alone is not a code point, and a client that sends an emoji in a message
# sends two escapes for it.
fn jp_uescape(b: list[byte], mut &at: list[int], mut &out: list[byte]) {
	mut cp := jp_hex4(b, at)
	if cp >= 55296 and cp <= 56319 and at[0] + 1 < b.len() and b[at[0]] == b'\\' and b[at[0] + 1] == b'u' {
		at[0] = at[0] + 2
		lo := jp_hex4(b, at)
		cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
	}
	jp_utf8(cp, out)
}

fn jp_hex4(b: list[byte], mut &at: list[int]) -> int {
	mut n := 0
	mut i := 0
	for i < 4 {
		raise "json: a `\\u` escape needs four hex digits" if at[0] >= b.len()
		n = n * 16 + jp_hexval(b[at[0]])
		at[0] = at[0] + 1
		i = i + 1
	}
	return n
}

fn jp_hexval(c: byte) -> int {
	return int(c) - 48 if jp_isdigit(c)
	return int(c) - 87 if c >= b'a' and c <= b'f'
	return int(c) - 55 if c >= b'A' and c <= b'F'

	raise "json: a `\\u` escape needs four hex digits"
}

fn jp_utf8(cp: int, mut &out: list[byte]) {
	if cp < 128 {
		out.append(byte(cp))
	} else if cp < 2048 {
		out.append(byte(192 + cp / 64))
		out.append(byte(128 + cp % 64))
	} else if cp < 65536 {
		out.append(byte(224 + cp / 4096))
		out.append(byte(128 + (cp / 64) % 64))
		out.append(byte(128 + cp % 64))
	} else {
		out.append(byte(240 + cp / 262144))
		out.append(byte(128 + (cp / 4096) % 64))
		out.append(byte(128 + (cp / 64) % 64))
		out.append(byte(128 + cp % 64))
	}
}

# jp_num reads a number and answers an INTEGER. JSON has one number type and LSP uses it
# for positions, counts and ids, every one of which is a whole number; a fraction is
# consumed and dropped rather than refused, because refusing it would drop a session over a
# field this server does not read.
fn jp_num(b: list[byte], mut &at: list[int]) -> JVal {
	mut neg := false
	if b[at[0]] == b'-' {
		neg = true
		at[0] = at[0] + 1
	}
	mut n := 0
	mut any := false
	for at[0] < b.len() and jp_isdigit(b[at[0]]) {
		n = n * 10 + (int(b[at[0]]) - 48)
		at[0] = at[0] + 1
		any = true
	}
	raise "json: a number needs a digit" if not any
	for at[0] < b.len() and jp_num_tail(b[at[0]]) {
		at[0] = at[0] + 1
	}
	return JInt(-n) if neg
	return JInt(n)
}

fn jp_num_tail(c: byte) -> bool {
	return jp_isdigit(c) or c == b'.' or c == b'e' or c == b'E' or c == b'+' or c == b'-'
}

fn jp_isdigit(c: byte) -> bool {
	return c >= b'0' and c <= b'9'
}
