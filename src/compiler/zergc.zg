# zerg — the self-hosting Zerg compiler.
#
# THIS FILE IS THE ENTRY AND NOTHING ELSE. The command line is declared in `cmd/root.zg` and
# what each command DOES lives beside it in `cmd`, one file per command — so a change to what
# `build` does touches no file that says what `zerg` accepts. What is left here is the one
# thing only the shipped entry may reach: `doc`'s `--serve`.
import (
	"cli"
	"/cmd"
	"/serve"
)

fn main(args: list[str]) {
	__zrt_exit(cmd.root(do_doc_entry).exec(args))
}

# do_doc_entry is what `zerg doc` runs. It is this entry's own function, not one of `cmd`'s,
# because `--serve` is the one form that needs `net`, and only this entry may import it — the
# seed's entry, `zergc_seed.zg`, has its own copy that refuses `--serve`.
fn do_doc_entry(c: cli.Ctx) -> int {
	return serve.run(c) if c.has("serve")
	return cmd.do_doc(c)
}
