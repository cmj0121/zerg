# m — a module that owns an init() block and a module constant (Phase 1g).
#
# `answer` is a module constant: immutable, module-private, and evaluated once at
# init time — its initializer is a runtime call, so it is computed inside the
# module's init function, not at C static-init. `init()` runs exactly once, before
# the first use of the module from `main`.
#
# It carries its type. A module-level INFERRED binding (`answer := compute()`) is
# the form this compiler accepts and then drops, so the name goes missing at the
# use site instead of the declaration being refused — see Known deviations in the
# release notes. The typed const is the module constant that works.

# A module-private constant, evaluated at init from a runtime call.
const answer: int = compute()

# compute is module-private, used only to initialize the constant.
fn compute() -> int {
	return 40
}

# init() runs once; its `print` proves it ran exactly once even across two uses.
init () {
	print 1
}

# get exposes the module constant across the boundary (a pub accessor).
pub fn get() -> int {
	return answer
}
