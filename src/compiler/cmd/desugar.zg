# `zerg desugar`. The rewrite is `zerg/desugar.zg`'s; what is here is the command and the
# same bracket gate `fmt.zg` applies — a file of its own beside it, for the reason `zergc.zg`
# gives for the command being beside `fmt`.

import (
	"cli"
	"io"

	"./zerg"
)

# desugar takes the same two flags `fmt` does, and they mean the same things: `--check`
# asks the question without touching anything, and `--off` names a rule to leave alone.
pub fn desugar_cmd() -> cli.Command {
	return (
		cli.command("desugar", "rewrite sources into the core forms their sugar is defined as")
		.flag("c", "check", "report what is not already core and change nothing")
		.add(cli.argument("O", "off", "a rule code to leave alone, e.g. D103; repeatable").repeated())
		.add(cli.positional("path", "a `.zg` file, or a directory whose tree is rewritten").required().repeated())
		.run(do_desugar)
	)
}

fn do_desugar(c: cli.Ctx) -> int {
	# A PATH, NOT ONLY A FILE — see `do_fmt`.
	files := sources_from(c.args())

	return NOTHING_FOUND if files.len() == 0

	return run_desugar_check(files, c.all("off")) if c.has("check")

	run_desugar(files, c.all("off"))
	return 0
}

# run_desugar rewrites each source into the core forms its sugar is defined as. It is
# `run_fmt` with the other pass, down to the bracket gate: desugar reads the same token
# stream from the same lexer, so a file whose brackets do not close is one it would rewrite
# from a shape that means nothing.
#
# It writes IN PLACE, like `zerg fmt`, because the thing that runs it is a gate over a
# whole tree rather than a person over one file — `make desugar` copies the corpus and
# desugars the copy. Undoing the sugar in a source somebody is keeping is not what this is
# for, and the docs say so.
fn run_desugar(files: list[str], off: list[str]) {
	for f in files {
		src := read_source(f)

		# It lexes first, for the reason `zerg fmt` does: this rewrite is made out of the
		# token stream too, so text the lexer could not read is text the output would not
		# carry.
		lex_check(src, f)
		raise f"`{f}` has unbalanced brackets, so it cannot be desugared — the file is left as it is" if not zerg.fmt_balanced(src)

		out := zerg.desugar_src_off(src, off, f)
		if out != src {
			guard {
				io.write_file(f, bytearray(out))
			}
			io.write(f + "\n")
		}
	}
}

# run_desugar_check is the question `make desugar`'s fixpoint gate asks: is there any sugar
# left in this file. A desugared source that desugars again to something else would mean
# one of these rules produces what another one rewrites, which is the one way a pass like
# this can be wrong without any program behaving differently.
fn run_desugar_check(files: list[str], off: list[str]) -> int {
	mut bad := 0
	for f in files {
		src := read_source(f)
		lex_check(src, f)
		if not zerg.fmt_balanced(src) {
			io.ewrite(f"{f}: unbalanced brackets, so it cannot be desugared\n")
			bad = bad + 1
		} else if zerg.desugar_src_off(src, off, f) != src {
			io.ewrite(f"{f}: still holds sugar (run `zerg desugar`)\n")
			bad = bad + 1
		}
	}
	return 1 if bad > 0
	return 0
}
