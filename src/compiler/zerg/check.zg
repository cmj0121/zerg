# check.zg — the rules a program must satisfy, apart from the code that emits it.
#
# Every other file here answers "what C does this become". This one answers "is this a
# Zerg program at all", and it is separate for a reason that is not tidiness: for most of
# this compiler's life the answer was nobody's job. The seed has a semantic-analysis pass
# and the self-hosting compiler was written without one, so `x := 1` followed by `x = 2`
# compiled, `1 + "s"` produced pointer arithmetic, and a type error reached `cc` — which
# reported it against generated C under `.zerg-cache`, at a line the programmer cannot
# open. Each of those is the thing the project's standing rule forbids: a form is
# implemented, or refused BY NAME, and never silently wrong.
#
# The rules live here rather than in a pass of their own because the knowledge they need
# already exists in the emitter — `c_infer` computes a type for every expression and the
# environment already tracks every binding in scope. A separate pass today would mean a
# second walk and a second copy of inference, and the second copy is the one that drifts.
# So these functions take the Emitter and are called from the emission walk at the points
# that already know the answer. Collecting them in one file is what keeps the RULES
# readable as a set, and it is what makes lifting them into a real pass later a move
# rather than a rewrite — which is what has to happen when the AST learns to carry source
# positions, since a diagnostic without a line number is only half of one.
#
# What a message here looks like, and why it differs from the rest of the compiler:
#
#   `NotImplemented: …`  a form this compiler does not build yet. It disappears when the
#                        feature lands. Those live in emit.zg beside the form.
#   a plain sentence     an ill-formed PROGRAM. It is permanent and it is the language's
#                        answer, not this compiler's. Those live here.
#
# scripts/reject-check.sh is the gate, and it holds every rule here to both halves: the
# compiler must refuse the program, and the refusal must not come from cc.

# --- where a diagnostic happened --------------------------------------------------
#
# Every rule below reports through `chk_at`, which puts the place in front of the message.
# The position comes from the SAt marker the parser leaves before each statement, so it is
# where the STATEMENT starts rather than the exact token — the honest thing to say about
# that is that the line is always right and the column points at the beginning of the
# statement the error is in. Marking the token itself is what a span on every expression
# would buy, and what `chk_at` will hand over the moment one exists.

# chk_at RECORDS `msg` against the file, line and column of the statement being emitted,
# and lets emission carry on so the rest of the program is checked too. What it does not
# do is end the process, which is what every one of these rules used to do — a file with
# three mistakes reported one, and the second was a surprise waiting after the first fix.
#
# Carrying on is safe because the C built after a finding is thrown away: the driver hands
# nothing to cc once this list is non-empty. What it buys is every finding in one run.
fn chk_at(mut &em: Emitter, msg: str) {
	chk_at_place(em, em.at_path, em.at_line, em.at_col, msg)
}

# chk_at_place is the same, for a rule that KNOWS its place rather than reading the marker
# the emission walk left. A rule about a signature is one: it runs before any statement is
# emitted, so there is no marker yet to read.
#
# ONE MISTAKE EARNS ONE MESSAGE, so an exact repeat — same file, same line, same column,
# same sentence — is dropped here rather than at whichever caller happens to run twice.
# The walk revisits a statement for reasons of its own: a match arm's bindings are
# registered up to three times (condition, body, and the body's type inference), and a
# monomorphized generic emits its template body once per specialization — so one bad arm
# bind collected SIX copies of one finding. Deduping in the arm code would fix the caller
# of the week; every rule reports through here, so here is where the invariant lives. A
# program that genuinely makes the same mistake twice is still reported twice, because two
# occurrences differ in line or column — what cannot be told apart is two mistakes inside
# ONE statement, and a single statement-level place is the SAt marker's already-documented
# grain (see the header above).
fn chk_at_place(mut &em: Emitter, path: str, line: int, col: int, msg: str) {
	for d in em.diags {
		return if d.line == line and d.col == col and d.path == path and d.msg == msg
	}
	em.diags.append(Diag(path, line, col, msg, ""))
}

# --- visibility -------------------------------------------------------------------
#
# `pub` is the one visibility marker, and until now nothing read it. Every module flattens
# into one namespace, so a call to another module's module-private function resolved exactly
# as a call to its own — `pub` was parsed, carried on the declaration, and consulted by the
# linter alone.
#
# A MODULE IS A DIRECTORY, so the question is answered by comparing the directory a
# declaration was read from with the directory the reference is in. That is the whole of the
# rule this compiler enforces: the package layer above it — package-internal versus
# package-public, and the root module's re-export surface — needs a package to exist first,
# and none does.
#
# The entry file's own directory is deliberately NOT a module here. A file beside the entry
# is not compiled into the build at all, so nothing in it can be referenced and there is
# nothing for this rule to say about it.
fn c_mod_of(path: str) -> str {
	b := list[byte](path)
	mut cut := -1
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i
		}
		i = i + 1
	}
	return "" if cut < 0

	mut out: list[byte] = []
	mut j := 0
	for j < cut {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# chk_visible is the rule. It is quiet on a `pub` declaration, on one from the module doing
# the reading, and on one whose module is unknown — a generated declaration (a `derive`d
# impl, a monomorphized specialization) carries the path of whatever asked for it, and a
# rule that guessed there would refuse programs for a reason the reader cannot see.
fn chk_visible(mut &em: Emitter, name: str, decl_mod: str, is_pub: bool) {
	return if is_pub

	# A declaration with no module is a GENERATED one — a `derive`d impl, a monomorphized
	# specialization — carrying the path of whatever asked for it. There is no module a
	# reader could have written, so there is nothing to refuse them for.
	return if decl_mod == ""

	here := c_mod_of(em.at_path)
	return if here == decl_mod

	# And the reading module is unknown where no marker covers the code being emitted —
	# before the first statement of the first function, the marker still says nothing. A
	# module constant's initializer is NOT that case any more: c_const_assigns points the
	# marker at the declaration itself, so its module answers here like any other reader's.
	return if here == ""

	chk_at(em, f"`{name}` is not a public member of module `{c_last_segment(decl_mod)}`")
}

# chk_note is chk_at for something that is NOT an error. `L5xx` is the family that needs it:
# every implicit conversion is a lint finding, and every one of them is also a legal program,
# so it goes on a list that does not fail the build.
#
# It is here rather than in lint.zg because lint.zg answers from the parsed File alone — "no
# types, no flow analysis, which keeps it honest about what it can claim" — and a conversion
# is a fact about types. So the lowering walk, which has them, records it, and the linter asks
# the walk. That is the first rule in either file that needed more than the tree.
#
# NOTHING IS RECORDED UNLESS SOMEBODY ASKED. A build passes a `lints` list it then throws
# away, so without this flag every build paid the whole cost below for output nobody reads —
# and the cost is quadratic.
#
# DEDUPED BY PLACE, which is that cost: c_infer has no memo, so an expression is walked more
# than once and a rule that appends per walk reported the same conversion three times on a
# nested arithmetic chain. The scan is linear in what has been recorded, so the pass is
# quadratic in the number of findings — measured at 25% of `zerg lint`'s runtime on a program
# with eight thousand of them. Tolerated because it only runs when the answer is wanted, and
# because a program with thousands of findings has a bigger problem than the wait.
#
# It keys on the STATEMENT's place, which is all `chk_at`'s marker carries — so two conversions
# on one line collapse into one finding. That under-reports rather than over-reports, and the
# second appears once the first is fixed. A caller that KNOWS a narrower place says so with
# chk_note_at, and an integer literal is the one node that does: it carries the token's own
# line and column, because a fix an editor can apply has to point at what it would rewrite.
fn chk_note(mut &em: Emitter, msg: str) {
	chk_note_at(em, em.at_line, em.at_col, msg, "")
}

fn chk_note_at(mut &em: Emitter, line: int, col: int, msg: str, fix: str) {
	return if not em.want_lints

	for d in em.lints {
		return if d.line == line and d.col == col and d.path == em.at_path and d.msg == msg
	}
	em.lints.append(Diag(em.at_path, line, col, msg, fix))
}

# --- mutability ------------------------------------------------------------------
#
# A binding is immutable unless it says `mut`. That is not a diagnostic nicety — the
# memory model's "no shared mutable Zerg state" and its whole aliasing story rest on it,
# and until the environment carried `env_mut` there was nothing holding the other end of
# that promise.
#
# The check is on the ROOT of the assignment target, because writing `p.x` or `xs[0]`
# writes the binding `p` or `xs`: a value is owned by its binding and reaching into it
# does not create a second, more permissive one.

# chk_assignable raises unless `lhs` names storage this scope may write.
fn chk_assignable(mut &em: Emitter, lhs: Expr) {
	chk_store_path(em, lhs)
	root := chk_root_name(lhs)

	# NOT ROOTED IN A NAME AT ALL. A store target is a PLACE — a name, or a field or an index
	# reached from one — and `f() = 2` and `5 = 2` are values with nowhere to live. This used to
	# return here, on the belief that "emit has its own words for the shapes it cannot store
	# through"; emit has none, and rendered both to the left of a C `=`, so cc answered
	# "expression is not assignable" about generated code.
	if root == "" {
		chk_at(em, f"`{expr_kind(lhs)}` is not a place, and an assignment needs one — a name, or a field or an index reached from one")
		return
	}

	idx := c_live_idx(em, root)

	return if idx < 0

	return if em.env_mut[idx]

	# A MODULE binding is not an immutable local that could have been written `mut`, so
	# "declare it `mut`" is advice that cannot be taken and the answer says why instead.
	# There are TWO kinds of them and they are immutable for different reasons: a `const`
	# (GRAMMAR group 4) has no writable spelling in the language at all, while a plain
	# top-level binding is immutable because the TOP LEVEL is — `mut` there is legal only
	# inside a module-level `unsafe` group (docs/runtime/package.md). One sentence for both
	# called a plain `COUNT := 3` a `const`, which is a word the reader can go and look up
	# and find they did not write.
	# ONE of the sentences, never two. `raise` used to say that by leaving; a rule that
	# records instead has to say it with a `return`, and forgetting to is how the first run
	# of this reported the same assignment twice in two different words.
	if chk_is_module_binding(em, idx) {
		if em.env_const[idx] {
			chk_at(em, f"cannot assign to `{root}`: it is a module `const`, and a constant is never written — bind a `mut` copy of it if this function needs one")
		} else {
			chk_at(em, f"cannot assign to `{root}`: it is a module binding, and the top level is immutable — bind a `mut` copy of it here, since a `mut` binding at the top level is legal only inside a module-level `unsafe` group (docs/runtime/package.md)")
		}
		return
	}

	# `this` is the third of these: it is never DECLARED, so `mut this := …` is advice the
	# grammar has no spelling for. A method's receiver is a copy (GRAMMAR#fn-decl) and the form
	# that writes through it is `mut fn`, which is what the reader has to reach for.
	if root == "this" {
		chk_at(em, "cannot assign to `this`: a method's receiver is a copy, and the form that writes through it is `mut fn` — the one that marks a method as mutating the instance it is called on")
		return
	}

	# Everything else — a plain binding and a by-value parameter alike — is fixed the same
	# way, and for a parameter `mut n := n` is the ordinary idiom rather than a workaround.
	if c_ident_name(lhs) != "" {
		chk_at(em, f"cannot assign to `{root}`: it is immutable — declare it `mut {root} := …` to allow a write")
		return
	}
	chk_at(em, f"cannot assign through `{root}`: it is immutable — a write to a field or element writes the binding, so declare it `mut {root} := …`")
}

# chk_is_module_binding is whether an environment slot is one of the module-level bindings.
# c_reset_env seeds every function's environment with them FIRST and in k_decls' order, so
# they hold exactly the lowest indices and row `idx` IS `k_decls[idx]`; a local that shadows
# one binds above it and c_live_idx answers the inner one.
#
# It answers MEMBERSHIP and nothing else. Which KIND of module binding it is — whether the
# `const` keyword was written — is `env_const[idx]`, the flag the declaration carries, and
# asking the flag is not a thing position can be made to answer: a plain `COUNT := 3` at
# the top level is just as much a row here as a `const` is.
fn chk_is_module_binding(mut &em: Emitter, idx: int) -> bool {
	return idx < em.k_decls.len()
}

# --- a default is a property of the declaration ------------------------------------
#
# A default is judged ONCE, where the signature is read, rather than at the calls that
# happen to omit it. That is not tidiness: `spawn` and `defer` capture the defaults they
# backfill, so a bad one used to be diagnosed only when spawned — and the message named an
# argument the programmer never wrote.

# c_check_defaults judges every declared default in the program.
fn c_check_defaults(mut &em: Emitter, f: File) {
	for fn_d in f.fns {
		key := c_sig_key(fn_d.recv, fn_d.name)
		for pm in fn_d.params {
			chk_param_default(em, key, pm, fn_d.path, fn_d.line, fn_d.col)
		}
	}
}

# chk_param_default raises on a default that could never be legal at any call. It takes the
# declaration's PLACE rather than the declaration: this runs before any statement is
# emitted, so the SAt markers have said nothing and `em.at_*` still holds whatever the last
# unit left there.
fn chk_param_default(mut &em: Emitter, key: str, pm: Param, path: str, line: int, col: int) {
	return if not pm.has_def

	# a `mut &` takes the ADDRESS of a caller's variable; a default has none to take
	if pm.is_ref {
		chk_at_place(em, path, line, col, f"parameter `{pm.name}` of `{chk_call_name(key)}` is a `mut &` and cannot have a default — a reference needs a caller's variable to point at")
		return
	}

	got := c_infer(em, pm.def)
	return if chk_fits_expr(em, pm.ty, got, pm.def)
	chk_at_place(em, path, line, col, f"the default for `{pm.name}` of `{chk_call_name(key)}` is {ty_name(got)}, and the parameter is {ty_name(pm.ty)}")
}

# --- a pattern binds, and a construction gives, what the variant holds --------------

# chk_variant_arity raises when a constructor pattern or a construction names more values
# than the variant carries. `Rect(w, h)` against a `Rect(int)` emitted a read of a union
# member that was never declared, and cc reported it against generated C — the arm and the
# declaration disagree, and only one of them is on the screen the programmer is looking at.
# `Line(7, 8)` is that same disagreement from the other side of the enum, so `what` is the
# only thing that differs between them.
#
# BOTH directions, like chk_call_arity. Too FEW is the quieter half and the worse one:
# `Line(7)` against a `Line(int, int)` left `.f1` reading whatever zero-initialisation put
# there, and `Line(n) =>` bound one of two without a word.
fn chk_variant_arity(mut &em: Emitter, ctor: str, n: int, what: str) {
	held := chk_variant_held(em, ctor)
	return if n == held
	chk_at(em, f"`{ctor}` carries {chk_args(held)} and this {what} {strconv.to_string(n, 10)}")
}

# chk_variant_held is how many payload values a variant carries. The table holds one row per
# payload field and c_build_enums appends a variant's rows CONTIGUOUSLY, so the count ends
# where the run ends — the same early exit c_param_row makes over the parameter table.
fn chk_variant_held(mut &em: Emitter, ctor: str) -> int {
	mut n := 0
	mut i := 0
	for i < em.vf_variant.len() {
		if em.vf_variant[i] == ctor {
			n = n + 1
		} else if n > 0 {
			return n
		}
		i = i + 1
	}
	return n
}

# --- call shape -------------------------------------------------------------------
#
# `add(1)` on a two-parameter function reached cc as "too few arguments to function call",
# which is a true statement about generated C and no help at all: the C prototype it names
# is one this compiler wrote. The count is knowable here, where both the call and the
# signature are in hand.

# chk_callsite measures a whole resolved call against its signature — the arity and every
# argument. It exists for the calls that are not EXPRESSIONS: `spawn f(…)` and `defer f(…)`
# resolve a callee themselves and render its arguments with their own loop, so neither ever
# reaches c_args_from, where every other call is checked.
#
# `base` is 0 for all three callee shapes: a method's receiver leads the argument list here
# (the parser put `this` at parameter 0 when it flattened the impl block), so the parameter
# table lines up with no shift.
#
# `what` is the statement asking, so the borrow refusal says `spawn` or `defer` rather than
# describing both. The row is read once and answers both questions about the parameter,
# which is why the borrow check lives here rather than in a walk of its own.
fn chk_callsite(mut &em: Emitter, key: str, args: list[Expr], what: str) {
	chk_call_arity(em, key, 0, args.len())
	mut i := 0
	for i < args.len() {
		row := c_param_row(em, key, i)
		chk_argument(em, key, row, i + 1, args[i])

		# A `mut &` may not be CAPTURED. GRAMMAR#param says a borrow "cannot ESCAPE (be
		# captured by a spawn or stored past the call)", and both of these statements store
		# their arguments in an env to be used later — a spawn's may outlive the frame the
		# reference points into entirely. `spawn` refused this in a pass of its own;
		# `defer`, which the same sentence covers, reached cc.
		if row >= 0 and em.pr_ref[row] {
			chk_at(em, f"argument {strconv.to_string(i + 1, 10)} of `{chk_call_name(key)}` is a `mut &` and cannot cross a `{what}`: a borrow may not be captured, and this one would outlive the call it is valid for")
		}
		i = i + 1
	}
}

# chk_store_path raises when a WRITE has to pass through something that is not storage.
#
# `chk_root_name` only asks what the target is rooted at. The steps between are the ones
# that reached cc: `d["k"][0] = 7`, `n["a"]["b"] = 5` and `get()[0] = 99` each store into a
# value that C has no address for, and cc said "expression is not assignable" about a
# statement expression this compiler wrote. Every index on the path has to be a place,
# which is the same question `mut &` asks of an argument and a mutating method asks of its
# receiver — a write to a copy is not a write, and all three are that sentence.
fn chk_store_path(mut &em: Emitter, e: Expr) {
	tgt := chk_store_target(e)
	return if not c_is_index(e) and not c_is_fieldref(e)

	if c_is_index(e) and not c_is_place(em, tgt) {
		chk_at(em, f"cannot store through {c_place_why(em, tgt)} — it is a value rather than a place, so the write would land on a copy; bind it to a name first")
		return
	}
	chk_store_path(em, tgt)
}

# chk_str_not_indexable is the language's rule that a str has no subscript.
#
# docs/core/types.md: a str "iterates as `rune` and is NOT indexable" — it is UTF-8, so a
# subscript would name a byte rather than a character. The emitter named every other
# non-container while letting a str past, and what it fell into was the LIST path: `s[0]`
# read a `const char*` as a list header and printed whatever that came to, a different
# number every run, and `s[1..3]` handed the same pointer to zrt_list_slice and was
# reported by cc.
#
# A LANGUAGE rule, so it is checked rather than refused: it carries a place, and the seed
# has rejected it all along. The caller has already established the type, so this takes
# none — the question is asked in exactly one place.
# --- specs -----------------------------------------------------------------------
#
# What a `spec` guarantees is a SIGNATURE, so what an `impl` must supply is a signature.
# The check used to compare names, and only within one file:
#
#   fn tag() -> str          satisfied   fn tag(n: int) -> int
#   spec Ord: Eq             required     nothing of Eq
#   impl Nope for A          named        a spec that does not exist
#
# All three came from the same place — the spec was read by a token scanner into a
# comma-joined list of member names, held on the Parser, and checked when one file finished.
# A spec is now parsed, rides on the File, and is checked over the WHOLE program, which is
# the view the driver already builds before anything is emitted.
#
# What is compared, per docs/core/specs.md ("A spec bound is the complete interface to a
# generic type") and docs/code/functions.md ("the name is part of the function's contract"):
# arity, and at each POSITION the parameter's name, type and `mut &`, and whether it has a
# default — plus the return type. Position matters because Zerg has positional calls: if the
# order were free, every call through a spec would have to be written with named arguments.
#
# What is NOT compared is the default's VALUE. A default's presence decides which calls are
# legal, so it is interface; the value is what runs, and what runs is what an impl provides.
fn chk_spec_impls(mut &em: Emitter, f: File) {
	for ip in f.impls {
		si := chk_spec_index(f, ip.on)
		if si < 0 {
			chk_at_place(em, ip.path, ip.line, ip.col, f"no spec named `{ip.on}` — an `impl … for …` names the interface it supplies, and nothing in this program declares one by that name")
			continue
		}
		sp := f.specs[si]
		if sp.params.len() != ip.args.len() {
			# without this the mismatch surfaces one member at a time, as "parameter `k` is
			# int, and the spec declares K" — true, and about the wrong thing. What went
			# wrong is that the impl never said what `K` is.
			chk_at_place(em, ip.path, ip.line, ip.col, f"`{ip.on}` is parameterized by {chk_join(sp.params)}, and this `impl` gives {strconv.to_string(ip.args.len(), 10)} type argument(s) — a parameterized spec is implemented once per argument, as `impl {ip.on}[…] for {ip.target}`")
			continue
		}
		mut seen: list[str] = []
		chk_impl_covers(em, f, ip, si, seen)
	}
}

# chk_join renders a spec's type-parameter names for a message. ty_names wants a list[Ty],
# and building TNamed leaves purely to join them is a list to make one sentence.
fn chk_join(ns: list[str]) -> str {
	mut out := ""
	for n in ns {
		if out != "" {
			out = out + ", "
		}
		out = out + n
	}
	return out
}

fn chk_spec_index(f: File, name: str) -> int {
	mut i := 0
	for i < f.specs.len() {
		return i if f.specs[i].name == name
		i = i + 1
	}
	return -1
}

# chk_impl_covers checks one `impl` against one spec AND every spec that one extends.
#
# `spec Ord: Eq` makes an `impl Ord` also require `Eq` (GRAMMAR#spec-decl), and the whole clause
# used to be swallowed by the scan for `{`. `seen` is what keeps a diamond — two supers
# extending one spec — from being checked twice, and a cycle from not terminating.
fn chk_impl_covers(mut &em: Emitter, f: File, ip: ImplDecl, si: int, mut &seen: list[str]) {
	sp := f.specs[si]
	return if c_name_in(seen, sp.name)

	seen.append(sp.name)

	for req in sp.reqs {
		chk_impl_member(em, f, ip, sp, req)
	}
	for sup in sp.supers {
		up := chk_spec_index(f, sup)
		if up < 0 {
			chk_at_place(em, sp.path, sp.line, sp.col, f"`{sp.name}` extends `{sup}`, and nothing in this program declares a spec by that name")
			continue
		}
		chk_impl_covers(em, f, ip, up, seen)
	}
}

# chk_impl_member finds what the impl supplies for one required member, and compares it.
fn chk_impl_member(mut &em: Emitter, f: File, ip: ImplDecl, sp: SpecDecl, req: FnDecl) {
	for sup in f.fns {
		if sup.recv == ip.target and sup.name == req.name {
			why := chk_sig_differs(sp, ip, req, sup)
			if why != "" {
				chk_at_place(em, sup.path, sup.line, sup.col, f"`{ip.target}.{req.name}` does not match what `{sp.name}` requires: {why}")
			}
			return
		}
	}
	chk_at_place(em, ip.path, ip.line, ip.col, f"`{ip.target}` does not implement `{req.name}`, which `{sp.name}` requires")
}

# chk_sig_differs answers WHY two signatures differ, or "" when they do not.
#
# Both signatures carry their receiver as the first parameter — a required one gets `This`,
# which chk_spec_subst turns into the target — so the two are the same shape and are
# compared position for position with nothing to offset. That is also what makes `mut fn`
# comparable: it rides as the receiver's `mut &`, exactly like any other parameter's.
fn chk_sig_differs(sp: SpecDecl, ip: ImplDecl, req: FnDecl, sup: FnDecl) -> str {
	return f"it takes {chk_args(sup.params.len() - 1)}, and the spec declares {chk_args(req.params.len() - 1)}" if sup.params.len() != req.params.len()

	mut i := 0
	for i < req.params.len() {
		w := req.params[i]
		g := sup.params[i]
		at := strconv.to_string(i, 10)

		if i == 0 {
			return "it is a `mut fn` and the spec's is not — a `mut fn` mutates its receiver, so calling it needs a `mut` binding" if g.is_ref and not w.is_ref
			return "it is not a `mut fn` and the spec's is" if w.is_ref and not g.is_ref

			i = i + 1
			continue
		}
		return f"parameter {at} is named `{g.name}`, and the spec names it `{w.name}` — a named argument selects by that name, so it is part of the contract" if w.name != g.name

		wt := chk_spec_subst(w.ty, sp, ip)

		return f"parameter `{g.name}` is {ty_name(g.ty)}, and the spec declares {ty_name(wt)}" if not ty_eq(wt, g.ty)
		return f"parameter `{g.name}` is `mut &` and the spec's is not" if g.is_ref and not w.is_ref
		return f"parameter `{g.name}` is not `mut &` and the spec's is" if w.is_ref and not g.is_ref
		return f"parameter `{g.name}` has a default and the spec declares none — whether one may be omitted is the spec's to say" if g.has_def and not w.has_def
		return f"parameter `{g.name}` has no default and the spec declares one" if w.has_def and not g.has_def

		i = i + 1
	}

	return "it returns nothing, and the spec declares a result" if req.has_ret and not sup.has_ret
	return "it returns a value, and the spec declares none" if sup.has_ret and not req.has_ret

	rt := chk_spec_subst(req.ret, sp, ip)
	return f"it returns {ty_name(sup.ret)}, and the spec declares {ty_name(rt)}" if req.has_ret and not ty_eq(rt, sup.ret)

	return ""
}

# chk_spec_subst turns a type written in a SPEC into the type it means for one `impl`.
#
# Two things in a required signature are not concrete types yet. `This` is the implementing
# type — inside an `impl` the parser already resolves it (parser.zg), so the supplied
# signature holds the target and the required one must be brought to meet it. And a
# parameterized spec's own `K` is whatever `impl Ix[int]` bound it to, which is why the
# impl's type arguments are kept rather than skipped.
fn chk_spec_subst(t: Ty, sp: SpecDecl, ip: ImplDecl) -> Ty {
	return match t {
		TNamed(n)     => chk_subst_named(n, sp, ip)
		TList(e)      => TList(chk_spec_subst(e, sp, ip))
		TOpt(e)       => TOpt(chk_spec_subst(e, sp, ip))
		TMap(k, v)    => TMap(chk_spec_subst(k, sp, ip), chk_spec_subst(v, sp, ip))
		TChan(e, d)   => TChan(chk_spec_subst(e, sp, ip), d)
		TEither(l, r) => TEither(chk_spec_subst(l, sp, ip), chk_spec_subst(r, sp, ip))
		TTuple(es)    => TTuple(chk_subst_all(es, sp, ip))
		TFn(ps, r)    => TFn(chk_subst_all(ps, sp, ip), chk_spec_subst(r, sp, ip))
		_             => t
	}
}

fn chk_subst_named(n: str, sp: SpecDecl, ip: ImplDecl) -> Ty {
	return TNamed(ip.target) if n == "This"

	mut i := 0
	for i < sp.params.len() {
		# an argument the impl did not give leaves the parameter as it stands, so the
		# mismatch is reported about the type the reader wrote rather than about a
		# substitution that did not happen
		return ip.args[i] if sp.params[i] == n and i < ip.args.len()

		i = i + 1
	}
	return TNamed(n)
}

fn chk_subst_all(ts: list[Ty], sp: SpecDecl, ip: ImplDecl) -> list[Ty] {
	mut out: list[Ty] = []
	for t in ts {
		out.append(chk_spec_subst(t, sp, ip))
	}
	return out
}

# chk_int_literal rejects an integer literal that does not fit an i64.
#
# docs/core/types.md: "A literal that does not fit its required type is a COMPILE ERROR …
# never a runtime overflow", and the chapter's own deviation note says an int literal past
# i64 "is still rejected". It was not: the lexer accumulated the digits in a wrapping i64
# and handed the emitter whatever came out, so `9223372036854775808` printed
# -9223372036854775808, `99999999999999999999999` printed 200376420520689663 and
# `0xFFFFFFFFFFFFFFFFF` printed -1 — three wrong answers with no diagnostic anywhere.
#
# A LANGUAGE rule, so it carries a place. The seed has rejected all three all along.
fn chk_int_literal(mut &em: Emitter, lex: str) {
	if not int_fits(lex) {
		chk_at(em, f"the integer literal `{lex}` does not fit an `int` — it is 64 bits wide, and a literal past it is a compile error rather than a value that wraps")
	}
}

fn chk_str_not_indexable(mut &em: Emitter) {
	chk_at(em, "a `str` is not indexable — it is UTF-8, so a subscript would name a byte and not a character; convert it first with `list[byte](s)`")
}

fn chk_store_target(e: Expr) -> Expr {
	return match e {
		EIndex(t, _) => t
		EField(t, _) => t
		_            => e
	}
}

fn c_is_fieldref(e: Expr) -> bool {
	return match e {
		EField(_, _) => true
		_            => false
	}
}

# chk_arm_types raises when a `match` USED AS A VALUE has arms that answer different types.
#
# The whole match takes its type from the FIRST arm, which is the only one anything looked
# at: a later arm answering something else was rendered into the same conditional and cc
# reported the mismatch — as a WARNING under clang, so the program linked. Every arm has to
# be typed with its OWN payload bound, which is why this is a walk and not a comparison.
# chk_branch_types is chk_arm_types for the OTHER construct that answers one type from two
# places. `x := if false { 1 } else { 2.5 }` printed `2` — the float arm truncated into the int
# the first arm settled on — and where the two types have no C conversion between them the
# mismatch escaped the compiler entirely and `cc` reported it, against generated C.
#
# `match` has had the rule since arms could answer at all, and the sentence is deliberately the
# same shape: two constructs, one question, and a reader who has met one of these has met both.
# That an omission in one construct went unnoticed while the other was checked is the shape this
# compiler keeps finding — one rule, N places, written at fewer.
#
# THE OTHER OPERAND is not what decides here. Both branches are values with types of their own,
# so this is chk_fits and not the adoption question: a literal branch adopts nothing from its
# sibling, exactly as one match arm adopts nothing from the next.
fn chk_branch_types(mut &em: Emitter, then_e: Expr, else_e: Expr) {
	want := c_infer(em, then_e)
	got := c_infer(em, else_e)

	return if c_is_unknown(want) or c_is_unknown(got)
	return if ty_eq(want, TVoid) or ty_eq(got, TVoid)

	# A `nil` BRANCH HAS NO TYPE TO DISAGREE WITH. It is one of the four typeless forms, so
	# `x: int? = if c { 1 } else { nil }` is a carrier taking a value on one side and absence
	# on the other — two spellings of one `int?` and not two answers. Every OTHER branch does
	# bring its type, a literal included: a branch is not a typed position for its sibling, the
	# same way one match arm is not one for the next.
	return if ty_eq(want, TNil) or ty_eq(got, TNil)
	return if chk_fits(em, want, got) or chk_fits(em, got, want)

	chk_at(em, f"an `if` expression answers ONE type, and its branches give {ty_name(want)} and {ty_name(got)}")
}

fn chk_arm_types(mut &em: Emitter, arms: list[Arm], st: Ty) {
	return if arms.len() < 2

	want := c_infer_arm_body(em, arms[0], st)
	return if c_is_unknown(want) or ty_eq(want, TVoid)

	mut i := 1
	for i < arms.len() {
		got := c_infer_arm_body(em, arms[i], st)
		if not c_is_unknown(got) and not ty_eq(got, TVoid) and not chk_fits(em, want, got) {
			chk_at(em, f"a `match` answers ONE type, and its arms give {ty_name(want)} and {ty_name(got)}")
			return
		}
		i = i + 1
	}
}

# chk_ref_arg raises when a `mut &` argument is not a PLACE. A borrow is the caller's own
# storage handed over to be written, and `m["k"]` is a value however much it reads as one:
# it lowers to a statement expression, so `&` on it reached cc as "cannot take the address
# of an rvalue". The same sentence the mutating-method path uses, for the same reason —
# writing to a copy is not writing.
fn chk_ref_arg(mut &em: Emitter, key: str, pos: int, a: Expr) {
	if not c_is_place(em, a) {
		chk_at(em, f"{chk_arg_says(key, pos)} borrows {c_place_why(em, a)}, which is a value rather than a place — bind it to a name first")
		return
	}

	# TWO INDEPENDENT CONTROLS MEET HERE (GRAMMAR#param): the CALLER decides whether its
	# variable is `mut`, the CALLEE decides via `mut &` whether it writes back, and "a
	# caller-visible mutation needs BOTH". Only the callee's half was read, so `bump(k)` on
	# an immutable `k` wrote through it and printed the changed value — a write to a binding
	# the reader declared unwritable, with nothing said. There is no call-site marker to
	# warn them either: the signature is the whole contract.
	root := chk_root_name(a)
	return if root == ""

	idx := c_live_idx(em, root)
	return if idx < 0 or em.env_mut[idx]

	# `this` is never DECLARED, so `mut this := …` is advice the grammar has no spelling
	# for. A plain method holds its receiver by value; the half that is missing is on the
	# ENCLOSING method, and `mut fn` is how it is supplied.
	if root == "this" {
		chk_at(em, f"{chk_arg_says(key, pos)} writes back to `this`, and the enclosing method holds its receiver by value — declare that one `mut fn` too, or the mutation lands on a copy")
		return
	}
	chk_at(em, f"{chk_arg_says(key, pos)} writes back to `{root}`, which is not `mut` — a caller-visible mutation needs both halves, so declare it `mut {root} := …`")
}

# chk_arg_says names the slot a borrow rule is about. A method's RECEIVER has no written
# position, so numbering it would point at nothing on the page: `mut fn` is how it was
# declared and "the receiver" is what a reader calls it.
fn chk_arg_says(key: str, pos: int) -> str {
	# The SLOT and the fact that it borrows, as one clause — because the two read differently
	# and only one of them mentions `mut &`: a receiver borrows because the METHOD is a `mut
	# fn`, and an argument because its parameter says so. This used to hand back one
	# caller's half and have the other append its own, which read "argument 1 of `f` is a
	# `mut &` and is a `mut &`, and …".
	return f"the receiver of `{chk_call_name(key)}`, which is a `mut fn`," if pos == 0

	return f"{chk_slot_says(key, pos)} is a `mut &` and"
}

# chk_slot_says names an argument BY POSITION, the way chk_field_says names a struct's field.
# It is the plain name of the slot, with no clause about what is wrong with it, so a borrow
# rule and a fit rule can each finish the sentence their own way.
pub fn chk_slot_says(key: str, pos: int) -> str {
	return f"argument {strconv.to_string(pos, 10)} of `{chk_call_name(key)}`"
}

# chk_binding_says names a binding as a slot. chk_binding has a sentence of its own that reads
# better ("cannot bind str to a int binding: `n`"), and this is what the FLOOR in c_fit_copied
# says on the paths that reach it without passing that one — a carrier's payload, which is
# fitted below the declaration rather than at it.
pub fn chk_binding_says(name: str) -> str {
	return f"the binding `{name}`"
}

# CHK_ANSWER names the `return` slot. A returned value has no position and no name to give,
# so what the sentence can point at is the SIGNATURE.
#
# chk_returned uses it too, and that is the whole reason it is a name rather than a string at
# each site: both walks reach the same bad `return` and both report at the statement's place,
# so an identical sentence is ONE finding after chk_at_place's dedupe — and two the day the
# wording drifts by a word. It drifted, and a reader was told twice.
const CHK_ANSWER := "this function's answer"

# chk_ref_alias raises when one call hands the same variable to two `mut &` parameters.
#
# GRAMMAR#param — a `mut &` "cannot ALIAS (the same variable to two `mut &` in one call),
# which keeps it safe with no borrow checker". That sentence is the reason there is no
# borrow checker, and nothing was holding it: `two(k, k)` passed one address twice, so the
# callee's two names were one variable and the second write landed on top of the first.
fn chk_ref_alias(mut &em: Emitter, key: str, args: list[Expr]) {
	mut i := 0
	for i < args.len() {
		row := c_param_row(em, key, i)
		if row >= 0 and em.pr_ref[row] {
			ni := chk_root_name(args[i])
			mut j := i + 1
			for j < args.len() {
				rj := c_param_row(em, key, j)
				if ni != "" and rj >= 0 and em.pr_ref[rj] and chk_root_name(args[j]) == ni {
					chk_at(em, f"`{ni}` is given to two `mut &` parameters of `{chk_call_name(key)}` in one call — a borrow may not alias, which is what keeps it safe without a borrow checker")
					return
				}
				j = j + 1
			}
		}
		i = i + 1
	}
}

# chk_call_arity raises when a call passes too few or too many arguments. `base` is 1 for
# a method, whose receiver already fills parameter 0, and 0 for a free call.
fn chk_call_arity(mut &em: Emitter, key: str, base: int, argc: int) {
	# a key nothing registered is not a call this rule knows anything about — an
	# intrinsic, a constructor, a binding holding a function. Emit names those itself.
	row := c_sig_row(em, key)
	return if row < 0

	given := base + argc

	if given > em.sig_nparams[row] {
		chk_at(em, f"`{chk_call_name(key)}` takes {chk_args(em.sig_nparams[row])} and this gives {strconv.to_string(given, 10)}")
		return
	}
	if given < em.sig_nreq[row] {
		chk_at(em, f"`{chk_call_name(key)}` needs {chk_args(em.sig_nreq[row])} and this gives {strconv.to_string(given, 10)}")
	}
}

# chk_args counts arguments in words a reader does not trip over. "takes 1 arguments" is
# the kind of thing that makes a tool feel unfinished, and a message printed for someone
# else's mistake is the worst place to look unfinished.
fn chk_args(n: int) -> str {
	return "1 argument" if n == 1
	return strconv.to_string(n, 10) + " arguments"
}

# chk_call_name spells a signature key the way a reader wrote the call. A free function's
# key IS its name; a method's is `Type#name` internally, and `Type.name` on the page —
# both halves are worth printing, but the separator is an implementation detail nobody
# should have to meet in a diagnostic.
fn chk_call_name(key: str) -> str {
	bs := list[byte](key)
	mut out: list[byte] = []
	for b in bs {
		# a SPECIALIZATION's key carries its type arguments after a `$`, and the reader wrote
		# none of that — `two(1, "x")` was answered with "`two$int` takes int as argument 2".
		# The mangling is how the compiler tells two instantiations apart; it is not a name
		# any program contains, so it stops here, at the one place a key becomes a sentence.
		break if b == b'$'

		if b == b'#' {
			out.append(b'.')
		} else {
			out.append(b)
		}
	}
	return str(out)
}

# --- does a value fit a slot ------------------------------------------------------
#
# Three rules ask this one question — a declaration against its initializer, a `return`
# against its signature, an argument against its parameter, and an assignment against the
# storage it writes — and the answer has to be the same in all of them or the language has
# four type systems. It lives here once.
#
# It says no on a real MISMATCH and yes on everything it is unsure of. A slot whose type
# RESHAPES what it is given is never a mismatch: an optional wraps a bare value, a channel
# has its own direction check, a map literal takes its type from the declaration. `float`
# takes an `int` because the language mixes the two in arithmetic. And a type the compiler
# could not work out is not evidence of anything — refusing on TUnknown would turn every
# gap in inference into a rejected program.
#
# Everything else is `ty_eq`, which is a real comparison over the Ty enum. This used to be
# `ty_name(a) == ty_name(b)` restricted to the scalars, because `ty_name` is the DIAGNOSTIC
# SPELLING and collapses TUnknown, TTuple and TMap onto one name — so a struct bound to the
# wrong struct, a tuple to a map, and a `list[str]` to a `map` all went past this rule and
# reached cc, which is the failure this file exists to remove.

# chk_fits_expr is chk_fits asked of the EXPRESSION rather than of its type alone, and there
# is exactly one question that needs the difference: an untyped integer literal adopts a
# `float` context and an already-typed `int` VALUE does not (docs/core/types.md, "Numeric
# literals"). `x: float = 1` is the literal adopting its context like any other; `y: float
# = i` would be a silent widening of a value that already has a type, and the language says
# that needs `float(i)` — because the conversion is the place a lost bit is visible.
#
# The type-only chk_fits cannot tell those apart: both are TInt by the time it is asked. So
# the SIX slots a value enters ask this one — a binding, an assignment, a `return`, an
# argument, a parameter's default, and a struct literal's field. What still asks the type alone is the list-ELEMENT
# recursion, which has no expression to pass (it recurses on types pulled out of a
# container), and chk_arm_types, which compares two arms rather than a value against a slot.
#
# The pair `_expr` / plain is this file's existing shape for one question asked two ways —
# c_is_nil_lit and c_is_nil_expr are the same twins.
fn chk_fits_expr(mut &em: Emitter, want: Ty, got: Ty, e: Expr) -> bool {
	# A LITERAL ADOPTS ITS POSITION; A VALUE DOES NOT. That is the whole of what a position
	# does to a number — docs/core/type-system.md's "a position may WRAP a value; it never
	# CONVERTS one" — so the only expression this clause lets across a type boundary is one
	# that has no type of its own to keep.
	#
	# `x: byte = 5` is a byte written as a byte. `x: byte = 300` is the same well-typedness
	# failing as a CONSTANT, because the compiler holds the value and knows the conversion
	# raises — chk_const_into's sentence, which points at the number rather than at the
	# annotation. And `x: byte = n` for an `int` binding is now neither: it is a value being
	# re-typed, which is a refusal with `byte(n)` as the fix.
	if chk_int_lit(e) and chk_into_builtin(want, got) and chk_lit_shaped(want, e) {
		chk_const_into(em, want, e)
		return true
	}

	# A USER `Into` DOES NOT FIRE HERE EITHER, and for the same one sentence. `impl Into[int]
	# for S` declares what `S` converts to; it does not make `n: int = s` that conversion.
	# Written `s.into()`, the position sees an `int` and never asks.

	# A LIST LITERAL is built INTO its destination, element by element, with the declared
	# element type — so `xs: list[byte] = [1, 2]` is two bytes written into a byte buffer and
	# not a `list[int]` reinterpreted. The stride rule in chk_fits is about a container that
	# already EXISTS; a literal is not one yet.
	#
	# It is asked HERE and not at the binding, which is where it used to live: a list literal
	# also arrives as an argument, a return, an assignment and a parameter's default, and at
	# those four `f([1, 2])` on a `list[byte]` parameter was refused while the binding spelling
	# of the same thing was allowed. One rule, six slots — the same shape this file has now
	# had to fix three times.
	return chk_elems_fit(em, want, e) if c_is_list(want) and c_is_listlit(e) and c_is_list(got)

	return chk_fits(em, want, got)
}

# chk_elems_fit is whether every element of a list literal fits the declared element type. It
# asks chk_fits_expr per element, which is the same question the value slots ask — a literal
# element adopts, a typed value does not — so a list literal is not a place the rules go
# quiet. Asking the two element TYPES instead, which is what this replaced, cannot tell an
# untyped literal adopting `byte` from a byte VALUE being widened.
fn chk_elems_fit(mut &em: Emitter, want: Ty, ival: Expr) -> bool {
	we := c_list_elem(want)

	# IT REPORTS HERE AND ANSWERS YES, which reads backwards and is the point. Answering no
	# sent the caller to its own sentence, and the caller compares the two CONTAINERS — so a
	# literal whose first element is right and whose third is wrong was reported as
	# "cannot bind list[float] to a list[float] binding", the same type printed twice. A
	# reader is told nothing is wrong, in an error.
	#
	# The element is where the mistake is, so the element is what the sentence names, by
	# POSITION, exactly as a struct literal's field does — the two are the same shape of
	# mistake and now read the same way. Every bad element is named, not only the first: the
	# dedupe in chk_at_place is per message, so three wrong elements are three sentences.
	mut reported := false
	mut i := 0
	for e in c_listlit_elems(ival) {
		i = i + 1
		got := c_infer(em, e)
		if not chk_fits_expr(em, we, got, e) {
			chk_at(em, f"{chk_elem_says(i)} is {ty_name(we)}, and this gives {ty_name(got)}")
			reported = true
		}
	}
	return true if reported

	return true
}

# chk_elem_says names a list literal's element BY POSITION, the way chk_field_says names a
# struct's field, and it is shared with the emitter's element floor — because a slot named two
# ways is two findings about one mistake, and chk_at_place can only dedupe sentences that
# match. `pos` arrives 1-based, which is this file's convention for both.
pub fn chk_elem_says(pos: int) -> str {
	return f"element {strconv.to_string(pos, 10)} of this list literal"
}

# chk_into_builtin is the built-in `Into` matrix — docs/core/types.md's table of seven pairs,
# written as the shape it has rather than as seven rows.
#
# THE SHAPE IS A HUB, AND THE HUB IS `int`. Every pair in that table has `int` on one side:
# out of it go `int → float`, `int → byte`, `int → rune`, `int → uint`, and into it come
# `byte → int`, `rune → int`, `uint → int`. That is not a coincidence in the table — it IS the
# one-step rule. `byte → float` is absent precisely because it would be `byte → int → float`,
# and a spec that forbids chaining cannot then ship one.
#
# So there are two clauses and no list, and the fixed-width ladder the spec adds as stdlib
# types joins by being given a class and a width in c_scalar_class / c_scalar_bits and nothing
# else — which is what docs/core/types.md means by adding a width "without touching the
# grammar".
#
# `float → int` is the one asymmetry, and it is the spec's: dropping a fraction is a decision,
# so it is written `int(x)` or taken with `//`.
fn chk_into_builtin(want: Ty, got: Ty) -> bool {
	return false if not chk_into_side(want) or not chk_into_side(got)

	# out of the hub, and INTO it — "every OTHER numeric scalar" both times. `int` on both
	# sides is not a conversion, and the clause below said it was: every `int` reaching an
	# `int` slot went through a lowering that casts it to itself, and L501 reported 1583
	# findings of which most read "int converts to int".
	return true if c_is_int(got) and not c_is_int(want)

	return c_is_int(want) and not c_is_int(got) and not c_is_float(got)
}

# chk_const_into is the CONSTANT layer of `Into`, and it has a sentence of its own because it
# is not a type error. `b: byte = 300` type-checks — `int → byte` is a conversion this language
# has — and what is wrong with it is the VALUE. Saying "cannot bind int to a byte binding"
# there was true before Into existed and is misleading now: it points at the annotation, when
# the fix is the number.
#
# It is reported at compile time rather than left to raise because the compiler has the value
# in its hand. Reachability does not enter into it — `if false { b: byte = 300 }` is the same
# error — for the reason Go gives about the same construct: a constant that cannot exist is
# not made acceptable by not being reached.
fn chk_const_into(mut &em: Emitter, want: Ty, e: Expr) {
	# THE DIVISOR FIRST, because a tree that cannot be computed has no value to be out of
	# range. `x: byte = 1 / 0` said "`this` is not a value a byte holds" — true, and about the
	# wrong thing: nothing is wrong with the range, the division cannot happen. And at a FLOAT
	# target there is no range question at all, so `x: float = 1 / 0` reached the emitter and
	# answered `inf`. chk_binary asks the same question of every other expression, but a
	# literal tree at a typed position is rendered by c_into and never reaches it.
	chk_const_into_at(em, want, e, true)
}

# chk_const_into_at is the same rule with the L502 note made optional, and `noted` is the one
# question that separates an ADOPTION from a WRITTEN conversion.
#
# `b: byte = 5` is a literal taking a type the page does not show, which is what L502 reports.
# `byte(5)` shows it — and so does `b'\n'`, which the parser desugars to exactly that
# conversion over the literal `10`. Noting the written form told the compiler's own source to
# "write `byte(10)`" about three lines that already said `b'\n'` and `b'/'`, and `make lint`
# went red on the tree it is run against. The RANGE half is wanted at both; the note is not.
fn chk_const_into_at(mut &em: Emitter, want: Ty, e: Expr, noted: bool) {
	# THE DIVISOR FIRST, because a tree that cannot be computed has no value to be out of
	# range. `x: byte = 1 / 0` said "`this` is not a value a byte holds" — true, and about the
	# wrong thing: nothing is wrong with the range, the division cannot happen. And at a FLOAT
	# target there is no range question at all, so `x: float = 1 / 0` reached the emitter and
	# answered `inf`. chk_binary asks the same question of every other expression, but a
	# literal tree at a typed position is rendered by c_into and never reaches it.
	return if chk_const_divisors(em, e)
	return if chk_lit_fits_noted(em, want, e, noted)
	return if chk_const_unfoldable(em, want, e)

	chk_at(em, f"`{chk_lit_offender(em, want, e, false)}` is not a value a {ty_name(want)} holds — the conversion is known here, so it is reported now rather than raised")
}

fn chk_lit_fits_noted(mut &em: Emitter, want: Ty, e: Expr, noted: bool) -> bool {
	return chk_lit_adopts(em, want, e) if noted

	return chk_lit_fits(em, want, e)
}

# chk_const_divisor refuses a division whose divisor is a constant zero.
#
# It is the const rule of docs/core/types.md at the one operator that can fail without any type
# being wrong: the compiler holds the divisor, the divisor is `0`, and the division is known to
# raise. Reachability does not enter into it — `if false { 1 / 0 }` is the same error — for the
# reason Go gives about the same construct, that a value which cannot exist is not made
# acceptable by not being reached.
#
# It is asked HERE, of every binary expression, rather than inside the fold: the fold runs only
# where a literal ADOPTS a type, and `x := 1 / 0` adopts nothing (`int` is already the default),
# while `x: float = 1 / 0` folds no integers at all and used to answer `inf`. One question, one
# place, every operator that divides.
fn chk_const_divisor(mut &em: Emitter, oper: str, eb: Expr) -> bool {
	return false if oper != "/" and oper != "%" and oper != "//"

	f := chk_lit_eval(eb)
	return false if not f.ok or f.value != 0

	chk_at(em, f"this divides by a constant `0` — the value is known here, so it is reported now rather than raised")
	return true
}

# chk_const_unfoldable is the tree whose ARITHMETIC leaves i64, as against the one whose answer
# leaves the target. The two need different sentences and got one: `x: uint = 9223372036854775807
# + 1` said "`this` is not a value a uint holds", which is false twice over — 2^63 is a perfectly
# good `uint`, and the compiler never worked the value out to have an opinion about it. What
# happened is the fold overflowing the `int` every literal is measured against, which is the same
# limit that makes the upper half of `uint` unwritable (docs/core/types.md marks it).
#
# A leaf past i64 is somebody else's finding — chk_int_literal reports it where the lexeme is —
# so this speaks only when every leaf fits and the arithmetic between them does not.
fn chk_const_unfoldable(mut &em: Emitter, want: Ty, e: Expr) -> bool {
	f := chk_lit_eval(e)
	return false if f.ok or not chk_lit_leaves_fit(e)

	chk_at(em, f"this expression's value is past what an `int` holds, so it cannot be measured against {ty_name(want)} — every literal is measured against `int` before its position is consulted")
	return true
}

fn chk_lit_leaves_fit(e: Expr) -> bool {
	return match e {
		EInt(lex, _, _) => int_fits(lex)
		EUnary(_, x) => chk_lit_leaves_fit(x)
		EBinary(_, a, b) => chk_lit_leaves_fit(a) and chk_lit_leaves_fit(b)
		_ => false
	}
}

# chk_const_divisors is the same question asked of a whole literal tree, for the trees that
# never reach chk_binary — the ones c_into renders itself. It answers whether it reported, so
# the caller can stop: a tree that cannot be computed has no value to measure.
fn chk_const_divisors(mut &em: Emitter, e: Expr) -> bool {
	return match e {
		EUnary(_, x) => chk_const_divisors(em, x)
		EBinary(o, a, b) => chk_const_divisors_pair(em, o, a, b)
		_ => false
	}
}

fn chk_const_divisors_pair(mut &em: Emitter, o: str, a: Expr, b: Expr) -> bool {
	# every side is walked before the answer is taken, so two bad divisors are two findings
	l := chk_const_divisors(em, a)
	r := chk_const_divisors(em, b)
	here := chk_const_divisor(em, o, b)

	return l or r or here
}

# chk_lit_offender names the number the reader has to change, which in a folded expression is
# not always the one it folds to. `x: byte = 300 - 100` folds to `200`, and `200` is a perfectly
# good byte — what is wrong with the line is the `300`, and a sentence about `200` sends the
# reader looking for a mistake that is not there.
#
# So it descends to the DEEPEST part that does not fit and names that; when every part fits and
# only the answer does not — `200 + 100` — the answer is the deepest thing wrong, and it is
# named. One rule, both cases.
fn chk_lit_offender(mut &em: Emitter, want: Ty, e: Expr, neg: bool) -> str {
	return match e {
		EUnary(_, x) => chk_lit_offender(em, want, x, not neg)
		EBinary(_, a, b) => chk_lit_offender_pair(em, want, a, b, neg, e)
		_ => chk_lit_says(e, neg)
	}
}

fn chk_lit_offender_pair(mut &em: Emitter, want: Ty, a: Expr, b: Expr, neg: bool, whole: Expr) -> str {
	return chk_lit_offender(em, want, a, false) if not chk_lit_in_range(em, want, a, false)
	return chk_lit_offender(em, want, b, false) if not chk_lit_in_range(em, want, b, false)

	return chk_lit_says(whole, neg)
}

# chk_lit_says renders an integer literal the way it was WRITTEN, minus and all. The lexeme is
# on the node (every literal keeps its surface text so `fmt` can print it back verbatim), so
# this reads it rather than re-rendering the parsed value — `0x1_00` in the source should be
# `0x1_00` in the diagnostic, not `256`.
fn chk_lit_says(e: Expr, neg: bool) -> str {
	return match e {
		EUnary(_, x) => chk_lit_says(x, not neg)
		EInt(lex, _, _) => chk_lit_sign(lex, neg)
		EBinary(_, _, _) => chk_lit_folded_says(e, neg)
		_ => "this"
	}
}

# chk_lit_folded_says names a folded constant by the VALUE it folded to, which is the number
# the reader has to change. Naming the expression instead — "`200 + 100`" — would repeat the
# line back at them; what is wrong with `x: byte = 200 + 100` is that it is `300`, and `300`
# is what the sentence says. A fold that failed has no value to name and falls back to "this",
# which is the same answer every other unfoldable expression gets.
fn chk_lit_folded_says(e: Expr, neg: bool) -> str {
	f := chk_lit_eval(e)
	return "this" if not f.ok

	v := f.value
	return strconv.to_string(0 - v, 10) if neg

	return strconv.to_string(v, 10)
}

fn chk_lit_sign(lex: str, neg: bool) -> str {
	return f"-{lex}" if neg

	return lex
}

# chk_lit_note is `L502` — the literal took a type the page does not show. It is the half of
# `L5xx` that is about ADOPTION rather than conversion, and the spec asks for it deliberately:
# the point is that `1` and `1.0` should always mean different types in the source, so a reader
# never has to infer a literal's type from its surroundings. `1.5 + 1` is reported and
# `1.5 + 1.0` is not.
#
# An integer literal reaching an `int` is not adoption — that is the type it already had — and
# a fractional literal never reaches here at all, because chk_lit_fits only answers about
# integer ones.
fn chk_lit_note(mut &em: Emitter, want: Ty, e: Expr) {
	return if c_is_int(want)

	chk_lit_note_leaves(em, want, e, false)
}

# chk_lit_note_leaves reports the LEAVES of a literal tree, one finding each, rather than the
# tree as a whole.
#
# The tree has no spelling of its own to show — and the number it folds to is not one the
# reader can act on. `x: float = 1 / 2` reported ``the literal `0` is a float here``: `0` is
# the INTEGER fold of an expression this compiler computes as `0.5`, so the finding named a
# value the program never holds. The leaves are what the reader would change, and what a fix
# would rewrite: `1` and `2` each become `1.0` and `2.0`, and the type is on the page.
fn chk_lit_note_leaves(mut &em: Emitter, want: Ty, e: Expr, neg: bool) {
	match e {
		EUnary(_, x) => chk_lit_note_leaves(em, want, x, not neg)
		EBinary(_, a, b) => chk_lit_note_pair(em, want, a, b)
		_ => chk_lit_note_leaf(em, want, e, neg)
	}
}

# chk_lit_note_leaf reports ONE leaf, at the LEAF's own place rather than the statement's.
#
# That is what makes the finding actionable rather than only true. `x: float = 1 / 2` has two
# of them on one line, and a finding that points at the statement points at both — an editor
# cannot rewrite "the `1`" when the place it is given is the `x`. The token's line and column
# ride on `EInt` for exactly this, and they are also what stops the two from deduping into one:
# chk_note_at keys on the place, and these two places differ.
fn chk_lit_note_leaf(mut &em: Emitter, want: Ty, e: Expr, neg: bool) {
	shown := chk_lit_shown(want, e, neg)
	msg := f"L502 the literal `{chk_lit_says(e, neg)}` is a {ty_name(want)} here — write `{shown}` and the page shows it"

	# THE SENTENCE AND THE FIX ARE ONE DECISION, made here and carried in one Diag. A server
	# that read `shown` back out of `msg` would be a second copy of it, and the day the wording
	# changes the copy silently rewrites source into something else.
	#
	# A NEGATED leaf is not offered one: the `-` is a node ABOVE the digits and the place is the
	# digits', so replacing at that place would drop the sign — `-1` would become `1.0`. The
	# finding still reports; what it withholds is the mechanical answer, which is the honest
	# thing to withhold when the place and the thing to rewrite are not the same span.
	match e {
		EInt(_, line, col) => chk_note_at(em, line, col, msg, chk_fix_unless(neg, shown))
		_ => chk_note(em, msg)
	}
}

fn chk_fix_unless(neg: bool, shown: str) -> str {
	return "" if neg

	return shown
}

fn chk_lit_note_pair(mut &em: Emitter, want: Ty, a: Expr, b: Expr) {
	chk_lit_note_leaves(em, want, a, false)
	chk_lit_note_leaves(em, want, b, false)
}

# chk_lit_shown is the literal written so that its type is visible — the fix the finding hands
# over, and the rewrite an editor can apply from it. Only `float` has a second spelling to
# offer; a `byte` or a `uint` literal has no surface form of its own, so for those the finding
# names the type and the reader writes the annotation.
fn chk_lit_shown(want: Ty, e: Expr, neg: bool) -> str {
	return f"{ty_name(want)}({chk_lit_says(e, neg)})" if not c_is_float(want)

	return f"{chk_lit_says(e, neg)}.0"
}

# chk_lit_adopts is the fit AND the finding, because a literal that takes a type is L502
# wherever it happens and the two are never wanted apart. Written as three separate pairs, a
# fourth adoption position added later would have silently reported nothing.
fn chk_lit_adopts(mut &em: Emitter, want: Ty, e: Expr) -> bool {
	return false if not chk_lit_fits(em, want, e)

	chk_lit_note(em, want, e)
	return true
}

# chk_into_side is whether a type may stand on either side of a built-in Into. A NUMERIC
# scalar may. `bool` is a scalar and may not — `bool(8)` is a zero test rather than a widening,
# and nothing about it is the value being carried across. A `type X = Y` may not either, and
# that is the whole point of a strong typedef: c_scalar_class answers about the NAME, not the
# representation, so a `Celsius` is not an `int` here however it is stored.
fn chk_into_side(t: Ty) -> bool {
	cls := c_scalar_class(t)

	return cls == SC_SIGNED or cls == SC_UNSIGNED or cls == SC_FLOAT
}

# chk_lit_fits is the second half of adoption, and it is not optional: a literal adopts the
# type its context demands ONLY if it is a value of that type. docs/core/types.md — "A
# literal that does not fit its required type is a compile error (`byte = 300`, `uint = -1`)
# — never a runtime overflow."
#
# Adoption without the range check is strictly worse than no adoption: `take(1000)` on a
# `byte` parameter would go from a diagnostic to a silent truncation, which is the trade the
# byte-widening comment in chk_fits already refused once.
fn chk_lit_fits(mut &em: Emitter, want: Ty, e: Expr) -> bool {
	# ONLY A NUMERIC SCALAR IS A TYPE A NUMBER ADOPTS. Without this line the range check fell
	# through to "no bounds to test" for everything that is not one, so an `int?` ACCEPTED the
	# literal `1` — and the moment c_infer_binary started asking, `x + 1` for an `int?` typed
	# itself `int?` and the diagnostic became one about printing a carrier.
	return false if not chk_into_side(want)

	# THE SHAPE BEFORE THE RANGE, and it is chk_lit_shaped's answer rather than a second copy
	# of it — chk_fits_expr asks the same question before it ever reaches here, and a tree the
	# two of them disagreed about would adopt at one caller and not at the other.
	return false if not chk_lit_shaped(want, e)

	# A FLOAT CARRIES NO BOUNDS, so the shape is the whole of its test; every other target has
	# a range, and chk_lit_in_range accepts exactly the expressions chk_int_lit does.
	return true if c_is_float(want)

	# THE UPPER HALF OF `uint` IS A LITERAL TOO. Every integer literal is measured against `int`
	# by the walk that reads it — the right bound for one with no position to ask, and the wrong
	# one here: `u: uint = 18446744073709551615` was rejected with "does not fit an `int`" about
	# a value that is an ordinary `uint` and reachable by arithmetic. The position says which
	# bound applies, and this is where the position is known.
	return true if c_is_uint(want) and chk_uint_lit_fits(e)

	return chk_lit_in_range(em, want, e, false)
}

# chk_lit_in_range walks down to the literal, `neg` recording whether an odd number of
# minuses stands above it — the sign is a unary node rather than part of the lexeme, so it
# is carried down instead of parsed. It answers on the VALUE, so `-0` is in range for a
# `uint` and `-1` is not.
fn chk_lit_in_range(mut &em: Emitter, want: Ty, e: Expr, neg: bool) -> bool {
	return match e {
		EUnary(o, x) => chk_lit_minus(em, want, o, x, neg)
		EBinary(o, a, b) => chk_lit_pair_in_range(em, want, o, a, b, neg)
		EInt(lex, _, _) => chk_int_in_range(em, want, int_value(lex), neg)
		_ => false
	}
}

# chk_lit_pair_in_range is the fold, and WHERE it happens is the whole rule: the literals take
# the type the position demands and the arithmetic then happens IN THAT TYPE, so every step is
# measured against it — the operands first, and then what they make.
#
# That order is the difference between two designs that agree about `x: byte = 100 + 100` and
# disagree about everything harder. Folding FIRST, at some wider precision, and range-checking
# only the answer would accept `x: byte = 300 - 100`, where a reader is shown a `300` in a byte
# context and told nothing — and, worse, would make `x: float = 1 / 2` an INTEGER division
# folded to `0` and then widened, which is the silent-integer-division trap the language
# refuses `int + float` to avoid. Here the two literals are floats before the `/` runs.
#
# So an operand that does not fit is out of range, and a RESULT that does not fit is out of
# range, and the sentence a reader gets is chk_const_into's — about the value, not the
# annotation. The compiler is doing early what the runtime would do late, with the same
# checked rules, which is what keeps the two answers from drifting.
fn chk_lit_pair_in_range(mut &em: Emitter, want: Ty, o: str, a: Expr, b: Expr, neg: bool) -> bool {
	return false if not chk_lit_oper(o)
	return false if not chk_lit_in_range(em, want, a, false) or not chk_lit_in_range(em, want, b, false)

	# a float carries no bounds to test — chk_lit_fits never asks it — so a pair reaching here
	# is an integer one, and it is folded as one
	f := chk_lit_eval_pair(o, a, b)
	return false if not f.ok

	return chk_folded_in_range(em, want, f.value, neg)
}

# chk_folded_in_range hands a SIGNED fold to chk_int_in_range, which speaks magnitude-and-sign
# because that is the shape a literal arrives in: the `-` is a node above the digits, never
# part of them. A fold has no such node — it has a number — so the sign is split back out
# here rather than at each caller, and `uint = 0 - 1` is refused instead of passing a negative
# magnitude to a test that reads it as a large positive one.
fn chk_folded_in_range(mut &em: Emitter, want: Ty, v: int, neg: bool) -> bool {
	return chk_int_in_range(em, want, v, neg) if v >= 0

	return match guard { 0 - v } {
		Left(m)  => chk_int_in_range(em, want, m, not neg)
		Right(_) => false
	}
}

# Folded is a constant the compiler worked out, or the news that it could not. `ok` is false
# for a division by zero and for a fold that leaves i64 — neither is a value, and neither is
# this function's to report: an expression that cannot be folded is simply not one that adopts,
# and the position then says what it always said about a value of the wrong type.
struct Folded {
	ok: bool
	value: int
}

# chk_lit_eval works out an all-literal expression's value.
#
# THE COMPILER'S OWN ARITHMETIC IS CHECKED, which is the trap here: folding `a * b` for two
# large literals would raise inside the compiler and take the process down, reporting an
# overflow in the compiler about an overflow in the program. `guard` is exactly the tool for
# that — it demotes the raise to a value — so the fold asks for the answer and is told when
# there is none.
#
# A UNARY MINUS IS `0 - x`, and it folds as one rather than through a negation of its own: it
# is the same subtraction the runtime would perform, so it reaches the same overflow at i64's
# floor, where negation is the one place unary arithmetic has an answer it cannot hold. Any
# OTHER unary operator is not arithmetic chk_lit_oper knows, so the pair below folds it to
# nothing — which is what a `not` over a literal should fold to.
fn chk_lit_eval(e: Expr) -> Folded {
	return match e {
		# A LEXEME PAST i64 HAS NO VALUE HERE. int_value answers `0` for one — deliberately,
		# because the width is reported where the place is known — and a fold that believed it
		# said "this divides by a constant `0`" about `n % 99999999999999999999`, naming a
		# number that is not on the line. A leaf the compiler cannot hold is a fold that cannot
		# happen, which is what `ok` is for.
		EInt(lex, _, _) => Folded(int_fits(lex), int_value(lex))
		EUnary(o, x) => chk_lit_eval_pair(o, EInt("0", 0, 0), x)
		EBinary(o, a, b) => chk_lit_eval_pair(o, a, b)
		_ => Folded(false, 0)
	}
}

fn chk_lit_eval_pair(o: str, a: Expr, b: Expr) -> Folded {
	# THE OPERATOR IS ASKED FIRST, because chk_lit_apply has to end in some number and would
	# hand back `0` for one it does not know — a value, and the wrong one. Asked here, an
	# unknown operator is the absence of a value instead, which is what it is.
	return Folded(false, 0) if not chk_lit_oper(o)

	fa := chk_lit_eval(a)
	fb := chk_lit_eval(b)
	return Folded(false, 0) if not fa.ok or not fb.ok

	return match guard { chk_lit_apply(o, fa.value, fb.value) } {
		Left(v)  => Folded(true, v)
		Right(_) => Folded(false, 0)
	}
}

# chk_lit_apply is the arithmetic itself, under the guard above. It is written with the
# language's own operators rather than with a table of C semantics, so a constant and the
# runtime that would have computed it cannot disagree — `/` and `%` are Euclidean in both
# because they are the same operator.
#
# The last line is unreachable — chk_lit_eval_pair has already refused every operator this
# list does not name — and is here because a function ends in a value.
fn chk_lit_apply(o: str, x: int, y: int) -> int {
	return x + y if o == "+"
	return x - y if o == "-"
	return x * y if o == "*"
	return x / y if o == "/"
	return x % y if o == "%"
	return x // y if o == "//"

	return 0
}

# a match arm takes no guard, so the `-` test is its own function rather than a condition on
# the arm above
fn chk_lit_minus(mut &em: Emitter, want: Ty, o: str, x: Expr, neg: bool) -> bool {
	return false if o != "-"

	return chk_lit_in_range(em, want, x, not neg)
}

# chk_int_in_range asks the SCALAR TABLE for the bounds rather than listing them. It used to
# spell `255` and "no negative side" by hand, which is the second copy of what
# c_signed_lo / c_unsigned_hi render into C — and a literal the checker says fits while the
# conversion says it does not is exactly the drift one table prevents. It also meant a `rune`
# had no arm at all, so nothing range-checked one.
#
# An `int` at full width is left alone: a literal past i64 is the LEXER's to refuse, because
# a value this cannot represent is not one it can compare.
fn chk_int_in_range(mut &em: Emitter, want: Ty, v: int, neg: bool) -> bool {
	cls := c_scalar_class(want)

	return true if cls != SC_SIGNED and cls != SC_UNSIGNED

	# A RUNE is asked its own question, because its values are not a range: the width test
	# below would accept a surrogate, and `zrt_conv_rune` — the run-time half of this very
	# rule — refuses one. A literal the checker admits and the conversion rejects is exactly
	# the drift the shared bound functions exist to prevent, so the two halves of the rune
	# answer are stated together (chk_rune_ok here, zrt_is_rune there).
	return chk_rune_ok(v) if not neg and c_is_rune(c_repr_of(em, want))
	return v == 0 if c_is_rune(c_repr_of(em, want))

	# THE SIGN QUESTION IS NOT A QUESTION ABOUT WIDTH. An unsigned target has no negative
	# side at any width, so asking the width first let `uint = -1` through — `uint` is 64
	# bits, which is exactly where the magnitude check stops having anything to say.
	return v == 0 if neg and cls == SC_UNSIGNED

	bits := c_scalar_bits(want)

	return true if bits >= 64

	return v <= c_bound_hi(cls, bits) if not neg

	return 0 - v >= c_bound_lo(cls, bits)
}

# chk_rune_ok is "a single valid Unicode code point" (docs/core/types.md), the compile-time
# half of the runtime's zrt_is_rune. The surrogate pair is what makes it a predicate rather
# than a bound: U+D800..U+DFFF are UTF-16 machinery and are not characters.
fn chk_rune_ok(v: int) -> bool {
	return false if v < 0 or v > 1114111

	return v < 55296 or v > 57343
}

# chk_int_lit is whether an expression is an UNTYPED integer literal — the literal itself,
# or one behind a unary minus, which is how a negative one is written. Anything else is a
# value with a type of its own, however small the expression is.
#
# The literal itself is c_is_int_lit's question, and it is asked there: the emitter already
# has to know which spellings are one, to tell `-1` the constant from `-x` the negation, and
# a second copy here would disagree with it the day a base prefix or a digit separator is
# added.
fn chk_int_lit(e: Expr) -> bool {
	return match e {
		EUnary(o, x) => o == "-" and chk_int_lit(x)
		EBinary(o, a, b) => chk_lit_oper(o) and chk_int_lit(a) and chk_int_lit(b)
		_ => c_is_int_lit(e)
	}
}

# chk_lit_oper is the arithmetic an all-literal expression may be built from. Comparison and
# the logical operators are absent because they answer `bool`, which is not a type a number
# adopts; the `%`-suffixed wrapping forms are absent because they are an opt-OUT of the
# checked rule this fold is an early application of, and a constant has no reason to wrap.
fn chk_lit_oper(o: str) -> bool {
	return o == "+" or o == "-" or o == "*" or o == "/" or o == "%" or o == "//"
}

# chk_lit_float_oper is that list minus the two a DOUBLE cannot carry, and it stands next to
# it because the subtraction is the whole of the difference. C has no `%` on a double, and the
# floor form is a lowering of its own, so neither is arithmetic the emitter can hand a double:
# a literal tree using either does not adopt a float at all, and the position then writes its
# ordinary sentence. It is the checker's half of the agreement c_lit_as_float keeps at the
# other end — accepting a form the two halves would answer differently is how a checker and an
# emitter come to disagree in silence.
fn chk_lit_float_oper(o: str) -> bool {
	return o == "+" or o == "-" or o == "*" or o == "/"
}

# chk_lit_shaped is whether this tree is one that COULD adopt `want` at all, asked before the
# range is, because the two failures deserve different sentences. A tree of the wrong shape —
# `x: float = 1 % 2`, whose `%` no double carries — is not a value out of range, and saying
# "`1` is not a value a float holds" about it is false twice over. It simply does not adopt,
# and the position then writes its ordinary sentence about a value of the wrong type.
# chk_uint_lit_fits is the u64 bound asked of a BARE literal. A tree is not asked: the fold
# runs on i64 and there is no `uint` arithmetic behind it, so `u: uint = X + 1` for an X past
# i64 stays refused — which is honest, and narrower than pretending the fold reached there.
fn chk_uint_lit_fits(e: Expr) -> bool {
	return match e {
		EInt(lex, _, _) => uint_fits(lex)
		_ => false
	}
}

fn chk_lit_shaped(want: Ty, e: Expr) -> bool {
	return chk_lit_float_tree(e) if c_is_float(want)

	return true
}

# chk_lit_float_tree is chk_int_lit over chk_lit_float_oper instead of chk_lit_oper: the same
# walk, asking the narrower list at every node rather than only at the top. The emitter asks
# it too — c_is_lit_tree is this question plus "and an operator stands somewhere in it" — so
# the tree the checker admits and the tree c_lit_as_float renders are one tree by construction.
fn chk_lit_float_tree(e: Expr) -> bool {
	return match e {
		EUnary(o, x) => o == "-" and chk_lit_float_tree(x)
		EBinary(o, a, b) => chk_lit_float_oper(o) and chk_lit_float_tree(a) and chk_lit_float_tree(b)
		_ => c_is_int_lit(e)
	}
}

# chk_fits is whether a value of type `got` may fill a slot declared `want`.
fn chk_fits(mut &em: Emitter, want: Ty, got: Ty) -> bool {
	return true if c_is_unknown(want) or c_is_unknown(got)
	return true if c_is_carrier(want) or ty_is_chan(want) or c_is_map(want)

	# NO SCALAR WIDENS HERE, AND NONE WIDENS ANYWHERE. A conversion between two scalars is
	# written — `int(b)`, `float(i)` — and there is no longer a second route through a
	# position for it to take, so this function has nothing to make an exception for.
	#
	# The history is worth keeping, because it is four states of one question. A byte widened
	# right here, on the type alone; then it stopped, because widening a VALUE silently is
	# what `int(b)` exists to make visible; then it converted again by a named mechanism at an
	# enumerated position, with a lint finding on it; and now the position wraps and never
	# converts, which retires both the mechanism and the finding. `int → float` was the last
	# pair still taking the first route, and it took it on the TYPE alone — where there is no
	# position to hang a conversion on at all, and so no place a reader could be shown one.

	# a list fits a list when its ELEMENTS fit, which is not the same as their being equal:
	# `xs: list[int?] = [nil, 1]` infers `list[nil]` from its first element, and `nil` fits
	# an optional slot. Recursing here rather than deferring to ty_eq is what keeps the
	# reshaping above true at every depth instead of only at the top.
	if c_is_list(want) and c_is_list(got) {
		we := c_list_elem(want)
		ge := c_list_elem(got)

		# A `list[byte]` IS NOT A `list[int]`, whatever the elements would do one at a time.
		# The buffer's stride is its ELEMENT's size, so reading one as the other walks 8
		# bytes per 1-byte slot: `ys: list[int] = list[byte]("Hi")` printed 26952, and a
		# longer string read past the end.
		#
		# Both orderings now fall out of the recursion below as well, since a byte no longer
		# widens — but this stays ahead of it, because the escapes further down (an unknown
		# element, an optional one) would let a mismatched stride through on their way to a
		# better sentence about something else.
		return false if c_is_byte(we) != c_is_byte(ge)

		return chk_fits(em, we, ge)
	}

	# an optional handed to a value slot is a real mistake, and emit already has a better
	# sentence for it than this rule can write — it names the three ways to unwrap one
	return true if c_is_opt(got)

	return ty_eq(want, got)
}

# --- returned value ---------------------------------------------------------------
#
# A signature is a promise, and `-> int` with `return "nope"` reached cc as an
# incompatible-pointer conversion. The declared type is on the function and the `return`
# may be forty lines away, which is exactly why nobody notices without a check.

# chk_returned raises when a returned value is not the type the signature declares, and
# ANSWERS the type it inferred — c_return wants the same one, and inferring it twice walks
# the expression twice for every value return in the program.
fn chk_returned(mut &em: Emitter, e: Expr) -> Ty {
	declared := em.fn_ret
	got := c_infer(em, e)
	if not chk_fits_expr(em, declared, got, e) {
		chk_at(em, f"{CHK_ANSWER} is {ty_name(declared)}, and this gives {ty_name(got)}")
	}
	return got
}

# --- declared type versus value ---------------------------------------------------
#
# `x: int = "hello"` reached cc as an incompatible-pointer conversion. `b: bool = 1`
# reached nothing at all: both are int64_t in C, so the program compiled and printed
# `true`. An annotation that the compiler does not check is a comment.

# chk_binding raises when a declaration and its initializer are different types.
fn chk_binding(mut &em: Emitter, name: str, declared: Ty, ival: Expr) {
	# THE ANNOTATION HAS TO NAME A TYPE, and a local's was the one that did not have to. A
	# parameter's is checked where it is resolved, and a `type X = Y`'s underlying name too —
	# but `x: Nope = 5` reported "cannot bind int to a Nope binding", a sentence about the VALUE
	# that treats the unknown name as though it were a type the value failed to be. It also hid
	# the fixed-width ladder's own sentence behind it, which is what sent anybody looking.
	nm := c_named_of(declared)
	if nm != "" and not c_is_type_name(em, nm) {
		c_builtin_check(nm)
		chk_at(em, f"the binding `{name}` is annotated `{nm}`, and no type of that name is declared in this program")
		return
	}

	got := c_infer(em, ival)

	if not chk_fits_expr(em, declared, got, ival) {
		chk_at(em, f"cannot bind {ty_name(got)} to a {ty_name(declared)} binding: `{name}`")
	}
}

# chk_needs_type is the other half of chk_binding: the binding that declares NO type, given a
# form that HAS none. `x := []`, `x := {:}` and `x := nil` name a value with nothing to say
# what it is — docs/core/type-system.md's "ambiguity is an error", the consequence with no
# demand and no declared default to fall back on — and the fix is the annotation, which is
# what the sentence hands the reader.
#
# THE THREE WENT THREE DIFFERENT WAYS, all of them quiet. `x := []` lowered to a list of
# zero-byte elements and reached `cc`, which reported incompatible types against generated C
# in a cache file nobody wrote; `x := {:}` and `x := nil` compiled in silence and bound
# something the rest of the program then read. A form the language says has no type must be
# refused where it has no position, not given one by accident of lowering.
fn chk_needs_type(mut &em: Emitter, name: str, ival: Expr) {
	what := chk_typeless_form(ival)
	return if what == ""

	chk_at(em, f"the binding `{name}` gives {what}, which has no type of its own — a type must come from somewhere, so write it on the left: `{name}: T = …`")
}

# chk_typeless_form names the form when an expression is one of the ones that carry no type,
# and is the empty string otherwise. It is the list docs/core/type-system.md calls exhaustive,
# less the two that cannot reach a binding's right-hand side: a numeric literal has a default
# and so is never without a type, and an untyped closure parameter is refused by name.
fn chk_typeless_form(e: Expr) -> str {
	return match e {
		EListLit(elems) => chk_empty_says(elems.len(), "the empty list `[]`")
		EMapLit(ks, vs) => chk_empty_says(ks.len(), "the empty map `{:}`")
		ENil => "`nil`"
		_ => ""
	}
}

# a match arm takes no guard, so "empty, and therefore typeless" is asked here
fn chk_empty_says(n: int, says: str) -> str {
	return "" if n > 0

	return says
}

# chk_typedef is what a `type X = Y` declaration must satisfy. The name is a TYPE name, so
# it collides with the same things a struct or an enum name would, and the underlying type
# has to be one that exists — a `type X = Nope` used to be dropped on the floor along with
# the whole declaration, so nothing said anything at all.
fn chk_typedef(mut &em: Emitter, td: TypeDecl) -> Ty {
	# A NAME COLLISION is not asked here. c_build_typedefs runs before the struct and enum
	# registries exist, so asking would always answer no — c_build_type_names is the pass
	# that already asks it of every kind of type name at once, and the typedef joins it.
	#
	# the underlying type is a TYPE, and a name that nothing declares is the mistake worth
	# catching here rather than at the first use of it
	nm := c_named_of(td.under)
	if nm != "" and not c_is_type_name(em, nm) {
		# THE FOURTH POSITION A WIDTH CAN APPEAR, and the one the ladder's own commit missed
		# while claiming to cover them all: `type W = u8` reported "names no type — `u8` is not
		# declared", which is the unnamed refusal the rule exists to kill, one type position
		# over.
		c_builtin_check(nm)

		chk_at_place(em, td.path, td.line, td.col, f"`type {td.name} = {nm}` names no type — `{nm}` is not declared in this program")
		return TUnknown
	}

	# A SCALAR UNDERNEATH, this phase. docs/core/types.md records the deviation, and the seed
	# refuses the same thing — but it is worth naming rather than emitting, because a
	# `type Label = str` looked like it worked: a str is a refcounted cell, and the typedef
	# name is not a str to c_is_str, so nothing retained it, nothing released it, and
	# `str(l)` printed the pointer as a number. A form that answers wrongly is worse than one
	# that says it is not built.
	if c_scalar_class(td.under) == SC_NONE {
		chk_at_place(em, td.path, td.line, td.col, f"NotImplemented: `type {td.name} = {ty_name(td.under)}` over a non-scalar — this compiler builds a strong typedef over a scalar, where the new name costs nothing at runtime; a `str`, a container or a struct underneath needs the copy and drop rules to follow the name")
		return TUnknown
	}
	return td.under
}

# chk_slot_fits is a value entering a POSITIONAL slot named by `where` — a struct literal's
# field, an enum variant's payload. It takes the label rather than deriving it, because the
# two callers name their slot differently and the rule is the same for both.
#
# It began as the struct field alone — the sixth slot, and the one that had no rule at all. `P("hi")` on an `x: int` field put a pointer where an int64_t goes
# and compiled; `P(b'a')` on an `x: int` and `P(i)` on an `x: float` were the byte and float
# rules going quiet in the one place nothing asked them.
#
# It asks chk_fits_expr like the other five, so a literal field adopts and a typed value does
# not, and a list-literal field is checked element by element. The position is what the
# sentence names, because a struct literal gives its fields in order and has no other handle
# on the one that is wrong.
fn chk_slot_fits(mut &em: Emitter, where: str, want: Ty, arg: Expr) {
	got := c_infer(em, arg)
	if not chk_fits_expr(em, want, got, arg) {
		chk_at(em, f"{where} is {ty_name(want)}, and this gives {ty_name(got)}")
	}
}

# chk_field_says names a struct's field BY POSITION, the way chk_arg_says names an argument,
# and it is shared with the emitter's missing-field diagnostic — because the two disagreed
# about the numbering. One counted from 1 and the other from 0, so the same field of the same
# struct was "field 1" or "field 0" depending on which mistake you made.
#
# `pos` arrives 1-based, which is chk_arg_says' convention.
pub fn chk_field_says(sname: str, pos: int) -> str {
	return f"field {strconv.to_string(pos, 10)} of `{sname}`"
}

# --- assigned value ---------------------------------------------------------------
#
# An assignment is the FOURTH slot a value enters, and it was the one this rule set left
# out: `mut b: bool = true` followed by `b = 1` compiled and printed `true`, which is the
# same defect as the declaration it was written to catch, one statement later.

# chk_assigned raises when a value does not fit the storage it is assigned to.
fn chk_assigned(mut &em: Emitter, lhs: Expr, want: Ty, rhs: Expr) {
	got := c_infer(em, rhs)
	if not chk_fits_expr(em, want, got, rhs) {
		chk_at(em, f"cannot assign {ty_name(got)} to {chk_target_name(lhs)}, which holds {ty_name(want)}")
	}
}

# chk_target_name names an assignment target the way it was written — the binding for a
# bare name, and the binding plus what it was reached through otherwise, since a field or
# an element has no name of its own to print.
fn chk_target_name(lhs: Expr) -> str {
	root := chk_root_name(lhs)

	return "this target" if root == ""
	return f"`{root}`" if c_ident_name(lhs) != ""

	return f"that part of `{root}`"
}

# --- argument versus parameter ----------------------------------------------------
#
# `f(1.5)` into an `int` parameter reached cc, which reported an implicit conversion
# against a prototype this compiler wrote. The parameter table has held every type all
# along — c_arg already reads the same row to decide whether to pass an address.

# chk_argument raises when an argument is not the type its parameter takes. `row` is the
# parameter table's row, which c_arg has already found for its own use — looking it up
# again would be the walk its comment exists to prevent — and `pos` is where the argument
# stands as WRITTEN, counting from one, which is the only number a reader can find on the
# line they are looking at. A row of -1 is a call this rule knows nothing about: an
# intrinsic, a constructor, a binding holding a function. Emit names those itself.
fn chk_argument(mut &em: Emitter, key: str, row: int, pos: int, arg: Expr) {
	return if row < 0

	want := em.pr_ty[row]
	got := c_infer(em, arg)
	if not chk_fits_expr(em, want, got, arg) {
		# THE SENTENCE IS chk_slot_says', which is what the emitter's argument floor writes
		# too. It used to be a shape of its own — "`f` takes float as argument 1" — saying
		# exactly what the floor said in different words, so one bad argument was reported
		# twice: chk_at_place dedupes per sentence, and two synonyms are two sentences.
		#
		# It also puts an argument in the same shape as a struct field and a list element,
		# so the four positional slots read as one family a reader learns once.
		chk_at(em, f"{chk_slot_says(key, pos)} is {ty_name(want)}, and this gives {ty_name(got)}")
	}
}

# --- operands ---------------------------------------------------------------------
#
# An operator says what it takes. `1 + "s"` compiled to C pointer arithmetic and printed
# an address; `true + 1` printed 2; `not 1` printed false. Each is C answering a question
# in C's terms for a language that does not ask it that way.
#
# The rules are the seed's, which is where they were already written down: arithmetic
# takes numbers (and `+` takes two strs), the bitwise operators take ints, `and` / `or`
# take bools, an ordering takes two numbers or two strs, and an equality takes two things
# of one kind.
#
# Only the SCALAR families are judged, and that is a LIMIT rather than a boundary. The
# reason is `ty_name`: it is the diagnostic spelling of a type, and using it as an equality
# relation is only safe where the spelling is unique, which is exactly the scalars — it
# collapses TUnknown, TTuple and TMap onto one name. So `[1] and true` and a struct bound
# to the wrong struct are still cc's to report, which is the failure this file exists to
# remove; closing it needs a real `ty_eq` over the Ty enum, and that is owed.
#
# A `nil` on either side of an equality is how an optional is tested and is never a
# mismatch, which the same restriction gives for free.

# chk_binary raises when an operator's operands are not what it takes. It is given the
# operand TYPES rather than the expressions: c_binexpr infers the left one for its own
# reasons, and an f-string desugars into a left-nested `+` chain, so re-inferring here
# would walk the whole left spine again at every link of it.
fn chk_binary(mut &em: Emitter, oper: str, ta: Ty, tb: Ty, ea: Expr, eb: Expr) {
	return if c_is_unknown(ta) or c_is_unknown(tb)

	chk_const_divisor(em, oper, eb)

	# An OPTIONAL is not an operand of ANY of them. `x == nil` is the first thing a person
	# reaches for to test one, and it lowered to a comparison between the carrier struct
	# and `0` — but so did `x > 0`, `x + 1`, `x & 1` and `x and true`, because a carrier is
	# not a scalar and every family's own test answers "not my business" for it. Putting
	# this under the equality branch, which is where it went first, closed one family of
	# five. The language's answer is the binding form, which is also the only one that
	# hands over the value when there is one.
	if c_is_opt(ta) or c_is_opt(tb) {
		chk_at(em, f"an optional is not an operand of `{oper}` — unwrap it with `if v := x {{ … }} else {{ … }}`, which also binds what it holds")
		return
	}

	# A `type X = Y` IS NOT A Y HERE. docs/core/types.md: X takes on Y's representation and
	# keeps an identity of its own, and this compiler does not carry Y's arithmetic or spec
	# impls across — so a `Celsius` has no `+` until somebody writes `int(c)`, which is the
	# explicit step the whole feature is for.
	#
	# AHEAD of every family, and that is not a detail: it sat between them once, after the
	# logical and bitwise blocks, which return unconditionally — so `f1 and f2` on a
	# `type Flag = bool` and `m & 1` on a `type Mask = int` were accepted and lowered to
	# working C, which is the underlying type's operators being inherited by exactly the
	# rule that says they are not.
	#
	# EQUALITY IS THE EXCEPTION, between two values of the SAME one. The deviation the doc
	# records is about arithmetic and spec impls, and `==` is neither; an enum is nominal and
	# inherits nothing either, and gets same-enum `==` twelve lines below. Refusing
	# `uid1 == uid2` would take away the one operation a `UserId` exists to support — and
	# would leave `if flag` on a `type Flag = bool` told to "compare it (`x != 0`)" by a rule
	# that then refuses the comparison.
	if chk_is_typedef_operand(em, ta) or chk_is_typedef_operand(em, tb) {
		return if chk_is_equality(oper) and ty_eq(ta, tb)

		chk_at(em, f"operator `{oper}` has no meaning on {ty_name(ta)} and {ty_name(tb)} — a `type … = …` keeps its own identity and does not take the underlying type's operators, so convert first")
		return
	}

	if chk_is_logical(oper) {
		if chk_wrong_bool(ta) or chk_wrong_bool(tb) {
			chk_at(em, f"operator `{oper}` takes bool operands, and these are {ty_name(ta)} and {ty_name(tb)}")
		}
		return
	}

	if chk_is_bitwise(oper) {
		if chk_wrong_int(ta) or chk_wrong_int(tb) {
			chk_at(em, f"operator `{oper}` takes int operands, and these are {ty_name(ta)} and {ty_name(tb)}")
		}
		return
	}

	if chk_is_arith(oper) {
		# `+` is the one arithmetic operator a str also answers, and only for two of them
		return if oper == "+" and c_is_str(ta) and c_is_str(tb)
		if chk_wrong_num(ta) or chk_wrong_num(tb) {
			chk_at(em, f"operator `{oper}` takes numeric operands, and these are {ty_name(ta)} and {ty_name(tb)}")
			return
		}

		chk_operand_pair(em, oper, ta, tb, ea, eb)
		return
	}

	if chk_is_order(oper) {
		return if c_is_str(ta) and c_is_str(tb)
		if chk_wrong_num(ta) or chk_wrong_num(tb) {
			chk_at(em, f"operator `{oper}` orders two numbers or two strs, and these are {ty_name(ta)} and {ty_name(tb)}")
			return
		}

		chk_operand_pair(em, oper, ta, tb, ea, eb)
		return
	}

	if chk_is_equality(oper) {
		# AN ENUM IS NOT A SCALAR, so it fell straight through this branch and the tags were
		# compared as whatever C made of them. Two of them answered by tag alone: `Red ==
		# Apple`, one variant of each of two unrelated enums, was `true` because both are
		# tag 0. And an enum against an int reached cc, which read the tagged union as a
		# number. Same enum is the one comparison that means anything.
		if c_is_enum_ty(em, ta) or c_is_enum_ty(em, tb) {
			return if c_is_enum_ty(em, ta) and c_is_enum_ty(em, tb) and ty_eq(ta, tb)
			chk_at(em, f"cannot compare {ty_name(ta)} and {ty_name(tb)} with `{oper}` — a variant is a value of ITS enum, and its discriminant is not a number to compare with")
			return
		}

		return if not chk_is_scalar(ta) or not chk_is_scalar(tb)

		# int and float compare: they are one family, and the language already mixes them
		# in arithmetic. `int` and `uint` are NOT that family — the trap the mixing rule
		# names is a comparison trap first (in C the signed side converts, so `-1 == 1u` is
		# not what it reads as), and asking it only for `<` would have caught the operator
		# where the answer looks wrong and missed the one where it looks right.
		if chk_is_num(ta) and chk_is_num(tb) {
			chk_operand_pair(em, oper, ta, tb, ea, eb)
			return
		}
		if ty_name(ta) != ty_name(tb) {
			chk_at(em, f"cannot compare {ty_name(ta)} and {ty_name(tb)} with `{oper}` — they are different kinds of value")
		}
	}
}

# chk_unary raises when a prefix operator's operand is not what it takes.
fn chk_unary(mut &em: Emitter, oper: str, x: Expr) {
	t := c_infer(em, x)

	return if c_is_unknown(t)

	# the same rule the binary families get, and for the same reason: `not f` on a
	# `type Flag = bool` and `-c` on a `Celsius` are the underlying type's operators, which a
	# typedef does not take on. The scalar predicates below all answer no for a TNamed, so
	# without this the prefix operators were the one family that let a typedef through.
	if chk_is_typedef_operand(em, t) {
		chk_at(em, f"operator `{oper}` has no meaning on {ty_name(t)} — a `type … = …` keeps its own identity and does not take the underlying type's operators, so convert first")
		return
	}
	if oper == "not" and chk_wrong_bool(t) {
		chk_at(em, f"operator `not` takes a bool operand, and this one is {ty_name(t)}")
	}
	if oper == "-" and chk_wrong_num(t) {
		chk_at(em, f"operator `-` takes a numeric operand, and this one is {ty_name(t)}")
	}
	if oper == "~" and chk_wrong_int(t) {
		chk_at(em, f"operator `~` takes an int operand, and this one is {ty_name(t)}")
	}
}

# The three "wrong" predicates each answer the same shape of question: is this a type the
# operator cannot take.
#
# THEY USED TO ASK IT OF SCALARS ONLY — "is this a SCALAR the operator cannot take" — which
# answers NO for a value that is not a scalar at all, so every aggregate walked past every one
# of them. `xs + [2]`, `xs & [2]`, `xs and [2]`, `-xs` and `~xs` were each lowered to C and
# reported by cc against a file under .zerg-cache, which is the standing rule breached five
# times by one word. Only ORDER escaped it, having a rule of its own about `Ord`. The word is
# out of the NAMES as well: a predicate called `chk_scalar_wrong_num` reads as the rule it was,
# and the name is the part a caller checks its own line against.
#
# The gate is now every type but TUnknown, which is the one they cannot have an opinion about:
# refusing on it would turn every gap in inference into a rejected program, which is the same
# exemption chk_fits makes and for the same reason. What is handled BEFORE these — an optional,
# a typedef — still returns first and keeps its own better sentence.
fn chk_wrong_bool(t: Ty) -> bool {
	return not c_is_unknown(t) and not c_is_bool_ty(t)
}

fn chk_wrong_int(t: Ty) -> bool {
	return not c_is_unknown(t) and not chk_is_bitwise_operand(t)
}

fn chk_wrong_num(t: Ty) -> bool {
	return not c_is_unknown(t) and not chk_is_num(t)
}

# chk_is_bitwise_operand is docs/core/types.md's list for `&` `|` `^` `~` `<<` `>>`, and the
# page names three: `int`, `uint`, `byte`. So it is the integer classes, with `rune` taken
# back out — a rune is a CHARACTER, and masking a character's bits is not an operation on
# one. That exclusion is the spec's, which is why it is the only name here.
#
# It was `c_is_int` alone, which refused `uint` in the teeth of the page. `byte` slipped
# through by a second accident — chk_is_num did not list it, so a byte was not a scalar at
# all and no operand rule had anything to say about it. Two wrongs that looked like one
# working rule.
fn chk_is_bitwise_operand(t: Ty) -> bool {
	cls := c_scalar_class(t)
	return false if c_is_rune(t)

	return cls == SC_SIGNED or cls == SC_UNSIGNED
}

fn chk_is_scalar(t: Ty) -> bool {
	return chk_is_num(t) or c_is_str(t) or c_is_bool_ty(t)
}

# chk_operand_pair is docs/core/types.md's rule for two operands, and it is now one line of
# prose: AN OPERATOR'S OPERANDS MUST ALREADY BE ONE TYPE. A literal adopts the other operand's
# type, because that slot is one of the typed positions; anything else is two types meeting,
# which is no type at all.
#
# IT USED TO PICK THE LARGEST TYPE BOTH REACH, which is the machinery Option B deleted from the
# specification. That rule made `i + f` a `float` and `i + u` an error, and the difference
# between them was not a difference a reader could see: both are two typed values of different
# types in one expression, and the answer was decided by a containment table nothing in the
# source mentions. Now they are one refusal with one fix — convert a side — and the `int`/`uint`
# case stops being a special inconvenience and becomes the ordinary answer.
#
# The C signed/unsigned trap is why that inconvenience was worth defending on its own — in C
# the signed operand converts to unsigned, so `-1 < 1u` is false — and it is why the ORDER
# family asks this as well as the arithmetic one. It is no longer the argument, only a case.
fn chk_operand_pair(mut &em: Emitter, oper: str, ta: Ty, tb: Ty, ea: Expr, eb: Expr) {
	# the cheap questions first: this is asked of every binary expression in the program
	return if ty_eq(ta, tb) or c_is_unknown(ta) or c_is_unknown(tb)

	# THE OTHER OPERAND OF A TYPED EXPRESSION is one of the typed positions — the list names
	# it — so `n * 10` where `n` is a `uint` is the literal becoming a uint, not a mixed pair.
	#
	# It adopts on the SAME terms as the other thirteen, which is chk_lit_fits and not merely
	# "is it a literal": `n * 300` where n is a `byte` is out of range here exactly as
	# `b: byte = 300` is, and asking the weaker question would have made the operand slot the
	# one place a literal adopts a type it is not a value of.
	return if chk_lit_adopts(em, ta, eb) or chk_lit_adopts(em, tb, ea)

	chk_at(em, f"operator `{oper}` has {ty_name(ta)} on one side and {ty_name(tb)} on the other, and an operator's operands must already be one type — convert one side with `{ty_name(ta)}(…)` or `{ty_name(tb)}(…)`")
}

# chk_is_num is THE list of numeric types, and chk_is_scalar builds on it rather than
# re-enumerating: adding `uint` to a second copy is an edit that is easy to miss, and missing
# it let a `uint` reach the arithmetic and ordering diagnostics through the not-a-scalar hole
# instead of the numeric path the mixing rule assumes.
# chk_is_typedef_operand is whether an operand is a `type X = Y` name. It asks the emitter's
# registry rather than the type's shape, because the shape is precisely what a typedef shares
# with its underlying type and precisely what must not be read through here.
fn chk_is_typedef_operand(mut &em: Emitter, t: Ty) -> bool {
	nm := c_named_of(t)
	return false if nm == ""

	return c_is_typedef(em, nm)
}

# chk_is_num is every NUMBER, which is every scalar class but bool — asked of the table
# rather than listed, because the list left `byte` out. That omission did not show as a
# wrong answer: it made a byte not a scalar, so every operand rule below skipped it and the
# rules that happened to want a byte admitted one. A type nothing checks looks exactly like
# a type everything permits.
fn chk_is_num(t: Ty) -> bool {
	cls := c_scalar_class(t)
	return cls == SC_SIGNED or cls == SC_UNSIGNED or cls == SC_FLOAT
}

# chk_is_logical is `and` / `or` — the operators that TAKE bools. It is deliberately not
# c_is_bool_op, which asks whether an operator YIELDS one and so includes every comparison.
fn chk_is_logical(oper: str) -> bool {
	return oper == "and" or oper == "or"
}

# The WRAPPING forms are arithmetic as much as the checked ones — `+%` differs from `+`
# in what it does on overflow, not in what it takes — and leaving them out let
# `true +% 1` walk straight past the rule the others obey.
fn chk_is_arith(oper: str) -> bool {
	return true if oper == "+%" or oper == "-%" or oper == "*%"
	return true if oper == "//"

	return oper == "+" or oper == "-" or oper == "*" or oper == "/" or oper == "%"
}

fn chk_is_bitwise(oper: str) -> bool {
	return oper == "&" or oper == "|" or oper == "^" or oper == "<<" or oper == ">>"
}

fn chk_is_order(oper: str) -> bool {
	return oper == "<" or oper == ">" or oper == "<=" or oper == ">="
}

fn chk_is_equality(oper: str) -> bool {
	return oper == "==" or oper == "!="
}

# --- conditions -------------------------------------------------------------------
#
# Zerg has no truthiness: a condition is a bool or it is a mistake. `if 1` compiled to C's
# own rule that non-zero is true, which is a rule this language does not have, and `while
# xs` did the same for a pointer.

# chk_condition raises unless `x` is a bool. `site` names the form, since "the condition"
# alone leaves a reader hunting through a line with three of them.
fn chk_condition(mut &em: Emitter, x: Expr, site: str) {
	t := c_infer(em, x)
	return if c_is_bool_ty(t)

	# an expression whose type this compiler cannot work out is not evidence of anything,
	# and refusing it here would turn every gap in inference into a rejected program
	return if c_is_unknown(t)

	# an optional gets the binding advice ALONE: `x != 0` is a program the operand rule
	# refuses, so following this diagnostic would earn a second one
	if c_is_opt(t) {
		chk_at(em, f"the condition of {site} must be bool, and this one is {ty_name(t)} — bind it with `if v := x {{ … }}`, which also hands over what it holds")
		return
	}
	chk_at(em, f"the condition of {site} must be bool, and this one is {ty_name(t)} — Zerg has no truthiness, so compare it (`x != 0`) or bind it (`if x := …`)")
}

# --- redeclaration ----------------------------------------------------------------
#
# There is deliberately NO rule here. docs/core/memory.md: a name may be re-declared —
# in the same block or a nested one — and the new binding may differ in type and
# mutability; re-declaration is declare-del-declare, so the right-hand side reads the OLD
# binding and the name then rebinds afresh. A rule refusing the same-block half used to
# live here, and the worked example in the chapter did not compile under it.
#
# The emitter needs no machinery for the legality either: c_let renders the initializer
# before c_add_var appends the new row, so the RHS resolves the old binding; c_live_idx
# walks from the newest row, so every later use resolves the new one; the old row's C
# name stays reserved (c_fresh_cname spells the new one apart) and its pending release
# still pays at scope exit — which is exactly when an EXPLICIT `del`'s storage comes back
# today, the [not yet] the chapter's `del` section owns.
#
# What survives is the `const` boundary (below): a `const` is shadow-proof in either
# direction, so a re-declaration may neither take a const's name (chk_const_rebind) nor
# mint a `const` over a name any visible binding holds (chk_const_mint) — same block
# included.

# --- `const` shadow-proofing ------------------------------------------------------
#
# GRAMMAR group 4: a `const` binding is immutable and SHADOW-PROOF — no later binding may
# take its name, and it may not itself take a name a visible binding holds. A collision in
# EITHER direction is an error; a plain `:=` may still be shadowed, so `mut n := n` stays
# the ordinary way to get a writable copy of a parameter. Until now neither direction was
# looked at: `k := 2` in a block under a module `const k := 1` compiled and printed 2,
# silently, which is the exact answer the keyword exists to rule out.
#
# The consts in sight are two families under one rule, and one list: the module constants
# (the k_decls rows whose `is_const` is set, seeded at scope 0 and open in every function)
# and the local `const` bindings of the function being emitted. Both are environment rows
# with `env_const` set, so both are consulted through the same open-scope walk every other
# name question uses, and a `const` in a block that has ENDED binds nothing and blocks
# nothing.
#
# The two directions hang off DIFFERENT hooks, because they guard different acts. Taking
# a const's name is something every name-introducing site can do — a binding, a loop
# variable, a match-arm bind, a parameter — so direction one lives in c_add_var, the one
# gate every one of them enters the environment through. `for k in 0..3` under `const k`
# used to be accepted there alone, while D103 desugars that loop to a core form that
# CONTAINS a binding — so the desugared program was refused, `make desugar`'s contract is
# that the two behave the same, and the seed refuses the surface form too: three judges,
# and the narrow reading was the odd one out. MINTING a const is something only the
# `binding` production can do, so direction two stays with c_let, that production's one
# home.

# chk_const_rebind is direction one: this name — binding, loop variable, match-arm bind or
# parameter, `const` or not — takes a name a visible `const` holds. It runs in c_add_var
# BEFORE the new row (and, for a `const`, its registry row) is appended, so a `const`'s
# own registration never collides with itself.
fn chk_const_rebind(mut &em: Emitter, name: str) {
	# `_` is the discard: it binds nothing a later statement can name, so it can neither
	# shadow nor be shadowed
	return if name == "_"

	if chk_const_in_sight(em, name) {
		chk_at(em, f"`{name}` re-binds a `const` — a `const` binding is shadow-proof, so no later binding may take its name; pick another one")
	}
}

# chk_const_mint is direction two: this `const` takes a name some visible binding already
# holds — an outer block's or this very block's alike, since re-declaration is legal for a
# plain binding and a `const` is precisely the binding that refuses to take part in it. A
# collision with a visible `const` is left to chk_const_rebind, whose message names the
# `const`: reporting both directions of one collision would say one mistake twice.
fn chk_const_mint(mut &em: Emitter, name: str) {
	return if name == "_"
	return if chk_const_in_sight(em, name)

	idx := c_live_idx(em, name)

	return if idx < 0

	chk_at(em, f"`const {name}` shadows a binding already visible here — a `const` may neither shadow nor be shadowed, so a name collision in either direction is an error")
}

# chk_const_in_sight is whether an OPEN scope holds a `const` binding of this name. It
# walks the ENVIRONMENT, because a `const` is an ordinary binding with one extra column:
# c_add_var is already told `is_const` and records it beside the name and the block id it
# was going to record anyway, so this is the same open-scope walk c_var_cname makes.
fn chk_const_in_sight(mut &em: Emitter, name: str) -> bool {
	mut i := 0
	for i < em.env_names.len() {
		return true if em.env_const[i] and em.env_names[i] == name and c_in_scope(em, i)
		i = i + 1
	}
	return false
}

# --- the top level is immutable ----------------------------------------------------
#
# docs/runtime/package.md: outside `main` lives only immutable top-level state, and "a
# top-level binding may not be `mut` outside a module-level `unsafe { … }` group". The
# declaration used to be dropped by the parser's top-level skip, which split the mistake
# in two wrong answers: unused, the program compiled; used, every use site said
# `undefined name` — the wrong message, at the wrong place, about a name the program
# plainly declares.
#
# The binding is PARSED instead (p_top_binding) and refused here at its own declaration,
# which is also what keeps the uses honest: the name resolves, writable (c_reset_env reads
# k_mut), so the one finding points at the one line to fix and no second finding about
# immutability muddies it.
#
# It walks `own` — the unit being emitted — rather than the whole program, because this
# runs once per UNIT and the whole-program consts list would repeat the finding once per
# module. A `mut` binding inside a module-level `unsafe { … }` group is EXEMPT by name:
# that group is the one home the language gives a mutable global (docs/runtime/ffi.md,
# GRAMMAR group 12), the parser records the context on the declaration (in_unsafe), and
# the binding lowers as an ordinary module global whose k_mut row keeps it writable.
fn chk_top_muts(mut &em: Emitter, own: File) {
	for c in own.consts {
		if c.is_mut and not c.in_unsafe {
			chk_at_place(em, c.path, c.line, c.col, f"the top-level binding `{c.name}` may not be `mut` outside a module-level " + "`unsafe { … }` group — module state is immutable, and shared mutable state travels by value or through channels")
		}
	}
}

# --- the rendering overrides -------------------------------------------------------
#
# docs/runtime/format.md: `display` and `debug` are the two built-in value renderings,
# and an `impl` may override either — `fn display() -> str`, taking nothing beyond the
# value and answering the text it shows as. The SHAPE is the contract: c_render_override
# dispatches `print`, an f-string hole and `str(…)` through an override only when it has
# this shape, so a method that takes an argument or answers something else would be
# silently passed over — the exact quiet the overrides were rescued from. This rule makes
# the mismatch a finding at the declaration instead.

# chk_render_overrides refuses a `display` / `debug` method whose shape is not the
# override contract's. It walks the whole program's declarations once, like
# chk_spec_impls, and reports at each method's own place.
#
# The declaration list only says WHERE: the verdict is c_render_shape_ok's, the predicate
# the dispatcher itself uses, so the shape this rule approves and the shape the dispatcher
# accepts are ONE predicate rather than two readings of one contract that can drift into
# the checker blessing a method the dispatcher then skips.
fn chk_render_overrides(mut &em: Emitter, f: File) {
	for fn_i in f.fns {
		chk_render_shape(em, fn_i)
	}
}

# chk_render_shape holds ONE declaration to the contract, and the gate is the DISPATCHER'S
# OWN PREDICATE: c_render_shape_ok is what decides whether `print` goes through this method,
# so asking it — rather than negating its clauses here — is what makes "approved by the
# checker" and "dispatched to" the same question by construction. A clause added there can
# no longer be owed here by hand.
#
# The clauses below therefore choose WORDING, not verdict, and the last needs no test: past
# the two above it, the only way c_render_shape_ok can have answered false is the result.
#
# ONE sentence, never two — the rule chk_assignable states and enforces the same way. A
# `fn display(w: int) -> int` is one mistaken declaration and earns one finding about it.
fn chk_render_shape(mut &em: Emitter, fd: FnDecl) {
	return if fd.recv == ""
	return if fd.name != "display" and fd.name != "debug"
	return if c_render_shape_ok(em, fd.recv, fd.name)

	key := c_sig_key(fd.recv, fd.name)
	row := c_sig_row(em, key)

	# c_build_sigs runs first and registers every function in `f`, so there IS a row; the
	# belt is here because saying nothing is the only honest answer if that ever changes,
	# and the alternative — folding `row < 0` into the arity clause — printed a sentence
	# about an arity nobody had looked at.
	return if row < 0

	# row 0 of the parameters is the receiver the parser prepends; a `mut fn` makes it a
	# `mut &`, and showing a value must not change it
	if em.sig_nparams[row] != 1 {
		chk_at_place(em, fd.path, fd.line, fd.col, f"`{fd.recv}.{fd.name}()` renders the value as text (docs/runtime/format.md), so it takes no arguments beyond the value it is called on")
		return
	}
	if c_param_is_ref(em, key, 0) {
		chk_at_place(em, fd.path, fd.line, fd.col, f"`{fd.recv}.{fd.name}()` renders the value as text (docs/runtime/format.md), so it is a plain `fn`, not a `mut fn` — showing a value must not change it")
		return
	}
	chk_at_place(em, fd.path, fd.line, fd.col, f"`{fd.recv}.{fd.name}()` answers the `str` the value shows as (docs/runtime/format.md), and this one does not")
}

# chk_root_name walks an assignment target down to the binding it writes: `p` for `p`,
# `p.x`, `p.x.y`, `xs[0]` and `m["k"].f` alike. Anything that does not bottom out in a
# name answers "".
fn chk_root_name(e: Expr) -> str {
	return match e {
		EIdent(n)    => n
		EField(t, _) => chk_root_name(t)
		EIndex(t, _) => chk_root_name(t)
		_            => ""
	}
}
