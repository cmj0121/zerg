# math — basic mathematics (Phase 1f, bundle MVP).
#
# Bundled into a program that writes `import "math"`; its members are reached
# through the namespace, as `math.abs(-3)` or `math.max(3, 9)`. Every function here is
# ordinary safe Zerg over the primitive numeric types.
#
# Zerg is zero-external-dependency like Go, so the transcendentals are NOT a foreign
# binding onto libc `<math.h>` — they are pure-Zerg numerical algorithms over the
# primitive `float` ops. `sqrt` (Newton's method) and `pow` (integer exponent, by
# squaring) land here, with the `pi` / `e` constants as functions (the grammar has no
# module-level value constant yet). The trigonometric family, a float-exponent `pow`
# (needing `exp`/`ln`), and floor/ceil/round are a straightforward extension, deferred.

# abs returns the absolute value of the integer x.
pub fn abs(x: int) -> int {
	return - x if x < 0
	return x
}

# fabs returns the absolute value of the float x.
pub fn fabs(x: float) -> float {
	return - x if x < 0.0
	return x
}

# min returns the smaller of two integers.
pub fn min(a: int, b: int) -> int {
	return a if a < b
	return b
}

# max returns the larger of two integers.
pub fn max(a: int, b: int) -> int {
	return a if a > b
	return b
}

# sqrt returns the non-negative square root of x, computed in pure Zerg by Newton's
# method: each step replaces the guess with the average of it and x/guess, converging
# quadratically. A negative x raises ValueError — the domain error, which a `guard`
# demotes to a value.
pub fn sqrt(x: float) -> float {
	if x < 0.0 {
		raise "math.sqrt: domain error (negative input)"
	}
	return 0.0 if x == 0.0
	mut guess := x
	mut i := 0
	for i < 100 {
		next := (guess + x / guess) / 2.0
		diff := next - guess
		adiff := if diff < 0.0 {
			- diff
		} else {
			diff
		}
		return next if adiff < 0.0000000001
		guess = next
		i = i + 1
	}
	return guess
}

# pow raises base to an INTEGER exponent, computed in pure Zerg by exponentiation by
# squaring (log2(exp) multiplications). A negative exponent returns the reciprocal
# `1 / base^-exp`; a zero base with a negative exponent raises ValueError (a division
# by zero). A float-exponent pow awaits exp/ln (deferred).
pub fn pow(base: float, exp: int) -> float {
	if exp < 0 {
		if base == 0.0 {
			raise "math.pow: domain error (zero base, negative exponent)"
		}
		return 1.0 / pow(base, - exp)
	}
	mut result := 1.0
	mut b := base
	mut e := exp
	for e > 0 {
		if e % 2 == 1 {
			result = result * b
		}
		b = b * b
		e = e / 2
	}
	return result
}

# no_fraction reports whether x's magnitude is large enough that a float64 holds no
# fractional part (>= 2^52) — such a value is already integral, and int() of it would
# overflow, so the rounding family returns it unchanged. Module-private.
fn no_fraction(x: float) -> bool {
	return fabs(x) >= 4503599627370496.0
}

# trunc returns x with its fractional part removed, rounding toward zero: trunc(2.7) is
# 2.0 and trunc(-2.7) is -2.0. Computed in pure Zerg — for |x| < 2^52 through the checked
# int truncation, and a larger x (already integral) returned as is.
pub fn trunc(x: float) -> float {
	return x if no_fraction(x)
	return float(int(x))
}

# floor returns the greatest integer value not greater than x: floor(2.7) is 2.0 and
# floor(-2.1) is -3.0.
pub fn floor(x: float) -> float {
	t := trunc(x)
	return t - 1.0 if t > x
	return t
}

# ceil returns the least integer value not less than x: ceil(2.1) is 3.0 and ceil(-2.7)
# is -2.0.
pub fn ceil(x: float) -> float {
	t := trunc(x)
	return t + 1.0 if t < x
	return t
}

# round returns x rounded to the nearest integer, with a half rounded away from zero:
# round(2.5) is 3.0 and round(-2.5) is -3.0.
pub fn round(x: float) -> float {
	return - floor(- x + 0.5) if x < 0.0
	return floor(x + 0.5)
}

# pi returns an approximation of the ratio of a circle's circumference to its diameter.
# It is a function, not a constant binding, because the grammar has no module-level
# value declaration yet (a `math.PI` value would need that surface).
pub fn pi() -> float {
	return 3.141592653589793
}

# e returns an approximation of Euler's number, the base of the natural logarithm. Like
# `pi`, it is a function pending a module-level constant surface.
pub fn e() -> float {
	return 2.718281828459045
}
