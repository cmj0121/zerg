	TypeNameNotUpper = 610
	PreludeNameAsName = 611
	DecoratorOnStatement = 612
	SecondDecorator = 613
	AllowNamesNoCodes = 614

	# checking — a form whose meaning does not hold together — reported against the tree, all at once
	NotPublicMember = 301
	AssignTargetNotAPlace = 302
	AssignToConst = 303
	NotYetTypedefNonScalar = 304
	AssignToModuleBinding = 305
	AssignToThis = 306
	AssignToImmutable = 307
	AssignThroughImmutable = 308
	MutRefParamDefault = 309
