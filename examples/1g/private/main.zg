# visibility demo (negative): `helper` is module-private, so naming it across the module
# boundary is a compile error. Building this must fail — that is what it is for.
#   zerg build examples/1g/private/main.zg
#   error: `helper` is not a public member of module `lib`
#     --> examples/1g/private/main.zg:12:12
# `pub` is the one visibility marker: `lib.public_fn()` is reachable and `lib.helper()` is
# not. A module is a DIRECTORY, so the boundary this crosses is the one between `lib/` and
# the file importing it.
import "./lib"

fn main() {
	print lib.helper() # error: `helper` is not a public member of module `lib`
}
