# testing — minimal assertion helpers (Phase 1f, bundle MVP).
#
# Bundled into a program that writes `import "testing"`; its members are reached
# through the namespace, as `testing.assert_eq(a, b)`. Each assertion returns
# `Result[nil]` — a satisfied assertion is `nil` (Ok), a violated one `raise`s so an
# enclosing `guard` recovers it as a value (or, uncaught, aborts with the message).
# This is the library the `#[test]` discovery + `zerg test` runner (Phase 1i) builds
# on; `#[test]` discovery itself is 1i, not this module.
#
# WHAT IT RAISES IS A GENERIC Err, deliberately, and it is the only stdlib module that
# still does. The other pure-Zerg modules raise a taxonomy kind because they are refusing
# a VALUE — `ValueError`, a value was not one this could accept (docs/code/errors.md).
# A failed assertion is not that: it is a claim about the program that did not hold, and
# the six built-in kinds have no member for it. Naming it `ValueError` would put it in a
# subtree a handler catches for another reason, so it stays the untyped Err a bare
# `raise` builds until the taxonomy has a name for a broken claim.

# detail renders one failure's message out of its three parts: WHAT did not hold, what the
# author called it, and the context a chain accumulated. Each part is left out when it is
# empty, so a bare `assert(false)` still raises the two words it always raised and no
# existing reader of these messages has to learn a new shape to keep working.
fn detail(what: str, msg: str, notes: str) -> str {
	mut s := what
	if msg != "" {
		s = s + ": " + msg
	}
	if notes != "" {
		s = s + " [" + notes + "]"
	}
	return s
}

# assert succeeds when cond holds; otherwise it raises so the failure is observable
# (an enclosing `guard` catches it, or it aborts the program).
#
# `msg` IS WHAT THE BARE FORM COULD NOT SAY. A condition is compiled away before it fails,
# so `assertion failed` is the whole of what the runtime knows and the author is the only
# one who can say which claim it was. The parameter has a default because most assertions
# are `assert_eq` and want none, and a default costs the call site nothing.
pub fn assert(cond: bool, msg: str = "") -> Result[nil] {
	raise detail("assertion failed", msg, "") if not cond
	return nil
}

# assert_eq succeeds when a and b compare equal under their Eq impl (the blessed Eq
# spec / a `#[derive(Eq)]` from Phase 1c); otherwise it raises, NAMING BOTH VALUES.
# Generic over any `T: Eq`, so it serves the primitive scalars and any user type that
# derives Eq.
#
# THE VALUES ARE INTERPOLATED AND NOT `str()`-ed, and the difference is the bootstrap seed
# rather than a style. Both spellings are the same rendering in this compiler — `display`
# is a built-in rendering rather than a spec, so it needs no bound — but the seed checks a
# generic body ABSTRACTLY, before any instantiation, and `str(x)` over a type parameter is
# _cannot build a str from T_ there while `f"{x}"` lowers. `testing` is a module the seed
# compiles, so the module writes the spelling both compilers take.
pub fn assert_eq[T: Eq](a: T, b: T) -> Result[nil] {
	raise f"assert_eq failed: {a} != {b}" if a != b
	return nil
}

# assert_ne is the negation: it succeeds when a and b differ, and raises when they
# compare equal — naming the value they both are, which is the one fact a reader of the
# failure does not have.
pub fn assert_ne[T: Eq](a: T, b: T) -> Result[nil] {
	raise f"assert_ne failed: both values are {a}" if a == b
	return nil
}

# not_raised is what assert_raises does when the call it was handed came back. It is a
# function rather than a `raise` written into the match arm because both arms of a match
# answer one type, and this one has to answer an `Err` it never gets to build.
fn not_raised() -> Err {
	raise "assert_raises failed: the call returned instead of raising"
}

# assert_raises answers the `Err` a call raised; it FAILS when the call returned instead.
# What it takes is the `guard` the caller writes at the point of the call:
#
#   e := testing.assert_raises(guard { strings.split("a,b", "") })
#   testing.assert(e is ValueError, "split refused with the wrong kind")
#
# THE ERROR COMES BACK RATHER THAN THE KIND GOING IN, and that is not a preference: a type
# is not a value in `zerg`, so `assert_raises(f, ValueError)` cannot be spelled at all. The
# form that is left is also the better half of the trade — the caller asks with the
# language's own `is`, and this module never has to learn the error taxonomy it is
# deliberately outside of (see the header).
#
# A `guard` AND NOT AN `fn ()`, and the difference was measured rather than preferred. The
# closure reads better — `assert_raises(fn () { strings.split("a,b", "") })` says what it
# does — and this compiler cannot compile it: a closure body naming an imported module is
# _E735 a closure captures `strings`, and this compiler cannot work out what it holds_,
# because a namespace is a free name and a capture needs a type. Every test that reaches
# its module through `import` is exactly that shape, so the closure form would be a form
# that works only for the tests that need it least. The `guard` is evaluated at the CALL
# SITE, where the namespace is in scope, and hands the outcome over as an ordinary value.
#
# IT IS GENERIC BECAUSE THE CARRIER IS — `split` raises out of a `list[str]`, `repeat` out
# of a `str`, `count` out of an `int` — which is what a suite that hand-rolled this helper
# found and had to write for itself. `T` is never inspected here; the whole body is about
# the Right.
pub fn assert_raises[T](r: Result[T]) -> Err {
	return match r {
		Either.Left(_)  => not_raised()
		Either.Right(e) => e
	}
}

# --- the test context ---------------------------------------------------------------
#
# EVERY ASSERTION IS A FREE FUNCTION, AND THE ONE NON-GENERIC ONE IS ALSO A METHOD. The
# free function is the plain form and takes no context; the method is the terminal of a
# chain that carries some. `assert_eq`, `assert_ne` and `assert_raises` have no method form
# and the reason is measured rather than chosen: all three are generic, and a generic
# METHOD is _E409 NotImplemented: a generic METHOD `Context.assert_eq[…]`_ in this compiler
# while a generic free function is not. So `t.str("file", path).assert_eq(got, want)` is
# unwritable today — which is most of why `assert_eq` now names both values itself: the
# failure that most wanted context is the one that can carry none.
#
# THE ASSERTION IS THE CHAIN'S TERMINAL, deliberately the opposite end from the logger's
# `log.str(…).msg(…)`. If an assertion sat in the middle, a `t.assert(cond)` whose terminal
# the author forgot would assert NOTHING and say so to no one — and `zerg` has no `impl
# Drop` to notice a value that was built and never finished. Putting the assertion last
# makes a dangling assertion a thing that cannot be written.
#
# THE CONTEXT IS PER-ASSERTION FOR FREE, and value semantics are the whole mechanism: each
# `str` / `int` / `bool` answers a COPY carrying one more field, so what a chain accumulated
# reaches its own terminal and nothing after it — measured, and the receiver the chain
# started from is unchanged afterwards. The cost of that is worth knowing: a copy is a copy
# of the accumulated text, so an N-field chain moves O(N²) bytes. N is two or three in every
# failure that wants context, and the chain is written out by hand, so there is no shape of
# this that gets large.
#
# PER TYPE, because there is no other way to spell it: `zerg` has no varargs, no `any`, and
# no generic struct to hold a rendered list, so one method per scalar is what a named value
# costs. The three that exist are the three a failure has been asking for.
#
# A Context is taken BY VALUE — `fn my_test(ctx: testing.Context)` — and by value is not
# a copy of what matters. The one field that carries anything out is a channel, and a
# channel is a `Ref` value: copying a value refcount-bumps the `Ref`s it contains and
# deep-copies the rest (docs/code/coroutine.md). So the copy the parameter makes shares
# the one thing that must be shared, and a test says what it has to say without `mut &`
# — measured: a Context passed by value through two frames and a `spawn` delivered every
# event to the runner holding the receiving end.
#
# WHAT A TEST SAYS TRAVELS AS AN EVENT, not as a field it sets, and that is the same
# reasoning one step on: a `bool` field set by the test would be set on the COPY, and the
# runner would never see it. The channel is the only field, so it is the only mechanism.

# Event is one thing a running test told its runner. It is `pub` because the generated
# driver names the channel's type; its fields are the module's own, because nothing
# outside reads one — `collect` below is the only reader there is.
pub struct Event {
	kind: int = 0
	text: str = ""
}

# The kinds an Event carries. LOG / SKIP / FATAL are what the test itself says; DONE and
# RAISE are what the driver says about the body afterwards, over the same channel, so
# that one receive loop sees the whole of a test's life and there is no second route for
# a runner to get wrong.
const EV_LOG := 0
const EV_SKIP := 1
const EV_FATAL := 2
const EV_DONE := 3
const EV_RAISE := 4

# Outcome is what one test came to, as the runner reports it: `ok`, `fail` or `skip`, and
# the text that goes under it — a skip's reason, or a failure's notes and message.
pub struct Outcome {
	pub verdict: str = ""
	pub text: str = ""
}

pub struct Context {
	# `name` is the method, so the field cannot be
	tname: str = ""

	# what the chain has accumulated, already rendered — `file=a.zg row=3`. It is a `str`
	# and not a `list` because the only thing ever done with it is to be appended to a
	# message, and a list would be a second representation of the same text.
	notes: str = ""

	# THE CHANNEL IS BIDIRECTIONAL, and the direction is what makes the runner's loop
	# end: a channel closes when its last SEND-capable holder goes, and the runner holds
	# a `<-chan[Event]` which is not one. So the context — held only by the coroutine
	# running the test — is the last sender, and the body returning is what ends the
	# stream.
	#
	# THE FIELD IS `pub` BECAUSE THE ALTERNATIVE IS A DEFAULT NOBODY CAN WRITE. A
	# module-private field must carry one (`E482`), and the only value that would serve is
	# a FRESH channel per construction — `chan[Event]()`, a call. `zerg` takes that: a
	# default is evaluated per construction and may be a call (docs/core/types.md, "Field
	# defaults"). The bootstrap SEED does not, and `testing` is a module the seed's own
	# suite compiles, so the module has to stay inside the subset the seed reads. `pub`
	# is what drops the requirement instead of working around it: `context` below hands
	# every Context its channel, so the default was dead the day it was written.
	pub events: chan[Event]
}

# context builds the Context for one test. It is the generated driver's entry point and
# not something a test writes: a test is HANDED one.
pub fn context(name: str, events: chan[Event]) -> Context {
	return Context(name, "", events)
}

impl Context {
	# name is which test this is — the function's own name, as the report prints it.
	pub fn name() -> str {
		return this.tname
	}

	# str / int / bool each add one NAMED value to the context the next assertion carries,
	# and answer the context to chain the following one onto:
	#
	#   t.str("file", path).int("row", i).assert(ok, "the row did not round-trip")
	#
	# They are named for the type they take because that is the only way to take one (see
	# the note above the type), and they are the ordinary way to put a value into a failure
	# now that `assert_eq` and `assert_ne` name theirs themselves.
	pub fn str(key: str, value: str) -> This {
		return this.noted(key, value)
	}

	pub fn int(key: str, value: int) -> This {
		return this.noted(key, f"{value}")
	}

	pub fn bool(key: str, value: bool) -> This {
		return this.noted(key, f"{value}")
	}

	# noted is the copy the three above share: one more `key=value` on the end, on a context
	# that is this one plus that field and is not this one.
	fn noted(key: str, value: str) -> This {
		mut c := this
		if c.notes != "" {
			c.notes = c.notes + " "
		}
		c.notes = f"{c.notes}{key}={value}"
		return c
	}

	# assert is the free `assert` with whatever the chain accumulated appended, and it is a
	# TERMINAL: a chain ends at an assertion or it never asserted anything.
	pub fn assert(cond: bool, msg: str = "") -> Result[nil] {
		raise detail("assertion failed", msg, this.notes) if not cond
		return nil
	}

	# log records a message to show ONLY IF this test fails. A test that logs its way
	# through a passing run is a test whose output nobody reads; the note earns its
	# place at the moment there is something to explain.
	pub fn log(msg: str) {
		this.events <- Event(EV_LOG, msg)
	}

	# skip says this test does not apply here — a platform it is not for, a resource that
	# is not present — and stops it. IT IS NOT A FAILURE, and the report counts it apart
	# from both.
	#
	# THE UNWIND SAYS "STOPPED" AND THE CONTEXT SAYS "WHY", which is the whole reason
	# there is no error KIND for either of these. `testing` is deliberately outside the
	# taxonomy (see the header): a claim that did not hold is not a value that was
	# refused, and a runner that told a skip from a failure by matching on a message
	# string would be reading prose as a protocol. So the raise carries nothing anyone
	# reads, the event carries everything, and the runner asks the context.
	pub fn skip(reason: str) -> Result[nil] {
		this.events <- Event(EV_SKIP, reason)
		raise "test skipped"
	}

	# fatal stops this test now, failed. It is what a test says when going on would only
	# produce noise — a fixture that did not open, a parse that returned nothing to
	# assert about.
	pub fn fatal(msg: str) -> Result[nil] {
		this.events <- Event(EV_FATAL, msg)
		raise "test failed"
	}
}

# finished is what the driver says after the body is out of its hands: `ok` when it
# returned, and otherwise the message it raised. It is the last event on the channel.
pub fn finished(ctx: Context, ok: bool, msg: str) {
	if ok {
		ctx.events <- Event(EV_DONE, "")
	} else {
		ctx.events <- Event(EV_RAISE, msg)
	}
}

# collect drains one test's channel and says what the test came to.
#
# A MISSING TERMINAL EVENT IS A CRASH, and it is the default rather than a branch: the
# loop ends either because the sender finished — which it does only after `finished` —
# or because the coroutine died, and only the first can have said DONE or RAISE. A death
# also raises out of the receive (the channel closes carrying the producer's Err, or the
# runtime finds nothing left to run), which is what the `guard` is for; both routes land
# on the same verdict.
pub fn collect(rx: <-chan[Event]) -> Outcome {
	mut notes := ""
	mut verdict := "crash"
	mut text := ""
	mut why := ""
	mut skipped := false

	guard {
		for ev in rx {
			if ev.kind == EV_LOG {
				notes = notes + ev.text + "\n"
			} else if ev.kind == EV_SKIP {
				skipped = true
				why = ev.text
			} else if ev.kind == EV_FATAL {
				why = ev.text
			} else if ev.kind == EV_DONE {
				verdict = "ok"
			} else if ev.kind == EV_RAISE {
				verdict = "fail"
				text = ev.text
			}
		}
	}

	if verdict == "fail" {
		# `skip` and `fatal` both arrive as a raise, and the context is what tells them
		# from each other and from an assertion nobody wrote a reason for
		return Outcome("skip", why) if skipped
		if why != "" {
			text = why
		}
		return Outcome("fail", notes + text)
	}
	return Outcome(verdict, text)
}
