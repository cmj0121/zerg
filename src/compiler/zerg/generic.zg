# generic — monomorphization (docs/core/specs.md, GRAMMAR group 6).
#
# A generic function is a TEMPLATE, not a function. Nothing is emitted for the declaration
# itself; what reaches C is one specialization per distinct set of type arguments some call
# site asks for. C has no generics, and erasing to a common representation would need a
# uniform boxed value — which this language does not have, because a `list[int]` is int64s
# and not pointers.
#
# The whole pass is an AST-to-AST substitution: `subst_fn` copies the template with each
# type parameter replaced, and what comes back is an ORDINARY FnDecl. Everything downstream
# — the checker, the emitter, the name mangler, the copy and drop rules — handles it with no
# knowledge that a generic was ever involved. That is the point of doing it here and not
# later: a type parameter that survives into lowering is a type the C backend has no width
# for, and every pass would need an opinion about it.
#
# The type ARGUMENTS are not written at the call site. They are solved from the argument
# types by matching the template's declared parameter types against them, which is what
# makes `assert_eq(1, 1)` legal without spelling `assert_eq[int]`.

# gen_mangle is the C-visible name of one specialization. The type arguments go into the
# name because they are what distinguishes it: two instantiations of one template are two
# functions, and a name that dropped them would collide the moment a program used both.
#
# `$` is not legal in a Zerg identifier, so a mangled name cannot collide with one a
# program declares. It is mapped to `_` on the way into C, which does not accept it either.
pub fn gen_mangle(name: str, args: list[Ty]) -> str {
	mut out := name
	for a in args {
		out = out + "$" + gen_ty_key(a)
	}
	return out
}

# gen_ty_key is a type as a name fragment. It has to tell any two distinct types apart, and
# ty_name already does — the substitution below is only to keep the result an identifier.
fn gen_ty_key(t: Ty) -> str {
	mut out := ""
	for b in list[byte](ty_name(t)) {
		out = out + gen_key_byte(b)
	}
	return out
}

fn gen_key_byte(b: byte) -> str {
	return "_" if not gen_is_ident_byte(b)

	mut one: list[byte] = []
	one.append(b)
	return str(one)
}

fn gen_is_ident_byte(b: byte) -> bool {
	return true if b >= b'0' and b <= b'9'
	return true if b >= b'A' and b <= b'Z'
	return true if b >= b'a' and b <= b'z'

	return b == b'_'
}

# gen_is_tparam reports whether a name is one of the template's type parameters.
pub fn gen_is_tparam(names: list[str], nm: str) -> bool {
	for n in names {
		return true if n == nm
	}
	return false
}

# gen_solve works out what each type parameter must be, from the types the call actually
# passes. It matches each declared parameter type against the argument's type STRUCTURALLY,
# so a `list[T]` parameter given a `list[int]` solves T, not only a bare `T`.
#
# An unsolved parameter answers TUnknown, and the caller reports it: a type argument that
# cannot be worked out is a call that has not said what it means, and guessing `int` would
# make the program compile as something nobody wrote.
pub fn gen_solve(tparams: list[str], decls: list[Ty], actuals: list[Ty]) -> list[Ty] {
	mut sol: list[Ty] = []
	for n in tparams {
		sol.append(TUnknown)
	}
	mut i := 0
	for i < decls.len() and i < actuals.len() {
		gen_match(tparams, sol, decls[i], actuals[i])
		i = i + 1
	}
	return sol
}

# gen_match walks a declared type and an actual one together, recording a binding wherever
# the declared side is a type parameter. The FIRST binding wins: `f(a: T, b: T)` given an
# int and a str takes int, and the mismatch is then reported by the ordinary argument rule
# against the specialization's own signature — which says `b: int` and means it.
fn gen_match(tparams: list[str], mut &sol: list[Ty], decl: Ty, actual: Ty) {
	nm := c_named_of(decl)
	if nm != "" and gen_is_tparam(tparams, nm) {
		mut i := 0
		for i < tparams.len() {
			if tparams[i] == nm and c_is_unknown(sol[i]) {
				sol[i] = actual
				return
			}
			i = i + 1
		}
		return
	}
	gen_match_inner(tparams, sol, decl, actual)
}

# gen_match_inner is the structural half: a container's element, a carrier's payload, a
# function type's parameters and result. Each pair is matched by POSITION, and a shape that
# does not line up simply binds nothing — the argument rule downstream is what reports it.
fn gen_match_inner(tparams: list[str], mut &sol: list[Ty], decl: Ty, actual: Ty) {
	match decl {
		TList(e)      => gen_match(tparams, sol, e, gen_elem_of(actual))
		TOpt(e)       => gen_match(tparams, sol, e, gen_payload_of(actual))
		TChan(e, d)   => gen_match(tparams, sol, e, gen_elem_of(actual))
		TMap(k, v)    => gen_match_map(tparams, sol, k, v, actual)
		TTuple(es)    => gen_match_all(tparams, sol, es, gen_parts_of(actual))
		TEither(x, y) => gen_match_either(tparams, sol, x, y, actual)
		TFn(ps, r)    => gen_match_fn(tparams, sol, ps, r, actual)
		_             => gen_nop()
	}
}

fn gen_nop() {
}

fn gen_match_map(tparams: list[str], mut &sol: list[Ty], k: Ty, v: Ty, actual: Ty) {
	match actual {
		TMap(ak, av) => gen_match_two(tparams, sol, k, ak, v, av)
		_            => gen_nop()
	}
}

fn gen_match_either(tparams: list[str], mut &sol: list[Ty], x: Ty, y: Ty, actual: Ty) {
	match actual {
		TEither(ax, ay) => gen_match_two(tparams, sol, x, ax, y, ay)
		_ => gen_nop()
	}
}

fn gen_match_fn(tparams: list[str], mut &sol: list[Ty], ps: list[Ty], r: Ty, actual: Ty) {
	match actual {
		TFn(aps, ar) => gen_match_fnparts(tparams, sol, ps, r, aps, ar)
		_            => gen_nop()
	}
}

fn gen_match_fnparts(tparams: list[str], mut &sol: list[Ty], ps: list[Ty], r: Ty, aps: list[Ty], ar: Ty) {
	gen_match_all(tparams, sol, ps, aps)
	gen_match(tparams, sol, r, ar)
}

fn gen_match_two(tparams: list[str], mut &sol: list[Ty], a: Ty, aa: Ty, b: Ty, ba: Ty) {
	gen_match(tparams, sol, a, aa)
	gen_match(tparams, sol, b, ba)
}

fn gen_match_all(tparams: list[str], mut &sol: list[Ty], ds: list[Ty], as_: list[Ty]) {
	mut i := 0
	for i < ds.len() and i < as_.len() {
		gen_match(tparams, sol, ds[i], as_[i])
		i = i + 1
	}
}

# The three readers below take a shape APART without knowing it has one — an actual type
# that is not the container the declaration expects answers TUnknown, which binds nothing.
fn gen_elem_of(t: Ty) -> Ty {
	return match t {
		TList(e)    => e
		TChan(e, d) => e
		_           => TUnknown
	}
}

fn gen_payload_of(t: Ty) -> Ty {
	return match t {
		TOpt(e) => e
		_       => TUnknown
	}
}

fn gen_parts_of(t: Ty) -> list[Ty] {
	return match t {
		TTuple(es) => es
		_          => []
	}
}

# --- substitution -------------------------------------------------------------------
#
# One template plus one set of type arguments makes one ordinary function. Every node that
# can carry a type is rebuilt; every node that cannot is rebuilt too, because a walk that
# returned the original for "nothing to do here" would have to know which subtrees contain
# a type, and that is the same question one level up.

# subst_fn specializes a template. The result has NO type parameters — that is what makes
# it an ordinary function, and what stops it being instantiated again.
pub fn subst_fn(tpl: FnDecl, args: list[Ty]) -> FnDecl {
	names := tpl.tparams
	mut ps: list[Param] = []
	for pm in tpl.params {
		ps.append(Param(pm.name, subst_ty(names, args, pm.ty), pm.is_ref, pm.has_def, subst_expr(names, args, pm.def)))
	}
	return FnDecl(gen_mangle(tpl.name, args), tpl.recv, ps, tpl.has_ret, subst_ty(names, args, tpl.ret), subst_block(names, args, tpl.body), tpl.is_pub, tpl.path, tpl.line, tpl.col, [], [])
}

# subst_ty replaces a type parameter wherever a type is written, at any depth.
pub fn subst_ty(names: list[str], args: list[Ty], t: Ty) -> Ty {
	nm := c_named_of(t)
	if nm != "" {
		mut i := 0
		for i < names.len() {
			return args[i] if names[i] == nm and i < args.len()
			i = i + 1
		}
		return t
	}
	return match t {
		TList(e)      => TList(subst_ty(names, args, e))
		TOpt(e)       => TOpt(subst_ty(names, args, e))
		TChan(e, d)   => TChan(subst_ty(names, args, e), d)
		TMap(k, v)    => TMap(subst_ty(names, args, k), subst_ty(names, args, v))
		TTuple(es)    => TTuple(subst_tys(names, args, es))
		TEither(x, y) => TEither(subst_ty(names, args, x), subst_ty(names, args, y))
		TFn(ps, r)    => TFn(subst_tys(names, args, ps), subst_ty(names, args, r))
		_             => t
	}
}

fn subst_tys(names: list[str], args: list[Ty], ts: list[Ty]) -> list[Ty] {
	mut out: list[Ty] = []
	for t in ts {
		out.append(subst_ty(names, args, t))
	}
	return out
}

fn subst_block(names: list[str], args: list[Ty], b: list[Stmt]) -> list[Stmt] {
	mut out: list[Stmt] = []
	for s in b {
		out.append(subst_stmt(names, args, s))
	}
	return out
}

fn subst_stmt(names: list[str], args: list[Ty], s: Stmt) -> Stmt {
	return match s {
		SLet(nm, ty, ht, im, v) => SLet(nm, subst_ty(names, args, ty), ht, im, subst_expr(names, args, v))
		SAssign(l, r) => SAssign(subst_expr(names, args, l), subst_expr(names, args, r))
		SPrint(v) => SPrint(subst_expr(names, args, v))
		SReturn(hv, v) => SReturn(hv, subst_expr(names, args, v))
		SReturnIf(v, c) => SReturnIf(subst_expr(names, args, v), subst_expr(names, args, c))
		SExpr(v) => SExpr(subst_expr(names, args, v))
		SIf(c, tb, he, eb) => SIf(subst_expr(names, args, c), subst_block(names, args, tb), he, subst_block(names, args, eb))
		SFor(hc, c, b) => SFor(hc, subst_expr(names, args, c), subst_block(names, args, b))
		SForIn(nm, it, b) => SForIn(nm, subst_expr(names, args, it), subst_block(names, args, b))
		SForSelect(arms) => SForSelect(subst_sel_arms(names, args, arms))
		SRaise(e, hf, cause) => SRaise(subst_expr(names, args, e), hf, subst_expr(names, args, cause))
		SDefer(v) => SDefer(subst_expr(names, args, v))
		SSpawn(v) => SSpawn(subst_expr(names, args, v))
		SSend(ch, v) => SSend(subst_expr(names, args, ch), subst_expr(names, args, v))
		SSelect(arms) => SSelect(subst_sel_arms(names, args, arms))
		SClose(ch, tw) => SClose(subst_expr(names, args, ch), tw)
		SIfLet(nm, v, tb, he, eb) => SIfLet(nm, subst_expr(names, args, v), subst_block(names, args, tb), he, subst_block(names, args, eb))
		_ => s
	}
}

fn subst_sel_arms(names: list[str], args: list[Ty], arms: list[SelArm]) -> list[SelArm] {
	mut out: list[SelArm] = []
	for a in arms {
		out.append(SelArm(a.op, a.bind, subst_expr(names, args, a.ch), subst_expr(names, args, a.val), subst_block(names, args, a.body)))
	}
	return out
}

fn subst_expr(names: list[str], args: list[Ty], e: Expr) -> Expr {
	return match e {
		EUnary(o, x) => EUnary(o, subst_expr(names, args, x))
		EBinary(o, a, b) => EBinary(o, subst_expr(names, args, a), subst_expr(names, args, b))
		ECall(nm, xs) => ECall(nm, subst_exprs(names, args, xs))
		EField(x, f) => EField(subst_expr(names, args, x), f)
		EOptChain(x, f) => EOptChain(subst_expr(names, args, x), f)
		ETry(x) => ETry(subst_expr(names, args, x))
		EIndex(x, i) => EIndex(subst_expr(names, args, x), subst_expr(names, args, i))
		EMethod(x, m, xs) => EMethod(subst_expr(names, args, x), m, subst_exprs(names, args, xs))
		EListLit(xs) => EListLit(subst_exprs(names, args, xs))
		EConv(ty, x, as_) => EConv(subst_ty(names, args, ty), subst_expr(names, args, x), as_)
		EIf(c, a, b) => EIf(subst_expr(names, args, c), subst_expr(names, args, a), subst_expr(names, args, b))
		EMatch(x, arms) => EMatch(subst_expr(names, args, x), subst_arms(names, args, arms))
		ERange(a, b, inc) => ERange(subst_expr(names, args, a), subst_expr(names, args, b), inc)
		ETuple(xs) => ETuple(subst_exprs(names, args, xs))
		EMapLit(ks, vs) => EMapLit(subst_exprs(names, args, ks), subst_exprs(names, args, vs))
		EFn(ps, hr, r, b) => subst_fn_expr(names, args, ps, hr, r, b)
		EChanNew(ty, cap) => EChanNew(subst_ty(names, args, ty), subst_expr(names, args, cap))
		ERecv(x) => ERecv(subst_expr(names, args, x))
		EForce(x) => EForce(subst_expr(names, args, x))
		ECoalesce(a, b, jump) => ECoalesce(subst_expr(names, args, a), subst_expr(names, args, b), subst_block(names, args, jump))
		EGuard(b) => EGuard(subst_block(names, args, b))
		EIs(x, nm) => EIs(subst_expr(names, args, x), nm)
		EIn(x, s) => EIn(subst_expr(names, args, x), subst_expr(names, args, s))
		_ => e
	}
}

fn subst_fn_expr(names: list[str], args: list[Ty], ps: list[Param], hr: bool, r: Ty, b: list[Stmt]) -> Expr {
	mut out: list[Param] = []
	for pm in ps {
		out.append(Param(pm.name, subst_ty(names, args, pm.ty), pm.is_ref, pm.has_def, subst_expr(names, args, pm.def)))
	}
	return EFn(out, hr, subst_ty(names, args, r), subst_block(names, args, b))
}

fn subst_exprs(names: list[str], args: list[Ty], xs: list[Expr]) -> list[Expr] {
	mut out: list[Expr] = []
	for x in xs {
		out.append(subst_expr(names, args, x))
	}
	return out
}

fn subst_arms(names: list[str], args: list[Ty], arms: list[Arm]) -> list[Arm] {
	mut out: list[Arm] = []
	for a in arms {
		out.append(Arm(a.pat, subst_expr(names, args, a.lit), a.bind, a.ctor, a.binds, a.has_guard, subst_expr(names, args, a.guard_expr), subst_expr(names, args, a.body)))
	}
	return out
}
