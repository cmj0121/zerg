	CtorArgCount = 311
	MutRefArgEscapes = 312
	StoreThroughValue = 313
	SpecUnknown = 314
	ImplTypeArgCount = 315
	SpecExtendsUnknown = 316
	SpecMethodMismatch = 317
	SpecRequirementUnmet = 318
	IntLiteralOverflow = 319
	StrNotIndexable = 320
	IfBranchTypes = 321
	MatchArmTypes = 322
	BorrowOfValue = 323
	WriteBackToThis = 324
	WriteBackToImmutable = 325
	MutRefAliasInCall = 326
	CallArgCount = 327
	CallMissingArgs = 328
	ListElementType = 329
	ValueOutOfType = 330
	DivideByZero = 331
	IntRangeOverflow = 332
	ReturnType = 333
	BindingTypeMismatch = 335
	BindingHasNoType = 336
	TypedefNamesNoType = 337
	FieldOrPayloadType = 338
	AssignType = 339
	ArgumentType = 340
	OptionalOperand = 341
	OpNoMeaning = 342
	OpWantsBool = 343
	OpWantsInt = 344
	OpWantsNumeric = 345
