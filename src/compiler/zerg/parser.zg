# parser — tokens to an AST for the self-hosting Zerg compiler (M2).
#
# A recursive-descent parser over the token stream, following the GRAMMAR group-4
# precedence ladder (or < and < cmp < add < mul < unary < call < primary). It covers the
# Zerg-boot subset the examples corpus needs: function declarations; the binding,
# assignment, print, return / return-if, if / else-if / else, for, break, continue, nop,
# and bare-expression statements; and the literal / identifier / unary / binary / call /
# match expression forms. Operators are stored by their Zerg spelling; the emitter maps
# them to C. Forms outside the subset are skipped rather than parsed.
import "strconv"

# Parser holds the token list, the read cursor, and — while an `impl T { … }` block is
# being read — the type that block is for, which is what `This` names inside it.
struct Parser {
	toks: list[Token]
	pos: int
	impl_ty: str
}

fn cur(mut &p: Parser) -> Token {
	return p.toks[p.pos] if p.pos < p.toks.len()
	return Token(Eof, "", "", 0, 0)
}

fn cur_kind(mut &p: Parser) -> Kind {
	return cur(p).kind
}

fn peek_kind(mut &p: Parser, n: int) -> Kind {
	j := p.pos + n
	return p.toks[j].kind if j < p.toks.len()
	return Eof
}

fn p_at(mut &p: Parser, k: Kind) -> bool {
	return cur_kind(p) == k
}

fn p_advance(mut &p: Parser) {
	p.pos = p.pos + 1
}

# expect consumes the current token when it is of the wanted kind; on a mismatch it
# leaves the cursor put (the subset corpus is well-formed, so this is a no-op there).
fn expect(mut &p: Parser, k: Kind) {
	if p_at(p, k) {
		p_advance(p)
	}
}

fn skip_semis(mut &p: Parser) {
	for p_at(p, Semi) {
		p_advance(p)
	}
}

# ident_name extracts the identifier spelling from an EIdent expression (the assignment
# and call targets in the subset), or "" for anything else.
fn ident_name(e: Expr) -> str {
	return match e {
		EIdent(n) => n
		_ => ""
	}
}

# --- types ---------------------------------------------------------------------

fn parse_type(mut &p: Parser) -> Ty {
	mut name := cur(p).lexeme
	p_advance(p)

	# A MODULE-QUALIFIED type, `cli.Opt`: every module of a program flattens into one
	# scope, so the qualifier only says where the type came from and the last segment is
	# the name. Reading it this way is what lets a program use a type another module
	# declares — without it the qualifier parses as a type of its own and the emitter
	# spells a name nothing declared.
	for p_at(p, Dot) {
		p_advance(p)
		name = cur(p).lexeme
		p_advance(p)
	}

	# `This` is the self type: inside an impl it is the type that impl is for. Resolving it
	# at parse time keeps it out of the emitter, which has no notion of a self type.
	return TNamed(p.impl_ty) if name == "This" and p.impl_ty != ""

	# A function type, `fn(P, ...) -> R`. A result is optional: `fn(int)` returns nothing.
	if name == "fn" and p_at(p, LParen) {
		p_advance(p)
		mut ptys: list[Ty] = []
		for not p_at(p, RParen) and not p_at(p, Eof) {
			ptys.append(parse_type(p))
			if p_at(p, Comma) {
				p_advance(p)
			}
		}
		expect(p, RParen)
		mut fret := TVoid
		if p_at(p, Arrow) {
			p_advance(p)
			fret = parse_type(p)
		}
		return TFn(ptys, fret)
	}
	if name == "chan" and p_at(p, LBrack) {
		p_advance(p)
		elem := parse_type(p)
		expect(p, RBrack)
		return TChan(elem)
	}
	if name == "map" and p_at(p, LBrack) {
		p_advance(p)
		kt := parse_type(p)
		if p_at(p, Comma) {
			p_advance(p)
		}
		vt := parse_type(p)
		expect(p, RBrack)
		return TMap(kt, vt)
	}
	if name == "list" and p_at(p, LBrack) {
		p_advance(p)
		elem := parse_type(p)
		expect(p, RBrack)
		return TList(elem)
	}
	if name == "Result" and p_at(p, LBrack) {
		# the subset ignores the error channel: Result[T] is treated as T's happy path,
		# and Result[nil] as void
		p_advance(p)
		inner := parse_type(p)
		expect(p, RBrack)
		return inner
	}

	return TInt if name == "int"
	return TFloat if name == "float"
	return TStr if name == "str"
	return TBool if name == "bool"
	return TByte if name == "byte"

	if name == "uint" {
		# the subset models uint as int64_t (it never parses top-bit values)
		return TInt
	}
	return TNil if name == "nil"
	return TNamed(name)
}

# is_conv reports whether a callee name is a scalar type conversion.
fn is_conv(name: str) -> bool {
	return name == "int" or name == "byte" or name == "str" or name == "float" or name == "bool" or name == "uint"
}

fn conv_ty(name: str) -> Ty {
	return TInt if name == "int" or name == "uint"
	return TByte if name == "byte"
	return TFloat if name == "float"
	return TBool if name == "bool"

	return TStr
}

# --- declarations --------------------------------------------------------------

# parse turns source into a File. Imports, structs, enums, functions, and `impl` blocks
# are recognised at the top level; any other top-level token is skipped.
pub fn parse(src: str) -> File {
	toks := tokenize(src)
	mut p := Parser(toks, 0, "")
	mut imports: list[str] = []
	mut structs: list[StructDecl] = []
	mut enums: list[EnumDecl] = []
	mut fns: list[FnDecl] = []
	mut consts: list[Stmt] = []
	skip_semis(p)
	for not p_at(p, Eof) {
		if p_at(p, Import) {
			parse_import(p, imports)
		} else if p_at(p, Pub) {
			# `pub` binds to the declaration that follows it
			p_advance(p)
			if p_at(p, Fn) {
				fns.append(parse_fn(p, true, ""))
			}
		} else if p_at(p, Fn) {
			fns.append(parse_fn(p, false, ""))
		} else if p_at(p, Struct) {
			structs.append(parse_struct(p))
		} else if p_at(p, Enum) {
			enums.append(parse_enum(p))
		} else if p_at(p, Spec) {
			parse_spec(p)
		} else if p_at(p, Const) {
			# `const` at the top level is a module constant, not a statement: it becomes a
			# C global rather than a local of any function
			p_advance(p)
			consts.append(parse_binding(p, false))
		} else if p_at(p, Init) {
			fns.append(parse_init(p, fns.len()))
		} else if p_at(p, Impl) {
			parse_impl(p, fns)
		} else {
			p_advance(p)
		}
		skip_semis(p)
	}
	return File(imports, structs, enums, fns, consts)
}

# imports_of returns just the import paths of a source, for the driver's module loader:
# it resolves and loads a program's dependencies before anything is emitted, so it needs
# the import list alone and not the cost of keeping a whole parse around.
pub fn imports_of(src: str) -> list[str] {
	return parse(src).imports
}

# parse_fill reads the tail of `[v; N]` and expands it: the count is a const-expr, and an
# integer literal is the whole of that this compiler evaluates, so N copies are written out
# here rather than carried as a shape the emitter would have to understand.
fn parse_fill(mut &p: Parser, v: Expr) -> Expr {
	n := cur(p)
	mut out: list[Expr] = []
	if n.kind != Int {
		raise "NotImplemented: a fill count that is not an integer literal"
	}
	p_advance(p)
	expect(p, RBrack)
	mut i := 0
	count := strconv.parse_int(n.lexeme, 10)
	for i < count {
		out.append(v)
		i = i + 1
	}
	return EListLit(out)
}

# parse_fn_expr reads `fn(p: T) -> R { … }` in expression position — the same shape a
# declaration has, minus the name. GRAMMAR gives a fn-expr no generic parameters, so there
# is no bracket group to read here.
fn parse_fn_expr(mut &p: Parser) -> Expr {
	p_advance(p) # 'fn'
	expect(p, LParen)
	mut params: list[Param] = []
	for not p_at(p, RParen) and not p_at(p, Eof) {
		mut is_ref := false
		if p_at(p, Mut) {
			p_advance(p)
			if p_at(p, Amp) {
				p_advance(p)
				is_ref = true
			}
		}
		pname := cur(p).lexeme
		p_advance(p)
		expect(p, Colon)
		pty := parse_type(p)
		params.append(Param(pname, pty, is_ref, false, ENil))
		if p_at(p, Comma) {
			p_advance(p)
		}
	}
	expect(p, RParen)
	mut ret := TVoid
	mut has_ret := false
	if p_at(p, Arrow) {
		p_advance(p)
		ret = parse_type(p)
		has_ret = true
	}
	return EFn(params, has_ret, ret, parse_block(p))
}

# parse_map_lit reads `{k: v, …}` and the empty `{:}`.
#
# The `:` is what makes a map literal unambiguous: GRAMMAR gives the empty map the
# spelling `{:}` rather than `{}` precisely so that a brace with no colon in it is ALWAYS
# a block. Nothing here has to guess.
fn parse_map_lit(mut &p: Parser) -> Expr {
	p_advance(p) # '{'
	mut ks: list[Expr] = []
	mut vs: list[Expr] = []
	if p_at(p, Colon) {
		# the empty map, `{:}`
		p_advance(p)
		expect(p, RBrace)
		return EMapLit(ks, vs)
	}
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		ks.append(parse_expr(p))
		expect(p, Colon)
		vs.append(parse_expr(p))
		break if not p_at(p, Comma)
		p_advance(p)
	}
	expect(p, RBrace)
	return EMapLit(ks, vs)
}

# parse_spec consumes a `spec S { … }` declaration whole and yields nothing.
#
# A spec is an INTERFACE: it declares signatures, and the code for them lives in the
# `impl S for T` blocks, which parse_impl already reads. So there is nothing here to lower
# — but there is something to skip, and skipping it correctly is the point. parse's
# fallthrough advances ONE token, which left the body's `fn show() -> str` to be read as a
# top-level function with no block; the emitter then wrote a non-void C function with an
# empty body, which is undefined behaviour that only warns.
#
# Provided default methods inside a spec are not supported yet and are skipped with the
# rest of the block.
fn parse_spec(mut &p: Parser) {
	p_advance(p) # 'spec'
	skip_to_block_end(p)
}

# skip_to_block_end consumes tokens through the matching `}` of the next `{`. Anything
# before that brace — a name, generic parameters, a bound — goes with it.
fn skip_to_block_end(mut &p: Parser) {
	for not p_at(p, LBrace) and not p_at(p, Eof) {
		p_advance(p)
	}
	return if p_at(p, Eof)
	mut depth := 0
	for not p_at(p, Eof) {
		if p_at(p, LBrace) {
			depth = depth + 1
		} else if p_at(p, RBrace) {
			depth = depth - 1
			if depth == 0 {
				p_advance(p)
				return
			}
		}
		p_advance(p)
	}
}

# parse_init reads `init() { … }`, the lazy-setup declaration, as an ordinary function so
# nothing downstream needs a second notion of a callable. GRAMMAR allows MANY of them and
# runs each once in declaration order, so the name carries the position it was read at —
# `init` twice over would otherwise be one C symbol twice.
#
# The name is not one a program can write (`init` is a keyword), which is what keeps it
# from colliding with anything the source declares.
fn parse_init(mut &p: Parser, at: int) -> FnDecl {
	p_advance(p) # 'init'
	expect(p, LParen)
	expect(p, RParen)
	mut params: list[Param] = []
	body := parse_block(p)
	return FnDecl(init_name(at), "", params, false, TVoid, body, false)
}

pub fn init_name(at: int) -> str {
	return "init__" + strconv.to_string(at, 10)
}

pub fn is_init_name(name: str) -> bool {
	return strings_has_prefix(name, "init__")
}

fn strings_has_prefix(s: str, pre: str) -> bool {
	b := list[byte](s)
	q := list[byte](pre)
	return false if b.len() < q.len()
	mut i := 0
	for i < q.len() {
		return false if b[i] != q[i]
		i = i + 1
	}
	return true
}

# parse_import reads both forms GRAMMAR gives an import — one spec, or a parenthesized
# group of them — and appends every path it binds.
#
# The group matters more than it looks: F404 writes it, and a parser that skipped it would
# hand the driver an EMPTY import list for a file that imports things. Nothing would fail
# at the parse — the module loader would simply not load `io`, and the failure would
# surface later and elsewhere as an unknown name.
fn parse_import(mut &p: Parser, mut &imports: list[str]) {
	p_advance(p) # 'import'
	if not p_at(p, LParen) {
		path := parse_import_spec(p)
		if path != "" {
			imports.append(path)
		}
		return
	}
	p_advance(p) # '('
	skip_semis(p)
	for not p_at(p, RParen) and not p_at(p, Eof) {
		at := p.pos
		path := parse_import_spec(p)
		if path != "" {
			imports.append(path)
		}

		# a spec that read nothing would leave the position where it was: step over the
		# token rather than reading it forever
		if p.pos == at {
			p_advance(p)
		}
		skip_semis(p)
	}
	if p_at(p, RParen) {
		p_advance(p)
	}
}

# parse_import_spec reads `pub? "path" (as name)?` and yields the path, or "" when what is
# there is not a spec at all.
#
# `pub` re-exports what it imports. The driver has to LOAD it either way — a re-exported
# module is part of the program — so the marker is consumed and the path read as usual.
# `as` renames the namespace, which is a binding this parser does not track, so the name
# is consumed and the path is what comes back.
fn parse_import_spec(mut &p: Parser) -> str {
	if p_at(p, Pub) {
		p_advance(p)
	}
	return "" if not p_at(p, Str)
	t := cur(p)
	p_advance(p) # the path
	if p_at(p, As) {
		p_advance(p) # 'as'
		if p_at(p, Ident) {
			p_advance(p)
		}
	}
	return t.value # the decoded path, without its quotes
}

fn parse_enum(mut &p: Parser) -> EnumDecl {
	p_advance(p) # 'enum'
	name := cur(p).lexeme
	p_advance(p) # name
	expect(p, LBrace)
	skip_semis(p)
	mut variants: list[VariantDef] = []
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		vname := cur(p).lexeme
		p_advance(p)
		mut fields: list[Ty] = []
		if p_at(p, LParen) {
			p_advance(p)
			for not p_at(p, RParen) and not p_at(p, Eof) {
				fields.append(parse_type(p))
				if p_at(p, Comma) {
					p_advance(p)
				}
			}
			expect(p, RParen)
		}
		variants.append(VariantDef(vname, fields))
		skip_semis(p)
	}
	expect(p, RBrace)
	return EnumDecl(name, variants)
}

# is_pascal reports whether a name starts with an uppercase ASCII letter — the tell for
# a type / enum-variant name versus a lowercase binding.
fn is_pascal(s: str) -> bool {
	b := list[byte](s)
	return false if b.len() == 0
	v := int(b[0])
	return v >= 65 and v <= 90
}

fn parse_struct(mut &p: Parser) -> StructDecl {
	p_advance(p) # 'struct'
	name := cur(p).lexeme
	p_advance(p) # name
	expect(p, LBrace)
	skip_semis(p)
	mut fields: list[FieldDef] = []
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		# a field may be declared `pub`; visibility does not reach the emitted C, which is
		# one flat struct either way, so the marker is read and dropped
		if p_at(p, Pub) {
			p_advance(p)
		}
		fname := cur(p).lexeme
		p_advance(p)
		expect(p, Colon)
		fty := parse_type(p)
		fields.append(FieldDef(fname, fty))
		skip_semis(p)
	}
	expect(p, RBrace)
	return StructDecl(name, fields)
}

# parse_impl reads an `impl T { … }` block and appends its methods to the file's flat
# function list, each carrying `T` as its receiver.
#
# The type is taken as the LAST type name before the `{`, at bracket depth zero. That one
# rule reads all three spellings the grammar allows — `impl T`, `impl T[A]`, and the spec
# form `impl Spec for T` — and lands on T in every one of them, which matters because the
# methods belong to T in all three.
fn parse_impl(mut &p: Parser, mut &fns: list[FnDecl]) {
	p_advance(p) # 'impl'
	mut target := ""
	mut depth := 0
	for not p_at(p, Eof) and not (p_at(p, LBrace) and depth == 0) {
		if p_at(p, LBrack) {
			depth = depth + 1
		} else if p_at(p, RBrack) {
			depth = depth - 1
		} else if depth == 0 and p_at(p, Ident) {
			target = cur(p).lexeme
		}
		p_advance(p)
	}
	expect(p, LBrace)
	skip_semis(p)

	# `This` inside the block names the type the block is for; the parser resolves it here
	# rather than leaving a name the emitter would have to spell and could not.
	outer := p.impl_ty
	p.impl_ty = target
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		mut is_pub := false
		if p_at(p, Pub) {
			p_advance(p)
			is_pub = true
		}
		if p_at(p, Fn) {
			fns.append(parse_fn(p, is_pub, target))
		} else {
			# an associated binding or any other impl item is outside the subset
			p_advance(p)
		}
		skip_semis(p)
	}
	expect(p, RBrace)
	p.impl_ty = outer
}

fn parse_fn(mut &p: Parser, is_pub: bool, recv: str) -> FnDecl {
	p_advance(p) # 'fn'
	name := cur(p).lexeme
	p_advance(p) # name
	# `fn f[T](x: T)` — the bracket group was read as the parameter list, so `[T]` became
	# two parameters named `[` and `]` and the C came out unparseable
	if p_at(p, LBrack) {
		raise "NotImplemented: a generic function definition"
	}
	expect(p, LParen)
	mut params: list[Param] = []
	if recv != "" {
		# The receiver is not written in the parameter list — `this` is implicit — so it is
		# added here. From this point on a method is an ordinary function whose first
		# argument happens to be called `this`, which is why nothing below the parser needs
		# a notion of methods at all.
		params.append(Param("this", TNamed(recv), false, false, ENil))
	}
	for not p_at(p, RParen) and not p_at(p, Eof) {
		# an optional `mut &` prefix marks a mutable-reference parameter
		mut is_ref := false
		if p_at(p, Mut) {
			p_advance(p)
			if p_at(p, Amp) {
				p_advance(p)
				is_ref = true
			}
		}
		pname := cur(p).lexeme
		p_advance(p)
		expect(p, Colon)
		pty := parse_type(p)

		# `= <constant>` makes the parameter optional at the call site
		mut has_def := false
		mut def := ENil
		if p_at(p, Assign) {
			p_advance(p)
			def = parse_expr(p)
			has_def = true
		}
		params.append(Param(pname, pty, is_ref, has_def, def))
		if p_at(p, Comma) {
			p_advance(p)
		}
	}
	expect(p, RParen)
	mut has_ret := false
	mut ret := TVoid
	if p_at(p, Arrow) {
		p_advance(p)
		ret = parse_type(p)
		has_ret = true
	}
	body := parse_block(p)
	return FnDecl(name, recv, params, has_ret, ret, body, is_pub)
}

fn parse_block(mut &p: Parser) -> list[Stmt] {
	expect(p, LBrace)
	mut body: list[Stmt] = []
	skip_semis(p)
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		body.append(parse_stmt(p))
		skip_semis(p)
	}
	expect(p, RBrace)
	return body
}

# --- statements ----------------------------------------------------------------

fn parse_stmt(mut &p: Parser) -> Stmt {
	k := cur_kind(p)
	if k == Nop {
		p_advance(p)
		return SNop
	}
	if k == Print {
		p_advance(p)
		return SPrint(parse_expr(p))
	}
	if k == Raise {
		p_advance(p)
		return SRaise(parse_expr(p))
	}
	return parse_return(p) if k == Return
	if k == Break {
		p_advance(p)
		return parse_jump_guard(p, SBreak)
	}
	if k == Continue {
		p_advance(p)
		return parse_jump_guard(p, SContinue)
	}

	return parse_if(p) if k == If
	return parse_for(p) if k == For

	# The forms below parse to NOTHING today. Each was silently dropped: `spawn f()` ran
	# f() inline, `with`/`del` vanished, a `select` block's arms were read as loose
	# statements. Refusing by name is the least a compiler owes a program it cannot build.
	if k == Spawn {
		p_advance(p)
		return SSpawn(parse_expr(p))
	}
	if k == Select {
		raise "NotImplemented: select"
	}
	if k == With {
		raise "NotImplemented: with"
	}
	if k == Del {
		raise "NotImplemented: del"
	}
	if k == Defer {
		p_advance(p)
		return SDefer(parse_expr(p))
	}
	if k == Guard {
		# guard { ... } (optionally with a trailing else): the subset runs the happy
		# path only, so emit the guarded block's statements
		p_advance(p)
		body := parse_block(p)
		if p_at(p, Else) {
			p_advance(p)
			parse_block(p)
		}
		return SGuard(body)
	}
	if k == Mut {
		p_advance(p)
		return parse_binding(p, true)
	}
	if k == Const {
		p_advance(p)
		return parse_binding(p, false)
	}
	return parse_binding(p, false) if k == Ident and (peek_kind(p, 1) == Walrus or peek_kind(p, 1) == Colon)

	# expression statement or reassignment (the target may be a name, field, or index)
	e := parse_expr(p)
	if p_at(p, LArrow) {
		# `ch <- v` sends. It is a STATEMENT, not an expression: GRAMMAR gives it no
		# value, which is also what tells it from the prefix receive.
		p_advance(p)
		return SSend(e, parse_expr(p))
	}
	if p_at(p, Assign) {
		p_advance(p)
		return SAssign(e, parse_expr(p))
	}
	return SExpr(e)
}

# parse_binding parses `name := e` (inferred) or `name: T = e` (typed). const is folded
# into an immutable let (is_mut false); the emitter treats both as a plain C local.
fn parse_binding(mut &p: Parser, is_mut: bool) -> Stmt {
	name := cur(p).lexeme
	p_advance(p)
	if p_at(p, Walrus) {
		p_advance(p)
		return SLet(name, TUnknown, false, is_mut, parse_expr(p))
	}
	expect(p, Colon)
	ty := parse_type(p)
	expect(p, Assign)
	return SLet(name, ty, true, is_mut, parse_expr(p))
}

# parse_jump_guard reads the optional trailing `if cond` on a `break` or a `continue` —
# the same postfix `if` a conditional return takes (GRAMMAR group 6) — and desugars it
# into the `if cond { jump }` it is defined as. Going through the block form means the
# emitter needs to know nothing about it.
#
# Without this the `if` was left for the next statement to read, so `break if c` broke
# unconditionally and the condition became a dangling if with no block. Silently.
fn parse_jump_guard(mut &p: Parser, jump: Stmt) -> Stmt {
	return jump if not p_at(p, If)
	p_advance(p)
	mut body: list[Stmt] = []
	body.append(jump)
	mut none: list[Stmt] = []
	return SIf(parse_expr(p), body, false, none)
}

fn parse_return(mut &p: Parser) -> Stmt {
	p_advance(p) # 'return'
	return SReturn(false, ENil) if p_at(p, Semi) or p_at(p, RBrace) or p_at(p, Eof)

	# `return if c` — a bare early exit under a guard. It is desugared here into the
	# `if c { return }` it is defined as, because SReturnIf carries a VALUE and a bare
	# return has none; going through the block form means the emitter needs to know
	# nothing about it. Without this the `if` fell through to parse_expr and was read as an
	# if-EXPRESSION with no block, which swallowed the rest of the function — silently, and
	# only where the formatter had just produced the form.
	if p_at(p, If) {
		p_advance(p)
		mut body: list[Stmt] = []
		body.append(SReturn(false, ENil))
		mut none: list[Stmt] = []
		return SIf(parse_expr(p), body, false, none)
	}
	e := parse_expr(p)
	if p_at(p, If) {
		p_advance(p)
		return SReturnIf(e, parse_expr(p))
	}
	return SReturn(true, e)
}

fn parse_if(mut &p: Parser) -> Stmt {
	p_advance(p) # 'if'
	cond := parse_expr(p)
	then_body := parse_block(p)
	mut has_else := false
	mut else_body: list[Stmt] = []
	if p_at(p, Else) {
		p_advance(p)
		has_else = true
		if p_at(p, If) {
			# else-if: the else block is a single nested if statement
			else_body.append(parse_if(p))
		} else {
			else_body = parse_block(p)
		}
	}
	return SIf(cond, then_body, has_else, else_body)
}

fn parse_for(mut &p: Parser) -> Stmt {
	p_advance(p) # 'for'
	return SFor(false, ENil, parse_block(p)) if p_at(p, LBrace)

	# for-in: `for name in iterable { ... }`
	if p_at(p, Ident) and peek_kind(p, 1) == In {
		vname := cur(p).lexeme
		p_advance(p) # name
		p_advance(p) # 'in'
		iter := parse_expr(p)
		return SForIn(vname, iter, parse_block(p))
	}
	cond := parse_expr(p)
	body := parse_block(p)
	return SFor(true, cond, body)
}

# --- expressions ---------------------------------------------------------------

fn is_add_op(k: Kind) -> bool {
	return k == Plus or k == Minus or k == Pipe or k == Caret or k == PlusMod or k == MinusMod
}

fn is_mul_op(k: Kind) -> bool {
	return k == Star or k == Slash or k == Percent or k == StarMod or k == Shl or k == Shr or k == Amp
}

fn is_cmp_op(k: Kind) -> bool {
	return k == EqEq or k == Ne or k == Lt or k == Gt or k == Le or k == Ge
}

fn is_unary_op(k: Kind) -> bool {
	return k == Minus or k == Not or k == Tilde or k == MinusMod
}

fn parse_expr(mut &p: Parser) -> Expr {
	return parse_or(p)
}

fn parse_or(mut &p: Parser) -> Expr {
	mut left := parse_and(p)
	for p_at(p, Or) {
		p_advance(p)
		left = EBinary("or", left, parse_and(p))
	}
	return left
}

fn parse_and(mut &p: Parser) -> Expr {
	mut left := parse_cmp(p)
	for p_at(p, And) {
		p_advance(p)
		left = EBinary("and", left, parse_cmp(p))
	}
	return left
}

# parse_cmp is non-associative: at most one comparison operator.
fn parse_cmp(mut &p: Parser) -> Expr {
	left := parse_range(p)
	if is_cmp_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		return EBinary(op, left, parse_range(p))
	}
	return left
}

# parse_range reads `a..b` and `a..=b`. GRAMMAR puts this level between comparison and
# addition, which is what makes `v in 0..10` read as `v in (0..10)` rather than
# `(v in 0)..10` — the bound is an add-expr, so arithmetic inside it needs no parentheses.
fn parse_range(mut &p: Parser) -> Expr {
	lo := parse_add(p)
	k := cur_kind(p)
	return lo if k != DotDot and k != DotDotEq
	p_advance(p)
	return ERange(lo, parse_add(p), k == DotDotEq)
}

fn parse_add(mut &p: Parser) -> Expr {
	mut left := parse_mul(p)
	for is_add_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		left = EBinary(op, left, parse_mul(p))
	}
	return left
}

fn parse_mul(mut &p: Parser) -> Expr {
	mut left := parse_unary(p)
	for is_mul_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		left = EBinary(op, left, parse_unary(p))
	}
	return left
}

fn parse_unary(mut &p: Parser) -> Expr {
	# `<-ch` receives. GRAMMAR gives it its own level (recv-base) so `<-a.b` reads as
	# `<-(a.b)` and a chain of them nests, which is what recursing here gives.
	if p_at(p, LArrow) {
		p_advance(p)
		return ERecv(parse_unary(p))
	}
	if is_unary_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		return EUnary(op, parse_unary(p))
	}
	return parse_postfix(p)
}

# parse_postfix parses a primary then a chain of calls. In the subset the callee is
# always a bare identifier, so a call collapses to ECall(name, args).
fn parse_postfix(mut &p: Parser) -> Expr {
	mut e := parse_primary(p)
	for p_at(p, LParen) or p_at(p, Dot) or p_at(p, LBrack) {
		if p_at(p, LBrack) {
			p_advance(p) # '['
			idx := parse_expr(p)
			expect(p, RBrack)
			e = EIndex(e, idx)
		} else if p_at(p, Dot) {
			p_advance(p)
			fld := cur(p).lexeme
			p_advance(p)
			if p_at(p, LParen) {
				# method call: target.method(args)
				e = EMethod(e, fld, parse_call_args(p))
			} else {
				e = EField(e, fld)
			}
		} else {
			# free call: name(args), or a scalar type conversion like int(x)
			name := ident_name(e)
			args := parse_call_args(p)
			if is_conv(name) {
				e = EConv(conv_ty(name), args[0])
			} else {
				e = ECall(name, args)
			}
		}
	}
	return e
}

fn parse_call_args(mut &p: Parser) -> list[Expr] {
	p_advance(p) # '('
	mut args: list[Expr] = []
	for not p_at(p, RParen) and not p_at(p, Eof) {
		args.append(parse_expr(p))
		if p_at(p, Comma) {
			p_advance(p)
		}
	}
	expect(p, RParen)
	return args
}

fn parse_primary(mut &p: Parser) -> Expr {
	t := cur(p)
	k := t.kind
	if k == Int {
		p_advance(p)
		return EInt(t.lexeme)
	}
	if k == Byte {
		# a byte literal b'x' becomes its decimal code point
		p_advance(p)
		return EInt(strconv.to_string(int(list[byte](t.value)[0]), 10))
	}
	if k == Float {
		p_advance(p)
		return EFloat(t.lexeme)
	}
	if k == Str or k == RawStr {
		# a raw string differs from a plain one only in what the LEXER did with the
		# backslashes; by here both carry their text in `value`
		p_advance(p)
		return EStr(t.value)
	}
	if k == FStr {
		p_advance(p)
		return fstr_expr(p, t)
	}
	if k == True {
		p_advance(p)
		return EBool(true)
	}
	if k == False {
		p_advance(p)
		return EBool(false)
	}
	if k == Nil {
		p_advance(p)
		return ENil
	}
	if k == This {
		# the receiver reads as an ordinary binding, because the parser made it one
		p_advance(p)
		return EIdent("this")
	}
	if k == Ident {
		# list[T](x) — a list-type conversion (e.g. list[byte](s))
		if t.lexeme == "list" and peek_kind(p, 1) == LBrack {
			p_advance(p) # 'list'
			p_advance(p) # '['
			elem := parse_type(p)
			expect(p, RBrack)
			args := parse_call_args(p)
			return EConv(TList(elem), args[0])
		}
		p_advance(p)
		return EIdent(t.lexeme)
	}
	if k == Fn {
		return parse_fn_expr(p)
	}
	if k == Chan {
		# `chan[T](cap)` — the capacity is optional and defaults to an unbuffered
		# rendezvous, which is what a bare `chan[T]()` means
		p_advance(p)
		expect(p, LBrack)
		elem := parse_type(p)
		expect(p, RBrack)
		expect(p, LParen)
		mut cap: Expr = EInt("0")
		if not p_at(p, RParen) {
			cap = parse_expr(p)
		}
		expect(p, RParen)
		return EChanNew(elem, cap)
	}
	if k == Unsafe {
		# GRAMMAR makes this a block-EXPRESSION; today the block was swallowed whole and
		# its statements never ran
		raise "NotImplemented: unsafe"
	}
	if k == Asm {
		raise "NotImplemented: asm"
	}
	if k == Cmd {
		# A command literal runs a process, and what the EXPRESSION is worth — an exit
		# code, the output, a process handle — is a stdlib question GRAMMAR deliberately
		# leaves open. Until that is answered it refuses by name: today it parsed as
		# nothing at all, so `c := `echo hi`` silently bound 0.
		raise "NotImplemented: a command literal — " + t.lexeme
	}
	if k == LParen {
		# `(e)` is grouping and `(a, b)` is a tuple — the comma is what tells them apart,
		# so the first element is read before deciding which this is
		p_advance(p)
		inner := parse_expr(p)
		if not p_at(p, Comma) {
			expect(p, RParen)
			return inner
		}
		mut elems: list[Expr] = []
		elems.append(inner)
		for p_at(p, Comma) {
			p_advance(p)
			break if p_at(p, RParen)
			elems.append(parse_expr(p))
		}
		expect(p, RParen)
		return ETuple(elems)
	}
	if k == LBrace {
		return parse_map_lit(p)
	}
	if k == LBrack {
		# list literal: [] or [a, b, ...], or the FILL form [v; N]
		p_advance(p)
		mut elems: list[Expr] = []
		for not p_at(p, RBrack) and not p_at(p, Eof) {
			elems.append(parse_expr(p))
			# `[v; N]` is N copies of v. The `;` is the lexer's statement separator
			# elsewhere, which is exactly why it needs handling here: without it the
			# count was read as a second ELEMENT and the list came out the wrong length.
			if p_at(p, Semi) and elems.len() == 1 {
				p_advance(p)
				return parse_fill(p, elems[0])
			}
			if p_at(p, Comma) {
				p_advance(p)
			}
		}
		expect(p, RBrack)
		return EListLit(elems)
	}
	if k == If {
		# if-expression: if cond { expr } else { expr }
		p_advance(p)
		cond := parse_expr(p)
		expect(p, LBrace)
		skip_semis(p)
		then_e := parse_expr(p)
		skip_semis(p)
		expect(p, RBrace)
		expect(p, Else)
		expect(p, LBrace)
		skip_semis(p)
		else_e := parse_expr(p)
		skip_semis(p)
		expect(p, RBrace)
		return EIf(cond, then_e, else_e)
	}
	return parse_match(p) if k == Match
	p_advance(p)
	return ENil
}

fn parse_match(mut &p: Parser) -> Expr {
	p_advance(p) # 'match'
	scrut := parse_expr(p)
	expect(p, LBrace)
	skip_semis(p)
	mut arms: list[Arm] = []
	for not p_at(p, RBrace) and not p_at(p, Eof) {
		arms.append(parse_arm(p))
		skip_semis(p)
	}
	expect(p, RBrace)
	return EMatch(scrut, arms)
}

# parse_arm parses one `pattern [if guard] => body` arm. A bare identifier binds the
# scrutinee (or is the `_` wildcard); anything else is a literal pattern matched by
# equality.
fn parse_arm(mut &p: Parser) -> Arm {
	mut pat := 0
	mut lit := ENil
	mut bind := ""
	mut ctor := ""
	mut binds: list[str] = []
	if p_at(p, Ident) {
		name := cur(p).lexeme
		p_advance(p)
		if name == "_" {
			pat = 2
		} else if is_pascal(name) {
			# enum constructor pattern: `Variant` or `Variant(a, b)`
			pat = 3
			ctor = name
			if p_at(p, LParen) {
				p_advance(p)
				for not p_at(p, RParen) and not p_at(p, Eof) {
					binds.append(cur(p).lexeme)
					p_advance(p)
					if p_at(p, Comma) {
						p_advance(p)
					}
				}
				expect(p, RParen)
			}
		} else {
			pat = 1
			bind = name
		}
	} else {
		lit = parse_expr(p)
	}
	mut has_guard := false
	mut grd := ENil
	if p_at(p, If) {
		p_advance(p)
		has_guard = true
		grd = parse_expr(p)
	}
	expect(p, FatArrow)
	body := parse_expr(p)
	return Arm(pat, lit, bind, ctor, binds, has_guard, grd, body)
}

# --- f-strings ---------------------------------------------------------------------------
#
# An f-string DESUGARS here into the `+` chain it is defined to be, so ast.zg and emit.zg
# know nothing about f-strings: no node, no case, no runtime format engine. `f"a{x}b"`
# builds precisely the tree `"a" + str(x) + "b"` would.
#
# The fold is LEFT-leaning and always SEEDED with a str literal, and both halves are
# load-bearing. c_binexpr decides string concatenation from the LEFT operand's inferred
# type alone: with an EStr on the left every step lowers to zgs_concat. A right fold — the
# shape the seed uses — puts a hole on the left instead, and a hole that infers int falls
# through to the numeric path as `(zg_n + "b")`, which is valid C pointer arithmetic. No
# diagnostic, wrong output. The empty leading `""` of `f"{s}"` costs one concat and buys
# that away.
#
# Every hole is wrapped in `str(…)`, which is `display()` for a scalar and identity for a
# str, so a hole renders whatever it holds.
fn fstr_expr(mut &p: Parser, t: Token) -> Expr {
	src := list[byte](t.value)
	n := src.len()
	mut acc: Expr = ENil
	mut have := false
	mut lo := 0 # start of the literal run being gathered
	mut i := 0
	for i < n {
		c := src[i]
		if c == b'{' and i + 1 < n and src[i + 1] == b'{' {
			i = i + 2
		} else if c == b'}' and i + 1 < n and src[i + 1] == b'}' {
			i = i + 2
		} else if c == b'\\' {
			i = fstr_esc_end(src, i)
		} else if c == b'{' {
			txt := fstr_slice(src, lo, i)

			# the first part is emitted even when empty, so the fold is seeded with a str
			if txt != "" or not have {
				acc = fstr_join(acc, have, EStr(fstr_text(txt)))
				have = true
			}
			end := fstr_hole_end(src, i)
			acc = fstr_join(acc, have, fstr_hole(p, fstr_slice(src, i + 1, end)))
			have = true
			i = end + 1
			lo = i
		} else {
			i = i + 1
		}
	}
	tail := fstr_slice(src, lo, n)
	return fstr_join(acc, have, EStr(fstr_text(tail))) if tail != "" or not have
	return acc
}

fn fstr_join(acc: Expr, have: bool, part: Expr) -> Expr {
	return part if not have
	return EBinary("+", acc, part)
}

fn fstr_slice(src: list[byte], lo: int, hi: int) -> str {
	mut out: list[byte] = []
	mut i := lo
	for i < hi {
		out.append(src[i])
		i = i + 1
	}
	return str(out)
}

# fstr_esc_end steps over a backslash escape. `\u{…}` carries braces of its own, which is
# the reason this exists: two bytes would leave its `{` to be read as a hole.
fn fstr_esc_end(src: list[byte], at: int) -> int {
	n := src.len()

	return at + 1 if at + 1 >= n
	return at + 2 if src[at + 1] != b'u'

	mut i := at + 2
	for i < n {
		return i + 1 if src[i] == b'}'
		i = i + 1
	}
	return n
}

# fstr_hole_end is the index of the `}` closing the hole that opens at `at`, counting the
# braces a nested list or map literal brings with it.
fn fstr_hole_end(src: list[byte], at: int) -> int {
	n := src.len()
	mut depth := 0
	mut i := at
	for i < n {
		c := src[i]
		if c == b'"' or c == b'\'' {
			i = fstr_quote_end(src, i)
		} else {
			if c == b'{' {
				depth = depth + 1
			} else if c == b'}' {
				depth = depth - 1
				return i if depth == 0
			}
			i = i + 1
		}
	}
	return n
}

fn fstr_quote_end(src: list[byte], at: int) -> int {
	n := src.len()
	q := src[at]
	mut i := at + 1
	for i < n {
		if src[i] == b'\\' {
			i = i + 2
		} else if src[i] == q {
			return i + 1
		} else {
			i = i + 1
		}
	}
	return n
}

# fstr_text decodes one chunk of literal text: `{{` and `}}` collapse to one brace, and the
# backslash escapes are decoded by wrapping the chunk back into a plain string literal and
# running it through the lexer — so `\n` and `\u{…}` mean here exactly what they mean in a
# `"…"`, rather than through a second escape table that would drift from the first.
fn fstr_text(raw: str) -> str {
	toks := tokenize(f"\"{fstr_unbrace(raw)}\"")
	return toks[0].value if toks[0].kind == Str
	raise "f-string: malformed literal text: " + raw
}

fn fstr_unbrace(raw: str) -> str {
	b := list[byte](raw)
	n := b.len()
	mut out: list[byte] = []
	mut i := 0
	for i < n {
		c := b[i]
		if c == b'\\' and i + 1 < n {
			out.append(c)
			out.append(b[i + 1])
			i = i + 2
		} else if (c == b'{' or c == b'}') and i + 1 < n and b[i + 1] == c {
			out.append(c)
			i = i + 2
		} else {
			out.append(c)
			i = i + 1
		}
	}
	return str(out)
}

# fstr_hole turns one hole's source into an expression. It is RE-LEXED and parsed by the
# ordinary machinery, so anything the compiler can parse in an expression position works
# inside a hole; p.impl_ty rides along so `this` resolves as it does outside one.
fn fstr_hole(mut &p: Parser, hole: str) -> Expr {
	fstr_reject(hole)

	toks := tokenize(hole)
	mut hp := Parser(toks, 0, p.impl_ty)
	e := parse_expr(hp)

	# a hole is ONE expression; emitting just the prefix of something longer is exactly the
	# silent wrong answer this path exists to avoid
	if not p_at(hp, Eof) and not p_at(hp, Semi) {
		raise "f-string: a hole must be a single expression: {" + hole + "}"
	}
	return EConv(TStr, e)
}

# fstr_reject refuses the hole forms this compiler does not implement, naming which one.
#
# GRAMMAR gives a hole three optional tails, and every one of them needs a STATIC TYPE to
# mean anything — the seed picks its display and format leaves from it. This compiler
# desugars in the PARSER, where no type exists yet. Dropping a `:04d` would print the wrong
# text and say nothing, so each is refused by name instead.
fn fstr_reject(hole: str) {
	b := list[byte](hole)
	n := b.len()
	mut depth := 0
	mut i := 0
	for i < n {
		c := b[i]
		if c == b'"' or c == b'\'' {
			i = fstr_quote_end(b, i)
		} else if c == b'(' or c == b'[' or c == b'{' {
			depth = depth + 1
			i = i + 1
		} else if c == b')' or c == b']' or c == b'}' {
			depth = depth - 1
			i = i + 1
		} else if depth == 0 and c == b':' {
			raise "NotImplemented: an f-string ':spec' format spec — {" + hole + "}"
		} else if depth == 0 and c == b'!' and i + 1 < n and fstr_is_conv(b[i + 1]) {
			raise "NotImplemented: an f-string '!r' / '!s' / '!a' conversion — {" + hole + "}"
		} else {
			i = i + 1
		}
	}
	if fstr_is_selfdoc(b) {
		raise "NotImplemented: the f-string '{expr=}' self-documenting form — {" + hole + "}"
	}
}

fn fstr_is_conv(c: byte) -> bool {
	return c == b'r' or c == b's' or c == b'a'
}

# fstr_is_selfdoc reports a hole ending in `=`, the self-documenting form — but not one
# ending in a comparison, whose `=` is the second half of an operator.
fn fstr_is_selfdoc(b: list[byte]) -> bool {
	mut i := b.len() - 1
	for i >= 0 and b[i] == b' ' {
		i = i - 1
	}
	return false if i < 1 or b[i] != b'='
	p := b[i - 1]
	return p != b'=' and p != b'!' and p != b'<' and p != b'>'
}
