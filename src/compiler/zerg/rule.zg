	# emitting — a form this compiler will not lower, including a `[not yet]`. `E7xx` is `E4xx` continued,
	# for the reason `E6xx` continues `E2xx`
	LoopKeywordOutsideLoop = 401
	FromCauseNotErr = 402
	NotYetJumpOutOfGuard = 403
	ChanOfOptional = 404
	EitherSideOneValue = 405
	OptionalChainOnNonOptional = 406
	IntOnPayloadEnum = 407
	TryCarrierMismatch = 408
	NotYetGenericMethod = 409
	GenericInstantiationDepth = 410
	TypeParamUndecided = 411
	TypeParamBoundUnmet = 412
	NotYetRawPointerBuiltin = 413
	NotYetCompileTimeBuiltin = 414
	NotYetImplOnBuiltin = 415
	NotYetSpecAsType = 416
	StrOfListElement = 417
	ConvOfOptional = 418
