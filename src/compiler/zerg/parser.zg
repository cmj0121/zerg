# parser — tokens to an AST for the self-hosting Zerg compiler (M2).
#
# A recursive-descent parser over the token stream, following the GRAMMAR group-4
# precedence ladder (or < and < cmp < add < mul < unary < call < primary). It covers the
# Zerg-boot subset the examples corpus needs: function declarations; the binding,
# assignment, print, return / return-if, if / else-if / else, for, break, continue, nop,
# and bare-expression statements; and the literal / identifier / unary / binary / call /
# match expression forms. Operators are stored by their Zerg spelling; the emitter maps
# them to C. Forms outside the subset are skipped rather than parsed.
import "strconv"

# Parser holds the token list, the read cursor, and — while an `impl T { … }` block is
# being read — the type that block is for, which is what `This` names inside it.
struct Parser {
	pub toks: list[Token]
	pub pos: int
	pub impl_ty: str

	# path is the file being read, stamped onto every FnDecl so a diagnostic can name it
	pub path: str

	# depth counts how many recursion levels of nesting the parser is inside — one per
	# nested expression, block, type, unary/receive prefix, `??` right arm, and `else if`.
	# It exists so ZG_MAX_NESTING can be enforced: this parser recurses once per level on
	# the native stack, which overflows to SIGSEGV with no diagnostic, and a counted refusal
	# is the only answer a recursive-descent parser can give before that happens.
	pub depth: int

	# edepth counts how many parse_expr calls are open. It is not a second budget — it
	# answers one question, "is the expression now finished the OUTERMOST one", so the
	# tree's own depth is measured once per expression instead of once per level. A
	# statement resets it, because a statement is where an expression tree ends: the block
	# inside a `guard` or a closure holds statements, and each of their expressions is a
	# root of its own.
	pub edepth: int

	# ty_quals collects the MODULE QUALIFIERS written in a type position, which parse_base_type
	# resolves away (File.ty_quals says why the fact is kept on the side). It rides on the
	# parser rather than being threaded through parse_type's dozen returns: a type is parsed
	# from six positions and each would otherwise have to hand a list down and collect it back.
	pub ty_quals: list[TyQual]
}

fn cur(mut &p: Parser) -> Token {
	return p.toks[p.pos] if p.pos < p.toks.len()
	return Token(Kind.Eof, "", "", 0, 0)
}

fn cur_kind(mut &p: Parser) -> Kind {
	return cur(p).kind
}

fn peek_kind(mut &p: Parser, n: int) -> Kind {
	j := p.pos + n
	return p.toks[j].kind if j < p.toks.len()
	return Kind.Eof
}

# peek_lexeme is peek_kind's other half: the TEXT of a token ahead, read without consuming
# it, which is what a refusal needs to name the form the parser is standing in front of.
# Past the end it answers "", the lexeme `cur` already gives for the Eof token.
fn peek_lexeme(mut &p: Parser, n: int) -> str {
	j := p.pos + n
	return p.toks[j].lexeme if j < p.toks.len()
	return ""
}

fn p_at(mut &p: Parser, k: Kind) -> bool {
	return cur_kind(p) == k
}

fn p_advance(mut &p: Parser) {
	p.pos = p.pos + 1
}

# --- the channel every refusal goes through ---------------------------------------------
#
# A DIAGNOSTIC OWES A CODE AND A PLACE, and what used to decide whether one carried them was
# the SITE: `raise "E2xx …" + p_place(p, line, col)` spelled both out by hand, so a refusal
# written without them was missing both and nothing said so. Of the 103 raise statements in
# this file, 43 appended a place and a dozen carried no code at all — not because anyone
# decided those rules needed neither, but because a convention is not a rule.
#
# check.zg answers the same question for the CHECKED rules, and the answer is the channel:
# every one of them reports through chk_at / chk_at_place, which take the code as an
# ARGUMENT and know the place themselves, so a rule cannot be written without either — the
# compiler's own arity rule refuses the call. These two are that channel for the parser, in
# the same two shapes and the same argument order, because a second mechanism would be a
# second answer to one question.
#
# What they DO with the message is the one difference, and it is forced. A checked rule
# RECORDS a Diag and lets emission carry on, so the rest of the program is checked in the
# same run; a refusal ends the parse, and after it there is no tree left to walk. So these
# build the message the site raises rather than recording it — which is also why the `raise`
# stays at the site: a call that raises is not a diverge this compiler can see (a function
# whose last statement is one still owes its answer, E333), and a third of these sites are
# the postfix `raise … if c` guard, which is a statement form and not a call.
#
# scripts/error-codes-check.sh holds the file to it, and it is worth knowing exactly how far
# that reaches: it reports a `raise` here that takes a string LITERAL, which is how the drift
# actually happened — somebody writing the sentence where they stood. It does NOT see
# `m := "…"` followed by `raise m`, and it cannot see `raise anything(…)`, because every site
# here raises a call and a rule against calls would be a rule against the channel. So the
# gate is a ratchet against the easy way back, not a proof; what makes it hold is that there
# is no reason to reach for the hard way.

# p_diag reports at the token the parser is STANDING ON, which is where a refusal belongs
# when it is the current token that is wrong — `expected X, found Y` is about `Y`.
fn p_diag(mut &p: Parser, code: str, msg: str) -> str {
	t := cur(p)
	return p_diag_at(p, t.line, t.col, code, msg)
}

# p_diag_at is for a site that REMEMBERS its place rather than standing on it: a rule about
# the `pub` three tokens back, or about the `#[` a decorator opened, points at the token the
# reader has to go and change, which by then is not the one under the cursor.
fn p_diag_at(mut &p: Parser, line: int, col: int, code: str, msg: str) -> str {
	return f"{code} {msg}{p_place(p, line, col)}"
}

# p_place renders the `--> file:line:col` trailer, in the exact layout render_diag draws
# under a checked finding — one fact about this compiler's output, which is what
# scripts/lib/diag.sh reads it by, and which is why both go through place_line rather than
# each spelling the layout out. What the newline adds is the one difference: a raise carries
# its place inside the message, where a Diag has a line of its own for it.
#
# It is p_diag_at's, and no refusal here calls it directly any more. What keeps it a function
# of its own is the place that has to travel ACROSS a layer: `chan[T?]` is refused in ast.zg,
# where every reader of a channel's element type meets the rule (ty_chan, ty_chan_elem_check),
# so the position reaches it as a trailer the parser rendered, with no message around it yet.
fn p_place(mut &p: Parser, line: int, col: int) -> str {
	return "\n" + place_line(p.path, line, col)
}

# p_impossible is the ONE exception to the channel, and it is not a diagnostic: it is how
# this parser is loud about a state its own structure rules out — an arm reached by no
# program, kept because a match arm is an expression and every arm must yield the match's
# one type.
#
# It carries no code ON PURPOSE, and that is what makes it a separate function rather than a
# lazy raise. A code is an identity a GATE pins to a program (scripts/error-codes-check.sh
# demands a case per code), and no case can be written for a state no input reaches — so a
# code here would be a number nothing could ever assert, and the gate would be right to say
# so. It carries no place for the same reason: there is no token to blame.
#
# `internal:` opens it because the one reader who could ever see it needs to know at once
# that the fault is this compiler's and not their program's.
fn p_impossible(what: str) -> str {
	return "internal: " + what
}

# --- the forms GRAMMAR does not derive --------------------------------------------------
#
# A production says what the language HAS, and a parser that reads past one invents. The
# three refusals below each name a form GRAMMAR states in so many words is not there, and
# each of them used to compile and run: a language nobody can read off the grammar is one
# whose surface is whatever the parser happened to accept.
#
# Each is ONE function, called from every site that can reach the form, because a code is
# an identity and two raises would be two rules under one number (scripts/error-codes-check.sh).
# The trailing comma in particular is reached from four separate loops.

# p_one_tuple refuses `( e , )`. GRAMMAR#tuple-lit is `'(' expr ',' expr ( ',' expr )* ')'`
# — two elements or more — and the note beside it says a single `( expr )` is just
# grouping. There is therefore no arity-one tuple type for `(1, )` to have, and it built
# one anyway: `x := (1, )` gave `x` the type `(int)` and `x.0` read the element back.
fn p_one_tuple(mut &p: Parser, line: int, col: int) {
	raise p_diag_at(p, line, col, "E288", "a 1-tuple `( e, )` — GRAMMAR#tuple-lit is two elements or more, and a single `( expr )` is just grouping, so drop the comma")
}

# p_trailing_comma refuses the comma before a closer. No comma-separated production in
# GRAMMAR derives one — `tuple-lit`, `list-lit`, `map-lit` and `arg-list` all write the
# separator BETWEEN elements — and all four read one silently. `zerg fmt` already deleted
# them, which is the tell: every other part of the toolchain knew the form was not
# canonical, and the parser was the one place that said nothing.
#
# `what` names the production and `closer` the bracket, because one code covers four call
# sites and a reader who meets it needs to be told which list they are standing in.
fn p_trailing_comma(mut &p: Parser, what: str, closer: str, line: int, col: int) {
	raise p_diag_at(p, line, col, "E289", f"a trailing comma before the closing `{closer}` of {what} — GRAMMAR writes the comma BETWEEN elements and derives none before the closer, so drop it")
}

# p_list_sep is the whole separator rule, and it is ONE function because it is one rule: a
# comma BETWEEN elements, and none before the closer. GRAMMAR states it for every
# comma-separated production it has, and this parser used to state it once per reader —
# twelve copies of six lines, differing only in which bracket closes the list and what to
# call it.
#
# Twelve copies is not a style complaint. Every one of them was written because the reader
# beside it had been found accepting a list with no separators at all — `(int int)` as a
# two-element tuple type, `f(1 2)` as a two-argument call, `[1 2]` as a two-element list,
# `map[str int]` as two type arguments — each read, accepted and lowered in silence. The
# rule arrived at each site as its own bug was found, so the count of readers that HAD it
# was always the count of bugs somebody had already hit; `spec Ix[K V]` was the twelfth and
# it was still silent. `p_trailing_comma` was extracted from the middle of those copies and
# the control flow around it was left behind, which is what let the list keep growing.
#
# `closer` is the closing token, `shut` its text for the message, and `what` names the
# production — one code covers every call site, and a reader who meets it needs to be told
# which list they are standing in.
#
# The separator is read wherever the caller's loop has room for it: after the element in
# every reader that parses its own first one, and BEFORE it in the one whose first argument
# arrives from its caller. The early return is what makes both work — at the closer there is
# no separator to read, which is the end of the list in the first shape and an empty tail in
# the second.
fn p_list_sep(mut &p: Parser, closer: Kind, shut: str, what: str) {
	return if p_at(p, closer)

	ct := cur(p)
	expect(p, Kind.Comma)
	if p_at(p, closer) {
		p_trailing_comma(p, what, shut, ct.line, ct.col)
	}
}

# p_brace_head refuses a head that OPENS with `{`. GRAMMAR, group 7: "ANY '{'-opening
# expression — a block OR a map literal — at the start of an if/for/with/match head must be
# parenthesized", which is what follows from `{` being the block opener.
#
# The two heads failed in opposite ways and neither said the rule. `if {"a": 1}.len() == 1`
# read the brace as a map literal and RAN; `for` reads a leading `{` as the loop's body, so
# the same head was parsed as a block and the first entry inside it reported "a binding
# needs a name, and `"a"` is not one" — a complaint about a key nobody wrote as a binding,
# with no place on it. One rule, one sentence, both heads.
fn p_brace_head(mut &p: Parser, kw: str, line: int, col: int) {
	raise p_diag_at(p, line, col, "E290", f"a `{{`-opening expression at the start of {kw} — a `{{ … }}` is a block or a map literal (GRAMMAR#map-lit), so a head that begins with one must be parenthesized")
}

# p_no_brace_head is the check every head runs, and it is one function so that the five
# heads cannot drift into five answers. It reads `{` as a refusal outright, except under
# `for`, where a leading `{` is the INFINITE LOOP's body (GRAMMAR#for-stmt makes the head
# optional) — there the brace is a head only if something CONTINUES it as an expression,
# which is what p_brace_continues answers.
fn p_no_brace_head(mut &p: Parser, kw: str, head_optional: bool) {
	return if not p_at(p, Kind.LBrace)
	return if head_optional and not p_brace_continues(p)

	t := cur(p)
	p_brace_head(p, kw, t.line, t.col)
}

# p_brace_continues answers whether the `{` the parser stands on is followed, past its
# matching `}`, by a token that can only CONTINUE an expression — a `.`, a call, an index,
# an operator. That is the whole difference between `for { break }`, whose brace is the
# body, and `for {"a": 1}.len() == 1 { … }`, whose brace was a head someone forgot to
# parenthesize. Nothing else can tell them apart: both are `for` followed by `{`, and the
# `:` inside is no signal either, since `{ x: int = 1 }` is a block holding a typed binding.
#
# The scan counts braces only. A `}` inside a nested `(` or `[` is still a `}` to this
# parser's lexer, and a `{` inside one still opens a map literal or a block, so brace depth
# alone is what pairs them.
fn p_brace_continues(mut &p: Parser) -> bool {
	mut depth := 0
	mut i := 0
	for {
		k := peek_kind(p, i)
		return false if k == Kind.Eof
		if k == Kind.LBrace {
			depth = depth + 1
		} else if k == Kind.RBrace {
			depth = depth - 1
			break if depth == 0
		}
		i = i + 1
	}
	return p_continues_expr(peek_kind(p, i + 1))
}

# p_continues_expr names the tokens that can follow a complete expression and leave it
# still incomplete. It is deliberately the POSTFIX and INFIX set rather than "anything that
# is not a statement opener": a token this list does not hold ends the expression, and for
# a `for` body that is every ordinary continuation — a `;` the lexer inserted, the `}` of
# the enclosing block, the next statement's keyword.
fn p_continues_expr(k: Kind) -> bool {
	return true if k == Kind.Dot or k == Kind.OptDot or k == Kind.LParen or k == Kind.LBrack
	return true if k == Kind.Question or k == Kind.Coalesce or k == Kind.DotDot or k == Kind.DotDotEq
	return true if k == Kind.And or k == Kind.Or or k == Kind.In or k == Kind.As

	return is_add_op(k) or is_mul_op(k) or is_cmp_op(k)
}

# ZG_MAX_NESTING bounds how deep a program may nest, and the number is a MEASURED one, not
# a language rule: this parser recurses once per nesting level, and on an 8 MB stack it
# died of SIGSEGV — no diagnostic, exit 139 — at about 485 nested parentheses or list
# literals, 650 nested calls, 1300 nested blocks; the weakest stage downstream, the emitter
# on nested calls, died at about 302. 200 clears every one of those with room to spare
# while sitting forty times above the deepest nesting anywhere in this repository, which is
# five. The bound is a translation limit of this implementation
# (docs/conformance.md), like C's own minimum of 63 nested parenthesized expressions.
const ZG_MAX_NESTING := 200

# p_deeper takes one nesting level, and refuses the program once the budget is spent —
# BEFORE the recursion happens, so the stack the refusal is reported from is a healthy one.
# Callers give the level back with p_shallower on their one fallthrough exit; a raise
# between the two abandons the whole parse, so a skipped decrement can never be observed by
# a later statement.
fn p_deeper(mut &p: Parser) {
	p.depth = p.depth + 1
	return if p.depth <= ZG_MAX_NESTING

	t := cur(p)
	p_too_deep(p, t.line, t.col)
}

# p_shallower gives back the level p_deeper took. It is a named pair rather than a bare
# `p.depth = p.depth - 1` so that both halves are greppable: an increment answers to a name
# and a decrement did not, and a decrement that goes missing is not a crash but a budget
# that shrinks quietly for the rest of the parse.
fn p_shallower(mut &p: Parser) {
	p.depth = p.depth - 1
}

# p_too_deep is the ONE sentence for exceeding the bound, and it is one sentence because
# the claim docs/conformance.md makes is one: however a program reaches 200 levels, this
# is the answer. Two callers reach it for two reasons — the parser's own recursion, and
# the depth of the tree it built — and a reader who hit either needs the same instruction.
fn p_too_deep(mut &p: Parser, line: int, col: int) {
	raise p_diag_at(p, line, col, "E244", f"this program nests more than {strconv.to_string(ZG_MAX_NESTING, 10)} levels deep — a translation limit of this compiler (docs/conformance.md): its parser recurses once per level of nested expressions, blocks and types, and every later pass walks the tree it built the same way, so refusing here is what this compiler can still say before the native stack it runs on overflows without a word")
}

# p_expr_root bounds the expression TREE, once, on the outermost expression of a
# statement — which is the only place the bound can be stated as a property of the AST
# rather than of whoever is walking it.
#
# p_deeper cannot do this job. It counts the parser's RECURSION, and the two shapes come
# apart: `(((…)))` recurses without deepening the tree, and `1 + 1 + … + 1` deepens the
# tree without recursing, because the precedence levels build a left-deep chain in a LOOP.
# The chain was therefore invisible here and left to be caught downstream — which held
# only for as long as every downstream walk remembered to count. It did not: `subst_expr`
# is a third walk, it runs BEFORE the emitter's counter, and a 400-term chain inside a
# generic template that some call instantiates died of SIGSEGV with nothing on stderr.
# `zerg lint` died the same way, and `zerg lsp` — which catches a `raise` and cannot catch
# a signal — took the editor's server down with it.
#
# So the tree is measured where it is BUILT, and "no Expr in this AST is deeper than
# ZG_MAX_NESTING" is true from the parser on. The walk here is iterative — a worklist, not
# recursion — because a walk that measures depth must not be able to fail at depth. Its
# one fact about the node set is expr_parts, in ast.zg beside the enum.
fn p_expr_root(mut &p: Parser, e: Expr, line: int, col: int) {
	mut nodes: list[Expr] = [e]
	mut lvl: list[int] = [1]
	mut i := 0
	for i < nodes.len() {
		d := lvl[i]
		if d > ZG_MAX_NESTING {
			p_too_deep(p, line, col)
		}
		for k in expr_parts(nodes[i]) {
			nodes.append(k)
			lvl.append(d + 1)
		}
		i = i + 1
	}
}

# p_name reads the NAME a declaration or a binding introduces, and refuses anything that is
# not an identifier.
#
# Every naming position used to take `cur(p).lexeme` — whatever token happened to be there —
# so a RESERVED WORD passed straight through as a name. `this` went through all of them:
# `fn f(this: int)`, `struct P { this: int }`, `fn this()`, `struct this`, `enum E { this }`,
# `A(this) =>`. GRAMMAR#keyword lists it as a keyword and GRAMMAR#param says outright that `this`
# is NOT a parameter; `print` and `with` were turned away only because the parser routes
# them as statements somewhere else, which is not a rule about names at all.
#
# The worst of them reached cc: a method already has `this` at parameter 0, so writing one
# gave `zg_P_get(zg_P zg_this, int64_t zg_this)` and clang reported the redefinition
# against generated C.
# p_names_here reports whether the token at `at` is a name a BINDING position is about to
# take — an identifier, or a reserved word somebody used as one. The three positions that
# bind through a `:=` / `in` guard themselves with `p_at(p, Ident)`, which is right about
# what they accept and silent about why: a keyword there is not "some other statement", it
# is a binding whose name is reserved, and saying so is what every other naming position
# now does.
fn p_names_here(mut &p: Parser, at: int) -> bool {
	k := p.toks[at].kind
	return true if k == Kind.Ident
	return lookup_keyword(p.toks[at].lexeme) != Kind.Ident
}

# p_reserved_word reports whether a lexeme is one a DECLARATION may not take. The keyword
# table answers most of it, and `This` is the one that is not in it: it is the SELF TYPE, a
# name every `impl` writes and no `impl` declares (GRAMMAR#impl-decl), so it is reserved in
# exactly the way `this` is while being an ordinary identifier to the lexer.
#
# It was found by a migration. `enum Kind { … This … }` declared a variant with that name,
# and once a variant had to be written through its enum there was no way to tell `Kind.This`
# the value from `This` the type at all — which is what a reserved word is for.
fn p_reserved_word(lx: str) -> bool {
	return true if lx == "This"

	return lookup_keyword(lx) != Kind.Ident
}

# p_not_a_name refuses the token standing in a NAME SLOT that is not a name, and it is ONE
# function because it is one rule. A declaration, a field, a parameter and a binding all
# reach it, and the binding used to raise the same sentence from a second site with no code
# on either — which is two rules under no identity, the state scripts/error-codes-check.sh
# exists to end.
#
# `what` names the slot, because one code covers every one of them and a reader who meets it
# has to be told which name the parser was waiting for.
fn p_not_a_name(mut &p: Parser, what: str) -> str {
	return p_diag(p, "E601", f"{what} needs a name, and `{cur(p).lexeme}` is not one")
}

fn p_name(mut &p: Parser, what: str) -> str {
	lx := cur(p).lexeme

	raise p_diag(p, "E245", f"`{lx}` is a reserved word and cannot name {what}") if p_reserved_word(lx)
	raise p_not_a_name(p, what) if not p_at(p, Kind.Ident)

	p_advance(p)
	return lx
}

# p_prelude_role names what a PRELUDE NAME is for, and returns "" for everything else. The
# prelude is bound in every module before a program is read (docs/runtime/package.md), so a
# declaration that takes one of its names does not shadow it — it leaves the form that
# desugars to it with no name to reach for, which is a silence rather than an error.
#
# THE SET IS WHAT THIS TOOLCHAIN BINDS, not what the prelude is specified to hold, and each
# member is here because a site reads it BY NAME:
#
#   the scalars and the two list aliases    parse_base_type, which maps them to a `Ty`
#   `list` `map`                            parse_base_type again — their `[ … ]` is the type's
#   `Either` `Result` `Err`                 the carrier's spellings, likewise
#   `Left` `Right`                          the emitter's constructor and exhaustiveness rules
#   `Eq` `Into`                             the two specs the emitter injects as source
#
# `Ord`, `Hash`, `Error`, `Iterator`, `Iterable` and `Ref` are named by the same page and are
# declared by NOTHING here, so a program's own `spec Ord` is the only `Ord` there is. Refusing
# it would take a working declaration away to hold a name for a feature that does not exist,
# and the day one lands is the day its name joins this list.
#
# `set` AND `array` ARE THE SAME ANSWER read from a nearer miss. p_builtin_type_ctor names
# them beside `list` and `map`, but that predicate is about a BRACKET — whose `[ … ]` is a
# type's arguments rather than an index — and parse_base_type maps neither to a `Ty`. There is
# no `set[T]` in this language yet (docs/runtime/package.md marks it absent), so nothing is
# bound and nothing is knocked out; a mention is not a binding.
fn p_prelude_role(lx: str) -> str {
	return "a built-in scalar type" if lx == "int" or lx == "uint" or lx == "float" or lx == "bool" or lx == "str" or lx == "byte" or lx == "rune"
	return "a built-in list alias" if lx == "bytearray" or lx == "runearray"
	return "a built-in container type" if lx == "list" or lx == "map"
	return "an error-carrier type" if lx == "Either" or lx == "Result" or lx == "Err"
	return "an error-carrier constructor" if lx == "Left" or lx == "Right"
	return "a built-in spec" if lx == "Eq" or lx == "Into"

	return ""
}

# p_decl_name is p_name at a slot that DECLARES a top-level name, and it is a second function
# rather than a flag on the first because the two slots differ in what they may take. Every
# naming position refuses a reserved WORD; only a declaration refuses a prelude name, because
# only a declaration is silent about it — a local `list := 5` shadows the constructor inside
# one scope and any call of it is a loud type error, while a top-level `struct list` removes
# the name from the whole program and the first word of the complaint is `undefined`.
#
# A MODULE CONSTANT IS NOT HERE, and that is the parser's shape rather than a decision: a
# top-level `const` and a local one are the same `parse_binding`, so gating it would gate
# every binding in every function with it.
#
# `<builtin>` is exempt because the toolchain's own injected source is not a program: the
# emitter parses `spec Eq` and `spec Into` from a string (emit.zg's ZG_BUILTIN_SPECS) and it
# is the very declaration this rule reserves the name for.
fn p_decl_name(mut &p: Parser, what: str) -> str {
	return p_reserved_name(p, p_prelude_role(cur(p).lexeme), what)
}

# p_reserved_name is the refusal itself, asked with the role its caller's SLOT computed. The
# role is the argument rather than the lexeme because the two slots do not take the same set:
# a type declaration's name lands in the namespace every one of these names is bound in, and
# a function's lands where only some of them can be spelled.
fn p_reserved_name(mut &p: Parser, role: str, what: str) -> str {
	lx := cur(p).lexeme

	raise p_diag(p, "E611", f"`{lx}` is a prelude name — {role} — and cannot name {what}: the prelude is bound in every module before a program is read, so the forms that desugar to it can never be knocked out from under the language") if role != "" and p.path != "<builtin>"

	return p_name(p, what)
}

# p_prelude_callee_role is p_prelude_role at the FUNCTION slot: the prelude names a CALL can
# spell. `map` IS THE WHOLE OF THE DIFFERENCE, and it is measured rather than argued. Declare
# `fn N(zz: int) -> int` and call `N(1)`: for every other name in the set the declaration is
# unreachable, because the callee is read as the prelude's own form before a user symbol is
# looked for — a conversion for the scalars and the two list aliases, a construction for
# `Either` / `Result` / `Err` / `Eq` / `Into` (E727), the carrier's constructor for `Left` /
# `Right` (E459). `list` is reachable here, but a `fn list` costs the SEED the `list[byte](s)`
# bridge, and a language rule holds in both compilers or it is not one.
#
# `map` alone answers 2 in both: `map[…](…)` as a constructor is built by neither compiler, so
# the name has no value form for a declaration to take — and `fn map(xs, f)` is the one
# function in this set a real program actually wants to write.
#
# THE SCALARS ARE THE REASON THIS RULE IS NOT MERELY TIDY. `fn byte(n: int) -> int { n + 1 }`
# with `print byte(41)` after it compiled in both compilers and printed 41 here and 42 in the
# seed, with nothing said by either: one program, two answers, no diagnostic. Refusing the
# declaration is what makes that question unaskable.
fn p_prelude_callee_role(lx: str) -> str {
	return "" if lx == "map"

	return p_prelude_role(lx)
}

# p_fn_name is the `fn` slot's half of that rule, and `recv` is the whole of the question. A
# METHOD'S NAME IS NOT A TOP-LEVEL NAME: a spec member reads `This` and an impl's supply reads
# its target, so only a free function arrives with none — and c_build_top_names registers only
# the receiverless ones for exactly that reason. `impl P { fn set(v: int) }` names nothing the
# prelude bound; it lives in `P`'s namespace, where a call has already said which type it is
# on. Reserving through here refused two cases scripts/reject-check.sh was already written on.
fn p_fn_name(mut &p: Parser, recv: str) -> str {
	return p_name(p, "a function") if recv != ""

	return p_reserved_name(p, p_prelude_callee_role(cur(p).lexeme), "a function")
}

# p_type_name is the name slot of a DECLARATION THAT INTRODUCES A TYPE — a struct, an enum,
# a spec, a `type X = Y` (GRAMMAR#type-ident). It is p_decl_name plus the one rule that
# separates the two namespaces this language has: a type's name begins with an UPPER-CASE
# LETTER, and a value's does not.
#
# THAT RULE IS LEXICAL, AND EVERYTHING DEPENDS ON IT. `name_is_type` is how a construction is
# told from a call, how `cli.Opt` the module qualifier is told from `It.Item` the associated
# type, and how a generic bound naming a spec is told from one naming a concrete type. The
# last two are asked by the PARSER, which has resolved nothing and has no table to consult —
# so a `struct _Box` or a `struct lower` cannot be made to work by teaching the constructor
# alone. It would be legal in one position and misread in three.
#
# It used to be legal in NONE and said so wrongly: `_Box(1)` on a declared `struct _Box`
# answered `E425 undefined function`, which is false about the program — the name is a type,
# and the reader declared it eight lines up. The seed builds all of them, so this is a
# LANGUAGE decision rather than a gap: the upper-case letter is what the declaration owes,
# and GRAMMAR#type-ident now derives it.
#
# A leading `_` is refused by the same rule and not by one of its own. `_` has no case, so it
# is neither namespace, and a name that is in neither is exactly what this asks about.
#
# THE CASE RULE IS ASKED BEFORE THE PRELUDE ONE, and `struct list` is the name that decides
# it: both rules are true of it, and only one of the two answers is a repair. PascalCasing a
# lower-case prelude name leaves the prelude alone — `Int`, `List`, `Map`, `Str` and every
# other one of them is a name p_prelude_role does not know — so the case rule's advice
# satisfies both rules in one edit, while "pick another name" says nothing about the letter
# and lets the second attempt be refused again for a reason the first refusal never mentioned.
# The reverse order costs a round trip and buys nothing; a name that is BOTH gets the finding
# that ends the matter.
#
# It reads the token WITHOUT consuming it, which is what lets it be asked first, and it asks
# only of an identifier: a reserved word and a token that is no name at all are p_name's E245
# and E601, and they arrive at a slot that has not been told a type is wanted yet.
fn p_type_name(mut &p: Parser, what: str) -> str {
	t := cur(p)

	raise p_diag_at(p, t.line, t.col, "E610", f"`{t.lexeme}` cannot name {what} — a declared type's name begins with an UPPER-CASE LETTER (GRAMMAR#type-ident), which is how the language tells a type from a value: `{t.lexeme}(…)` would read as a call to a function of that name, and `{t.lexeme}.X` as a module qualifier. Write it in PascalCase") if p_at(p, Kind.Ident) and not name_is_type(t.lexeme)

	return p_decl_name(p, what)
}

# expect consumes the token the grammar requires, and REPORTS when it is not there.
#
# It used to advance on a match and say nothing otherwise, so a malformed construct was not
# reported at all — the parser derailed quietly and whatever it built from the wreckage
# reached the emitter. Every truncated form went that way: `print guard`, a `fn` with no
# name, a `chan` with no element type, an unclosed `{`. The first complaint came from cc,
# about a file under .zerg-cache, and it named nothing the programmer had written.
fn expect(mut &p: Parser, k: Kind) {
	raise p_diag(p, "E204", f"expected `{kind_name(k)}`, found `{cur(p).lexeme}`") if not p_at(p, k)
	p_advance(p)
}

fn skip_semis(mut &p: Parser) {
	for p_at(p, Kind.Semi) {
		p_advance(p)
	}
}

# p_stmt_sep is skip_semis with the separator REQUIRED. GRAMMAR#stmt-list writes a statement
# list as `statement ( stmt-sep+ statement )*`, so two statements in a row with nothing
# between them is not a program — and every loop here called skip_semis, which skips a
# separator when there is one and says nothing when there is not. So a second statement on
# the same line was read as a statement, and quietly: `print "a" "b"` printed `a`, `x := 1 2`
# bound 1, `print f() f()` called `f` once. Nothing was reported because nothing was wrong as
# far as the loop could tell — it had a statement, and it asked for the next one. The seed
# has refused this since it was written, so the two compilers disagreed about which programs
# exist.
#
# `end` is the token that closes the list — `}` for a block or a module-level `unsafe { … }`
# group, the end of file at the top level — since arriving at it is the other way a statement
# may be followed by no separator.
fn p_stmt_sep(mut &p: Parser, end: Kind) {
	at := p.pos
	skip_semis(p)
	return if p.pos != at or p_at(p, end) or p_at(p, Kind.Eof)

	t := cur(p)
	raise p_diag_at(p, t.line, t.col, "E205", f"expected a newline or `;` to separate statements, found `{t.lexeme}`")
}

# ident_name extracts the identifier spelling from an EIdent expression (the assignment
# and call targets in the subset), or "" for anything else.
fn ident_name(e: Expr) -> str {
	return match e {
		Expr.EIdent(n) => n
		_ => ""
	}
}

# is_or_expr reports whether an expression is a bitwise-or at its top, which in a match arm
# is the shape an or-pattern over LITERALS arrives in — parse_expr swallows the `|`.
fn is_or_expr(e: Expr) -> bool {
	return match e {
		Expr.EBinary(oper, x, y) => oper == "|"
		_ => false
	}
}

# --- types ---------------------------------------------------------------------

# parse_type reads a type expression, including the two DIRECTIONAL channel spellings
# GRAMMAR gives: `<-chan[T]` is receive-only and `chan[T]<-` is send-only.
#
# Neither is ambiguous here, and the reason is structural rather than lucky: parse_type is
# a closed sub-grammar that NEVER calls parse_expr, and it is only ever entered from a
# type position — a parameter type, the type after `->`, a struct field, the `:` of a typed
# binding, an enum variant's field, a type argument. None of those can begin an expression,
# so a leading `<-` there can only be a direction and never a receive. The trailing form
# cannot collide with `send-stmt ::= expr '<-' expr` for the mirror reason: parse_type is
# never entered from a statement position, so `ch <- v` does not reach here. The trailing
# `<-` is also only looked for after the `]` of a `chan[…]`, never after a name or any
# other type, which is what keeps it away from anything else a `<-` could follow.
# parse_type reads a type and, when a `?` follows it, wraps it as the OPTIONAL of that
# type (GRAMMAR group 7: `type ::= base-type '?'?`). The suffix used to be left in the
# stream: `x: int? = nil` bound a plain `int` and `nil` lowered to `0`, so an absent value
# became the number zero and nothing said so.
#
# It is one wrapper around the whole reader rather than a case inside it, because the
# suffix follows a COMPLETE type — `list[int]?`, `P?`, `chan[int]?` — and every one of
# those is built somewhere below.
# parse_type counts a nesting level per type it reads, because types recurse without ever
# touching parse_expr — `list[list[…]]`, `chan[chan[…]]`, a function type's parameters —
# and each level is a frame of parse_base_type on the same native stack the expressions use.
fn parse_type(mut &p: Parser) -> Ty {
	p_deeper(p)
	mut t := parse_base_type(p)
	if p_at(p, Kind.Question) {
		p_advance(p)
		t = Ty.TOpt(t)
	}
	p_shallower(p)
	return t
}

# parse_paren_types reads `( type, … )` into the types it names, leaving the stream on the
# token after the `)`. A tuple type and a function type's parameter list are the same
# production with different meanings, and keeping them one loop is what keeps their
# trailing-comma and end-of-input recovery from drifting apart.
fn parse_paren_types(mut &p: Parser) -> list[Ty] {
	expect(p, Kind.LParen)
	mut out: list[Ty] = []
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		out.append(parse_type(p))
		p_list_sep(p, Kind.RParen, ")", "a tuple type")
	}
	expect(p, Kind.RParen)
	return out
}

# parse_param_types reads a function TYPE's parameter list, `( param-type, … )`
# (GRAMMAR#param-type-list). It is not parse_paren_types, and the one token that separates
# them is the whole reason it exists: GRAMMAR#param-type is `( 'mut' '&' )? type`, and a
# tuple element is a bare type. Sharing the tuple reader is what made `fn(mut &int) -> bool`
# answer `expected `,`, found `&`` — a punctuation complaint about a type this language has,
# and the message a typo gets rather than the named refusal docs/code/functions.md promises.
fn parse_param_types(mut &p: Parser) -> list[Ty] {
	expect(p, Kind.LParen)
	mut out: list[Ty] = []
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		# The prefix is READ, and the type behind it read too, before anything is refused: a
		# sentence made at the `&` names a bracket, and a sentence made here names the type
		# the marker is on. `mut` with no `&` is not a param-type at all — the same rule
		# GRAMMAR#param states for a declaration — so expect answers for it.
		mut is_ref := false
		mt := cur(p)
		if p_at(p, Kind.Mut) {
			p_advance(p)
			expect(p, Kind.Amp)
			is_ref = true
		}
		t := parse_type(p)

		# `mut &` in a type is real in the LANGUAGE: it is part of the type, so `fn(mut &int)`
		# and `fn(int)` are distinct (docs/code/functions.md). It is refused here because the
		# value side of it is refused downstream anyway — a held function is a bare pointer in
		# this compiler and the call site reads its convention from the callee's NAME (E469) —
		# so accepting the spelling would only mean a type nothing can ever hold.
		raise p_diag_at(p, mt.line, mt.col, "E286", f"NotImplemented: a `mut &` parameter in a function type — GRAMMAR#param-type derives `( 'mut' '&' )? type`, and `mut &` is part of the type, so `fn(mut &{ty_name(t)})` is a distinct type from `fn({ty_name(t)})`. A function VALUE is a bare pointer here and the call site reads a `mut &` from the callee's NAME, which a value has not got, so the type is refused rather than spelled and never honoured") if is_ref

		out.append(t)
		p_list_sep(p, Kind.RParen, ")", "a parameter type list")
	}
	expect(p, Kind.RParen)
	return out
}

# parse_chan_elem reads the `[T]` of a channel and answers the element type.
#
# It is ONE function because a channel's element type has one rule on it, and this is the
# only place either surface form reads that element: the TYPE `chan[T]` (GRAMMAR#chan-type,
# in every position a type may be written) and the CONSTRUCTOR `chan[T](cap?)`
# (GRAMMAR#chan-new). Both used to read it inline, and the rule was attached to neither —
# it lived in the emitter, on the constructor's lowering path alone, so a `chan[int?]` was
# refused where it was BUILT and accepted everywhere it was merely declared.
#
# The rule is asked HERE for the CONSTRUCTOR's sake: `chan[T](cap?)` builds an `EChanNew`
# carrying the element type and never a `Ty.TChan`, so it is the one surface form that does
# not pass through `ty_chan` (ast.zg), which every construction of the type does.
#
# `line`/`col` are the `chan` keyword's own, taken by the caller before that token was
# consumed, so a refusal points at the type rather than at the statement holding it.
fn parse_chan_elem(mut &p: Parser, line: int, col: int) -> Ty {
	expect(p, Kind.LBrack)
	elem := parse_type(p)
	expect(p, Kind.RBrack)
	ty_chan_elem_check(elem, p_place(p, line, col))
	return elem
}

fn parse_base_type(mut &p: Parser) -> Ty {
	# `[T; N]` — an ARRAY TYPE (GRAMMAR#array-type). It is not built, and it was not turned away
	# either: the `[` fell through to the name below, so `xs: [int; 3]` reported `expected
	# `=`, found `int`` and `fn f(xs: [int; 3])` reported `expected `:`, found `;`` — two
	# different tokens, neither of them the form.
	raise p_diag(p, "E233", "NotImplemented: an array type `[T; N]` — this compiler has `list[T]`, whose length is not part of its type") if p_at(p, Kind.LBrack)

	# `unsafe fn(…) -> R` — a FUNCTION TYPE carrying the unsafe marker (GRAMMAR#fn-type is
	# `'unsafe'? 'fn' '(' param-type-list? ')' ret-type?`). `unsafe` is a keyword, so it never
	# reached the name below and every type position reported the token after it instead: a
	# binding said ``expected `=`, found `fn` ``, a parameter said ``expected `,`, found `fn` ``
	# — two tokens, neither of them the form, for a production GRAMMAR derives in full.
	#
	# It is refused for the reason a standalone `unsafe fn` is (E264): the marker is a TRUST
	# BOUNDARY this compiler does not enforce, so honouring it in a type would be a promise
	# about calls it never checks. Dropping the word instead would be worse — a plain `fn`
	# type is callable from safe code, which is the one thing the marker exists to prevent.
	if p_at(p, Kind.Unsafe) {
		u := cur(p)
		raise p_diag_at(p, u.line, u.col, "E488", "NotImplemented: an `unsafe fn(…)` TYPE — GRAMMAR#fn-type carries the marker, and `unsafe` is a trust boundary this compiler does not enforce (the reason a standalone `unsafe fn` is E264), so the type is refused rather than spelled and never honoured")
	}

	if p_at(p, Kind.LArrow) {
		ar := cur(p)
		p_advance(p)
		inner := parse_type(p)
		raise p_diag_at(p, ar.line, ar.col, "E602", "a `<-` prefix is a channel direction: only `<-chan[T]` is a type") if not ty_is_chan(inner)

		# BOTH ARROWS IS NEITHER DIRECTION. GRAMMAR#chan-type has three alternatives —
		# `chan[T]`, `<-chan[T]` and `chan[T]<-` — and a channel that is at once receive-only
		# and send-only is none of them. The trailing `<-` was read after the `]` with no
		# regard for a leading one, so `<-chan[int]<-` became a receiver and the second arrow
		# vanished: a signature that says it can only send, honoured as one that can only
		# receive.
		raise p_diag_at(p, ar.line, ar.col, "E498", "a channel is bidirectional, receive-only or send-only — GRAMMAR#chan-type gives `<-chan[T]<-` no reading, and both arrows at once name no direction") if ty_chan_dir(inner) != 0

		return ty_chan(ty_chan_elem(inner), 2, p_place(p, ar.line, ar.col))
	}

	# `(A, B)` — a TUPLE TYPE (GRAMMAR#tuple-type), two elements or more. The value form has
	# always worked, so `t := (1, "a")` was fine and there was simply no way to WRITE the
	# type it has: every position that wants one — a typed binding, a parameter, a return,
	# a field, a list element — fell through to the name below and reported whatever token
	# came next. Five positions, five different messages, none of them the form.
	if p_at(p, Kind.LParen) {
		elems := parse_paren_types(p)

		# GRAMMAR says two or more. One element in parentheses is a grouped type everywhere
		# else in the language, and a zero-element tuple is not a thing Zerg has — `nil` is
		# what a function with no result returns.
		raise p_diag(p, "E246", "a tuple type has two elements or more — `()` is not a type, and `(T)` is just `T`") if elems.len() < 2

		return Ty.TTuple(elems)
	}

	# the head token is kept, not just its text: the `chan` branch below needs the keyword's
	# own line and column to point a refusal at the type, and by then it is consumed.
	kw := cur(p)
	mut name := kw.lexeme
	p_advance(p)

	# A MODULE-QUALIFIED type, `cli.Opt`: every module of a program flattens into one
	# scope, so the qualifier only says where the type came from and the last segment is
	# the name. Reading it this way is what lets a program use a type another module
	# declares — without it the qualifier parses as a type of its own and the emitter
	# spells a name nothing declared.
	for p_at(p, Kind.Dot) {
		# AN ASSOCIATED TYPE IS NOT A MODULE QUALIFIER, and dropping the qualifier made them the
		# same thing: `I.Item` PROJECTS a type the implementer of `I` supplies (GRAMMAR#base-type,
		# chainable as `I.Item.Sub`), so keeping only `Item` left it reading as an undeclared
		# type — the message a misspelling gets.
		#
		# The two are told apart by CASE, which the language already decides: a module is named
		# by its directory and is snake_case, a spec is PascalCase. So `cli.Opt` is a qualifier
		# and `It.Item` is a projection.
		raise p_diag(p, "E265", f"NotImplemented: an associated type projection `{name}.{peek_lexeme(p, 1)}` — GRAMMAR lets a spec name a type its implementer supplies and a signature project it, and this compiler has no associated types at all") if name_is_type(name)

		# THE QUALIFIER IS RESOLVED AWAY AND WRITTEN DOWN. Dropping it is right for
		# resolution — the last segment IS the name here — and it is also the moment the
		# only evidence of `lib.` in `c: lib.Counter` disappears, which is the evidence the
		# no-transitivity rule reads. So the fact that one was typed, and where, is recorded
		# before the name moves on.
		p.ty_quals.append(TyQual(name, p.path, kw.line, kw.col))

		p_advance(p)
		name = cur(p).lexeme
		p_advance(p)
	}

	# `This` is the self type: inside an impl it is the type that impl is for. Resolving it
	# at parse time keeps it out of the emitter, which has no notion of a self type.
	return Ty.TNamed(p.impl_ty) if name == "This" and p.impl_ty != ""

	# A function type, `fn(P, ...) -> R`. A result is optional: `fn(int)` returns nothing.
	if name == "fn" and p_at(p, Kind.LParen) {
		ptys := parse_param_types(p)
		mut fret := Ty.TVoid
		if p_at(p, Kind.Arrow) {
			p_advance(p)
			fret = parse_type(p)
		}
		return Ty.TFn(ptys, fret)
	}
	if name == "chan" and p_at(p, Kind.LBrack) {
		elem := parse_chan_elem(p, kw.line, kw.col)

		# the trailing `<-` — and ONLY here, right after the `]` that closed a channel's
		# element type, so nothing else that a `<-` may follow is ever eaten
		if p_at(p, Kind.LArrow) {
			p_advance(p)
			return ty_chan(elem, 1, p_place(p, kw.line, kw.col))
		}
		return ty_chan(elem, 0, p_place(p, kw.line, kw.col))
	}
	if name == "map" and p_at(p, Kind.LBrack) {
		p_advance(p)
		kt := parse_type(p)

		# the comma is REQUIRED between the key type and the value type: `map` reads its two
		# arguments here rather than through parse_ty_args, so it needs the rule stated
		# again — advancing on a comma only when it is there made it optional, and
		# `map[str int]` parsed with nothing said.
		expect(p, Kind.Comma)
		vt := parse_type(p)
		expect(p, Kind.RBrack)
		return Ty.TMap(kt, vt)
	}
	if name == "list" and p_at(p, Kind.LBrack) {
		p_advance(p)
		elem := parse_type(p)
		expect(p, Kind.RBrack)
		return Ty.TList(elem)
	}

	# `bytearray` IS `list[byte]` and `runearray` IS `list[rune]` — a shorter name for the
	# same type, interchangeable with the spelled-out form everywhere, and not a strong
	# typedef (docs/core/types.md). They parse to the same node, so nothing downstream can
	# tell which spelling a program used, which is the whole of the claim.
	#
	# They exist because a `str` is not indexable and the bridge out of one used to be
	# written `bytearray(s)` — a TYPE with an argument, in expression position, which is the
	# one thing the surface still needed a symbol table to read.
	return Ty.TList(Ty.TByte) if name == "bytearray"
	return Ty.TList(Ty.TRune) if name == "runearray"

	# `Result[T]` is `Either[T, Err]` — the language says so (docs/code/errors.md), and the
	# two spellings therefore parse to ONE type rather than to a special case beside it. The
	# annotation used to be ERASED to its happy path, so a function declared `-> Result[int]`
	# returned a plain int and `??`, `!` and `?` on the far side of it had nothing to read.
	if name == "Result" and p_at(p, Kind.LBrack) {
		p_advance(p)
		inner := parse_type(p)
		expect(p, Kind.RBrack)
		return Ty.TEither(inner, Ty.TErr)
	}
	if name == "Either" and p_at(p, Kind.LBrack) {
		p_advance(p)
		lt := parse_type(p)

		# the comma is REQUIRED between the two sides, for the reason `map` states above:
		# this pair is read here rather than through parse_ty_args, so an optional comma
		# here is `Either[int str]` accepted in silence.
		expect(p, Kind.Comma)
		rt := parse_type(p)
		expect(p, Kind.RBrack)

		# the sides must DIFFER: an injection that could reach both is not a construction
		# anyone can read, so the type is refused rather than the ambiguity resolved
		raise p_diag(p, "E206", f"`Either[{ty_name(lt)}, {ty_name(rt)}]` has the same type on both sides — a value could be either, and nothing could tell which") if ty_name(lt) == ty_name(rt)
		return Ty.TEither(lt, rt)
	}

	# `Err` is the Right payload made nameable, which is what lets a `Right(e)` be passed
	# to something. Without this it read as a user type named Err and the emitter spelled
	# `zg_Err`, a type nothing declares.
	return Ty.TErr if name == "Err"

	return Ty.TInt if name == "int"
	return Ty.TFloat if name == "float"
	return Ty.TStr if name == "str"
	return Ty.TBool if name == "bool"
	return Ty.TByte if name == "byte"

	return Ty.TUint if name == "uint"
	return Ty.TRune if name == "rune"
	return Ty.TNil if name == "nil"

	# A generic ARGUMENT list on a user type — `Ref[int]`, `Atomic[int]`, `B[T]`. The four
	# built-in generics above read their own brackets; every other name reached this line
	# with the `[` still in the stream, and nothing downstream wanted a `[`. The caller went
	# on reading types as if the list were not there: `-> Ref[int] {` left the body's brace
	# behind, a parameter list read `[` as the next parameter's name, and the file after it
	# lowered to C full of identifiers named `zg_[` and `zg_->`. `expect` is silent on a
	# mismatch, so none of that was reported — the first complaint came from cc, about a
	# generated file.
	#
	# The arguments are READ AND DROPPED, which is what this compiler already does with
	# `Result[T]`: it erases generics, so a type's identity is its name. What matters is
	# that the brackets are CONSUMED.
	skip_ty_args(p)
	return Ty.TNamed(name)
}

# parse_bound reads a `bound` — `Spec` or `A + B + C` (GRAMMAR#bound) — into the spec names
# it conjoins, dropping each one's type arguments. It is the same production after a type
# parameter's `:` and after a spec's, which is why one function reads both.
# join_bounds carries a conjunction in the one string a type parameter owns. A bound is read
# in exactly one place and checked in exactly one place, so the shape that matters is the one
# there; what a `list[list[str]]` would buy is a shape rather than an answer. A `+` cannot
# appear in a spec name, so the join is reversible — c_split_bounds is the other half.
fn join_bounds(specs: list[str]) -> str {
	mut out := ""
	for sp in specs {
		if out != "" {
			out = out + "+"
		}
		out = out + sp
	}
	return out
}

# join_commas spells a list of names the way the source writes one — `T, U` — for a
# diagnostic that has to quote a list back. It is `ty_names` for names that were never
# types: an `impl`'s type parameters are read as a name and a bound, so there is no `Ty` to
# hand that function, and a refusal that quoted only the first of them would be describing a
# narrower form than the one it turned away.
fn join_commas(names: list[str]) -> str {
	mut out := ""
	for nm in names {
		if out != "" {
			out = out + ", "
		}
		out = out + nm
	}
	return out
}

# parse_supers reads a spec's super list, keeping each super's NAME and its TYPE ARGUMENTS
# apart. A bound bakes its arguments into the name (spec_key) because a bound is only ever
# MATCHED against an impl's; a super's have to be SUBSTITUTED into the named spec's own
# parameters before its signatures can be compared, and a substitution needs the types
# themselves rather than a rendering of them.
#
# It is a reader of its own rather than a flag on parse_bound for that reason: the two want
# different things out of the same production, and one function returning both shapes would be
# answering two questions to serve one caller each.
fn parse_supers(mut &p: Parser, mut &names: list[str], mut &args: list[list[Ty]]) {
	for p_at(p, Kind.Ident) {
		names.append(cur(p).lexeme)
		p_advance(p)
		args.append(parse_ty_args(p))
		return if not p_at(p, Kind.Plus)

		p_advance(p) # '+'
	}
}

fn parse_bound(mut &p: Parser, whose: str, allow_args: bool) -> list[str] {
	mut out: list[str] = []
	for p_at(p, Kind.Ident) {
		name := cur(p).lexeme
		p_advance(p)

		# A TYPE PARAMETER'S BOUND carries its arguments, because they are what the bound
		# MEANS: `[T: Into[Meters]]` asks whether T converts to Meters, and a bound that kept
		# only the name asked whether it converts to anything — the one question `Into` is
		# never worth asking. They ride in the name as `Into[Meters]`, rendered by ty_name, and
		# the impl registry renders its own the same way, so the two agree by construction
		# rather than by a comparison somebody has to keep true.
		#
		# A SUPER-SPEC still refuses them, and that is a different missing thing: a super's
		# arguments have to be SUBSTITUTED into the named spec's own parameters before its
		# signatures can be compared, and dropping them silently made `spec Ord: Eq[int]`
		# refuse every correct `impl Ord` with "parameter `o` is int, and the spec declares T"
		# — a valid program turned away for a reason about the compiler.
		if p_at(p, Kind.LBrack) {
			raise p_diag(p, "E207", f"NotImplemented: a parameterized `{name}[…]` as {whose} — this compiler carries a spec's type arguments only on an `impl` and on a type parameter's bound, so it has nothing to substitute the parameters with here") if not allow_args

			out.append(spec_key(name, parse_ty_args(p)))
		} else {
			out.append(name)
		}
		return out if not p_at(p, Kind.Plus)

		p_advance(p) # '+'
	}
	return out
}

# parse_ty_args reads a `[ T, … ]` type-argument list into the types it names, leaving the
# stream on the token after the `]`. skip_ty_args below consumes the same shape and answers
# nothing, which is right where the arguments are erased; an `impl`'s are not.
fn parse_ty_args(mut &p: Parser) -> list[Ty] {
	mut out: list[Ty] = []
	return out if not p_at(p, Kind.LBrack)
	p_advance(p) # '['
	for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
		out.append(parse_type(p))
		p_list_sep(p, Kind.RBrack, "]", "a type argument list")
	}
	expect(p, Kind.RBrack)
	return out
}

# skip_ty_args consumes a balanced `[ … ]` type-argument list, if one is next. Nesting is
# counted rather than assumed one deep, so `Pair[list[int], B[T]]` leaves the stream on the
# token after the outer `]`.
fn skip_ty_args(mut &p: Parser) {
	return if not p_at(p, Kind.LBrack)
	p_advance(p) # '['
	mut depth := 1
	for depth > 0 and not p_at(p, Kind.Eof) {
		if p_at(p, Kind.LBrack) {
			depth = depth + 1
		}
		if p_at(p, Kind.RBrack) {
			depth = depth - 1
		}
		p_advance(p)
	}
}

# is_conv reports whether a callee name is a scalar type conversion.
#
# `rune` was the one primitive missing here while conv_ty below already had an arm for it —
# so `rune(65)` was "undefined function `rune`", the only one of the seven that could not be
# written. The answer had been written and the question was never asked.
fn is_conv(name: str) -> bool {
	return name == "int" or name == "byte" or name == "str" or name == "float" or name == "bool" or name == "uint" or name == "rune"
}

fn conv_ty(name: str) -> Ty {
	return Ty.TInt if name == "int"
	return Ty.TUint if name == "uint"
	return Ty.TRune if name == "rune"
	return Ty.TByte if name == "byte"
	return Ty.TFloat if name == "float"
	return Ty.TBool if name == "bool"

	return Ty.TStr
}

# --- declarations --------------------------------------------------------------

# parse_at turns source into a File. Imports, structs, enums, functions, and `impl` blocks
# are recognised at the top level; any other top-level STATEMENT is read whole and treated
# as a nop, which is compile mode's answer to the script mode `program ::= stmt-list`
# grants.
#
# It is told which FILE it is reading, and there is deliberately NO pathless twin. A parse
# is where a refusal with a place (p_place) comes from, and a pathless one made that place
# name a line of no file; the twin was kept for "a caller with genuinely no path" and the
# last two — imports_of and declares_main — both turned out to have one. `path` may still
# be empty, for a re-lex with no file behind it, but that is the caller saying so rather
# than a second door that says it by default.
pub fn parse_at(src: str, path: str) -> File {
	toks := tokenize(src)
	mut p := Parser(toks, 0, "", path, 0, 0, [])
	mut imports: list[ImportDecl] = []
	mut structs: list[StructDecl] = []
	mut enums: list[EnumDecl] = []
	mut specs: list[SpecDecl] = []
	mut impls: list[ImplDecl] = []
	mut types: list[TypeDecl] = []
	mut fns: list[FnDecl] = []
	mut consts: list[ConstDecl] = []
	mut stmts: list[TopStmt] = []

	# pending are the specs named by a `#[derive(…)]` that has been read and whose
	# declaration has not been reached yet. A decorator is its own top-level item, so the
	# name it applies to is one iteration away.
	# and the place it was WRITTEN at, which the list itself cannot carry: a decorator is
	# refused for what follows it, so the position a reader has to go to is the `#[`, not the
	# declaration under it and not the end of the file. It follows the `unsafe` group's
	# arrangement one arm down, for the same reason.
	mut pending: list[str] = []
	mut deco_line := 0
	mut deco_col := 0
	mut derive_on: list[str] = []
	mut derive_spec: list[str] = []

	# in_unsafe tracks a module-level `unsafe { … }` group. The group's items go
	# through the SAME arms as everything else — a `fn` was always read there, and the
	# binding arms fire inside it too, carrying `in_unsafe` onto the declaration
	# (ConstDecl.in_unsafe) — because GRAMMAR group 12 makes the group a CONTEXT around
	# ordinary declarations, not a dialect of its own. It decides exactly two things:
	# whether a `mut` binding is the mutable global the group grants (chk_top_muts reads
	# the flag) and whether a bare statement is refused rather than read as a top-level
	# nop, since `unsafe-item ::= decorated-decl | binding` derives no statement.
	#
	# A FLAG AND NOT A DEPTH, and the group's own place beside it. As a counter this was
	# state of the loop that nothing checked at `Eof`: a missing `}` left the rest of the
	# file silently inside the group, so `mut counter := 0` below it became a mutable
	# global and chk_top_muts' refusal — the whole point of the flag — was switchable by a
	# typo, with no diagnostic anywhere. `unsafe-item` also derives no nested group, so the
	# counter's only other reachable value was ill-formed too. Both are refused now, and
	# `unsafe_line` / `unsafe_col` are what lets the unterminated one point at the `unsafe`
	# that was never closed rather than at the end of the file.
	mut in_unsafe := false
	mut unsafe_line := 0
	mut unsafe_col := 0
	skip_semis(p)
	for not p_at(p, Kind.Eof) {
		# `pub` is a VISIBILITY FLAG on the declaration that follows, not a dispatch of its
		# own. It used to open a second, hand-copied Fn/Type/Const/… chain that had already
		# drifted from the one below — and `pub struct` fell off its end with no `else`, so
		# the `pub` was silently dropped and the declaration was picked up as PRIVATE on
		# the next iteration. One flag, one dispatch: every declaration is parsed exactly
		# once, with its visibility in hand, and a form that takes no `pub` says so.
		#
		# `t` is the DECLARATION'S FIRST TOKEN, taken before the marker is consumed, and every
		# refusal below reports at it (p_diag_at). What is refused is the declaration that
		# starts at `t`, whichever arm reaches that answer — which is why they name it rather
		# than the token under the cursor: by the time an arm answers, the cursor has moved
		# past the `pub` or the `#[…]` the reader has to go and delete.
		t := cur(p)
		mut is_pub := false
		if p_at(p, Kind.Pub) {
			is_pub = true
			p_advance(p)
		}

		# A PENDING DECORATOR BELONGS TO THIS ITEM, and until now only three arms below took
		# one: `struct`, `enum` and `spec` call p_take_derives, and every other arm walked
		# past the list without touching it. So a decorator on anything else was not refused
		# where it stood — it SURVIVED, and either landed on whichever decoratable
		# declaration came later (`#[derive(Eq)] impl P { … }` silently derived onto the next
		# `struct` in the file) or was reported at `Eof` as having no declaration under it,
		# which is a false sentence about a program whose next line is a declaration.
		#
		# It is asked HERE, at the one point every item passes, rather than as a fourth
		# refusal hung off the arms that do not want one — the arms are nine and the rule is
		# one. `pub` is already consumed because a decorator LEADS it (GRAMMAR#decorated-decl),
		# and `Hash` is allowed through so decorators stack.
		raise p_diag_at(p, deco_line, deco_col, "E487", f"`{p_deco_says(pending[0])}` applies to the {p_deco_leads(pending)} that follows it, and what follows is `{cur(p).lexeme}` — a decorator changes what a DECLARATION means, so it may not lead one it has nothing to say about") if pending.len() > 0 and not p_deco_may_lead(p, pending)

		if p_at(p, Kind.Import) {
			# a re-export puts the marker on the import-spec (GRAMMAR#import-spec), so a leading
			# `pub` has nothing it could bind to
			raise p_diag_at(p, t.line, t.col, "E247", "`pub import` is not a form — a re-export marks the spec instead: `import pub \"…\"`") if is_pub
			parse_import(p, imports)
		} else if p_at(p, Kind.Fn) {
			# a pending `#[test]` is TAKEN here and the list emptied, the way the three type arms
			# take a derive: a marker left on the list would be reported at `Eof` as a decorator
			# with no declaration under it, about the declaration it had just been given
			is_test := p_deco_is_test(pending)
			pending = []
			fns.append(parse_fn(p, is_pub, "", false, in_unsafe, is_test))
		} else if p_at(p, Kind.Struct) {
			# a struct may be declared `pub` (GRAMMAR#struct-decl), and the marker is CARRIED.
			# It used to be read and dropped, because type visibility was not enforced and a
			# flag nothing reads is a lie the next reader believes; now the type registry
			# records it and chk_ty_visible asks it.
			sd := parse_struct(p, is_pub)
			p_take_derives(sd.name, pending, derive_on, derive_spec)
			structs.append(sd)
		} else if p_at(p, Kind.Enum) {
			# `pub enum` — carried, the struct arm's reason
			ed := parse_enum(p, is_pub)
			p_take_derives(ed.name, pending, derive_on, derive_spec)
			enums.append(ed)
		} else if p_at(p, Kind.Spec) {
			# `pub spec` — carried, the struct arm's reason
			sp := parse_spec(p, is_pub)
			p_take_derives(sp.name, pending, derive_on, derive_spec)
			specs.append(sp)
		} else if p_at(p, Kind.Const) {
			# `const` at the top level is a module constant, not a statement: it becomes a
			# C global rather than a local of any function
			p_advance(p)
			consts.append(p_top_binding(p, false, true, is_pub, in_unsafe, t.line, t.col))
		} else if p_at(p, Kind.Init) {
			# an `init()` is called by the RUNTIME, not by a reader in another module, so
			# there is no visibility for a marker to grant (GRAMMAR#init-decl derives none)
			raise p_diag_at(p, t.line, t.col, "E248", "`pub` does not go on `init()` — the runtime calls it, so it has no visibility to grant") if is_pub
			fns.append(parse_init(p, fns.len()))
		} else if p_at(p, Kind.Impl) {
			# an `impl` fulfils a spec rather than declaring a new name, so GRAMMAR#impl-decl
			# derives no `pub` for it — visibility lives on the spec and on the type
			raise p_diag_at(p, t.line, t.col, "E249", "`pub` does not go on an `impl` block — an `impl` fulfils a spec, and visibility lives on the `spec` and the type it is for") if is_pub
			parse_impl(p, fns, impls, in_unsafe)
		} else if p_at(p, Kind.Type) {
			types.append(parse_typedecl(p, is_pub))
		} else if p_at(p, Kind.Hash) {
			# GRAMMAR#decorated-decl — a decorator LEADS the declaration and `pub` sits inside it, so
			# the order is `#[…] pub fn`, never `pub #[…]`
			raise p_diag_at(p, t.line, t.col, "E250", "a decorator leads its declaration and `pub` sits inside it: write `#[…] pub fn …`, not `pub #[…]`") if is_pub
			if pending.len() == 0 {
				deco_line = t.line
				deco_col = t.col
			}
			parse_decorator(p, pending)
		} else if p_at(p, Kind.Mut) and peek_kind(p, 1) == Kind.Fn {
			# GRAMMAR#fn-decl — `mut fn` marks a METHOD that mutates its receiver, and "a
			# free function or closure has no receiver, so it is never `mut fn`". The token
			# fell into the skip below, so the `mut` was swallowed and the function compiled
			# as if it had never been written.
			raise p_diag_at(p, t.line, t.col, "E251", "a free function is never `mut fn` — `mut fn` marks a method that mutates the instance it is called on, and a free function has no receiver")
		} else if p_at(p, Kind.Mut) {
			# a top-level `mut` binding — `mut x := 0` or `pub mut x := 0`, `pub` changing
			# nothing about mutability. Inside a module-level `unsafe { … }` group it is
			# the language's MUTABLE GLOBAL (docs/runtime/ffi.md, GRAMMAR group 12), and
			# `in_unsafe` carries that context onto the declaration. In SAFE code it is
			# ill-formed — the top level is immutable (docs/runtime/package.md) — but it
			# is PARSED rather than refused here, so the refusal (chk_top_muts) carries
			# this declaration's place and lands beside every other finding of the run,
			# instead of splitting into "compiles when unused" and `undefined name` at
			# every use site.
			p_advance(p)
			consts.append(p_top_binding(p, true, false, is_pub, in_unsafe, t.line, t.col))
		} else if p_at(p, Kind.Ident) and (peek_kind(p, 1) == Kind.Walrus or peek_kind(p, 1) == Kind.Colon) {
			# a plain top-level binding — `COUNT := 3`, `pub COUNT := 3`, or `answer: int
			# = compute()` — is the same module constant the `const` arm reads, without
			# the shadow-proofing the keyword adds; docs/runtime/package.md puts it in the
			# module's immutable state with `pub` as the visibility. It used to fall into
			# the fallback below and vanish, so the module compiled WITHOUT the member and
			# every use answered `undefined name` about a name the module plainly declares.
			consts.append(p_top_binding(p, false, false, is_pub, in_unsafe, t.line, t.col))
		} else if p_at(p, Kind.Unsafe) and (peek_kind(p, 1) == Kind.Fn or (peek_kind(p, 1) == Kind.Mut and peek_kind(p, 2) == Kind.Fn)) {
			# a standalone `unsafe fn` — GRAMMAR#fn-decl spells it (`'pub'? 'unsafe'?
			# 'mut'? 'fn'`), and it IS a declaration. Refusing it is right — nothing here
			# records the marker, so reading the `fn` as safe would erase the one thing the
			# keyword says, which is the caller rule the GROUP form now carries (E387) — but
			# it must be refused AS ITSELF: the statement fallback below answered
			# "NotImplemented: unsafe" about the block-expression, and the `pub` variant was
			# told it had marked a statement, about a form that is a declaration. `is_pub` is
			# already consumed, so `pub unsafe fn` lands here too and both spellings get this
			# one message; `t` is the declaration's first token, so the refusal carries the
			# place a declaration owes.
			raise p_diag_at(p, t.line, t.col, "E264", "NotImplemented: a standalone `unsafe fn` declaration — `unsafe` marks a trust boundary this compiler does not enforce yet (docs/runtime/ffi.md), so the function is refused rather than read as a safe `fn`")
		} else if p_at(p, Kind.Unsafe) and peek_kind(p, 1) == Kind.LBrace {
			# a module-level `unsafe { … }` group opens. Every item inside goes through
			# the arms above exactly as it would outside — the group is a CONTEXT, not a
			# grammar of its own — and the depth is what the binding arms record on each
			# declaration (in_unsafe) and what keeps a bare statement out (below).
			raise p_diag_at(p, t.line, t.col, "E252", "`pub` does not go on an `unsafe { … }` group — the group marks a context, and visibility belongs to each declaration inside it") if is_pub

			# GRAMMAR#unsafe-item — `unsafe-item ::= decorated-decl | binding`, which derives no
			# group, so a group inside a group is not a form. It used to nest, and the
			# inner `}` closed the outer one as far as the counter was concerned.
			raise p_diag_at(p, t.line, t.col, "E253", "a module-level `unsafe { … }` group does not nest — the group marks one context, and everything declared in it is already in that context (GRAMMAR group 12)") if in_unsafe

			p_advance(p)
			p_advance(p)
			in_unsafe = true
			unsafe_line = t.line
			unsafe_col = t.col

			# OPENING the group is not an item, so nothing separates it from the first one:
			# ASI inserts a `;` after a token that can END an item (GRAMMAR group 2) and `{`
			# is not one. This is the one pass round the loop that reads no item, so it is
			# also the one that must not ask for the separator below.
			continue
		} else if in_unsafe and p_at(p, Kind.RBrace) {
			p_advance(p)
			in_unsafe = false
		} else if in_unsafe {
			# GRAMMAR#unsafe-item — `unsafe-item ::= decorated-decl | binding` derives no
			# statement, so what is left here is ill-formed. It used to be dropped one
			# token at a time, which is how the group's `mut` bindings vanished; now that
			# every declaration form is read above, the honest answer for the remainder
			# is a refusal that names the group, not a silent delete and not the
			# top-level-statement nop below (the group grants an unsafe CONTEXT, and a
			# statement nobody runs must not be blessed into it).
			raise p_diag_at(p, t.line, t.col, "E254", "a module-level `unsafe { … }` group holds declarations — a `fn`, a `type`, or a binding (GRAMMAR group 12); a statement runs in a function body, not in a group")
		} else {
			# GRAMMAR#program makes `program ::= stmt-list` normative: Zerg has a SCRIPT MODE,
			# so a top-level statement is GRAMMATICAL and is read here, whole. What it
			# must never be is SHREDDED: this fallback used to advance ONE TOKEN, so a
			# statement's remaining tokens were re-dispatched as items of their own —
			# `xs.each(fn (n: int) { … })` answered "a function needs a name" about a
			# lambda that was never a declaration. One COMPLETE statement is consumed.
			#
			# And what becomes of it is no longer "nothing". It is RECORDED, with its place,
			# and refused by the build (chk_top_stmts) — for the reason the missing `fn main`
			# is refused by the build and not by the parse: the form derives, so a parse that
			# turned it away would be saying this compiler cannot READ a production it can.
			raise p_diag_at(p, t.line, t.col, "E255", "`pub` binds to a declaration, and a statement takes none — a statement is run, not exported") if is_pub
			s := parse_stmt(p)
			p_take_top_stmt(stmts, t, s, p.path)
		}

		# The top level's end is the end of FILE, except inside a module-level `unsafe { … }`
		# group (GRAMMAR#unsafe-group), whose items this same loop reads and whose end is its
		# `}`. The group is a brace this loop opens and closes rather than a block it
		# descends into, so it is the one place where the terminator is not fixed.
		mut end := Kind.Eof
		if in_unsafe {
			end = Kind.RBrace
		}
		p_stmt_sep(p, end)
	}

	# The `impl` check is NOT here. A spec may be declared in another file of the same
	# module, or in an imported one, and this function sees one file — so checking here had
	# to skip any spec it had not itself read, which is why `impl Nope for A` compiled. The
	# driver already builds the whole-program view (`merge_asts`), and that is where the
	# question can be answered; see chk_spec_impls.
	# A decorator with no declaration under it is a decorator on nothing. Naming it is the
	# same contract every other unsupported form has: what is written is either implemented
	# or named, never quietly dropped.
	raise p_diag_at(p, deco_line, deco_col, "E208", f"`{p_deco_says(pending[0])}` has no declaration under it — a decorator applies to the {p_deco_leads(pending)} that follows it, and this one is the last item in the file") if pending.len() > 0

	# An `unsafe { … }` group with no `}` is the same kind of leftover state, and it was the
	# one this function did not look at. The loop simply ran to `Eof` with the group still
	# open, so every declaration after the missing brace was read as if it were inside —
	# which turns a `mut` binding into the language's mutable global and silently disarms
	# the refusal that keeps one out of safe code. The place is the `unsafe` that opened it,
	# not the end of the file, because that is where the reader has to go.
	raise p_diag_at(p, unsafe_line, unsafe_col, "E256", "this module-level `unsafe { … }` group is never closed — a group marks a context and the context has to end, or every declaration after it is read as being inside") if in_unsafe

	return File(imports, structs, enums, specs, impls, fns, types, consts, derive_on, derive_spec, stmts, p.ty_quals)
}

# p_take_top_stmt records a top-level statement for the build to refuse, and is the one
# place the EXCEPTION is written down: `nop`.
#
# `nop` does nothing and yields nothing (GRAMMAR#nop), so a build that runs nothing for it
# has run it exactly — and it is the statement GRAMMAR opens the language with, the whole of
# the smallest well-formed program. Every other statement asks to be RUN, and the top level
# is not a place anything runs.
fn p_take_top_stmt(mut &stmts: list[TopStmt], t: Token, s: Stmt, path: str) {
	return if p_is_nop(s)

	stmts.append(TopStmt(t.lexeme, path, t.line, t.col))
}

fn p_is_nop(s: Stmt) -> bool {
	return match s {
		Stmt.SNop => true
		_         => false
	}
}

# p_top_binding reads one top-level binding and answers the module-constant DECLARATION it
# is: the SLet parse_binding builds, rehomed onto a ConstDecl carrying the file and the
# position the form started at — `line` / `col` are the FIRST token's, captured by the
# caller before it consumed the `pub` / `const` / `mut` in front of the name. A module
# constant is a statement of no function, so nothing else (no FnDecl, no SAt marker) would
# ever remember where it was written, and a declaration a rule can refuse owes a place.
# `in_unsafe` is whether the binding sits inside a module-level `unsafe { … }` group — the
# one place a top-level `mut` is legal (docs/runtime/ffi.md).
fn p_top_binding(mut &p: Parser, is_mut: bool, is_const: bool, is_pub: bool, in_unsafe: bool, line: int, col: int) -> ConstDecl {
	s := parse_binding(p, is_mut, is_const)
	return match s {
		Stmt.SLet(name, ty, has_ty, im, ic, value) => ConstDecl(name, ty, has_ty, im, ic, is_pub, in_unsafe, value, p.path, line, col)

		# parse_binding only ever answers SLet; the arm is exhaustiveness, and it must be
		# LOUD: fabricating a ConstDecl here would let a future non-SLet result flow into
		# the module's constants as an unnamed `zg_` global
		_ => p_not_a_binding()
	}
}

# p_not_a_binding is p_top_binding's impossible arm made loud. It is typed as answering
# the ConstDecl it never builds because a match arm is an expression and every arm must
# yield the match's one type — the same shape as c_range_unsupported.
fn p_not_a_binding() -> ConstDecl {
	raise p_impossible("parse_binding answered a statement that is not a binding — SLet is its one result, and a top-level declaration must not be fabricated from anything else")
}

# p_deco_may_lead reports whether the item starting here is one THIS pending list may lead.
# The three that take a derive or an `#[obj]` are the three that call p_take_derives —
# `struct`, `enum` and `spec` — and `#[test]` goes on the one declaration none of those is, a
# `fn`. A second decorator is let through either way so they stack: `#[derive(Eq)] #[obj] spec
# S` puts two names on one pending list and the declaration under them takes both.
#
# It reads the LIST and not just the token, because the two sets are disjoint: without that,
# `#[test]` on a struct would be accepted and dropped, which is the silence the whole rule
# exists to end.
fn p_deco_may_lead(mut &p: Parser, pending: list[str]) -> bool {
	return true if p_at(p, Kind.Hash)
	return p_at(p, Kind.Fn) if p_deco_is_test(pending)

	return p_at(p, Kind.Struct) or p_at(p, Kind.Enum) or p_at(p, Kind.Spec)
}

# p_deco_is_test reports whether a pending list holds a `#[test]`.
fn p_deco_is_test(pending: list[str]) -> bool {
	for nm in pending {
		return true if nm == "#test"
	}
	return false
}

# p_deco_leads spells the declarations the pending list may lead, for the sentence that turns
# one away. A derive and an `#[obj]` name a type or a spec; a `#[test]` names a function, and
# telling a reader who wrote one that it belongs on a `struct` would be advice for the other
# decorator.
fn p_deco_leads(pending: list[str]) -> str {
	return "`fn`" if p_deco_is_test(pending)

	return "`struct`, `enum` or `spec`"
}

# p_deco_says spells a PENDING entry the way the program wrote it. The list carries derive
# arguments, `#obj` and `#test` together — under markers no spec name can be, since a `#` is
# not an identifier character — and every sentence about the list assumed a derive, so `#[obj]
# fn f()` was refused as `#[derive(#obj)]`: a decorator quoted at a reader who never wrote it,
# in a spelling the language does not have.
fn p_deco_says(nm: str) -> str {
	return "#[obj]" if nm == "#obj"
	return "#[test]" if nm == "#test"

	return f"#[derive({nm})]"
}

# p_take_derives moves the pending derive names onto the declaration just parsed, as pairs.
fn p_take_derives(name: str, mut &pending: list[str], mut &on: list[str], mut &specs: list[str]) {
	for nm in pending {
		on.append(name)
		specs.append(nm)
	}
	pending = []
}

# imports_of_at returns just the import paths of a source, for the driver's module loader:
# it resolves and loads a program's dependencies before anything is emitted, so it needs
# the import list alone and not the cost of keeping a whole parse around.
#
# It is told which FILE it is reading, and there is deliberately no pathless twin. The scan
# is a full parse, so it is the FIRST parse a source meets — a refusal the parser raises
# with a place (p_place) escapes from HERE, before the pathed compile parse ever runs, and
# a pathless caller made that place name a line of no file. The twin was kept for "a caller
# with genuinely no path" and no such caller ever appeared; what its existence did keep is
# the one mistake this signature was introduced to make impossible.
pub fn imports_of_at(src: str, path: str) -> list[str] {
	# the PATHS alone: the loader resolves a module to a file, and the name the import binds
	# is a question about this file's scope, which the loader has no opinion about
	f := parse_at(src, path)
	mut out: list[str] = []
	for im in f.imports {
		out.append(im.path)
	}
	return out
}

# import_decls_at is imports_of_at with the DECLARATION kept, and it exists for the one thing
# the path alone cannot buy: a place. A loader that holds only `"atomic"` can say a module is
# unavailable and cannot say which line asked for it, so its refusal is the one shape this
# repo's gates turn away — a real error the reader has to go and find.
pub fn import_decls_at(src: str, path: str) -> list[ImportDecl] {
	f := parse_at(src, path)
	return f.imports
}

# parse_fill reads the tail of `[v; N]`. The count is a CONST-EXPR (GRAMMAR group 4's
# `list-lit`), so it is parsed as an ordinary expression and carried on the node — the parser
# used to expand the form into N copies right here, which is why the count could only ever be
# an integer literal: a const-expr may name a constant, and a name is not resolvable until
# every file of the program has been merged. c_fill_elems does the expansion, over a program.
fn parse_fill(mut &p: Parser, v: Expr) -> Expr {
	n := parse_expr(p)
	expect(p, Kind.RBrack)
	return Expr.EFill(v, n)
}

# parse_fn_expr reads `fn(p: T) -> R { … }` in expression position — the same shape a
# declaration has, minus the name. GRAMMAR gives a fn-expr no generic parameters, so there
# is no bracket group to read here.
fn parse_fn_expr(mut &p: Parser) -> Expr {
	p_advance(p) # 'fn'
	expect(p, Kind.LParen)
	mut params: list[Param] = []
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		mut is_ref := false
		if p_at(p, Kind.Mut) {
			p_advance(p)
			if p_at(p, Kind.Amp) {
				p_advance(p)
				is_ref = true
			}
		}
		nt := cur(p)
		pname := p_name(p, "a parameter")

		# A CLOSURE parameter MAY OMIT its `: type` (GRAMMAR#closure-param), and one that
		# does is `TUnknown` here. The parser cannot do better than that and must not try:
		# the type comes from the function type the closure is checked against, which is a
		# fact about the POSITION the closure lands in and not about the closure — so it is
		# filled where that position is known (c_fn_typed), and a closure that never meets
		# one is refused there.
		mut pty := Ty.TUnknown
		if p_at(p, Kind.Colon) {
			p_advance(p)
			pty = parse_type(p)
		}

		# The same production ends with `( '=' expr )?` — a DEFAULT, exactly the tail
		# GRAMMAR#param gives a named declaration's parameter, and one a named `fn` has had
		# since defaults were built. The closure half was never read: the loop went from the
		# type straight to the comma, so the `=` was still sitting there when the next
		# parameter's NAME was asked for, and the answer was `a parameter needs a name, and
		# `=` is not one` — a complaint about the token, from a reader that had no idea a
		# default was what it was looking at.
		#
		# The expression is read to its end before the refusal, so the sentence is about the
		# form and not about wherever the reader stopped. Building it is more than parsing:
		# a default is materialised AT THE CALL SITE out of the callee's DECLARATION, and a
		# closure is reached through a value, which carries no declaration to read one from.
		if p_at(p, Kind.Assign) {
			p_advance(p)
			parse_expr(p)
			raise p_diag_at(p, nt.line, nt.col, "E285", f"NotImplemented: a default on the closure parameter `{pname}` — GRAMMAR#closure-param derives `( '=' expr )?` and a named `fn` declaration honours it, but a default is filled in at the CALL SITE from the callee's declaration, and a closure is reached through a value that has not got one. Pass the argument at every call")
		}
		params.append(Param(pname, pty, is_ref, false, Expr.ENil))
		p_list_sep(p, Kind.RParen, ")", "a parameter list")
	}
	expect(p, Kind.RParen)
	mut ret := Ty.TVoid
	mut has_ret := false
	if p_at(p, Kind.Arrow) {
		p_advance(p)
		ret = parse_type(p)
		has_ret = true
	}
	return Expr.EFn(params, has_ret, ret, parse_block(p))
}

# parse_select reads `select { … }` and its four arm shapes:
#
#     v := <-ch => body      a receive that names what it received
#        <-ch => body        a receive that discards it
#     ch <- v => body        a send
#     _ => body              nothing was ready (non-blocking)
#
# The terminal arm is spelled with the RESERVED `close`, which is what makes it impossible to
# misread or to mistype: `close` is already the keyword that ends a stream (`close(ch)`), and a
# keyword cannot also be the name of something in scope. It used to be the contextual word
# `done`, and contextual meant this parser took ANY identifier before `=>` as an arm head and
# silently made everything but `done` the `_` arm — so `closed => …` compiled, and turned the
# whole select non-blocking. `_` stays contextual because it is punctuation: nothing can be
# named `_` that a reader would confuse with the wildcard.
fn parse_select(mut &p: Parser) -> Stmt {
	p_advance(p) # 'select'
	return Stmt.SSelect(parse_sel_arms(p))
}

# parse_sel_arms reads the `{ arm+ }` both spellings share.
fn parse_sel_arms(mut &p: Parser) -> list[SelArm] {
	expect(p, Kind.LBrace)
	skip_semis(p)
	mut arms: list[SelArm] = []
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		arms.append(parse_sel_arm(p))
		skip_semis(p)
	}
	expect(p, Kind.RBrace)

	# GRAMMAR says `select-arm+`. An empty one has nothing to wait FOR, so it would park on
	# no channel at all and never wake — a hang with no cause to find.
	raise p_diag(p, "E202", "a select needs at least one arm — an empty one waits on nothing and never wakes") if arms.len() == 0
	return arms
}

fn parse_sel_arm(mut &p: Parser) -> SelArm {
	# There is no terminal arm. A select PICKS a ready arm; ENDING is the loop's job, and
	# `for select { … }` is the loop that owns it. `close` here is refused by name rather
	# than quietly parsed, because it was an arm until this change.
	raise p_diag(p, "E201", "`close` is not a select arm head — a select picks a ready arm, and `for select { … }` is the loop that ends when every watched channel has") if p_at(p, Kind.Close) and peek_kind(p, 1) == Kind.FatArrow

	# `_ => …` — the non-blocking arm, and the ONLY bare identifier a select arm may open with.
	# Anything else here is refused by name: it used to become this arm silently, which turned a
	# typo into a select that no longer blocks and no longer ends.
	if p_names_here(p, p.pos) and peek_kind(p, 1) == Kind.FatArrow {
		head := p_name(p, "a select arm's binding")
		raise p_diag(p, "E203", f"`{head}` is not a select arm head — a select picks a ready arm, and `for select {{ … }}` is the loop that ends when every watched channel has") if head != "_"
		p_advance(p) # '=>'
		return SelArm(3, "", Expr.ENil, Expr.ENil, parse_sel_body(p))
	}

	# `v := <-ch => …` — a named receive
	mut bind := ""
	if p_names_here(p, p.pos) and peek_kind(p, 1) == Kind.Walrus {
		bind = p_name(p, "a select arm's binding")
		if bind == "_" {
			bind = ""
		}
		p_advance(p) # ':='
	}
	if p_at(p, Kind.LArrow) {
		p_advance(p)
		ch := parse_expr(p)
		expect(p, Kind.FatArrow)
		return SelArm(0, bind, ch, Expr.ENil, parse_sel_body(p))
	}

	# `ch <- v => …` — a send
	ch := parse_expr(p)
	expect(p, Kind.LArrow)
	v := parse_expr(p)
	expect(p, Kind.FatArrow)
	return SelArm(1, "", ch, v, parse_sel_body(p))
}

# parse_sel_body reads an arm's body. GRAMMAR says an arm is followed by an expression
# and a block IS one, but this parser has no block-expression — so a `{` is read as a
# block and anything else as a single STATEMENT.
#
# A statement rather than an expression, because `print v` is the most obvious thing to
# write in an arm and `print` is a statement here. Reading it as an expression consumed
# nothing, and the arm loop then read the rest of the body as further arms.
#
# A bare REASSIGNMENT used to be refused here, on the grounds that GRAMMAR made an arm body
# an `expr` while a reassignment is a `simple-stmt`, and that the seed rejected it too. The
# grammar settled the other way — an arm RUNS rather than yields, so its body is a stmt —
# and the seed reads one now, so `v := <-work => total = total + v!` is an ordinary arm and
# no longer needs braces to say what it plainly says.
fn parse_sel_body(mut &p: Parser) -> list[Stmt] {
	return parse_block(p) if p_at(p, Kind.LBrace)
	mut one: list[Stmt] = []

	# the marker parse_block stamps, stamped here for the same reason p_else_body stamps
	# one: a braceless body is a statement built outside that loop, so without it a
	# diagnostic about the arm named the whole `select` rather than the arm.
	t := cur(p)
	one.append(Stmt.SAt(t.line, t.col))

	one.append(parse_stmt(p))
	return one
}

# p_brace_is_map decides, standing on a `{` in EXPRESSION position, whether it opens a map
# literal or a block. Both are primaries (GRAMMAR#primary lists `map-lit` and `block`), so
# the decision has to be made before either is read.
#
# GRAMMAR names the discriminator: "that ':' is exactly what distinguishes a '{ … }' map
# from a block, so a bare-element '{ … }' is ALWAYS a block". So the scan looks for a `:`
# among the brace's OWN tokens — depth 1 — and answers block when there is none. `{}` is a
# block and `{:}` is the empty map, which is why the empty map was given that spelling.
#
# The one shape the bare rule gets wrong is the one p_brace_continues already names: a
# TYPED BINDING carries a `:` too — `{ x: int = 1 }` is a block holding one — and it is
# told apart by what FOLLOWS. A map entry is `expr ':' expr` and ends at the `,` or the
# `}`; a typed binding puts an `=` between the type and the value. So a depth-1 `:` whose
# entry also holds a depth-1 `=` is a binding, and the brace is a block.
#
# A `;` at depth 1 ends the scan the same way: the lexer's inserted separator means the
# brace holds STATEMENTS, and a map's entries are separated by `,` and never by one.
#
# Depth counts all three bracket kinds, because a `:` belonging to something nested — a
# named argument `f(a: 1)`, a nested map, a slice — is not this brace's.
fn p_brace_is_map(mut &p: Parser) -> bool {
	mut depth := 0
	mut i := 0
	for {
		k := peek_kind(p, i)
		return false if k == Kind.Eof

		if k == Kind.LBrace or k == Kind.LParen or k == Kind.LBrack {
			depth = depth + 1
		} else if k == Kind.RBrace or k == Kind.RParen or k == Kind.RBrack {
			depth = depth - 1
			return false if depth == 0
		} else if depth == 1 and k == Kind.Semi {
			# a statement separator: these are statements, so this is a block
			return false
		} else if depth == 1 and k == Kind.Colon {
			return not p_brace_entry_assigns(p, i + 1)
		}
		i = i + 1
	}
	return false
}

# p_brace_entry_assigns answers whether the entry that a depth-1 `:` opened runs on to an
# `=` before it ends — which is what makes `x: int = 1` a typed binding rather than a map
# entry whose key is `x`. The entry ends at the enclosing brace's `,` or `}`, or at a `;`.
fn p_brace_entry_assigns(mut &p: Parser, at: int) -> bool {
	mut depth := 1
	mut i := at
	for {
		k := peek_kind(p, i)
		return false if k == Kind.Eof

		if k == Kind.LBrace or k == Kind.LParen or k == Kind.LBrack {
			depth = depth + 1
		} else if k == Kind.RBrace or k == Kind.RParen or k == Kind.RBrack {
			depth = depth - 1
			return false if depth == 0
		} else if depth == 1 and (k == Kind.Comma or k == Kind.Semi) {
			return false
		} else if depth == 1 and k == Kind.Assign {
			return true
		}
		i = i + 1
	}
	return false
}

# parse_map_lit reads `{k: v, …}` and the empty `{:}`.
#
# The `:` is what makes a map literal unambiguous: GRAMMAR gives the empty map the
# spelling `{:}` rather than `{}` precisely so that a brace with no colon in it is ALWAYS
# a block. Nothing here has to guess — p_brace_is_map above has already asked.
fn parse_map_lit(mut &p: Parser) -> Expr {
	p_advance(p) # '{'
	mut ks: list[Expr] = []
	mut vs: list[Expr] = []

	# ASI FIRES INSIDE A BRACE. It is suppressed inside an unclosed `(` or `[` and nowhere
	# else (GRAMMAR group 2), so a map literal written over several lines carries a `;` after
	# every entry whose line does not end in the `,`:
	#
	#     m := {
	#         "a": 1        <- an int can END an item, so ASI inserts a `;` here
	#     }
	#
	# and this loop demanded `}` or a `,`, so that program got "expected `}`, found `;`" —
	# a table written the way anyone writes one. With a trailing comma it worked, because a
	# `,` cannot end an item and no `;` was inserted; the two spellings disagreed.
	skip_semis(p)
	if p_at(p, Kind.Colon) {
		# the empty map, `{:}`
		p_advance(p)
		skip_semis(p)
		expect(p, Kind.RBrace)
		return Expr.EMapLit(ks, vs)
	}
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		et := cur(p)
		ks.append(parse_expr(p))

		# THIS ENTRY HAS NO `:`. The brace as a whole reached here because one of its entries
		# had one, so a later entry without one is a map literal missing a value — `{a, "b": 1}`
		# — and not the block/map ambiguity, which p_brace_is_map settled before this ran.
		#
		# It used to read on regardless and build a map out of whatever parsed, which is how a
		# match arm written `Right(e) => { report(e); stop() }` came out as a one-entry map that
		# ran neither call. That form is a BLOCK now and never reaches this function.
		raise p_diag_at(p, et.line, et.col, "E479", "a map entry is `key: value`, and this one has no `:` — GRAMMAR#map-entry") if not p_at(p, Kind.Colon)
		p_advance(p)
		vs.append(parse_expr(p))
		skip_semis(p)
		break if not p_at(p, Kind.Comma)
		ct := cur(p)
		p_advance(p)
		skip_semis(p)
		if p_at(p, Kind.RBrace) {
			p_trailing_comma(p, "a map literal", "}", ct.line, ct.col)
		}
	}
	expect(p, Kind.RBrace)
	return Expr.EMapLit(ks, vs)
}

# parse_spec consumes a `spec S { … }` declaration whole and yields nothing.
#
# A spec is an INTERFACE: it declares signatures, and the code for them lives in the
# `impl S for T` blocks, which parse_impl already reads. So there is nothing here to lower
# — but there is something to skip, and skipping it correctly is the point. parse's
# fallthrough advances ONE token, which left the body's `fn show() -> str` to be read as a
# top-level function with no block; the emitter then wrote a non-void C function with an
# empty body, which is undefined behaviour that only warns.
#
# parse_spec reads a `spec` declaration — its name, its own type parameters, the specs it
# extends, and each required member's SIGNATURE.
#
# It used to be a token scanner. The header loop ran to the `{` keeping the first Ident as
# the name, which swallowed the super-spec after `:` whole; the body loop kept the Ident
# after each `fn` and dropped everything else. So a spec was a name and a list of method
# names, and every guarantee beyond "something with this name exists" was imaginary:
# `fn tag() -> str` satisfied `fn tag(n: int) -> int`, and `spec Ord: Eq` required nothing
# of `Eq`.
#
# The members are read by parse_fn_head — the same code an `impl`'s methods go through — so
# what a spec requires and what an impl supplies are the same kind of object.
#
# A PROVIDED member (a signature carrying a body) is still refused. A signature that is
# dropped loses enforcement; a BODY that is dropped is code on the page that is never
# compiled, so nothing in it is checked — a `this.x` naming a field no implementor has, a
# call to a function that does not exist, a type error. It reads like the method that will
# run and is not, which is the shape this compiler turns away by name everywhere else.
fn parse_spec(mut &p: Parser, is_pub: bool) -> SpecDecl {
	kw := cur(p)
	p_advance(p) # 'spec'
	name := p_type_name(p, "a spec")

	# `spec Ix[K]` and `spec Ix[K: Ord]` — the spec's OWN type parameters. They are what a
	# required signature's `K` stands for, and an `impl Ix[int]` says which type that is.
	#
	# The BOUND is read and dropped: nothing here checks that the argument satisfies it, and
	# collecting every bare identifier instead made `[K: Ord]` two parameters, so a correct
	# `impl Ix[int] for A` was told the spec is "parameterized by K, Ord".
	mut params: list[str] = []
	if p_at(p, Kind.LBrack) {
		p_advance(p)
		for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
			params.append(p_name(p, "a spec's type parameter"))
			if p_at(p, Kind.Colon) {
				p_advance(p)
				parse_bound(p, "a type parameter's bound", false)
			}

			p_list_sep(p, Kind.RBrack, "]", "a spec's type parameter list")
		}
		expect(p, Kind.RBrack)
	}

	# `spec Ord: Eq + Hash` — a SUPER-SPEC (GRAMMAR#spec-decl), a conjunction. An `impl Ord` must
	# satisfy every one of them; the whole clause used to be swallowed by the scan for `{`.
	#
	# `spec Ord: Eq[int]` used to make `int` a SECOND super, so the impl was told `Ord`
	# extends a spec named `int`. It is named rather than dropped — see parse_bound.
	mut supers: list[str] = []
	mut super_args: list[list[Ty]] = []
	if p_at(p, Kind.Colon) {
		p_advance(p)
		parse_supers(p, supers, super_args)
	}

	expect(p, Kind.LBrace)
	skip_semis(p)
	mut reqs: list[FnDecl] = []
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		# `unsafe` opens a fn-sig too — GRAMMAR#fn-sig is `'unsafe'? 'mut'? 'fn' …` — so
		# `unsafe fn peek()` in a spec IS a member, and it used to fall to the catch-all at
		# the bottom of this loop, whose sentence says the token starts no member AT ALL and
		# cites GRAMMAR#spec-member while saying it. That denied a derivation the grammar
		# plainly has, which is worse than not building the form: a reader is told the
		# language is smaller than it is, by the document that defines it.
		#
		# The signature is READ to its end and then refused as itself, with the place a
		# declaration owes — the same answer a top-level `unsafe fn` gets (E264) for the same
		# reason, so one unenforced trust boundary now has one story in both positions. The
		# lookahead is what keeps the catch-all honest for everything else: `unsafe { … }`
		# inside a spec really does start no member, and still gets E276.
		if p_at(p, Kind.Unsafe) and (peek_kind(p, 1) == Kind.Fn or (peek_kind(p, 1) == Kind.Mut and peek_kind(p, 2) == Kind.Fn)) {
			u := cur(p)
			p_advance(p)
			mut u_mut := false
			if p_at(p, Kind.Mut) {
				p_advance(p)
				u_mut = true
			}

			# `in_unsafe` is FALSE even though the word being read is `unsafe`: that parameter
			# tracks whether the declaration sits inside a module-level `unsafe { … }` GROUP
			# (the sig_unsafe column), and a `spec` member sits in no group. The signature is
			# discarded by the raise below in any case.
			sig := parse_fn_head(p, false, "This", u_mut, false)
			raise p_diag_at(p, u.line, u.col, "E287", f"NotImplemented: the `unsafe` `spec` signature `{sig.name}` — GRAMMAR#fn-sig derives `'unsafe'? 'mut'? 'fn'`, so this IS a spec member; `unsafe` marks a trust boundary this compiler does not enforce yet (docs/runtime/ffi.md), so the signature is refused rather than read as a safe one and its `unsafe` dropped")
		}

		# `mut fn` is part of a fn-sig (GRAMMAR#fn-sig), and it is INTERFACE: a `mut fn` method
		# mutates its receiver, so calling it needs a `mut` binding. Dropping the token made
		# the requirement silent in both directions — a spec asking for `mut fn` was
		# satisfied by a plain one, and a plain one by a `mut fn`.
		mut recv_mut := false
		if p_at(p, Kind.Mut) and peek_kind(p, 1) == Kind.Fn {
			p_advance(p)
			recv_mut = true
		}
		if p_at(p, Kind.Fn) {
			# The receiver is `This` — the implementing type, which is not known here. Giving
			# it a name makes a required signature the same SHAPE as a supplied one, so the
			# two are compared position for position with nothing to offset.
			sig := parse_fn_head(p, false, "This", recv_mut, false)
			raise p_diag(p, "E210", f"NotImplemented: a `spec` member with a BODY — a provided method's body is read and dropped here, so nothing in it is checked and it is not the method that runs; declare the signature `{sig.name}` and write the body in each `impl`") if p_at(p, Kind.LBrace)

			reqs.append(sig)
		} else if p_at(p, Kind.Type) {
			raise p_diag(p, "E230", "an associated type is not a `spec` member — a spec carries BEHAVIOUR and nothing else (GRAMMAR#spec-member), so `type Item` names a type nothing here binds. Take the type as a parameter of the spec instead")
		} else if p_at(p, Kind.Ident) and peek_kind(p, 1) == Kind.Colon {
			raise p_diag(p, "E211", f"an associated value is not a `spec` member — a spec carries BEHAVIOUR and nothing else (GRAMMAR#spec-member), so `{cur(p).lexeme}: T` asks each impl for a constant nothing here binds. A per-type constant is an `impl` item")
		} else {
			# ANYTHING ELSE IS NOT A MEMBER, and this used to advance one token and carry on.
			# `spec Buf { SIZE := 4096 }` was therefore accepted in silence and the member
			# vanished: no impl had to supply it, and nothing said so. A spec's members are
			# what GRAMMAR#spec-member derives, and a token that starts none of them is the
			# program saying something this language has no room for.
			raise p_diag(p, "E276", f"`{cur(p).lexeme}` does not start a `spec` member — a spec carries BEHAVIOUR (GRAMMAR#spec-member): a required signature, or a provided method")
		}
		skip_semis(p)
	}
	expect(p, Kind.RBrace)
	return SpecDecl(name, params, supers, super_args, reqs, is_pub, p.path, kw.line, kw.col)
}

# parse_typedecl reads `type X = Y` — a NEW, DISTINCT type that takes on Y's representation
# and keeps an identity of its own (docs/core/types.md). It used to reach the top level's
# final `else`, which advances ONE token, so the four tokens of a declaration were swallowed
# one at a time and the type simply did not exist: `Celsius(20)` answered "no type named
# `Celsius` to construct" and a `-> Celsius` answered the same, with nothing pointing at the
# declaration that had been dropped.
#
# A GENERIC one is `[not yet]` and says so. It is read far enough to know that is what it is,
# because refusing at the `[` with the parser's ordinary message would name a bracket rather
# than the feature.
fn parse_typedecl(mut &p: Parser, is_pub: bool) -> TypeDecl {
	kw := cur(p)
	p_advance(p)

	# p_name, and not a bare `expect(p, Kind.Ident)`. Every other declaration in this file
	# takes its name through p_name, which is where the reserved-word rule is asked
	# (GRAMMAR group 7: `This` is the self type and no declaration may take it); an alias
	# read its identifier for itself and so was the one declaration the rule never reached.
	# `type This = int` then meant a module-level synonym for `int` while `This` inside an
	# `impl` still meant the implementing type — one word, two meanings, in one program.
	name := p_type_name(p, "a type alias")

	# A code and a place, which this one refusal did without while its two siblings — E212
	# for a generic `enum` and E215 for a generic `struct` — carry both. Three declarations
	# refused for one reason, and the alias was the one a gate could not pin.
	if p_at(p, Kind.LBrack) {
		b := cur(p)
		raise p_diag_at(p, b.line, b.col, "E491", f"NotImplemented: a generic `type {name}[…] = …` — a parameterized alias is one instantiation per argument, and this compiler erases type parameters (the reason a generic `enum` is E212 and a generic `struct` E215)")
	}

	expect(p, Kind.Assign)

	return TypeDecl(name, parse_type(p), is_pub, p.path, kw.line, kw.col)
}

# parse_init reads `init() { … }`, the lazy-setup declaration, as an ordinary function so
# nothing downstream needs a second notion of a callable. GRAMMAR allows MANY of them and
# runs each once in declaration order, so the name carries the position it was read at —
# `init` twice over would otherwise be one C symbol twice.
#
# The name is not one a program can write (`init` is a keyword), which is what keeps it
# from colliding with anything the source declares.
fn parse_init(mut &p: Parser, at: int) -> FnDecl {
	kw := cur(p)
	p_advance(p) # 'init'
	expect(p, Kind.LParen)
	expect(p, Kind.RParen)
	mut params: list[Param] = []
	body := parse_block(p)
	return FnDecl(init_name(at), "", params, false, Ty.TVoid, body, false, p.path, kw.line, kw.col, [], [], false, false)
}

pub fn init_name(at: int) -> str {
	return "init__" + strconv.to_string(at, 10)
}

pub fn is_init_name(name: str) -> bool {
	return strings_has_prefix(name, "init__")
}

fn strings_has_prefix(s: str, pre: str) -> bool {
	b := bytearray(s)
	q := bytearray(pre)
	return false if b.len() < q.len()
	mut i := 0
	for i < q.len() {
		return false if b[i] != q[i]
		i = i + 1
	}
	return true
}

# parse_import reads both forms GRAMMAR gives an import — one spec, or a parenthesized
# group of them — and appends every path it binds.
#
# The group matters more than it looks: F404 writes it, and a parser that skipped it would
# hand the driver an EMPTY import list for a file that imports things. Nothing would fail
# at the parse — the module loader would simply not load `io`, and the failure would
# surface later and elsewhere as an unknown name.
fn parse_import(mut &p: Parser, mut &imports: list[ImportDecl]) {
	p_advance(p) # 'import'
	if not p_at(p, Kind.LParen) {
		im := parse_import_spec(p)
		if im.path != "" {
			imports.append(im)
		}
		return
	}
	p_advance(p) # '('
	skip_semis(p)
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		at := p.pos
		im := parse_import_spec(p)
		if im.path != "" {
			imports.append(im)
		}

		# a spec that read nothing would leave the position where it was: step over the
		# token rather than reading it forever
		if p.pos == at {
			p_advance(p)
		}
		skip_semis(p)
	}
	if p_at(p, Kind.RParen) {
		p_advance(p)
	}
}

# parse_import_spec reads `pub? "path" (as name)?` and yields the DECLARATION it is — the
# path, the name it binds, and the place, which is everything a later pass needs to resolve
# a qualified name against it. Anything that is not a string literal is refused below, so
# the only empty path it can answer is the empty literal.
#
# `pub` re-exports what it imports. The driver has to LOAD it either way — a re-exported
# module is part of the program — so the marker is consumed and the path read as usual.
#
# `as` RENAMES THE NAMESPACE, and the alias used to be read and thrown away: the binding was
# recomputed downstream as the path's last segment, so `import "a/text" as at` bound `text`
# and every `at.…` in the file was a name nothing declared. The alias is the binding when it
# is there, which is a fact about the surface and so the parser's to record.
fn parse_import_spec(mut &p: Parser) -> ImportDecl {
	if p_at(p, Kind.Pub) {
		p_advance(p)
	}

	# A PATH IS A STRING LITERAL, and only that (GRAMMAR#import-path). This used to answer ""
	# for anything else, and "" means "no spec here" — so `import util/text`, the older bare
	# spelling, was read as no import at all and the leftover `util/text` fell through to the
	# statement loop as a top-level expression, which compile mode treats as a nop. The
	# program built, printed, exited 0, and had imported nothing; the first sign of it was a
	# member access on a namespace that was never bound.
	# THE GUESS IS A PATH OR IT IS NOTHING, which is the other half of the same rule: a
	# suggestion quotes the reader's own line back at them, so one assembled out of whatever
	# followed is worse than none. It ran to the next `;` — and ASI inserts none after
	# `import`, a keyword that cannot END an item (GRAMMAR group 2) — so a bare `import` with
	# no path swept up the declarations under it and offered `import "structQ{puba:int"`.
	if not p_at(p, Kind.Str) {
		guess := p_import_path_guess(p)

		# ONE RAISE, because it is one rule: a code answers to a rule, and reporting the same
		# one from two sites is two rules wearing one identity (scripts/error-codes-check.sh).
		# What differs between the two lines is the ADVICE, so that is the part that varies.
		mut says := "there is no path here to quote back: GRAMMAR#import-path derives a str-lit and nothing else, so a module is named `import \"util/text\"`"
		if guess != "" {
			says = f"write `import \"{guess}\"` (GRAMMAR#import-path); the bare form is not the spelling this language has"
		}

		raise p_diag_at(p, cur(p).line, cur(p).col, "E267", f"an import path is a string — {says}")
	}

	t := cur(p)
	p_advance(p) # the path
	if p_at(p, Kind.As) {
		p_advance(p) # 'as'
		if p_at(p, Kind.Ident) {
			alias := cur(p).lexeme
			p_advance(p)
			return ImportDecl(t.value, alias, true, p.path, t.line, t.col)
		}
	}

	# `t.value` is the decoded path, without its quotes
	return ImportDecl(t.value, last_segment(t.value), false, p.path, t.line, t.col)
}

# p_import_path_guess reassembles the bare path the reader wrote, so the refusal above can
# quote their own line back at them rather than a placeholder. It reads through the peek
# pair, WITHOUT consuming: that raise ends the parse anyway, and a reader of this function
# should not have to know it.
#
# It reads the SHAPE OF A PATH — `identifier ( '/' identifier )*`, which is what the string
# in GRAMMAR#import-path holds — and stops at the first token that is not part of one. It
# used to read to the next `;` instead, which is a terminator this position never meets: ASI
# inserts one after a token that can END an item (GRAMMAR group 2) and `import` is not one,
# so a bare `import` ran on through the declarations below it and the suggestion was
# assembled out of a struct. Answering "" for a line that holds no path is what lets the
# caller offer no suggestion rather than an invented one.
fn p_import_path_guess(mut &p: Parser) -> str {
	return "" if peek_kind(p, 0) != Kind.Ident

	mut out := peek_lexeme(p, 0)
	mut n := 1
	for peek_kind(p, n) == Kind.Slash and peek_kind(p, n + 1) == Kind.Ident {
		out = out + "/" + peek_lexeme(p, n + 1)
		n = n + 2
	}
	return out
}

fn parse_enum(mut &p: Parser, is_pub: bool) -> EnumDecl {
	kw := cur(p)
	p_advance(p) # 'enum'
	name := p_type_name(p, "an enum")

	# `enum E[T] { A(T) }` — the parameter list was read and dropped the way a struct's is,
	# but an enum's payload NAMES it, so `T` reached cc as a type nothing declares. A struct's
	# field types go through c_check_named_ty; a variant's did not.
	raise p_diag(p, "E212", f"NotImplemented: a generic enum `{name}[…]` — this compiler erases type parameters, and a variant's payload names one") if p_at(p, Kind.LBrack)
	expect(p, Kind.LBrace)
	skip_semis(p)

	mut variants: list[VariantDef] = []
	mut spelled: list[str] = []
	mut payload := false
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		vt := cur(p)
		vname := p_name(p, "an enum variant")
		mut fields: list[Ty] = []
		if p_at(p, Kind.LParen) {
			p_advance(p)
			for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
				fields.append(parse_type(p))
				p_list_sep(p, Kind.RParen, ")", "a variant payload")
			}
			expect(p, Kind.RParen)
			payload = true
		}

		# `= const-expr` gives the variant an explicit DISCRIMINANT (GRAMMAR#variant). It used
		# to be read as the next variant's name — `A = 3` declared three variants, one of
		# them called "=" — so an enum that spelled its own values compiled to nonsense with
		# nothing said about it.
		#
		# What is READ here and not decided here is the VALUE: the expression is a const-expr,
		# so it may name a constant, and the numbering it feeds — this variant's value, and
		# the next variant's default of one past it — is c_build_enums' to work out once the
		# program is whole. That is also where E213's "distinct across variants" moved to,
		# because two variants only collide once both have numbers.
		mut has_discr := false
		mut discr := Expr.ENil
		if p_at(p, Kind.Assign) {
			p_advance(p)
			has_discr = true
			discr = parse_expr(p)
			spelled.append(vname)
		}
		variants.append(VariantDef(vname, fields, has_discr, discr, vt.line, vt.col))

		# GRAMMAR#variant-list is `variant ( stmt-sep+ variant )*` — the same shape as a
		# statement list, so the separator is REQUIRED and p_stmt_sep is the rule that says
		# so. skip_semis skipped one when there was one and said nothing when there was not,
		# which made `enum Shape { Dot Line }` two variants written as though they were one
		# thing, accepted in silence.
		p_stmt_sep(p, Kind.RBrace)
	}
	expect(p, Kind.RBrace)

	# GRAMMAR#variant — a discriminant belongs to a C-style integer enum, and only to one: a
	# payload enum's tag is opaque and match-only, so there is nothing for a value to be.
	# The spelled list is what makes this exact: a variant whose declared value HAPPENS to
	# equal its position was indistinguishable from one that declared nothing, so `P(int) = 0`
	# had its discriminant read and then quietly dropped.
	raise p_diag(p, "E214", f"enum `{name}` carries a payload, so its tag is opaque — a discriminant (on `{spelled[0]}`) belongs to an enum whose every variant is fieldless") if payload and spelled.len() > 0
	return EnumDecl(name, variants, is_pub, p.path, kw.line, kw.col)
}

# is_pascal reports whether a name starts with an uppercase ASCII letter — the tell for
# a type / enum-variant name versus a lowercase binding.
fn is_pascal(s: str) -> bool {
	b := bytearray(s)
	return false if b.len() == 0
	v := int(b[0])
	return v >= 65 and v <= 90
}

fn parse_struct(mut &p: Parser, is_pub: bool) -> StructDecl {
	kw := cur(p)
	p_advance(p) # 'struct'
	name := p_type_name(p, "a struct")

	# `struct B[T] { … }` — READ AND DROPPED, so a field of type `T` then reported
	# `no type named T`: a message about the consequence, from two steps away, for a form
	# the compiler had already decided not to support. A generic ENUM has been refused by
	# name since it was written; this is the same refusal for the other declaration.
	raise p_diag(p, "E215", f"NotImplemented: a generic struct `{name}[…]` — this compiler erases type parameters, and a field names one") if p_at(p, Kind.LBrack)
	expect(p, Kind.LBrace)
	skip_semis(p)
	mut fields: list[FieldDef] = []
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		# where the field BEGINS, read before `pub` is consumed, so a diagnostic about the
		# field points at the whole declaration rather than at the type halfway along it
		at := cur(p)

		# a field may be declared `pub`, which marks it for external instance access. It does
		# not reach the emitted C — one flat struct either way — and it is carried because it
		# decides whether the field is allowed to have no default (GRAMMAR#field).
		mut is_pub := false
		if p_at(p, Kind.Pub) {
			p_advance(p)
			is_pub = true
		}
		fname := p_name(p, "a struct field")
		expect(p, Kind.Colon)
		fty := parse_type(p)

		# `x: int = 7` — a field DEFAULT (GRAMMAR#field), which feeds the constructor: it is
		# what lets the field's argument be omitted, exactly as a parameter default lets a
		# trailing call argument be omitted. It is one expression and it is kept whole, so it
		# can be backfilled at each construction and evaluated there.
		mut has_def := false
		mut def := Expr.ENil
		if p_at(p, Kind.Assign) {
			p_advance(p)
			def = parse_expr(p)
			has_def = true
		}
		fields.append(FieldDef(fname, fty, is_pub, has_def, def, at.line, at.col))

		# GRAMMAR#field-list is `field ( stmt-sep+ field )*` — the separator is REQUIRED,
		# the same rule the variant list states above and for the same reason.
		p_stmt_sep(p, Kind.RBrace)
	}
	expect(p, Kind.RBrace)
	return StructDecl(name, fields, is_pub, p.path, kw.line, kw.col)
}

# parse_decorator reads `#[ … ]` (GRAMMAR#decorator). It used to reach the top-level fallback,
# which advances a single token — so `#[derive(Eq)]` was skipped as SIX separate items and
# anything inside it that happened to parse as a declaration was read as one.
#
# The brackets hold a COMMA LIST of items — `deco-item ( ',' deco-item )*` — which this read
# as one item with a bag of identifiers in it. Every name inside that was not `derive` went
# onto `pending` as though it were a derive argument, so `#[derive(Eq), sealed]` asked to
# derive `sealed`: advice that makes no sense, about a decorator parse_deco_item refuses by
# name the moment it is written alone.
fn parse_decorator(mut &p: Parser, mut &pending: list[str]) {
	ob := cur(p)
	p_advance(p) # '#['

	# `#[]` IS NOT A DECORATOR. GRAMMAR#decorator is `'#[' deco-item ( ',' deco-item )* ']'`
	# — one item or more — and the loop below never runs when the `]` is already there, so
	# an empty pair of brackets was read, dropped, and the declaration after it compiled as
	# though nobody had written anything. A decorator changes what a declaration MEANS, which
	# is the reason every other one here is named rather than skipped; an empty one asks for
	# a change nobody can name, and that is worth saying rather than ignoring.
	raise p_diag_at(p, ob.line, ob.col, "E495", "a decorator holds at least one item — GRAMMAR#decorator derives `#[ deco-item, … ]`, and `#[]` names nothing to apply") if p_at(p, Kind.RBrack)

	for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
		parse_deco_item(p, pending)
		break if not p_at(p, Kind.Comma)
		ct := cur(p)
		p_advance(p)

		# GRAMMAR#decorator writes the comma BETWEEN items and derives none before the `]`,
		# the same rule every other comma list here states.
		if p_at(p, Kind.RBrack) {
			p_trailing_comma(p, "a decorator", "]", ct.line, ct.col)
		}
	}
	expect(p, Kind.RBrack)
}

# parse_deco_item reads ONE `name` or `name( args )` (GRAMMAR#deco-item). Only `derive` is
# built, and every other decorator is NAMED rather than skipped, because a decorator that
# changes what a declaration MEANS cannot be ignored without changing the program.
#
# derive's ARGUMENTS ARE KEPT, on `pending`, for the declaration one iteration away. They used
# to be scanned past and dropped, which cost more than it looks: `#[derive(Eq)]` on a type
# meant nothing, so `==` on it either was refused or — on an enum — silently compared tags.
fn parse_deco_item(mut &p: Parser, mut &pending: list[str]) {
	name := cur(p).lexeme

	# `#[obj]` takes no arguments and goes on a `spec`. It rides the same pending list as a
	# derive, under a marker no spec name can be — a `#` is not an identifier character — so
	# the two never compete for a name while sharing one attachment mechanism.
	if name == "obj" {
		p_advance(p)
		pending.append("#obj")
		return
	}

	# `#[test]` takes no arguments and goes on a `fn`. It rides the same pending list under the
	# same kind of marker, for the same reason: one attachment mechanism, and a `#` keeps the
	# marker out of the namespace a derive argument is a name in.
	#
	# It is READ rather than refused because a test file is compiled by `zerg test` and by
	# nothing else — so the decorator that names a test has to reach a parse somewhere, and the
	# seed has recognised it since 1i. Refusing it here would have made `zerg` the compiler
	# that cannot read its own test files.
	if name == "test" {
		p_advance(p)
		pending.append("#test")
		return
	}

	# `#[allow(L…)]` IS THE ONE DECORATOR THIS COMPILER READS AND NEVER USES. It names lint
	# codes to suppress over the statement it leads, and what a code MEANS is the linter's to
	# know — so the whole of the parser's job is to accept the name and attribute no meaning to
	# it. A copy of the L-code catalogue here would be a second place a language fact is
	# written down, and the copy that goes stale is always the one no tool reads.
	#
	# NOTHING GOES ON `pending`, which is the other half of the arrangement: the list is what
	# tells the arms below which DECLARATION a decorator is about, and this one is about none.
	# An empty list after it is therefore exactly true, and it is what lets `#[allow(…)]` lead
	# a statement while `#[derive(…)]` may not.
	if name == "allow" {
		at := cur(p)
		p_advance(p)

		# `#[allow]` and `#[allow()]` SUPPRESS NOTHING while reading as though they suppressed
		# something — E497's argument one decorator over, and the same answer.
		mut named := 0
		if p_at(p, Kind.LParen) {
			p_advance(p)
			for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
				if p_at(p, Kind.Ident) {
					named = named + 1
				}
				p_advance(p)
			}
			expect(p, Kind.RParen)
		}

		raise p_diag_at(p, at.line, at.col, "E614", "an `#[allow]` names the lint codes it suppresses — GRAMMAR#deco-item takes the arguments, and an allow with none suppresses nothing while reading as though it did") if named == 0
		return
	}

	# `#[sealed]` IS RESERVED, and it is a different sentence from an unknown name. GRAMMAR's
	# construction note gives it a meaning — it demotes the field-wise `T(…)` constructor to
	# module-private — so a reader who writes it has not made a typo, and telling them the
	# compiler "reads `#[derive(…)]` and `#[obj]`, and no other" answers a question they did
	# not ask. What they need to know is that the word is the right one and the behaviour is
	# not built, so nothing is protecting the constructor they thought they had sealed.
	nt := cur(p)

	raise p_diag_at(p, nt.line, nt.col, "E496", f"NotImplemented: the decorator `#[sealed]` — it is a reserved decorator (GRAMMAR group 7 gives it a meaning: the field-wise `T(…)` constructor becomes module-private) and this compiler does not build it, so the constructor stays public rather than being sealed in silence") if name == "sealed"

	raise p_diag(p, "E217", f"NotImplemented: the decorator `#[{name}]` — this compiler reads `#[derive(…)]`, `#[obj]`, `#[test]` and `#[allow(…)]`, and no other") if name != "derive"

	p_advance(p)

	# `#[derive]` AND `#[derive()]` ASK FOR NOTHING, and were given it: the arguments are what
	# a derive IS — the specs to generate — so a bare one was read, dropped, and the type went
	# on with no impls while the line above it said it had some. That is the shape of silence
	# this whole pass is about, one `==` away from being noticed.
	#
	# The two spellings are ONE rule, so they are one raise, asked after the arguments are
	# read rather than at each spelling: `before` is how many names were on `pending` when
	# this item began, since a `#[derive(Eq), derive(Ord)]` shares the list with its siblings.
	dt := cur(p)
	before := pending.len()

	# a derive ARGUMENT is a spec name; the arguments a decorator may take in general are
	# const-exprs, and none of them opens a bracket, so the item ends at its own `)`
	if p_at(p, Kind.LParen) {
		p_advance(p)
		for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
			if p_at(p, Kind.Ident) {
				pending.append(cur(p).lexeme)
			}
			p_advance(p)
		}
		expect(p, Kind.RParen)
	}

	raise p_diag_at(p, dt.line, dt.col, "E497", "a `#[derive]` names the specs to generate — GRAMMAR#deco-item takes the arguments, and a derive with none asks for nothing while reading as though it asked for something") if pending.len() == before
}

fn parse_impl(mut &p: Parser, mut &fns: list[FnDecl], mut &impls: list[ImplDecl], in_unsafe: bool) {
	kw := cur(p)
	p_advance(p) # 'impl'

	# `impl[T] Spec for list[T]` — GRAMMAR#impl-decl derives type parameters on the `impl`
	# ITSELF, and its comment says why they sit at that position: a `T` introduced here is
	# what the TARGET is then allowed to spell. Nothing read them, so the head began at a
	# `[` where a name was expected and the answer was "an `impl` needs a name, and `[` is
	# not one" — a complaint about the token under the cursor for a production the grammar
	# derives in full, which is the one shape of message this project does not allow.
	#
	# They are READ, by the same reader `fn`, `struct` and `spec` already share, and the
	# form is then refused BY NAME. A second reader here would be a second answer to one
	# production; and reading them is what makes the refusal able to say which parameters
	# it is turning away rather than which bracket it tripped over.
	mut tp_names: list[str] = []
	mut tp_bounds: list[str] = []
	p_type_params(p, tp_names, tp_bounds)
	raise p_diag_at(p, kw.line, kw.col, "E291", f"NotImplemented: an `impl` carrying its own type parameters `[{join_commas(tp_names)}]` — GRAMMAR#impl-decl puts them there so the target may spell them (`impl[T] Spec for list[T]`), and one impl standing for every instantiation of its target needs those instantiations monomorphized, which this compiler does only for a generic `fn`. Write the `impl` for one concrete target") if tp_names.len() > 0

	# THE HEAD IS PARSED, not scanned. It used to be a loop counting brackets to find the
	# name that `for` follows, with a second lookahead (`p_for_after_args`) to fake the
	# question "are these type arguments, and does a `for` come after them?" — which a parse
	# simply answers by reading them.
	#
	# `impl Spec[args] for Target` and `impl Target` are the same three steps: a name, an
	# optional type-argument list, and then `for` deciding which of the two the name was.
	ftok := cur(p)
	mut first := p_name(p, "an `impl`")
	mut args := parse_ty_args(p)
	mut sp := ""
	mut target := first

	# the TARGET's arguments, which until this change were the one thing in the head that
	# was skipped rather than read. `ttok` follows them, so the refusal below points at the
	# target rather than at the `impl` keyword. Before the `for` is seen the two are the
	# same token and the same list — an inherent `impl Box[int] { … }` has no spec to carry
	# arguments, so the ones already read belong to its target.
	mut ttok := ftok
	mut targs := args
	if p_at(p, Kind.For) {
		p_advance(p)
		sp = first
		ttok = cur(p)
		target = p_name(p, "an `impl … for …` target")
		targs = parse_ty_args(p)
	}

	# A DOTTED NAME IN THE HEAD. GRAMMAR#impl-decl's target is a `type`, and GRAMMAR#base-type
	# derives `type-name type-args? ( '.' identifier )*` — so `impl text.Pair { … }` and
	# `impl Spec for text.Pair` are both forms the grammar has. Neither was read: the name
	# before the `.` was taken whole and the `.` fell to the block's `expect`, which said
	# ``expected `{`, found `.` `` — the token under the cursor, for a production derived in
	# full, and with no place.
	#
	# The SPEC position is the other half and is not the same question: GRAMMAR writes it as
	# a bare `type-name`, so a dotted name there is not derived at all and the sentence says
	# so rather than promising it later.
	# The suffix is READ before either refusal, because which of the two this is cannot be
	# known at the `.`: `impl text.Pair { … }` and `impl text.Named for Bot` are the same
	# tokens until the name after the dot is past and a `for` either follows or does not.
	if p_at(p, Kind.Dot) {
		d := cur(p)
		mut tail := ""
		for p_at(p, Kind.Dot) {
			p_advance(p)
			tail = p_name(p, "a name reached through an import")
		}

		# A `for` after it means the dotted name stood in the SPEC position, which GRAMMAR
		# writes as a bare `type-name` — so this one is not a form the grammar has, and the
		# sentence says that rather than promising it later.
		raise p_diag_at(p, d.line, d.col, "E490", f"an `impl`'s spec is named by a bare `type-name` (GRAMMAR#impl-decl), and `{target}.{tail}` is a name reached through an import — import the spec's module and name the spec alone") if sp == "" and p_at(p, Kind.For)

		raise p_diag_at(p, d.line, d.col, "E489", f"NotImplemented: an `impl` on `{target}.{tail}` — GRAMMAR#impl-decl's target is a `type` and GRAMMAR#base-type derives a dotted name, but this compiler keys an implementation by the target's BARE name, which a type reached through an import does not have here. Write the `impl` in the module that declares the type")
	}

	# An `impl` is keyed here by a bare NAME — `ImplDecl` holds a `str` for its target, and
	# a method's receiver is that same string — so `list[int]` and `list[str]` are one key
	# and `list` is a name no declaration in the program introduces. Skipping the arguments
	# made both of those invisible: `impl Size for list[int]` reached the emitter as an
	# `impl` on a type called `list`, and answered "no type named `list`" — a sentence that
	# is FALSE about a language whose grammar spells `list[T]` and whose every program uses
	# one. Reading the arguments is what lets the refusal be about the form that was
	# written, at the place it was written.
	raise p_diag_at(p, ttok.line, ttok.col, "E292", f"NotImplemented: an `impl` on `{target}[{ty_names(targs)}]` — a type ARGUMENT on the target: this compiler keys an implementation by the target's bare name, so every instantiation of `{target}` would share one, and telling them apart is the same monomorphization a generic target needs. Write the `impl` for a `struct` or an `enum` this program declares") if targs.len() > 0

	if sp != "" {
		impls.append(ImplDecl(sp, args, target, p.path, kw.line, kw.col))
	}
	expect(p, Kind.LBrace)
	skip_semis(p)

	# `This` inside the block names the type the block is for; the parser resolves it here
	# rather than leaving a name the emitter would have to spell and could not.
	outer := p.impl_ty
	p.impl_ty = target
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		mut is_pub := false
		if p_at(p, Kind.Pub) {
			p_advance(p)
			is_pub = true
		}
		mut recv_mut := false
		if p_at(p, Kind.Mut) {
			mt := cur(p)

			# `mut fn` marks a method that mutates `this` IN PLACE — exactly the `mut &this`
			# case (GRAMMAR#fn-decl). So the receiver becomes a `mut &` parameter and everything
			# below the parser follows: the body writes through it, the call site is checked
			# for a `mut` binding, and the borrow cannot escape or alias. A receiver passed
			# BY VALUE is what made this impossible before — the method ran, the copy
			# changed, and the caller's value did not.
			p_advance(p)
			raise p_diag_at(p, mt.line, mt.col, "E603", "`mut` before a declaration in an `impl` marks a `mut fn` method, and this is not a `fn`") if not p_at(p, Kind.Fn)
			recv_mut = true
		}
		if p_at(p, Kind.Fn) {
			fns.append(parse_fn(p, is_pub, target, recv_mut, in_unsafe, false))
		} else if p_at(p, Kind.Ident) and peek_kind(p, 1) == Kind.Walrus {
			# `LIMIT := 5` — an associated VALUE binding (GRAMMAR#val-bind). It was skipped a token
			# at a time, so the name reached the emitter undeclared and cc reported it.
			raise p_diag(p, "E218", f"NotImplemented: an associated value binding `{cur(p).lexeme} := …` in an `impl`")
		} else if p_at(p, Kind.Type) {
			raise p_diag(p, "E231", "NotImplemented: an associated type binding `type … = …` in an `impl`")
		} else {
			raise p_diag(p, "E219", f"NotImplemented: `{cur(p).lexeme}` as an `impl` item — this compiler reads methods and nothing else")
		}
		skip_semis(p)
	}
	expect(p, Kind.RBrace)
	p.impl_ty = outer
}

# `is_test` is the `#[test]` the caller took off the pending decorator list. It arrives as a
# parameter rather than being read here because a decorator is its own top-level item — it is
# read before the `fn` under it exists — and only the arm that dispatched to this one has the
# list in hand.
fn parse_fn(mut &p: Parser, is_pub: bool, recv: str, recv_mut: bool, in_unsafe: bool, is_test: bool) -> FnDecl {
	head := parse_fn_head(p, is_pub, recv, recv_mut, in_unsafe)
	body := parse_block(p)

	return FnDecl(head.name, head.recv, head.params, head.has_ret, head.ret, body, head.is_pub, head.path, head.line, head.col, head.tparams, head.tbounds, head.in_unsafe, is_test)
}

# p_type_params reads `[T, U: Eq]` — a type parameter list — into two parallel lists, the
# names and the spec each is bounded by ("" for an unbounded one). It answers nothing when
# there is no bracket, so every caller may ask.
#
# A BOUND IS A CONJUNCTION of specs — `T: Eq + Hash` asks for both. They are carried joined
# by `+` in the one string a parameter owns, and split where they are checked: a bound is
# read in exactly one place, so the shape that matters is the one there. A bound silently
# narrowed to its first spec would be a program that type-checks against a promise nobody
# made, which is what refusing the form was protecting against.
fn p_type_params(mut &p: Parser, mut &names: list[str], mut &bounds: list[str]) {
	return if not p_at(p, Kind.LBrack)

	p_advance(p) # '['
	for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
		nm := p_name(p, "a type parameter")
		mut bound := ""
		if p_at(p, Kind.Colon) {
			p_advance(p)

			# `parse_bound` is the one reader of `Spec` and `A + B + C`, shared with a spec's
			# own type parameters and with a super-spec. A second reader here would be a
			# second answer to the same production — and a narrower one, since that reader
			# also refuses a bound carrying type arguments.
			bound = join_bounds(parse_bound(p, "a type parameter's bound", true))

			# A VALUE GENERIC PARAMETER, `fn f[N: int]` (GRAMMAR#type-param): a bound that names a
			# CONCRETE TYPE rather than a spec makes the parameter a compile-time VALUE, not a
			# type. Nothing here rejected it, so `N` was carried as a type parameter bounded by
			# a spec named `int` — and the call site `f[3]()` then reported "calling index",
			# two steps from the form and naming neither the parameter nor the argument.
			#
			# Spec or concrete is told by CASE, the same distinction an associated type uses:
			# a spec is PascalCase, and every concrete type this language spells is not.
			raise p_diag(p, "E266", f"NotImplemented: a value generic parameter `{nm}: {bound}` — GRAMMAR lets a concrete-type bound make a parameter a compile-time value (`fn f[N: int]`, applied as `f[3]()`), and this compiler has type parameters only") if not name_is_type(bound)
		}
		names.append(nm)
		bounds.append(bound)
		p_list_sep(p, Kind.RBrack, "]", "a type parameter list")
	}
	expect(p, Kind.RBrack)
}

# parse_fn_head reads a function's SIGNATURE and stops before its body, answering a FnDecl
# whose body is empty. That is exactly a `fn-sig`, which is what a `spec` member is — so a
# spec's requirement and an impl's supply are read by one piece of code, and a comparison
# between them is a comparison of like with like rather than of two parsers' opinions.
fn parse_fn_head(mut &p: Parser, is_pub: bool, recv: str, recv_mut: bool, in_unsafe: bool) -> FnDecl {
	# where the declaration BEGINS, read before anything is consumed: a diagnostic about the
	# signature is made before any statement is emitted, so no SAt marker has spoken yet
	kw := cur(p)
	p_advance(p) # 'fn'

	name := p_fn_name(p, recv)

	# `fn f[T, U: Eq](…)` — the type parameters, and the spec each is bounded by. They are
	# read here rather than skipped because a generic function is a TEMPLATE: nothing is
	# emitted for the declaration itself, and one instantiation reaches C per distinct set
	# of type arguments a call asks for.
	mut tparams: list[str] = []
	mut tbounds: list[str] = []
	p_type_params(p, tparams, tbounds)
	expect(p, Kind.LParen)
	mut params: list[Param] = []
	if recv != "" {
		# The receiver is not written in the parameter list — `this` is implicit — so it is
		# added here. From this point on a method is an ordinary function whose first
		# argument happens to be called `this`, which is why nothing below the parser needs
		# a notion of methods at all.
		params.append(Param("this", Ty.TNamed(recv), recv_mut, false, Expr.ENil))
	}
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		# an optional `mut &` prefix marks a mutable-reference parameter
		mut is_ref := false
		if p_at(p, Kind.Mut) {
			p_advance(p)

			# `mut x: T` is NOT a parameter form (GRAMMAR#param): a by-value parameter is the
			# callee's own copy and writing to it changes nothing the caller can see, so the
			# `mut` reads as a promise the language does not make. It was accepted and the
			# keyword dropped, and a write in the body then said `cannot assign through b:
			# it is immutable` — a true sentence about a parameter the programmer marked mut.
			raise p_diag(p, "E263", "a parameter is `mut &` or nothing — a plain `mut` parameter is a copy the caller never sees written, so the `mut` would promise what it cannot give; bind a `mut` copy in the body instead") if not p_at(p, Kind.Amp)
			p_advance(p)
			is_ref = true
		}
		pname := p_name(p, "a parameter")
		expect(p, Kind.Colon)
		pty := parse_type(p)

		# `= <constant>` makes the parameter optional at the call site
		mut has_def := false
		mut def := Expr.ENil
		if p_at(p, Kind.Assign) {
			p_advance(p)
			def = parse_expr(p)
			has_def = true
		}
		params.append(Param(pname, pty, is_ref, has_def, def))
		p_list_sep(p, Kind.RParen, ")", "a parameter list")
	}
	expect(p, Kind.RParen)
	mut has_ret := false
	mut ret := Ty.TVoid
	if p_at(p, Kind.Arrow) {
		p_advance(p)
		ret = parse_type(p)
		has_ret = true
	}
	mut none: list[Stmt] = []
	return FnDecl(name, recv, params, has_ret, ret, none, is_pub, p.path, kw.line, kw.col, tparams, tbounds, in_unsafe, false)
}

# parse_block counts a nesting level per block, since statements nest through blocks and
# never through parse_expr: `if` inside `if` is parse_block → parse_stmt → parse_block,
# another recursion on the same stack the expression forms overflow.
# parse_with expands `with` into the block it is sugar for (GRAMMAR#with-stmt):
#
#     with acquire() as y { body }   →   { y := acquire(); body }
#     with acquire() { body }        →   { <a name only the compiler writes> := acquire(); body }
#
# It is PURELY SYNTACTIC — no type, no sema, no emitter — because the block it becomes
# already does the whole job: what is bound in it ends at its `}`, on every exit including
# an abort unwind. The form says the block exists for one resource, and binds it.
#
# THE NAMELESS FORM STILL BINDS. Expanding it to a bare `acquire(); body` would end the
# value's life at that statement rather than at the `}`, which is the opposite of what
# holding a resource means — a lock released before the code it protects has run.
#
# The written name carries the LINE, so two `with`s in one function cannot collide and the
# name is the same on every run — `fixpoint` compares emitted C byte for byte, so a counter
# that restarted anywhere but at the same place would move it. A program that writes
# `_with_12` itself collides loudly, as a redeclaration, rather than quietly.
fn parse_with(mut &p: Parser) -> Stmt {
	line := cur(p).line
	p_advance(p)
	p_no_brace_head(p, "a `with` head", false)
	value := parse_expr(p)

	mut name := f"_with_{strconv.to_string(line, 10)}"
	if p_at(p, Kind.As) {
		p_advance(p)
		name = p_name(p, "a `with` binding")
	}

	mut body: list[Stmt] = [Stmt.SLet(name, Ty.TUnknown, false, false, false, value)]
	for st in parse_block(p) {
		body.append(st)
	}

	return Stmt.SScope(body)
}

fn parse_block(mut &p: Parser) -> list[Stmt] {
	p_deeper(p)
	expect(p, Kind.LBrace)
	mut body: list[Stmt] = []
	skip_semis(p)
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		# the marker carries where the statement STARTS, read before it is parsed, so a
		# diagnostic about anything in it has a line and a column to name
		t := cur(p)

		# A DECORATOR MAY LEAD A STATEMENT (GRAMMAR#statement), and it is read here rather
		# than in parse_stmt because a decorator is not a statement: it is the item BEFORE
		# one, separated from it by the same `;` every pair of items is.
		if p_at(p, Kind.Hash) {
			p_stmt_decorator(p)
			p_stmt_sep(p, Kind.RBrace)
			continue
		}

		body.append(Stmt.SAt(t.line, t.col))
		body.append(parse_stmt(p))
		p_stmt_sep(p, Kind.RBrace)
	}
	expect(p, Kind.RBrace)
	p_shallower(p)
	return body
}

# p_stmt_decorator reads the one decorator leading a statement and turns away every decorator
# that is not about one.
#
# The compiler KEEPS NOTHING: the only decorator a statement takes is `#[allow(…)]`, which is
# the linter's and means nothing here (parse_deco_item). So a decorator that put a name on
# `pending` is one about a DECLARATION, and there is no declaration inside a body for it to be
# about.
#
# The sentence is its own rather than E487's, and the difference is what the reader is standing
# in front of. E487 is raised where declarations live and can say which declaration the
# decorator wanted; here there are none, so the useful thing to say is which decorator a
# statement DOES take.
fn p_stmt_decorator(mut &p: Parser) {
	t := cur(p)
	mut pending: list[str] = []
	parse_decorator(p, pending)

	raise p_diag_at(p, t.line, t.col, "E612", f"`{p_deco_says(pending[0])}` applies to the {p_deco_leads(pending)} that follows it, and a statement is not one — the decorator a STATEMENT takes is `#[allow(…)]`, which suppresses a lint finding over it") if pending.len() > 0
}

# --- statements ----------------------------------------------------------------

# p_starts_destructure reports whether the statement beginning here is a destructuring
# form: a `(` — optionally after `mut` or `const` — whose group is followed by `:=` or `=`.
# A parenthesised EXPRESSION statement looks the same up to the closing paren, so the
# separator is what tells them apart.
#
# It answers WHICH of the two, and not merely "one of them", because they are two forms:
# `bind-target` (GRAMMAR#binding) and `assign-target` (GRAMMAR#assign-target) are separate
# productions, so each is a separate thing this compiler has not built and each owes its own
# sentence. One answer for both meant the `=` spelling was turned away with the `:=` one's
# words — advice to write a binding, at a reader who had written an assignment.
#
#   0  not a destructuring statement
#   1  a destructuring BINDING, `(a, b) := e` / `mut (a, b) := e`
#   2  a destructuring ASSIGNMENT, `(a, b) = e`
fn p_starts_destructure(mut &p: Parser) -> int {
	mut i := p.pos
	if p.toks[i].kind == Kind.Mut or p.toks[i].kind == Kind.Const {
		i = i + 1
	}
	return 0 if i >= p.toks.len() or p.toks[i].kind != Kind.LParen

	mut depth := 0
	for i < p.toks.len() {
		k := p.toks[i].kind
		if k == Kind.LParen {
			depth = depth + 1
		} else if k == Kind.RParen {
			depth = depth - 1
			if depth == 0 {
				nxt := p.toks[i + 1].kind

				return 1 if nxt == Kind.Walrus
				return 2 if nxt == Kind.Assign

				return 0
			}
		} else if k == Kind.Semi or k == Kind.Eof {
			return 0
		}
		i = i + 1
	}
	return 0
}

# parse_stmt reads one statement, and it is a wrapper because a statement is where an
# expression tree ENDS: the block inside a `guard`, a closure's body, and the jump after
# `??` are all statements written INSIDE an expression, and each of their expressions is a
# root of its own — expr_parts stops at a block for that reason. Zeroing the counter here
# is what makes p_expr_root's "outermost expression" true at every altitude.
fn parse_stmt(mut &p: Parser) -> Stmt {
	outer := p.edepth
	p.edepth = 0
	s := parse_stmt_node(p)
	p.edepth = outer
	return s
}

fn parse_stmt_node(mut &p: Parser) -> Stmt {
	k := cur_kind(p)

	# A bare `{ … }` is a NESTED SCOPE (GRAMMAR#compound-stmt — `compound-stmt ::= block`).
	# Reaching the expression parser instead, it was read as a map literal or as whatever its first
	# statement made of it, and the message named that.
	# A RESERVED WORD IN THE NAME SLOT is checked before the statement keywords below, or
	# the one that owns the keyword answers first: `print := 1` reached the `print`
	# statement arm, read `:= 1` as the thing to print, and reported it from the expression
	# fallback. A `:=` after any keyword is a binding somebody meant to write.
	# `:=` or `: T =` after something that is not a name. A RESERVED WORD is the case worth
	# naming — `print := 1` reached the `print` statement arm, read `:= 1` as the thing to
	# print, and was reported from the expression fallback — but `5 := 1` is not a reserved
	# word and calling it one is a sentence the reader cannot act on. Both spellings are
	# checked, since only the walrus one used to be and the two diverged.
	if k != Kind.Ident and (peek_kind(p, 1) == Kind.Walrus or (peek_kind(p, 1) == Kind.Colon and is_stmt_kw(k))) {
		raise p_diag(p, "E257", f"`{cur(p).lexeme}` is a reserved word and cannot name a binding") if lookup_keyword(cur(p).lexeme) != Kind.Ident
		raise p_not_a_name(p, "a binding")
	}

	# A BARE BLOCK AS A STATEMENT (GRAMMAR#compound-stmt). It opens a scope and nothing else,
	# which is the whole point of writing one: what is bound in it ends at its `}`, and the
	# emitter's c_block already gives every block a fresh scope id, a mark and an unwind.
	#
	# The refusal that stood here said this compiler gives every binding the enclosing
	# FUNCTION's scope. That stopped being true when scope ids and the release registry
	# landed; nothing had asked it since, because no form could produce the node.
	return Stmt.SScope(parse_block(p)) if k == Kind.LBrace

	# `P{x} := p` — a STRUCT PATTERN in binding position (GRAMMAR#bind-target). The `{` after
	# a type name reached the expression parser, which reported a block used as an expression.
	#
	# A TUPLE pattern is the same form one bracket over: `(a, b) := f()` read as a tuple
	# EXPRESSION, so the names in it came out undefined rather than bound.
	raise p_diag(p, "E221", f"NotImplemented: a struct pattern `{cur(p).lexeme}{{…}}` — this compiler destructures with field access, not with a pattern") if k == Kind.Ident and is_pascal(cur(p).lexeme) and peek_kind(p, 1) == Kind.LBrace

	# A DESTRUCTURING BINDING OR ASSIGNMENT — `(a, b) := e`, `mut (a, b) := e`, `(a, b) = e`
	# (GRAMMAR#binding, GRAMMAR#bind-target, GRAMMAR#assign-target). It is named HERE, where the
	# token of a statement, because each spelling failed differently otherwise: the `:=` one
	# reached the expression fallback and was named after its walrus, the `mut` one reported
	# `expected `:`, found `a``, and the `=` one BUILT AND DID NOTHING — the tuple was
	# evaluated, assigned to no one, and the program printed the values it started with.
	# THE `=` SPELLING IS ITS OWN FORM, and it used to borrow this sentence — so a reader who
	# wrote `(a, b) = (1, 2)` was told about `(a, b) := …`, a form they had not written and a
	# `:=` their source does not contain. GRAMMAR derives them as two productions and each is
	# separately unbuilt; the place is the statement's own token, which neither carried.
	dtor := p_starts_destructure(p)

	raise p_diag_at(p, cur(p).line, cur(p).col, "E238", "NotImplemented: a destructuring binding `(a, b) := …` — GRAMMAR#bind-target derives the tuple form, and this compiler binds one name at a time") if dtor == 1
	raise p_diag_at(p, cur(p).line, cur(p).col, "E486", "NotImplemented: a destructuring assignment `(a, b) = …` — GRAMMAR#assign-target derives the tuple form, and this compiler assigns to one target at a time; write the two assignments out, reading the tuple with `.0` and `.1`") if dtor == 2

	if k == Kind.Nop {
		p_advance(p)
		return Stmt.SNop
	}
	if k == Kind.Print {
		p_advance(p)
		return Stmt.SPrint(parse_expr(p))
	}
	if k == Kind.Raise {
		p_advance(p)

		e := parse_expr(p)

		# `from cause` records the cause as the new Err's `unwrap()` (GRAMMAR#raise). It was
		# never read here: `parse_expr` stopped at the `from`, and the rest of the line was
		# skipped by parse_stmt's fallback — so the cause was DROPPED, silently, and the
		# chain a `guard` reads back had a link missing.
		mut cause := Expr.ENil
		mut has_cause := false
		if p_at(p, Kind.From) {
			p_advance(p)
			cause = parse_expr(p)
			has_cause = true
		}

		# `raise e if c` — the postfix guard, on the fourth of GRAMMAR's diverges. It reads as
		# the same sugar the other three carry and is desugared into exactly the block form it
		# is defined as (`if c { raise e }`), so the emitter needs to know nothing about it.
		return parse_jump_guard(p, Stmt.SRaise(e, has_cause, cause))
	}
	return parse_return(p) if k == Kind.Return
	if k == Kind.Break {
		p_advance(p)
		return parse_jump_guard(p, Stmt.SBreak)
	}
	if k == Kind.Continue {
		p_advance(p)
		return parse_jump_guard(p, Stmt.SContinue)
	}

	return parse_if(p) if k == Kind.If
	return parse_for(p) if k == Kind.For

	# The forms below parse to NOTHING today. Each was silently dropped: `spawn f()` ran
	# f() inline, `with`/`del` vanished, a `select` block's arms were read as loose
	# statements. Refusing by name is the least a compiler owes a program it cannot build.
	if k == Kind.Spawn {
		p_advance(p)
		return Stmt.SSpawn(parse_expr(p))
	}

	return parse_select(p) if k == Kind.Select
	return parse_with(p) if k == Kind.With

	if k == Kind.Del {
		p_advance(p)
		name := p_name(p, "a `del`")
		return Stmt.SDel(name)
	}
	return parse_close(p, false) if k == Kind.Close
	if k == Kind.Defer {
		p_advance(p)

		# `defer close(ch)` — the one statement `defer` takes besides a call, because
		# `close` is a keyword and its argument is a channel rather than a callee. Every
		# other deferred form is an expression and goes through parse_expr below.
		return parse_close(p, true) if p_at(p, Kind.Close)
		return Stmt.SDefer(parse_expr(p))
	}
	if k == Kind.Mut {
		p_advance(p)
		return parse_binding(p, true, false)
	}
	if k == Kind.Const {
		p_advance(p)
		return parse_binding(p, false, true)
	}

	# A BINDING is `name := …` or `name: T = …`, and it is recognised by that shape — so a
	# RESERVED WORD in the name slot did not match, fell through every arm below, and was
	# reported from the expression fallback as `` `:=` is not an expression``: the token
	# after the name rather than the reserved word in it. `print := 1` and `this := 1` both
	# arrived that way. Reaching parse_binding is what puts them in front of `p_name`.
	return parse_binding(p, false, false) if peek_kind(p, 1) == Kind.Walrus or (peek_kind(p, 1) == Kind.Colon and k != Kind.Ident)
	return parse_binding(p, false, false) if k == Kind.Ident and peek_kind(p, 1) == Kind.Colon

	# expression statement or reassignment (the target may be a name, field, or index)
	e := parse_expr(p)
	if p_at(p, Kind.LArrow) {
		# `ch <- v` sends. It is a STATEMENT, not an expression: GRAMMAR gives it no
		# value, which is also what tells it from the prefix receive.
		p_advance(p)
		return Stmt.SSend(e, parse_expr(p))
	}
	if p_at(p, Kind.Assign) {
		p_advance(p)
		return Stmt.SAssign(e, parse_expr(p))
	}
	return Stmt.SExpr(e)
}

# parse_binding parses `name := e` (inferred) or `name: T = e` (typed). A `const` still
# lowers to a plain immutable C local, but its const-ness RIDES on the node now: `const`
# marks a shadow-proof binding (GRAMMAR group 4), and folding the keyword away here was
# why nothing downstream could enforce that.
fn parse_binding(mut &p: Parser, is_mut: bool, is_const: bool) -> Stmt {
	# the last naming position that still read whatever token was there: `print := 1` and
	# `this := 1` were carried past and reported from the expression fallback, as `` `:=` is
	# not an expression`` — the token after the name rather than the reserved word in it.
	name := p_name(p, "a binding")
	if p_at(p, Kind.Walrus) {
		p_advance(p)
		return Stmt.SLet(name, Ty.TUnknown, false, is_mut, is_const, parse_expr(p))
	}
	expect(p, Kind.Colon)
	ty := parse_type(p)
	expect(p, Kind.Assign)
	return Stmt.SLet(name, ty, true, is_mut, is_const, parse_expr(p))
}

# parse_jump_guard reads the optional trailing `if cond` on a `break` or a `continue` —
# the same postfix `if` a conditional return takes (GRAMMAR group 6) — and desugars it
# into the `if cond { jump }` it is defined as. Going through the block form means the
# emitter needs to know nothing about it.
#
# Without this the `if` was left for the next statement to read, so `break if c` broke
# unconditionally and the condition became a dangling if with no block. Silently.
fn parse_jump_guard(mut &p: Parser, jump: Stmt) -> Stmt {
	return jump if not p_at(p, Kind.If)
	p_advance(p)
	mut body: list[Stmt] = []
	body.append(jump)
	mut none: list[Stmt] = []
	return Stmt.SIf(parse_expr(p), body, false, none)
}

# p_if_has_block reports whether the `if` beginning at `at` has a BLOCK after its
# condition — which is what makes it an if-EXPRESSION rather than a postfix `if` on a jump
# (GRAMMAR#return's disambiguation). It reads without consuming.
#
# A `{` inside a `(` or a `[` belongs to something else, so the scan is depth-aware; the
# statement's own end is where it gives up, since a conditional return has nothing after
# its condition.
#
# desugar.zg's dsg_if_has_block asks this same question and stays a second function on
# purpose. It runs BEFORE any parse, over a token stream whose statement end dsg_stmt_end
# has already found; this one has the Parser's cursor and nothing else, so it must stop
# itself at the separator. Folding them together would hand one of the two a bound it does
# not have.
fn p_if_has_block(mut &p: Parser, at: int) -> bool {
	mut depth := 0
	mut i := at
	for i < p.toks.len() {
		k := p.toks[i].kind
		return false if (k == Kind.Semi or k == Kind.Eof) and depth == 0
		if k == Kind.LParen or k == Kind.LBrack {
			depth = depth + 1
		} else if k == Kind.RParen or k == Kind.RBrack {
			depth = depth - 1
		} else if k == Kind.LBrace and depth == 0 {
			return true
		}
		i = i + 1
	}
	return false
}

fn parse_return(mut &p: Parser) -> Stmt {
	p_advance(p) # 'return'
	return Stmt.SReturn(false, Expr.ENil) if p_at(p, Kind.Semi) or p_at(p, Kind.RBrace) or p_at(p, Kind.Eof)

	# `return if c` — a bare early exit under a guard. It is desugared here into the
	# `if c { return }` it is defined as, because SReturnIf carries a VALUE and a bare
	# return has none; going through the block form means the emitter needs to know
	# nothing about it. Without this the `if` fell through to parse_expr and was read as an
	# if-EXPRESSION with no block, which swallowed the rest of the function — silently, and
	# only where the formatter had just produced the form.
	if p_at(p, Kind.If) {
		# THE ONE AMBIGUITY, which GRAMMAR#return spells out: "a leading `if` whose condition
		# is followed by a `{` block is instead an if-EXPRESSION being returned; the
		# conditional-return `if` takes a bare condition and NO block." Nothing here looked
		# past the condition, so `return if c { 1 } else { 2 }` was always the bare early exit
		# under `c`, and the `{ 1 } else { 2 }` left over became whatever the statement loop
		# could make of it.
		return Stmt.SReturn(true, parse_expr(p)) if p_if_has_block(p, p.pos + 1)

		p_advance(p)
		mut body: list[Stmt] = []
		body.append(Stmt.SReturn(false, Expr.ENil))
		mut none: list[Stmt] = []
		return Stmt.SIf(parse_expr(p), body, false, none)
	}
	e := parse_expr(p)
	if p_at(p, Kind.If) {
		p_advance(p)
		return Stmt.SReturnIf(e, parse_expr(p))
	}
	return Stmt.SReturn(true, e)
}

fn parse_if(mut &p: Parser) -> Stmt {
	p_advance(p) # 'if'
	p_no_brace_head(p, "an `if` head", false)

	# `if v := e { … }` — the binding form. It is told from an ordinary condition by the
	# `:=` alone, one token of lookahead, because no condition may contain one. Without
	# this the `:=` was read as the start of a second expression and the rest of the
	# function came apart, silently.
	if p_names_here(p, p.pos) and peek_kind(p, 1) == Kind.Walrus {
		name := p_name(p, "an `if let` binding")
		p_advance(p) # ':='
		value := parse_expr(p)
		then_body := parse_block(p)
		mut has_else_l := false
		mut else_body_l: list[Stmt] = []
		if p_at(p, Kind.Else) {
			p_advance(p)
			has_else_l = true
			else_body_l = p_else_body(p)
		}
		return Stmt.SIfLet(name, value, then_body, has_else_l, else_body_l)
	}

	cond := parse_expr(p)
	then_body := parse_block(p)
	mut has_else := false
	mut else_body: list[Stmt] = []
	if p_at(p, Kind.Else) {
		p_advance(p)
		has_else = true
		else_body = p_else_body(p)
	}
	return Stmt.SIf(cond, then_body, has_else, else_body)
}

# p_else_body reads what follows an `else`, for BOTH `if` forms — the plain one and
# `if let`. It was written out twice, four identical lines each, and there is exactly one
# rule in it: `else if` is a single nested if statement rather than a block.
#
# That recursion opens no block, so the chain's depth is counted here or nowhere — a
# thousand `else if` in one chain killed the parser the same way a thousand parentheses
# did, and parse_block never sees them.
fn p_else_body(mut &p: Parser) -> list[Stmt] {
	return parse_block(p) if not p_at(p, Kind.If)

	mut body: list[Stmt] = []
	p_deeper(p)

	# the marker parse_block would have stamped, stamped here for the same reason: this
	# recursion opens no block, so the nested `if` is the ONE statement in the program that
	# reached the emitter with no position of its own, and a diagnostic about its HEAD —
	# `else if zzz > 0`, `else if x > 0` naming an if-let binding that has just gone out of
	# scope — was reported against whatever statement spoke last, which is the closing line
	# of the branch above it.
	t := cur(p)
	body.append(Stmt.SAt(t.line, t.col))

	body.append(parse_if(p))
	p_shallower(p)
	return body
}

fn parse_for(mut &p: Parser) -> Stmt {
	p_advance(p) # 'for'

	# The head is OPTIONAL here, so a leading `{` is the infinite loop's BODY — unless
	# something past its matching `}` continues it as an expression, which is the one
	# reading under which it was a head. That check goes first: taken as a body, the head
	# `{"a": 1}.len() == 1` was parsed as a block and complained about its first entry.
	p_no_brace_head(p, "a `for` head", true)
	return Stmt.SFor(false, Expr.ENil, parse_block(p)) if p_at(p, Kind.LBrace)

	# `for select { … }` — one ready arm per round, until every watched channel has ended.
	# A condition cannot begin with `select`, so one token of lookahead separates it from
	# `for <cond> { … }` with no ambiguity at all.
	if p_at(p, Kind.Select) {
		p_advance(p) # 'select'
		return Stmt.SForSelect(parse_sel_arms(p))
	}

	# `for mut v in xs` binds the element MUTABLY and writes the edit back to its slot
	# (GRAMMAR#for-stmt). The `mut` was not read here, so it fell into the condition expression
	# and was reported as whatever that made of it.
	raise p_diag(p, "E242", "NotImplemented: `for mut v in …` — the mutable loop binding writes each edited element back to its slot, which this compiler does not do") if p_at(p, Kind.Mut)

	# for-in: `for name in iterable { ... }`
	if p_names_here(p, p.pos) and peek_kind(p, 1) == Kind.In {
		vname := p_name(p, "a loop binding")
		p_advance(p) # 'in'
		iter := parse_expr(p)
		return Stmt.SForIn(vname, iter, parse_block(p))
	}
	cond := parse_expr(p)
	body := parse_block(p)
	return Stmt.SFor(true, cond, body)
}

# --- expressions ---------------------------------------------------------------

fn is_add_op(k: Kind) -> bool {
	return k == Kind.Plus or k == Kind.Minus or k == Kind.Pipe or k == Kind.Caret or k == Kind.PlusMod or k == Kind.MinusMod
}

fn is_mul_op(k: Kind) -> bool {
	return k == Kind.Star or k == Kind.Slash or k == Kind.SlashDiv or k == Kind.Percent or k == Kind.StarMod or k == Kind.Shl or k == Kind.Shr or k == Kind.Amp
}

fn is_cmp_op(k: Kind) -> bool {
	return k == Kind.EqEq or k == Kind.Ne or k == Kind.Lt or k == Kind.Gt or k == Kind.Le or k == Kind.Ge
}

fn is_unary_op(k: Kind) -> bool {
	return k == Kind.Minus or k == Kind.Not or k == Kind.Tilde or k == Kind.MinusMod
}

# parse_expr is where every nested expression re-enters the parser — a parenthesized
# group, a call's argument, a list's element, an index — so it is where a nesting level is
# counted. The ladder below it is not: one pass through coalesce → or → … → primary is one
# level of the program, however many functions it takes.
fn parse_expr(mut &p: Parser) -> Expr {
	p_deeper(p)
	t := cur(p)
	p.edepth = p.edepth + 1
	e := parse_coalesce(p)
	p.edepth = p.edepth - 1

	# the outermost expression of a statement is the whole tree, so it is measured here
	# and once — see p_expr_root for why the parser's own counter cannot see it. The place
	# is the expression's FIRST token, not the one the reader stopped on: what is too deep
	# is what starts here.
	if p.edepth == 0 {
		p_expr_root(p, e, t.line, t.col)
	}
	p_shallower(p)
	return e
}

# parse_coalesce reads `a ?? b`, the OUTERMOST binary level. It sits there because its
# right-hand side may be a DIVERGENT STATEMENT — the spec drains a channel with
# `for { v := <-ch ?? break }` — and a statement cannot be an operand of anything, so no
# level can sit outside it. GRAMMAR makes it the loosest binary, and RIGHT-ASSOCIATIVE.
#
# The recursion is that associativity, and it is not cosmetic. Read left-to-right,
# `a ?? b ?? 7` groups as `(a ?? b) ?? 7`, whose left operand is a fallback that may itself
# be absent — so the inner ternary had to yield a bare value and an optional at once, and
# the C it emitted did not compile. Grouped right, each `??` peels exactly one layer:
# `b ?? 7` is a value, and `a ?? that` is a value.
fn parse_coalesce(mut &p: Parser) -> Expr {
	left := parse_or(p)
	return left if not p_at(p, Kind.Coalesce)
	p_advance(p)
	mut jump: list[Stmt] = []
	if is_divergent(cur_kind(p)) {
		# What GRAMMAR#coalesce-rhs takes here is the bare DIVERGE, and the postfix `if`
		# guard belongs to the statement form beside it (GRAMMAR#raise-stmt). parse_stmt
		# reads the statement form — one reader for `raise e from c`, and for the `return`
		# whose leading `if` may be an if-expression — so what it comes back with has to be
		# asked whether a guard was folded in, and refused when one was.
		#
		# UNDEFINED BEHAVIOUR FROM SAFE CODE is what accepting it produced. c_coalesce
		# emits the divergent form as a temp assigned on the present branch and a statement
		# on the other, because a diverge LEAVES and so needs no value; under a guard it
		# does not leave, the `else` assigns nothing, and `q := p ?? raise Err("x") if
		# false` read the temp uninitialised. There is no lowering to reach for — the form
		# has no meaning to lower — so it is named here, before a tree exists to miscompile.
		t := cur(p)
		s := parse_stmt(p)
		raise p_diag_at(p, t.line, t.col, "E284", f"a `??` right-hand `{t.lexeme}` takes no trailing `if` — the postfix guard belongs to the STATEMENT form of a diverge (GRAMMAR#raise-stmt), and written here it reads as the coalesce's condition rather than the `{t.lexeme}`'s: when it is false nothing diverges, and the `??` still owes the value it never produced. Guard the whole statement instead, or bind the coalesce first and guard what follows it") if p_jump_is_guarded(s)
		jump.append(s)
		return Expr.ECoalesce(left, Expr.ENil, jump)
	}

	# the right-associative recursion is a nesting level of its own, so it re-enters
	# through parse_expr — the one door that counts a level — rather than wrapping
	# p_deeper by hand around a recursion parse_expr already spells
	return Expr.ECoalesce(left, parse_expr(p), jump)
}

# is_divergent names the statements that LEAVE, which are the ones `??` may take on its
# right: after one of them there is no value to have produced, which is exactly why they
# are allowed where an expression is otherwise required.
fn is_divergent(k: Kind) -> bool {
	return k == Kind.Break or k == Kind.Continue or k == Kind.Return or k == Kind.Raise
}

# p_jump_is_guarded reports whether the statement parse_coalesce just read for a `??`'s
# right side came back WRAPPED IN A GUARD.
#
# It asks the SHAPE rather than looking ahead for an `if` token, because the token alone
# cannot tell the two readings apart: `?? return if c { 1 } else { 2 }` returns an
# if-EXPRESSION and is well-formed, while `?? return 7 if c` is the guard, and both put an
# `if` in the same place. parse_return has already made that decision (p_if_has_block), so
# reading its answer is what keeps the disambiguation in ONE place.
#
# ONE RULE, THREE SLOTS. The guard is folded in at three points and this covers all of
# them: parse_jump_guard wraps `break`/`continue`/`raise` in an SIf, parse_return desugars
# a bare `return if c` into the same, and `return e if c` becomes an SReturnIf. Entering
# with one of the four diverge keywords, neither shape can be reached any other way — so
# either one back from that call is a guard, and a rule written against parse_jump_guard
# alone would have left the two return branches compiling.
fn p_jump_is_guarded(s: Stmt) -> bool {
	return match s {
		Stmt.SIf(_, _, _, _) => true
		Stmt.SReturnIf(_, _) => true
		_ => false
	}
}

fn parse_or(mut &p: Parser) -> Expr {
	mut left := parse_and(p)
	for p_at(p, Kind.Or) {
		p_advance(p)
		left = Expr.EBinary("or", left, parse_and(p))
	}
	return left
}

fn parse_and(mut &p: Parser) -> Expr {
	mut left := parse_cmp(p)
	for p_at(p, Kind.And) {
		p_advance(p)
		left = Expr.EBinary("and", left, parse_cmp(p))
	}
	return left
}

# parse_cmp is non-associative: at most one comparison operator, or one `is` type test
# (GRAMMAR#cmp-expr puts the two at the same level and allows only one of them).
fn parse_cmp(mut &p: Parser) -> Expr {
	left := parse_range(p)
	if is_cmp_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		return Expr.EBinary(op, left, parse_range(p))
	}
	if p_at(p, Kind.Is) {
		p_advance(p)

		# The right side is a bare name, not an expression: reading it as one would make
		# `e is StopIteration` an ident lookup for a name nothing declares. Refusing here
		# is what keeps a malformed test from reaching the emitter as something else.
		raise p_diag(p, "E604", f"`is` wants a type name on its right, found `{cur(p).lexeme}`") if not p_at(p, Kind.Ident)
		name := cur(p).lexeme
		p_advance(p)
		return Expr.EIs(left, name)
	}

	# `in` takes an EXPRESSION on its right where `is` takes a name, and that is the difference
	# between the two: `is` asks what something IS and names a type, `in` asks what something is
	# a MEMBER of and names a set. parse_range, not parse_add, so `v in 0..10` reads as
	# `v in (0..10)` — which is the reading the range level exists to give.
	if p_at(p, Kind.In) {
		p_advance(p)
		return Expr.EIn(left, parse_range(p))
	}
	return left
}

# parse_range reads `a..b` and `a..=b`. GRAMMAR puts this level between comparison and
# addition, which is what makes `v in 0..10` read as `v in (0..10)` rather than
# `(v in 0)..10` — the bound is an add-expr, so arithmetic inside it needs no parentheses.
fn parse_range(mut &p: Parser) -> Expr {
	lo := parse_add(p)
	k := cur_kind(p)
	return lo if k != Kind.DotDot and k != Kind.DotDotEq
	p_advance(p)

	# `500..` — GRAMMAR makes the upper bound optional after `..`, and what tells "there is no
	# bound" from "the bound follows" is whether the next token could begin one. Without this
	# the guard of `500.. if c =>` was read AS the bound, since an if-expression is a legal
	# bound expression, and the arm silently tested `n < (c ? … : …)`.
	return Expr.ERange(lo, Expr.ENil, false) if k == Kind.DotDot and no_bound_follows(cur_kind(p))
	return Expr.ERange(lo, parse_add(p), k == Kind.DotDotEq)
}

fn parse_add(mut &p: Parser) -> Expr {
	mut left := parse_mul(p)
	for is_add_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		left = Expr.EBinary(op, left, parse_mul(p))
	}
	return left
}

fn parse_mul(mut &p: Parser) -> Expr {
	mut left := parse_try(p)
	for is_mul_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		left = Expr.EBinary(op, left, parse_try(p))
	}
	return left
}

# parse_try reads the postfix `!` (and refuses the postfix `?`). It sits OUTSIDE
# parse_unary rather than inside parse_postfix, and that placement is the whole point:
# the spec writes `v := <-ch!`, meaning "force the Result this receive produced". Read
# inside parse_postfix the `!` would bind to `ch` and give `ERecv(EForce(ch))` — forcing
# the CHANNEL, which is not a Result at all. Out here it gives `EForce(ERecv(ch))`.
#
# `?` is refused rather than lowered. It early-returns the Right from the enclosing
# function, so it needs a signature that can carry one, and signatures still erase
# `Result[T]`. Until then it must say so: it used to fall off the end of parse_primary
# and emit a dead `0;`, which is a wrong program that compiles.
fn parse_try(mut &p: Parser) -> Expr {
	mut e := parse_unary(p)
	for p_at(p, Kind.Bang) or p_at(p, Kind.Question) {
		if p_at(p, Kind.Question) {
			# `x?` is built rather than refused here: whether it CAN be written depends on the
			# enclosing function's result type, which the parser does not know. The emitter
			# does, and refuses by name there.
			p_advance(p)
			e = parse_chain_tail(p, Expr.ETry(e))
			continue
		}
		p_advance(p)
		e = Expr.EForce(e)

		# What follows a `!` belongs to the value it produced. `(<-ch)![0]` indexes the list
		# the receive answered with, and `(<-ch)!.field` reads a field of it — the receive-
		# and-force idiom the chapter is written in, applied to a payload that is not a
		# scalar. Because the `!` level sits above parse_postfix, the chain had already been
		# read and finished, so the `[0]` was simply DROPPED: the emitted C printed the whole
		# list and only cc objected, against generated code.
		e = parse_chain_tail(p, e)
	}
	return e
}

# parse_chain_tail continues a postfix chain on an expression that is already built: a
# field, a method call, an index. A bare `(` is deliberately not here — a free call needs
# an identifier for its name, and the thing to the left of one of these is a value.
fn parse_chain_tail(mut &p: Parser, e0: Expr) -> Expr {
	mut e := e0
	for p_at(p, Kind.Dot) or p_at(p, Kind.LBrack) or p_at(p, Kind.OptDot) {
		if p_at(p, Kind.OptDot) {
			p_advance(p)
			fld := p_field_name(p, "?.", false)
			e = Expr.EOptChain(e, fld)
		} else if p_at(p, Kind.LBrack) {
			p_advance(p) # '['
			idx := parse_expr(p)
			expect(p, Kind.RBrack)
			e = Expr.EIndex(e, idx)
		} else {
			p_advance(p) # '.'
			fld := p_field_name(p, ".", true)
			if p_at(p, Kind.LParen) {
				e = Expr.EMethod(e, fld, parse_call_args(p))
			} else {
				e = Expr.EField(e, fld)
			}
		}
	}
	return e
}

fn parse_unary(mut &p: Parser) -> Expr {
	# `<-ch` receives. GRAMMAR gives it its own level (recv-base) so `<-a.b` reads as
	# `<-(a.b)` and a chain of them nests, which is what recursing here gives. The
	# recursion is a nesting level and is counted as one: a run of prefixes is written
	# without a single bracket, so nothing else on the way down would.
	if p_at(p, Kind.LArrow) {
		p_advance(p)
		p_deeper(p)
		e := Expr.ERecv(parse_unary(p))
		p_shallower(p)
		return e
	}

	# A UNARY OPERATOR'S OPERAND INCLUDES THE GROUP-8 POSTFIXES: GRAMMAR is
	# `unary-expr ::= unary-op unary-expr | postfix-expr` with `?`, `!` and `?.` among the
	# postfixes, so `-x!` is `-(x!)`. The operand was read with parse_unary, one level short of
	# parse_try — which sits ABOVE this level deliberately, so that `<-ch!` forces what the
	# receive answered rather than the channel. The `!` therefore landed on the NEGATION's
	# result, and `-x!` on an `int?` answered "operator `-` takes a numeric operand, and this
	# one is int?", about an operand the program never wrote that way.
	#
	# Only THIS operand moves up to parse_try. The receive above keeps parse_unary, which is
	# what leaves the `!` outside for parse_try to put around the ERecv.
	if is_unary_op(cur_kind(p)) {
		op := kind_name(cur_kind(p))
		p_advance(p)
		p_deeper(p)
		e := Expr.EUnary(op, parse_try(p))
		p_shallower(p)
		return e
	}
	return parse_postfix(p)
}

# index_base_name / index_type_name take an `EIndex` apart for the one shape that is not a
# subscript: `id[int]` as the callee of a call. Both answer "" for anything else, which is
# what leaves every other indexed callee refused by name.
fn index_base_name(e: Expr) -> str {
	return match e {
		Expr.EIndex(b, _) => ident_name(b)
		_ => ""
	}
}

fn index_type_name(e: Expr) -> str {
	return match e {
		Expr.EIndex(_, i) => ident_name(i)
		_ => ""
	}
}

# p_ty_of_name is a written type argument as a type. A scalar goes through the conversion
# table the parser already has; anything else is a declared name, and whether such a type
# exists is the instantiation's question rather than this one's.
fn p_ty_of_name(nm: str) -> Ty {
	return conv_ty(nm) if is_conv(nm)

	return Ty.TNamed(nm)
}

# p_field_name reads the selector a postfix `.` or `?.` takes, and it is ONE function for
# the same reason p_one_tuple above is: four sites read one — `.` and `?.`, each of them in
# parse_postfix and again in parse_chain_tail — and a rule written at one of four slots is
# the shape of bug that keeps being found here.
#
# All four used to take `cur(p).lexeme` and advance, whatever token was sitting there, so
# GRAMMAR#postfix — `'.' identifier`, `'.' dec-int`, `'?.' identifier` — described a surface
# the parser did not have. What happened to the rest was NOT a parse error: `x.if` became a
# field access whose field is named `if`, and the CHECKER answered it, ``E376 no field `if`
# on int`` — a sentence about a field somebody might plausibly have declared, for a word
# GRAMMAR#keyword says in so many words can never be an identifier. Every declaring position
# already refuses one (E245, E257); this is the selecting position saying the same thing.
#
# The line-eating is the case that shows why it has to be caught HERE rather than downstream.
# A `.` suppresses ASI, so in
#
#     print 1.
#     print 2
#
# the second line's `print` was read as the field name of `1.`, the statement vanished, and
# what got reported was `2` — under E205, on a line with nothing wrong with it. By the time
# a field name is a string in an AST node, the token that was really the error is gone.
#
# `tuple_ok` is the difference between the two dots and it is GRAMMAR's: a tuple is read back
# by static index off `.` alone, and `?.` derives an identifier and nothing else.
fn p_field_name(mut &p: Parser, dot: str, tuple_ok: bool) -> str {
	t := cur(p)
	lx := t.lexeme

	raise p_diag_at(p, t.line, t.col, "E293", f"`{lx}` is a reserved word and cannot name a field") if p_reserved_word(lx)

	if not p_at(p, Kind.Ident) and not (tuple_ok and p_at(p, Kind.Int)) {
		mut want := "a field name"
		if tuple_ok {
			want = "a field name or a tuple index"
		}
		raise p_diag_at(p, t.line, t.col, "E294", f"expected {want} after `{dot}`, found `{lx}`")
	}

	p_advance(p)
	return lx
}

# parse_postfix parses a primary then a chain of calls. In the subset the callee is
# always a bare identifier, so a call collapses to ECall(name, args).
fn parse_postfix(mut &p: Parser) -> Expr {
	mut e := parse_primary(p)
	for p_at(p, Kind.LParen) or p_at(p, Kind.Dot) or p_at(p, Kind.LBrack) or p_at(p, Kind.OptDot) {
		if p_at(p, Kind.OptDot) {
			# `a?.b` — the lexer has produced this token since it existed and no parser ever
			# consumed it, so `x := p?.n` bound `p` and the `.n` was simply dropped.
			p_advance(p)
			fld := p_field_name(p, "?.", false)
			e = Expr.EOptChain(e, fld)
		} else if p_at(p, Kind.LBrack) {
			p_advance(p) # '['
			idx := parse_expr(p)

			# A COMMA MAKES IT TYPE ARGUMENTS, and nothing else it could be. GRAMMAR says so
			# outright — "'[X, Y]' is unambiguously type arguments (an index takes one value)"
			# — and this branch read one expression and demanded `]`, so `pairup[str, int](…)`
			# got "expected `]`, found `,`": the message a typo gets, for the one bracket form
			# the grammar calls unambiguous.
			#
			# The SINGLE-argument case is not decided here. `f[T](x)` and `xs[i]` are the same
			# tokens and telling them apart needs to know what the base is, so it stays where
			# it was — recovered from the EIndex below, where a call has been seen.
			# ASSIGNED, not returned: a call is a postfix like any other, and the chain goes on
			# after it. Returning here ended the loop, so `pair[int, str](7, "a").len()` died
			# on "`.` is not an expression this compiler reads" — the same shape of message
			# this branch exists to remove, one postfix further along.
			if p_at(p, Kind.Comma) {
				e = p_type_arg_call(p, e, idx)
			} else {
				expect(p, Kind.RBrack)
				e = Expr.EIndex(e, idx)
			}
		} else if p_at(p, Kind.Dot) {
			p_advance(p)
			fld := p_field_name(p, ".", true)
			if p_at(p, Kind.LParen) {
				# method call: target.method(args)
				e = Expr.EMethod(e, fld, parse_call_args(p))
			} else {
				e = Expr.EField(e, fld)
			}
		} else {
			# free call: name(args), or a scalar type conversion like int(x)
			mut name := ident_name(e)

			# A CALLEE THAT IS NOT A NAME. Three forms reach here and all three used to be
			# built as `ECall("", args)`, which the emitter reported as ``undefined function
			# ` ``` — an empty name, naming nothing, for a program with no typo in it:
			#
			#   f[T](x)    explicit type arguments (GRAMMAR#postfix, group 7)
			#   fs[0](x)   a call through a function VALUE held in a container
			#   p?.get()   an optional method call
			#
			# The shape is still in hand here, which is why the refusal belongs in the parser
			# rather than downstream of the name it threw away.
			# EXPLICIT TYPE ARGUMENTS ARE NOT A FORM. `id[int](7)` reaches here as an INDEX
			# of `id`, and the only way to tell that subscript from a type argument list is to
			# know what `id` is — which is a symbol table, in the parser, for one form.
			# GRAMMAR settled it the other way: a postfix `[ … ]` is ALWAYS an index, and a
			# generic call takes its type from its arguments.
			#
			# The shape is still in hand here, so this is where it is named. Downstream there
			# is only a name that was thrown away.
			mut tyargs: list[Ty] = []
			if name == "" {
				base := index_base_name(e)
				tn := index_type_name(e)
				if base != "" and tn != "" {
					p_written_type_args(p, base, tn)
				}
			}
			raise p_diag(p, "E222", f"NotImplemented: calling {expr_kind(e)} — a callee is a plain name in this compiler, so `fs[0](…)` (a function value in a container) and `p?.m(…)` (an optional method call) are unbuilt") if name == ""

			args := parse_call_args(p)
			if is_conv(name) {
				# A CONVERSION TAKES A VALUE. `int()` and `list[int]()` read as a call and
				# then indexed an empty argument list, so the COMPILER aborted with its own
				# `IndexError: index out of range` — no place, no form named, and a stack
				# trace of the compiler rather than a diagnostic about the program.
				raise p_diag(p, "E258", f"`{name}(…)` converts a VALUE and was given none — a conversion reads one thing as another, so there has to be a thing") if args.len() == 0
				raise p_diag(p, "E259", f"`{name}(…)` converts one value, and this gives {strconv.to_string(args.len(), 10)}") if args.len() > 1

				e = Expr.EConv(conv_ty(name), args[0], name)
			} else {
				e = Expr.ECall(name, args, tyargs)
			}
		}
	}
	return e
}

# p_type_arg_call is the MULTI-argument shape of a form the language does not have —
# `base[A, B](args)`, entered once a comma has settled that the bracket is not an index.
# `id[int](7)` is the one-argument shape, refused where the postfix loop recovers it; this
# is the same refusal for the shape that never looked like an index at all.
#
# GRAMMAR settled it: a postfix `[ … ]` is ALWAYS an index, and a generic call takes its
# type from its arguments. Telling the two apart in a parser needs to know what `base` is,
# which is a symbol table for one form.
fn p_type_arg_call(mut &p: Parser, base: Expr, first: Expr) -> Expr {
	name := ident_name(base)
	tn := ident_name(first)

	# A BUILT-IN TYPE is not a generic call. `map[K, V](…)` names a TYPE and its arguments
	# are the type's own, which is the one thing `[ … ]` after a name still means — so the
	# refusal it earns is the one about a constructor, downstream, and not this one.
	if not p_builtin_type_ctor(name) {
		p_written_type_args(p, name, tn + ", …")
	}

	# THE SEPARATOR AT THE TOP OF THE LOOP, because the first argument arrived as `first` and
	# there is no element below it to follow. It is the same rule and the same reader of it
	# (p_list_sep); this is the one call site with nowhere else to put the call.
	mut tyargs: list[Ty] = [p_ty_of_name(tn)]
	for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
		p_list_sep(p, Kind.RBrack, "]", "a type argument list")
		tyargs.append(parse_type(p))
	}
	expect(p, Kind.RBrack)
	raise p_diag(p, "E268", f"NotImplemented: `{name}[…]` with no call after it — this compiler instantiates a generic at the call, so its type arguments have to arrive with the arguments") if not p_at(p, Kind.LParen)

	return Expr.ECall(name, parse_call_args(p), tyargs)
}

# p_written_type_args is the one complaint both shapes earn. `id[int](7)` is recovered from
# an index in the postfix loop and `pairup[str, int](…)` never looked like one, but they are
# the same form and a code answers to a rule rather than to a shape.
fn p_written_type_args(mut &p: Parser, name: str, tn: str) {
	raise p_diag(p, "E275", f"`{name}[{tn}](…)` writes a call's type arguments, and a postfix `[ … ]` is an index — a generic takes its type from the arguments, so write `{name}(…)`")
}

# p_builtin_type_ctor names the built-in TYPES whose `[ … ]` is the type's own arguments
# rather than a call's. GRAMMAR#base-type gives them type-args; they are not generic
# functions and a program cannot declare one.
fn p_builtin_type_ctor(name: str) -> bool {
	return name == "map" or name == "set" or name == "list" or name == "chan" or name == "ptr" or name == "array"
}

fn parse_call_args(mut &p: Parser) -> list[Expr] {
	p_advance(p) # '('
	mut args: list[Expr] = []
	for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
		# A NAMED ARGUMENT — `f(loud: true)`, GRAMMAR#arg, and the sanctioned way to skip a
		# defaulted parameter in the middle (docs/code/functions.md). This compiler is
		# positional-only, and the `:` reached parse_primary, which answered "`:` is not an
		# expression this compiler reads" — a token, about a form the language specifies and
		# the seed builds. An argument list is where the form is recognizable.
		raise p_diag(p, "E223", f"NotImplemented: the named argument `{cur(p).lexeme}:` — this compiler binds arguments by position only") if p_at(p, Kind.Ident) and peek_kind(p, 1) == Kind.Colon

		args.append(parse_expr(p))
		p_list_sep(p, Kind.RParen, ")", "an argument list")
	}
	expect(p, Kind.RParen)
	return args
}

fn parse_primary(mut &p: Parser) -> Expr {
	t := cur(p)
	k := t.kind
	if k == Kind.Int {
		p_advance(p)
		return Expr.EInt(t.lexeme, t.line, t.col)
	}
	if k == Kind.Byte {
		# a byte literal `b'x'` is its code point AS A BYTE. It used to be a bare EInt, so it
		# inferred as `int` — and `c: byte = b'J'` was refused as "cannot bind int to a byte
		# binding", about the one literal in the language whose whole point is that it is a
		# byte. The conversion node is the type the emitter already knows how to carry, and
		# `byte(74)` has always worked; this is that, written the way a reader writes it.
		#
		# The VALUE arrives as the octet's decimal spelling, not the octet: re-reading the
		# byte out of the str here is what made `b'\x80'` impossible to lex at all, because
		# a str cannot hold the upper half of the range (scan_char_lit says why).
		p_advance(p)
		return Expr.EConv(Ty.TByte, Expr.EInt(t.value, t.line, t.col), "byte")
	}
	if k == Kind.Rune {
		p_advance(p)

		# The literal's VALUE is its code point, and it arrives as the point's decimal
		# spelling — decoded by the lexer beside int_value, for the reason that one gives:
		# what a lexeme is worth is a fact about the LEXEME. Decoding it HERE, from a str
		# re-read out of the token, is what made `'\0'` impossible to lex at all, because a
		# str cannot hold a NUL (scan_char_lit says why).
		return Expr.EConv(Ty.TRune, Expr.EInt(t.value, t.line, t.col), "rune")
	}
	if k == Kind.Float {
		p_advance(p)
		return Expr.EFloat(t.lexeme)
	}
	if k == Kind.Str or k == Kind.RawStr {
		# a raw string differs from a plain one only in what the LEXER did with the
		# backslashes; by here both carry their text in `value`
		p_advance(p)
		return Expr.EStr(t.value)
	}
	if k == Kind.FStr {
		p_advance(p)
		return fstr_expr(p, t)
	}
	if k == Kind.True {
		p_advance(p)
		return Expr.EBool(true)
	}
	if k == Kind.False {
		p_advance(p)
		return Expr.EBool(false)
	}
	if k == Kind.Nil {
		p_advance(p)
		return Expr.ENil
	}
	if k == Kind.KwThis {
		# the receiver reads as an ordinary binding, because the parser made it one
		p_advance(p)
		return Expr.EIdent("this")
	}

	# The INTERPOLATING form, `` f`…` ``, lexes as a bare `f` and then the command literal,
	# so the parser saw a call with a stray token after it and said `expected `)`, found
	# ``echo {n}```. GRAMMAR#fcmd-lit makes it a form of its own — one that runs through a shell
	# and shell-quotes each hole — and it is refused as one.
	raise p_diag(p, "E235", "NotImplemented: an interpolating command literal — " + p.toks[p.pos + 1].lexeme) if k == Kind.Ident and t.lexeme == "f" and peek_kind(p, 1) == Kind.Cmd

	if k == Kind.Ident {
		# list[T](x) — a list-type conversion (e.g. bytearray(s))
		if t.lexeme == "list" and peek_kind(p, 1) == Kind.LBrack {
			p_advance(p) # 'list'
			p_advance(p) # '['
			elem := parse_type(p)
			expect(p, Kind.RBrack)
			args := parse_call_args(p)

			raise p_diag(p, "E260", "`list[T](…)` converts a VALUE and was given none — it is the str-to-bytes bridge, not a constructor; `[]` builds an empty list") if args.len() == 0
			raise p_diag(p, "E261", f"`list[T](…)` converts one value, and this gives {strconv.to_string(args.len(), 10)}") if args.len() > 1

			return Expr.EConv(Ty.TList(elem), args[0], "list")
		}

		# `bytearray(s)` / `runearray(s)` — the str-to-list bridges, which are the SAME node
		# `bytearray(s)` and `runearray(s)` produce. The name is read here rather than
		# through the conversion table beside it because the table answers a scalar type and
		# these two answer a list.
		if (t.lexeme == "bytearray" or t.lexeme == "runearray") and peek_kind(p, 1) == Kind.LParen {
			mut elem := Ty.TRune
			if t.lexeme == "bytearray" {
				elem = Ty.TByte
			}
			p_advance(p)
			args := parse_call_args(p)

			raise p_diag(p, "E272", f"`{t.lexeme}(…)` converts a VALUE and was given none — it is the str-to-list bridge, not a constructor; `[]` builds an empty list") if args.len() == 0
			raise p_diag(p, "E273", f"`{t.lexeme}(…)` converts one value, and this gives {strconv.to_string(args.len(), 10)}") if args.len() > 1

			return Expr.EConv(Ty.TList(elem), args[0], "list")
		}
		p_advance(p)
		return Expr.EIdent(t.lexeme)
	}
	return parse_fn_expr(p) if k == Kind.Fn
	if k == Kind.Chan {
		# `chan[T](cap)` — the capacity is optional and defaults to an unbuffered
		# rendezvous, which is what a bare `chan[T]()` means
		p_advance(p)
		elem := parse_chan_elem(p, t.line, t.col)
		expect(p, Kind.LParen)
		mut cap: Expr = Expr.EInt("0", 0, 0)
		if not p_at(p, Kind.RParen) {
			cap = parse_expr(p)
		}
		expect(p, Kind.RParen)
		return Expr.EChanNew(elem, cap)
	}
	if k == Kind.Guard {
		# `guard { … }` is an EXPRESSION (GRAMMAR#guard-expr) yielding Result[T], not a statement.
		# It was read as one before, which is why `n := guard { f() } ?? 0` — the form the
		# spec writes the operator with — was refused outright, and why a statement-position
		# guard lowered to a bare block that caught nothing at all.
		p_advance(p)
		return Expr.EGuard(parse_block(p))
	}

	# GRAMMAR#unsafe-expr and GRAMMAR#asm-expr, the two block-EXPRESSIONS this parser names
	# and does not build. The `unsafe` block used to be swallowed whole with its statements
	# never run, and naming it was only half the fix: both markers were the keyword and
	# nothing else — `NotImplemented: unsafe` — so they named no form, carried no place, and
	# let `unsafe` read as unsupported when the module-level GROUP spelled the same way works.
	raise p_diag_at(p, t.line, t.col, "E224", "NotImplemented: `unsafe { … }` as an EXPRESSION — GRAMMAR makes it a block whose value the expression takes, and this compiler builds only the module-level `unsafe { … }` GROUP, which declares items rather than yielding a value") if k == Kind.Unsafe
	raise p_diag_at(p, t.line, t.col, "E271", "NotImplemented: `asm(…)` — GRAMMAR has inline assembly with an operand list (GRAMMAR#asm-operand), and this compiler emits C and has no assembler of its own") if k == Kind.Asm

	if k == Kind.Cmd {
		# A command literal runs a process, and what the EXPRESSION is worth — an exit
		# code, the output, a process handle — is a stdlib question GRAMMAR deliberately
		# leaves open. Until that is answered it refuses by name: today it parsed as
		# nothing at all, so `c := `echo hi`` silently bound 0.
		raise p_diag(p, "E236", "NotImplemented: a command literal — " + t.lexeme)
	}
	if k == Kind.LParen {
		# `(e)` is grouping and `(a, b)` is a tuple — the comma is what tells them apart,
		# so the first element is read before deciding which this is
		p_advance(p)
		inner := parse_expr(p)
		if not p_at(p, Kind.Comma) {
			expect(p, Kind.RParen)
			return inner
		}
		mut elems: list[Expr] = []
		elems.append(inner)
		for p_at(p, Kind.Comma) {
			ct := cur(p)
			p_advance(p)

			# A COMMA WITH NOTHING AFTER IT is two different ill-formed programs, and which
			# one it is depends on how many elements are already in hand: after one it is
			# the 1-tuple `(1, )`, after two or more it is a trailing comma. The loop used
			# to `break` here, which built a tuple out of either and said nothing.
			if p_at(p, Kind.RParen) {
				if elems.len() == 1 {
					p_one_tuple(p, ct.line, ct.col)
				}
				p_trailing_comma(p, "a tuple literal", ")", ct.line, ct.col)
			}
			elems.append(parse_expr(p))
		}
		expect(p, Kind.RParen)
		return Expr.ETuple(elems)
	}
	if k == Kind.LBrace {
		# A `{` IN EXPRESSION POSITION IS A MAP LITERAL OR A BLOCK, and GRAMMAR gives both
		# to `primary`. p_brace_is_map decides on the `:` — the discriminator the grammar
		# names — and a brace without one is the block EXPRESSION whose value is its last
		# statement's (GRAMMAR, group 2).
		#
		# The same braces at a STATEMENT's start are a block statement (parse_stmt reads
		# that one, as Stmt.SScope) and their value is discarded; a head that opens with `{`
		# is E290. Position decides, and this function is only ever the expression position.
		return parse_map_lit(p) if p_brace_is_map(p)
		return Expr.EBlock(parse_block(p))
	}
	if k == Kind.LBrack {
		# list literal: [] or [a, b, ...], or the FILL form [v; N]
		p_advance(p)
		mut elems: list[Expr] = []
		for not p_at(p, Kind.RBrack) and not p_at(p, Kind.Eof) {
			elems.append(parse_expr(p))

			# `[v; N]` is N copies of v. The `;` is the lexer's statement separator
			# elsewhere, which is exactly why it needs handling here: without it the
			# count was read as a second ELEMENT and the list came out the wrong length.
			if p_at(p, Kind.Semi) and elems.len() == 1 {
				p_advance(p)
				return parse_fill(p, elems[0])
			}

			p_list_sep(p, Kind.RBrack, "]", "a list literal")
		}
		expect(p, Kind.RBrack)
		return Expr.EListLit(elems)
	}

	return parse_if_expr(p) if k == Kind.If
	return parse_match(p) if k == Kind.Match

	# A STATEMENT standing where an expression is wanted. The common way in is a match
	# arm — GRAMMAR makes an arm's body an expression, and `Left(v) => print v` is the
	# first thing anyone writes — where the statement used to be consumed as NOTHING: the
	# arm yielded 0, and the tokens after it were read as a further arm. That is a program
	# that compiles and is not the one that was written, so it is named instead.
	raise p_diag(p, "E605", f"NotImplemented: `{t.lexeme}` is a statement, and an expression is wanted here") if is_stmt_kw(k)

	# TWO TOKENS ARRIVE HERE AS THE SIGN OF A FORM, not as themselves. A `:=` means the
	# line was a DESTRUCTURING binding — `(a, b) := (1, 2)` — whose left side read as a
	# tuple expression before the walrus was reached; a `..` in a pattern means a LIST
	# pattern. Naming the token names the wreckage rather than what was written.

	# A bare `..` is a RANGE with nothing on its left (GRAMMAR#range-expr): `xs[..2]` is the open
	# form of a slice. It was named as a list pattern, which is a different form the same
	# token opens — advice about something nobody wrote.
	raise p_diag(p, "E239", "NotImplemented: a range with no lower bound — write `xs[0..n]`; a list PATTERN `[a, ..rest]` is a different form this compiler also does not have") if k == Kind.DotDot

	# ANY OTHER TOKEN. This used to be `p_advance(p); return ENil` — the token was consumed
	# and the expression became nil, which emits `0`. So every form this parser does not
	# know became the number zero, silently: a rune literal `'A'` was 0, and so was anything
	# else that ever reached here. A form the compiler cannot read is named; it is never a
	# value it did not write.
	raise p_diag(p, "E606", f"NotImplemented: `{t.lexeme}` is not an expression this compiler reads")
}

# parse_close reads `close ( expr )`, the channel's one built-in statement. `at_exit` is
# set for the `defer close(ch)` form, which is the same statement with the block's exit as
# its moment.
fn parse_close(mut &p: Parser, at_exit: bool) -> Stmt {
	p_advance(p) # 'close'
	expect(p, Kind.LParen)
	ch := parse_expr(p)
	expect(p, Kind.RParen)
	return Stmt.SClose(ch, at_exit)
}

# is_stmt_kw names the keywords that can only begin a STATEMENT. It is deliberately a
# list of keywords rather than "anything unrecognised": the parser skips out-of-subset
# surface elsewhere on purpose, and turning every unknown token into an error would
# refuse programs this compiler is meant to read past.
fn is_stmt_kw(k: Kind) -> bool {
	return true if k == Kind.Print or k == Kind.Raise or k == Kind.Return or k == Kind.Nop
	return true if k == Kind.Break or k == Kind.Continue or k == Kind.Del or k == Kind.Defer or k == Kind.Close

	return k == Kind.Spawn or k == Kind.Select or k == Kind.For or k == Kind.With
}

# parse_if_expr reads `if cond { e } else { e }` — the if-EXPRESSION (GRAMMAR#if-expr),
# whose `else` is mandatory because it yields the taken branch's value.
#
# The `else if` CHAIN is why this is a function and not the inline arm it used to be.
# GRAMMAR writes the else-arm of an `if` as another `if`, and the inline version demanded a
# `{` after `else` — so `if a { 1 } else if b { 2 } else { 3 }`, which is how anyone writes
# three cases, got "expected `{`, found `if`". The chain is right-nested here, which is
# exactly what it means, so the emitter's two-branch lowering takes any length of it
# unchanged.
fn parse_if_expr(mut &p: Parser) -> Expr {
	p_advance(p) # 'if'
	p_no_brace_head(p, "an `if` head", false)
	t := cur(p)

	# THE BINDING HEAD, `if v := e { … }` (GRAMMAR#if-head), which runs the branch only when
	# `e` is present. It is grammatical in expression position and this compiler unwraps an
	# optional in the STATEMENT form only, so the `:=` reached the condition's expression
	# parser and reported itself.
	raise p_diag_at(p, t.line, t.col, "E270", f"NotImplemented: a binding head in an `if` EXPRESSION — `if {t.lexeme} := …` unwraps an optional, and this compiler does that in the statement form only; bind it before the expression, or use `??`") if p_at(p, Kind.Ident) and peek_kind(p, 1) == Kind.Walrus

	cond := parse_expr(p)
	then_e := parse_if_branch(p)
	expect(p, Kind.Else)

	# `else if` — the chain, right-nested. The else-branch IS another if-expression, and
	# reading it as one is all the nesting takes.
	return Expr.EIf(cond, then_e, parse_if_expr(p)) if p_at(p, Kind.If)
	return Expr.EIf(cond, then_e, parse_if_branch(p))
}

# parse_if_branch is one `{ … }` arm of an if-expression. A branch is a BLOCK in GRAMMAR and
# a block's value is its last statement's, so a multi-statement arm is grammatical — and this
# compiler lowers an if-expression to a C conditional, which holds one expression and no
# statements. The arm is named rather than reported as the token that could not continue it.
fn parse_if_branch(mut &p: Parser) -> Expr {
	expect(p, Kind.LBrace)
	skip_semis(p)
	e := parse_expr(p)
	skip_semis(p)

	t := cur(p)
	raise p_diag_at(p, t.line, t.col, "E269", "NotImplemented: an `if` EXPRESSION whose branch has more than one statement — a block's value is its last statement's, and this compiler lowers the expression form to a conditional, which holds no statements. Use the `if` STATEMENT and assign in each branch") if not p_at(p, Kind.RBrace)

	expect(p, Kind.RBrace)
	return e
}

fn parse_match(mut &p: Parser) -> Expr {
	p_advance(p) # 'match'
	p_no_brace_head(p, "a `match` head", false)
	scrut := parse_expr(p)
	expect(p, Kind.LBrace)
	skip_semis(p)
	mut arms: list[Arm] = []
	for not p_at(p, Kind.RBrace) and not p_at(p, Kind.Eof) {
		arms.append(parse_arm(p))
		skip_semis(p)
	}
	expect(p, Kind.RBrace)
	return Expr.EMatch(scrut, arms)
}

# at_named_range_arm reports whether the arm head is a RANGE ARM whose lower bound is a name —
# an identifier immediately followed by `..` or `..=` (GRAMMAR#range-bound, whose second
# alternative is a bare `identifier`).
#
# It exists because a range arm is recognized BY ITS `..` and that recognition only ever ran on
# a literal head: a non-identifier head falls to `parse_expr` below, which reads `200..300` as
# the range it is, while an identifier head was claimed by the binding branch, which reads the
# name and then demands the `=>` a range arm has not reached yet. So `LO..HI =>` came back as
# `expected `=>`, found `..`` — a token-level complaint about a form GRAMMAR derives.
#
# ONE TOKEN OF LOOKAHEAD IS THE WHOLE DECISION, and deliberately so: GRAMMAR#pattern makes the
# pattern grammar context-free — "nothing here has to be resolved to be parsed" — so the parser
# may not ask what the name MEANS, and knows of no constants to ask about. Whether the name is
# worth a compile-time value is a later question, put to `chk_const_eval` at the use site, where
# a name that is not one is reported against the line that wanted a constant.
fn at_named_range_arm(mut &p: Parser) -> bool {
	k := peek_kind(p, 1)
	return k == Kind.DotDot or k == Kind.DotDotEq
}

# p_arm_body_stmt refuses a STATEMENT left standing after an arm's body, and it is one
# function for the reason p_trailing_comma is: the two shapes that reach it — a leftover `=`
# and a leftover `<-` — are one rule about what an arm's body may be, and writing them out
# twice would put one rule under two identities (scripts/error-codes-check.sh).
#
# `what` names the shape, because one code covers both and the reader has to be told which
# statement was left behind.
fn p_arm_body_stmt(mut &p: Parser, what: str) -> str {
	return p_diag(p, "E607", f"NotImplemented: a match arm's body is an expression — {what} in an arm needs a block body, which this emitter cannot yet lower")
}

# parse_arm parses one `pattern [if guard] => body` arm. A bare identifier binds the
# scrutinee (or is the `_` wildcard) unless a `..` follows it, which makes it a range bound;
# anything else is a literal pattern matched by equality.
fn parse_arm(mut &p: Parser) -> Arm {
	# A TUPLE or LIST pattern in arm position — `(a, b) =>`, `[a, ..r] =>`. Both read as an
	# EXPRESSION here, so the names in them came out undefined rather than bound, and the
	# message named a symptom two steps from the form that was written.
	raise p_diag(p, "E232", "NotImplemented: a tuple pattern in a `match` arm — this compiler destructures a tuple with `.0` / `.1`") if p_at(p, Kind.LParen)
	raise p_diag(p, "E240", "NotImplemented: a list pattern in a `match` arm — this compiler destructures a list with indexing and `.slice`") if p_at(p, Kind.LBrack)

	mut pat := 0
	mut lit := Expr.ENil
	mut bind := ""
	mut ctor := ""
	mut binds: list[str] = []
	if p_at(p, Kind.Ident) and not at_named_range_arm(p) {
		mut name := cur(p).lexeme
		p_advance(p)

		# `Color.Green =>` — a variant NAMED BY ITS ENUM, the pattern half of the qualified
		# form. The arm matches on the variant, so the enum name is dropped once it has been
		# read; whether it is the right enum is the emitter's question, which it already asks
		# of a bare pattern against the scrutinee's type.
		mut qualified := false
		if p_at(p, Kind.Dot) and peek_kind(p, 1) == Kind.Ident {
			p_advance(p)
			name = p_name(p, "a variant pattern")
			qualified = true
		}

		# `Move{x, y} =>` — a STRUCT PATTERN (GRAMMAR#struct-pat). `P{…}` after a name in arm
		# position is that and nothing else, and it fell through to the arrow check, so the
		# message was `expected `=>`, found `{`` — the token after the form rather than the
		# form. The tuple and list patterns beside it are already refused by name.
		raise p_diag(p, "E243", f"NotImplemented: a struct pattern `{name}{{…}}` in a `match` arm — this compiler destructures a struct with field access, not with a pattern") if p_at(p, Kind.LBrace)

		if name == "_" {
			pat = 2
		} else if qualified or p_at(p, Kind.LParen) {
			# enum constructor pattern: `Enum.Variant` or `Enum.Variant(a, b)`. What makes it
			# one is the SHAPE — a qualifier, or a payload list — and not the capital the name
			# happens to start with. Which enum it belongs to is the emitter's question, and
			# `c_check_arm_pats` already asks it of every constructor pattern.
			pat = 3
			ctor = name
			if p_at(p, Kind.LParen) {
				p_advance(p)
				for not p_at(p, Kind.RParen) and not p_at(p, Kind.Eof) {
					# A SUB-PATTERN IN THE PAYLOAD. GRAMMAR#variant-pat's payload is a
					# `pattern-list`, and `pattern` derives every pattern form there is —
					# so `E.Wrap(Inner.A(n))` and `E.One(0)` are both derived. This loop
					# reads a NAME and nothing else, so the first reported whatever token
					# followed the inner name (``expected `,`, found `.` ``) and the second
					# fell to p_name's own sentence: a token complaint with no code and no
					# place, for a form the grammar has (docs/code/patterns.md says as much,
					# and asks for exactly this).
					# A RESERVED WORD IS NOT A SUB-PATTERN, and p_name below owns that
					# sentence (E245): `E.One(this)` is somebody naming a binding `this`,
					# not writing a pattern inside a pattern, and answering it here would
					# take a rule off a case that already had one.
					pt := cur(p)
					nested := p_at(p, Kind.Ident) and peek_kind(p, 1) == Kind.Dot
					if (nested or not p_at(p, Kind.Ident)) and not p_reserved_word(pt.lexeme) {
						raise p_diag_at(p, pt.line, pt.col, "E492", f"NotImplemented: a sub-pattern inside a variant payload, beginning at `{pt.lexeme}` — GRAMMAR#variant-pat takes a `pattern-list` there and this compiler takes a binding name or `_`. Match one level, bind the payload, and `match` the binding in turn") if pt.lexeme != "_"
					}
					binds.append(p_name(p, "a pattern binding"))
					p_list_sep(p, Kind.RParen, ")", "a pattern list")
				}
				expect(p, Kind.RParen)
			}
		} else {
			# A BARE NAME IN PATTERN POSITION IS ALWAYS A FRESH BINDING (GRAMMAR#pattern), and
			# nothing here has to be resolved to be parsed. It used to be a constructor pattern
			# when it started with a capital, which made an arm's meaning a NAMING CONVENTION:
			# rename the binding `Value` to `value` and the same arm stopped matching a variant
			# and started binding the subject.
			#
			# The rule that stood here — E274, "`{name}` is a variant of some enum" — could not
			# be true, because the parser has resolved nothing and knows of no enum: it fired
			# on a program that declared none, and named an enum that did not exist. It is
			# retired rather than moved, because moving it to where the enums ARE known would
			# put a program's legality back under an unrelated declaration — an enum gaining a
			# variant would turn a working binding arm elsewhere into an error, which is the
			# same file-order coupling GRAMMAR retired the bare-variant form to be rid of.
			#
			# What guards the mistake it was aimed at — `match c { Red => …  Green => … }`,
			# meaning two variants and getting one catch-all — is E458 in the emitter: a
			# binding arm covers everything, so any arm after it is unreachable and said so.
			pat = 1
			bind = name
		}
	} else {
		lit = parse_expr(p)
	}

	# AN OR-PATTERN, `A | B =>` (GRAMMAR#pattern), which this compiler does not lower. It
	# arrives in TWO shapes and the rule was written at one of them: a literal pattern lets
	# parse_expr swallow the `|` as the bitwise operator, so `1 | 2` reached the emitter as a
	# folded value and was named there; a name pattern stops before the `|`, and the parser
	# died on "expected `=>`" — the message a typo gets, for a form GRAMMAR has.
	#
	# Both shapes are one rule, so it is written once, HERE: the parser is the only place
	# that sees the bitwise-or expression and the leftover `|` token alike.
	raise p_diag(p, "E241", "NotImplemented: an or-pattern — `|` in a pattern is read as the bitwise operator here, so the arm would match neither side. Write consecutive integers as a range (`1..=2`), or one arm each") if p_at(p, Kind.Pipe) or is_or_expr(lit)

	# `pattern as name` — the AS BINDING (GRAMMAR#sub-pattern), which binds the whole matched value
	# while the pattern keeps destructuring. It fell through to the arrow check, so the
	# message named `as` rather than the form it opens.
	raise p_diag(p, "E234", "NotImplemented: an `as` binding in a `match` arm — `pattern as name` binds the whole matched value, which this compiler does not carry alongside the destructured parts") if p_at(p, Kind.As)

	mut has_guard := false
	mut grd := Expr.ENil
	if p_at(p, Kind.If) {
		p_advance(p)
		has_guard = true
		grd = parse_expr(p)
	}
	expect(p, Kind.FatArrow)
	body := parse_expr(p)

	# GRAMMAR makes an arm's body an `expr`, and a block is a primary — so `X => { … }` is
	# grammatical and a bare statement is not. c_match lowers a match to a ternary chain
	# and can hold neither, which is a general `match` gap rather than a channel one.
	#
	# What is fixed here is only the DIAGNOSTIC. `Add(d) => n = n + d` used to leave the
	# `= n + d` behind, and the arm loop then read the wreckage as further arms and emitted
	# C that only cc could object to. A leftover `=` or `<-` after a body is exactly that
	# situation, and it is now said in Zerg's own words.
	raise p_arm_body_stmt(p, "a reassignment") if p_at(p, Kind.Assign)
	raise p_arm_body_stmt(p, "a send") if p_at(p, Kind.LArrow)

	# An arm's guard goes BEFORE the `=>` (GRAMMAR#match-arm). Written after the body it was
	# silently DROPPED — `Right(e) => 0 if e is ValueError` compiled to an unconditional arm,
	# and the arm counted toward exhaustiveness as if it had no guard at all.
	raise p_diag(p, "E262", "a match arm's guard goes before the `=>` — write `pattern if cond => body`") if p_at(p, Kind.If)

	return Arm(pat, lit, bind, ctor, binds, has_guard, grd, body)
}

# --- f-strings ---------------------------------------------------------------------------
#
# An f-string DESUGARS here into the `+` chain it is defined to be, so ast.zg and emit.zg
# know nothing about f-strings: no node, no case, no runtime format engine. `f"a{x}b"`
# builds precisely the tree `"a" + str(x) + "b"` would.
#
# The fold is LEFT-leaning and always SEEDED with a str literal, and both halves are
# load-bearing. c_binexpr decides string concatenation from the LEFT operand's inferred
# type alone: with an EStr on the left every step lowers to zgs_concat. A right fold — the
# shape the seed uses — puts a hole on the left instead, and a hole that infers int falls
# through to the numeric path as `(zg_n + "b")`, which is valid C pointer arithmetic. No
# diagnostic, wrong output. The empty leading `""` of `f"{s}"` costs one concat and buys
# that away.
#
# Every hole is wrapped in `str(…)`, which is `display()` for a scalar and identity for a
# str, so a hole renders whatever it holds.
fn fstr_expr(mut &p: Parser, t: Token) -> Expr {
	src := bytearray(t.value)
	n := src.len()
	mut acc: Expr = Expr.ENil
	mut have := false
	mut lo := 0 # start of the literal run being gathered
	mut i := 0
	for i < n {
		c := src[i]
		if c == b'{' and i + 1 < n and src[i + 1] == b'{' {
			i = i + 2
		} else if c == b'}' and i + 1 < n and src[i + 1] == b'}' {
			i = i + 2
		} else if c == b'\\' {
			i = fstr_esc_end(src, i)
		} else if c == b'{' {
			txt := fstr_slice(src, lo, i)

			# the first part is emitted even when empty, so the fold is seeded with a str
			if txt != "" or not have {
				acc = fstr_join(acc, have, Expr.EStr(fstr_text(p, t, txt)))
				have = true
			}
			end := fstr_hole_end(src, i)
			acc = fstr_join(acc, have, fstr_hole(p, t, fstr_slice(src, i + 1, end)))
			have = true
			i = end + 1
			lo = i
		} else {
			i = i + 1
		}
	}
	tail := fstr_slice(src, lo, n)
	return fstr_join(acc, have, Expr.EStr(fstr_text(p, t, tail))) if tail != "" or not have
	return acc
}

fn fstr_join(acc: Expr, have: bool, part: Expr) -> Expr {
	return part if not have
	return Expr.EBinary("+", acc, part)
}

fn fstr_slice(src: list[byte], lo: int, hi: int) -> str {
	mut out: list[byte] = []
	mut i := lo
	for i < hi {
		out.append(src[i])
		i = i + 1
	}
	return str(out)
}

# fstr_esc_end steps over a backslash escape. `\u{…}` carries braces of its own, which is
# the reason this exists: two bytes would leave its `{` to be read as a hole.
fn fstr_esc_end(src: list[byte], at: int) -> int {
	n := src.len()

	return at + 1 if at + 1 >= n
	return at + 2 if src[at + 1] != b'u'

	mut i := at + 2
	for i < n {
		return i + 1 if src[i] == b'}'
		i = i + 1
	}
	return n
}

# fstr_hole_end is the index of the `}` closing the hole that opens at `at`, counting the
# braces a nested list or map literal brings with it.
fn fstr_hole_end(src: list[byte], at: int) -> int {
	n := src.len()
	mut depth := 0
	mut i := at
	for i < n {
		c := src[i]
		if c == b'"' or c == b'\'' {
			i = fstr_quote_end(src, i)
		} else {
			if c == b'{' {
				depth = depth + 1
			} else if c == b'}' {
				depth = depth - 1
				return i if depth == 0
			}
			i = i + 1
		}
	}
	return n
}

fn fstr_quote_end(src: list[byte], at: int) -> int {
	n := src.len()
	q := src[at]
	mut i := at + 1
	for i < n {
		if src[i] == b'\\' {
			i = i + 2
		} else if src[i] == q {
			return i + 1
		} else {
			i = i + 1
		}
	}
	return n
}

# fstr_text decodes one chunk of literal text: `{{` and `}}` collapse to one brace, and the
# backslash escapes are decoded by wrapping the chunk back into a plain string literal and
# running it through the lexer — so `\n` and `\u{…}` mean here exactly what they mean in a
# `"…"`, rather than through a second escape table that would drift from the first.
fn fstr_text(mut &p: Parser, t: Token, raw: str) -> str {
	toks := tokenize(f"\"{fstr_unbrace(raw)}\"")
	return toks[0].value if toks[0].kind == Kind.Str
	raise p_diag_at(p, t.line, t.col, "E608", "f-string: malformed literal text: " + raw)
}

fn fstr_unbrace(raw: str) -> str {
	b := bytearray(raw)
	n := b.len()
	mut out: list[byte] = []
	mut i := 0
	for i < n {
		c := b[i]
		if c == b'\\' and i + 1 < n {
			out.append(c)
			out.append(b[i + 1])
			i = i + 2
		} else if (c == b'{' or c == b'}') and i + 1 < n and b[i + 1] == c {
			out.append(c)
			i = i + 2
		} else {
			out.append(c)
			i = i + 1
		}
	}
	return str(out)
}

# fstr_hole turns one hole's source into an expression. It is RE-LEXED and parsed by the
# ordinary machinery, so anything the compiler can parse in an expression position works
# inside a hole; p.impl_ty rides along so `this` resolves as it does outside one.
fn fstr_hole(mut &p: Parser, t: Token, hole: str) -> Expr {
	fstr_reject(p, t, hole)

	toks := tokenize(hole)

	# the hole parser INHERITS the enclosing depth: its recursion continues on the same
	# native stack, so an f-string could not be a fresh budget even if it wanted one. It
	# inherits `edepth` for the mirror reason — the hole's expression is spliced into the
	# enclosing tree, which is measured as one whole, so the hole is not a root.
	mut hp := Parser(toks, 0, p.impl_ty, p.path, p.depth, p.edepth, [])
	e := parse_expr(hp)

	# a hole is ONE expression; emitting just the prefix of something longer is exactly the
	# silent wrong answer this path exists to avoid
	raise p_diag_at(p, t.line, t.col, "E609", "f-string: a hole must be a single expression: {" + hole + "}") if not p_at(hp, Kind.Eof) and not p_at(hp, Kind.Semi)
	return Expr.EConv(Ty.TStr, e, "str")
}

# fstr_reject refuses the hole forms this compiler does not implement, naming which one.
#
# GRAMMAR gives a hole three optional tails, and every one of them needs a STATIC TYPE to
# mean anything — the seed picks its display and format leaves from it. This compiler
# desugars in the PARSER, where no type exists yet. Dropping a `:04d` would print the wrong
# text and say nothing, so each is refused by name instead.
fn fstr_reject(mut &p: Parser, t: Token, hole: str) {
	b := bytearray(hole)
	n := b.len()
	mut depth := 0
	mut i := 0
	for i < n {
		c := b[i]
		if c == b'"' or c == b'\'' {
			i = fstr_quote_end(b, i)
		} else if c == b'(' or c == b'[' or c == b'{' {
			depth = depth + 1
			i = i + 1
		} else if c == b')' or c == b']' or c == b'}' {
			depth = depth - 1
			i = i + 1
		} else if depth == 0 and c == b':' {
			raise p_diag_at(p, t.line, t.col, "E225", "NotImplemented: an f-string ':spec' format spec — {" + hole + "}")
		} else if depth == 0 and c == b'!' and i + 1 < n and fstr_is_conv(b[i + 1]) {
			raise p_diag_at(p, t.line, t.col, "E226", "NotImplemented: an f-string '!r' / '!s' / '!a' conversion — {" + hole + "}")
		} else {
			i = i + 1
		}
	}
	raise p_diag_at(p, t.line, t.col, "E227", "NotImplemented: the f-string '{expr=}' self-documenting form — {" + hole + "}") if fstr_is_selfdoc(b)
}

fn fstr_is_conv(c: byte) -> bool {
	return c == b'r' or c == b's' or c == b'a'
}

# fstr_is_selfdoc reports a hole ending in `=`, the self-documenting form — but not one
# ending in a comparison, whose `=` is the second half of an operator.
fn fstr_is_selfdoc(b: list[byte]) -> bool {
	mut i := b.len() - 1
	for i >= 0 and b[i] == b' ' {
		i = i - 1
	}
	return false if i < 1 or b[i] != b'='
	p := b[i - 1]
	return p != b'=' and p != b'!' and p != b'<' and p != b'>'
}
