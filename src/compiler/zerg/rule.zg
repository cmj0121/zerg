# rule — the identity of every diagnostic this compiler reports.
#
# A diagnostic names a RULE, and the code in front of its sentence is that rule's stable
# identity: prose gets better and a gate that pinned the sentence would turn red every time
# it did. The catalogue a reader looks the code up in is docs/tooling/diagnostics.md; this
# file is what the COMPILER holds, and the two are held to each other by
# `make error-codes-check`.
#
# It is an enum and not a string at the site for three reasons, each of which was a way the
# scheme had already drifted:
#
#   A CODE IS DECLARED ONCE. Every reporting channel takes a `Rule`, so a hand-spelled
#   `"E204"` is a type error rather than a finding some gate has to go looking for. A rule
#   with no identity cannot be written at all.
#
#   TWO PRs COLLIDE IN GIT. Three collisions happened in one week — `E387`, `E477` and
#   `E288`/`E289` — because parallel work could only grep the catalogue and never see a
#   sibling's choice. Every new code is a line in THIS file, so a second one lands on the
#   same lines and the merge says so, before CI is asked.
#
#   THE NUMBER IS NOT THE IDENTITY. A variant names the rule and the discriminant carries
#   the number, so renumbering the scheme is an edit to this file and to nothing else.
#
# The variants are grouped by the STAGE that reports them, which is the order a build meets
# them, and that grouping is what the ranges spell: `E1xx` lexical, `E2xx` parser, `E3xx`
# checking, `E4xx` emitting, `E5xx` building. A `NotYet…` name is the other class of
# refusal — a form the language has and this compiler has not built — and it retires when
# the form is built rather than when a rule changes its mind.
#
# ONE NUMBER IS NEVER REUSED. A retired code leaves this file for the catalogue's retired
# table: an old build's message must go on meaning what it meant, and reissuing a number
# silently reassigns every report, log and bug filed under it.

pub enum Rule {
	# lexical — text that is not Zerg tokens — the scanner's refusals, reported before a form exists to name
	StrUnterminated = 101
	RuneEmpty = 102
	RuneTooLong = 103
	CharNotAToken = 104
	TripleStrUnterminated = 105
	RawStrUnterminated = 106
	CommandUnterminated = 107
	BasedNumberNoDigit = 108
	EscapeInvalid = 109
	StrHoldsNul = 110
	SourceNotUtf8 = 111

	# parser — tokens that are not a Zerg form. `E6xx` is `E2xx` continued: a range is a hundred numbers and
	# the parser used ninety-eight of them
	SelectArmClose = 201
	SelectNoArms = 202
	SelectArmHead = 203
	ExpectedFound = 204
	ExpectedStatementEnd = 205
	EitherSameType = 206
	NotYetParameterizedSpec = 207
	DeriveNoDeclaration = 208
	NotYetSpecMemberBody = 210
	AssocValueNotSpecMember = 211
	NotYetGenericEnum = 212
	EnumDiscriminantRepeated = 213
	DiscriminantOnPayloadEnum = 214
	NotYetGenericStruct = 215
	NotYetDecorator = 217
	NotYetImplAssocValue = 218
	NotYetImplItem = 219
	NotYetStructPattern = 221
	NotYetCallee = 222
	NotYetNamedArgument = 223
	NotYetUnsafeExpr = 224
	NotYetFStringFormatSpec = 225
	NotYetFStringConversion = 226
	NotYetFStringSelfDoc = 227
	AssocTypeNotSpecMember = 230
	NotYetImplAssocType = 231
	NotYetTuplePattern = 232
	NotYetArrayType = 233
	NotYetAsPattern = 234
	NotYetCommandInterpolating = 235
	NotYetCommandLiteral = 236
	NotYetDestructuringBinding = 238
	NotYetRangeNoLower = 239
	NotYetListPattern = 240
	NotYetOrPattern = 241
	NotYetForMutBinding = 242
	NotYetStructPatternInMatch = 243
	NestingTooDeep = 244
	ReservedWordAsName = 245
	TupleTypeOneElement = 246
	PubImport = 247
	PubOnInit = 248
	PubOnImpl = 249
	PubInsideDecorator = 250
	FreeFnMut = 251
	PubOnUnsafeGroup = 252
	UnsafeGroupNested = 253
	UnsafeGroupHoldsDeclarations = 254
	PubOnStatement = 255
	UnsafeGroupUnterminated = 256
	ReservedWordAsBinding = 257
	ScalarConvNoValue = 258
	ScalarConvManyValues = 259
	ListConvNoValue = 260
	ListConvManyValues = 261
	MatchGuardPlacement = 262
	ParamMutRefOrNothing = 263
	NotYetUnsafeFn = 264
	NotYetAssocTypeProjection = 265
	NotYetValueGenericParam = 266
	ImportPathNotString = 267
	NotYetTypeArgsNoCall = 268
	NotYetIfExprManyStatements = 269
	NotYetIfExprBindingHead = 270
	NotYetAsm = 271
	ArrayConvNoValue = 272
	ArrayConvManyValues = 273
	TypeArgsAsIndex = 275
	SpecMemberNeitherSigNorBody = 276
	ImplOrphan = 277
	DeriveSpecEnumThisParam = 278
	DeriveSpecEnumVariantNoValue = 279
	ObjNotOnSpec = 280
	ObjWithMutFn = 281
	ObjWithThisParam = 282
	DeriveOnStructureless = 283
	CoalesceDivergeGuard = 284
	NotYetClosureParamDefault = 285
	NotYetFnTypeMutRefParam = 286
	NotYetUnsafeSpecSignature = 287
	TupleLitOneElement = 288
	TrailingComma = 289
	BraceOpeningHead = 290
	NotYetImplTypeParams = 291
	NotYetImplTypeArgument = 292
	ReservedWordAsField = 293
	FieldNameExpected = 294
	DelUnknownName = 295
	DelNotABinding = 296
	UseAfterDel = 297
	UseAfterDelOnSomePaths = 298
	NameExpected = 601
	ChanDirectionPrefix = 602
	MutBeforeNonFn = 603
	IsWantsTypeName = 604
	NotYetStatementAsExpr = 605
	NotYetExprForm = 606
	NotYetMatchArmStatement = 607
	FStringTextMalformed = 608
