# lexer — Zerg source text to a token stream (self-hosting compiler, M1).
#
# A port of the Go bootstrap's internal/lexer, following GRAMMAR group 2. It skips
# horizontal whitespace and comments, inserts a ';' at a line break when the previous
# token can end an item (ASI) — suppressed inside an unclosed '(' or '[' but not '{' —
# and scans the literal, keyword, identifier, operator, and punctuation forms.
#
# Trivia (comments, blank lines) is not retained: the `--emit tokens` view the diff-test
# oracle prints never shows it, so the subset lexer simply drops it. An f-string is scanned
# WHOLE, as one FStr token the parser cuts up (scan_fstring); the f-cmd and decorator
# interpolation forms are still deferred.
import (
	"ascii"
	"strconv"
)

# Lex holds the scan state. `stack` + `sp` implement the brace-depth stack over an
# append-only list (list has no pop): push writes at sp and bumps it, pop just drops sp.
struct Lex {
	pub src: list[byte]
	pub n: int
	pub offs: int
	pub line: int
	pub col: int
	pub depth: int
	pub stack: list[int]
	pub sp: int
	pub prev: Kind

	# keep_trivia makes a comment a TOKEN instead of nothing. The compiler never sets it —
	# it would only have to skip them again — but the formatter cannot do its job without
	# them, and a formatter that eats comments is not one anybody would run twice.
	pub keep_trivia: bool
}

# --- character helpers ---------------------------------------------------------

# at returns the byte i positions ahead of the cursor, or 0 past end of input. It
# takes the lexer by reference purely to avoid copying the source list on every peek.
fn at(mut &l: Lex, i: int) -> byte {
	j := l.offs + i
	return l.src[j] if j < l.n
	return byte(0)
}

fn eof(mut &l: Lex) -> bool {
	return l.offs >= l.n
}

# advance consumes one byte, tracking line and column.
fn advance(mut &l: Lex) -> byte {
	c := l.src[l.offs]
	l.offs = l.offs + 1
	if c == byte(10) {
		l.line = l.line + 1
		l.col = 1
	} else {
		l.col = l.col + 1
	}
	return c
}

fn is_ident(c: byte) -> bool {
	return ascii.is_alpha(c) or ascii.is_digit(c) or c == b'_'
}

# lexeme_from returns the source slice [a, cursor) as a str, read straight from the
# source list (no list slicing built-in exists).
fn lexeme_from(mut &l: Lex, a: int) -> str {
	mut out: list[byte] = []
	mut i := a
	for i < l.offs {
		out.append(l.src[i])
		i = i + 1
	}
	return str(out)
}

# --- token production ----------------------------------------------------------

fn emit(mut &l: Lex, k: Kind, line: int, col: int, lexeme: str) -> Token {
	l.prev = k
	return Token(k, lexeme, "", line, col)
}

# bad emits an ILLEGAL token that says what is wrong with it. The lexer has always marked
# the token it could not read; what it never did was give a reason, so the only thing that
# ever spoke about one was parse_primary's fallback — "`b'b` is not an expression this
# compiler reads", which names the wrong layer, the wrong problem, and a lexeme that is a
# fragment of what the person wrote.
#
# The reason rides in the token's VALUE, which an Illegal has no other use for, and
# `lex_diags` turns every one of them into a diagnostic with a place and a code.
fn bad(mut &l: Lex, code: Rule, why: str, line: int, col: int, lexeme: str) -> Token {
	return emit_val(l, Kind.Illegal, line, col, lexeme, f"{rule_code(code)} {why}")
}

fn emit_val(mut &l: Lex, k: Kind, line: int, col: int, lexeme: str, value: str) -> Token {
	l.prev = k
	return Token(k, lexeme, value, line, col)
}

# lex_code_end is where `bad` put the space, and it is the whole of the encoding: an Illegal
# token has ONE spare field and a diagnostic wants two things out of it, so the code is
# joined on the way in and cut off on the way out. Reading a code back out of a message
# ANYWHERE ELSE would be the second copy `Diag.code` exists to prevent; here it is one
# writer and one reader, a few lines apart.
fn lex_code_end(b: list[byte]) -> int {
	mut i := 0
	for i < b.len() {
		return i if b[i] == b' '
		i = i + 1
	}
	return -1
}

# next returns the next token, inserting a ';' at a line break per the ASI rule and
# dropping comments and blank lines along the way.
fn next(mut &l: Lex) -> Token {
	for not eof(l) {
		c := at(l, 0)
		if c == b' ' or c == byte(9) {
			advance(l)
		} else if c == byte(13) and at(l, 1) == byte(10) {
			# THE CR HALF OF A CRLF, and nothing else. GRAMMAR#NEWLINE is `'\r'? '\n'`, so a
			# CR belongs to the line break that follows it — consumed here, and the LF arm
			# below does the ASI work, which keeps one rule for what ends a statement.
			#
			# A CR was in the whitespace class beside space and tab, where GRAMMAR#WS never
			# put it. That silently swallowed a LONE CR — a classic-Mac line ending, or one
			# left by an editor mid-line — so a file whose statements were separated by CR
			# alone lexed as ONE line and the ASI `;` was never inserted. Out of the class,
			# a lone CR reaches bad_char like any other character no token claims (E104).
			advance(l)
		} else if c == byte(10) {
			sline := l.line
			scol := l.col
			advance(l)
			return emit(l, Kind.Semi, sline, scol, ";") if l.depth == 0 and ends_item(l.prev)
		} else if c == b'#' {
			return scan_token(l) if at(l, 1) == b'['
			return scan_comment(l, l.line, l.col) if l.keep_trivia

			skip_comment(l)
		} else {
			return scan_token(l)
		}
	}
	return emit(l, Kind.Eof, l.line, l.col, "")
}

fn skip_comment(mut &l: Lex) {
	for not eof(l) and at(l, 0) != byte(10) {
		advance(l)
	}
}

# scan_comment reads a `#` comment to the end of its line and returns it as a token,
# lexeme and all, so the formatter can put it back exactly as written.
fn scan_comment(mut &l: Lex, sline: int, scol: int) -> Token {
	mut sb: list[byte] = []
	for not eof(l) and at(l, 0) != byte(10) {
		sb.append(advance(l))
	}
	return emit(l, Kind.Comment, sline, scol, str(sb))
}

fn scan_token(mut &l: Lex) -> Token {
	sline := l.line
	scol := l.col
	soff := l.offs
	c := at(l, 0)

	# literal prefixes
	return scan_raw_string(l, sline, scol, soff) if c == b'r' and at(l, 1) == b'"'
	return scan_fstring(l, sline, scol, soff) if c == b'f' and at(l, 1) == b'"'

	if c == b'b' and at(l, 1) == b'\'' {
		advance(l) # b
		return scan_char_lit(l, Kind.Byte, true, sline, scol, soff)
	}

	return scan_ident(l, sline, scol, soff) if ascii.is_alpha(c) or c == b'_'
	return scan_number(l, sline, scol, soff) if ascii.is_digit(c)
	return scan_string(l, sline, scol, soff) if c == b'"'
	return scan_char_lit(l, Kind.Rune, false, sline, scol, soff) if c == b'\''
	return scan_cmd(l, sline, scol, soff) if c == b'`'

	if c == b'#' {
		# '#[' opens a decorator; depth is bumped, suppressing ASI until the ']'
		advance(l) # '#'
		advance(l) # '['
		l.depth = l.depth + 1
		return emit(l, Kind.Hash, sline, scol, "#[")
	}
	return scan_nonascii(l, sline, scol, soff) if int(c) >= 0x80

	return scan_operator(l, sline, scol, soff)
}

# scan_nonascii is the E104 a character outside ASCII gets. GRAMMAR#letter makes the source
# UTF-8 — which is what lets a comment, a string and a rune hold any character at all —
# and GRAMMAR#identifier derives ASCII letters, digits and `_`, so a character reaching
# here spells nothing: the same lexical error `@` is, under the same code.
#
# IT IS CAUGHT BEFORE scan_operator RATHER THAN IN ITS FALLBACK, and the whole reason is
# the lexeme. `lexeme_from` cuts the source between two offsets and reads the bytes back
# as a `str`, scan_operator having consumed exactly ONE — so the diagnostic about `值`
# asked for one third of a character, and the str constructor answered by KILLING the
# compiler: `EncodingError: bytes are not valid UTF-8 for a str`, an uncaught abort with
# no code, no place and no form named, for a program the ASCII path reports cleanly.
#
# Consuming the whole character instead makes the lexeme what the reader wrote, which is
# both a legal `str` and ONE error where a byte at a time would be three. The lead byte
# always begins a well-formed sequence here, because the driver reads the file as a `str`
# before this ever sees it, so `rune_len` is the whole of the answer.
fn scan_nonascii(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	n := rune_len(at(l, 0))
	mut i := 0
	for i < n and not eof(l) {
		advance(l)
		i = i + 1
	}
	return bad_char(l, sline, scol, soff)
}

fn scan_ident(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	for not eof(l) and is_ident(at(l, 0)) {
		advance(l)
	}
	lexeme := lexeme_from(l, soff)
	return emit(l, lookup_keyword(lexeme), sline, scol, lexeme)
}

# --- numbers -------------------------------------------------------------------

fn based_valid(c: byte, base: byte) -> bool {
	v := int(c)

	return ascii.is_hex_digit(c) if base == b'x'
	return v >= 48 and v <= 55 if base == b'o'

	return v == 48 or v == 49
}

fn consume_dec(mut &l: Lex) {
	for not eof(l) {
		c := at(l, 0)
		if ascii.is_digit(c) {
			advance(l)
		} else if c == b'_' and ascii.is_digit(at(l, 1)) {
			advance(l)
		} else {
			return
		}
	}
}

fn consume_based(mut &l: Lex, base: byte) {
	for not eof(l) {
		c := at(l, 0)
		if based_valid(c, base) {
			advance(l)
		} else if c == b'_' and based_valid(at(l, 1), base) {
			advance(l)
		} else {
			return
		}
	}
}

fn scan_number(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	# a number just after '.' is a bare decimal tuple index, never a float
	if l.prev == Kind.Dot {
		consume_dec(l)
		return emit(l, Kind.Int, sline, scol, lexeme_from(l, soff))
	}
	if at(l, 0) == b'0' and (at(l, 1) == b'x' or at(l, 1) == b'o' or at(l, 1) == b'b') {
		base := at(l, 1)
		advance(l) # 0
		advance(l) # x/o/b

		# a based literal needs a digit IMMEDIATELY after its prefix, which is what GRAMMAR
		# group 3 writes as `'0x' hex-digit ( '_'? hex-digit )*`: the first digit is part of
		# the prefix's own production, and only the ones after it may be grouped. `0x` on
		# its own consumed nothing, was emitted as an Int, and lowered to a C `0x` — which
		# cc read as the number zero, so a malformed literal compiled and answered 0.
		#
		# The question is put to the FIRST byte, not to how much `consume_based` swallowed,
		# because those two are not the same question and `0x_1F` is the difference.
		# `consume_based` takes a `_` whenever a valid digit follows it, which is the right
		# rule everywhere it is asked EXCEPT at the first position: a grouping `_` sits
		# between two digits, and here there is no digit to its left. A run LENGTH cannot
		# see that — `0x_1F` consumed four bytes, passed, and meant 31.
		lead := based_valid(at(l, 0), base)

		# the malformed run is consumed before it is reported so the whole of it lands in
		# ONE Illegal token. Reporting from where the bad byte was found would leave the
		# lexer standing inside the literal, and `_1F` would come back as an identifier —
		# one mistake, two messages, the second of them about a name nobody wrote.
		consume_based(l, base)
		return bad(l, Rule.BasedNumberNoDigit, "a based number needs a digit immediately after its prefix", sline, scol, lexeme_from(l, soff)) if not lead
		return emit(l, Kind.Int, sline, scol, lexeme_from(l, soff))
	}

	consume_dec(l)
	mut kind := Kind.Int

	# fractional part: '.' immediately followed by a digit
	if at(l, 0) == b'.' and ascii.is_digit(at(l, 1)) {
		kind = Kind.Float
		advance(l) # .
		consume_dec(l)
	}

	# exponent: e/E [sign] digits
	if at(l, 0) == b'e' or at(l, 0) == b'E' {
		nx := at(l, 1)
		if ascii.is_digit(nx) or (nx == b'+' or nx == b'-') and ascii.is_digit(at(l, 2)) {
			kind = Kind.Float
			advance(l) # e/E
			if at(l, 0) == b'+' or at(l, 0) == b'-' {
				advance(l)
			}
			consume_dec(l)
		}
	}
	return emit(l, kind, sline, scol, lexeme_from(l, soff))
}

# --- strings, runes, bytes, commands -------------------------------------------

# utf8_encode returns the UTF-8 bytes of a code point (for the '\u{...}' escape).
fn utf8_encode(cp: int) -> list[byte] {
	mut r: list[byte] = []
	if cp < 128 {
		r.append(byte(cp))
	} else if cp < 2048 {
		r.append(byte(192 + cp / 64))
		r.append(byte(128 + cp % 64))
	} else if cp < 65536 {
		r.append(byte(224 + cp / 4096))
		r.append(byte(128 + cp / 64 % 64))
		r.append(byte(128 + cp % 64))
	} else {
		r.append(byte(240 + cp / 262144))
		r.append(byte(128 + cp / 4096 % 64))
		r.append(byte(128 + cp / 64 % 64))
		r.append(byte(128 + cp % 64))
	}
	return r
}

# decode_escape consumes a backslash escape at the cursor and answers the VALUE it decodes
# to — a code point, or in byte_mode the octet a '\xHH' spells — or -1 for a malformed one,
# which the caller reports at the literal's own place (bad_escape). Answering -1 rather than
# raising is the whole point: `b'\xzz'` used to reach `byte(hi * 16 + lo)` with hex_val's
# -1 in it, and the COMPILER's own checked conversion aborted with `OverflowError` — no
# file, no line, no form named. A malformed escape is a fact about the source, and the
# person who wrote it is owed a place.
#
# Nothing here advances past a byte it has not accepted, so the caller's recovery starts
# where the mistake does. An escape this table does not name is -1 too, as the seed has it:
# quietly meaning `\q` as `q` reads as forgiveness right up until `\` gains a meaning.
fn decode_escape(mut &l: Lex, byte_mode: bool) -> int {
	advance(l) # backslash
	return -1 if eof(l)
	c := advance(l)

	return 10 if c == b'n'
	return 9 if c == b't'
	return 13 if c == b'r'
	return 0 if c == b'0'
	return 92 if c == b'\\'
	return 39 if c == b'\''

	# `\"` IS NOT A BYTE ESCAPE. GRAMMAR#byte-escape lists `n t r 0 \ '` and `\x` — and no
	# `"`, because the quote a byte literal has to escape is the single one that ends it.
	# GRAMMAR#escape, the rune/str set, is where `"` belongs. The two arms below already ask
	# which literal they are in (`\x` is byte-only, `\u` is rune/str-only); this one did not,
	# so `b'\"'` lexed to 34 and a program GRAMMAR does not derive compiled and ran.
	return 34 if c == b'"' and not byte_mode

	if c == b'x' and byte_mode {
		return -1 if not ascii.is_hex_digit(at(l, 0)) or not ascii.is_hex_digit(at(l, 1))

		hi := ascii.hex_val(advance(l))
		lo := ascii.hex_val(advance(l))
		return hi * 16 + lo
	}
	if c == b'u' and not byte_mode {
		return -1 if at(l, 0) != b'{'

		advance(l) # {
		mut cp := 0
		mut n := 0
		for ascii.is_hex_digit(at(l, 0)) {
			cp = cp * 16 + ascii.hex_val(advance(l))
			n = n + 1

			# clamped one past the code space, so a long run of digits cannot overflow the
			# checked multiply above — the clamp value itself still reads as out of range
			if cp > 1114111 {
				cp = 1114112
			}
		}
		return -1 if n == 0 or at(l, 0) != b'}'

		advance(l) # }

		# PAST U+10FFFF, OR A SURROGATE — NOT A CODE POINT, so not an escape. This used to
		# answer U+FFFD, matching what the seed's WriteRune does with a bad rune, and the
		# substitution was silent: `int('\u{110000}')` and `int('\u{D800}')` both printed
		# 65533, so a program that named one character got another with nothing said. -1 is
		# "not an escape", which the caller reports as E109 at the literal's own place.
		return -1 if cp > 1114111 or (cp >= 55296 and cp <= 57343)
		return cp
	}
	return -1
}

# eat_to_quote is THE RECOVERY POINT a malformed literal reports from: the rest of it, up
# to its closing quote or the line's end, whichever comes first. Returning from where the
# scan gave up left the lexer standing INSIDE the literal, so `b'ba'` was read as one bad
# token and then as a second rune literal starting at the surviving quote — one mistake,
# two messages, the second of them nonsense. A recovery point is part of a diagnostic, and
# it is one function because the two malformed-literal exits below both need exactly it.
fn eat_to_quote(mut &l: Lex, q: byte) {
	for not eof(l) and at(l, 0) != q and at(l, 0) != byte(10) {
		advance(l)
	}
	if at(l, 0) == q {
		advance(l)
	}
}

# bad_escape reports a malformed backslash escape, after recovering to the end of the
# literal. The noun names the literal form, as the seed's message does.
fn bad_escape(mut &l: Lex, noun: str, q: byte, sline: int, scol: int, soff: int) -> Token {
	eat_to_quote(l, q)
	return bad_escape_here(l, noun, sline, scol, soff)
}

# bad_escape_here is the SENTENCE, for a caller that has already recovered by itself: a
# triple-quoted string ends at `"""` rather than at a line break, so it walks its own way out
# and then says the same thing. One rule reported from two places is two rules wearing one
# code, and this was one — the gate that says so could not see it until a code moved out of a
# message and into an argument.
fn bad_escape_here(mut &l: Lex, noun: str, sline: int, scol: int, soff: int) -> Token {
	return bad(l, Rule.EscapeInvalid, f"invalid escape in a {noun} literal", sline, scol, lexeme_from(l, soff))
}

fn scan_string(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	return scan_triple_string(l, sline, scol, soff) if at(l, 1) == b'"' and at(l, 2) == b'"'
	advance(l) # opening "
	mut sb: list[byte] = []
	for true {
		return bad(l, Rule.StrUnterminated, "a string literal is not closed before the end of the line", sline, scol, lexeme_from(l, soff)) if eof(l) or at(l, 0) == byte(10)
		c := at(l, 0)
		if c == b'"' {
			advance(l)
			break
		}
		if c == b'\\' {
			v := decode_escape(l, false)
			return bad_escape(l, "string", b'"', sline, scol, soff) if v < 0

			for e in utf8_encode(v) {
				sb.append(e)
			}
		} else {
			sb.append(advance(l))
		}
	}
	return nul_bad(l, sline, scol, soff) if has_nul(sb)
	return emit_val(l, Kind.Str, sline, scol, lexeme_from(l, soff), str(sb))
}

# has_nul is the seed's NUL rule: a Zerg str is text, and the bridge that makes one refuses
# an interior NUL — so a string literal that decodes to one must be refused HERE, by name,
# or `"\0"` aborts the compiler itself with `EncodingError` at emit_val's `str(sb)`.
fn has_nul(sb: list[byte]) -> bool {
	for c in sb {
		return true if c == byte(0)
	}
	return false
}

# nul_bad is that refusal, once. Three literal forms can decode to a NUL — a plain string,
# a triple string and a raw string — and E110 is ONE row in docs/tooling/diagnostics.md, so
# the sentence is written here rather than at each of the three exits.
fn nul_bad(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	return bad(l, Rule.StrHoldsNul, "a string literal may not contain a NUL", sline, scol, lexeme_from(l, soff))
}

# scan_fstring scans an f-string as ONE token: the lexeme is the verbatim source `f"a{x}b"`
# and the value is the RAW inner text — holes, escapes and `{{` exactly as written. Cutting
# it into text and holes is the parser's job, which re-lexes each hole.
#
# Keeping the literal whole, rather than the seed's FStrBegin/LBrace/…/FStrEnd stream, is
# what lets `zerg fmt` print it back byte for byte. The formatter shares this lexer, and
# its printer treats every `{` as a block opener and every `}` as a closer — a hole's
# braces in the token stream would have it tear an f-string across four indented lines.
# The cost is that `zerg fmt` does not reach INSIDE a hole, and that `--emit tokens` no
# longer matches the seed for a source that has one.
fn scan_fstring(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	advance(l) # f
	advance(l) # opening "
	mut sb: list[byte] = []
	mut depth := 0 # 0 = literal text, above it = inside a `{ … }` hole
	for true {
		# An f-string RAISES where a plain string yields an Illegal token, and the reason is
		# that nothing downstream reads Illegal: parse_primary steps over it and answers
		# ENil, so a malformed literal would compile to a program that silently lacks it.
		# The forms below cannot be recovered from either — an unclosed hole has no end to
		# guess at — so the lexer is where they stop.
		raise "f-string: unterminated literal: " + lexeme_from(l, soff) if eof(l) or at(l, 0) == byte(10)
		c := at(l, 0)
		if depth > 0 {
			if c == b'{' {
				depth = depth + 1
			} else if c == b'}' {
				depth = depth - 1
			} else if c == b'"' or c == b'\'' {
				copy_quoted(l, sb, c)
				continue
			}
			sb.append(advance(l))
		} else if c == b'"' {
			advance(l) # closing "
			break
		} else if c == b'{' and at(l, 1) == b'{' {
			sb.append(advance(l))
			sb.append(advance(l))
		} else if c == b'}' and at(l, 1) == b'}' {
			sb.append(advance(l))
			sb.append(advance(l))
		} else if c == b'}' {
			raise "f-string: a bare '}' is not text — write '}}' for one: " + lexeme_from(l, soff)
		} else if c == b'{' {
			depth = 1
			sb.append(advance(l))
		} else if c == b'\\' {
			copy_escape(l, sb)
		} else {
			sb.append(advance(l))
		}
	}
	return emit_val(l, Kind.FStr, sline, scol, lexeme_from(l, soff), str(sb))
}

# copy_escape copies a backslash escape through VERBATIM, so the parser decodes it with the
# same table a plain string uses. `\u{…}` carries braces of its own, which is why the whole
# escape is taken here — two bytes would leave its `{` to be read as a hole.
fn copy_escape(mut &l: Lex, mut &sb: list[byte]) {
	sb.append(advance(l)) # backslash
	return if eof(l)
	c := advance(l)
	sb.append(c)
	return if c != b'u'
	for not eof(l) {
		e := advance(l)
		sb.append(e)
		break if e == b'}'
	}
}

# copy_quoted copies a string or rune literal written INSIDE a hole, escapes and all, so a
# brace or quote of its own is not read as the f-string's.
fn copy_quoted(mut &l: Lex, mut &sb: list[byte], q: byte) {
	sb.append(advance(l)) # opening quote
	for not eof(l) and at(l, 0) != byte(10) {
		if at(l, 0) == b'\\' {
			copy_escape(l, sb)
		} else {
			c := advance(l)
			sb.append(c)
			break if c == q
		}
	}
}

fn scan_triple_string(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	advance(l)
	advance(l)
	advance(l) # opening """
	mut sb: list[byte] = []
	for true {
		return bad(l, Rule.TripleStrUnterminated, "a triple-quoted string is never closed", sline, scol, lexeme_from(l, soff)) if eof(l)
		if at(l, 0) == b'"' and at(l, 1) == b'"' and at(l, 2) == b'"' {
			advance(l)
			advance(l)
			advance(l)
			break
		}
		if at(l, 0) == b'\\' {
			v := decode_escape(l, false)
			if v < 0 {
				# recovery to the closing """ by hand: bad_escape stops at a line break,
				# and a line break is exactly what this literal is allowed to hold
				for not eof(l) {
					if at(l, 0) == b'"' and at(l, 1) == b'"' and at(l, 2) == b'"' {
						advance(l)
						advance(l)
						advance(l)
						break
					}
					advance(l)
				}
				return bad_escape_here(l, "string", sline, scol, soff)
			}
			for e in utf8_encode(v) {
				sb.append(e)
			}
		} else {
			sb.append(advance(l))
		}
	}
	return nul_bad(l, sline, scol, soff) if has_nul(sb)
	return emit_val(l, Kind.Str, sline, scol, lexeme_from(l, soff), str(sb))
}

fn scan_raw_string(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	advance(l) # r
	advance(l) # opening "
	mut sb: list[byte] = []
	for true {
		return bad(l, Rule.RawStrUnterminated, "a raw string has no closing quote on this line", sline, scol, lexeme_from(l, soff)) if eof(l) or at(l, 0) == byte(10)
		break if at(l, 0) == b'"'

		sb.append(advance(l))
	}
	advance(l) # closing "
	return nul_bad(l, sline, scol, soff) if has_nul(sb)
	return emit_val(l, Kind.RawStr, sline, scol, lexeme_from(l, soff), str(sb))
}

# scan_char_lit scans a single-quoted rune or byte literal; the cursor sits on the
# opening quote, and byte_mode selects the byte form's '\xHH' escape.
fn scan_char_lit(mut &l: Lex, kind: Kind, byte_mode: bool, sline: int, scol: int, soff: int) -> Token {
	advance(l) # opening '
	mut sb: list[byte] = []
	return bad(l, Rule.RuneEmpty, "a rune literal is empty — it holds exactly one character", sline, scol, lexeme_from(l, soff)) if eof(l) or at(l, 0) == byte(10) or at(l, 0) == b'\''
	mut val := 0
	if at(l, 0) == b'\\' {
		val = decode_escape(l, byte_mode)
		if val < 0 {
			return bad_escape(l, "byte", b'\'', sline, scol, soff) if byte_mode
			return bad_escape(l, "rune", b'\'', sline, scol, soff)
		}
	} else {
		# ONE CHARACTER IS ONE CODE POINT, and in UTF-8 that is one to four BYTES. Taking a
		# single byte made `'é'` two characters as far as this scanner was concerned, so a
		# literal the language allows was reported as holding more than one — the source is
		# UTF-8 and the rule is about what it spells, not about how wide the spelling is.
		#
		# A byte literal is the other rule and keeps the single byte: `b'…'` names an octet,
		# which is exactly what the width of a code point is not.
		sb.append(advance(l))
		if not byte_mode {
			mut more := rune_len(sb[0]) - 1
			for more > 0 and not eof(l) and at(l, 0) != b'\'' {
				sb.append(advance(l))
				more = more - 1
			}
		}
	}
	if at(l, 0) != b'\'' {
		eat_to_quote(l, b'\'')
		return bad(l, Rule.RuneTooLong, "a rune literal holds exactly one character, and this holds more", sline, scol, lexeme_from(l, soff))
	}
	advance(l) # closing '

	# THE VALUE RIDES AS A DECIMAL SPELLING, not as the character itself. Token.value is a
	# `str`, and the str bridge validates: `str(sb)` RAISED for the one byte `\x80` (not
	# UTF-8) and for `\x00` (an interior NUL), so the compiler itself aborted with
	# `EncodingError` on half the range GRAMMAR's byte-escape grants — the values a `byte`
	# exists for — and again on the rune `'\0'`, which the seed accepts. A code point is not
	# text any more than an octet is, and no str can be asked to carry either; the number
	# always can, and it is already the spelling the parser's EInt wants to hold.
	#
	# An escape arrives with its value decoded (decode_escape); a character written plainly
	# is read off its source bytes — one byte IS the value, and a multi-byte code point goes
	# through rune_value, the audited decoder, exactly as the parser used to send it.
	if sb.len() == 1 {
		val = int(sb[0])
	} else if sb.len() > 1 {
		val = rune_value(str(sb))
	}
	return emit_val(l, kind, sline, scol, lexeme_from(l, soff), strconv.to_string(val, 10))
}

fn scan_cmd(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	advance(l) # opening `
	mut sb: list[byte] = []
	for true {
		return bad(l, Rule.CommandUnterminated, "a command literal has no closing backtick", sline, scol, lexeme_from(l, soff)) if eof(l)
		if at(l, 0) == b'`' {
			advance(l)
			break
		}
		sb.append(advance(l))
	}
	return emit_val(l, Kind.Cmd, sline, scol, lexeme_from(l, soff), str(sb))
}

# --- operators and punctuation -------------------------------------------------

# op advances `extra` further bytes past the already-consumed first, then emits.
fn op(mut &l: Lex, k: Kind, sline: int, scol: int, soff: int, extra: int) -> Token {
	mut i := 0
	for i < extra {
		advance(l)
		i = i + 1
	}
	return emit(l, k, sline, scol, lexeme_from(l, soff))
}

fn scan_operator(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	c := advance(l)
	two := at(l, 0)
	if c == b'+' {
		return op(l, Kind.PlusMod, sline, scol, soff, 1) if two == b'%'
		return op(l, Kind.Plus, sline, scol, soff, 0)
	}
	if c == b'-' {
		return op(l, Kind.MinusMod, sline, scol, soff, 1) if two == b'%'
		return op(l, Kind.Arrow, sline, scol, soff, 1) if two == b'>'

		return op(l, Kind.Minus, sline, scol, soff, 0)
	}
	if c == b'*' {
		return op(l, Kind.StarMod, sline, scol, soff, 1) if two == b'%'
		return op(l, Kind.Star, sline, scol, soff, 0)
	}

	# `//` is floor division, not a comment: a Zerg comment starts with '#'.
	if c == b'/' {
		return op(l, Kind.SlashDiv, sline, scol, soff, 1) if two == b'/'
		return op(l, Kind.Slash, sline, scol, soff, 0)
	}

	return op(l, Kind.Percent, sline, scol, soff, 0) if c == b'%'
	return op(l, Kind.Amp, sline, scol, soff, 0) if c == b'&'
	return op(l, Kind.Pipe, sline, scol, soff, 0) if c == b'|'
	return op(l, Kind.Caret, sline, scol, soff, 0) if c == b'^'
	return op(l, Kind.Tilde, sline, scol, soff, 0) if c == b'~'

	if c == b'<' {
		return op(l, Kind.Shl, sline, scol, soff, 1) if two == b'<'
		return op(l, Kind.Le, sline, scol, soff, 1) if two == b'='
		return op(l, Kind.LArrow, sline, scol, soff, 1) if two == b'-'

		return op(l, Kind.Lt, sline, scol, soff, 0)
	}
	if c == b'>' {
		return op(l, Kind.Shr, sline, scol, soff, 1) if two == b'>'
		return op(l, Kind.Ge, sline, scol, soff, 1) if two == b'='

		return op(l, Kind.Gt, sline, scol, soff, 0)
	}
	if c == b'=' {
		return op(l, Kind.EqEq, sline, scol, soff, 1) if two == b'='
		return op(l, Kind.FatArrow, sline, scol, soff, 1) if two == b'>'

		return op(l, Kind.Assign, sline, scol, soff, 0)
	}
	if c == b'!' {
		return op(l, Kind.Ne, sline, scol, soff, 1) if two == b'='
		return op(l, Kind.Bang, sline, scol, soff, 0)
	}
	if c == b':' {
		return op(l, Kind.Walrus, sline, scol, soff, 1) if two == b'='
		return op(l, Kind.Colon, sline, scol, soff, 0)
	}
	if c == b'?' {
		return op(l, Kind.Coalesce, sline, scol, soff, 1) if two == b'?'
		return op(l, Kind.OptDot, sline, scol, soff, 1) if two == b'.'

		return op(l, Kind.Question, sline, scol, soff, 0)
	}
	if c == b'.' {
		if two == b'.' {
			return op(l, Kind.DotDotEq, sline, scol, soff, 2) if at(l, 1) == b'='
			return op(l, Kind.DotDot, sline, scol, soff, 1)
		}
		return op(l, Kind.Dot, sline, scol, soff, 0)
	}
	return op(l, Kind.Comma, sline, scol, soff, 0) if c == b','
	if c == b'(' {
		l.depth = l.depth + 1
		return op(l, Kind.LParen, sline, scol, soff, 0)
	}
	if c == b')' {
		if l.depth > 0 {
			l.depth = l.depth - 1
		}
		return op(l, Kind.RParen, sline, scol, soff, 0)
	}
	if c == b'[' {
		l.depth = l.depth + 1
		return op(l, Kind.LBrack, sline, scol, soff, 0)
	}
	if c == b']' {
		if l.depth > 0 {
			l.depth = l.depth - 1
		}
		return op(l, Kind.RBrack, sline, scol, soff, 0)
	}
	if c == b'{' {
		brace_push(l)
		return op(l, Kind.LBrace, sline, scol, soff, 0)
	}
	if c == b'}' {
		brace_pop(l)
		return op(l, Kind.RBrace, sline, scol, soff, 0)
	}
	return op(l, Kind.Semi, sline, scol, soff, 0) if c == b';'

	return bad_char(l, sline, scol, soff)
}

# bad_char is E104's ONE reporting site. Two characters reach it — an ASCII one no operator
# claims, and a non-ASCII one scan_nonascii has consumed whole — and they are one rule, so
# they are one code and therefore one raise (scripts/error-codes-check.sh counts a code
# reported twice as two rules sharing an identity).
fn bad_char(mut &l: Lex, sline: int, scol: int, soff: int) -> Token {
	return bad(l, Rule.CharNotAToken, "this character is not part of any Zerg token", sline, scol, lexeme_from(l, soff))
}

# brace_push saves the enclosing paren/bracket depth and resets it, so ASI resumes
# inside a '{ }' block even when the brace itself sits in an unclosed '(' or '['.
fn brace_push(mut &l: Lex) {
	if l.sp < l.stack.len() {
		l.stack[l.sp] = l.depth
	} else {
		l.stack.append(l.depth)
	}
	l.sp = l.sp + 1
	l.depth = 0
}

fn brace_pop(mut &l: Lex) {
	if l.sp > 0 {
		l.sp = l.sp - 1
		l.depth = l.stack[l.sp]
	}
}

# --- public surface ------------------------------------------------------------

# tokenize scans src to completion, returning the token stream terminated by an Eof
# token.
fn tokenize(src: str) -> list[Token] {
	return lex_with(src, false)
}

# tokenize_trivia lexes with comments retained, for the formatter.
# lex_diags is every LEXICAL error in a source: one per token the lexer could not read,
# each with the reason it recorded and the place it recorded it at.
#
# It is a pass of its own, run before anything is parsed, because these are errors about
# TEXT and nothing further along can say anything true about them. Without it an illegal
# token reached parse_primary's fallback, which answered "`b'b` is not an expression this
# compiler reads" — the wrong layer, the wrong problem, and a lexeme that is a fragment of
# what the person wrote.
pub fn lex_diags(src: str, path: str) -> list[Diag] {
	mut out: list[Diag] = []
	for t in tokenize(src) {
		if t.kind == Kind.Illegal {
			b := bytearray(t.value)
			at := lex_code_end(b)
			out.append(Diag(path, t.line, t.col, fstr_slice(b, 0, at), fstr_slice(b, at + 1, b.len()), ""))
		}
	}
	return out
}

fn tokenize_trivia(src: str) -> list[Token] {
	return lex_with(src, true)
}

fn lex_with(src: str, keep: bool) -> list[Token] {
	b := bytearray(src)
	mut l := Lex(b, b.len(), 0, 1, 1, 0, [], 0, Kind.Semi, keep)
	mut out: list[Token] = []
	for true {
		t := next(l)
		out.append(t)
		break if is_eof(t.kind)
	}
	return out
}

fn is_eof(k: Kind) -> bool {
	return match k {
		Kind.Eof => true
		_        => false
	}
}

# int_value is what an integer lexeme is WORTH: decimal, `0x` / `0o` / `0b`, with `_` groups
# anywhere between digits (GRAMMAR, group 2). It lives here because that is a LEXICAL fact
# about the literal rather than a fact about the program — the emitter renders C from it and
# the formatter compares two of them to tell `1 | 2` from `1 | 3`, and a second implementation
# of the same base-prefix rules is one that will disagree with this one eventually.
#
# It reads a bare magnitude: a leading `-` is a separate token, so no lexeme reaches here with
# a sign on it.
pub fn int_value(lex: str) -> int {
	v := int_scan(lex)

	# a literal past i64 is a compile error (docs/core/types.md), reported where the place
	# is known; this is only asked afterwards, so the wrapped value never reaches C
	return 0 if v < 0

	return v
}

# rune_len is how many BYTES the code point starting with this one occupies, read off the
# lead byte the way UTF-8 encodes it. It is the scanner's half of the same fact rune_value
# decodes, and they are written together so a change to one is read beside the other.
fn rune_len(b0: byte) -> int {
	n := int(b0)

	return 1 if n < 0x80
	return 2 if n >= 0xC0 and n < 0xE0
	return 3 if n >= 0xE0 and n < 0xF0
	return 4 if n >= 0xF0

	return 1
}

# rune_value is the code point a rune literal holds. It DELEGATES: `runearray(s)` is the
# runtime's decoder (zrt_str_runes), which is the one the emitted programs use and the one
# that rejects overlongs and surrogates. A hand-rolled continuation-byte fold here would be
# a third UTF-8 decoder, one call away from the audited one, silently accepting what it
# refuses — and every correctness fix would then have two homes with tests in one.
#
# A rune literal is exactly one code point by construction, the scanner having already
# refused a literal holding more.
pub fn rune_value(text: str) -> int {
	rs := runearray(text)
	return 0 if rs.len() == 0

	return int(rs[0])
}

# int_fits reports whether an integer literal is representable in an i64. A literal that
# does not fit its required type is a COMPILE ERROR and never a runtime overflow
# (docs/core/types.md) — which the seed has always enforced and this compiler had not, so
# `9223372036854775808` printed -9223372036854775808 and `0xFFFFFFFFFFFFFFFFF` printed -1.
pub fn int_fits(lex: str) -> bool {
	return int_scan(lex) >= 0
}

# int_scan reads a literal in any of the four bases, answering -1 when the value overflows
# an i64. A literal is never negative — the `-` in `-1` is a unary operator, not part of the
# token — so -1 is not a value this can otherwise return, and one scan answers both
# questions above.
fn int_scan(lex: str) -> int {
	b := bytearray(lex)
	n := b.len()
	mut base := 10
	mut start := 0
	if n >= 2 and b[0] == b'0' {
		c := b[1]
		if c == b'x' or c == b'X' {
			base = 16
			start = 2
		} else if c == b'o' or c == b'O' {
			base = 8
			start = 2
		} else if c == b'b' or c == b'B' {
			base = 2
			start = 2
		}
	}
	mut val := 0
	mut i := start
	for i < n {
		ch := b[i]
		if ch != b'_' {
			d := ascii.hex_val(ch)

			# the test is done BEFORE the multiply, on the largest value that can still
			# survive it; testing afterwards would be reading a number that has already
			# wrapped, which is the defect this exists to catch
			return 0 - 1 if val > (9223372036854775807 - d) / base

			val = val * base + d
		}
		i = i + 1
	}
	return val
}

# --- the uint half of an integer literal -------------------------------------------
#
# `int_scan` stops at i64, which is the right bound for a literal with no position to ask —
# the default. It is the wrong bound for one whose position says `uint`: half of that type's
# values are ordinary numbers, reachable by arithmetic, and were unwritable as literals
# (docs/core/types.md marked it). The scan is the same walk with the other bound.
#
# Two functions rather than one returning an optional, because the compiler's own subset reads
# this file and a struct is the plainer thing for it to carry.

pub struct UintLit {
	pub ok: bool
	pub value: uint
}

pub fn uint_fits(lex: str) -> bool {
	return uint_scan(lex).ok
}

pub fn uint_value(lex: str) -> uint {
	return uint_scan(lex).value
}

# uint_scan reads a literal in any of the four bases against the u64 bound. Like int_scan it
# tests BEFORE the multiply, on the largest value that can still survive it — testing after
# would be reading a number that has already wrapped, and here it would also abort, since the
# compiler's own arithmetic is checked.
pub fn uint_scan(lex: str) -> UintLit {
	b := bytearray(lex)
	n := b.len()
	mut base := uint(10)
	mut start := 0
	if n >= 2 and b[0] == b'0' {
		c := b[1]
		if c == b'x' or c == b'X' {
			base = uint(16)
			start = 2
		} else if c == b'o' or c == b'O' {
			base = uint(8)
			start = 2
		} else if c == b'b' or c == b'B' {
			base = uint(2)
			start = 2
		}
	}

	hi := uint(9223372036854775807) * uint(2) + uint(1)
	mut val := uint(0)
	mut i := start
	for i < n {
		ch := b[i]
		if ch != b'_' {
			d := uint(ascii.hex_val(ch))
			return UintLit(false, uint(0)) if val > (hi - d) / base

			val = val * base + d
		}
		i = i + 1
	}
	return UintLit(true, val)
}

# token_category classifies a kind for rendering: 1 -> NAME(lexeme), 2 -> NAME(quoted
# value), 0 -> the bare kind name.
fn token_category(k: Kind) -> int {
	return match k {
		Kind.Int => 1
		Kind.Float => 1
		Kind.Ident => 1
		Kind.Str => 2
		Kind.FStr => 2
		Kind.RawStr => 2
		Kind.Rune => 2
		Kind.Byte => 2
		Kind.Cmd => 2
		Kind.FStrBegin => 2
		Kind.FStrText => 2
		Kind.FCmdBegin => 2
		Kind.FCmdText => 2
		Kind.Conv => 2
		Kind.FmtSpec => 2
		_ => 0
	}
}

# quote renders s the way Go's %q does for the common cases: wrapped in double quotes
# with the standard escapes and an '\xHH' fallback for other control bytes.
#
# This is the TOKEN DUMP's spelling — `--emit tokens` is diff-tested byte for byte against
# the seed's, which renders Go's %q. It is NOT a C string literal: C's '\x' consumes as
# many hex digits as follow it, so a non-ASCII byte before one runs on. `c_str_lit` in
# emit.zg is the C one, and it uses octal for exactly that reason.
fn quote(s: str) -> str {
	mut out: list[byte] = []
	out.append(byte(34)) # "
	for c in bytearray(s) {
		v := int(c)
		if v == 34 {
			out.append(byte(92))
			out.append(byte(34))
		} else if v == 92 {
			out.append(byte(92))
			out.append(byte(92))
		} else if v == 10 {
			out.append(byte(92))
			out.append(b'n')
		} else if v == 9 {
			out.append(byte(92))
			out.append(b't')
		} else if v == 13 {
			out.append(byte(92))
			out.append(b'r')
		} else if v >= 32 and v <= 126 {
			out.append(c)
		} else {
			out.append(byte(92))
			out.append(b'x')
			out.append(hex_digit(v / 16))
			out.append(hex_digit(v % 16))
		}
	}
	out.append(byte(34)) # "
	return str(out)
}

fn hex_digit(n: int) -> byte {
	return byte(48 + n) if n < 10
	return byte(97 + n - 10)
}

fn render_token(t: Token) -> str {
	cat := token_category(t.kind)

	return f"{kind_name(t.kind)}({t.lexeme})" if cat == 1
	return f"{kind_name(t.kind)}({quote(t.value)})" if cat == 2

	return kind_name(t.kind)
}

# dump_tokens renders the whole stream in the bootstrap's `--emit tokens` format —
# `line:col\t<token>` per line, the Eof token omitted — for byte-exact diff-testing.
pub fn dump_tokens(src: str) -> str {
	toks := tokenize(src)
	mut out: list[byte] = []
	mut i := 0
	for i < toks.len() {
		t := toks[i]
		break if is_eof(t.kind)

		line := strconv.to_string(t.line, 10)
		col := strconv.to_string(t.col, 10)
		s := f"{line}:{col}\t{render_token(t)}\n"
		for c in bytearray(s) {
			out.append(c)
		}
		i = i + 1
	}
	return str(out)
}
