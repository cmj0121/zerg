# The formatter rewrites a source in the one canonical style, from TOKENS rather than
# from the AST. That is the whole design decision: an AST has already thrown away the
# comments and the blank lines a reader put there, and a formatter that eats those is one
# nobody runs twice. The token stream keeps them (lexer's trivia mode), so this pass can
# be strict about spacing and indentation while leaving everything a human wrote in place.
#
# Every rule has a CODE, so it can be named — in a diagnostic, in a review, on a command
# line that turns it off. The prefix groups them, the way a Python linter's does, and the
# grouping is by WHAT A RULE DOES rather than by which pass implements it:
#
#   F1xx  layout        where the line breaks and how far it is indented
#   F2xx  spacing       where a space goes between two tokens
#   F3xx  trivia        what happens to what a person wrote for a person
#   F4xx  rewrites      the rules that MOVE code rather than space it
#
# The full table, and the same one docs/tooling/fmt.md carries:
#
#   F101  one tab per nesting level; `}` closes at the level it opened
#   F102  one statement per line — the lexer's inserted `;` IS the line break
#   F103  a wrapped expression continues one level in per open bracket
#   F104  a run of blank lines survives as exactly one
#   F105  a group that spans lines closes on its own line
#   F106  a run of arms lands every `=>` in one column
#   F107  a run of trailing comments lands every `#` in one column
#   F201  one space around a binary operator, after a comma, at least one around `=>`
#   F202  no space after `(` `[`, before `)` `]` `,`, or between a name and its `(`
#   F203  a prefix operator is tight to its operand — `-1`, `&x`, `<-ch`
#   F204  a range operator is tight to both its bounds — `0..n`, `a..=b`
#   F301  a comment keeps its text, on its own line or trailing the code it followed
#   F401  a one-jump if-block becomes the postfix guard it is sugar for —
#         `return x if c`, `break if c`, `continue if c`
#   F402  imports group — standard library first, then the rest — each group alphabetical
#   F403  an argument list is one line, or one element per line — never half of each
#   F404  two or more imports become one parenthesized group
#   F405  a string built with `+` becomes the f-string it already is
#   F406  a blank line where one is load-bearing — guard runs, declaration runs, comments
#   F407  a discarded receive binder drops — `_ := <-ch => …` is `<-ch => …`
#   F408  an or-pattern over consecutive integers becomes the range it is — `1 | 2` is `1..=2`
#
# F1xx-F3xx are not negotiable: they are what "canonical" means, and a formatter with
# options for them is a formatter two people configure differently. F4xx is different —
# it changes the code's SHAPE, not its spacing — so it is the group that can be switched
# off, and `zerg fmt --off F401` does. F105 sits in layout rather than in rewrites because
# it only decides where an existing token goes.
#
# The formatter is idempotent by construction: the output is built from the same token
# stream the input would produce, so formatting formatted source changes nothing. A rule
# that MOVES code is a pre-pass over the tokens, so the printer stays one straight walk
# and the rewrite is not tangled through it.

# fmt_balanced is whether a source's brackets close, which is the one structural fact
# every spacing rule below leans on. It is the gate the driver applies BEFORE writing,
# because fmt reads the token stream rather than the tree: without it a file with a syntax
# error came back reformatted, exit 0, nothing said — `fn main( {` as `fn main({` and
# `print("hi")` as `print ("hi")`, the tokens intact but the spacing decided by rules that
# had nothing true to work from.
#
# It is deliberately NOT a parse. A formatter has to work on source the compiler cannot
# COMPILE — that is exactly when a person reaches for one — and this parser refuses 26
# forms the language has and this compiler has not built. So this asks the weaker question
# fmt actually depends on, and it says so: a file that balances but is still ill-formed
# (`x := = 1`) is formatted as before. The stronger gate becomes available when a syntax
# error and a NotImplemented refusal stop being the same kind of abort.
pub fn fmt_balanced(src: str) -> bool {
	mut depth := 0
	for t in tokenize_trivia(src) {
		# `Hash` is `#[`, ONE token that opens a bracket the matching `]` closes as an
		# ordinary RBrack — so a decorator reads as one close too many unless it is counted
		# here. Every `#[derive(…)]` in the tree tripped this on the first attempt.
		if t.kind == Kind.LParen or t.kind == Kind.LBrack or t.kind == Kind.LBrace or t.kind == Kind.Hash {
			depth = depth + 1
		}
		if t.kind == Kind.RParen or t.kind == Kind.RBrack or t.kind == Kind.RBrace {
			depth = depth - 1

			# a close with nothing open: the rest of the file cannot be read either
			return false if depth < 0
		}
	}
	return depth == 0
}

# fmt_src_off is fmt_src with the named rules switched off.
pub fn fmt_src_off(src: str, off: list[str]) -> str {
	mut toks := tokenize_trivia(src)
	if not fmt_is_off(off, "F401") {
		toks = fmt_guards(toks)
	}
	if not fmt_is_off(off, "F407") {
		toks = fmt_discards(toks)
	}
	if not fmt_is_off(off, "F408") {
		toks = fmt_ranges(toks)
	}
	if not fmt_is_off(off, "F409") {
		toks = fmt_withs(toks)
	}
	if not fmt_is_off(off, "F402") {
		toks = fmt_imports(toks)
	}
	if not fmt_is_off(off, "F404") {
		toks = fmt_import_group(toks)
	}
	if not fmt_is_off(off, "F405") {
		toks = fmt_fstr(toks)
	}
	if not fmt_is_off(off, "F403") {
		toks = fmt_wrap(toks)
	}
	if not fmt_is_off(off, "F406") {
		toks = fmt_blank(toks)
	}
	return fmt_toks(toks, fmt_is_off(off, "F105"))
}

fn fmt_is_off(off: list[str], code: str) -> bool {
	for c in off {
		return true if c == code
	}
	return false
}

# --- rule F401: an if-block whose only statement JUMPS becomes the postfix guard ------------
#
# GRAMMAR defines `return x if c`, `break if c` and `continue if c` as sugar for
# `if c { … }` around the same jump — one postfix `if`, three jumps. So the two forms say
# the same thing and one of them says it in four lines. The formatter picks the short one,
# which is what a guard clause is for: the exceptional exit stops interrupting the shape of
# the code it guards.
#
# Preferring the sugar is the general rule here, not a special case for `return`: where the
# language offers a shorter surface for exactly what is written, the canonical form is the
# shorter one, and a reader stops having to notice that the two are the same thing.
#
# It rewrites only what it can rewrite WITHOUT LOSING anything:
#
#   * exactly one statement in the block, and it is a jump;
#   * no `else` — an else has a second branch that the guard form cannot carry;
#   * no comment anywhere inside, because a comment is something a person put there and
#     this pass has nowhere to put it back.
#
# Anything else is left exactly as written. A formatter that ate a comment is a formatter
# nobody runs twice.
fn fmt_guards(mut &toks: list[Token]) -> list[Token] {
	mut out: list[Token] = []
	mut i := 0
	for i < toks.len() {
		lb := fmt_guard_at(toks, i, out)
		if lb > 0 {
			rb := fmt_block_end(toks, lb)
			fmt_emit_guard(toks, i, lb, rb, out)
			i = rb + 1
		} else {
			out.append(toks[i])
			i = i + 1
		}
	}
	return out
}

# fmt_guard_at answers with the `{` of a rewritable if-block starting at `at`, or 0 when
# the shape is anything else. Every reason to decline is here, in one place.
fn fmt_guard_at(mut &toks: list[Token], at: int, mut &out: list[Token]) -> int {
	return 0 if toks[at].kind != Kind.If or fmt_is_else_if(out)
	lb := fmt_block_start(toks, at)
	return 0 if lb == 0
	rb := fmt_block_end(toks, lb)
	return 0 if rb == 0 or not fmt_is_lone_jump(toks, lb, rb) or fmt_has_else(toks, rb)
	return lb
}

# fmt_emit_guard writes `<jump> <value?> if <cond>` from the pieces of `if <cond> { <jump>
# <value?> }`, all on the `if`'s own line so the printer lays it out as one statement.
fn fmt_emit_guard(mut &toks: list[Token], at: int, lb: int, rb: int, mut &out: list[Token]) {
	ln := toks[at].line
	col := toks[at].col
	jump := fmt_jump_at(toks, lb)

	# the jump as it was written — `return`, `break` or `continue`
	out.append(fmt_on_line(toks[jump], ln))

	# a returned value, if there is one: everything between the jump and the `}`, minus
	# the separators. `break` and `continue` carry none, so this loop runs zero times.
	mut i := jump + 1
	for i < rb {
		if not is_semi(toks[i].kind) {
			out.append(fmt_on_line(toks[i], ln))
		}
		i = i + 1
	}
	out.append(Token(Kind.If, "if", "", ln, col))

	# the condition: everything between `if` and the `{`
	mut j := at + 1
	for j < lb {
		out.append(fmt_on_line(toks[j], ln))
		j = j + 1
	}
	out.append(Token(Kind.Semi, ";", "", ln, col))
}

fn fmt_on_line(t: Token, ln: int) -> Token {
	return Token(t.kind, t.lexeme, t.value, ln, t.col)
}

# fmt_block_start finds the `{` that opens the if's block: the first one at bracket depth
# zero, so a `{` inside the condition's parentheses is not mistaken for it. It answers 0
# when the shape is not an if-block at all.
fn fmt_block_start(mut &toks: list[Token], at: int) -> int {
	mut depth := 0
	mut i := at + 1
	for i < toks.len() {
		k := toks[i].kind
		if is_open(k) {
			depth = depth + 1
		} else if is_close(k) {
			depth = depth - 1
		} else if is_lbrace(k) and depth == 0 {
			return i
		} else if is_semi(k) or is_comment(k) {
			return 0
		}
		i = i + 1
	}
	return 0
}

fn fmt_block_end(mut &toks: list[Token], lb: int) -> int {
	mut depth := 0
	mut i := lb
	for i < toks.len() {
		if is_lbrace(toks[i].kind) {
			depth = depth + 1
		} else if is_rbrace(toks[i].kind) {
			depth = depth - 1
			return i if depth == 0
		}
		i = i + 1
	}
	return 0
}

# fmt_is_lone_jump reports whether the block holds exactly one statement, a jump, with no
# comment and no nested block.
fn fmt_is_lone_jump(mut &toks: list[Token], lb: int, rb: int) -> bool {
	r := fmt_jump_at(toks, lb)
	return false if r < 0
	mut i := r + 1
	for i < rb {
		k := toks[i].kind

		# an `if` here is the jump's OWN postfix guard, and two of them is not a form: this
		# rule used to produce `return 0 if n < 0 if m` from `if m { return 0 if n < 0 }` —
		# source the compiler cannot parse, written by the tool that is supposed to preserve
		# meaning. There is no single guard that says what the nesting says, so the block
		# stays a block. (An if-EXPRESSION being returned is already declined by the `{`.)
		return false if is_comment(k) or is_lbrace(k) or k == Kind.If

		if is_semi(k) and fmt_more_after(toks, i, rb) {
			return false # a second statement
		}
		i = i + 1
	}
	return true
}

# fmt_jump_at is the index of the block's jump — `return`, `break` or `continue` — skipping
# the separators the lexer put after the `{`, or -1 when the first thing in the block is
# not one.
fn fmt_jump_at(mut &toks: list[Token], lb: int) -> int {
	mut i := lb + 1
	for i < toks.len() {
		k := toks[i].kind
		if is_semi(k) {
			i = i + 1
		} else if is_jump(k) {
			return i
		} else {
			return -1
		}
	}
	return -1
}

fn fmt_more_after(mut &toks: list[Token], at: int, rb: int) -> bool {
	mut i := at + 1
	for i < rb {
		return true if not is_semi(toks[i].kind)
		i = i + 1
	}
	return false
}

fn fmt_has_else(mut &toks: list[Token], rb: int) -> bool {
	mut i := rb + 1
	for i < toks.len() {
		k := toks[i].kind
		if is_semi(k) {
			i = i + 1
		} else {
			return k == Kind.Else
		}
	}
	return false
}

# fmt_is_else_if reports whether the `if` about to be read is the tail of an `else if`,
# which is a branch of an existing chain rather than a guard of its own.
fn fmt_is_else_if(mut &out: list[Token]) -> bool {
	return false if out.len() == 0
	return out[out.len() - 1].kind == Kind.Else
}

# fmt_stmt_start reports whether the token at `at` begins a statement — nothing but a
# separator, a brace or a comment stands in front of it.
fn fmt_stmt_start(mut &toks: list[Token], at: int) -> bool {
	return true if at == 0
	k := toks[at - 1].kind
	return is_semi(k) or is_lbrace(k) or is_rbrace(k) or is_comment(k)
}

# --- rule F409: a bare block that opens with a binding is a `with` ------------------------
#
# GRAMMAR defines `with` BY EXPANSION — `with e as x { … }` is `{ x := e; … }` — so a bare
# block whose first statement binds is already a `with`, written the long way. The rewrite
# says so, and it is the same move F401 makes on the other sugar the grammar defines that
# way.
#
# It fires on a bare block only, which `fmt_stmt_start` is what decides: a struct literal's
# `{` follows a type name and a function body's follows a `)`, so neither is at the start of
# a statement. And it takes only the plain `x := e` form — a `mut` binding or an annotated
# one says something `with` does not, so folding either would be a rewrite that changed the
# program rather than its spelling.
#
# WHAT IT MUST NOT DO is fold the binding's teardown in with it. `with` carries no teardown
# of its own, so a rule keyed on `{ x := e; defer x.close(); … }` would have to drop the
# `defer` to produce one — which deletes a line somebody wrote. Nothing here is keyed on a
# `defer`: whatever follows the binding stays inside the block, in order.
fn fmt_withs(mut &toks: list[Token]) -> list[Token] {
	mut out: list[Token] = []
	mut i := 0
	for i < toks.len() {
		end := fmt_with_bind_end(toks, i)
		if end < 0 {
			out.append(toks[i])
			i = i + 1
		} else {
			ln := toks[i].line
			col := toks[i].col
			out.append(Token(Kind.With, "with", "", ln, col))

			# the head is ONE line, so every token it is built from is re-lined onto the `{`'s.
			# The expression came from the line below and would otherwise be printed there,
			# which is where the block used to open.
			mut j := i + 3
			for j < end {
				out.append(fmt_on_line(toks[j], ln))
				j = j + 1
			}
			out.append(Token(Kind.As, "as", "", ln, col))
			out.append(fmt_on_line(toks[i + 1], ln))
			out.append(toks[i])

			# the binding's `;` is KEPT, and it is what stops a blank line appearing where the
			# binding was. A `;` prints nothing and still moves the printer's `prev_line`, which
			# is the same mechanism that lets F401 collapse a four-line if-block onto one line
			# (see fmt_blank's note); consuming it here left the gap open.
			i = end
		}
	}
	return out
}

# fmt_with_bind_end answers the index of the `;` that ends the binding a bare block opens
# with, or -1 when this is not that shape. Every reason to decline is here, in one place.
fn fmt_with_bind_end(mut &toks: list[Token], at: int) -> int {
	return 0 - 1 if at + 3 >= toks.len()
	return 0 - 1 if not is_lbrace(toks[at].kind) or not fmt_stmt_start(toks, at)
	return 0 - 1 if toks[at + 1].kind != Kind.Ident or toks[at + 1].lexeme == "_"
	return 0 - 1 if toks[at + 2].kind != Kind.Walrus

	mut depth := 0
	mut i := at + 3
	for i < toks.len() {
		k := toks[i].kind
		if is_lbrace(k) or k == Kind.LParen or k == Kind.LBrack {
			depth = depth + 1
		} else if is_rbrace(k) or k == Kind.RParen or k == Kind.RBrack {
			return 0 - 1 if depth == 0

			depth = depth - 1
		} else if is_semi(k) and depth == 0 {
			return 0 - 1 if i == at + 3

			return i
		}
		i = i + 1
	}
	return 0 - 1
}

# --- rule F407: a discarded receive binder drops ----------------------------------------------
#
# GRAMMAR makes a recv-arm's binder OPTIONAL — `<-ch => stmt` is the whole form — so
# `_ := <-ch => stmt` names the received value only in order to say it has no name. Go needs
# `_ =` because an unused variable is an error there; Zerg has no such rule, so the binder
# buys nothing and costs the next reader the question "where is `_` read?".
#
# It fires only where an `=>` proves a select arm. A STATEMENT `_ := <-ch` is a binding, and
# dropping its binder would leave a bare receive standing where a statement was; that case
# belongs to the linter (L104), which suggests rather than rewrites.
fn fmt_discards(mut &toks: list[Token]) -> list[Token] {
	mut out: list[Token] = []
	mut i := 0
	for i < toks.len() {
		if fmt_is_discard_arm(toks, i) {
			i = i + 2 # the `_` and its `:=`; the receive that follows stays
		} else {
			out.append(toks[i])
			i = i + 1
		}
	}
	return out
}

# fmt_is_discard_arm reports whether `at` opens the head of a select arm that binds the
# discard: `_ :=` at the start of a statement, a receive after it, and an `=>` closing the
# head. Every reason to decline is here, in one place.
fn fmt_is_discard_arm(mut &toks: list[Token], at: int) -> bool {
	return false if at + 2 >= toks.len()
	return false if toks[at].kind != Kind.Ident or toks[at].lexeme != "_"
	return false if toks[at + 1].kind != Kind.Walrus or not is_larrow(toks[at + 2].kind)
	return false if not fmt_stmt_start(toks, at)

	return fmt_arm_head_ends(toks, at + 3)
}

# fmt_arm_head_ends reports whether a `=>` closes the head that starts at `at`, before the
# statement itself ends. That arrow is what tells a select arm from a plain binding.
fn fmt_arm_head_ends(mut &toks: list[Token], at: int) -> bool {
	mut depth := 0
	mut i := at
	for i < toks.len() {
		k := toks[i].kind

		return false if is_semi(k) or is_comment(k) or is_lbrace(k)
		return true if k == Kind.FatArrow and depth == 0

		if is_bracket(k) {
			depth = depth + 1
		} else if is_close(k) {
			depth = depth - 1
		}
		i = i + 1
	}
	return false
}

# --- rule F408: an or-pattern over consecutive integers becomes the range it is ---------------
#
# GRAMMAR gives a match arm a RANGE form — `1..=2 =>`, match-only sugar for the guard
# `_ if _ in 1..=2` — so it says exactly what `1 | 2 =>` says, and says it once however many
# values there are. This is F401's and F405's principle a third time: where the language offers
# a shorter surface for exactly what is written, the canonical form is the shorter one.
#
# Here the shorter one is also the only one that WORKS. `|` in pattern position is read as the
# bitwise operator by both compilers, so `1 | 2` folds to 3 and the arm matches neither 1 nor 2
# — silently. The rule does not exist to paper over that (an or-pattern of anything else is
# still wrong and still needs the language work), but for the contiguous-integer case it turns
# a wrong answer into a right one on the way past.
#
# The shape it accepts is deliberately narrow, and each part of it is load-bearing:
#
#   * the whole arm HEAD is integer literals separated by `|`, and nothing else. `|` is also a
#     binary operator, and a token pass has no other way to know one is in pattern position —
#     `out <- a | b => …` is a select send arm whose VALUE happens to contain one.
#   * the values ASCEND BY ONE. `1 | 3` is not a range: `1..=3` would take 2 with it.
#   * two or more alternatives, and no guard.
#
# Each bound keeps its own LEXEME, so `0x10 | 0x11` becomes `0x10..=0x11` rather than being
# rewritten in decimal. A literal's surface is the author's.
fn fmt_ranges(mut &toks: list[Token]) -> list[Token] {
	mut out: list[Token] = []
	mut i := 0
	for i < toks.len() {
		shut := fmt_or_pat_end(toks, i)
		if shut > 0 {
			fmt_emit_range(toks, i, shut, out)
			i = shut
		} else {
			out.append(toks[i])
			i = i + 1
		}
	}
	return out
}

# fmt_or_pat_end answers with the index of the `=>` closing a rewritable or-pattern head at
# `at`, or 0 when the shape is anything else at all.
fn fmt_or_pat_end(mut &toks: list[Token], at: int) -> int {
	return 0 if not fmt_stmt_start(toks, at)

	mut i := at
	mut prev := 0
	mut n := 0
	for i < toks.len() {
		mut neg := false
		if toks[i].kind == Kind.Minus {
			neg = true
			i = i + 1
			return 0 if i >= toks.len()
		}
		return 0 if toks[i].kind != Kind.Int
		mut v := int_value(toks[i].lexeme)
		if neg {
			v = 0 - v
		}
		return 0 if n > 0 and v != prev + 1
		prev = v
		n = n + 1
		i = i + 1
		return 0 if i >= toks.len()

		k := toks[i].kind
		if k == Kind.FatArrow {
			return i if n >= 2
			return 0
		}
		return 0 if k != Kind.Pipe
		i = i + 1
		return 0 if i >= toks.len()
	}
	return 0
}

# fmt_emit_range writes `lo..=hi` from the FIRST and LAST alternative of the head, dropping
# everything between them — the middle values are what the range now states.
fn fmt_emit_range(mut &toks: list[Token], at: int, shut: int, mut &out: list[Token]) {
	ln := toks[at].line
	col := toks[at].col
	out.append(toks[at])
	if toks[at].kind == Kind.Minus {
		out.append(toks[at + 1])
	}
	out.append(Token(Kind.DotDotEq, "..=", "", ln, col))
	if toks[shut - 2].kind == Kind.Minus {
		out.append(toks[shut - 2])
	}
	out.append(toks[shut - 1])
}

# --- rule F406: a blank line where one is load-bearing ---------------------------------------
#
# The bar for this rule is high, because the tree it formats has TEN blank lines inside
# function bodies in total, and this file — 1300 lines of it — has none. So the rule puts
# one in exactly two places, and both are places the authors here already put one.
#
# A run of MORE THAN ONE guard is followed by a blank:
#
#     fn conv_ty(s: str) -> Ty {      fn conv_ty(s: str) -> Ty {
#         return TInt if s == "int"       return TInt if s == "int"
#         return TStr if s == "str"       return TStr if s == "str"
#         return TNil               →
#     }                                   return TNil
#                                     }
#
# One guard is part of the line it guards; two or more are a TABLE of exits, and a table
# wants an edge. That restraint is most of the rule: 182 of this tree's 218 guard runs are
# a single guard and none of them is touched.
#
# A comment on its OWN line, with code before it, gets a blank in front. A comment there
# heads a new chunk of the function — that is what makes it its own line rather than a
# trailing one — and half of the blank lines already in this tree's bodies are exactly it.
#
# What it does NOT do, though the shape suggests it: a blank after a nested block's `}`.
# That is 683 places, which is not a rule about readability but a rewrite of the tree.
#
# It is F4xx and switchable because it inserts a line nobody wrote — the same test that put
# F403 there. It runs LAST, after F403, because F403 renumbers lines and this rule's whole
# job is to decide line numbers; running it earlier would have its work rewritten.
fn fmt_blank(mut &toks: list[Token]) -> list[Token] {
	mut at: list[bool] = []
	mut i := 0
	for i < toks.len() {
		at.append(false)
		i = i + 1
	}
	fmt_blank_mark(toks, at)

	# The blank is made by SHIFTING every later token down a line, not by widening the gap
	# the run leaves behind. Widening does not work: the `;` the lexer inserts after a `}`
	# prints nothing but still moves the printer's `prev_line`, so a gap opened before that
	# `;` is closed again by it — which is why F401 can collapse a four-line if-block onto
	# one line without leaving a blank where the block used to be.
	mut out: list[Token] = []
	mut shift := 0
	mut j := 0
	for j < toks.len() {
		if at[j] {
			shift = shift + 1
		}
		out.append(fmt_on_line(toks[j], toks[j].line + shift))
		j = j + 1
	}
	return out
}

# fmt_blank_mark marks each token that a blank line goes in FRONT of. It tracks the block
# depth because a comment only heads a chunk INSIDE a body: at the top level a comment is
# a declaration's doc comment, or one of an import's, and the blank line between those is
# the author's to place.
fn fmt_blank_mark(mut &toks: list[Token], mut &at: list[bool]) {
	mut depth := 0
	mut group := 0
	mut i := 0
	for i < toks.len() {
		k := toks[i].kind
		if is_lbrace(k) {
			depth = depth + 1
		} else if is_rbrace(k) and depth > 0 {
			depth = depth - 1
		} else if is_bracket(k) {
			group = group + 1
		} else if is_close(k) and group > 0 {
			group = group - 1
		}
		end := fmt_guard_end(toks, i)
		dend := fmt_decl_end(toks, i)
		if end < 0 and dend >= 0 {
			# a run of declarations gets a leading edge and NOTHING after it
			mut dn := 1
			mut dlast := dend
			mut dnxt := fmt_next_code(toks, dend)
			for dnxt >= 0 {
				e := fmt_decl_end(toks, dnxt)
				break if e < 0
				dn = dn + 1
				dlast = e
				dnxt = fmt_next_code(toks, e)
			}
			if dn >= fmt_decl_min() and fmt_blank_lead(toks, i) {
				at[i] = true
			}
			i = dlast + 1
		} else if end < 0 {
			# `group == 0` keeps this out of a wrapped argument list: a comment among a
			# list's elements belongs to the element it sits on, and a blank line there
			# separates it from the very thing it is about.
			if depth > 0 and group == 0 and fmt_blank_comment(toks, i) {
				at[i] = true
			}
			i = i + 1
		} else {
			# walk the whole run, so the mark lands after the LAST of its guards
			mut n := 1
			mut last := end
			mut nxt := fmt_next_code(toks, end)
			for nxt >= 0 {
				e := fmt_guard_end(toks, nxt)
				break if e < 0
				n = n + 1
				last = e
				nxt = fmt_next_code(toks, e)
			}
			if n > 1 {
				# a table gets both edges. The leading one is only wanted where the run
				# starts mid-function: at the top of a body the `{` is already the edge.
				if fmt_blank_lead(toks, i) {
					at[i] = true
				}
				if fmt_blank_here(toks, nxt) {
					at[nxt] = true
				}
			}
			i = last + 1
		}
	}
}

# fmt_blank_comment reports a comment on its own line with code before it AND code after it
# — the shape that heads a new chunk. A comment TRAILING code shares that code's line and is
# part of it; a comment under another comment is one block and is not split; and a comment
# with nothing but the closing `}` after it heads nothing, so a blank would only push it
# away from what it is commenting ON.
fn fmt_blank_comment(mut &toks: list[Token], at: int) -> bool {
	return false if not is_comment(toks[at].kind)
	return false if at == 0

	p := fmt_prev_code(toks, at)
	return false if p < 0
	k := toks[p].kind
	return false if is_comment(k) or is_lbrace(k)

	# on the same line as what precedes it, this is a trailing comment
	return false if toks[at].line == toks[p].line
	return false if not fmt_blank_leads(toks, at)

	return fmt_blank_here(toks, at)
}

# fmt_blank_leads reports whether a comment block has any code after it to head.
fn fmt_blank_leads(mut &toks: list[Token], at: int) -> bool {
	mut i := at + 1
	for i < toks.len() {
		k := toks[i].kind

		return false if is_rbrace(k) or is_eof(k)
		return true if not is_semi(k) and not is_comment(k)

		i = i + 1
	}
	return false
}

# fmt_decl_min is how many declarations make a paragraph. Two are a pair — `sline` and
# `scol` are one thought written twice — which is the same step this rule already takes
# when it says one guard is part of the line it guards.
fn fmt_decl_min() -> int {
	return 3
}

# fmt_decl_end is the index of the `;` closing the declaration starting at `at`, or -1 when
# the statement there is anything else. The forms are `x := e`, `mut x := e` and the typed
# `x: T = e`.
#
# A `{` at depth zero declines it, the way it declines a guard: `x := if c { 1 } else { 2 }`
# is a statement with a shape of its own and not part of any preamble.
fn fmt_decl_end(mut &toks: list[Token], at: int) -> int {
	mut i := at
	if toks[i].kind == Kind.Mut {
		i = i + 1
	}
	return -1 if toks[i].kind != Kind.Ident
	i = i + 1
	if toks[i].kind == Kind.Colon {
		# `x: T = e` — step over the type to the `=` that opens the value
		mut j := i + 1
		mut d := 0
		for j < toks.len() {
			k := toks[j].kind
			if is_bracket(k) {
				d = d + 1
			} else if is_close(k) {
				d = d - 1
			} else if d == 0 and k == Kind.Assign {
				break
			} else if is_semi(k) or is_lbrace(k) or is_comment(k) {
				return -1
			}
			j = j + 1
		}
		return -1 if j >= toks.len()
		i = j
	} else if toks[i].kind != Kind.Walrus {
		return -1
	}
	mut depth := 0
	mut j := i + 1
	for j < toks.len() {
		k := toks[j].kind
		if is_bracket(k) {
			depth = depth + 1
		} else if is_close(k) {
			depth = depth - 1
		} else if is_lbrace(k) and depth == 0 {
			return -1
		} else if is_semi(k) and depth == 0 {
			return j
		} else if is_comment(k) or is_eof(k) {
			return -1
		}
		j = j + 1
	}
	return -1
}

# fmt_blank_lead reports whether a blank belongs in FRONT of a run: there has to be code
# ahead of it to be separated from, and that code must not be a comment. A comment there is
# the run's heading, and F406 has already put a blank in front of IT — putting a second one
# between the heading and the table would split the two things that go together.
fn fmt_blank_lead(mut &toks: list[Token], at: int) -> bool {
	p := fmt_prev_code(toks, at)
	return false if p < 0
	k := toks[p].kind
	return false if is_lbrace(k) or is_comment(k)
	return fmt_blank_here(toks, at)
}

# fmt_blank_here is every reason a blank line is NOT wanted at `at`, in one place.
fn fmt_blank_here(mut &toks: list[Token], at: int) -> bool {
	return false if at <= 0
	k := toks[at].kind

	# nothing to be separated FROM: a blank before a closer, or at the end of the file
	return false if is_rbrace(k) or is_eof(k)

	# a blank is already there. The gap is measured against the token immediately before,
	# because that is what the printer's `prev_line` will hold — a `;` among them prints
	# nothing and still counts.
	return false if toks[at].line - toks[at - 1].line >= 2
	return true
}

# fmt_guard_end is the index of the `;` closing the postfix guard that starts at `at`, or
# -1 when the statement there is anything else.
#
# A guard is a jump with an `if` after it and no block of its own. The `{` test is what
# tells it from `return if c { 1 } else { 2 }` — a jump whose VALUE is an if-expression,
# which is a statement of a different shape and not part of any table.
fn fmt_guard_end(mut &toks: list[Token], at: int) -> int {
	return -1 if not is_jump(toks[at].kind)

	mut depth := 0
	mut seen := false
	mut i := at + 1
	for i < toks.len() {
		k := toks[i].kind
		if is_lbrace(k) {
			return -1 if depth == 0
			depth = depth + 1
		} else if is_bracket(k) {
			depth = depth + 1
		} else if is_close(k) or is_rbrace(k) {
			depth = depth - 1
		} else if is_semi(k) and depth == 0 {
			return i if seen
			return -1
		} else if is_comment(k) or is_eof(k) {
			return -1
		} else if k == Kind.If and depth == 0 {
			seen = true
		}
		i = i + 1
	}
	return -1
}

# fmt_next_code is the next token that is not a separator. The `;`s are skipped because
# they are what stands between one guard of a run and the next.
fn fmt_next_code(mut &toks: list[Token], at: int) -> int {
	mut i := at + 1
	for i < toks.len() {
		return i if not is_semi(toks[i].kind)
		i = i + 1
	}
	return -1
}

# fmt_opens_block reports whether the `{` at `at` opens a BLOCK rather than a map literal.
#
# The formatter reads TOKENS, so it has to decide this the way a reader does: from what stands
# in front of the brace. Where a VALUE is expected — after `:=`, `=`, `:`, `,`, `(`, `[`,
# `return` — a `{` is a map literal and everything about it stays on the line it was written
# on. Everywhere else it opens a block.
#
# Without this, `m := {"a": 1}` came back as
#
#     m := {
#         "a": 1
#     }
#
# which does not parse: the formatter turned a valid program into an invalid one. Nothing
# caught it for the reason this file's failures usually hide — `make fmt-self` covers the
# compiler and the stdlib, and neither of them writes a map literal, so the form the rule was
# wrong about was a form no gated source contained. It is the third defect of that exact shape,
# after `chan[T]<-` and `-1`.
fn fmt_opens_block(mut &toks: list[Token], at: int) -> bool {
	p := fmt_prev_code(toks, at)
	return true if p < 0

	return not fmt_wants_value(toks[p].kind)
}

# fmt_wants_value is every token a VALUE may follow. It is written as the smaller list on
# purpose: the positions a block opens in are open-ended — after a `)`, a name, `else`, `=>`,
# another `{` — while the places an expression is expected are countable, and a new one joins
# by being named here.
fn fmt_wants_value(k: Kind) -> bool {
	return true if k == Kind.Walrus or k == Kind.Assign or k == Kind.Colon or k == Kind.Comma or k == Kind.LParen or k == Kind.LBrack

	# `return {…}`, `x in {…}`, `ch <- {…}` — the keyword and the two operators that take a
	# value on their right and can find a literal there. `in` and `<-` were missed when this
	# list was first written, and the miss reproduced the very defect the list exists to fix,
	# one token class over: `found := "a" in {"a": 1}` came back as a block.
	return k == Kind.Return or k == Kind.In or k == Kind.LArrow
}

fn fmt_prev_code(mut &toks: list[Token], at: int) -> int {
	mut i := at - 1
	for i >= 0 {
		return i if not is_semi(toks[i].kind)
		i = i - 1
	}
	return -1
}

# --- rule F405: a string built with `+` becomes the f-string it already is -------------------
#
# A chain of `+` over strings says what an f-string says, in more punctuation:
#
#     "n=" + s + " of " + t      →      f"n={s} of {t}"
#
# The formatter has no types, and does not need them here. `+` is never heterogeneous —
# the emitter lowers it to a string concat exactly when the LEFT operand is a str, and
# there is no `+` on any other composite — so ONE string literal anywhere in a chain types
# the whole of it. That is the trigger.
#
# The trap this rule is mostly built around is precedence: `+` shares its level with `-`,
# `|`, `^`, `+%` and `-%`, so `"a" + b - c` parses as `("a" + b) - c` and the `+` chain is
# NOT the whole token run. Rewriting the run would re-associate the expression. What may
# appear between operands is therefore a whitelist rather than a blacklist, and any of
# those five at the chain's own depth ends it.
#
# `strconv.to_string(X, 10)` narrows to `{X}`. Base 10 is what a hole renders in anyway, so
# the call says nothing the braces do not — and every other base is a conversion a hole has
# no spelling for, so it keeps its call. The test is on the LEXEME `10`, not the value:
# `0xa` is the same number and not the same statement of intent.
#
# It declines, each for its own reason:
#
#   * fewer than 3 operands — two is one `+`, already the shortest way to say it;
#   * no string literal — nothing proves the chain is a string;
#   * no hole — an all-literal chain gains nothing from an `f`, which is what leaves
#     zergc's nine-line help text alone;
#   * a chain spanning more than one line — its author's breaks say where the pieces are,
#     and staying inside one line means this rule never touches a line number, so it
#     composes with F403 and F406 without either seeing the other;
#   * a raw or triple-quoted literal, or one carrying `\u{…}`, whose braces belong to the
#     escape and cannot be doubled;
#   * a hole whose text carries `"`, `\`, `{` or `}` — the f-string's own delimiters;
#   * a literal carrying a brace. Doubling it is correct and reads worse than what it
#     replaces: this tree builds C, and `f"{ind}{{\n"` asks a reader to decide per brace
#     whether it is a hole or an escape. Correctness was never the question there;
#   * the accumulation `out = out + …`, which is 88 of this tree's concatenations and the
#     dominant idiom. `f"{out}…"` re-reads the accumulator as a hole, so the one thing the
#     statement is DOING becomes indistinguishable from the values being interpolated.
fn fmt_fstr_min() -> int {
	return 3
}

# Fstr is what rendering a chain answers with: the whole f-string lexeme, and whether the
# chain was one this rule may rewrite. They come out together because BUILDING the text is
# what finds the operand that declines it.
struct Fstr {
	text: str
	ok: bool
}

fn fmt_fstr(mut &toks: list[Token]) -> list[Token] {
	mut head: list[int] = []
	mut i := 0
	for i < toks.len() {
		head.append(-1)
		i = i + 1
	}
	fmt_fstr_mark(toks, head)
	mut out: list[Token] = []
	mut j := 0
	for j < toks.len() {
		if head[j] >= 0 {
			r := fmt_fstr_render(toks, j, head[j])
			out.append(Token(Kind.FStr, r.text, "", toks[j].line, toks[j].col))
			j = head[j] + 1
		} else {
			out.append(toks[j])
			j = j + 1
		}
	}
	return out
}

# fmt_fstr_mark records, on each rewritable chain's FIRST token, the index of its last.
# Every `+` of one chain walks out to the same pair, so writing the same answer twice is
# how the overlapping anchors settle.
fn fmt_fstr_mark(mut &toks: list[Token], mut &head: list[int]) {
	mut i := 0
	for i < toks.len() {
		if toks[i].kind == Kind.Plus {
			lo := fmt_fstr_lo(toks, i)
			hi := fmt_fstr_hi(toks, i)
			r := fmt_fstr_render(toks, lo, hi)
			if r.ok and not fmt_fstr_accum(toks, lo) {
				head[lo] = hi
			}
		}
		i = i + 1
	}
}

# fmt_fstr_atom is what a chain may hold BETWEEN its operators at its own bracket depth.
# It is a whitelist and deliberately narrow: what is outside it is what the rewrite would
# get wrong. Inside a bracket anything goes — the walk only tests at depth zero.
fn fmt_fstr_atom(k: Kind) -> bool {
	return match k {
		Kind.Ident  => true
		Kind.Str    => true
		Kind.Int    => true
		Kind.Float  => true
		Kind.True   => true
		Kind.False  => true
		Kind.Nil    => true
		Kind.KwThis => true
		Kind.Dot    => true
		Kind.LParen => true
		Kind.RParen => true
		Kind.LBrack => true
		Kind.RBrack => true
		_           => false
	}
}

# fmt_fstr_lo walks left from a `+` to the chain's first token. A CLOSING bracket met going
# left opens a group to step over; an OPENING one at depth zero is the bracket holding the
# chain, and stops the walk without being taken.
fn fmt_fstr_lo(mut &toks: list[Token], p: int) -> int {
	mut d := 0
	mut lo := p
	mut i := p - 1
	for i >= 0 {
		k := toks[i].kind
		if is_close(k) {
			d = d + 1
		} else if is_bracket(k) {
			break if d == 0
			d = d - 1
		} else if d == 0 and not fmt_fstr_atom(k) and k != Kind.Plus {
			break
		}
		lo = i
		i = i - 1
	}
	return lo
}

fn fmt_fstr_hi(mut &toks: list[Token], p: int) -> int {
	mut d := 0
	mut hi := p
	mut i := p + 1
	for i < toks.len() {
		k := toks[i].kind
		if is_bracket(k) {
			d = d + 1
		} else if is_close(k) {
			break if d == 0
			d = d - 1
		} else if d == 0 and not fmt_fstr_atom(k) and k != Kind.Plus {
			break
		}
		hi = i
		i = i + 1
	}
	return hi
}

# fmt_fstr_accum reports the `out = out + …` shape by comparing the assignment's target
# with the chain's first operand.
fn fmt_fstr_accum(mut &toks: list[Token], lo: int) -> bool {
	return false if lo < 2
	return false if toks[lo - 1].kind != Kind.Assign

	mut i := lo - 2
	mut j := lo
	for i >= 0 and toks[i].kind != Kind.Semi and not is_lbrace(toks[i].kind) {
		return false if toks[j].kind != toks[i].kind or toks[j].lexeme != toks[i].lexeme
		i = i - 1
		j = j + 1
	}
	return true
}

# fmt_fstr_render builds the f-string a chain would become, and answers whether it may.
fn fmt_fstr_render(mut &toks: list[Token], lo: int, hi: int) -> Fstr {
	return Fstr("", false) if hi <= lo
	return Fstr("", false) if toks[lo].line != toks[hi].line

	mut text := ""
	mut parts := 0
	mut lits := 0
	mut holes := 0
	mut d := 0
	mut a := lo
	mut i := lo
	for i <= hi + 1 {
		fin := i > hi
		mut k := Kind.Semi
		if not fin {
			k = toks[i].kind
		}
		if not fin and is_bracket(k) {
			d = d + 1
		} else if not fin and is_close(k) {
			d = d - 1
		}
		if fin or (d == 0 and k == Kind.Plus) {
			return Fstr("", false) if i <= a
			piece := fmt_fstr_part(toks, a, i - 1)
			return Fstr("", false) if not piece.ok
			text = text + piece.text
			parts = parts + 1
			if a == i - 1 and toks[a].kind == Kind.Str {
				lits = lits + 1
			} else {
				holes = holes + 1
			}
			a = i + 1
		}
		i = i + 1
	}
	return Fstr("", false) if parts < fmt_fstr_min() or lits == 0 or holes == 0
	return Fstr(f"f\"{text}\"", true)
}

# fmt_fstr_part renders one operand: a string literal contributes its text, anything else
# becomes a `{ … }` hole spelled the way the printer would spell it on one line.
fn fmt_fstr_part(mut &toks: list[Token], lo: int, hi: int) -> Fstr {
	if lo == hi and toks[lo].kind == Kind.Str {
		return Fstr("", false) if not fmt_fstr_lit_ok(toks[lo])
		return Fstr(fmt_fstr_lit(toks[lo].lexeme), true)
	}
	s: str = fmt_fstr_span(toks, fmt_fstr_arg_lo(toks, lo, hi), fmt_fstr_arg_hi(toks, lo, hi))
	return Fstr("", false) if not fmt_fstr_hole_ok(s)
	return Fstr("{" + s + "}", true)
}

# fmt_fstr_is_dec reports the `strconv.to_string(X, 10)` shape, whose whole content is the
# base a hole renders in anyway.
fn fmt_fstr_is_dec(mut &toks: list[Token], lo: int, hi: int) -> bool {
	return false if hi - lo < 7
	return false if toks[lo].kind != Kind.Ident or toks[lo].lexeme != "strconv"
	return false if not is_dot(toks[lo + 1].kind)
	return false if toks[lo + 2].kind != Kind.Ident or toks[lo + 2].lexeme != "to_string"
	return false if toks[lo + 3].kind != Kind.LParen
	return false if fmt_wrap_end(toks, lo + 3) != hi
	return false if toks[hi - 1].kind != Kind.Int or toks[hi - 1].lexeme != "10"

	return is_comma(toks[hi - 2].kind)
}

fn fmt_fstr_arg_lo(mut &toks: list[Token], lo: int, hi: int) -> int {
	return lo + 4 if fmt_fstr_is_dec(toks, lo, hi)
	return lo
}

fn fmt_fstr_arg_hi(mut &toks: list[Token], lo: int, hi: int) -> int {
	return hi - 3 if fmt_fstr_is_dec(toks, lo, hi)
	return hi
}

# fmt_fstr_span spells a token run the way the printer would on ONE line, through the
# printer's own spacing predicate — so a hole's text is already canonical and formatting
# the result again changes nothing.
fn fmt_fstr_span(mut &toks: list[Token], lo: int, hi: int) -> str {
	mut out := ""
	mut prev2 := Kind.Semi
	mut prev := Kind.Semi
	mut i := lo
	for i <= hi {
		t := toks[i]
		if i > lo and fmt_space_between(toks, i, prev2, prev) {
			out = out + " "
		}
		out = out + fmt_text(t)
		prev2 = prev
		prev = t.kind
		i = i + 1
	}
	return out
}

# fmt_fstr_lit_ok is every reason a string literal declines to be an f-string's text.
fn fmt_fstr_lit_ok(t: Token) -> bool {
	b := bytearray(t.lexeme)
	n := b.len()

	return false if n < 2 or b[0] != b'"'
	return false if n >= 3 and b[1] == b'"' and b[2] == b'"'

	mut i := 1
	for i < n - 1 {
		c := b[i]

		# `\u{…}`'s braces belong to the escape: doubling breaks it and not doubling reads
		# as a hole, so there is no spelling and the chain keeps its `+`
		return false if c == b'\\' and i + 1 < n and b[i + 1] == b'u'
		if c == b'\\' {
			i = i + 2
		} else {
			# a brace is correct doubled and worse to read, so it declines instead
			return false if c == b'{' or c == b'}'
			i = i + 1
		}
	}
	return true
}

fn fmt_fstr_lit(lex: str) -> str {
	b := bytearray(lex)
	mut out: list[byte] = []
	mut i := 1
	for i < b.len() - 1 {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# fmt_fstr_hole_ok refuses a hole carrying the f-string's own delimiters. What this really
# catches is inside an operand's brackets, which is where they occur — `dump(b, ind + "\t")`
# is a hole this rule cannot spell.
fn fmt_fstr_hole_ok(s: str) -> bool {
	return false if s == ""
	for c in bytearray(s) {
		return false if c == b'"' or c == b'\\' or c == b'{' or c == b'}'
	}
	return true
}

# --- rule F403: an argument list is one line, or one element per line -----------------------
#
# F105 decides where a closer goes once a group already spans lines. F403 decides WHETHER
# it spans them at all. A group that fits is joined even if its author broke it, and one
# that does not fit breaks at EVERY top-level comma — never half of each, which is what
# used to leave `), 3` hanging off the end of a closer.
#
# It fits when both hold:
#
#   * printed flat, the group ends before column 80 — a tab counts as 4;
#   * it has fewer than 6 top-level elements.
#
# Width is the real judgement here and the count is a backstop for what width cannot see:
# six arguments read as a list to scan rather than a line to read, however short each is.
#
# A group with NO top-level comma is exempt from both. A chain and a parenthesised
# expression break where their author broke them — those breaks say where the steps are,
# not that the line ran out of room. What they do get is the opener ending its own line,
# so every step of a chain starts in the same column:
#
#     n := (
#         builder()
#         .run()
#     )
#
# It declines outright when a comment is anywhere inside, for F401's reason: a comment is
# something a person put there, and joining lines has nowhere to put it back.
#
# This belongs in F4xx and is switchable, unlike F105: it does not merely place a token
# that already exists, it inserts breaks the author did not write and drops the trailing
# comma that a joined list no longer needs.
#
# The pass rewrites each token's LINE and the printer stays one straight walk, which is
# how every rule that moves code works here.

# fmt_wrap_max is the column a flat group must end before; fmt_wrap_tab is what one tab
# counts as while measuring, and fmt_wrap_elems is the element count that breaks a group
# however narrow it is.
fn fmt_wrap_max() -> int {
	return 80
}

fn fmt_wrap_tab() -> int {
	return 4
}

fn fmt_wrap_elems() -> int {
	return 6
}

# Wrap is where a group's decision leaves the scan: the index just past its closer, and
# the column the line is at once the closer is printed.
struct Wrap {
	next: int
	col: int
}

fn fmt_wrap(mut &toks: list[Token]) -> list[Token] {
	mut brk := fmt_wrap_breaks(toks)
	mut drop: list[bool] = []
	mut i := 0
	for i < toks.len() {
		drop.append(false)
		i = i + 1
	}
	mut wid := fmt_wrap_widths(toks)
	fmt_wrap_scan(toks, brk, drop, wid)
	return fmt_wrap_relines(toks, brk, drop)
}

# fmt_wrap_breaks reads the author's line breaks off the tokens as a count per token — 0
# for "same line", 1 for a break, 2 for a break with a blank line kept (F104). Deciding on
# THIS rather than on the line numbers themselves is what lets a decision be rewritten
# without renumbering everything after it.
fn fmt_wrap_breaks(mut &toks: list[Token]) -> list[int] {
	mut brk: list[int] = []
	mut i := 0
	for i < toks.len() {
		mut d := 0
		if i > 0 {
			g := toks[i].line - toks[i - 1].line
			if g >= 2 {
				d = 2
			} else if g == 1 {
				d = 1
			}
		}
		brk.append(d)
		i = i + 1
	}
	return brk
}

# fmt_wrap_widths is what each token costs on a flat line, its own text plus the space
# F201/F202 would put before it. Measuring from the same predicate the printer uses is
# what keeps the estimate and the output from drifting apart.
fn fmt_wrap_widths(mut &toks: list[Token]) -> list[int] {
	mut w: list[int] = []
	mut prev2 := Kind.Semi
	mut prev := Kind.Semi
	mut i := 0
	for i < toks.len() {
		t := toks[i]
		s: str = fmt_text(t)
		b := bytearray(s)
		mut n := b.len()
		if i > 0 and fmt_space_between(toks, i, prev2, prev) {
			n = n + 1
		}
		w.append(n)
		if not is_semi(t.kind) {
			prev2 = prev
			prev = t.kind
		}
		i = i + 1
	}
	return w
}

# fmt_wrap_scan walks the top level and hands every bracket group to the decision. `col`
# is the flat column the line has reached, which is what a group is measured against —
# the same left-to-right walk the printer makes, so a group is judged where it lands.
fn fmt_wrap_scan(mut &toks: list[Token], mut &brk: list[int], mut &drop: list[bool], mut &wid: list[int]) {
	mut depth := 0
	mut col := 0
	mut i := 0
	for i < toks.len() {
		t := toks[i]
		if is_semi(t.kind) {
			col = depth * fmt_wrap_tab()
			i = i + 1
		} else {
			if is_rbrace(t.kind) and depth > 0 and fmt_rbrace_closes_block(toks, i) and not fmt_guard_inline(toks, fmt_brace_open(toks, i)) {
				depth = depth - 1
			}
			if brk[i] > 0 or i == 0 {
				col = depth * fmt_wrap_tab()
			}
			if fmt_wrap_opens(toks, i) {
				r := fmt_wrap_group(toks, brk, drop, wid, i, col + wid[i], depth)
				col = r.col
				i = r.next
			} else {
				if is_lbrace(t.kind) and fmt_opens_block(toks, i) and not fmt_guard_inline(toks, i) {
					depth = depth + 1
				}
				col = col + wid[i]
				i = i + 1
			}
		}
	}
}

# fmt_wrap_opens reports whether token `at` opens a group this rule may decide. A `#[`
# is a decorator's brackets rather than a list's, and its shape is the language's.
fn fmt_wrap_opens(mut &toks: list[Token], at: int) -> bool {
	return false if not is_bracket(toks[at].kind)
	return false if at > 0 and is_hash(toks[at - 1].kind)

	return true
}

# fmt_wrap_group decides the one group opening at `open`. `col` is where the line stands
# with the opener printed; `depth` is the indent level the group's own line is at, so its
# elements sit one level in from it and its closer lands back on it.
fn fmt_wrap_group(
	mut &toks: list[Token],
	mut &brk: list[int],
	mut &drop: list[bool],
	mut &wid: list[int],
	open: int,
	col: int,
	depth: int
) -> Wrap {
	shut := fmt_wrap_end(toks, open)

	return Wrap(open + 1, col) if shut == 0
	return Wrap(shut + 1, col) if fmt_wrap_has_comment(toks, open, shut)

	flat := fmt_wrap_flat_width(wid, open + 1, shut)
	elems := fmt_wrap_elem_count(toks, open, shut)
	return fmt_wrap_free(toks, brk, drop, wid, open, shut, col, flat, depth) if elems == 0

	# Both thresholds VETO a join; neither orders a split. A group is broken up only when
	# its author already broke it — this rule then decides whether it stays broken, and
	# makes it break all the way rather than around one element.
	#
	# Ordering a split reads well until you see what it does, because this walk sees one
	# group at a time and not the whole line. When a line runs long the group that crosses
	# column 80 is the LAST one on it, which is almost never the one worth breaking:
	# `return 0 if a or b or c(x, y)` would put `c`'s two arguments on three lines while
	# the condition that actually made the line long — and that has no brackets to break
	# at — stayed as it was. The count is no better: `scan(l, Rune, false, a, b, c)` fits
	# in 55 columns and reads as a line, and a rule that split it on the count alone made
	# eight lines out of one.
	#
	# So a line its author fitted on one line stays there, and what this rule owns is the
	# shape of the groups that are already wrapped.
	over := col + flat > fmt_wrap_max()
	many := elems >= fmt_wrap_elems()

	# A group that HOLDS A BLOCK is split whatever it measures, because the alternative is
	# not "one line" — it is the half-broken shape this rule exists to prevent. Joining
	# `f(a, guard { x } ?? 1)` onto one line does not put it on one line; the block breaks
	# regardless and the `)` ends up alone after it. Neither threshold can see that, since
	# both are about width.
	holds := fmt_wrap_holds_block(toks, open, shut)
	spans := fmt_wrap_spans(toks, brk, open, shut)
	return fmt_wrap_split(toks, brk, drop, wid, open, shut, depth) if spans and (over or many or holds)
	return fmt_wrap_join(toks, brk, drop, open, shut, col + flat)
}

# fmt_wrap_join puts the whole group on one line. The trailing comma goes with it: it is
# there to make a broken list's last element look like the others, and on one line it is
# a comma before a closer that nothing follows.
#
# Joining a group joins everything nested inside it, so every trailing comma down there
# is answered here too — the inner groups are never visited again.
fn fmt_wrap_join(mut &toks: list[Token], mut &brk: list[int], mut &drop: list[bool], open: int, shut: int, col: int) -> Wrap {
	mut i := open + 1
	for i <= shut {
		brk[i] = 0
		if is_comma(toks[i].kind) and i + 1 <= shut and is_close(toks[i + 1].kind) {
			drop[i] = true
		}
		i = i + 1
	}
	return Wrap(shut + 1, col)
}

# fmt_wrap_split gives every top-level element its own line. The opener ends its line and
# the closer starts one, so the elements are a column a reader can run an eye down.
#
# The trailing comma goes here too, and for a harder reason than it goes when a group is
# joined: a multi-line parameter list is the one place the grammar does NOT accept one, so
# a formatter that kept it there would print a function nothing can parse back. Dropping
# it in a signature and keeping it in a call would be one shape in two spellings, which is
# what canonical means there is not, so it goes from both.
fn fmt_wrap_split(
	mut &toks: list[Token],
	mut &brk: list[int],
	mut &drop: list[bool],
	mut &wid: list[int],
	open: int,
	shut: int,
	depth: int
) -> Wrap {
	inner := (depth + 1) * fmt_wrap_tab()
	fmt_wrap_break_at(brk, open + 1)
	fmt_wrap_break_at(brk, shut)
	if shut > open + 1 and is_comma(toks[shut - 1].kind) {
		drop[shut - 1] = true
	}
	mut col := inner
	mut i := open + 1
	for i < shut {
		if fmt_wrap_opens(toks, i) {
			r := fmt_wrap_group(toks, brk, drop, wid, i, col + wid[i], depth + 1)
			col = r.col
			i = r.next
		} else {
			if is_comma(toks[i].kind) and i + 1 < shut {
				fmt_wrap_break_at(brk, i + 1)
				col = inner
			} else {
				col = col + wid[i]
			}
			i = i + 1
		}
	}
	return Wrap(shut + 1, depth * fmt_wrap_tab() + 1)
}

# fmt_wrap_free is a group with no top-level comma — a chain, or parentheses around an
# expression. Its breaks are the author's and stay, but if it spans lines at all then its
# opener ends its line, so every step starts in the same column.
fn fmt_wrap_free(
	mut &toks: list[Token],
	mut &brk: list[int],
	mut &drop: list[bool],
	mut &wid: list[int],
	open: int,
	shut: int,
	col: int,
	flat: int,
	depth: int
) -> Wrap {
	return Wrap(shut + 1, col + flat) if not fmt_wrap_spans(toks, brk, open, shut)
	inner := (depth + 1) * fmt_wrap_tab()
	fmt_wrap_break_at(brk, open + 1)
	fmt_wrap_break_at(brk, shut)
	mut c := inner
	mut i := open + 1
	for i < shut {
		if fmt_wrap_opens(toks, i) {
			r := fmt_wrap_group(toks, brk, drop, wid, i, c + wid[i], depth + 1)
			c = r.col
			i = r.next
		} else {
			if brk[i] > 0 {
				c = inner
			}
			c = c + wid[i]
			i = i + 1
		}
	}
	return Wrap(shut + 1, depth * fmt_wrap_tab() + 1)
}

fn fmt_wrap_break_at(mut &brk: list[int], at: int) {
	if at < brk.len() and brk[at] == 0 {
		brk[at] = 1
	}
}

# fmt_wrap_spans reports whether the group from `open` to `shut` occupies more than one
# line — either because its author broke it, or because it HOLDS A BLOCK.
#
# The second half is not a refinement. A `{` that opens a block always ends its line, which
# is the printer's own rule and not a decision this pass gets to make, so a group holding
# one spans lines however it was written. Measuring it flat is what made `zerg fmt`
# non-idempotent on `print int(guard { … } ?? byte(7))`: F403 read a one-line group and left
# it alone, the printer broke it at the block anyway, F105 then found a closer on a later
# line than its opener and moved it — and the file that came back was one the NEXT run
# formatted differently again. A formatter's one promise is that formatting formatted source
# changes nothing, and it was being kept by every gate in the tree because no gated source
# writes a block inside a call.
fn fmt_wrap_spans(mut &toks: list[Token], mut &brk: list[int], open: int, shut: int) -> bool {
	mut i := open + 1
	for i <= shut {
		return true if brk[i] > 0
		i = i + 1
	}
	return fmt_wrap_holds_block(toks, open, shut)
}

# fmt_wrap_holds_block is the second half of fmt_wrap_spans asked on its own, which the
# comma case needs separately: a group holding a block is split rather than merely known to
# span lines.
fn fmt_wrap_holds_block(mut &toks: list[Token], open: int, shut: int) -> bool {
	mut i := open + 1
	for i <= shut {
		return true if is_lbrace(toks[i].kind) and fmt_opens_block(toks, i) and not fmt_guard_inline(toks, i)
		i = i + 1
	}
	return false
}

# fmt_wrap_end is the index of the bracket that closes the one at `open`.
fn fmt_wrap_end(mut &toks: list[Token], open: int) -> int {
	mut d := 0
	mut i := open
	for i < toks.len() {
		k := toks[i].kind
		if is_bracket(k) {
			d = d + 1
		} else if is_close(k) {
			d = d - 1
			return i if d == 0
		}
		i = i + 1
	}
	return 0
}

fn fmt_wrap_has_comment(mut &toks: list[Token], open: int, shut: int) -> bool {
	mut i := open + 1
	for i < shut {
		return true if is_comment(toks[i].kind)
		i = i + 1
	}
	return false
}

fn fmt_wrap_flat_width(mut &wid: list[int], lo: int, hi: int) -> int {
	mut n := 0
	mut i := lo
	for i <= hi {
		n = n + wid[i]
		i = i + 1
	}
	return n
}

# fmt_wrap_elem_count is how many top-level elements the group holds, and 0 when it has no
# top-level comma at all — the shape that is exempt. A trailing comma closes the last
# element rather than opening another.
fn fmt_wrap_elem_count(mut &toks: list[Token], open: int, shut: int) -> int {
	mut commas := 0
	mut d := 0
	mut i := open + 1
	for i < shut {
		k := toks[i].kind
		if is_bracket(k) or is_lbrace(k) {
			d = d + 1
		} else if is_close(k) or is_rbrace(k) {
			d = d - 1
		} else if is_comma(k) and d == 0 {
			commas = commas + 1
		}
		i = i + 1
	}

	return 0 if commas == 0
	return commas if is_comma(toks[shut - 1].kind)

	return commas + 1
}

# fmt_wrap_relines writes the decisions back as line numbers, which is the only thing the
# printer reads. A dropped token hands its break to whatever takes its place.
fn fmt_wrap_relines(mut &toks: list[Token], mut &brk: list[int], mut &drop: list[bool]) -> list[Token] {
	mut out: list[Token] = []
	mut line := 1
	mut pend := 0
	mut i := 0
	for i < toks.len() {
		if i > 0 {
			pend = pend + brk[i]
		}
		if drop[i] {
			i = i + 1
		} else {
			line = line + pend
			pend = 0
			t := toks[i]
			out.append(Token(t.kind, t.lexeme, t.value, line, t.col))
			i = i + 1
		}
	}
	return out
}

# --- printing -------------------------------------------------------------------------

# fmt_toks prints the tokens and then lines up the columns a run shares (F106, F107).
fn fmt_toks(mut &toks: list[Token], no_close: bool) -> str {
	mut p := fmt_print(toks, no_close)
	return fmt_align(p)
}

# Printed is what the printer hands the aligner: the text it wrote, plus the byte offset of
# every token a run could align on — a match or select arm's `=>`, and a comment that TRAILS
# code rather than standing on its own line.
#
# The offsets come from the printer rather than from a scan of the finished text, and that is
# the load-bearing part. Once the tokens are gone a `=>` inside a string literal reads
# exactly like an arm's, and padding that one would not lay out a table — it would rewrite
# the string.
struct Printed {
	text: str
	arrow: list[int]
	trail: list[int]
}

# fmt_rbrace_closes_block is fmt_opens_block asked of the `}` end of the pair: it finds the
# brace this one closes and asks what THAT one opened.
#
# IT REPLACES A STACK, and that is the point of it. Three passes need this answer and they walk
# the token list three different ways, so the first version kept a per-brace stack in the one
# pass that had a loop to hang it on — whereupon the pass with no stack asked the question a
# second way, and the THIRD pass, the wrap scanner, did not ask it at all and popped a level
# that a map literal had never pushed. One function all three call cannot drift like that.
fn fmt_rbrace_closes_block(mut &toks: list[Token], at: int) -> bool {
	return fmt_opens_block(toks, fmt_brace_open(toks, at))
}

# fmt_brace_open is the index of the `{` the `}` at `at` closes, walking back. The formatter
# has no tree and each pass sees one token at a time, so the pairing is re-derived where it is
# wanted rather than carried.
fn fmt_brace_open(mut &toks: list[Token], at: int) -> int {
	mut depth := 0
	mut i := at
	for i >= 0 {
		if is_rbrace(toks[i].kind) {
			depth = depth + 1
		} else if is_lbrace(toks[i].kind) {
			depth = depth - 1
			return i if depth == 0
		}
		i = i - 1
	}
	return 0
}

# fmt_brace_shut is fmt_brace_open walked the other way: the `}` the `{` at `at` opens.
fn fmt_brace_shut(mut &toks: list[Token], at: int) -> int {
	mut depth := 0
	mut i := at
	for i < toks.len() {
		if is_lbrace(toks[i].kind) {
			depth = depth + 1
		} else if is_rbrace(toks[i].kind) {
			depth = depth - 1
			return i if depth == 0
		}
		i = i + 1
	}
	return 0
}

# fmt_guard_inline reports whether the `{` at `open` is a guard's block the author wrote as
# ONE LINE — `guard { e } ?? d` — which is the one block that stays there. A guard's block
# usually holds one expression, and `check("max + 1 raises", guard { max + 1 } ?? 7, 7)`
# reads as the line it is; exploding it three-deep buried eighteen such checks in one
# example alone. So the block rule is not applied to it: no newline after the `{`, no line
# of its own for the `}`, no level in between.
#
# The exemption is EARNED, not assumed: every token through the closer must sit on the
# author's one line, none may be a comment (it would eat the rest of the line), and none a
# `;` — a second statement is a block again. A guard whose block the author broke keeps the
# block shape, breaks and all; this rule never joins, it only declines to break.
fn fmt_guard_inline(mut &toks: list[Token], open: int) -> bool {
	return false if not is_lbrace(toks[open].kind)

	p := fmt_prev_code(toks, open)
	return false if p < 0 or toks[p].kind != Kind.Guard

	shut := fmt_brace_shut(toks, open)
	return false if shut == 0

	mut i := open + 1
	for i <= shut {
		k := toks[i].kind

		return false if toks[i].line != toks[open].line
		return false if is_comment(k) or is_semi(k)

		i = i + 1
	}
	return true
}

# fmt_pop_int drops a list's last element. The subset has no `pop`, and a stack is what the
# brace nesting needs, so the drop is written here once rather than at each use.
fn fmt_pop_int(xs: list[int]) -> list[int] {
	mut out: list[int] = []
	mut i := 0
	for i < xs.len() - 1 {
		out.append(xs[i])
		i = i + 1
	}
	return out
}

fn fmt_print(mut &toks: list[Token], no_close: bool) -> Printed {
	mut out: list[byte] = []
	mut arrow: list[int] = []
	mut trail: list[int] = []
	mut depth := 0
	mut col := 0           # bytes written on the current line
	mut prev2 := Kind.Semi # the one before it — `<-` needs a token of context on each side
	mut prev := Kind.Semi  # the last token that mattered for spacing
	mut prev_line := 0

	# One entry per open `(` or `[`: the source line it opened on, and the block depth its
	# statement sits at. A group that opened on an EARLIER line gets its closer on a line
	# of its own — which is what turns a wrapped chain into a shape with a visible end,
	#
	#     a := (builder()
	#         .run()
	#         .fast()
	#     )
	#
	# instead of a `))` that a reader has to count. `psp` is the height rather than the
	# list's length, so the two lists are reused instead of regrown per group.
	#
	# Both indents are measured from that block depth PLUS the group height, so a nested
	# group steps in one level per open bracket and its closer lands under its own opener.
	# Anchoring a closer to the statement instead put every closer of a nest in the same
	# column — a reader could not tell which one closed which, and an inner closer sat to
	# the LEFT of the content it closed.
	mut pline: list[int] = []
	mut pind: list[int] = []
	mut psp := 0

	# bsave is the bracket depth the INNERMOST open `{` was seen at, and bstack the ones
	# outside it. A `;` counts as the fill separator only while the bracket depth is deeper
	# than that — which is the lexer's rule for where it stops inserting one.
	mut bsave := 0
	mut bstack: list[int] = []

	mut i := 0
	for i < toks.len() {
		t := toks[i]
		break if is_eof(t.kind)

		# A `;` INSIDE BRACKETS is not a statement separator: it is the fill/array form's
		# own separator (GRAMMAR#array-type's `[type ';' const-expr]`, and `[v; N]`). Breaking the
		# line there turned `[0; 8]` — eight zeros — into `[0` / `8]`, a list of TWO, which
		# is the one thing a formatter may never do: change what the program means.
		#
		# "Inside brackets" is the LEXER's question, and the answer is the lexer's rule: a
		# `{` RESETS the depth (lexer.zg's brace_push) because a block inside a call's
		# parens is a statement list again, and ASI resumes there. Asking `psp > 0` alone
		# printed the inserted `;` of every closure body written inside a call.
		if is_semi(t.kind) and psp > bsave {
			fmt_write(out, fmt_text(t))
			col = col + 1
			prev2 = prev
			prev = t.kind
			prev_line = t.line
			i = i + 1
			continue
		}
		if is_semi(t.kind) {
			if col > 0 {
				out.append(byte(10))
				col = 0
			}
			prev2 = prev
			prev = t.kind
			prev_line = t.line
			i = i + 1
		} else {
			# A line break the author put INSIDE an expression is kept: the lexer inserts no
			# `;` there (the line did not end an item), and joining it back up would turn a
			# wrapped list or a built-up string into one unreadable line. The continuation is
			# indented one level past its statement, which is what makes it read as one.
			# A closer whose opener was on an earlier line starts its own line, at the
			# indent the opener's line had. (That indent is never 0 in practice: a group
			# spanning lines is inside a statement, and a statement is inside a block.)
			#
			# It is checked BEFORE the generic continuation, and instead of it: once the
			# closer sits on its own line, the continuation rule would see a line break too
			# and break a second time. Running both is what made the first version rewrite
			# already-formatted source — the one thing this formatter promises not to do.
			closer := not no_close and is_close(t.kind) and psp > 0 and pline[psp - 1] < t.line
			mut broke := false
			if col > 0 and closer {
				out.append(byte(10))
				ci := pind[psp - 1] + psp - 1
				fmt_indent(out, ci)
				col = ci
				broke = true
			} else if col > 0 and t.line > prev_line and not is_rbrace(t.kind) {
				out.append(byte(10))

				# F104 applies inside a group as well as between statements. Only the other
				# branch used to check for it, so a blank line a person left among a wrapped
				# list's elements — the separator between an import group's two halves, for
				# one — was closed up as if it had never been written.
				if t.line > prev_line + 1 {
					out.append(byte(10))
				}

				# `depth` and not the opener's block depth: a group may OPEN A BLOCK inside
				# itself — `print(match n { … })` — and the arms belong to that block, one
				# level in from the `match` line. Measuring from the opener's depth alone
				# left them level with it, and the closing `}` to the left of what it
				# closed. Where a group opens no block the two are the same number, which
				# is why every other wrapped shape is unchanged.
				mut ci := depth + 1
				if psp > 0 {
					ci = depth + psp
				}
				fmt_indent(out, ci)
				col = ci
				broke = true
			}

			# A `}` closes its block: it dedents before it is written, and it always starts
			# a line. The lexer's inserted `;` cannot be relied on for either — it only
			# fires at bracket depth 0 — so block structure is the formatter's own rule.
			# The one-line guard block never opened a level, so its `}` closes none.
			if is_rbrace(t.kind) and fmt_rbrace_closes_block(toks, i) and not fmt_guard_inline(toks, fmt_brace_open(toks, i)) {
				if bstack.len() > 0 {
					bsave = bstack[bstack.len() - 1]
					bstack = fmt_pop_int(bstack)
				}
				if depth > 0 {
					depth = depth - 1
				}
				if col > 0 {
					out.append(byte(10))
					col = 0
				}
			}
			if col == 0 {
				# a blank line in the source survives, but only one
				if prev_line > 0 and t.line > prev_line + 1 {
					out.append(byte(10))
				}

				# A line can also start with no break of its own to account for: after a
				# comment, which runs to end of line, or after a `}`. Inside a group that is
				# still open it belongs at the group's indent all the same — otherwise a
				# comment among a wrapped list's elements dropped the element after it back
				# to the statement's own level.
				# measured from the CURRENT block depth, not the opener's: a group may open a
				# block inside itself — `print(match n { … })` — and its contents belong to
				# that block, one level in from the line the `match` is on. Where a group
				# opens no block the two are the same number, which is why every other
				# wrapped shape is unchanged.
				mut ci := depth
				if psp > 0 {
					ci = depth + psp
					if is_close(t.kind) {
						ci = ci - 1
					}
				}
				fmt_indent(out, ci)
				col = ci
			} else if not broke and fmt_space_between(toks, i, prev2, prev) {
				# a line just broken is at its indent and nothing more: the spacing rule
				# asks about two tokens ON a line, and after `x,` it would put the space
				# that belongs after the comma at the START of the next line
				out.append(b' ')
				col = col + 1
			}

			# where a column a run shares would go, recorded before the token lands on it
			if t.kind == Kind.FatArrow and not fmt_arm_guarded(toks, i) {
				arrow.append(out.len())
			} else if is_comment(t.kind) and fmt_line_has_code(out) {
				trail.append(out.len())
			}
			fmt_write(out, fmt_text(t))
			col = col + 1
			if is_open(t.kind) {
				if psp < pline.len() {
					pline[psp] = t.line
					pind[psp] = depth
				} else {
					pline.append(t.line)
					pind.append(depth)
				}
				psp = psp + 1
			} else if is_close(t.kind) and psp > 0 {
				psp = psp - 1
			}

			# a `{` opens a block: whatever follows starts on its own line, one deeper. A map
			# literal's brace is not one and stays on its line — fmt_opens_block — and a
			# guard's one-line block declines the break — fmt_guard_inline.
			if is_lbrace(t.kind) and fmt_opens_block(toks, i) and not fmt_guard_inline(toks, i) {
				bstack.append(bsave)
				bsave = psp
				depth = depth + 1
				out.append(byte(10))
				col = 0
			}

			# a comment runs to end of line: close the line so nothing joins it
			if is_comment(t.kind) {
				out.append(byte(10))
				col = 0
			}
			prev2 = prev
			prev = t.kind
			prev_line = t.line
			i = i + 1
		}
	}
	if col > 0 {
		out.append(byte(10))
	}
	return Printed(str(out), arrow, trail)
}

# fmt_arm_guarded reports whether the arm this `=>` closes carries a GUARD — an `if expr`
# between the pattern and the arrow. A guarded arm's head is a sentence rather than a name,
# so it does not join a run and does not widen one: it ends the run it meets.
fn fmt_arm_guarded(mut &toks: list[Token], at: int) -> bool {
	mut i := at - 1
	for i >= 0 {
		k := toks[i].kind

		break if is_semi(k) or is_lbrace(k) or is_rbrace(k) or is_comment(k)
		return true if k == Kind.If

		i = i - 1
	}
	return false
}

# fmt_line_has_code reports whether anything but indentation has been written on the line the
# printer is on. It is what tells a TRAILING comment from one standing on its own line, and
# `col` cannot: a line already indented has a nonzero column with no code on it yet.
#
# The buffer comes by reference and nothing is written through it. A list argument arrives by
# value otherwise, and copying the whole output to look at its last few bytes — once per
# comment in the file — is the difference between reading a line and reading the file again.
fn fmt_line_has_code(mut &out: list[byte]) -> bool {
	mut i := out.len() - 1
	for i >= 0 {
		c := out[i]

		return false if c == byte(10)
		return true if c != b' ' and c != byte(9)

		i = i - 1
	}
	return false
}

# --- rules F106 / F107: a run shares one column ------------------------------------------
#
# A match over a small closed set is a LOOKUP TABLE, and the arms of one read as rows:
#
#     Eof       => "EOF"
#     Illegal   => "ILLEGAL"
#     FStrBegin => "FSTR_BEGIN"
#
# rather than as a ragged left edge with the answers scattered along it. Trailing comments
# line up for the same reason and by the same machinery — a run of them is a column of notes
# on a column of code.
#
# A RUN is consecutive lines, at the same indent, that each carry the same kind of mark.
# Anything else ends it: a blank line, a comment on its own line, a guarded arm, an arm whose
# body is a block or continues on the next line. So an arm never lines up with something that
# is not its neighbour in the same table.
#
# The padding is SPACES while the indent is TABS, which is what makes the column hold at any
# tab width — the tabs are identical across a run and cancel out, and only spaces are counted
# into the column itself.
#
# This is layout rather than a rewrite: it decides where a token an author already wrote goes.
# So it is not switchable, and F201's "one space around `=>`" becomes "at least one" — the
# printer still writes exactly one, and the column is what the padding adds to it.
#
# Idempotence is the printer's, not this pass's: whitespace between two tokens is not a token,
# so a second run lexes the padded source to the same stream, prints the same single space,
# and pads it again to the same column.

# fmt_align_gap is how far apart two heads may be and still share a column. It bounds the
# padding any one line takes, which is the whole reason a run has a budget: without it a run
# creeps wider one arm at a time and a three-character pattern ends up half a line from its
# answer.
#
# 12 is measured off a select, not a match. A match's patterns are names of one kind and run
# 3 to 9 columns, but a select's arm heads are four different shapes — `v := <-work`,
# `<-quit`, `out <- total`, `_` — and 8 cut the `_` out of its own table. The rule is that a
# table a reader sees as one table stays one, so the budget is set where the widest of those
# shapes still reaches the narrowest.
fn fmt_align_gap() -> int {
	return 12
}

fn fmt_align(mut &p: Printed) -> str {
	mut lens: list[int] = []
	mut lines := fmt_split_lines(p.text, lens)
	mut arrow := fmt_line_marks(lens, p.arrow)
	mut trail := fmt_line_marks(lens, p.trail)
	mut none: list[int] = []

	# the arrows go first: a `=>` that moves is to the LEFT of a trailing comment on the same
	# line, so the comment's mark is handed on already shifted
	fmt_align_marks(lines, arrow, trail, true)
	fmt_align_marks(lines, trail, none, false)
	return fmt_join_lines(lines)
}

# fmt_align_marks lines up every run of one kind of mark. `also` is the OTHER kind on the same
# lines, which moves when the padding pushes past it; the pass that has nothing after it hands
# in an empty list.
fn fmt_align_marks(mut &lines: list[str], mut &mark: list[int], mut &also: list[int], arms: bool) {
	mut i := 0
	for i < lines.len() {
		if fmt_align_row(lines, mark, also, i, arms) {
			i = fmt_align_run(lines, mark, also, i, arms)
		} else {
			i = i + 1
		}
	}
}

# fmt_align_row reports whether a line is a ROW of a table: it carries a mark, and — for a run
# of arms — the arm is one a row can hold.
fn fmt_align_row(mut &lines: list[str], mut &mark: list[int], mut &also: list[int], i: int, arms: bool) -> bool {
	return false if mark[i] < 0
	return true if not arms

	return fmt_arm_flat(lines[i], mark[i], fmt_mark_at(also, i))
}

fn fmt_mark_at(mut &marks: list[int], i: int) -> int {
	return -1 if i >= marks.len()
	return marks[i]
}

# fmt_align_run measures the run starting at `at`, lines it up, and answers with the line after
# it. A run is consecutive rows at one indent. A comment on its own line is TRANSPARENT — it
# does not end the table it sits inside — and anything else ends the run.
#
# The budget is ALL OR NOTHING: if the run's widest and narrowest heads are more than the gap
# apart, nothing in it is padded and every line keeps its single space. Cutting the run at the
# first head that overruns instead — which is what this did first — turns one `match` into three
# or four tables in three or four columns, which reads worse than the ragged edge it replaced.
# A table is one thing or it is not a table.
fn fmt_align_run(mut &lines: list[str], mut &mark: list[int], mut &also: list[int], at: int, arms: bool) -> int {
	tabs := fmt_indent_of(lines[at])
	mut lo := fmt_head_width(lines[at], mark[at])
	mut hi := lo
	mut end := at + 1
	for end < lines.len() {
		break if fmt_indent_of(lines[end]) != tabs
		break if not fmt_align_row(lines, mark, also, end, arms)

		w := fmt_head_width(lines[end], mark[end])
		if w < lo {
			lo = w
		}
		if w > hi {
			hi = w
		}
		end = end + 1
	}
	return end if hi - lo > fmt_align_gap()

	want := hi + 1 # the column every mark in the run lands in: one past its widest head
	mut i := at
	for i < end {
		if want != mark[i] {
			w := fmt_head_width(lines[i], mark[i])
			lines[i] = fmt_set_gap(lines[i], w, mark[i], hi - w + 1)

			# the other mark moves only if it stood to the RIGHT of the gap, and it is asked
			# BEFORE this line's own mark moves — a wide pad would otherwise carry the arrow
			# past a trailing comment and leave the comment behind
			if i < also.len() and also[i] > mark[i] {
				also[i] = also[i] + want - mark[i]
			}
			mark[i] = want
		}
		i = i + 1
	}
	return end
}

# fmt_arm_flat reports whether the arm on this line is one a row can hold: its body is on the
# line, and it is not a block. A line that ends in `{` opened a body, and one that ends at its
# arrow put the body on the next line; either way the arm is a shape rather than a row.
#
# `cut` is where a trailing comment starts, and the line is read only up to there — a comment
# ending in `{` is prose, not a body, and looking at the whole line let one shatter the table
# around it.
fn fmt_arm_flat(s: str, at: int, cut: int) -> bool {
	b := bytearray(s)
	mut i := b.len() - 1
	if cut >= 0 {
		i = cut - 1
	}
	for i >= 0 {
		c := b[i]
		if c != b' ' and c != byte(9) {
			return false if c == b'{'
			return i > at + 1
		}
		i = i - 1
	}
	return false
}

# fmt_head_width is what stands to the left of the mark: the column the last byte of code
# before it ends at, with the space the printer put in front of the mark not counted.
fn fmt_head_width(s: str, at: int) -> int {
	b := bytearray(s)
	mut i := at - 1
	for i >= 0 {
		return i + 1 if b[i] != b' ' and b[i] != byte(9)
		i = i - 1
	}
	return 0
}

fn fmt_indent_of(s: str) -> int {
	b := bytearray(s)
	mut n := 0
	for n < b.len() {
		break if b[n] != byte(9)
		n = n + 1
	}
	return n
}

# fmt_set_gap rewrites the whitespace between the code ending at `end` and the mark at `at` to
# exactly `n` spaces.
#
# It SETS the gap rather than adding to it, so the column does not depend on what the printer
# put there. Padding an assumed single space is off by one wherever the spacing rules print
# none — which is exactly what `20.. =>` does — and a rule that has to agree with another rule
# to be right is one that will be wrong later.
fn fmt_set_gap(s: str, end: int, at: int, n: int) -> str {
	b := bytearray(s)
	mut out: list[byte] = []
	mut i := 0
	for i < end {
		out.append(b[i])
		i = i + 1
	}
	mut k := 0
	for k < n {
		out.append(b' ')
		k = k + 1
	}
	mut j := at
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# fmt_line_marks turns offsets into the whole text into an offset within one line: one entry per
# line, -1 for "nothing to align here". A line that collects TWO marks aligns on neither —
# padding the first would leave the second's column a function of it.
#
# It is given the line LENGTHS rather than the lines: the only thing it needs from a line is
# where the next one starts, and rebuilding each line as a byte list to ask its length was the
# pass's largest single cost.
fn fmt_line_marks(mut &lens: list[int], mut &offs: list[int]) -> list[int] {
	mut mark: list[int] = []
	mut i := 0
	for i < lens.len() {
		mark.append(-1)
		i = i + 1
	}
	mut at := 0 # first byte of line `i`
	mut k := 0
	i = 0
	for i < lens.len() {
		end := at + lens[i]
		mut dup := false
		for k < offs.len() and offs[k] < end {
			if mark[i] < 0 {
				mark[i] = offs[k] - at
			} else {
				dup = true
			}
			k = k + 1
		}
		if dup {
			mark[i] = -1
		}
		at = end + 1
		i = i + 1
	}
	return mark
}

# fmt_split_lines splits the printed text at its line breaks, filling `lens` with each line's
# length as it goes — the aligner needs both and this pass already knows both. The empty piece
# after the last break is dropped; the printer always ends a line, and fmt_join_lines puts every
# break back.
fn fmt_split_lines(text: str, mut &lens: list[int]) -> list[str] {
	b := bytearray(text)
	mut out: list[str] = []
	mut cur: list[byte] = []
	mut i := 0
	for i < b.len() {
		if b[i] == byte(10) {
			lens.append(cur.len())
			out.append(str(cur))
			cur = []
		} else {
			cur.append(b[i])
		}
		i = i + 1
	}
	if cur.len() > 0 {
		lens.append(cur.len())
		out.append(str(cur))
	}
	return out
}

fn fmt_join_lines(mut &lines: list[str]) -> str {
	mut out: list[byte] = []
	for ln in lines {
		fmt_write(out, ln)
		out.append(byte(10))
	}
	return str(out)
}

# fmt_text is what a token contributes to the output: its exact source spelling.
fn fmt_text(t: Token) -> str {
	return t.lexeme if is_comment(t.kind)
	return t.lexeme if t.lexeme != ""

	return kind_name(t.kind)
}

fn fmt_write(mut &out: list[byte], s: str) {
	for c in bytearray(s) {
		out.append(c)
	}
}

fn fmt_indent(mut &out: list[byte], depth: int) {
	mut i := 0
	for i < depth {
		out.append(byte(9))
		i = i + 1
	}
}

# fmt_space_between decides whether two adjacent tokens are separated by a space. The
# defaults are "yes" — words and operators breathe — and the exceptions are the shapes
# where a space would be wrong: inside brackets, before punctuation that binds tight, and
# between a callee and its argument list.
#
# `<-` needs one token of context on EACH side, which is why the pair became a window of
# four. This formatter is token-based and builds no tree, so the four spellings of `<-`
# are told apart only by their neighbours:
#
#     ch <- v          infix send      — a space on both sides
#     <-ch             prefix receive  — tight on the right
#     <-chan[T]        recv-only type  — tight on the right
#     chan[T]<-        send-only type  — tight on the LEFT
#
# The first three are separated from the fourth by what FOLLOWS the arrow: only the
# trailing type marker is followed by something that cannot begin an item. The prefix
# forms are separated from the infix one by what PRECEDES the arrow: only the infix send
# has an operand in front of it.
fn fmt_space_between(mut &toks: list[Token], i: int, prev2: Kind, prev: Kind) -> bool {
	k := toks[i].kind
	if is_open(prev) {
		return false # `(x`, `[x`
	}
	if is_close(k) or is_comma(k) {
		return false # `x)`, `x]`, `x,`
	}

	# A MAP LITERAL'S BRACES HUG like a list's brackets — `{"a": 1}`, `{:}` — while a block's
	# stand apart from the head that opens them. Same token, two rules, told apart by what is
	# in front of the `{` (fmt_opens_block) and, for the `}`, by what its own opener was.
	return false if is_lbrace(prev) and not fmt_opens_block(toks, i - 1)
	return false if is_rbrace(k) and not fmt_rbrace_closes_block(toks, i)

	if is_open(k) and binds_tight(prev) {
		return false # `f(`, `xs[`, `chan[`
	}
	if is_dot(prev) or is_dot(k) {
		return false # `a.b`, `a?.b`
	}
	if is_colon(k) {
		return false # `name: T`
	}
	if is_unary_prefix(prev) {
		return false # `-x`, `&x`
	}
	if is_postfix(k) {
		return false # `v!`, `x?` — a postfix operator belongs to the operand on its left
	}
	if is_range_op(k) and not is_comma(prev) {
		return false # `0..n`, `a..=b` — a range binds its bounds
	}
	if is_range_op(prev) and not no_bound_follows(k) {
		return false # the other side of the same fact, and `[h, ..t]`'s rest marker
	}
	if is_larrow(k) and closes_chan_type(toks, i - 1) {
		return false # `chan[int]<-` — the arrow ends a send-only type
	}
	if is_larrow(prev) and not ends_operand(prev2) {
		return false # `<-ch`, `<-chan[int]` — the arrow leads what follows it
	}
	if is_minus(prev) and not ends_operand(prev2) {
		# `-1`, `3 + -1`, `x ?? -1` — a NEGATION leads what follows it, and is told from the
		# subtraction `a - b` the same way the two arrows are told apart: by whether anything
		# to its left could be an operand. It cannot go in is_unary_prefix, which asks only
		# what a token IS, and `-` is both.
		#
		# `-%` IS BOTH IN THE SAME WAY — the wrapping negate and the wrapping subtraction — so
		# it is asked here rather than there, and `-%b` comes out tight while `lo -% byte(1)`
		# keeps its spaces. It was in neither place, and printed `-% b`.
		return false
	}
	return true
}

# ends_operand reports whether a token could be the END of an operand, which is the question
# both `<-` and `-` are told apart by: each is a prefix exactly when nothing to its left could
# have been operated on.
#
# It is NOT `ends_item`. That one answers the lexer's question — can a line break here insert a
# `;` — and `return`, `break`, `continue` and `nop` end a STATEMENT while being no kind of
# operand at all. Asking the lexer's predicate printed `return -1` as `return - 1` (and would
# print `return <-ch` as `return <- ch`), which is the negation rule F203 states, backwards, in
# the one position where a negative literal is most common.
fn ends_operand(k: Kind) -> bool {
	return false if is_jump(k) or k == Kind.Nop
	return ends_item(k)
}

fn is_minus(k: Kind) -> bool {
	return match k {
		Kind.Minus    => true
		Kind.MinusMod => true
		_             => false
	}
}

# closes_chan_type reports whether the token at `i` is the `]` closing a `chan[…]` — which
# is the ONE thing a send-only `<-` can follow.
#
# It replaces a guess about what came AFTER the arrow. That guess — "a trailing marker is
# followed by something that cannot begin an item" — is true of `chan[T]<-,` and
# `chan[T]<-)`, and false of the return type in `fn mk() -> chan[int]<- {`: a `{` begins a
# block, so the marker read as a send and took a space it must not have. Looking left
# answers the question instead of approximating it, and it cannot confuse the two — a send
# `xs[0] <- v` closes a bracket too, but that bracket's `[` follows a NAME, not `chan`.
fn closes_chan_type(mut &toks: list[Token], i: int) -> bool {
	return false if i < 0 or toks[i].kind != Kind.RBrack
	mut depth := 0
	mut j := i
	for j >= 0 {
		k := toks[j].kind
		if k == Kind.RBrack {
			depth = depth + 1
		}
		if k == Kind.LBrack {
			depth = depth - 1
			return j > 0 and is_chan(toks[j - 1].kind) if depth == 0
		}
		j = j - 1
	}
	return false
}

fn is_chan(k: Kind) -> bool {
	return match k {
		Kind.Chan => true
		_         => false
	}
}

# is_postfix names the operators that follow their operand. Both are unambiguous: `!=` and
# `??` are tokens of their own, so a bare `!` is always the force-unwrap and a bare `?` is
# always the propagate. The formatter never learned either, so `print v!` came back as
# `print v !` — an operator adrift from the thing it operates on.
fn is_postfix(k: Kind) -> bool {
	return match k {
		Kind.Bang     => true
		Kind.Question => true
		_             => false
	}
}

fn is_larrow(k: Kind) -> bool {
	return match k {
		Kind.LArrow => true
		_           => false
	}
}

# is_range_op names the two range operators. They are BINARY — so the spacing default said
# yes and `xs[1..3]` came back as `xs[1 .. 3]` — but they read as a constructor rather than as
# an operation: every range in this tree, in GRAMMAR and in the docs is written tight, and
# `0 .. n` is the one spelling nobody writes. The same tokens spell a list pattern's rest
# marker (`[h, ..t]`), where being tight to what FOLLOWS is equally what is wanted — so the
# space a comma owes is the one exception on the left.
fn is_range_op(k: Kind) -> bool {
	return match k {
		Kind.DotDot   => true
		Kind.DotDotEq => true
		_             => false
	}
}

# binds_tight reports whether a `(` or `[` after this token opens a call or an index
# rather than a grouping — the difference between `f(x)` and `if (x)`.
fn binds_tight(k: Kind) -> bool {
	return match k {
		Kind.Ident  => true
		Kind.RParen => true
		Kind.RBrack => true
		Kind.Str    => true
		Kind.Int    => true

		# `chan[T]` and `ptr[T]` are the two type constructors spelled with a KEYWORD rather
		# than a name, so the Ident case above does not reach them and `chan [int]` came out
		# with a space no other type has. `close(ch)` is the third: a statement whose
		# argument is parenthesized, written the way the call it used to be was.
		Kind.Chan  => true
		Kind.Ptr   => true
		Kind.Close => true
		_          => false
	}
}

fn is_open(k: Kind) -> bool {
	return match k {
		Kind.LParen => true
		Kind.LBrack => true
		Kind.Hash   => true
		_           => false
	}
}

fn is_close(k: Kind) -> bool {
	return match k {
		Kind.RParen => true
		Kind.RBrack => true
		_           => false
	}
}

# is_bracket is is_open without the `#` of a decorator: the openers that have a closer to
# pair with, which is what a group's extent is counted from.
fn is_bracket(k: Kind) -> bool {
	return match k {
		Kind.LParen => true
		Kind.LBrack => true
		_           => false
	}
}

fn is_hash(k: Kind) -> bool {
	return match k {
		Kind.Hash => true
		_         => false
	}
}

fn is_comma(k: Kind) -> bool {
	return match k {
		Kind.Comma => true
		_          => false
	}
}

# is_dot covers BOTH accessors: `.` and the optional chain `?.`, which is one token and
# binds exactly as tightly. Without the second, `b?.value` came back as `b ?. value`.
fn is_dot(k: Kind) -> bool {
	return match k {
		Kind.Dot    => true
		Kind.OptDot => true
		_           => false
	}
}

fn is_colon(k: Kind) -> bool {
	return match k {
		Kind.Colon => true
		_          => false
	}
}

# is_unary_prefix reports the tokens that attach to what follows them: `&` in `mut &p`.
# `not` is deliberately NOT here — it is a WORD, and `not x` written as `notx` is a
# different identifier, not a negation.
# is_unary_prefix is every operator that is ONLY ever a prefix, and so is tight to its operand
# without anything having to be asked about its neighbours (F203).
#
# `-` and `<-` are absent because they are not only-ever: each is also an infix operator, and
# which one it is depends on what stands to the LEFT — that question is asked further down, of
# those two by name.
#
# `~` is here because it IS only-ever, and it was missing: `zerg fmt` wrote `~ b`, which reads
# as an infix operator with its left side torn off. Nothing caught it because no gated source
# complements a value — the same shape of blind spot as the map literal this rule's neighbour
# was wrong about, and found the same way, by a case written for something else.
#
# `-%` is NOT here, for the same reason `-` is not: it is the wrapping negate AND the wrapping
# subtraction, so `-%b` is tight and `lo -% byte(1)` is not. Putting it here printed the second
# as `lo -%byte(1)`, which is the first mistake with the sides swapped.
fn is_unary_prefix(k: Kind) -> bool {
	return match k {
		Kind.Amp   => true
		Kind.Tilde => true
		_          => false
	}
}

fn is_semi(k: Kind) -> bool {
	return match k {
		Kind.Semi => true
		_         => false
	}
}

fn is_lbrace(k: Kind) -> bool {
	return match k {
		Kind.LBrace => true
		_           => false
	}
}

fn is_rbrace(k: Kind) -> bool {
	return match k {
		Kind.RBrace => true
		_           => false
	}
}

fn is_comment(k: Kind) -> bool {
	return match k {
		Kind.Comment => true
		_            => false
	}
}

# --- rule F404: many imports become one parenthesized group --------------------------------
#
# GRAMMAR gives `import` two forms, one spec or a parenthesized list of them, and says the
# formatter writes one spec per line. Two or more imports become the group:
#
#     import "cli"          import (
#     import "io"      →        "cli"
#                               "io"
#                           )
#
# ONE import is left as it is, which is gofmt's answer and for gofmt's reason: the group's
# job is to hold a list together, and a list of one is the statement itself with two lines
# of ceremony around it.
#
# Unlike F402 this rule takes `pub` and `as` with it. Those are what F402 declines over
# because it REORDERS — a re-export is an ordering the author chose — and this rule moves
# nothing past anything, so the objection does not apply. `import ( pub "…" )` is the spec
# grammar as GRAMMAR writes it.
#
# It runs AFTER F402, so the blank line between the standard library and the rest survives
# into the group, where it is the same separator Go's is.
#
# A comment among the imports declines the whole run, for F401's reason: a comment belongs
# to the import it sits on, and there is nowhere to put it back once the statements it sat
# between are one statement. A run already in group form is left alone, which is what makes
# running the rule twice a no-op.
fn fmt_import_group(mut &toks: list[Token]) -> list[Token] {
	first := fmt_first_import(toks)
	return toks if first < 0
	last := fmt_group_run_end(toks, first)

	return toks if last < 0
	return toks if fmt_run_specs(toks, first, last) < 2

	mut out: list[Token] = []
	mut i := 0
	for i < first {
		out.append(toks[i])
		i = i + 1
	}
	end := fmt_emit_group(toks, first, last, out)

	# Every token after the run shifts by however many lines the run grew, so the blank
	# line the author left before the next declaration is still there.
	shift := end - toks[last].line
	mut j := last + 1
	for j < toks.len() {
		out.append(fmt_on_line(toks[j], toks[j].line + shift))
		j = j + 1
	}
	return out
}

# fmt_emit_group writes `import (`, one spec per line, and the `)`, and answers with the
# line the closer landed on. Each spec keeps its own tokens — `pub`, the path, `as` and the
# name — so nothing is re-spelled from a value that was parsed out of it.
fn fmt_emit_group(mut &toks: list[Token], first: int, last: int, mut &out: list[Token]) -> int {
	ln := toks[first].line
	out.append(Token(Kind.Import, "import", "", ln, 0))
	out.append(Token(Kind.LParen, "(", "", ln, 0))

	mut cur := ln
	mut src := -1
	mut i := first
	for i <= last {
		if toks[i].kind == Kind.Import {
			cur = cur + 1

			# a blank line between two imports is the group separator F402 wrote, and it
			# means the same thing inside the parentheses as it did outside them
			if src >= 0 and toks[i].line > src + 1 {
				cur = cur + 1
			}
			src = toks[i].line
			mut j := i + 1
			for j <= last and toks[j].kind != Kind.Import and not is_semi(toks[j].kind) {
				out.append(fmt_on_line(toks[j], cur))
				j = j + 1
			}
			i = j
		} else {
			i = i + 1
		}
	}
	cur = cur + 1
	out.append(Token(Kind.RParen, ")", "", cur, 0))
	out.append(Token(Kind.Semi, ";", "", cur, 0))
	return cur
}

# fmt_group_run_end is the index of the last token of the run of import statements starting
# at `first`, or -1 when the run holds something this rule will not fold up.
fn fmt_group_run_end(mut &toks: list[Token], first: int) -> int {
	mut i := first
	mut last := -1
	for i < toks.len() {
		k := toks[i].kind
		if k == Kind.Import {
			# already a group: folding a fold is what would make this rule non-idempotent
			return -1 if toks[i + 1].kind == Kind.LParen
			mut j := i + 1
			if toks[j].kind == Kind.Pub {
				j = j + 1
			}
			return -1 if toks[j].kind != Kind.Str
			j = j + 1
			if toks[j].kind == Kind.As {
				j = j + 1
				return -1 if toks[j].kind != Kind.Ident
				j = j + 1
			}
			last = j - 1
			i = j
		} else if is_semi(k) {
			last = i
			i = i + 1
		} else if is_comment(k) and fmt_more_imports_after(toks, i) {
			# a comment BETWEEN imports: it belongs to the one it sits on and the fold has
			# nowhere to put it back. A comment after the run is just the next
			# declaration's, and ends the run rather than declining it.
			return -1
		} else {
			return last
		}
	}
	return last
}

fn fmt_more_imports_after(mut &toks: list[Token], at: int) -> bool {
	mut i := at
	for i < toks.len() {
		k := toks[i].kind

		return true if k == Kind.Import
		return false if not is_semi(k) and not is_comment(k)

		i = i + 1
	}
	return false
}

fn fmt_run_specs(mut &toks: list[Token], first: int, last: int) -> int {
	mut n := 0
	mut i := first
	for i <= last {
		if toks[i].kind == Kind.Import {
			n = n + 1
		}
		i = i + 1
	}
	return n
}

# --- rule F402: imports group, standard library first, each group alphabetical -------------
#
# The Go convention, and for the same reason: an import list is READ far more often than it
# is edited, and one that is grouped and sorted answers "does this file use X" by looking
# rather than by scanning. The standard library goes first because it is the part a reader
# already knows; everything else is what this program brought.
#
#     import "cli"          import (
#     import "zerg"    →        "cli"
#     import "io"               "io"
#
#                               "zerg"
#                           )
#
# The parentheses are F404, which runs next and folds what this rule has just ordered —
# they are in the picture because it is what `zerg fmt` prints, and a comment showing the
# intermediate state would be showing something nobody ever sees.
#
# What counts as standard library is the fixed bundled set, named below. The formatter
# cannot ask the filesystem — it is handed a string, not a directory — and the set is
# closed, so naming it here costs one line per module and is checked by the resolver
# failing loudly on anything else.
#
# It rewrites only a run of plain `import "path"` statements at the top of the file, and
# declines the moment anything else appears among them: a comment (which belongs to the
# import it sits on, and sorting would strand it), or an `import pub` (whose re-export is
# an ordering the author chose). Anything declined is left exactly as written.
fn fmt_imports(mut &toks: list[Token]) -> list[Token] {
	first := fmt_first_import(toks)
	return toks if first < 0
	last := fmt_import_run_end(toks, first)
	return toks if last < 0
	paths := fmt_run_paths(toks, first, last)
	return toks if paths.len() < 2
	mut out: list[Token] = []
	mut i := 0
	for i < first {
		out.append(toks[i])
		i = i + 1
	}
	ln := toks[first].line
	end := fmt_emit_imports(paths, ln, out)

	# Every token after the run shifts by however many lines the run grew or shrank, so the
	# blank line the author left before the next declaration is still there.
	shift := end - toks[last].line
	mut j := last + 1
	for j < toks.len() {
		out.append(fmt_on_line(toks[j], toks[j].line + shift))
		j = j + 1
	}
	return out
}

# fmt_emit_imports writes the sorted paths, a blank line between the two groups, and
# answers with the line the last one landed on.
fn fmt_emit_imports(paths: list[str], start: int, mut &out: list[Token]) -> int {
	mut ln := start
	mut wrote := false
	for std in [true, false] {
		mut group := false
		for p in fmt_sorted(fmt_group(paths, std)) {
			if wrote {
				ln = ln + 1
				if not group {
					ln = ln + 1 # the blank line between the groups
				}
			}
			out.append(Token(Kind.Import, "import", "", ln, 0))
			out.append(Token(Kind.Str, f"\"{p}\"", p, ln, 0))
			out.append(Token(Kind.Semi, ";", "", ln, 0))
			wrote = true
			group = true
		}
	}
	return ln
}

fn fmt_group(paths: list[str], std: bool) -> list[str] {
	mut out: list[str] = []
	for p in paths {
		if fmt_is_stdlib(p) == std {
			out.append(p)
		}
	}
	return out
}

# fmt_sorted returns the paths in alphabetical order. An import list is a handful of names,
# so an insertion sort is the whole of what this needs.
fn fmt_sorted(paths: list[str]) -> list[str] {
	mut out: list[str] = []
	for p in paths {
		mut at := 0
		for at < out.len() and fmt_before(out[at], p) {
			at = at + 1
		}
		out.append(p)
		mut k := out.len() - 1
		for k > at {
			out[k] = out[k - 1]
			k = k - 1
		}
		out[at] = p
	}
	return out
}

# fmt_is_stdlib reports whether a path names a bundled module. A module resolves by its
# LAST path segment (`import "std/io"` and `import "io"` are the same module), which is
# what the driver's resolver does, so the test is on that segment.
fn fmt_is_stdlib(path: str) -> bool {
	name := fmt_last_segment(path)
	for m in ["ascii", "atomic", "cli", "fs", "io", "math", "os", "rand", "strconv", "strings", "testing", "time"] {
		return true if m == name
	}
	return false
}

fn fmt_last_segment(path: str) -> str {
	b := bytearray(path)
	mut cut := 0
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i + 1
		}
		i = i + 1
	}
	mut out: list[byte] = []
	mut j := cut
	for j < b.len() {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# fmt_first_import is the index of the first `import`, or -1 when the file has none.
fn fmt_first_import(mut &toks: list[Token]) -> int {
	mut i := 0
	for i < toks.len() {
		return i if toks[i].kind == Kind.Import
		i = i + 1
	}
	return -1
}

# fmt_import_run_end is the index of the last token of the run of plain imports starting at
# `first`, or -1 when the run holds anything this pass will not reorder.
fn fmt_import_run_end(mut &toks: list[Token], first: int) -> int {
	mut i := first
	mut last := -1
	for i < toks.len() {
		k := toks[i].kind
		if k == Kind.Import {
			return -1 if toks[i + 1].kind != Kind.Str
			last = i + 1
			i = i + 2
		} else if is_semi(k) {
			last = i
			i = i + 1
		} else {
			return last
		}
	}
	return last
}

fn fmt_run_paths(mut &toks: list[Token], first: int, last: int) -> list[str] {
	mut out: list[str] = []
	mut i := first
	for i <= last {
		if toks[i].kind == Kind.Import {
			out.append(toks[i + 1].value)
		}
		i = i + 1
	}
	return out
}

# fmt_before reports whether a sorts before b, byte by byte. It is spelled out rather than
# written `a < b`: this compiler compares strings for EQUALITY only, and an ordering
# comparison on `str` would compare the pointers — which sorts by where the strings
# happen to sit in memory, silently, and differently on every run.
fn fmt_before(a: str, b: str) -> bool {
	x := bytearray(a)
	y := bytearray(b)
	mut i := 0
	for i < x.len() and i < y.len() {
		return true if x[i] < y[i]
		return false if x[i] > y[i]

		i = i + 1
	}
	return x.len() < y.len()
}

# is_jump reports the statements that DIVERGE — leave the block they are in without
# producing a value — which is exactly the set GRAMMAR's postfix guard is defined for.
fn is_jump(k: Kind) -> bool {
	return k == Kind.Return or k == Kind.Break or k == Kind.Continue or k == Kind.Raise
}
