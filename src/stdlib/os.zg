# os — process & platform facts (pure-Zerg stdlib over the runtime).
#
# Bundled into a program that writes `import "os"`; members are reached through the
# namespace, as `os.platform()`. Zerg is zero-external-dependency: each fact is a thin
# runtime leaf (`getenv` / `exit`, or a compile-time `#ifdef` for platform/arch); the
# null-safety logic (an unset variable is `nil`) is pure Zerg above them. The program's
# own arguments arrive as `fn main(args: list[str])`, not from here.
#
# THE ENVIRONMENT IS READ FREELY AND WRITTEN ONLY AT STARTUP. `env` is safe anywhere; `set_env`
# and `del_env` mutate a C-library structure with no lock on it, so they belong before the
# first `spawn` and nowhere else. Each says so at length.

# env returns the value of environment variable key, or nil when it is unset. (An unset
# variable and one set to the empty string are told apart here — both a plain lookup and
# `os.env(k) ?? default` do the right thing.)
pub fn env(key: str) -> str? {
	return __zrt_getenv(key) if __zrt_has_env(key)
	return nil
}

# set_env sets environment variable key to value, replacing any current one, and raises
# `ValueError` when the host refuses the name — a key that is empty or contains `=`, which
# `setenv(3)` will not accept. It answers nothing, because there is nothing a successful write
# knows that the caller did not already know.
#
# SET THE ENVIRONMENT AT STARTUP, BEFORE ANY COROUTINE IS SPAWNED. This is not a convention to
# be traded off against convenience — it is the ONLY safe use of this function, and the reason
# is that the state being mutated is not this language's. POSIX's `environ` is a C-library data
# structure with no lock on it: `setenv` may reallocate the array and free the old one, while
# `getenv` hands back a pointer INTO it, so a write on one coroutine racing an `os.env` on
# another is a use-after-free inside libc. Zerg runs real OS worker threads, so "two
# coroutines" is "two threads" often enough that a program which happens to work proves
# nothing.
#
# THAT MAKES IT UNLIKE EVERY OTHER SHARED-STATE HAZARD IN THIS LIBRARY. `log`'s installed
# logger is one cell this project owns, and one day an atomic could close it; `environ` is not
# ours and no amount of work here can make it safe. There is nothing to wait for.
#
# The two callers this is for are the whole of it: a program configuring itself before it does
# any work, and a program configuring the environment a child will INHERIT from `os.run`.
#
#     os.set_env("TZ", "UTC")            # before anything else runs
#     os.run(["sh", "-c", "echo $TZ"])   # the child inherits it
#
# THAT ILLUSTRATION IS NOT A ` ```zerg ` EXAMPLE, and the reason is the gate rather than the
# code: `scripts/doc-examples-check.sh` renders every example line with `print`, and this
# function answers nothing, which is `E390`. The round trip is asserted in
# tests/stdlib/os/os_test.zg instead, where a claim about a write can be made in full.
pub fn set_env(key: str, value: str) {
	__zrt_set_env(key, value)
}

# del_env removes environment variable key and answers WHETHER IT WAS THERE — `true` when the
# variable existed and has now gone, `false` when there was nothing to remove.
#
# THAT ANSWER IS THE ONE THING A CALLER CANNOT WORK OUT FOR ITSELF. `env` then `del_env` is two
# queries with a window between them, and C's `unsetenv` reports success either way, so it
# cannot be asked afterwards either. Reading and removing under one call is a deliberate
# improvement on the leaf rather than a passthrough of it.
#
# It is TOTAL: a name the host would refuse was not set, so `false` is a true answer rather
# than a missing one, and there is nothing here to raise about. `set_env` raises on such a name
# because a write to it has no answer at all.
#
# The startup rule above governs this one exactly as it governs `set_env` — a removal is a
# write to `environ` like any other.
#
# The example removes `PATH`, which every process on this platform is given, so the first call
# finds it and the second has nothing left to remove. That difference is the whole of what this
# function adds over the leaf it lowers onto.
#
# ```zerg
# os.del_env("PATH")
# os.del_env("PATH")
# ```
# ```output
# true
# false
# ```
pub fn del_env(key: str) -> bool {
	return __zrt_del_env(key)
}

# exit terminates the process immediately with status code. It does not return, and it
# runs no pending `defer`s — use it for a top-level, deliberate early exit.
pub fn exit(code: int) {
	__zrt_exit(code)
}

# run executes argv[0] with the given arguments (searching PATH), waits for it, and
# returns its exit status — 128+signal if it died on a signal, 127 if the program could
# not be executed. This is the process-spawn floor for tooling that shells out (a
# compiler invoking `cc`); it is the one runtime leaf that starts another process.
pub fn run(argv: list[str]) -> int {
	return __zrt_exec(argv)
}

# platform returns the target operating system as a lowercase name — "linux", "darwin",
# "windows", "freebsd", or "unknown". It is decided at C-compile time, so it names the
# platform the binary was built for.
pub fn platform() -> str {
	return __zrt_platform()
}

# arch returns the target CPU architecture — "arm64", "x86_64", "x86", "riscv64", or
# "unknown" — likewise fixed at compile time.
pub fn arch() -> str {
	return __zrt_arch()
}

# isatty reports whether the file descriptor `fd` is a terminal — 0 standard input, 1 standard
# output, 2 standard error. A descriptor that is not open is not a terminal, so it answers
# false rather than raising.
#
# IT IS ABOUT THE DEVICE AND ABOUT NOTHING ELSE, and that boundary is the whole reason it is
# worth having. A program uses it to choose a RENDERING — colour at a terminal, plain into a
# pipe — and never a FORMAT: output that changes SHAPE when it is redirected is output that
# cannot be read the same way twice, and a log file that is JSON on one machine and columns on
# another is worse than either. `log` follows exactly that line: colour asks this, and
# `ZERG_LOG` is the only thing that picks the format.
#
# ```zerg
# os.isatty(-1)
# ```
# ```output
# false
# ```
pub fn isatty(fd: int) -> bool {
	return __zrt_isatty(fd)
}
