# Two files of one module naming each other through imports.
#   zerg build examples/1g/siblings/main.zg
# Expected output:
#   3
#   8
#   8
#
# THE IMPORT IS WHAT MAKES A SIBLING'S NAME REACHABLE. Files of one module do NOT share a
# namespace (#57): `text.zg` reaches `count.zg`'s `width` by importing it and writing
# `count.width(a)`, and the bare `width(a)` is refused. The import binds a name onto a file
# that is already in this unit rather than loading a second copy of it, which is what lets
# two files of one module name each other MUTUALLY where two modules may not.
import "./lib"

fn main() {
	print lib.width(" abc ")
	print lib.both("ab", " cdef ")
	print lib.plain("ab", " cdef ")
}
