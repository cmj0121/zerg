# The `cmd` module's SURFACE: the terminal half of every subcommand, which the entries
# (`zergc.zg` and `zergc_seed.zg`) call and nothing else does (#57 decisions 4-6). A directory
# is a module because it holds this file, and what the module exports is what this file
# re-exports — not every `pub` in it.
#
# THE RE-EXPORT IS FLAT, so an entry writes `cmd.root(…)` and never `cmd.root.root(…)`: the
# files not listed here are this driver's own workings, and a `pub` in one of them means "my
# siblings may name me" and nothing more.
import (
	pub "./build"
	pub "./desugar"
	pub "./doc"
	pub "./fmt"
	pub "./lint"
	pub "./lsp"
	pub "./root"
	pub "./test"
)
