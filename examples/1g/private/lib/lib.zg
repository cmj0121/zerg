# lib — one public function and one module-private helper. A cross-module reference
# to the private helper is a compile error (Phase 1g visibility enforcement).
pub fn public_fn() -> int {
	return 1
}

# helper is module-private: specified to be reachable only inside lib, never as
# lib.helper. This compiler flattens every module into one namespace and checks no
# visibility, so the cross-module call in ../main.zg resolves — see the header there.
fn helper() -> int {
	return 2
}
