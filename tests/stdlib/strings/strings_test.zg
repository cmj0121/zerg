# The `strings` suite — every `pub` function of src/stdlib/strings.zg, each asked the
# ordinary case, its boundary, and the way it can refuse.
#
# BLACK-BOX, AND NOT BY CHOICE. docs/runtime/package.md puts a test in the module it
# tests, and this one cannot be: `zerg test` compiles a DIRECTORY as one package, and
# `src/stdlib` is a flat directory of seventeen independent modules. A test file dropped
# beside strings.zg makes every other stdlib module a source of the same unit, which
# `atomic.zg` (E215, a generic struct) and the `pub` names two modules share (E705
# `is_digit`, in `ascii` and `strconv`) each refuse before a single test runs. So the
# suite sits in a package of its own and reaches the module the way a user does, through
# `import "strings"`. It costs the module-private helpers — `match_at`, `slice_str`,
# `pad_count` — which are reachable only through the `pub` surface here.
#
# THE UTF-8 CLAIMS ARE TESTED, not restated. The module says it works at the BYTE level
# and is UTF-8 correct because UTF-8 is self-synchronising, that `index_of` answers a
# BYTE offset, and that case folding is ASCII-only. Those are three claims a byte-level
# implementation can get wrong in three different ways, and each has its own tests below.
import (
	"strings"
	"testing"
)

# EVERY CLAIM IS `assert`, the keyword, and the suite lost its explaining messages when it
# moved onto one. `testing.assert(cond, "why")` existed because a function is handed a `bool`
# with the expression already compiled away, so the author was the only one who could say
# what the claim had been; the keyword says it itself, with the file, the line, the source
# text, and the value of each operand a comparison came apart into. The ten messages that
# were dropped here each restated the enclosing test's own name.
#
# THE REFUSALS ARE ASKED WITH `testing.assert_raises`, which takes the `guard` written at
# the point of the call and answers the `Err` that came out of it — so what each of those
# tests asserts is the taxonomy kind the module's doc comment promises, in the language's
# own `is`. That one is still a function, and stays one: it asks about a call that already
# happened, which is not a claim a keyword can spell.

# --- has_prefix ---------------------------------------------------------------------

#[test]
fn test_has_prefix_ordinary() {
	assert strings.has_prefix("hello", "he")
	assert not strings.has_prefix("hello", "el")
}

#[test]
fn test_has_prefix_boundaries() {
	assert strings.has_prefix("hello", "")
	assert strings.has_prefix("hello", "hello")
	assert not strings.has_prefix("ab", "abc")
	assert not strings.has_prefix("", "x")
	assert strings.has_prefix("", "")
}

#[test]
fn test_has_prefix_multibyte(ctx: testing.Context) {
	assert strings.has_prefix("日本語", "日")
	assert strings.has_prefix("日本語", "日本")

	# `日` is E6 97 A5 and `有` is E6 9C 89 — the same lead byte. A prefix test that looked
	# at one byte would answer true here, and this test asks about three needles, so the
	# failure has to say which. The ASSERTION says that itself now — it carries its own
	# source text — and what is left for the context is the fact the text does not carry.
	ctx.log("the two needles share the lead byte E6")
	assert not strings.has_prefix("日本語", "有")
}

# --- has_suffix ---------------------------------------------------------------------

#[test]
fn test_has_suffix_ordinary() {
	assert strings.has_suffix("hello", "lo")
	assert not strings.has_suffix("hello", "ll")
}

#[test]
fn test_has_suffix_boundaries() {
	assert strings.has_suffix("hello", "")
	assert strings.has_suffix("hello", "hello")

	# the suffix longer than the string is the one that reaches match_at with a NEGATIVE
	# offset, which is the bound the caller is promised it need not check itself
	assert not strings.has_suffix("ab", "abc")
	assert strings.has_suffix("", "")
}

#[test]
fn test_has_suffix_multibyte() {
	assert strings.has_suffix("日本語", "語")
	assert strings.has_suffix("日本語", "本語")
	assert not strings.has_suffix("日本語", "本")
}

# --- index_of -------------------------------------------------------------------------

#[test]
fn test_index_of_ordinary() {
	assert strings.index_of("hello", "h") == 0
	assert strings.index_of("hello", "lo") == 3
	assert strings.index_of("hello", "l") == 2
}

#[test]
fn test_index_of_absent_is_minus_one() {
	assert strings.index_of("hello", "z") == -1
	assert strings.index_of("", "x") == -1
	assert strings.index_of("ab", "abc") == -1
}

#[test]
fn test_index_of_empty_needle_is_zero() {
	assert strings.index_of("hello", "") == 0
	assert strings.index_of("", "") == 0
}

# THE HEADLINE CLAIM: the answer is a BYTE offset and not a rune count. `本` is the second
# CHARACTER of `日本語` and its third BYTE, so a rune-counting implementation answers 1
# here and a byte-level one answers 3.
#[test]
fn test_index_of_answers_a_byte_offset_not_a_rune_count() {
	assert strings.index_of("日本語", "日") == 0
	assert strings.index_of("日本語", "本") == 3
	assert strings.index_of("日本語", "語") == 6

	# and mixed widths: `h` is one byte, `é` is two, so `l` is at 3 and not at 2
	assert strings.index_of("héllo", "é") == 1
	assert strings.index_of("héllo", "l") == 3
}

# UTF-8 IS SELF-SYNCHRONISING, which is the module's stated reason a byte search is safe:
# a lead byte (>= 0xC0) and a continuation byte (0x80..0xBF) are disjoint sets, so a valid
# needle can never begin at the interior of a code point. What that leaves for a test is
# the near miss — needles that SHARE leading bytes with what is there and must still not
# match, which is where a search comparing fewer bytes than the needle has would go wrong.
#[test]
fn test_index_of_does_not_match_a_partial_code_point() {
	# `本` is E6 9C AC and `有` is E6 9C 89 — two bytes in common out of three
	assert strings.index_of("本", "有") == -1

	# `日` is E6 97 A5 — one byte in common with both
	assert strings.index_of("日", "有") == -1
	assert strings.index_of("日日日", "有") == -1

	# and the boundary IS found, in a haystack whose characters share that lead byte
	assert strings.index_of("日有本", "有") == 3
}

# --- contains -------------------------------------------------------------------------

#[test]
fn test_contains_ordinary() {
	assert strings.contains("hello world", "o w")
	assert not strings.contains("hello", "z")
}

#[test]
fn test_contains_boundaries() {
	assert strings.contains("hello", "")
	assert strings.contains("", "")
	assert not strings.contains("", "x")
	assert strings.contains("hello", "hello")
}

#[test]
fn test_contains_multibyte() {
	assert strings.contains("日本語", "本")
	assert not strings.contains("日本語", "有")
}

# --- split ----------------------------------------------------------------------------
#
# TWO LISTS CANNOT BE COMPARED — `E445 NotImplemented: `==` on a list[str]`, structural
# equality over a container being unbuilt — so no claim here can be made about a split's
# result directly. Every one of them goes back through `join` with a separator the input does
# not contain, which is the only shape available and which happily doubles as the split/join
# round trip.

#[test]
fn test_split_ordinary() {
	assert strings.join(strings.split("a,b,c", ","), "|") == "a|b|c"
	assert strings.split("a,b,c", ",").len() == 3
}

#[test]
fn test_split_n_separators_give_n_plus_one_pieces() {
	# the pieces between separators, empties included — leading, trailing and adjacent
	assert strings.join(strings.split("a,,b", ","), "|") == "a||b"
	assert strings.split("a,,b", ",").len() == 3
	assert strings.split(",a,", ",").len() == 3
	assert strings.join(strings.split(",a,", ","), "|") == "|a|"
}

#[test]
fn test_split_boundaries() {
	# no separator present: one piece, the whole string
	assert strings.split("abc", ",").len() == 1
	assert strings.join(strings.split("abc", ","), "|") == "abc"

	# the empty string is one empty piece, not none
	assert strings.split("", ",").len() == 1
	assert strings.join(strings.split("", ","), "|") == ""

	# a multi-byte separator, and a separator longer than the string
	assert strings.join(strings.split("a、b、c", "、"), "|") == "a|b|c"
	assert strings.split("ab", "abcd").len() == 1
}

#[test]
fn test_split_empty_separator_raises_value_error() {
	e := testing.assert_raises(guard { strings.split("a,b", "") })
	assert e is ValueError

	# the demotion the module's own comment names, in the form its example shows: `guard`
	# turns the abort into a value and `??` supplies what to do instead
	assert (guard { strings.split("a,b", "").len() } ?? -1) == -1
}

# --- join -----------------------------------------------------------------------------

#[test]
fn test_join_ordinary() {
	assert strings.join(["a", "b", "c"], ",") == "a,b,c"
	assert strings.join(["usr", "local", "bin"], "/") == "usr/local/bin"
}

#[test]
fn test_join_boundaries() {
	parts: list[str] = []
	assert strings.join(parts, ",") == ""
	assert strings.join(["only"], ",") == "only"

	# an empty separator is legal for join — it is only `split` that cannot invert one
	assert strings.join(["a", "b"], "") == "ab"
	assert strings.join(["", ""], ",") == ","
}

#[test]
fn test_join_multibyte() {
	assert strings.join(["日", "本"], "、") == "日、本"
}

# --- repeat ---------------------------------------------------------------------------

#[test]
fn test_repeat_ordinary() {
	assert strings.repeat("ab", 3) == "ababab"
	assert strings.repeat("-", 5) == "-----"
}

#[test]
fn test_repeat_boundaries() {
	assert strings.repeat("ab", 0) == ""
	assert strings.repeat("ab", 1) == "ab"
	assert strings.repeat("", 5) == ""
	assert strings.repeat("日", 2) == "日日"
}

#[test]
fn test_repeat_negative_count_raises_value_error() {
	e := testing.assert_raises(guard { strings.repeat("ab", -1) })
	assert e is ValueError
}

# --- trim / trim_left / trim_right ------------------------------------------------------

#[test]
fn test_trim_ordinary() {
	assert strings.trim("  hi  ") == "hi"
	assert strings.trim("\t hi \n") == "hi"
}

#[test]
fn test_trim_takes_the_whole_ascii_space_set() {
	# the six `ascii.is_space` bytes — space, tab, LF, VT, FF, CR — on both sides
	assert strings.trim(" \t\n\u{0B}\u{0C}\rhi \t\n\u{0B}\u{0C}\r") == "hi"
}

#[test]
fn test_trim_boundaries() {
	assert strings.trim("") == ""
	assert strings.trim("   ") == ""
	assert strings.trim("hi") == "hi"

	# inner whitespace is not touched
	assert strings.trim("  a b  ") == "a b"
}

#[test]
fn test_trim_leaves_multibyte_intact() {
	# trimming is a byte scan, and `ascii.is_space` is false for every byte >= 0x80,
	# so no part of a code point can be taken off either end
	assert strings.trim("  日本  ") == "日本"
	assert strings.trim("日本") == "日本"
}

#[test]
fn test_trim_left_and_right_take_one_side_each() {
	assert strings.trim_left("  hi  ") == "hi  "
	assert strings.trim_right("  hi  ") == "  hi"
	assert strings.trim_left("hi  ") == "hi  "
	assert strings.trim_right("  hi") == "  hi"

	# THE SAME TWO FACTS WITH THE SURVIVING SPACE MADE VISIBLE, and the reason is the
	# example in the module's own comment: an `output` block ending in whitespace is a
	# block this repository's pre-commit hook silently trims, which turns a true example
	# into a false one. A terminator the eye can see is what lets the example be written
	# at all, and this is the assertion that backs it.
	assert strings.trim_left("  hi  ") + "|" == "hi  |"
	assert strings.trim_right("  hi  ") + "|" == "  hi|"
}

#[test]
fn test_trim_left_and_right_boundaries() {
	assert strings.trim_left("") == ""
	assert strings.trim_right("") == ""
	assert strings.trim_left("   ") == ""
	assert strings.trim_right("   ") == ""
}

# --- to_upper / to_lower ----------------------------------------------------------------

#[test]
fn test_to_upper_ordinary() {
	assert strings.to_upper("hello") == "HELLO"
	assert strings.to_upper("Hello World") == "HELLO WORLD"
}

#[test]
fn test_to_lower_ordinary() {
	assert strings.to_lower("HELLO") == "hello"
	assert strings.to_lower("Hello World") == "hello world"
}

#[test]
fn test_case_folds_leave_non_letters_alone() {
	assert strings.to_upper("a1!_z") == "A1!_Z"
	assert strings.to_lower("A1!_Z") == "a1!_z"
	assert strings.to_upper("") == ""
	assert strings.to_lower("") == ""
}

# THE ASCII-ONLY CLAIM. `é` is C3 A9 and `É` is C3 89; both bytes are >= 0x80, so both
# fold to themselves and the character comes out of either fold unchanged. A fold that
# reached above 0x7F would corrupt the string here rather than merely fail to fold it.
#[test]
fn test_case_folding_is_ascii_only() {
	assert strings.to_upper("héllo") == "HéLLO"
	assert strings.to_lower("HÉLLO") == "hÉllo"
	assert strings.to_upper("日本語") == "日本語"
	assert strings.to_lower("日本語") == "日本語"
}

# --- count ------------------------------------------------------------------------------

#[test]
fn test_count_ordinary() {
	assert strings.count("banana", "a") == 3
	assert strings.count("banana", "na") == 2
}

#[test]
fn test_count_is_non_overlapping() {
	# "aaaa" holds three overlapping "aa" and two that do not overlap
	assert strings.count("aaaa", "aa") == 2
	assert strings.count("banana", "ana") == 1
}

#[test]
fn test_count_boundaries() {
	assert strings.count("hello", "z") == 0
	assert strings.count("", "x") == 0
	assert strings.count("abc", "abcd") == 0
	assert strings.count("abc", "abc") == 1
}

#[test]
fn test_count_multibyte() {
	assert strings.count("ああ", "あ") == 2
	assert strings.count("日本日", "日") == 2
	assert strings.count("日本日", "有") == 0
}

#[test]
fn test_count_empty_needle_raises_value_error() {
	e := testing.assert_raises(guard { strings.count("banana", "") })
	assert e is ValueError
}

# --- replace ----------------------------------------------------------------------------

#[test]
fn test_replace_ordinary() {
	assert strings.replace("banana", "a", "o") == "bonono"
	assert strings.replace("a-b-c", "-", "::") == "a::b::c"
}

#[test]
fn test_replace_is_non_overlapping_and_left_to_right() {
	assert strings.replace("aaa", "aa", "b") == "ba"

	# the replacement is not rescanned: "aa" in the output came from the substitution
	assert strings.replace("ab", "b", "aa") == "aaa"
}

#[test]
fn test_replace_boundaries() {
	assert strings.replace("abc", "x", "y") == "abc"
	assert strings.replace("", "x", "y") == ""

	# an empty replacement is a deletion
	assert strings.replace("hello", "l", "") == "heo"
	assert strings.replace("abc", "abc", "") == ""
}

#[test]
fn test_replace_multibyte() {
	assert strings.replace("日本語", "本", "X") == "日X語"
	assert strings.replace("a,b", ",", "、") == "a、b"
	assert strings.replace("日本語", "有", "X") == "日本語"
}

#[test]
fn test_replace_empty_target_raises_value_error() {
	e := testing.assert_raises(guard { strings.replace("abc", "", "x") })
	assert e is ValueError
}

# --- trim_prefix / trim_suffix ------------------------------------------------------------

#[test]
fn test_trim_prefix_ordinary() {
	assert strings.trim_prefix("hello", "he") == "llo"
	assert strings.trim_prefix("/usr/bin", "/") == "usr/bin"
}

#[test]
fn test_trim_prefix_takes_one_and_only_one() {
	# a single leading prefix, not every one of them
	assert strings.trim_prefix("aaab", "a") == "aab"
}

#[test]
fn test_trim_prefix_boundaries() {
	assert strings.trim_prefix("hello", "xy") == "hello"
	assert strings.trim_prefix("hello", "") == "hello"
	assert strings.trim_prefix("hello", "hello") == ""
	assert strings.trim_prefix("ab", "abc") == "ab"
	assert strings.trim_prefix("日本語", "日") == "本語"
}

#[test]
fn test_trim_suffix_ordinary() {
	assert strings.trim_suffix("hello", "lo") == "hel"
	assert strings.trim_suffix("main.zg", ".zg") == "main"
}

#[test]
fn test_trim_suffix_takes_one_and_only_one() {
	assert strings.trim_suffix("abbb", "b") == "abb"
}

#[test]
fn test_trim_suffix_boundaries() {
	assert strings.trim_suffix("hello", "xy") == "hello"
	assert strings.trim_suffix("hello", "") == "hello"
	assert strings.trim_suffix("hello", "hello") == ""

	# longer than the string — the negative window match_at is promised to survive
	assert strings.trim_suffix("ab", "abc") == "ab"
	assert strings.trim_suffix("日本語", "語") == "日本"
}

# --- fields --------------------------------------------------------------------------------

#[test]
fn test_fields_ordinary() {
	assert strings.join(strings.fields("a b c"), "|") == "a|b|c"
	assert strings.fields("a b c").len() == 3
}

#[test]
fn test_fields_never_yields_an_empty_piece() {
	# leading, trailing and repeated whitespace, and the whole ascii space set at once
	assert strings.join(strings.fields("  a   b  "), "|") == "a|b"
	assert strings.fields("  a   b  ").len() == 2
	assert strings.join(strings.fields("\ta\n\nb\r"), "|") == "a|b"
}

#[test]
fn test_fields_boundaries() {
	assert strings.fields("").len() == 0
	assert strings.fields("   ").len() == 0
	assert strings.fields("solo").len() == 1
	assert strings.join(strings.fields("solo"), "|") == "solo"
}

#[test]
fn test_fields_multibyte() {
	assert strings.join(strings.fields(" 日  本 "), "|") == "日|本"
	assert strings.fields("日本").len() == 1
}

# --- last_index_of ---------------------------------------------------------------------------

#[test]
fn test_last_index_of_ordinary() {
	assert strings.last_index_of("hello", "l") == 3
	assert strings.last_index_of("abcabc", "abc") == 3
	assert strings.last_index_of("hello", "h") == 0
}

#[test]
fn test_last_index_of_absent_is_minus_one() {
	assert strings.last_index_of("hello", "z") == -1
	assert strings.last_index_of("", "x") == -1
	assert strings.last_index_of("ab", "abc") == -1
}

# the mirror of `index_of` finding an empty needle at 0: the LAST empty needle is the one
# at the end, so the answer is the string's byte length
#[test]
fn test_last_index_of_empty_needle_is_the_length() {
	assert strings.last_index_of("hello", "") == 5
	assert strings.last_index_of("", "") == 0
	assert strings.last_index_of("日", "") == 3
}

#[test]
fn test_last_index_of_answers_a_byte_offset() {
	assert strings.last_index_of("日本日", "日") == 6
	assert strings.last_index_of("日本語", "本") == 3
	assert strings.last_index_of("日本日", "有") == -1
}

# --- equal_fold --------------------------------------------------------------------------------

#[test]
fn test_equal_fold_ordinary() {
	assert strings.equal_fold("Hello", "hELLO")
	assert strings.equal_fold("abc", "abc")
	assert not strings.equal_fold("abc", "abd")
}

#[test]
fn test_equal_fold_boundaries() {
	assert strings.equal_fold("", "")
	assert not strings.equal_fold("", "a")

	# a length difference is answered before a byte is folded
	assert not strings.equal_fold("abc", "ab")
	assert not strings.equal_fold("ab", "abc")
}

# ASCII-ONLY AGAIN, and here it decides an answer rather than a rendering: `é` and `É`
# are two different code points that ASCII folding cannot bring together, so they are
# not equal-fold — while the ASCII letters around them are.
#[test]
fn test_equal_fold_is_ascii_only() {
	assert strings.equal_fold("héllo", "HéLLO")
	assert not strings.equal_fold("héllo", "HÉLLO")
	assert strings.equal_fold("日本語", "日本語")
	assert not strings.equal_fold("日本語", "日本有")
}

# --- pad_start / pad_end -------------------------------------------------------------------------

#[test]
fn test_pad_start_ordinary() {
	assert strings.pad_start("7", 3, "0") == "007"
	assert strings.pad_start("42", 5, " ") == "   42"
}

#[test]
fn test_pad_end_ordinary() {
	assert strings.pad_end("ab", 5, ".") == "ab..."
	assert strings.pad_end("7", 3, "0") == "700"
}

#[test]
fn test_pad_returns_a_string_already_that_wide_unchanged() {
	assert strings.pad_start("hello", 3, "-") == "hello"
	assert strings.pad_end("hello", 3, "-") == "hello"

	# exactly at the width, and a width no string can be under
	assert strings.pad_start("ab", 2, "-") == "ab"
	assert strings.pad_start("ab", -1, "-") == "ab"
	assert strings.pad_end("ab", -1, "-") == "ab"
}

#[test]
fn test_pad_boundaries() {
	assert strings.pad_start("", 3, "-") == "---"
	assert strings.pad_end("", 3, "-") == "---"
	assert strings.pad_start("", 0, "-") == ""
}

# THE WIDTH IS BYTES, which is the whole reason the fill has to be one. `日` is three
# bytes and one character, so padding it to five adds TWO fill bytes and not four.
#[test]
fn test_pad_counts_bytes_not_characters() {
	assert strings.pad_start("日", 5, "-") == "--日"
	assert strings.pad_end("日", 5, "-") == "日--"
	assert bytearray(strings.pad_start("日", 5, "-")).len() == 5

	# already five bytes wide at one character each side of the width
	assert strings.pad_start("日本", 5, "-") == "日本"
}

#[test]
fn test_pad_empty_fill_raises_value_error() {
	s := testing.assert_raises(guard { strings.pad_start("x", 4, "") })
	assert s is ValueError
	e := testing.assert_raises(guard { strings.pad_end("x", 4, "") })
	assert e is ValueError
}

# a multi-byte fill cannot land on a byte width without cutting a code point in half,
# which is why it is refused rather than truncated
#[test]
fn test_pad_multibyte_fill_raises_value_error() {
	s := testing.assert_raises(guard { strings.pad_start("x", 4, "ab") })
	assert s is ValueError
	e := testing.assert_raises(guard { strings.pad_end("x", 4, "日") })
	assert e is ValueError

	# demoted to a value, which is the form the module's example shows
	assert (guard { strings.pad_start("x", 4, "ab") } ?? "refused") == "refused"
}

# THE FILL IS VALIDATED BEFORE THE WIDTH IS CONSULTED. A string already wide enough
# returns early — but not before the fill is refused, so a bad fill is a bad call whether
# or not it would have been used.
#[test]
fn test_pad_refuses_a_bad_fill_even_when_no_padding_is_needed() {
	s := testing.assert_raises(guard { strings.pad_start("hello", 2, "") })
	assert s is ValueError
	e := testing.assert_raises(guard { strings.pad_end("hello", 2, "ab") })
	assert e is ValueError
}
