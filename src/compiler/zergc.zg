# zerg — the self-hosting Zerg compiler.
#
# One tool, a few sub-commands, and the two flags every tool owes its user: --help and
# --version. `build` is self-sufficient — it emits C beside the output, then links it by
# shelling out to cc through the runtime's process-spawn leaf (`__zrt_exec`) — and the
# compiler resolves `import` itself, so it works from any directory.
import "zerg"
import "io"

fn version() -> str {
	return "zerg 0.1.0 (self-hosted)"
}

# Opts is one parsed command line: the sub-command, its output path, its file arguments,
# and the two flags that short-circuit everything else. `bad` carries the first usage
# error, which is reported instead of guessing at what was meant.
struct Opts {
	cmd: str
	out: str
	files: list[str]
	help: bool
	version: bool
	bad: str
}

fn main(args: list[str]) {
	mut o := Opts("", "", [], false, false, "")
	parse_args(args, o)
	if o.bad != "" {
		io.ewrite("zerg: " + o.bad + "\n")
		io.ewrite(usage_line() + "\n")
		__zrt_exit(2)
	}
	if o.version {
		io.write(version() + "\n")
		return
	}
	if o.help or o.cmd == "" {
		io.write(help_text())
		return
	}
	run_command(o)
}

# parse_args reads the command line: the first non-flag word is the sub-command, `-o`
# takes the next word, and everything else is a file. Flags are accepted anywhere, so
# `zerg build prog.zg -o out` and `zerg build -o out prog.zg` mean the same thing.
fn parse_args(args: list[str], mut &o: Opts) {
	mut i := 0
	for i < args.len() {
		a := args[i]
		if a == "-h" or a == "--help" {
			o.help = true
		} else if a == "-V" or a == "--version" {
			o.version = true
		} else if a == "-o" or a == "--output" {
			if i + 1 >= args.len() {
				o.bad = "flag " + a + " needs a path"
				return
			}
			o.out = args[i + 1]
			i = i + 1
		} else if is_flag(a) {
			o.bad = "unknown flag " + a
			return
		} else if o.cmd == "" {
			o.cmd = a
		} else {
			o.files.append(a)
		}
		i = i + 1
	}
}

# is_flag reports whether a word looks like an option rather than a value.
fn is_flag(a: str) -> bool {
	b := list[byte](a)
	if b.len() < 2 {
		return false
	}
	return b[0] == b'-'
}

fn run_command(o: Opts) {
	if o.cmd == "build" {
		build_binary(o)
		return
	}
	if o.cmd == "c" {
		need_files(o)
		guard {
			io.write(zerg.emit_files(load_sources(o.files)))
		}
		return
	}
	if o.cmd == "tokens" {
		need_files(o)
		guard {
			io.write(zerg.dump_tokens(str(io.read_file(o.files[0]))))
		}
		return
	}
	if o.cmd == "fmt" {
		need_files(o)
		run_fmt(o.files)
		return
	}
	if o.cmd == "lint" {
		need_files(o)
		run_lint(o.files)
		return
	}
	io.ewrite("zerg: unknown command " + o.cmd + "\n")
	io.ewrite(usage_line() + "\n")
	__zrt_exit(2)
}

# need_files exits with a usage error when a sub-command that reads sources got none.
fn need_files(o: Opts) {
	if o.files.len() < 1 {
		io.ewrite("zerg: " + o.cmd + " needs at least one .zg file\n")
		io.ewrite(usage_line() + "\n")
		__zrt_exit(2)
	}
}

fn usage_line() -> str {
	return "usage: zerg <command> [-o <path>] <file.zg>..."
}

fn help_text() -> str {
	return version() + "\n\n" +
		usage_line() + "\n\n" +
		"Commands:\n" +
		"  build <file.zg>    compile a program to a native binary\n" +
		"  fmt <file.zg>...   rewrite sources in the canonical style\n" +
		"  lint <file.zg>...  report unused imports and dead private code\n" +
		"  c <file.zg>        print the emitted C\n" +
		"  tokens <file.zg>   print the token stream\n" +
		"\n" +
		"Flags:\n" +
		"  -o, --output PATH  where build writes the binary (default: the source name)\n" +
		"  -h, --help         show this message\n" +
		"  -V, --version      show the version\n" +
		"\n" +
		"Environment:\n" +
		"  ZERG_ROOT          installation root (default: the current directory)\n" +
		"  ZERG_RUNTIME       runtime C sources (default: $ZERG_ROOT/src/runtime/csrc)\n" +
		"  ZERG_STDLIB        standard library sources (default: $ZERG_ROOT/src/stdlib)\n"
}

# build_binary compiles `zerg build <file.zg>`: load the entry file with everything it
# imports, emit the merged C beside the output, then invoke cc to link it. Without -o the
# binary takes the entry file's name without its extension, as `cc` does.
fn build_binary(o: Opts) {
	need_files(o)
	mut output := o.out
	if output == "" {
		output = drop_ext(o.files[0])
	}
	srcs := load_sources(o.files)
	cpath := output + ".c"
	guard {
		io.write_file(cpath, list[byte](zerg.emit_files(srcs)))
	}
	code := __zrt_exec(cc_argv(cpath, output))
	if code != 0 {
		io.ewrite("zerg: cc failed\n")
		__zrt_exit(1)
	}
}

# drop_ext removes a trailing ".zg" so `zerg build hello.zg` writes `hello`.
fn drop_ext(path: str) -> str {
	if not has_suffix(path, ".zg") {
		return path
	}
	b := list[byte](path)
	mut out: list[byte] = []
	mut i := 0
	for i < b.len() - 3 {
		out.append(b[i])
		i = i + 1
	}
	return str(out)
}

# load_sources loads every named entry with its imports, keeping one copy of a module
# that several entries share.
fn load_sources(files: list[str]) -> list[str] {
	mut seen: list[str] = []
	mut srcs: list[str] = []
	for f in files {
		load_into(f, dir_of(f), seen, srcs)
	}
	return srcs
}

# --- installation layout -------------------------------------------------------------
#
# The compiler has to work from any directory, so nothing below is a relative path the
# process happens to be standing next to. Each location is answered by an environment
# variable first, then by a root that is itself answered the same way, and the in-repo
# layout is only the last resort — which is what makes a checkout work with no setup.

# env_or reads an environment variable, or gives fallback when it is unset.
fn env_or(key: str, fallback: str) -> str {
	if __zrt_has_env(key) {
		return __zrt_getenv(key)
	}
	return fallback
}

# zerg_root is the installation root: $ZERG_ROOT, else the current directory (the repo
# checkout, where src/runtime and src/stdlib sit).
fn zerg_root() -> str {
	return env_or("ZERG_ROOT", ".")
}

# rt_dir returns the runtime source tree — $ZERG_RUNTIME, else <root>/src/runtime/csrc.
# It is probed rather than assumed, so a wrong root fails as a missing-runtime message
# instead of a wall of cc errors about a header that was never there.
fn rt_dir() -> str {
	if __zrt_has_env("ZERG_RUNTIME") {
		return __zrt_getenv("ZERG_RUNTIME")
	}
	return join_path(zerg_root(), "src/runtime/csrc")
}

# stdlib_dir returns the standard library sources — $ZERG_STDLIB, else <root>/src/stdlib.
fn stdlib_dir() -> str {
	if __zrt_has_env("ZERG_STDLIB") {
		return __zrt_getenv("ZERG_STDLIB")
	}
	return join_path(zerg_root(), "src/stdlib")
}

# --- paths -----------------------------------------------------------------------------

# join_path joins a directory and a name, treating "" and "." as "here".
fn join_path(dir: str, name: str) -> str {
	if dir == "" or dir == "." {
		return name
	}
	return dir + "/" + name
}

# dir_of returns the directory part of a path, or "." when it names a bare file.
fn dir_of(path: str) -> str {
	b := list[byte](path)
	mut cut := 0
	mut seen := false
	mut i := 0
	for i < b.len() {
		if b[i] == b'/' {
			cut = i
			seen = true
		}
		i = i + 1
	}
	if not seen {
		return "."
	}
	mut out: list[byte] = []
	mut j := 0
	for j < cut {
		out.append(b[j])
		j = j + 1
	}
	return str(out)
}

# has_suffix reports whether s ends with suffix.
fn has_suffix(s: str, suffix: str) -> bool {
	b := list[byte](s)
	x := list[byte](suffix)
	if x.len() > b.len() {
		return false
	}
	mut i := 0
	for i < x.len() {
		if b[b.len() - x.len() + i] != x[i] {
			return false
		}
		i = i + 1
	}
	return true
}

# --- module resolution ------------------------------------------------------------------

# module_files resolves one import path to the source files that make up that module,
# searched in the entry program's own directory first (a user module beside the program),
# then the standard library. A module is either a single `<path>.zg` file or a DIRECTORY
# of them — the compiler's own `zerg` module is the second kind, and its files are read in
# the sorted order the runtime guarantees so the emitted C never depends on the
# filesystem. An unresolvable import yields an empty list; the caller reports it.
fn module_files(path: str, from_dir: str) -> list[str] {
	mut roots: list[str] = []
	roots.append(from_dir)
	roots.append(stdlib_dir())
	for root in roots {
		file := join_path(root, path + ".zg")
		if __zrt_exists(file) {
			mut one: list[str] = []
			one.append(file)
			return one
		}
		dir := join_path(root, path)
		if __zrt_exists(dir) {
			mut many: list[str] = []
			for name in __zrt_listdir(dir) {
				if has_suffix(name, ".zg") {
					many.append(join_path(dir, name))
				}
			}
			if many.len() > 0 {
				return many
			}
		}
	}
	mut none: list[str] = []
	return none
}

fn load_into(file: str, from_dir: str, mut &seen: list[str], mut &srcs: list[str]) {
	for s in seen {
		if s == file {
			return
		}
	}
	seen.append(file)
	src := str(io.read_file(file))
	for im in zerg.imports_of(src) {
		for dep in module_files(im, from_dir) {
			load_into(dep, from_dir, seen, srcs)
		}
	}
	srcs.append(src)
}

# cc_argv builds the cc command line: compile cpath into output over the always-linked,
# non-concurrent runtime units, found under rt_dir().
fn cc_argv(cpath: str, output: str) -> list[str] {
	rt := rt_dir()
	mut argv: list[str] = []
	argv.append("cc")
	argv.append("-std=c11")
	argv.append("-I")
	argv.append(rt)
	argv.append("-o")
	argv.append(output)
	argv.append(cpath)
	mut units: list[str] = []
	units.append("alloc.c")
	units.append("conv.c")
	units.append("entry.c")
	units.append("fmt.c")
	units.append("list.c")
	units.append("map.c")
	units.append("ref.c")
	units.append("str.c")
	units.append("sys.c")
	units.append("unwind.c")
	for u in units {
		argv.append(rt + "/" + u)
	}
	return argv
}

# --- fmt / lint ------------------------------------------------------------------------

fn run_fmt(files: list[str]) {
	io.ewrite("zerg: fmt is not implemented yet\n")
	__zrt_exit(2)
}

# run_lint reports every finding in the loaded program and exits nonzero when there is
# one, so `zerg lint` can gate a build rather than merely inform.
fn run_lint(files: list[str]) {
	findings := zerg.lint_files(load_sources(files))
	for f in findings {
		io.write(f + "\n")
	}
	if findings.len() > 0 {
		__zrt_exit(1)
	}
}
